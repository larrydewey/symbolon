test "the public index is read and written back the same" {
    List(SshEntry) es = entries_of("6769746875622d6b6579 ssh-ed25519 AAAA github\nnot a line\n77 ecdsa-sha2-nistp256 BBBB w\n");
    expect(es.len()).toEqual(2);
    expect(es[0].name).toEqual("github-key");
    expect(es[0].line).toEqual("ssh-ed25519 AAAA github");
    expect(es[1].name).toEqual("w");
}
