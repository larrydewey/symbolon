test "the window's token line is accepted with its answer in the same read" {
    expect(opens_with_token([97, 98, 10], "ab")).toBeTrue();
    expect(opens_with_token([97, 98, 10, 111, 107, 32, 49, 10], "ab")).toBeTrue();
    expect(opens_with_token([97, 98], "ab")).toBeFalse();
    expect(opens_with_token([97, 99, 10], "ab")).toBeFalse();
    expect(opens_with_token([97, 98, 99, 10], "ab")).toBeFalse();
    expect(opens_with_token([10], "")).toBeFalse();
}

test "the public index is read and written back the same" {
    List(SshEntry) es = entries_of("6769746875622d6b6579 ssh-ed25519 AAAA github\nnot a line\n77 ecdsa-sha2-nistp256 BBBB w\n");
    expect(es.len()).toEqual(2);
    expect(es[0].name).toEqual("github-key");
    expect(es[0].line).toEqual("ssh-ed25519 AAAA github");
    expect(es[1].name).toEqual("w");
}
