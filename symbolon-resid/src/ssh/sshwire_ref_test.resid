test "a truncated file, a section that is not for its public key, and bad padding are refused" {
    expect(none_k(key_file_of("-----BEGIN OPENSSH PRIVATE KEY-----\\n-----END OPENSSH PRIVATE KEY-----\n"))).toBeTrue();
