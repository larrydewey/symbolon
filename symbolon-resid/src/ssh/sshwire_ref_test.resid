    expect(signed_of([83, 83, 72, 83, 73, 71, 0, 0, 0, 0]).kind).toEqual("");
    Option(Bind) ob = bind_of([0, 0, 0, 24, 115, 101, 115, 115, 105, 111, 110, 45, 98, 105, 110, 100, 64, 111, 112, 101, 110, 115, 115, 104, 46, 99, 111, 109, 0, 0, 0, 51, 0, 0, 0, 11, 115, 115, 104, 45, 101, 100, 50, 53, 53, 49, 57, 0, 0, 0, 32, 222, 22, 197, 109, 114, 94, 176, 186, 46, 180, 223, 79, 188, 228, 191, 27, 165, 168, 232, 3, 41, 144, 225, 167, 98, 223, 119, 177, 8, 146, 88, 172, 0, 0, 0, 32, 49, 62, 179, 242, 213, 110, 31, 8, 94, 114, 129, 66, 91, 134, 162, 192, 223, 77, 247, 245, 197, 187, 73, 180, 4, 1, 131, 1, 33, 210, 106, 94, 0, 0, 0, 3, 115, 105, 103, 1]);
