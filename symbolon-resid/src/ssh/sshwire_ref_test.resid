    expect(hx(a.key)).toEqual("0000000b7373682d6564323535313900000020de16c56d725eb0ba2eb4df4fbce4bf1ba5a8e8032990e1a762df77b1089258ac");
    Signed h = signed_of([0, 0, 0, 32, 49, 62, 179, 242, 213, 110, 31, 8, 94, 114, 129, 66, 91, 134, 162, 192, 223, 77, 247, 245, 197, 187, 73, 180, 4, 1, 131, 1, 33, 210, 106, 94, 50, 0, 0, 0, 2, 109, 101, 0, 0, 0, 14, 115, 115, 104, 45, 99, 111, 110, 110, 101, 99, 116, 105, 111, 110, 0, 0, 0, 35, 112, 117, 98, 108, 105, 99, 107, 101, 121, 45, 104, 111, 115, 116, 98, 111, 117, 110, 100, 45, 118, 48, 48, 64, 111, 112, 101, 110, 115, 115, 104, 46, 99, 111, 109, 1, 0, 0, 0, 11, 115, 115, 104, 45, 101, 100, 50, 53, 53, 49, 57, 0, 0, 0, 51, 0, 0, 0, 11, 115, 115, 104, 45, 101, 100, 50, 53, 53, 49, 57, 0, 0, 0, 32, 222, 22, 197, 109, 114, 94, 176, 186, 46, 180, 223, 79, 188, 228, 191, 27, 165, 168, 232, 3, 41, 144, 225, 167, 98, 223, 119, 177, 8, 146, 88, 172, 0, 0, 0, 51, 16, 197, 42, 100, 232, 103, 159, 144, 81, 179, 137, 63, 204, 128, 155, 246, 237, 148, 142, 125, 146, 67, 31, 247, 51, 59, 92, 162, 134, 215, 55, 217, 182, 236, 209, 132, 212, 94, 111, 111, 74, 91, 47, 247, 28, 114, 154, 162, 228, 199, 66]);
