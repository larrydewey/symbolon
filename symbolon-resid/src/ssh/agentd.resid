// The SSH agent (SPEC 16.1): `symbolon ssh-agent DIR [SOCKET]`.
//
// It serves the agent protocol on a Unix socket the runtime keeps to this
// user (resid_unix_*). It lists the keys of DIR/ssh-keys without the PIN.
// For each signature it opens the consent window (the app run as
// --ssh-consent REQUEST): the window shows the key, the program asking
// (by its pid, read from SO_PEERCRED), what is signed and the server the
// session is bound to, takes the PIN, signs with `symbolon device ssh
// sign`, and sends back only the signature, on a per-request Unix socket
// that must first receive the request's one-time token. The agent checks
// the signature against the key before it answers. It holds no secret.
//
// A key with a certificate in DIR/ssh-certs that is valid by the clock
// (SPEC 16.1.2) is offered twice, as OpenSSH's agent does: the
// certificate first, then the key. A request naming the certificate is
// signed with the certified key and shown to the principal as a
// certificate's; an expired certificate is not offered or signed for.

import "sshwire.resid";
import "sshcert.resid";
import "../agent/sshcli.resid";
import "../browser/json.resid";
import "crypto.resid";
import "word.resid";
import "ecdsa.resid";
import "ed25519.resid";
import "rsa.resid";
import "hash.resid";
import "httpserv.resid";
import "clock.resid";

// ============================================================================
// Checks
// ============================================================================

// Does `sig_blob` verify over `data` under the public key `blob`?
pub Bool verifies(List(Int) blob, List(Int) data, List(Int) sig_blob) { return sig_verifies(blob, data, sig_blob); }

// The session a client bound (session-bind@openssh.com), checked: the
// host key's signature over the session identifier.
pub type AgentSession = { List(Int) host_key; List(Int) session_id; Bool forwarding; Bool bound; };

pub AgentSession unbound() { return AgentSession {.host_key = [], .session_id = [], .forwarding = false, .bound = false}; }

pub Option(AgentSession) checked_bind(List(Int) body) {
    Option(Bind) ob = bind_of(body);
    return match ob {
        None => None,
        Some(b) => if (verifies(b.host_key, b.session_id, b.sig)) { Some(AgentSession {.host_key = b.host_key, .session_id = b.session_id, .forwarding = b.forwarding, .bound = true}) } else { None }
    };
}

// Why a sign request is refused before anyone is asked, or "".
pub Str refused(AgentSession s, List(Int) key, Signed w) {
    if (w.kind == "auth" && hex_encode(w.key) != hex_encode(key)) { return "the request names another key"; }
    if (w.kind == "auth" && s.bound && hex_encode(w.session_id) != hex_encode(s.session_id)) { return "the request is for another session than the one bound"; }
    if (w.kind == "auth" && w.host_key.len() > 0 && s.bound && hex_encode(w.host_key) != hex_encode(s.host_key)) { return "the request names another server than the one bound"; }
    return "";
}

// ============================================================================
// The consent request
// ============================================================================

// The RSA signature algorithm a request's flags ask for (RFC 8332): ""
// for an EC or Ed25519 key, "refused" for SHA-1 ssh-rsa.
pub Str rsa_alg_of(List(Int) key, Int flags) {
    Option(SshPub) ok = pub_of_blob(key);
    SshPub k = ok else { no_pub() };
    if (k.kind != "rsa") { return ""; }
    if ((flags & flag_rsa_sha2_512()) != 0) { return "rsa-sha2-512"; }
    if ((flags & flag_rsa_sha2_256()) != 0) { return "rsa-sha2-256"; }
    return "refused";
}

pub Str consent_json(SshEntry e, Signed w, AgentSession s, Int pid, List(Int) data, Str sock, Str token, Str rsa_alg) { return consent_json_peer(e, w, s, pid, "", data, sock, token, rsa_alg, ""); }

// The certificate a request names, for the window: its authority, its
// principals, when it ends and whether this signature renews it (less
// than a third of its life left). "" when the request names the key.
pub Str cert_json(Option(CertEntry) oc, Int now) {
    return match oc {
        None => "",
        Some(c) => "{\"ca\":" + json_quote(c.ca) + ",\"principals\":[" + quoted(c.principals, 0, "") + "],\"valid_before\":" + f"{c.valid_before}"
                   + ",\"renews\":" + (if (entry_due(c, now)) { "true" } else { "false" }) + "}"
    };
}

Str quoted(List(Str) xs, Int i, Str acc) {
    if (i >= xs.len()) { return acc; }
    return quoted(xs, i + 1, acc + (if (i > 0) { "," } else { "" }) + json_quote(xs[i]));
}

// `peer`: who is asking, when the platform says so instead of a pid (on
// Android, the calling app as the agent service verified it: its label
// and package); "" leaves the field out. `cert`: cert_json, or "".
pub Str consent_json_peer(SshEntry e, Signed w, AgentSession s, Int pid, Str peer, List(Int) data, Str sock, Str token, Str rsa_alg, Str cert) {
    Str what = if (w.kind == "auth") { "{\"kind\":\"auth\",\"user\":" + json_quote(w.user) + "}" }
               else { if (w.kind == "sshsig") { "{\"kind\":\"sshsig\",\"namespace\":" + json_quote(w.namespace) + "}" } else { "{\"kind\":\"unknown\"}" } };
    Str host = if (s.bound) { "{\"key\":" + json_quote(base64_encode(s.host_key)) + ",\"fingerprint\":" + json_quote(ssh_fingerprint(s.host_key)) + ",\"forwarding\":" + (if (s.forwarding) { "true" } else { "false" }) + "}" } else { "null" };
    Option(List(Int)) ob = ssh_blob_of_line(e.line);
    List(Int) blob = ob else { [] };
    return "{\"key\":" + json_quote(e.name) + ",\"fingerprint\":" + json_quote(ssh_fingerprint(blob)) + ",\"what\":" + what + ",\"host\":" + host
        + ",\"pid\":" + f"{pid}" + (if (str_len(peer) > 0) { ",\"peer\":" + json_quote(peer) } else { "" }) + ",\"data\":" + json_quote(hex_encode(data)) + ",\"alg\":" + json_quote(rsa_alg) + (if (str_len(cert) > 0) { ",\"certificate\":" + cert } else { "" }) + ",\"socket\":" + json_quote(sock) + ",\"token\":" + json_quote(token) + "}";
}

Bool shell_safe(Str s) { return str_len(s) > 0 && !str_contains(s, "'") && !str_contains(s, "\n"); }
Bool word_safe(Str s) { return shell_safe(s) && !str_contains(s, " "); }

@requires(clock)
Bool nap(Int ms) { _ = clock.sleep_ns(ms * 1000000); return true; }

Bool has_nl(List(Int) b, Int i) {
    if (i >= b.len()) { return false; }
    if (b[i] == 10) { return true; }
    return has_nl(b, i + 1);
}

@requires(network)
List(Int) read_line_from(Int fd, List(Int) acc, Int cap) {
    if (acc.len() > cap || has_nl(acc, 0)) { return acc; }
    List(Int) chunk = resid_unix_recv_some(fd, 65536);
    if (chunk.len() == 0) { return acc; }
    return read_line_from(fd, acc.concat(chunk), cap);
}

// The window's connection: the first that sends "TOKEN\n" within two
// seconds of connecting (others are dropped); about `tries` tenths of a
// second in all. What came after the token line in the same read (a
// window that answers at once) is kept as the start of the answer.
pub type TokenConn = { Int fd; List(Int) rest; };

// Does `h` open with the token line? (Not only equal to it: the answer may
// follow in the same read.)
pub Bool opens_with_token(List(Int) h, Str token) {
    Str line = token + "\n";
    return str_len(token) > 0 && h.len() >= str_len(line) && http_text(h, 0, str_len(line)) == line;
}

@requires(network, clock)
TokenConn accept_token(Int l, Str token, Int tries) {
    if (tries <= 0) { return TokenConn {.fd = -1, .rest = []}; }
    Int c = resid_unix_accept_now(l);
    if (c < 0) {
        _ = nap(100);
        return accept_token(l, token, tries - 1);
    }
    _ = resid_unix_deadline(c, 2000);
    List(Int) h = read_line_from(c, [], 4096);
    Int n = str_len(token) + 1;
    if (opens_with_token(h, token)) { return TokenConn {.fd = c, .rest = h[n..h.len()]}; }
    _ = resid_unix_close(c);
    return accept_token(l, token, tries - 20);
}

// The signature the window sends ("ok HEX\n"), [] for cancel or nothing.
@requires(filesystem, network, clock, process, environment)
pub List(Int) ask_window(SshEntry e, Signed w, AgentSession s, Int pid, List(Int) data, Str rt, Str rsa_alg, Str cert) {
    Str ui = environment.get("SYMBOLON_CONSENT");
    if (!shell_safe(ui) || !word_safe(rt)) { return []; }
    Str base = rt + "/symbolon/sign-" + hex_encode(random_bytes(8));
    Str sock = base + ".sock";
    Int l = resid_unix_listen(sock);
    if (l < 0) { return []; }
    Str token = hex_encode(random_bytes(32));
    Str req = base + ".json";
    Str sh = base + ".sh";
    _ = filesystem.write_secret(req, json_utf8(consent_json_peer(e, w, s, pid, "", data, sock, token, rsa_alg, cert)));
    _ = filesystem.write_secret(sh, json_utf8("exec '" + ui + "' --ssh-consent '" + req + "' </dev/null >/dev/null 2>&1\n"));
    Int started = process.run("setsid -f sh " + sh);
    TokenConn tc = if (started == 0) { accept_token(l, token, 600) } else { TokenConn {.fd = -1, .rest = []} };
    _ = process.run("rm -f " + sh);
    _ = resid_unix_close(l);
    if (tc.fd < 0) { _ = process.run("rm -f " + req); return []; }
    _ = resid_unix_deadline(tc.fd, 300000);
    List(Int) ans = read_line_from(tc.fd, tc.rest, 262144);
    _ = resid_unix_close(tc.fd);
    _ = process.run("rm -f " + req);
    Str t = str_trim(http_text(ans, 0, ans.len()));
    if (!str_starts_with(t, "ok ")) { return []; }
    Str hx = str_slice(t, 3, str_len(t));
    return if (str_len(hx) % 2 == 0 && str_len(hx) > 0) { cose_hex_decode(hx) } else { [] };
}

// The consent window on a platform that opens it itself (Android: the
// agent service, SPEC 16.1.1): the same request file, per-request socket
// and one-time token as ask_window, announced as one line "consent PATH"
// on standard error instead of a program run. The window has five
// minutes.
@requires(filesystem, network, clock, process)
pub List(Int) ask_platform(SshEntry e, Signed w, AgentSession s, Str peer, List(Int) data, Str rt, Str rsa_alg, Str cert) {
    if (!word_safe(rt)) { return []; }
    Str base = rt + "/symbolon/sign-" + hex_encode(random_bytes(8));
    Str sock = base + ".sock";
    Int l = resid_unix_listen(sock);
    if (l < 0) { return []; }
    Str token = hex_encode(random_bytes(32));
    Str req = base + ".json";
    _ = filesystem.write_secret(req, json_utf8(consent_json_peer(e, w, s, 0, peer, data, sock, token, rsa_alg, cert)));
    eprintln("consent " + req);
    TokenConn tc = accept_token(l, token, 3000);
    _ = resid_unix_close(l);
    if (tc.fd < 0) { _ = process.run("rm -f " + req); return []; }
    _ = resid_unix_deadline(tc.fd, 300000);
    List(Int) ans = read_line_from(tc.fd, tc.rest, 262144);
    _ = resid_unix_close(tc.fd);
    _ = process.run("rm -f " + req);
    Str t = str_trim(http_text(ans, 0, ans.len()));
    if (!str_starts_with(t, "ok ")) { return []; }
    Str hx = str_slice(t, 3, str_len(t));
    return if (str_len(hx) % 2 == 0 && str_len(hx) > 0) { cose_hex_decode(hx) } else { [] };
}

// ============================================================================
// Messages
// ============================================================================

// A certificate of DIR/ssh-certs the agent offers: valid at `now`, and
// for the key it is listed with. Its principals and times are read from
// the certificate itself (what the window shows is what is signed for);
// only the authority's name comes from the list.
pub type Offered = { List(Int) blob; CertEntry e; };

pub Option(Offered) offered_cert(List(CertEntry) cs, SshEntry k, Int now) {
    return match cert_for_key(cs, k.name, 0) { None => None, Some(e) => offered_if(e, k, now) };
}

Option(Offered) offered_if(CertEntry e, SshEntry k, Int now) {
    Option(List(Int)) ob = cert_blob_of_line(e.line);
    List(Int) blob = ob else { [] };
    Option(SshCert) oc = cert_of_blob(blob);
    Option(List(Int)) kb = ssh_blob_of_line(k.line);
    List(Int) key = kb else { [] };
    return match oc {
        None => None,
        Some(c) => if (cert_current(c, now) && key.len() > 0 && hex_encode(c.key_blob) == hex_encode(key)) {
            Some(Offered {.blob = blob, .e = CertEntry {.key = e.key, .ca = e.ca, .days = e.days, .principals = c.principals, .valid_after = c.valid_after, .valid_before = c.valid_before, .line = e.line}})
        } else { None }
    };
}

// What a sign request names: the key's entry, its own blob, the
// certificate when the request named one, and the blob the signed data
// must name (the request's, or the certificate: for_signed).
pub type Target = { SshEntry e; List(Int) key; Option(CertEntry) cert; List(Int) named; };

pub Option(Target) target_for(List(SshEntry) es, List(CertEntry) cs, Int now, List(Int) blob, Int i) {
    if (i >= es.len()) { return None; }
    Option(List(Int)) b = ssh_blob_of_line(es[i].line);
    List(Int) eb = b else { [] };
    if (eb.len() > 0 && hex_encode(eb) == hex_encode(blob)) { return Some(Target {.e = es[i], .key = eb, .cert = None, .named = blob}); }
    Option(Offered) oc = offered_cert(cs, es[i], now);
    Option(CertEntry) named = match oc { None => None, Some(x) => if (hex_encode(x.blob) == hex_encode(blob)) { Some(x.e) } else { None } };
    return match named { None => target_for(es, cs, now, blob, i + 1), Some(x) => Some(Target {.e = es[i], .key = eb, .cert = Some(x), .named = blob}) };
}

// A client that loaded the certificate from a file asks for the
// signature with the key itself, while the user authentication it signs
// names the certificate (OpenSSH does this). That is taken as a request
// for the certificate when it is this key's current one (`oc`); any other
// certificate stays "another key" and is refused.
pub Target for_signed(Target t, Option(Offered) oc, Signed w) {
    Option(CertEntry) tc = t.cert;
    Bool plain = match tc { None => true, Some(_) => false };
    return match oc {
        None => t,
        Some(x) => if (plain && w.kind == "auth" && hex_encode(w.key) == hex_encode(x.blob)) { Target {.e = t.e, .key = t.key, .cert = Some(x.e), .named = x.blob} } else { t }
    };
}

// Each key, after its certificate when it has one valid at `now`.
pub List(Ident) idents_of(List(SshEntry) es, List(CertEntry) cs, Int now, Int i, List(Ident) acc) {
    if (i >= es.len()) { return acc; }
    Option(List(Int)) b = ssh_blob_of_line(es[i].line);
    Option(Offered) oc = offered_cert(cs, es[i], now);
    List(Ident) cert = match oc { None => [], Some(x) => [Ident {.blob = x.blob, .comment = es[i].name + " (certificate)"}] };
    List(Ident) more = match b { None => [], Some(x) => cert.concat([Ident {.blob = x, .comment = es[i].name}]) };
    return idents_of(es, cs, now, i + 1, acc.concat(more));
}

pub List(Int) failure() { return agent_msg(msg_failure(), []); }

pub type Reply = { List(Int) out; AgentSession s; };

@requires(filesystem, network, clock, process, environment)
pub Reply answer(Str dir, Str rt, Int pid, AgentSession s, Int t, List(Int) body) { return answer_via(dir, rt, pid, "", s, t, body); }

// `peer` non-empty: the stdio agent (Android), whose consent window the
// platform opens (ask_platform); else the desktop agent's (ask_window).
@requires(filesystem, network, clock, process, environment)
pub Reply answer_via(Str dir, Str rt, Int pid, Str peer, AgentSession s, Int t, List(Int) body) {
    if (t == msg_request_identities()) { return Reply {.out = identities_answer(idents_of(read_index(dir), read_certs(dir), clock_now_seconds(), 0, [])), .s = s}; }
    if (t == msg_extension()) {
        Option(AgentSession) b = checked_bind(body);
        return match b { None => Reply {.out = failure(), .s = s}, Some(x) => Reply {.out = agent_msg(msg_success(), []), .s = x} };
    }
    if (t == msg_sign_request()) { return Reply {.out = sign_reply(dir, rt, pid, peer, s, body), .s = s}; }
    return Reply {.out = failure(), .s = s};
}

@requires(filesystem, network, clock, process, environment)
List(Int) sign_reply(Str dir, Str rt, Int pid, Str peer, AgentSession s, List(Int) body) {
    Option(SignReq) or = sign_req_of(body);
    SignReq r = or else { SignReq {.key = [], .data = [], .flags = 0} };
    Int now = clock_now_seconds();
    List(CertEntry) cs = read_certs(dir);
    Option(Target) ot = target_for(read_index(dir), cs, now, r.key, 0);
    Target t0 = ot else { Target {.e = SshEntry {.name = "", .line = ""}, .key = [], .cert = None, .named = []} };
    SshEntry e = t0.e;
    if (str_len(e.name) == 0) { return failure(); }
    // The request's key (the certificate, when it names one) must be the
    // one the signed data names; the signature is the certified key's.
    Signed w = signed_of(r.data);
    Target tg = for_signed(t0, offered_cert(cs, e, now), w);
    if (str_len(refused(s, tg.named, w)) > 0) { return failure(); }
    Str alg = rsa_alg_of(tg.key, r.flags);
    if (alg == "refused") { return failure(); }
    Str cert = cert_json(tg.cert, now);
    List(Int) sig = if (str_len(peer) > 0) { ask_platform(e, w, s, peer, r.data, rt, alg, cert) } else { ask_window(e, w, s, pid, r.data, rt, alg, cert) };
    if (sig.len() == 0 || !verifies(tg.key, r.data, sig)) { return failure(); }
    return agent_msg(msg_sign_response(), sstring(sig));
}

// ============================================================================
// Connections
// ============================================================================

// The next message's type and body, or type -1 at EOF, on a bad length or
// after `idle` ms without one.
pub type Msg = { Int t; List(Int) body; };

@requires(network)
List(Int) read_exact(Int fd, Int n, List(Int) acc) {
    if (acc.len() >= n) { return acc; }
    List(Int) chunk = resid_unix_recv_some(fd, n - acc.len());
    if (chunk.len() == 0) { return acc; }
    return read_exact(fd, n, acc.concat(chunk));
}

@requires(network)
Msg read_msg(Int fd) {
    _ = resid_unix_deadline(fd, 30000);
    Int n = msg_len(read_exact(fd, 4, []));
    if (n < 0) { return Msg {.t = -1, .body = []}; }
    List(Int) b = read_exact(fd, n, []);
    if (b.len() != n) { return Msg {.t = -1, .body = []}; }
    return Msg {.t = b[0], .body = b[1..n]};
}

@requires(filesystem, network, clock, process, environment)
Int serve_conn(Str dir, Str rt, Int fd, Int pid, AgentSession s) {
    Msg m = read_msg(fd);
    if (m.t < 0) { return 0; }
    Reply r = answer(dir, rt, pid, s, m.t, m.body);
    if (!resid_unix_send(fd, r.out)) { return 0; }
    return serve_conn(dir, rt, fd, pid, r.s);
}

// One connection at a time; the loop carries only scalars and strings.
@requires(filesystem, network, clock, process, environment)
Int agent_loop(Str dir, Str rt, Int l) {
    Int c = resid_unix_accept(l);
    if (c < 0) { return 1; }
    List(Int) peer = resid_unix_peer(c);
    Int pid = if (peer.len() == 3) { peer[0] } else { 0 };
    _ = serve_conn(dir, rt, c, pid, unbound());
    _ = resid_unix_close(c);
    return agent_loop(dir, rt, l);
}

// `symbolon ssh-agent DIR [SOCKET]`
@requires(filesystem, network, clock, process, environment)
pub Int ssh_agent(Str dir, Str sock0) {
    Str rt = environment.get("XDG_RUNTIME_DIR");
    if (!word_safe(rt)) { eprintln("ssh-agent: XDG_RUNTIME_DIR is not set (the per-user runtime directory)"); return 2; }
    Str sock = if (str_len(sock0) > 0) { sock0 } else { rt + "/symbolon/ssh-agent.sock" };
    Int l = resid_unix_listen(sock);
    if (l == -2) { eprintln("ssh-agent: another agent answers on " + sock); return 1; }
    if (l == -3) { eprintln("ssh-agent: " + sock + " is in a directory others can reach, or a file that is not this user's socket is there"); return 1; }
    if (l < 0) { eprintln("ssh-agent: cannot listen on " + sock); return 1; }
    println("SSH_AUTH_SOCK=" + sock + "; export SSH_AUTH_SOCK;");
    return agent_loop(dir, rt, l);
}

// ============================================================================
// One connection on standard input and output (Android, SPEC 16.1.1)
// ============================================================================

// `symbolon ssh-agent-stdio DIR RUNDIR PEER`: the agent for one client
// connection, its messages on standard input and replies on standard
// output; started by Symbolon's agent service for each connection of an
// app it verified (PEER names it: label and package). RUNDIR holds the
// per-request consent files and sockets (0700, the app's own). It ends at
// the end of its input; the service closes that after 30 seconds without a
// message outside a pending consent.

@requires(network)
List(Int) stdin_until(Int n, List(Int) acc) {
    if (acc.len() >= n) { return acc; }
    List(Int) more = resid_read_some(65536);
    if (more.len() == 0) { return acc; }
    return stdin_until(n, acc.concat(more));
}

pub type StdMsg = { Int t; List(Int) body; List(Int) rest; };

@requires(network)
StdMsg stdin_msg(List(Int) buf) {
    List(Int) h = stdin_until(4, buf);
    if (h.len() < 4) { return StdMsg {.t = -1, .body = [], .rest = []}; }
    Int n = msg_len(h[0..4]);
    if (n < 0) { return StdMsg {.t = -1, .body = [], .rest = []}; }
    List(Int) b = stdin_until(4 + n, h);
    if (b.len() < 4 + n) { return StdMsg {.t = -1, .body = [], .rest = []}; }
    return StdMsg {.t = b[4], .body = b[5..4 + n], .rest = b[4 + n..b.len()]};
}

@requires(filesystem, network, clock, process, environment)
Int serve_stdio(Str dir, Str rt, Str peer, AgentSession s, List(Int) buf) {
    StdMsg m = stdin_msg(buf);
    if (m.t < 0) { return 0; }
    Reply r = answer_via(dir, rt, 0, peer, s, m.t, m.body);
    _ = print_bytes(r.out);
    return serve_stdio(dir, rt, peer, r.s, m.rest);
}

@requires(filesystem, network, clock, process, environment)
pub Int ssh_agent_stdio(Str dir, Str rt, Str peer) {
    if (!word_safe(rt) || str_len(peer) == 0 || str_len(peer) > 300 || str_contains(peer, "\n")) { eprintln("ssh-agent-stdio: give DIR RUNDIR PEER"); return 2; }
    return serve_stdio(dir, rt, peer, unbound(), []);
}
