test "p384: ssh-keygen's certificate is the one Symbolon builds from the same nonce, serial and times" {
    CertSpec spec = CertSpec {.nonce = [130, 51, 117, 156, 12, 28, 24, 190, 54, 141, 73, 111, 246, 59, 133, 36, 205, 29, 246, 179, 226, 111, 27, 71, 144, 118, 24, 86, 190, 65, 202, 57], .serial = [0, 0, 11, 58, 115, 206, 47, 242], .key_id = "symbolon:p384", .principals = ["alice", "bob"], .valid_after = 0, .valid_before = 9223372036854775807};
    expect(spec.valid_after).toEqual(0);
    expect(cert_alg_of(pub_of("ecdsa-sha2-nistp384 AAAAE2VjZHNhLXNoYTItbmlzdHAzODQAAAAIbmlzdHAzODQAAABhBOCP3fck/VMLfipB4NKiQQOHQNBaE6lVVOx+gzVro8RPxHSfQiMaocWSS6mAAkCzRqZUgrRJL/uzv9X1/stPqu3iu3/AwZXaaH79vh+4vohxQb14ES3L8JyowKnlmt3+RA== p384@test").alg)).toEqual("ecdsa-sha2-nistp384-cert-v01@openssh.com");
    expect(hx(cert_extensions())).toEqual("000000167065726d69742d706f72742d666f7277617264696e67000000000000000a7065726d69742d70747900000000");
}

