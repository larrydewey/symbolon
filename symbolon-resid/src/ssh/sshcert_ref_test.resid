test "rsa: ssh-keygen's certificate is the one Symbolon builds from the same nonce, serial and times" {
    CertSpec spec = CertSpec {.nonce = [101, 70, 247, 198, 25, 120, 125, 50, 50, 21, 34, 25, 218, 6, 211, 94, 226, 172, 4, 17, 33, 72, 126, 86, 88, 199, 221, 8, 110, 241, 43, 14], .serial = [0, 0, 11, 58, 115, 206, 47, 242], .key_id = "symbolon:rsa", .principals = ["alice", "bob"], .valid_after = 1795560930, .valid_before = 1798153230};
    expect(hx(cert_tbs(pub_of("ssh-rsa  rsa@test"), spec, blob_of("ecdsa-sha2-nistp256 AAAAE2VjZHNhLXNoYTItbmlzdHAyNTYAAAAIbmlzdHAyNTYAAABBBO8fRKeFzK0BB7t7WHCjKieTuiAkXO6Jru5kRHQL1Hrh0TCGpew3TmSq3vB1zjG2B8db38jIoAd0JY1OyOhZOq8= ca@test")))).toEqual("");
    expect(cert_alg_of(pub_of("ssh-rsa  rsa@test").alg)).toEqual("ssh-rsa-cert-v01@openssh.com");
    expect(hx(cert_extensions())).toEqual("000000167065726d69742d706f72742d666f7277617264696e67000000000000000a7065726d69742d70747900000000");
}

