    expect(hx(cert_tbs(pub_of("ecdsa-sha2-nistp256 AAAAE2VjZHNhLXNoYTItbmlzdHAyNTYAAAAIbmlzdHAyNTYAAABBBP2koME6Eb5n0k0a54SnGb7BT7BSBajagUwMgK0ymLvPYTER7wiaH5fDSQ3mPUBBjtLF6vNW4gZY3x35j8RNdm8= p256@test"), spec, blob_of("ecdsa-sha2-nistp256 AAAAE2VjZHNhLXNoYTItbmlzdHAyNTYAAAAIbmlzdHAyNTYAAABBBO8fRKeFzK0BB7t7WHCjKieTuiAkXO6Jru5kRHQL1Hrh0TCGpew3TmSq3vB1zjG2B8db38jIoAd0JY1OyOhZOq8= ca@test")))).toEqual("");
