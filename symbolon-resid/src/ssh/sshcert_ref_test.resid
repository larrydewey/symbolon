test "a certificate is current within its times and due with a third of its life left" {
    SshCert c = cert_or_none(cert_of_line("ssh-ed25519-cert-v01@openssh.com  ed@test"));
    expect(cert_current(c, 1795560930)).toBeTrue();
    expect(cert_current(c, 1795560929)).toBeFalse();
    expect(cert_current(c, 1798153230)).toBeFalse();
    expect(cert_due(c, 1795561530)).toBeFalse();
    expect(cert_due(c, 1797289129)).toBeFalse();
    expect(cert_due(c, 1797289130)).toBeTrue();
    expect(cert_due(c, 1798153231)).toBeTrue();
    expect(u64_val([255, 255, 255, 255, 255, 255, 255, 255])).toEqual(9223372036854775807);
    expect(hx(u64_be(1700000000))).toEqual("000000006553f100");
}

test "principals are user names, safe in authorized_keys and a shell" {
    expect(principal_ok("alice")).toBeTrue();
    expect(principal_ok("git")).toBeTrue();
    expect(principal_ok("a.b-c_d@e+f")).toBeTrue();
    expect(principal_ok("")).toBeFalse();
    expect(principal_ok("a,b")).toBeFalse();
    expect(principal_ok("a b")).toBeFalse();
    expect(principal_ok("a\"b")).toBeFalse();
    expect(principal_ok("a'b")).toBeFalse();
    expect(principal_ok("a*")).toBeFalse();
    expect(principal_ok("xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx")).toBeTrue();
    expect(principal_ok("xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx")).toBeFalse();
    CertOpts o = cert_opts(["--principal", "alice", "--days", "7", "--principal", "bob", "--principal", "alice"], 0, CertOpts {.principals = [], .days = 30, .err = ""});
    expect(o.err).toEqual("");
    expect(o.days).toEqual(7);
    expect(o.principals.len()).toEqual(2);
    expect(cert_opts(["--days", "367"], 0, CertOpts {.principals = [], .days = 30, .err = ""}).err).toEqual("--days takes 1 to 366");
    expect(cert_opts(["--days", "0"], 0, CertOpts {.principals = [], .days = 30, .err = ""}).err).toEqual("--days takes 1 to 366");
    expect(str_len(cert_opts(["--principal", "a,b"], 0, CertOpts {.principals = [], .days = 30, .err = ""}).err) > 0).toBeTrue();
    expect(str_len(cert_opts(["--force"], 0, CertOpts {.principals = [], .days = 30, .err = ""}).err) > 0).toBeTrue();
}

test "the certificate list is read and written back the same" {
    List(CertEntry) es = certs_of("6d79206b6579 6361 30 alice,bob 1795560930 1798153230 ssh-ed25519-cert-v01@openssh.com  ed@test\nnot a line\n");
    expect(es.len()).toEqual(1);
    expect(es[0].key).toEqual("my key");
    expect(es[0].ca).toEqual("ca");
    expect(es[0].days).toEqual(30);
    expect(es[0].principals.len()).toEqual(2);
    expect(es[0].valid_before).toEqual(1798153230);
    expect(es[0].line).toEqual("ssh-ed25519-cert-v01@openssh.com  ed@test");
    expect(cert_text(es[0])).toEqual("6d79206b6579 6361 30 alice,bob 1795560930 1798153230 ssh-ed25519-cert-v01@openssh.com  ed@test");
}

test "the agent offers a current certificate before its key, and signs for it with the key" {
    List(SshEntry) keys = [SshEntry {.name = "my key", .line = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIIs3b7WFOgvK0u/miihnx1F0+rzxexDW44kJIVD19sCX ed@test"}];
    List(CertEntry) cs = certs_of("6d79206b6579 6361 30 alice,bob 1795560930 1798153230 ssh-ed25519-cert-v01@openssh.com  ed@test");
    List(Ident) now_ids = idents_of(keys, cs, 1795560990, 0, []);
    expect(now_ids.len()).toEqual(2);
    expect(hx(now_ids[0].blob)).toEqual("");
    expect(now_ids[0].comment).toEqual("my key (certificate)");
    expect(hx(now_ids[1].blob)).toEqual("0000000b7373682d65643235353139000000208b376fb5853a0bcad2efe68a2867c75174fabcf17b10d6e389092150f5f6c097");
    expect(now_ids[1].comment).toEqual("my key");
    // Expired, or not yet valid: the key alone.
    expect(idents_of(keys, cs, 1798153230, 0, []).len()).toEqual(1);
    expect(idents_of(keys, cs, 1795560929, 0, []).len()).toEqual(1);
    // A certificate listed for another key is not offered.
