// OpenSSH certificates (src/ssh/sshcert.resid) against ssh-keygen -s
// (tests/gen_sshcert_ref.py), and the certificate list and what the agent
// offers from it. Generated; do not edit by hand.

import "sshcert.resid";
import "sshwire.resid";
import "agentd.resid";
import "../agent/sshcli.resid";
import "crypto.resid";

Str hx(List(Int) b) { return hex_encode(b); }
List(Int) blob_of(Str line) { Option(List(Int)) b = ssh_blob_of_line(line); return b else { [] }; }
List(Int) cblob_of(Str line) { Option(List(Int)) b = cert_blob_of_line(line); return b else { [] }; }
SshPub pub_of(Str line) { Option(SshPub) k = pub_of_blob(blob_of(line)); return k else { no_pub() }; }
SshCert cert_or_none(Option(SshCert) c) { return c else { SshCert {.alg = "none", .key_blob = [], .nonce = [], .serial = [], .kind = 0, .key_id = "", .principals = [], .valid_after = 0, .valid_before = 0, .critical = [], .extensions = [], .ca_blob = [], .tbs = [], .sig = []} }; }
Bool none_c(Option(SshCert) c) { return match c { None => true, Some(_) => false }; }

test "ed: ssh-keygen's certificate is the one Symbolon builds from the same nonce, serial and times" {
    CertSpec spec = CertSpec {.nonce = [45, 145, 193, 35, 171, 112, 195, 28, 130, 118, 75, 139, 244, 65, 159, 185, 132, 53, 104, 208, 187, 165, 17, 103, 239, 111, 215, 146, 66, 63, 15, 234], .serial = [0, 0, 11, 58, 115, 206, 47, 242], .key_id = "symbolon:ed", .principals = ["alice", "bob"], .valid_after = 1795560930, .valid_before = 1798153230};
    expect(hx(cert_tbs(pub_of("ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIIs3b7WFOgvK0u/miihnx1F0+rzxexDW44kJIVD19sCX ed@test"), spec, blob_of("ecdsa-sha2-nistp256 AAAAE2VjZHNhLXNoYTItbmlzdHAyNTYAAAAIbmlzdHAyNTYAAABBBO8fRKeFzK0BB7t7WHCjKieTuiAkXO6Jru5kRHQL1Hrh0TCGpew3TmSq3vB1zjG2B8db38jIoAd0JY1OyOhZOq8= ca@test")))).toEqual("");
    expect(cert_alg_of(pub_of("ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIIs3b7WFOgvK0u/miihnx1F0+rzxexDW44kJIVD19sCX ed@test").alg)).toEqual("ssh-ed25519-cert-v01@openssh.com");
    expect(hx(cert_extensions())).toEqual("000000167065726d69742d706f72742d666f7277617264696e67000000000000000a7065726d69742d70747900000000");
}

test "ed: the certificate reads back, and its signature is its authority's" {
    SshCert c = cert_or_none(cert_of_line("ssh-ed25519-cert-v01@openssh.com  ed@test"));
    expect(c.alg).toEqual("ssh-ed25519-cert-v01@openssh.com");
    expect(hx(c.key_blob)).toEqual("0000000b7373682d65643235353139000000208b376fb5853a0bcad2efe68a2867c75174fabcf17b10d6e389092150f5f6c097");
    expect(hx(c.ca_blob)).toEqual("0000001365636473612d736861322d6e69737470323536000000086e697374703235360000004104ef1f44a785ccad0107bb7b5870a32a2793ba20245cee89aeee6444740bd47ae1d13086a5ec374e64aadef075ce31b607c75bdfc8c8a00774258d4ec8e8593aaf");
    expect(c.kind).toEqual(1);
    expect(c.key_id).toEqual("symbolon:ed");
    expect(c.principals.len()).toEqual(2);
    expect(c.principals[0]).toEqual("alice");
    expect(c.principals[1]).toEqual("bob");
    expect(c.valid_after).toEqual(1795560930);
    expect(c.valid_before).toEqual(1798153230);
    expect(hx(c.tbs)).toEqual("");
    expect(cert_signed(c)).toBeTrue();
