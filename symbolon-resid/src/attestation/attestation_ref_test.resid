    Bool pinned = match build_pinned(record(), [[103, 108, 252, 113, 35, 148, 181, 244, 96, 82, 89, 66, 24, 186, 23, 180, 167, 185, 63, 49, 73, 185, 65, 112, 95, 211, 221, 5, 56, 246, 8, 145], [13, 102, 204, 239, 240, 63, 58, 72, 214, 1, 40, 32, 6, 254, 155, 252, 12, 96, 93, 27, 102, 143, 0, 190, 116, 76, 224, 156, 73, 70, 129, 177]]) { Ok(_) => true, Err(_) => false };
