// JSON (src/browser/json.resid) against Python's json module
// (tests/gen_json_ref.py). Generated; do not edit by hand.

import "json.resid";
import "crypto.resid";
import "httpserv.resid";

Str hx(List(Int) b) { return hex_encode(b); }
Str txt(List(Int) b) { return http_text(b, 0, b.len()); }

Option(Jv) at(List(Int) doc, List(Str) path) {
    Option(Jv) v = json_parse(doc);
    return match v { None => None, Some(x) => jpath(x, path, 0) };
}

Bool rejects(List(Int) doc) { return match json_parse(doc) { None => true, Some(_) => false }; }

test "strings are quoted as Python's json.dumps quotes them" {
    expect(hx(json_utf8(json_quote(txt([112, 108, 97, 105, 110]))))).toEqual("22706c61696e22");
    expect(hx(json_utf8(json_quote(txt([115, 97, 121, 32, 34, 104, 105, 34]))))).toEqual("22736179205c2268695c2222");
    expect(hx(json_utf8(json_quote(txt([98, 97, 99, 107, 92, 115, 108, 97, 115, 104]))))).toEqual("226261636b5c5c736c61736822");
    expect(hx(json_utf8(json_quote(txt([108, 105, 110, 101, 10, 98, 114, 101, 97, 107, 9, 116, 97, 98]))))).toEqual("226c696e655c6e627265616b5c7474616222");
    expect(hx(json_utf8(json_quote(txt([99, 116, 108, 1, 31, 127]))))).toEqual("2263746c5c75303030315c75303031667f22");
    expect(hx(json_utf8(json_quote(txt([99, 97, 102, 195, 169, 32, 226, 152, 131, 32, 240, 159, 152, 128]))))).toEqual("22636166c3a920e2988320f09f988022");
}

test "values are read at member paths as Python's json.loads reads them" {
    expect(hx(json_utf8(jstr(at([123, 34, 105, 100, 34, 58, 55, 44, 34, 114, 101, 115, 117, 108, 116, 34, 58, 123, 34, 114, 101, 115, 117, 108, 116, 34, 58, 123, 34, 116, 121, 112, 101, 34, 58, 34, 115, 116, 114, 105, 110, 103, 34, 44, 34, 118, 97, 108, 117, 101, 34, 58, 34, 97, 92, 34, 98, 92, 117, 48, 48, 101, 57, 92, 117, 100, 56, 51, 100, 92, 117, 100, 101, 48, 48, 34, 125, 125, 125], ["result", "result", "value"]))))).toEqual("612262c3a9f09f9880");
    expect(hx(json_utf8(jstr(at([123, 34, 105, 100, 34, 58, 32, 49, 50, 44, 32, 34, 115, 101, 115, 115, 105, 111, 110, 73, 100, 34, 58, 32, 34, 65, 66, 49, 50, 34, 44, 32, 34, 112, 97, 114, 97, 109, 115, 34, 58, 32, 123, 34, 120, 34, 58, 32, 91, 49, 44, 32, 50, 44, 32, 123, 34, 121, 34, 58, 32, 110, 117, 108, 108, 125, 93, 44, 32, 34, 111, 107, 34, 58, 32, 116, 114, 117, 101, 125, 125], ["sessionId"]))))).toEqual("41423132");
    expect(hx(json_utf8(jstr(at([32, 32, 123, 34, 109, 101, 116, 104, 111, 100, 34, 58, 34, 84, 97, 114, 103, 101, 116, 46, 97, 116, 116, 97, 99, 104, 101, 100, 84, 111, 84, 97, 114, 103, 101, 116, 34, 44, 34, 112, 97, 114, 97, 109, 115, 34, 58, 123, 34, 115, 101, 115, 115, 105, 111, 110, 73, 100, 34, 58, 34, 83, 49, 34, 44, 34, 116, 97, 114, 103, 101, 116, 73, 110, 102, 111, 34, 58, 123, 34, 117, 114, 108, 34, 58, 34, 97, 98, 111, 117, 116, 58, 98, 108, 97, 110, 107, 34, 125, 125, 125, 32], ["params", "targetInfo", "url"]))))).toEqual("61626f75743a626c616e6b");
    expect(jint(at([123, 34, 105, 100, 34, 58, 32, 49, 50, 44, 32, 34, 115, 101, 115, 115, 105, 111, 110, 73, 100, 34, 58, 32, 34, 65, 66, 49, 50, 34, 44, 32, 34, 112, 97, 114, 97, 109, 115, 34, 58, 32, 123, 34, 120, 34, 58, 32, 91, 49, 44, 32, 50, 44, 32, 123, 34, 121, 34, 58, 32, 110, 117, 108, 108, 125, 93, 44, 32, 34, 111, 107, 34, 58, 32, 116, 114, 117, 101, 125, 125], ["id"]))).toEqual(12);
    expect(jbool(at([123, 34, 105, 100, 34, 58, 32, 49, 50, 44, 32, 34, 115, 101, 115, 115, 105, 111, 110, 73, 100, 34, 58, 32, 34, 65, 66, 49, 50, 34, 44, 32, 34, 112, 97, 114, 97, 109, 115, 34, 58, 32, 123, 34, 120, 34, 58, 32, 91, 49, 44, 32, 50, 44, 32, 123, 34, 121, 34, 58, 32, 110, 117, 108, 108, 125, 93, 44, 32, 34, 111, 107, 34, 58, 32, 116, 114, 117, 101, 125, 125], ["params", "ok"]))).toBeTrue();
}

test "malformed JSON and nesting deeper than 64 are refused" {
    expect(rejects([123, 34, 97, 34, 58, 49, 44, 125])).toBeTrue();
    expect(rejects([91, 49, 32, 50, 93])).toBeTrue();
    expect(rejects([123, 34, 97, 34, 32, 49, 125])).toBeTrue();
    expect(rejects([34, 111, 112, 101, 110])).toBeTrue();
    expect(rejects([123, 34, 97, 34, 58, 49, 125, 32, 120])).toBeTrue();
    expect(rejects([1])).toBeTrue();
    expect(rejects([123, 34, 97, 34, 58, 34, 1, 34, 125])).toBeTrue();
    expect(rejects([91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 91, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93, 93])).toBeTrue();
    expect(rejects([])).toBeTrue();
}

test "a quoted string parses back to itself" {
    Str s = txt([99, 116, 108, 1, 31, 127, 32, 34, 113, 34, 32, 92, 32, 99, 97, 102, 195, 169]);
    expect(hx(json_utf8(jstr(json_parse(json_utf8(json_quote(s))))))).toEqual(hx(json_utf8(s)));
}
