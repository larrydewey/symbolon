// The WebSocket framing (src/browser/ws.resid) against frames and the
// accept value made by Python (hashlib, base64) in tests/gen_ws_ref.py.
// Generated; do not edit by hand.

import "ws.resid";
import "httpserv.resid";

test "Sec-WebSocket-Accept is RFC 6455's example value" {
    expect(ws_accept_of("dGhlIHNhbXBsZSBub25jZQ==")).toEqual("s3pPLMBiTxaQ9kYGzzhZRbK+xOo=");
}

Str text_of(Frame f) { return http_text(f.payload, 0, f.payload.len()); }

test "frames of each length form parse; short buffers ask for more" {
    Frame a = frame_at([129, 8, 123, 34, 105, 100, 34, 58, 49, 125]);
    expect(text_of(a)).toEqual("{\"id\":1}");
    expect(a.used).toEqual(10);
    expect(frame_at([129, 126, 1, 44, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121, 121]).payload.len()).toEqual(300);
    expect(frame_at([129, 127, 0, 0, 0, 0, 0, 1, 17, 112, 120, 120, 120, 120, 120, 120, 120, 120, 120, 120]).need).toEqual(69990);
    expect(text_of(frame_at([129, 131, 1, 2, 3, 4, 96, 96, 96]))).toEqual("abc");
    expect(frame_at([129]).need).toEqual(1);
}

test "fragments: the first frame is not final, the continuation is" {
    List(Int) b = [1, 6, 123, 34, 105, 100, 34, 58, 128, 2, 50, 125];
    Frame a = frame_at(b);
    expect(a.fin).toBeFalse();
    Frame c = frame_at(b[a.used..b.len()]);
    expect(c.fin).toBeTrue();
    expect(c.opcode).toEqual(0);
}
