    if (b.len() == 0 || b.len() > 65536 || !cbor_well_formed(b, 4)) { return None; }
    Result(OrgAttestResponse, SerialError) r = from_cbor(b);
    return match r { Ok(x) => Some(x), Err(_) => None };
