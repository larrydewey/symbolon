pub OrgEscrow escrow_signed(OrgEscrow e, List(Int) sig) {
    return OrgEscrow {.org_id = e.org_id, .coll_id = e.coll_id, .owner = e.owner, .roster_version = e.roster_version, .enc = e.enc, .ct = e.ct,
                      .log_sequence = e.log_sequence, .signer = e.signer, .sig = sig};
}

pub OrgRecoveryRequest recreq_signed(OrgRecoveryRequest q, List(Int) sig) {
    return OrgRecoveryRequest {.org_id = q.org_id, .coll_id = q.coll_id, .requester = q.requester, .time = q.time, .log_sequence = q.log_sequence, .signer = q.signer, .sig = sig};
}

pub List(Int) escrow_tbs(OrgEscrow e) { return utf8("symbolon v1 escrow").concat(cbor_bytes(to_cbor(escrow_signed(e, [])))); }
pub List(Int) recreq_tbs(OrgRecoveryRequest q) { return utf8("symbolon v1 recovery request").concat(cbor_bytes(to_cbor(recreq_signed(q, [])))); }

// What the escrowed key is sealed under (HPKE info).
pub List(Int) escrow_info(List(Int) org, List(Int) cid, UInt(64) version) {
    return utf8("symbolon v1 escrow").concat(org).concat(cid).concat(utf8(f"{version}"));
}

pub Str escrow_blob(List(Int) org, Str cid) { return "escrow-" + hex_encode(org) + "-" + cid; }
pub Str recreq_blob(List(Int) org, Str cid) { return "recreq-" + hex_encode(org) + "-" + cid; }

pub Option(OrgConsoleKey) conkey_of(List(Int) b) {
    if (b.len() == 0 || b.len() > 8192 || !cbor_well_formed(b, 4)) { return None; }
    Result(OrgConsoleKey, SerialError) r = from_cbor(b);
    return match r { Ok(x) => Some(x), Err(_) => None };
}

pub OrgConsoleKey conkey_signed(OrgConsoleKey k, List(Int) sig) {
    return OrgConsoleKey {.org_id = k.org_id, .cred_id = k.cred_id, .public_key = k.public_key, .rp_id = k.rp_id, .log_id = k.log_id, .log_sequence = k.log_sequence, .signer = k.signer, .sig = sig};
}

pub List(Int) conkey_tbs(OrgConsoleKey k) { return utf8("symbolon v1 console key").concat(cbor_bytes(to_cbor(conkey_signed(k, [])))); }
pub Str conkey_blob(List(Int) org, List(Int) cred_id) { return "conkey-" + hex_encode(org) + "-" + hex_encode(sha256_bytes(cred_id)[0..16]); }

