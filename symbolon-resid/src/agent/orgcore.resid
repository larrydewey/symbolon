    if (b.len() == 0 || b.len() > 65536 || !cbor_well_formed(b, 6)) { return None; }
    Result(OrgEscrow, SerialError) r = from_cbor(b);
    return match r { Ok(x) => Some(x), Err(_) => None };
}

pub Option(OrgRecoveryRequest) recreq_of(List(Int) b) {
    if (b.len() == 0 || b.len() > 65536 || !cbor_well_formed(b, 6)) { return None; }
    Result(OrgRecoveryRequest, SerialError) r = from_cbor(b);
    return match r { Ok(x) => Some(x), Err(_) => None };
