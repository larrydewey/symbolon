    if (b.len() == 0 || b.len() > 262144 || !cbor_well_formed(b, 6)) { return None; }
    Result(OrgAttestEvidence, SerialError) r = from_cbor(b);
    return match r { Ok(x) => Some(x), Err(_) => None };
}

