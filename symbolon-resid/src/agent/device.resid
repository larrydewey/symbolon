import "../threshold/keygen.resid";
import "../recovery/recovery.resid";
import "../duress/duress.resid";
import "../vault/vault.resid";
import "../net/proto.resid";
import "../net/services.resid";
import "state.resid";
import "common.resid";
import "../ssh/sshwire.resid";
import "fidokey.resid";
import "session.resid";
import "cosignerd.resid";
import "duresscli.resid";
import "keystore.resid";
import "cggmp_store.resid";
import "kvagent.resid";
import "nfmark.resid";
import "nextshare.resid";
import "../vault/kvshare.resid";
import "dev/tpm.resid";
import "dev/tpm_wire.resid";
import "hpkeg.resid";
import "kitpass.resid";
import "word.resid";
import "ecdsa.resid";
import "crypto.resid";
import "clock.resid";
import "epochfiles.resid";

Int srk_handle() { return 0x81000110; }
Int dk_handle() { return 0x81000111; }
Int unlock_a_handle() { return 0x81000112; }
Int unlock_b_handle() { return 0x81000113; }
// The device key of format 2 (authValue from the DEK): it never moves.
pub Int dk_v2_handle() { return 0x81000311; }
// The persistent handles an unlock key can be at: a PIN change, under
// either PIN, moves the profile's key to a random free one, so neither the
// handle nor the configuration field says whose it is.
pub List(Int) unlock_pool() { return [unlock_a_handle(), unlock_a_handle() + 256, unlock_b_handle(), unlock_b_handle() + 256]; }

pub Endpoint relay_ep(DeviceConfig c) { return Endpoint {.host = c.relay_host, .port = c.relay_port, .ca = c.ca, .token = ""}; }

// ─── The relay's sign-in (SPEC 29.4) ────────────────────────────
// The relay takes writes only from a device that signed in: the device
// signs the relay's challenge, with the relay's name, and the relay
// answers a session for seven days (dir/relay.token, "TOKEN UNTIL"). A
// device signs in again when its PIN unlocks it and the session is a day
// old; under the duress PIN it keeps the one it has.

pub Int resign_secs() { return 86400; }

@requires(filesystem, clock(readonly))
pub Bool session_fresh(Str dir) {
    List(Str) p = str_split(str_trim(filesystem.read_all(dir + "/relay.token")), " ");
    return p.len() == 2 && str_len(p[0]) == 64 && str_parse_int(p[1]) - 604800 + resign_secs() > clock_now_seconds();
}

@requires(filesystem, network, device, declassify, clock, environment)
pub Result(Int, Str) relay_sign_in(Str dir, DeviceConfig c, Unlocked u) {
    Endpoint e = relay_ep(c);
    HttpOut ch = http_call_ep(e, "GET", "/auth/challenge", []);
    Str chal = str_trim(http_text(ch.body, 0, ch.body.len()));
    if (ch.status != 200 || str_len(chal) != 64) { return Err("the relay gave no sign-in challenge"); }
    Str name = relay_name(c.relay_host, c.relay_port);
    List(Int) sig = dk_sign(c, u.real, u.st, relay_auth_message(name, cose_hex_decode(chal)))?;
    HttpOut r = http_call_ep(e, "POST", "/auth", http_bytes(chal + " " + hex_encode(c.log_id) + " " + hex_encode(c.party) + " " + hex_encode(sig) + " " + name));
    Str t = str_trim(http_text(r.body, 0, r.body.len()));
    if (r.status != 200 || str_len(t) < 66) { return Err(f"the relay refused the sign-in ({r.status})"); }
    // A bearer session: readable by its owner only (0600).
    return if (filesystem.write_secret(dir + "/relay.token", str_to_bytes(t))) { Ok(0) } else { Err("cannot store the relay session") };
}

// The relay with this device's session, for a write: signed in again
// first when the session is old and the PIN is the real one.
@requires(filesystem, network, device, declassify, clock, environment)
pub Endpoint relay_session(Str dir, DeviceConfig c, Unlocked u) {
    Int signed = if (u.kind == 1 && !session_fresh(dir)) { match relay_sign_in(dir, c, u) { Ok(_) => 0, Err(_) => 1 } } else { 0 };
    List(Str) p = str_split(str_trim(filesystem.read_all(dir + "/relay.token")), " ");
    return Endpoint {.host = c.relay_host, .port = c.relay_port, .ca = c.ca, .token = if (p.len() >= 1 && str_len(p[0]) == 64) { p[0] } else { "" }};
}

// ─── Mail sessions (SPEC 20.2) ──────────────────────────────────
// The relay takes a mailbox message only from a party of the recipient's
// log, named by the request's bearer session: this device's sign-in
// (relay.token), or, while it is not yet one of its log's devices (being
// enrolled, recovering), a mail session (relay.mtoken, "TOKEN UNTIL",
// POST /auth/mail). Before the log exists (inception), posts go without a
// session to mailboxes their owners opened.

// The relay with the session this device has for mail, read from its
// files only: the duress profile, which signs nothing in, uses it as is.
@requires(filesystem, clock(readonly))
pub Endpoint mail_relay(Str dir, DeviceConfig c) {
    Str t = live_token(dir + "/relay.token");
    return Endpoint {.host = c.relay_host, .port = c.relay_port, .ca = c.ca, .token = if (str_len(t) > 0) { t } else { live_token(dir + "/relay.mtoken") }};
}

// The token in a "TOKEN UNTIL" file while it has more than an hour left.
@requires(filesystem, clock(readonly))
Str live_token(Str f) {
    List(Str) p = str_split(str_trim(filesystem.read_all(f)), " ");
    return if (p.len() == 2 && str_len(p[0]) == 64 && str_parse_int(p[1]) > clock_now_seconds() + 3600) { p[0] } else { "" };
}

// The relay for mail under the real PIN: signed in again when the session
// is old; a device that is not one of its log's devices yet takes a mail
// session. With no log yet, no session.
@requires(filesystem, network, device, declassify, clock, environment)
pub Endpoint mail_ep(Str dir, DeviceConfig c, Unlocked u) {
    if (c.log_id.len() == 0) { return relay_ep(c); }
    if (u.kind != 1) { return mail_relay(dir, c); }
    _ = relay_session(dir, c, u);
    if (str_len(live_token(dir + "/relay.token")) > 0) { return mail_relay(dir, c); }
    _ = if (str_len(live_token(dir + "/relay.mtoken")) == 0) { mail_sign_in_dev(dir, c, u) } else { true };
    return mail_relay(dir, c);
}

@requires(filesystem, network, device, declassify, clock, environment)
Bool mail_sign_in_dev(Str dir, DeviceConfig c, Unlocked u) {
    Endpoint e = relay_ep(c);
    Str chal = relay_challenge(e);
    if (str_len(chal) == 0) { return false; }
    Str name = relay_name(c.relay_host, c.relay_port);
    Result(List(Int), Str) sig = dk_sign(c, u.real, u.st, mail_auth_message(name, cose_hex_decode(chal)));
    List(Int) s = match sig { Ok(x) => x, Err(_) => [] };
    if (s.len() != 64) { return false; }
    Str t = mail_session_from(e, chal, c.log_id, c.party, s, name);
    return str_len(t) > 0 && filesystem.write_secret(dir + "/relay.mtoken", str_to_bytes(t));
}

// Opens this device's mailbox (and its kit's) for an inception: the
// cosigner's messages reach them before there is a log to name them.
@requires(filesystem, network, device, declassify, clock, environment)
Bool open_mailbox_dev(DeviceConfig c, Unlocked u) {
    Int until = clock_now_seconds() + mbox_open_secs();
    Result(List(Int), Str) sig = dk_sign(c, u.real, u.st, mbox_open_message(c.party, until));
    List(Int) s = match sig { Ok(x) => x, Err(_) => [] };
    return s.len() == 64 && mbox_open(relay_ep(c), c.dk_pub, until, s);
}

pub Int dfail(Str m) { eprintln("device: " + m); return 1; }

@requires(filesystem)
pub Bool save_config(Str dir, DeviceConfig c) { return filesystem.write_bytes(dir + "/config.cbor", cbor_of_device(c)); }

@requires(filesystem)
pub Option(DeviceConfig) load_config(Str dir) { return device_of_cbor(get_file(dir + "/config.cbor")); }

// A PIN line from standard input, without its newline; empty at EOF.
pub Str read_pin() {
    Str l = resid_read_line();
    Int n = str_len(l);
    return if (n > 0 && str_slice(l, n - 1, n) == "\n") { str_slice(l, 0, n - 1) } else { l };
}

pub List(Secret(UInt(8))) pin_bytes(Str p) { return secret_bytes(utf8(p)); }

// ─── Profiles ───────────────────────────────────────────────────

@requires(declassify)
pub List(Secret(UInt(8))) stretch(DeviceConfig c, List(Secret(UInt(8))) pin) { return pin_stretch(pin, c.salt, c.argon_m_kib, c.argon_t); }

// The unlock key a PIN gives on this device, or [] when the TPM refuses it.
// TPM mode tries the two unlock keys in a random order, so a wrong-key try
// (counted by the lockout) does not tell which PIN was entered.
@requires(device, declassify, provision, network, environment)
pub List(Secret(UInt(8))) unlock_key_for(DeviceConfig c, List(Secret(UInt(8))) st, Bool a_first) {
    if (c.unprotected) { return unlock_key(st, c.salt); }
    if (on_keystore(c)) { return ks_unlock_key(c, if (a_first) { "unlock_a" } else { "unlock_b" }, st); }
    Int first = if (a_first) { c.tpm_unlock_a } else { c.tpm_unlock_b };
    Int second = if (a_first) { c.tpm_unlock_b } else { c.tpm_unlock_a };
    List(UInt(8)) salt = u8s(c.salt);
    Result(List(Secret(UInt(8))), TpmError) h1 = tpm_hmac(first, st, salt);
    return match h1 {
        Ok(h) => unlock_key(provisioned_key(h, "the TPM's HMAC of the stretched PIN under a TPM-held unlock key"), c.salt),
        Err(_) => match tpm_hmac(second, st, salt) { Ok(h) => unlock_key(provisioned_key(h, "the TPM's HMAC of the stretched PIN under a TPM-held unlock key"), c.salt), Err(_) => [] }
    };
}

pub List(UInt(8)) u8s(List(Int) b) { return u8s_at(b, 0, ListBuf()); }
List(UInt(8)) u8s_at(List(Int) b, Int i, ListBuf(UInt(8)) acc) {
    if (i >= b.len()) { return acc.finish(); }
    return u8s_at(b, i + 1, acc.push((UInt(8))(b[i] & 255)));
}

// The unlock key a PIN gives through one of the two unlock keys: `on_a`,
// the TPM key in tpm_unlock_a (else tpm_unlock_b), or the Keystore's
// unlock_a (else unlock_b); the unprotected profile has one. [] when the
// TPM refuses the PIN. Which of the two is the real profile's is recorded
// only inside the profiles (KeyList.mine, SPEC 9.4).
@requires(device, declassify, provision, network, environment)
pub List(Secret(UInt(8))) unlock_key_at(DeviceConfig c, List(Secret(UInt(8))) st, Bool on_a) {
    if (c.unprotected) { List(Secret(UInt(8))) k = unlock_key(st, c.salt); return k; }
    if (on_keystore(c)) { List(Secret(UInt(8))) k = ks_unlock_key(c, if (on_a) { "unlock_a" } else { "unlock_b" }, st); return k; }
    Result(List(Secret(UInt(8))), TpmError) h = tpm_hmac(if (on_a) { c.tpm_unlock_a } else { c.tpm_unlock_b }, st, u8s(c.salt));
    List(Secret(UInt(8))) none = [];
    List(Secret(UInt(8))) out = match h {
        Ok(x) => unlock_key(provisioned_key(x, "the TPM's HMAC of the stretched PIN under a TPM-held unlock key"), c.salt),
        Err(_) => none
    };
    return out;
}

@requires(filesystem, device, declassify, provision, network, environment, clock)
pub Unlocked unlock_dir(Str dir, DeviceConfig c, Str pin) {
    List(Secret(UInt(8))) st = stretch(c, pin_bytes(pin));
    Bool a_first = (random_bytes(1)[0] & 1) == 0;
    if (keys_v2(dir)) { Unlocked v = unlock_v2(dir, c, st, a_first); return v; }
    // Before format 2: with security keys enrolled (SPEC 9.4) both
    // profiles are sealed under one W, which a present, touched key gives.
    List(Secret(UInt(8))) w = if (keys_enrolled(dir)) { unwrap_key(dir) } else { [] };
    // The Keystore refuses no PIN (it has no auth value): an unlock key
    // that opens neither profile is the other key's, or a wrong PIN.
    if (on_keystore(c)) { return with_wrap(with_stretched(ks_unlock_either(dir, c, st, a_first, w), st), w); }
    List(Secret(UInt(8))) k = unlock_key_for(c, st, a_first);
    if (k.len() == 0) { return unlocked_none(); }
    return with_ukey(with_wrap(with_stretched(unlock(k, read_blob(dir, "a", w), read_blob(dir, "b", w)), st), w), k);
}

@requires(declassify, provision, network, environment, device, filesystem)
Unlocked ks_unlock_either(Str dir, DeviceConfig c, List(Secret(UInt(8))) st, Bool a_first, List(Secret(UInt(8))) w) {
    List(Secret(UInt(8))) k1 = unlock_key_for(c, st, a_first);
    Unlocked u = unlock(k1, read_blob(dir, "a", w), read_blob(dir, "b", w));
    if (u.kind != 0) { return with_ukey(u, k1); }
    List(Secret(UInt(8))) k2 = unlock_key_for(c, st, !a_first);
    return with_ukey(unlock(k2, read_blob(dir, "a", w), read_blob(dir, "b", w)), k2);
}

// The unlock key a PIN gives and the profile file whose list it opens
// (OwnList.which "" when none does: a wrong PIN). TPM mode asks the two
// unlock keys in a random order (unlock_key_for); the Keystore, which
// refuses no PIN, gives a key from each, and the one whose list opens is
// the PIN's.
pub type Found = { List(Secret(UInt(8))) k; OwnList o; };

@requires(filesystem, device, declassify, provision, network, environment)
pub Found find_own(Str dir, DeviceConfig c, List(Secret(UInt(8))) st, Bool a_first) {
    List(Secret(UInt(8))) k1 = if (on_keystore(c)) { unlock_key_at(c, st, a_first) } else { unlock_key_for(c, st, a_first) };
    OwnList o1 = if (k1.len() == 32) { open_own(dir, k1) } else { no_own() };
    if (o1.which != "" || !on_keystore(c)) { return Found {.k = k1, .o = o1}; }
    List(Secret(UInt(8))) k2 = unlock_key_at(c, st, !a_first);
    OwnList o2 = if (k2.len() == 32) { open_own(dir, k2) } else { no_own() };
    return Found {.k = k2, .o = o2};
}

// Format 2 (SPEC 9.4): the PIN opens its profile's key list; the list
// says which security key to touch (none: W is in it), the touch gives W,
// and W the profile's blob. A wrong PIN opens no list, and no key is
// asked for.
@requires(filesystem, device, declassify, provision, network, environment, clock)
Unlocked unlock_v2(Str dir, DeviceConfig c, List(Secret(UInt(8))) st, Bool a_first) {
    Found f = find_own(dir, c, st, a_first);
    OwnList o = f.o;
    if (o.which == "") { return with_stretched(unlocked_none(), st); }
    KeyList l = o.list;
    // The policy this profile shows (fidokey shown_fill): a change acted
    // under the duress PIN acts there too (SPEC 14.2).
    if (str_len(environment.get("SYMBOLON_FILL")) > 0 && shown_fill(dir, l) == "keys" && l.keys.len() == 0) {
        eprintln("device: " + fills_key_refusal());
        return with_stretched(unlocked_none(), st);
    }
    List(Secret(UInt(8))) w = list_wrap(dir, l);
    Unlocked u = unlock(f.k, read_blob(dir, o.which, w), []);
    return with_ukey(with_wrap(with_stretched(u, st), w), f.k);
}

// Whether this profile's unlock key is unlock key "a" (unlock_key_at):
// format 2 records it in the profile's list; before it, the real
// profile's was a, except on a TPM whose fields an interrupted update
// swapped, which the TPM answers.
@requires(filesystem, device, declassify, provision, network, environment)
pub Bool own_on_a(Str dir, DeviceConfig c, Unlocked u) {
    if (keys_v2(dir)) { OwnList o = open_own(dir, u.ukey); return o.list.mine == "a"; }
    if (c.unprotected || on_keystore(c)) { return u.kind == 1; }
    List(Secret(UInt(8))) ka = unlock_key_at(c, u.st, true);
    return ka.len() == 32 && hex_encode(reveal(ka)) == hex_encode(reveal(u.ukey));
}

// The DK's signature over `msg` (ECDSA P-256, SHA-256): the TPM key under
// its PIN policy, the Keystore key, or the unprotected profile's software key.
@requires(device, declassify, network, environment)
pub Result(List(Int), Str) dk_sign(DeviceConfig c, RealProfile p, List(Secret(UInt(8))) st, List(Int) msg) {
    if (c.unprotected) { return Ok(sw_sign(software_key(p.dek, "symbolon v1 software dk"), msg)); }
    if (on_keystore(c)) { return ks_sign(c, msg); }
    // The device key made since format 2 has an authValue from the DEK, so
    // a PIN change does not touch it (SPEC 9.1); one made before has the
    // stretched PIN until `device security-update` moves it.
    List(Secret(UInt(8))) auth = if (c.tpm_dk == dk_v2_handle()) { dk_auth(p.dek) } else { st };
    return match tpm_sign_policy(c.tpm_dk, auth, u8s(sha256_bytes(msg))) { Ok(s) => Ok(ints(s)), Err(e) => Err(tpm_error_text(e)) };
}

// The TPM device key's authValue (format 2): from the real profile's DEK,
// which only the real PIN opens; random when there is none (a duress
// unlock), so the TPM refuses it as it refused the duress PIN before.
@requires(declassify)
pub List(Secret(UInt(8))) dk_auth(List(Secret(UInt(8))) dek) {
    if (dek.len() != 32) { return random_secret(32); }
    List(Secret(UInt(8))) a = hk(dek, "symbolon v1 tpm device key auth", 32);
    return a;
}

// ─── `device new` ───────────────────────────────────────────────

// `symbolon device new DIR RELAY_HOST RELAY_PORT [--unprotected | --keystore] [--fast-kdf]`
// Reads the PIN and a duress PIN (an empty line: none) from standard input;
// makes the device's keys and its two sealed profiles; prints its public
// keys (PartyKeys, CBOR hex) for the cosigner's operator to pair.
@requires(filesystem, device, declassify, provision, network, environment)
pub Int device_new(Str dir, Str host, Int port, Bool unprotected, Bool keystore, Bool fast, Str ca) {
    if (filesystem.exists(dir + "/config.cbor")) { return dfail("already set up"); }
    Str pin = read_pin();
    Str dpin = read_pin();
    return device_new_pins(dir, host, port, unprotected, keystore, fast, ca, pin, dpin);
}

// device new with the PIN and duress PIN already read (device link-new).
@requires(filesystem, device, declassify, provision, network, environment)
pub Int device_new_pins(Str dir, Str host, Int port, Bool unprotected, Bool keystore, Bool fast, Str ca, Str pin, Str dpin) {
    if (filesystem.exists(dir + "/config.cbor")) { return dfail("already set up"); }
    // One TPM holds one Symbolon device: its keys sit at fixed persistent
    // handles. Another device's keys there are never replaced (they would be
    // gone for good); that device is retired with `device forget` first.
    if (!unprotected && !keystore && tpm_taken()) {
        return dfail("this computer's security chip already holds another Symbolon device's keys: retire that device first (symbolon device forget ITS-DIR), or use --unprotected");
    }
    _ = filesystem.create_dir(dir + "/log");
    if (str_len(pin) < 4) { return dfail("a PIN of at least 4 characters"); }
    if (dpin == pin) { return dfail("the duress PIN must differ from the PIN"); }
    List(Int) salt = random_bytes(16);
    List(Secret(UInt(8))) dek = random_secret(32);
    Int m = if (fast) { 64 } else { argon_m_kib() };
    Int t = if (fast) { 1 } else { argon_t() };
    DeviceConfig c0 = DeviceConfig {.relay_host = host, .relay_port = port, .ca = ca, .witnesses = [], .unprotected = unprotected, .argon_m_kib = m, .argon_t = t,
        .salt = salt, .tpm_dk = if (keystore && !unprotected) { keystore_profile() } else { dk_v2_handle() }, .tpm_unlock_a = unlock_a_handle(), .tpm_unlock_b = unlock_b_handle(),
        .party = [], .dk_pub = [], .hpke_pub = device_hpke2(dek).pk, .log_id = [], .mbox_next = 0, .peers = []};
    List(Secret(UInt(8))) st = stretch(c0, pin_bytes(pin));
    List(Secret(UInt(8))) dst = if (str_len(dpin) > 0) { stretch(c0, pin_bytes(dpin)) } else { random_secret(32) };
    Result(List(Int), Str) dk = make_dk(c0, dek, st);
    return match dk {
        Err(e) => dfail(e),
        Ok(pub) => finish_new(dir, c0, pub, dek, st, dst, str_len(dpin) > 0)
    };
}

@requires(device, declassify, network, environment)
Result(List(Int), Str) make_dk(DeviceConfig c, List(Secret(UInt(8))) dek, List(Secret(UInt(8))) st) {
    if (c.unprotected) { return Ok(sw_public(software_key(dek, "symbolon v1 software dk"))); }
    if (on_keystore(c)) { return ks_make_dk(c); }
    _ = tpm_srk_setup(srk_handle());
    Result(TpmBlob, TpmError) b = tpm_create(srk_handle(), tpm_policy_signing_template(tpm_policy_auth_value_digest()), dk_auth(dek));
    return match b {
        Err(e) => Err("TPM: " + tpm_error_text(e)),
        Ok(blob) => match tpm_persist(srk_handle(), blob, c.tpm_dk) {
            Err(e) => Err("TPM: " + tpm_error_text(e)),
            Ok(_) => Ok(public_point(blob.public_area))
        }
    };
}

List(Int) public_point(List(UInt(8)) pa) {
    return match tpm_public_parse(pa) { Ok(k) => [4].concat(ints(k.ecc_x)).concat(ints(k.ecc_y)), Err(_) => [] };
}

@requires(device, declassify)
pub Bool make_unlock_key(Int handle, List(Secret(UInt(8))) auth) {
    return match tpm_create(srk_handle(), tpm_hmac_key_template(), auth) {
        Err(_) => false,
        Ok(b) => match tpm_persist(srk_handle(), b, handle) { Ok(_) => true, Err(_) => false }
    };
}

@requires(filesystem, device, declassify, provision, network, environment)
Int finish_new(Str dir, DeviceConfig c0, List(Int) dk_pub, List(Secret(UInt(8))) dek, List(Secret(UInt(8))) st, List(Secret(UInt(8))) dst, Bool has_duress) {
    if (dk_pub.len() != 65) { return dfail("no device key"); }
    // Which of the two unlock keys (TPM handle field, Keystore alias) is
    // the real profile's is random, and recorded only in the profiles.
    Bool real_on_a = (random_bytes(1)[0] & 1) == 0;
    if (on_keystore(c0) && (!ks_make_hmac(c0, "unlock_a") || !ks_make_hmac(c0, "unlock_b"))) { return dfail("Keystore: cannot make the unlock keys"); }
    if (!c0.unprotected && !on_keystore(c0) && (!make_unlock_key(if (real_on_a) { c0.tpm_unlock_a } else { c0.tpm_unlock_b }, st)
                                              || !make_unlock_key(if (real_on_a) { c0.tpm_unlock_b } else { c0.tpm_unlock_a }, dst))) { return dfail("TPM: cannot make the unlock keys"); }
    DeviceConfig c = with_identity(c0, dk_pub);
    List(Secret(UInt(8))) ka = unlock_key_at(c, st, real_on_a);
    List(Secret(UInt(8))) kb = unlock_key_at(c, dst, !real_on_a);
    HpkeKeyPairG(Secret(UInt(8))) dh = hpkeg_derive_keypair(16, random_secret(32));
    RealProfile real = RealProfile {.share = random_secret(32), .cc = random_secret(32), .vault_key = random_secret(32), .dek = dek,
                                    .duress_hpke_pub = if (has_duress) { dh.pk } else { [] }};
    // The duress profile's 32-byte share field holds the seed of its own
    // transport (HPKE) key, registered with the cosigner with the sub-key
    // (SPEC 9.2, 14.2). It never holds the device's: that key opens the
    // folder-key wraps, kit halves and enrolment and re-share envelopes
    // addressed to the device (D-4).
    DuressFull dur = DuressFull {.share = random_secret(32), .subkey = random_secret(32), .vault_key = random_secret(32), .hpke_priv = dh.sk, .tweaks = []};
    List(Secret(UInt(8))) rp = encode_real(real) else { [] };
    List(Secret(UInt(8))) dp = encode_duress(dur) else { [] };
    List(Int) blob_real = seal_blob(ka, random_bytes(12), rp);
    List(Int) blob_dur = if (has_duress) { seal_blob(kb, random_bytes(12), dp) } else { decoy_blob(random_bytes(blob_len())) };
    List(Int) slot = if (has_duress) { seal_slot(dh.pk, 0, dur, random_secret(32)) else { [] } } else { decoy_slot(random_bytes(slot_len())) };
    // Which file holds the real profile is random and not recorded.
    Bool real_first = (random_bytes(1)[0] & 1) == 0;
    // The duress sub-key's public key and the duress transport key's; a
    // device without a duress PIN has both too, for keys no one holds.
    List(Int) dpub = duress_pub_of(if (has_duress) { dur.subkey } else { random_secret(32) }, if (has_duress) { dur.share } else { random_secret(32) });
    Bool ok = filesystem.write_bytes(dir + "/duress.pub", dpub) && write_profiles(dir, if (real_first) { "a" } else { "b" }, ka, kb, blob_real, blob_dur, real_on_a, has_duress)
           && filesystem.write_bytes(dir + "/slot", slot) && save_config(dir, c) && security_update_done(dir);
    if (!ok) { return dfail("cannot write the profile"); }
    println(hex_encode(cbor_of_keys(PartyKeys {.party = c.party, .auth_key = c.dk_pub, .hpke_key = c.hpke_pub})));
    return 0;
}

// The two profile files of a new device (format 2, SPEC 9.4): each with
// its own L, W and update-slot key and no security key yet; the real
// profile's list holds the other's L and W, and each list the other's slot
// key. Without a duress PIN the other file is random, its slot to a key no
// one holds. The file named "a" is written last: its presence marks
// format 2.
@requires(filesystem, declassify)
Bool write_profiles(Str dir, Str rw, List(Secret(UInt(8))) ka, List(Secret(UInt(8))) kb, List(Int) blob_real, List(Int) blob_dur, Bool real_on_a, Bool has_duress) {
    Str dw = if (rw == "a") { "b" } else { "a" };
    List(Int) salt = random_bytes(32);
    List(Secret(UInt(8))) lr = random_secret(32);
    List(Secret(UInt(8))) wr = random_secret(32);
    List(Secret(UInt(8))) ld = random_secret(32);
    List(Secret(UInt(8))) wd = random_secret(32);
    List(Secret(UInt(8))) sr = random_secret(32);
    List(Secret(UInt(8))) sd = random_secret(32);
    List(Secret(UInt(8))) none = [];
    KeyList rl = KeyList {.w = wr, .salt = salt, .via = [], .mine = if (real_on_a) { "a" } else { "b" }, .peer_l = ld, .peer_w = wd, .keys = [], .sk = sr, .peer_pk = slot_pub(sd), .fill = ""};
    KeyList dl = KeyList {.w = wd, .salt = salt, .via = [], .mine = if (real_on_a) { "b" } else { "a" }, .peer_l = none, .peer_w = none, .keys = [], .sk = sd, .peer_pk = slot_pub(sr), .fill = ""};
    List(Int) rf = own_file(ka, lr, rl, wr, rw, blob_real);
    List(Int) df = if (has_duress) { own_file(kb, ld, dl, wd, dw, blob_dur) } else { decoy_file(rl.peer_pk) };
    Bool ok = put_new_pair(dir, rw, rf, df);
    return ok;
}

// duress.pub (SPEC 14.2): the duress DK sub-key's public key (65) and the
// duress profile's transport key (65), from their secrets.
@requires(declassify)
pub List(Int) duress_pub_of(List(Secret(UInt(8))) subkey, List(Secret(UInt(8))) transport_seed) {
    return sw_public(subkey).concat(hpkeg_derive_keypair(16, transport_seed).pk);
}

// ─── The security update (D-4, SPEC 9.2, 9.4) ───────────────────
// A device made before it has a duress profile holding the device's v1
// transport key, and its profiles in the format before 2 (security keys
// listed in the clear, both profiles under one W); `device
// security-update` (secupdate.resid) re-seals the duress profile with a
// transport key of its own, moves the device to its v2 key, and moves the
// profiles to format 2. The file `security-update` records what ran
// ("transport-v2 duress-transport", then "keys-v2"; a device made since
// writes both at once). Whether it is due depends on that file alone,
// never on a PIN: the reminder looks the same under the PIN, the duress
// PIN, or none.

pub Str security_update_file(Str dir) { return dir + "/security-update"; }

@requires(filesystem)
pub Bool security_update_due(Str dir) {
    return filesystem.exists(dir + "/config.cbor") && !(filesystem.exists(security_update_file(dir)) && str_contains(filesystem.read_all(security_update_file(dir)), "keys-v2"));
}

// Whether the first part (D-4: the transport keys) ran.
@requires(filesystem)
pub Bool transport_update_done(Str dir) { return filesystem.exists(security_update_file(dir)); }

@requires(filesystem)
pub Bool transport_update_record(Str dir) { return filesystem.write_all(security_update_file(dir), "transport-v2 duress-transport\n"); }

@requires(filesystem)
pub Bool security_update_done(Str dir) { return filesystem.write_all(security_update_file(dir), "transport-v2 duress-transport keys-v2\n"); }

pub Str security_update_reminder(Str dir) {
    return "Finish the security update: run `symbolon device security-update " + dir + "` (it asks for the PIN, then the duress PIN). Until then a duress PIN may give access to your shared folders, and this device's files show its security keys to anyone.";
}

// ─── The nonce-fix marker (nfmark.resid, SPEC 6.2.2) ────────────
// Written by this build after a quorum epoch it made with the cosigner
// (the inception, a re-share it led or joined): every party of that
// session ran the Paillier nonce fix, or the session ended. It signs the
// epoch and transcript that session made, and only once the verified log,
// held against the witnesses, is at that epoch with that transcript
// (MR-1: never whatever head a relay serves afterwards); otherwise
// nothing is marked and the refresh stays due. The first valid marker is
// kept. `offered`: a marker another device handed on
// (EnrollSecrets.fix_mark), taken only by a device joining its first log
// (`may_adopt`) and only as the inception's, signed by the inception's
// device (MR-2: an existing member relies on its own markers alone).
@requires(filesystem, network, device, declassify, clock, environment)
pub Bool mark_fixed_quorum(Str dir, Unlocked u, Int epoch, List(Int) transcript, List(Int) offered, Bool may_adopt) {
    Option(DeviceConfig) oc = load_config(dir);
    return match oc { None => false, Some(c) => mark_fixed_in(dir, c, u, epoch, transcript, offered, may_adopt) };
}

@requires(filesystem, network, device, declassify, clock, environment)
Bool mark_fixed_in(Str dir, DeviceConfig c, Unlocked u, Int epoch, List(Int) transcript, List(Int) offered, Bool may_adopt) {
    if (c.log_id.len() == 0) { return false; }
    Result(LogView, SymbolonError) rv = log_view_dir(dir, relay_ep(c), c.log_id, "");
    return match rv { Err(_) => false, Ok(v) => mark_fixed_at(dir, c, u, v, epoch, transcript, offered, may_adopt) };
}

@requires(filesystem, device, declassify, network, environment)
Bool mark_fixed_at(Str dir, DeviceConfig c, Unlocked u, LogView v, Int epoch, List(Int) transcript, List(Int) offered, Bool may_adopt) {
    Quorum q = v.vh.head.quorum;
    FixMark om = fix_mark_of_bytes(offered);
    Str choice = mark_choice(fix_mark_check(fix_mark_read(dir), c.log_id, c.party, q, v.events), fix_mark_check(om, c.log_id, c.party, q, v.events), may_adopt, q, epoch, transcript);
    if (choice == "keep") { return true; }
    if (choice == "adopt") { return fix_mark_write(dir, om); }
    if (choice != "sign") { return false; }
    List(Int) tbs = fix_mark_tbs(c.log_id, epoch, transcript, c.party);
    Result(List(Int), Str) s = dk_sign(c, u.real, u.st, tbs);
    List(Int) sig = match s { Ok(x) => x, Err(_) => [] };
    return sig.len() == 64 && fix_mark_write(dir, FixMark {.log_id = c.log_id, .epoch = epoch, .transcript = transcript, .signer = c.party, .sig = sig});
}

DeviceConfig with_identity(DeviceConfig c, List(Int) dk_pub) {
    return DeviceConfig {.relay_host = c.relay_host, .relay_port = c.relay_port, .ca = c.ca, .witnesses = c.witnesses, .unprotected = c.unprotected,
        .argon_m_kib = c.argon_m_kib, .argon_t = c.argon_t, .salt = c.salt, .tpm_dk = c.tpm_dk, .tpm_unlock_a = c.tpm_unlock_a, .tpm_unlock_b = c.tpm_unlock_b,
        .party = party_of_key(dk_pub), .dk_pub = dk_pub, .hpke_pub = c.hpke_pub, .log_id = c.log_id, .mbox_next = c.mbox_next, .peers = c.peers};
}

pub DeviceConfig with_log(DeviceConfig c, List(WitnessEp) ws, List(Int) l, Int next, List(PartyKeys) peers) {
    return DeviceConfig {.relay_host = c.relay_host, .relay_port = c.relay_port, .ca = c.ca, .witnesses = ws, .unprotected = c.unprotected,
        .argon_m_kib = c.argon_m_kib, .argon_t = c.argon_t, .salt = c.salt, .tpm_dk = c.tpm_dk, .tpm_unlock_a = c.tpm_unlock_a, .tpm_unlock_b = c.tpm_unlock_b,
        .party = c.party, .dk_pub = c.dk_pub, .hpke_pub = c.hpke_pub, .log_id = l, .mbox_next = next, .peers = peers};
}

// ─── The CGGMP configuration under the DEK ──────────────────────

List(Int) share_aad() { return utf8("symbolon v1 share"); }

@requires(filesystem, declassify)
pub Bool store_share(Str dir, List(Secret(UInt(8))) dek, CgConfig cfg) {
    List(Int) iv = random_bytes(12);
    List(Secret(UInt(8))) ct = aes_gcmg_seal(dek, iv, secret_bytes(cg_cfg_encode(cfg)), share_aad());
    return put_secret_file(dir + "/share.enc", iv.concat(reveal(ct)));
}

@requires(filesystem, declassify)
pub Option(CgConfig) load_share(Str dir, List(Secret(UInt(8))) dek) {
    List(Int) b = get_file(dir + "/share.enc");
    if (b.len() < 28) { return None; }
    Option(List(Secret(UInt(8)))) pt = aes_gcmg_decrypt(dek, b[0..12], b[12..b.len()], share_aad());
    return match pt { None => None, Some(p) => cg_cfg_decode(reveal(p)) };
}

// ─── `device init`: inception (SPEC 10.1, 10.6) ─────────────────

pub type InitArgs = {
    Str cosigner_keys;                   // the cosigner's PartyKeys, CBOR hex
    List(WitnessEp) witnesses;
    Str device_primes; Str kit_primes;   // files with "P Q" hex (tests), or ""
};

// `symbolon device init DIR COSIGNER_KEYS W1 W2 W3 [DEVICE_PRIMES KIT_PRIMES]`,
// each W as host:port:pubkeyhex. Reads the PIN from standard input, then
// the kit's passphrase twice (an empty line: none; SPEC 13.2). The device
// plays the kit too (decision of 2026-10-29); it prints the kit's sheet
// (the seed, sealed under the passphrase if there is one), which the
// principal writes down, and erases it.
@requires(filesystem, network, device, declassify, clock, provision, environment)
pub Int device_init(Str dir, InitArgs a) {
    Option(DeviceConfig) oc = load_config(dir);
    Option(PartyKeys) ok = keys_of_cbor(cose_hex_decode(a.cosigner_keys));
    if (a.witnesses.len() < 3) { return dfail("three witnesses at least (SPEC 20.3)"); }
    if (a.witnesses.len() % 2 == 0) { return dfail("an odd number of witnesses (SPEC 20.3: with an even number a split vote can freeze the log)"); }
    List(WitnessRef) wrefs = witness_refs(a.witnesses, 0, []);
    if (witnesses_distinct(wrefs).len() != wrefs.len()) { return dfail("two witnesses with the same key (SPEC 20.3)"); }
    Str badw = bad_witness_url(wrefs, 0);
    if (str_len(badw) > 0) { return dfail(badw + ": not a witness address (HOST:PORT, the port from 1 to 65535)"); }
    Str pin = read_pin();
    NewKitPass kp = read_new_kit_pass();
    if (!kp.ok) { return dfail(kit_pass_mismatch()); }
    return match oc {
        None => dfail("run `symbolon device new` first"),
        Some(c) => match ok {
            None => dfail("those are not the cosigner's keys"),
            Some(cos) => if (c.log_id.len() > 0) { dfail("already in a log") } else { init_unlocked(dir, c, cos, a, pin, kp.pass) }
        }
    };
}

@requires(filesystem, network, device, declassify, clock, provision, environment)
Int init_unlocked(Str dir, DeviceConfig c, PartyKeys cos, InitArgs a, Str pin, Str kit_pass) {
    Unlocked u = unlock_dir(dir, c, pin);
    if (u.kind != 1) { return dfail("wrong PIN"); }
    List(Int) seed = random_bytes(32);
    // The sheet is made first: sealing it takes a while, and the kit must
    // not be in a published log before its sheet exists.
    if (str_len(kit_pass) > 0) { println("device: sealing the kit under its passphrase (Argon2id; this takes a while)..."); }
    List(Int) sheet = new_kit_sheet(seed, kit_pass);
    if (sheet.len() == 0) { return dfail("cannot seal the kit"); }
    KitKeys kit = kit_keys(seed) else { KitKeys {.sign_priv = [], .sign_pub = [], .hpke_priv = [], .hpke_pub = []} };
    PartyKeys me = PartyKeys {.party = c.party, .auth_key = c.dk_pub, .hpke_key = c.hpke_pub};
    PartyKeys kp = PartyKeys {.party = recovery_key_digest(kit.sign_pub), .auth_key = kit.sign_pub, .hpke_key = kit.hpke_pub};
    List(PartyKeys) parties = [me, kp, cos];
    List(Int) sid = random_bytes(32);
    Local dev = Local {.party = me.party, .cg = 1, .hpke_sk = device_transport(c, u.real.dek).sk};
    Local kitl = Local {.party = kp.party, .cg = 2, .hpke_sk = secret_bytes(kit.hpke_priv)};
    Remote cr = Remote {.party = cos.party, .cg = 3, .hpke_pub = cos.hpke_key};
    Endpoint relay = relay_ep(c);
    Int start = mailbox_end(relay, me.party, c.mbox_next);
    // No log names these mailboxes yet: their owners open them (SPEC 20.2).
    Int kuntil = clock_now_seconds() + mbox_open_secs();
    if (!open_mailbox_dev(c, u) || !mbox_open(relay, kit.sign_pub, kuntil, ecdsa_sign_raw(P256, Sha256, kit.sign_priv, mbox_open_message(kp.party, kuntil)))) { return dfail("the relay does not open this device's mailbox"); }
    if (!send_invite(relay, dev, cr, WKeygen(KeygenInvite {.session_id = sid, .parties = parties, .threshold = 1}), clock_now_seconds() + 60)) { return dfail("cannot reach the relay (is the cosigner running? its mailbox opens when it is)"); }
    println("device: key generation with the cosigner (Paillier keys: this can take minutes)...");
    Result(KgStep, CgFail) s1 = kg_begin(kg_ctx(1, [1, 2, 3], 1, [], sid, random_bytes(32), primes_of(a.device_primes)));
    Result(KgStep, CgFail) s2 = kg_begin(kg_ctx(2, [1, 2, 3], 1, [], sid, random_bytes(32), primes_of(a.kit_primes)));
    return match s1 {
        Err(e) => dfail("keygen: " + e.why),
        Ok(k1) => match s2 {
            Err(e) => dfail("keygen: " + e.why),
            Ok(k2) => after_keygen(dir, c, u, kit, parties, cr, a,
                run_session(relay, sid, [Seat {.me = dev, .st = k1.state, .round = 1, .out = k1.out, .done = false},
                                         Seat {.me = kitl, .st = k2.state, .round = 1, .out = k2.out, .done = false}],
                            [cr], [Cursor {.party = me.party, .next = start}, Cursor {.party = kp.party, .next = 0}], [],
                            lambda(st, msgs) { kg_adapt(st, msgs) }, 1800), pin, sheet, sid)
        }
    };
}

// The invitation, again every two seconds until `until`: the cosigner opens
// its mailbox at its next turn after the operator paired this device.
@requires(network, declassify, clock)
Bool send_invite(Endpoint relay, Local dev, Remote cr, Packet w, Int until) {
    if (send_to(relay, dev, cr, w)) { return true; }
    if (clock_now_seconds() > until) { return false; }
    _ = clock_sleep_ms(2000);
    return send_invite(relay, dev, cr, w, until);
}

Party party_from(PartyKeys k, UInt(8) kind, Str label) {
    return Party {.id = k.party, .kind = kind, .auth_key = k.auth_key, .hpke_key = k.hpke_key, .label = label, .attestation = NoAttestation};
}

// The first witness URL that is not canonical (core/log.resid witness_url_ok), or "".
Str bad_witness_url(List(WitnessRef) ws, Int i) {
    if (i >= ws.len()) { return ""; }
    if (!witness_url_ok(ws[i].url)) { return ws[i].url; }
    return bad_witness_url(ws, i + 1);
}

List(WitnessRef) witness_refs(List(WitnessEp) ws, Int i, List(WitnessRef) acc) {
    if (i >= ws.len()) { return acc; }
    // The host in lower case: a policy names canonical witness URLs only (core/log.resid witness_url_ok).
    return witness_refs(ws, i + 1, acc.concat([WitnessRef {.url = "http://" + str_to_lower(ws[i].host) + ":" + f"{ws[i].port}", .key = ws[i].key}]));
}

@requires(filesystem, network, device, declassify, clock, environment)
Int after_keygen(Str dir, DeviceConfig c, Unlocked u, KitKeys kit, List(PartyKeys) parties, Remote cr, InitArgs a, Run(KgState) r, Str pin, List(Int) sheet, List(Int) sid) {
    if (str_len(r.fail) > 0) { return dfail("keygen: " + r.fail); }
    KvInit kv = kv_inception(relay_ep(c), Local {.party = c.party, .cg = 1, .hpke_sk = device_transport(c, u.real.dek).sk}, cr, sid, mailbox_end(relay_ep(c), c.party, c.mbox_next));
    if (str_len(kv.why) > 0) { return dfail(kv.why); }
    CgConfig none = CgConfig {.id = 0, .threshold = 0, .ecdsa = [], .elgamal = [], .p = [], .q = [], .rid = [], .chain_key = [], .public = []};
    CgConfig mine = kg_result(r.seats[0].st) else { none };
    CgConfig kitc = kg_result(r.seats[1].st) else { none };
    List(Int) x = cfg_root_pubkey(mine, [1, 2, 3]);
    if (x.len() != 65) { return dfail("keygen gave no key"); }
    Quorum q = Quorum {.parties = [party_from(parties[0], party_kind_device(), "this device"), party_from(parties[1], party_kind_kit(), "recovery kit"),
                                   party_from(parties[2], party_kind_cosigner(), "cosigner")],
                       .t = 2, .root_pubkey = x, .epoch = 1, .transcript_digest = sha256_bytes(utf8("cmp/keygen")), .kv_commits = kv.out.commits};
    // The evaluation limit (policy field 3) with the vault OPRF key: a
    // cosigner that cannot deal k_v predates both.
    // The relay sequences the log (policy field 8, SPEC 20.3): its claim
    // key, pinned here, under the name this device reaches it at.
    List(Int) ck = claim_key_get(relay_ep(c));
    if (ck.len() == 0) { return dfail("the relay serves no claim key (GET /claim-key): it cannot sequence the log (SPEC 20.3)"); }
    Policy pol = Policy {.device_sigs_for_authority = 1, .recovery_delay_sec = 259200, .guardians = [], .guardian_threshold = 0,
                         .witnesses = witness_refs(a.witnesses, 0, []), .duress_window_sec = 3600,
                         .sequencer = [WitnessRef {.url = c.relay_host + f":{c.relay_port}", .key = ck}], .cosigner_policy = if (kv.on) { CosignerLimits(Limits {.sign = 60, .eval = 60}) } else { CosignerLimit(60) }};
    EventPayload e0 = EventPayload {.log_id = None, .sequence = 0, .predecessor_digest = None, .suite = 1, .body = InceptionBody(q, pol),
                                    .next_recovery_key_digests = [recovery_key_digest(kit.sign_pub)], .advisory_time = (UInt(64))clock_now_seconds()};
    List(Int) enc = payload_cbor(e0) else { [] };
    if (enc.len() == 0) { return dfail("inception does not encode"); }
    return sign_inception_event(dir, c, u, kit, parties, cr, a, mine, kitc, q, e0, enc, pin, sheet, kv);
}

// The inception's vault OPRF key (SPEC 18.10.1): this device (index 1) and
// the cosigner (index 3) each deal a fresh secret to indices 1, 2 (the
// kit) and 3. A cosigner that does not answer within a minute predates
// protected items: inception goes on without k_v, which `device
// protection enable` adds later.
pub type KvInit = { Bool on; KvOut out; KvDealing mine; Str why; };

@requires(network, declassify, clock)
KvInit kv_inception(Endpoint relay, Local dev, Remote cr, List(Int) sid, Int start) {
    KvDealing mine = kv_dealing(KvGenerate, 2, 3, [1, 3], 1);
    KvOut none = KvOut {.share = kv_scalar(classify((UInt(576)) 0)), .commits = []};
    if (!kv_send(relay, dev, [cr], sid, 1, mine, 0)) { return KvInit {.on = false, .out = none, .mine = mine, .why = "cannot reach the relay"}; }
    List(KvGot) got = kv_collect(relay, dev, [cr], Cursor {.party = dev.party, .next = start}, sid, 60);
    if (got.len() == 0) {
        eprintln("device: the cosigner does not deal a vault OPRF key; protected items stay off (device protection enable)");
        return KvInit {.on = false, .out = none, .mine = mine, .why = ""};
    }
    return match kv_combine(1, got, Some(mine), 1, [], [1, 3]) {
        Err(m) => KvInit {.on = false, .out = none, .mine = mine, .why = "vault OPRF key: " + m},
        Ok(o) => KvInit {.on = true, .out = o, .mine = mine, .why = ""}
    };
}

@requires(filesystem, network, device, declassify, clock, environment)
Int sign_inception_event(Str dir, DeviceConfig c, Unlocked u, KitKeys kit, List(PartyKeys) parties, Remote cr, InitArgs a,
                         CgConfig mine, CgConfig kitc, Quorum q, EventPayload e0, List(Int) enc, Str pin, List(Int) sheet, KvInit kv) {
    Endpoint relay = relay_ep(c);
    Local dev = Local {.party = c.party, .cg = 1, .hpke_sk = device_transport(c, u.real.dek).sk};
    Int start = mailbox_end(relay, c.party, c.mbox_next);
    if (!send_to(relay, dev, cr, WSignEvent(enc))) { return dfail("cannot reach the relay"); }
    List(Int) csig = wait_event_sig(relay, dev, cr, Cursor {.party = c.party, .next = start}, clock_now_seconds());
    if (csig.len() != 64) { return dfail("the cosigner did not sign the inception"); }
    Result(List(Int), Str) dsig = dk_sign(c, u.real, u.st, enc);
    List(Int) mysig = match dsig { Ok(s) => s, Err(_) => [] };
    if (mysig.len() != 64) { return dfail("the device key did not sign"); }
    List(Int) l = sha256_bytes(enc);
    List(EventSig) sigs = [EventSig {.signer = c.party, .sig = mysig}, EventSig {.signer = parties[1].party, .sig = ecdsa_sign_raw(P256, Sha256, kit.sign_priv, enc)},
                           EventSig {.signer = cr.party, .sig = csig}];
    List(WitnessCosignature) cs = cosigs(a.witnesses, c.ca, l, StoredEvent {.encoded = enc, .sigs = sigs, .cosigs = []});
    SignedEvent se = SignedEvent {.payload = e0, .encoded = enc, .sigs = sigs, .cosigs = cs};
    Result(VerifiedHead, SymbolonError) v = il_verify(l, [se], last_time([se], policy_of_e0([se])), lambda(p) { false });
    return match v {
        Err(e) => dfail("the inception does not verify: " + err_text(e)),
        Ok(vh) => publish(dir, c, u, kit, parties, cr, a, mine, kitc, StoredEvent {.encoded = enc, .sigs = sigs, .cosigs = cs}, l, sheet, kv, q)
    };
}

@requires(network, clock(readonly), declassify)
List(WitnessCosignature) cosigs(List(WitnessEp) ws, Str ca, List(Int) l, StoredEvent e0) { return cosigs_for(ws, ca, l, 0, l, [cbor_of_event(e0)], 0, []); }

// Every witness's co-signature on (l, seq, d) that verifies. `events`: the
// log before the event, with its co-signatures, then the event (each as
// the relay stores it), which the witness verifies before it co-signs
// (SPEC 20.3, agent/witnesssrv.resid).
@requires(network, clock(readonly), declassify)
pub List(WitnessCosignature) cosigs_for(List(WitnessEp) ws, Str ca, List(Int) l, UInt(64) seq, List(Int) d, List(List(Int)) events, Int i, List(WitnessCosignature) acc) {
    if (i >= ws.len()) { return acc; }
    Option(WitnessCosignature) c = cosign_from(Endpoint {.host = ws[i].host, .port = ws[i].port, .ca = ca, .token = ""}, ws[i].key, l, seq, d, events);
    return cosigs_for(ws, ca, l, seq, d, events, i + 1, match c { Some(x) => acc.concat([x]), None => acc });
}

@requires(network, declassify, clock)
pub List(Int) wait_event_sig(Endpoint relay, Local me, Remote from, Cursor cur, Int since) {
    Drained d = drain(relay, me, [from], cur, ListBuf());
    List(Int) s = first_event_sig(d.got, from.party, 0);
    if (s.len() > 0) { return s; }
    if (clock_now_seconds() - since > 120) { return []; }
    _ = clock_sleep_ms(200);
    return wait_event_sig(relay, me, from, d.cur, since);
}

List(Int) first_event_sig(List(Got) gs, List(Int) from, Int i) {
    if (i >= gs.len()) { return []; }
    Packet w = gs[i].w;
    List(Int) s = match w { WEventSig(x) => if (bytes_eq(gs[i].from, from)) { x } else { [] }, _ => [] };
    return if (s.len() > 0) { s } else { first_event_sig(gs, from, i + 1) };
}

pub Str err_text(SymbolonError e) {
    return match e {
        ErrInvalidLog(s) => "log: " + s, ErrInvalidSignature(s) => "signature: " + s, ErrQuorumNotMet(h, n) => f"quorum {h}/{n}",
        ErrStaleEpoch(h, c) => f"epoch {h}/{c}", ErrVaultIntegrity(s) => s, ErrPolicyViolation(s) => s, ErrDuressContainment(s) => s,
        ErrRecoveryFailed(s) => s, ErrRotationFailed(s) => s, ErrAttestationFailed(s) => s, ErrCapabilityDenied(s) => s,
        ErrNetwork(s) => s, ErrStorage(s) => s, ErrHardware(s) => s, ErrInternal(s) => s,
        ErrNewerFormat(_) => newer_text()
    };
}

// What the real profile says when the relay does not answer: the log
// cannot be fetched (common.resid verified_log_dir).
pub Str unreachable_text() { return err_text(ErrInvalidLog("no log at the relay")); }

// What the real profile says when the log came from the relay but a later
// request to it failed (a mailbox send, enroll/recover/protect): the
// relay was reachable a moment ago, so "no log at the relay" would
// contradict the read that just worked.
pub Str relay_lost_text() { return "cannot reach the relay"; }

// An operation the duress profile cannot or must not do (SPEC 14.2 item 3,
// 14.3): it never says "wrong PIN" (the coercer would learn that this PIN
// opened something else than the PIN). It fetches and verifies the log as
// the real profile does first, so the network pattern starts the same, and
// fails with the log's own error when that fails, as the real profile
// would; when the log verified, as the real profile fails when the relay
// stops answering after the log (relay_lost_text), never "no log at the
// relay" right after reads under the same PIN found it.
@requires(filesystem, network, clock(readonly), declassify)
pub Str duress_refusal(Str dir, DeviceConfig c) {
    Result(VerifiedHead, SymbolonError) v = verified_log_dir(dir, relay_ep(c), c.log_id);
    Str m = duress_refusal_for(v);
    return m;
}

pub Str duress_refusal_for(Result(VerifiedHead, SymbolonError) v) {
    return match v { Err(e) => err_text(e), Ok(_) => relay_lost_text() };
}

// Publishes the log, wraps the kit's halves (SPEC 10.6), stores the share,
// and prints the kit's sheet.
@requires(filesystem, network, device, declassify, clock, environment)
Int publish(Str dir, DeviceConfig c, Unlocked u, KitKeys kit, List(PartyKeys) parties, Remote cr, InitArgs a,
            CgConfig mine, CgConfig kitc, StoredEvent se, List(Int) l, List(Int) sheet, KvInit kv, Quorum q0) {
    if (!log_put(relay_ep(c), l, 0, cbor_of_event(se))) { return dfail("the relay refused the inception"); }
    // The relay takes the kit's blobs only from a signed-in device of the
    // log (SPEC 29.4): this one, now that its log is there.
    Endpoint relay = relay_session(dir, with_log(c, a.witnesses, l, c.mbox_next, parties), u);
    List(Int) kk = random_bytes(32);
    KitHalves halves = kit_split(kitc.ecdsa, kk, random_bytes(32), random_bytes(32));
    Wrapped wa = offline_wrap(kit.hpke_pub, l, 1, parties[1].party, half_bytes(halves.a, halves.ka), random_bytes(32)) else { Wrapped {.enc = [], .ct = []} };
    Wrapped wb = offline_wrap(cr.hpke_pub, l, 1, cr.party, half_bytes(halves.b, halves.kb), random_bytes(32)) else { Wrapped {.enc = [], .ct = []} };
    List(Int) secrets = kit_secrets_seal(secret_bytes(kk), l, 1, u.real.cc, u.real.vault_key);
    Local dev = Local {.party = c.party, .cg = 1, .hpke_sk = device_transport(c, u.real.dek).sk};
    Bool ok = blob_put(relay, kit_a_blob(l, 1), cbor_of_blob(WrappedBlob {.enc = wa.enc, .ct = wa.ct}))
           && blob_put(relay, kit_secrets_blob(l, 1), secrets)
           && send_to(relay, dev, cr, WKitHalf(WrappedBlob {.enc = wb.enc, .ct = wb.ct}))
           && store_share(dir, u.real.dek, mine) && store_dshare(dir, u.real, mine)
           // k_v: this device's share (never in the duress profile), and
           // its part for the kit, a_v, wrapped to the kit (SPEC 18.10.1).
           && (!kv.on || (kv_store(dir, u.real.dek, KvKept {.epoch = 1, .id = 1, .share = kv.out.share})
                          && kv_put_kit_half(relay, party_from(parties[1], party_kind_kit(), "recovery kit"), l, 1, kv.mine, 2)))
           && send_duress_key(dir, relay, dev, cr)
           && filesystem.write_bytes(dir + "/log/0", cbor_of_event(se))
           && save_config(dir, with_log(c, a.witnesses, l, mailbox_end(relay, c.party, c.mbox_next), parties));
    if (!ok) { return dfail("cannot store the result"); }
    // This build made the inception with the cosigner: the household's
    // keys never ran without the nonce fix (SPEC 6.2.2).
    _ = mark_fixed_quorum(dir, u, (Int)q0.epoch, q0.transcript_digest, [], false);
    println("log " + hex_encode(l));
    println("root key " + hex_encode(cfg_root_pubkey(mine, [1, 2, 3])));
    _ = mark_kit_sheet(dir, sheet);
    println("RECOVERY KIT (write it down; it is shown once): " + kit_sheet_text(sheet));
    println(kit_sheet_note(sheet));
    return 0;
}

// ─── `device register` and `device sign` (SPEC 10.3, 10.4) ──────

// `--duress` puts the credential in the duress subset (SPEC 14.2).
@requires(filesystem, network, device, declassify, clock, provision, environment)
pub Int device_register(Str dir, Str rp, Bool in_subset) {
    Option(DeviceConfig) oc = load_config(dir);
    return match oc {
        None => dfail("not set up"),
        Some(c) => register_with(dir, c, rp, unlock_dir(dir, c, read_pin()), in_subset)
    };
}

@requires(filesystem, network, device, declassify, clock)
Int register_with(Str dir, DeviceConfig c, Str rp, Unlocked u, Bool in_subset) {
    // The duress profile has no chain code to make a credential with.
    if (u.kind == 2) { return dfail(duress_refusal(dir, c)); }
    if (u.kind != 1) { return dfail("wrong PIN"); }
    Result(VerifiedHead, SymbolonError) v = verified_log_dir(dir, relay_ep(c), c.log_id);
    return match v {
        Err(e) => dfail(err_text(e)),
        Ok(vh) => print_credential(dir, u, rp, vh.head.quorum.root_pubkey, random_bytes(16), in_subset)
    };
}

@requires(filesystem, declassify)
pub Int print_credential(Str dir, Unlocked u, Str rp, List(Int) x, List(Int) nonce, Bool in_subset) {
    List(Int) cid = credential_id(u.real.cc, rp, nonce);
    List(UInt(64)) tau = tweak_scalar(u.real.cc, rp, nonce);
    if (!update_duress(dir, u.real, cid, bn_to_be(tau, 32), in_subset)) { return dfail("cannot update the duress profile"); }
    println("credential-id " + hex_encode(cid));
    println("public-key " + hex_encode(credential_pubkey(x, tau)));
    return 0;
}

// `symbolon device sign DIR RP CREDENTIAL_ID MESSAGE`: MESSAGE is m =
// SHA-256(authenticatorData || clientDataHash), hex. Prints r || s.
@requires(filesystem, network, device, declassify, clock, provision, environment)
pub Int device_sign(Str dir, Str rp, Str cid_hex, Str m_hex) {
    Option(DeviceConfig) oc = load_config(dir);
    List(Int) m = cose_hex_decode(m_hex);
    if (m.len() != 32) { return dfail("the message is 32 bytes"); }
    return match oc {
        None => dfail("not set up"),
        Some(c) => sign_with(dir, c, rp, cose_hex_decode(cid_hex), m, read_pin(), 0)
    };
}

@requires(filesystem, network, device, declassify, clock, provision, environment)
// form 0 prints the passkey forms (DER, then r || s); 1 an SSH signature
// blob (ecdsa-sha2-nistp256, SPEC 16.1).
pub Int sign_with(Str dir, DeviceConfig c, Str rp, List(Int) cid, List(Int) m, Str pin, Int form) {
    return sign_unlocked(dir, c, unlock_dir(dir, c, pin), rp, cid, m, pin, form);
}

// The same, with the profiles already unlocked (a WebAuthn assertion
// unlocks first to tell a threshold credential from a Synced one).
@requires(filesystem, network, device, declassify, clock, provision, environment)
pub Int sign_unlocked(Str dir, DeviceConfig c, Unlocked u, Str rp, List(Int) cid, List(Int) m, Str pin, Int form) {
    Result(List(Int), Str) r = sign_unlocked_raw(dir, c, u, rp, cid, m);
    return match r { Err(e) => dfail(e), Ok(sig) => print_sig(sig, form) };
}

Int print_sig(List(Int) sig, Int form) {
    if (form == 1) {
        println("signature " + hex_encode(ecdsa_sig_blob("nistp256", sig)));
        return 0;
    }
    println("signature-der " + hex_encode(ecdsa_der_of(ecdsa_sig_raw(P256, sig))));
    println(hex_encode(sig));
    return 0;
}

// The signature itself, r || s (64 bytes, checked against the
// credential's public key), for a caller that builds on it: an SSH
// certificate (SPEC 16.1.2) is signed this way.
@requires(filesystem, network, device, declassify, clock, provision, environment)
pub Result(List(Int), Str) sign_unlocked_raw(Str dir, DeviceConfig c, Unlocked u, Str rp, List(Int) cid, List(Int) m) {
    if (u.kind == 2) { return duress_sign(dir, c, u, cid, m); }
    if (u.kind != 1) { return Err("wrong PIN"); }
    Option(List(Int)) nonce = credential_nonce(u.real.cc, rp, cid);
    // A joined re-share's share kept aside goes into use first, whatever
    // started this signature (MR-13); one file check when there is none.
    _ = settle_pending(dir);
    Option(CgConfig) cg = load_share(dir, u.real.dek);
    Result(VerifiedHead, SymbolonError) v = verified_log_dir(dir, relay_ep(c), c.log_id);
    return match nonce {
        None => Err("that credential ID is not for this relying party (A-12)"),
        Some(n) => match cg {
            None => Err("no share"),
            Some(x) => match v {
                Err(e) => Err(err_text(e)),
                Ok(vh) => run_sign(dir, c, u, x, vh, tweak_scalar(u.real.cc, rp, n), m)
            }
        }
    };
}

// Under the duress PIN (SPEC 14.2): the duress profile's configuration,
// the subset's tweak for this credential (none outside the subset: the
// duress profile has no chain code), and a request signed by the duress
// sub-key, which the cosigner recognizes. The output is the same as a
// normal signature's, and a credential outside the subset fails as a
// credential presented to another relying party does.
@requires(filesystem, network, device, declassify, clock, provision)
Result(List(Int), Str) duress_sign(Str dir, DeviceConfig c, Unlocked u, List(Int) cid, List(Int) m) {
    Option(List(Secret(UInt(8)))) tau = subset_tweak(DuressFull {.share = u.duress.share, .subkey = u.duress.subkey, .vault_key = u.duress.vault_key,
                                                                .hpke_priv = u.duress.hpke_priv, .tweaks = duress_tweaks(dir, u.duress)}, cid, 0);
    Option(CgConfig) cg = load_dshare(dir, u.duress.hpke_priv);
    Result(VerifiedHead, SymbolonError) v = verified_log_dir(dir, relay_ep(c), c.log_id);
    return match tau {
        None => Err("that credential ID is not for this relying party (A-12)"),
        Some(t) => match cg {
            None => Err("no share"),
            Some(x) => match v {
                Err(e) => Err(err_text(e)),
                Ok(vh) => run_sign_as(dir, c, u.duress.share, u.duress.subkey, x, vh, bn_from_be(reveal(t)), m)
            }
        }
    };
}

// A signing session whose request is signed by the software key `rkey`
// and whose envelopes use the HPKE key derived for this device (the duress
// profile shares the device's identity; only the request key differs).
@requires(filesystem, network, declassify, clock)
Result(List(Int), Str) run_sign_as(Str dir, DeviceConfig c, List(Secret(UInt(8))) hpke_ikm, List(Secret(UInt(8))) rkey, CgConfig x, VerifiedHead vh, List(UInt(64)) tau, List(Int) m) {
    List(Int) sid = random_bytes(32);
    List(Int) rsig = sw_sign(rkey, request_tbs(sid, m, vh.head.quorum.epoch, c.party, request_sign()));
    return run_sign_core(dir, c, hpkeg_derive_keypair(16, hpke_ikm).sk, x, vh, tau, m, sid, rsig);
}

pub Option(Party) cosigner_of(List(Party) ps, Int i) {
    if (i >= ps.len()) { return None; }
    if (ps[i].kind == party_kind_cosigner()) { return Some(ps[i]); }
    return cosigner_of(ps, i + 1);
}

@requires(filesystem, network, device, declassify, clock, environment)
Result(List(Int), Str) run_sign(Str dir, DeviceConfig c, Unlocked u, CgConfig x, VerifiedHead vh, List(UInt(64)) tau, List(Int) m) {
    Quorum q = vh.head.quorum;
    Option(Party) ocos = cosigner_of(q.parties, 0);
    Party cos = ocos else { Party {.id = [], .kind = 0, .auth_key = [], .hpke_key = [], .label = "", .attestation = NoAttestation} };
    if (cos.id.len() == 0) { return Err("no cosigner in the quorum"); }
    List(Int) sid = random_bytes(32);
    List(List(Int)) signers = [c.party, cos.id];
    Result(List(Int), Str) rs = dk_sign(c, u.real, u.st, request_tbs(sid, m, q.epoch, c.party, request_sign()));
    List(Int) rsig = match rs { Ok(s) => s, Err(_) => [] };
    _ = mail_ep(dir, c, u);
    return run_sign_core(dir, c, device_transport(c, u.real.dek).sk, x, vh, tau, m, sid, rsig);
}

// The session itself, given the HPKE key the device's envelopes use and
// the request's signature (by the DK, or under duress by the sub-key).
@requires(filesystem, network, declassify, clock)
Result(List(Int), Str) run_sign_core(Str dir, DeviceConfig c, List(Secret(UInt(8))) hpke_sk, CgConfig x, VerifiedHead vh, List(UInt(64)) tau, List(Int) m, List(Int) sid, List(Int) rsig) {
    Quorum q = vh.head.quorum;
    Party cos = cosigner_of(q.parties, 0) else { Party {.id = [], .kind = 0, .auth_key = [], .hpke_key = [], .label = "", .attestation = NoAttestation} };
    if (cos.id.len() == 0) { return Err("no cosigner in the quorum"); }
    List(List(Int)) signers = [c.party, cos.id];
    if (rsig.len() != 64) { return Err("the device key did not sign the request"); }
    // No session with a party an abort identified, nor after repeated
    // aborts that identified no one, until a re-share (SPEC 6.2).
    Result(Int, SymbolonError) mr = may_run(load_aborts(dir, q), signers);
    if (match mr { Err(_) => true, Ok(_) => false }) { return Err("signing stopped after an abort: " + match mr { Err(e) => err_text(e), Ok(_) => "" }); }
    Endpoint relay = mail_relay(dir, c);
    Local dev = Local {.party = c.party, .cg = cg_id_of(q, c.party, 0), .hpke_sk = hpke_sk};
    Remote cr = Remote {.party = cos.id, .cg = cg_id_of(q, cos.id, 0), .hpke_pub = cos.hpke_key};
    Int start = mailbox_end(relay, c.party, c.mbox_next);
    SignInvite inv = SignInvite {.session_id = sid, .message = m, .epoch = (Int)q.epoch, .requester = c.party, .kind = (Int)request_sign(), .sig = rsig, .signers = signers, .proto = session_proto()};
    if (!send_to(relay, dev, cr, WSign(inv))) { return Err("cannot reach the relay"); }
    Option(CgCtx) octx = th_ctx(x, q, signers, c.party, tau, sid, m, random_bytes(32));
    return match octx {
        None => Err("no session context"),
        Some(ctx) => run_sign_ctx(dir, c, q, tau, m, relay, sid, dev, cr, start, ctx)
    };
}

@requires(filesystem, network, declassify, clock)
Result(List(Int), Str) run_sign_ctx(Str dir, DeviceConfig c, Quorum q, List(UInt(64)) tau, List(Int) m, Endpoint relay, List(Int) sid, Local dev, Remote cr, Int start, CgCtx ctx) {
    ThStep st = th_start(ctx, th_role(ctx, q, c.party, tau));
    if (th_no_nonce(st.state)) { return Err("signing: " + nonce_one_exhausted()); }
    return finish_sign(dir, c, q, tau, m, run_session(relay, sid, [Seat {.me = dev, .st = st.state, .round = 1, .out = st.out, .done = false}],
        [cr], [Cursor {.party = c.party, .next = start}], [], lambda(t, msgs) { sign_adapt(t, msgs) }, 120));
}

@requires(filesystem, network, clock(readonly), declassify)
Result(List(Int), Str) finish_sign(Str dir, DeviceConfig c, Quorum q, List(UInt(64)) tau, List(Int) m, Run(ThState) r) {
    // The mailbox is read on from where the session stopped, not again from
    // where it started: every round's envelope would be fetched twice.
    Int from = if (r.cursors.len() > 0 && r.cursors[0].next > c.mbox_next) { r.cursors[0].next } else { c.mbox_next };
    _ = save_config(dir, with_log(c, c.witnesses, c.log_id, mailbox_end(relay_ep(c), c.party, from), c.peers));
    _ = save_aborts(dir, record_run(load_aborts(dir, q), q, r.fail, r.culprits), q);
    if (str_len(r.fail) > 0) { return Err("signing: " + r.fail + if (r.culprits.len() > 0) { f" (blames {r.culprits})" } else { "" }); }
    ThState st = r.seats[0].st;
    List(Int) sig = match st { ThSigned(s) => th_sig_raw(s), _ => [] };
    if (sig.len() != 64 || !ecdsa_verify_digest(P256, credential_pubkey(q.root_pubkey, tau), m, ecdsa_sig_raw(P256, sig))) { return Err("no valid signature"); }
    return Ok(sig);
}

// ─── `device status` ────────────────────────────────────────────

@requires(filesystem, network, clock(readonly), declassify)
pub Int device_status(Str dir) {
    Option(DeviceConfig) oc = load_config(dir);
    if (security_update_due(dir)) { println("security-update due"); eprintln(security_update_reminder(dir)); }
    return match oc {
        None => dfail("not set up"),
        Some(c) => status_of(dir, c)
    };
}

// `symbolon device forget DIR`: removes this device's keys from the TPM
// (the device key, the two unlock keys and the storage key). The device
// directory is left alone; without its TPM keys it can no longer unlock.
@requires(filesystem, device, network, environment)
pub Int device_forget(Str dir) {
    Option(DeviceConfig) oc = load_config(dir);
    return match oc {
        None => dfail("not set up"),
        Some(c) => forget_keys(c)
    };
}

@requires(device, network, environment)
Int forget_keys(DeviceConfig c) {
    if (c.unprotected) { println("unprotected profile: no TPM keys to remove"); return 0; }
    if (on_keystore(c)) { return ks_forget(c); }
    // Only this device's keys: the device key at its handle must be the one
    // this configuration names. Keys another device put there stay.
    if (!dk_is_ours(c)) { return dfail("the security chip's keys at this device's handles belong to another device (or are gone): nothing removed"); }
    // The storage key (SRK) is left: it is the TPM's own, made again the
    // same from the TPM's seed, and other software may use it.
    Int gone = evict_all([c.tpm_dk, c.tpm_unlock_a, c.tpm_unlock_b], 0, 0);
    println(f"removed {gone} TPM key(s)");
    return 0;
}

// Whether the persistent handles a TPM-profile device uses (either set: a
// PIN change moves the keys to the other) hold anything.
@requires(device)
Bool tpm_taken() {
    Result(List(Int), TpmError) r = tpm_handles(dk_handle(), 512);
    List(Int) hs = match r { Ok(x) => x, Err(_) => [] };
    List(Int) ours = [dk_handle(), other_handle(dk_handle(), dk_handle()), dk_v2_handle()].concat(unlock_pool());
    return any_in(ours, hs, 0);
}

Bool any_in(List(Int) xs, List(Int) hs, Int i) {
    if (i >= xs.len()) { return false; }
    return hs.contains(xs[i]) || any_in(xs, hs, i + 1);
}

// Whether the key at the device-key handle is this device's.
@requires(device)
Bool dk_is_ours(DeviceConfig c) {
    Result(TpmPublic, TpmError) r = tpm_read_public(c.tpm_dk);
    return match r { Err(_) => false, Ok(p) => bytes_eq(public_point(p.public_area), c.dk_pub) };
}

@requires(device)
Int evict_all(List(Int) hs, Int i, Int n) {
    if (i >= hs.len()) { return n; }
    Result(Bool, TpmError) r = tpm_evict(hs[i]);
    return evict_all(hs, i + 1, match r { Ok(_) => n + 1, Err(_) => n });
}

// The log as this device verified it, held against the witnesses (R5-1,
// SPEC 13.4 "Notification"): the head and pending count include what a
// majority of the witnesses co-signed past the relay's log, and a line
// "hidden N" (with an ALARM on standard error) says the relay does not
// serve N of those events.
@requires(filesystem, network, clock(readonly), declassify)
Int status_of(Str dir, DeviceConfig c) {
    println("party " + hex_encode(c.party));
    println(if (c.unprotected) { "profile UNPROTECTED (no TPM: the PIN alone protects this device, SPEC 9.1)" } else { if (on_keystore(c)) { "profile KEYSTORE (the Android Keystore holds the unlock keys and the device key)" } else { "profile TPM" } });
    if (c.log_id.len() == 0) { println("log none (run `symbolon device init`)"); return 0; }
    println("log " + hex_encode(c.log_id));
    Result(WitnessedView, SymbolonError) v = log_seen(dir, relay_ep(c), c.log_id, "");
    return match v {
        Err(e) => dfail("log does not verify: " + err_text(e)),
        Ok(s) => print_seen(s)
    };
}

Int print_seen(WitnessedView s) {
    _ = print_head(s.view.vh);
    if (s.hidden > 0) { println(f"hidden {s.hidden} event(s) the witnesses co-signed and the relay does not serve: the relay may be hiding them (check `device pending`)"); }
    return 0;
}

Int print_head(VerifiedHead vh) {
    println(f"head sequence {vh.head.sequence} epoch {vh.head.quorum.epoch} parties {vh.head.quorum.parties.len()} threshold {vh.head.quorum.t} pending {vh.pending.len()}");
    // Whether the quorum has a vault OPRF key (SPEC 18.10): protected items
    // can be used only then; its public key C_0 names it.
    println("protected " + (if (vh.head.quorum.kv_commits.len() > 0) { "on " + hex_encode(vh.head.quorum.kv_commits[0]) } else { "off" }));
    return 0;
}

// ─── `device pin` ───────────────────────────────────────────────

// `symbolon device pin DIR`: the PIN, then the new PIN, on standard
// input. The profile the PIN opens opens under the new PIN from then on,
// under either PIN (SPEC 14.2): under the duress PIN it is the duress
// profile, whose new PIN is the duress PIN from then on; the other
// profile and its PIN are never touched (its file's update slot alone is
// written, as by every change: SPEC 14.2). Unprotected and Keystore
// profiles: the profile sealed again under the new PIN's unlock key, its
// key list's header too. TPM profile: the profile's unlock key's authValue
// changed (TPM2_ObjectChangeAuth with the old one) and the key made
// persistent at a random free handle of the four, the old one evicted;
// its output does not depend on its authValue, so the file is sealed
// afresh under the same keys. Both files are written either way, as a key
// change writes them (fidokey write_change). The device key (format 2) does not depend
// on the PIN and does not move; one made before (its authValue the
// stretched PIN) moves too on a change of the real PIN. An organization's
// min_pin_len (SPEC 29.5, from dir/org.policy) holds.
@requires(filesystem, device, declassify, provision, network, environment, clock)
pub Int device_pin(Str dir) {
    Option(DeviceConfig) oc = load_config(dir);
    if (match oc { None => true, Some(_) => false }) { return dfail("not set up (device new)"); }
    DeviceConfig c = oc else { with_identity(load_config(dir) else { DeviceConfig {.relay_host = "", .relay_port = 0, .ca = "", .witnesses = [], .unprotected = true, .argon_m_kib = 0, .argon_t = 0, .salt = [], .tpm_dk = 0, .tpm_unlock_a = 0, .tpm_unlock_b = 0, .party = [], .dk_pub = [], .hpke_pub = [], .log_id = [], .mbox_next = 0, .peers = []} }, []) };
    Str pin = read_pin();
    Str npin = read_pin();
    Int r = device_pin_with(dir, c, pin, npin);
    return r;
}

// `device pin` with the PINs read. A new PIN that opens the other profile
// cannot be taken (two profiles under one PIN): under the real PIN it is
// refused with "this PIN cannot be used; choose another", which does not
// name it; under the duress PIN refusing would tell the real PIN, so the
// change is acted (act_pin): the same work and "PIN changed", the duress
// PIN unchanged. The check is made under both PINs, so their timing is
// alike.
@requires(filesystem, device, declassify, provision, network, environment, clock)
pub Int device_pin_with(Str dir, DeviceConfig c, Str pin, Str npin) {
    Int need = org_min_pin(dir);
    if (str_len(npin) < 4 || str_len(npin) < need) { return dfail(f"a PIN of at least {if (need > 4) { need } else { 4 }} characters"); }
    if (npin == pin) { return dfail("the new PIN is the PIN"); }
    Unlocked u = unlock_dir(dir, c, pin);
    Int r = device_pin_unlocked(dir, c, u, npin);
    return r;
}

// `device pin` once the PIN (and any key's touch) has opened `u`.
@requires(filesystem, device, declassify, provision, network, environment, clock)
pub Int device_pin_unlocked(Str dir, DeviceConfig c, Unlocked u, Str npin) {
    if (u.kind != 1 && u.kind != 2) { return dfail("wrong PIN"); }
    List(Secret(UInt(8))) nst = stretch(c, pin_bytes(npin));
    Bool taken = pin_taken(dir, c, u, nst);
    if (u.kind == 1 && taken) { return dfail("this PIN cannot be used; choose another"); }
    Bool on_a = own_on_a(dir, c, u);
    if (taken) { Int a = act_pin(dir, c, u, on_a, nst); return a; }
    Int r = if (c.unprotected || on_keystore(c)) { repin_own(dir, c, u, on_a, nst) } else { tpm_repin(dir, c, u, on_a, nst) };
    return r;
}

// Whether the PIN stretched to `nst` opens a profile already (without a
// touch: its key list in format 2, the shared W before).
@requires(filesystem, device, declassify, provision, network, environment)
Bool pin_taken(Str dir, DeviceConfig c, Unlocked u, List(Secret(UInt(8))) nst) {
    Bool a_first = (random_bytes(1)[0] & 1) == 0;
    if (keys_v2(dir)) { Found f = find_own(dir, c, nst, a_first); return f.o.which != ""; }
    List(Int) a = read_blob(dir, "a", u.wrap);
    List(Int) b = read_blob(dir, "b", u.wrap);
    if (on_keystore(c)) { return unlock(unlock_key_at(c, nst, true), a, b).kind != 0 || unlock(unlock_key_at(c, nst, false), a, b).kind != 0; }
    List(Secret(UInt(8))) k = unlock_key_for(c, nst, a_first);
    return k.len() == 32 && unlock(k, a, b).kind != 0;
}

// The unlocked profile's plaintext, to be sealed again.
List(Secret(UInt(8))) own_plain(Unlocked u) {
    List(Secret(UInt(8))) none = [];
    List(Secret(UInt(8))) p = if (u.kind == 1) { encode_real(u.real) else { none } } else { encode_duress(u.duress) else { none } };
    return p;
}

// Unprotected and Keystore: the profile sealed under the new PIN's unlock
// key (and, in format 2, its list's header), checked, and its file written
// once.
@requires(filesystem, device, declassify, provision, network, environment)
Int repin_own(Str dir, DeviceConfig c, Unlocked u, Bool on_a, List(Secret(UInt(8))) nst) {
    List(Secret(UInt(8))) nk = unlock_key_at(c, nst, on_a);
    List(Secret(UInt(8))) p = own_plain(u);
    if (p.len() == 0 || nk.len() != 32) { return dfail("cannot encode the profile"); }
    List(Int) blob = seal_blob(nk, random_bytes(12), p);
    if (unlock(nk, blob, []).kind != u.kind) { return dfail("the profile does not open under the new PIN; nothing changed"); }
    Bool ok = if (keys_v2(dir)) { repin_file(dir, u, nk, blob) } else { write_blob(dir, own_blob_legacy(dir, u), blob, u.wrap) };
    if (!ok) { return dfail("cannot write the profile"); }
    println("PIN changed");
    return 0;
}

// Format 2: the PIN change's writes, as a key change's (fidokey
// write_change, SPEC 14.2): the profile's file sealed afresh, its header
// under the new unlock key `nk` and its blob `blob`; the other file's slot,
// under the real PIN the duress profile's list as it is. TPM mode passes
// the unlock key it has (its HMAC output does not change with the PIN).
@requires(filesystem, declassify)
Bool repin_file(Str dir, Unlocked u, List(Secret(UInt(8))) nk, List(Int) blob) {
    OwnList o = open_own(dir, u.ukey);
    if (o.which == "") { return false; }
    Bool ok = write_change(dir, o, o.list, nk, u.wrap, blob, duress_list(dir, o));
    return ok;
}

// Format 2: which file holds the unlocked profile.
@requires(filesystem, declassify)
Str own_which(Str dir, Unlocked u) { OwnList o = open_own(dir, u.ukey); return o.which; }

// Before format 2: which file holds the unlocked profile.
@requires(filesystem, declassify, provision)
Str own_blob_legacy(Str dir, Unlocked u) { return if (unlock(u.ukey, read_blob(dir, "a", u.wrap), []).kind == u.kind) { "a" } else { "b" }; }

// The organization's minimum PIN length the device last verified, or 0.
@requires(filesystem)
pub Int org_min_pin(Str dir) {
    List(Str) p = str_split(str_trim(filesystem.read_all(dir + "/org.policy")), "min_pin=");
    return if (p.len() == 2) { str_parse_int(str_split(p[1], " ")[0]) } else { 0 };
}

// A new duress PIN equal to the real one (act_pin): the same work as a
// change, under the PIN the profile has. Its file is written again, sealed
// under its own key with fresh IVs (the new PIN's key made and dropped);
// in TPM mode its unlock key moves to a free handle with its authValue as
// it was. "PIN changed" is printed; the duress PIN stays.
@requires(filesystem, device, declassify, provision, network, environment)
Int act_pin(Str dir, DeviceConfig c, Unlocked u, Bool on_a, List(Secret(UInt(8))) nst) {
    if (c.unprotected || on_keystore(c)) {
        _ = unlock_key_at(c, nst, on_a);
        Int r = repin_own(dir, c, u, on_a, u.st);
        return r;
    }
    Int t = tpm_repin(dir, c, u, on_a, u.st);
    return t;
}

// The other of a device key's two persistent handles (before format 2).
Int other_handle(Int h, Int base) { return if (h == base) { base + 256 } else { base }; }

// A random handle of the unlock pool that neither unlock key is at.
Int free_unlock_handle(DeviceConfig c) {
    List(Int) free = pool_free(unlock_pool(), [c.tpm_unlock_a, c.tpm_unlock_b], 0, []);
    return if (free.len() == 0) { 0 } else { free[(random_bytes(1)[0] & 255) % free.len()] };
}

List(Int) pool_free(List(Int) pool, List(Int) used, Int i, List(Int) acc) {
    if (i >= pool.len()) { return acc; }
    return pool_free(pool, used, i + 1, if (used.contains(pool[i])) { acc } else { acc.concat([pool[i]]) });
}

// TPM: this profile's unlock key with authValue `nst` at a free handle,
// the configuration naming it, the old one evicted. The device key moves
// too only when it is one made before format 2 and the real PIN changes.
@requires(filesystem, device, declassify, provision, network, environment)
Int tpm_repin(Str dir, DeviceConfig c, Unlocked u, Bool on_a, List(Secret(UInt(8))) nst) {
    // The profile files first, as every change writes them (their content
    // does not depend on the authValue): nothing has moved if they fail.
    if (keys_v2(dir) && !repin_file(dir, u, u.ukey, read_blob(dir, own_which(dir, u), u.wrap))) { return dfail("cannot write the profile"); }
    Int h = if (on_a) { c.tpm_unlock_a } else { c.tpm_unlock_b };
    Int h2 = free_unlock_handle(c);
    Bool dk_too = u.kind == 1 && c.tpm_dk != dk_v2_handle();
    Int dk2 = if (dk_too) { other_handle(c.tpm_dk, dk_handle()) } else { c.tpm_dk };
    if (dk_too) {
        Result(Int, Str) r1 = moved_key(c.tpm_dk, dk2, u.st, nst);
        if (match r1 { Err(_) => true, Ok(_) => false }) { return dfail(match r1 { Err(m) => m, Ok(_) => "" }); }
    }
    Result(Int, Str) r2 = moved_key(h, h2, u.st, nst);
    if (match r2 { Err(_) => true, Ok(_) => false }) {
        if (dk_too) { _ = tpm_evict(dk2); }
        return dfail(match r2 { Err(m) => m, Ok(_) => "" });
    }
    DeviceConfig n = with_handles(c, dk2, if (on_a) { h2 } else { c.tpm_unlock_a }, if (on_a) { c.tpm_unlock_b } else { h2 });
    if (!save_config(dir, n)) { return dfail("cannot store the configuration (the keys at the new handles are made)"); }
    if (dk_too) { _ = tpm_evict(c.tpm_dk); }
    _ = tpm_evict(h);
    println("PIN changed");
    return 0;
}

pub DeviceConfig with_handles(DeviceConfig c, Int dk, Int ua, Int ub) {
    return DeviceConfig {.relay_host = c.relay_host, .relay_port = c.relay_port, .ca = c.ca, .witnesses = c.witnesses, .unprotected = c.unprotected,
        .argon_m_kib = c.argon_m_kib, .argon_t = c.argon_t, .salt = c.salt, .tpm_dk = dk, .tpm_unlock_a = ua, .tpm_unlock_b = ub,
        .party = c.party, .dk_pub = c.dk_pub, .hpke_pub = c.hpke_pub, .log_id = c.log_id, .mbox_next = c.mbox_next, .peers = c.peers};
}

// The key at `from` with authValue `nst`, persistent at `to` (the old one stays until the caller evicts it).
@requires(device, declassify)
pub Result(Int, Str) moved_key(Int from, Int to, List(Secret(UInt(8))) st, List(Secret(UInt(8))) nst) {
    Result(TpmPublic, TpmError) rp = tpm_read_public(from);
    TpmPublic p = match rp { Ok(x) => x, Err(e) => return_none_pub() };
    if (p.public_area.len() == 0) { return Err("TPM: cannot read the key's public area"); }
    List(UInt(8)) priv = change_auth(from, srk_handle(), st, nst)?;
    _ = tpm_evict(to);
    return match tpm_persist(srk_handle(), TpmBlob {.private_area = priv, .public_area = p.public_area}, to) {
        Ok(_) => Ok(0),
        Err(e) => Err("TPM: " + tpm_error_text(e))
    };
}

TpmPublic return_none_pub() { return TpmPublic {.public_area = [], .type_alg = 0, .name_alg = 0, .name = [], .qualified_name = []}; }

@requires(device, declassify)
Result(List(UInt(8)), Str) change_auth(Int object, Int parent, List(Secret(UInt(8))) st, List(Secret(UInt(8))) nst) {
    return match tpm_change_auth(object, parent, st, nst) { Ok(p) => Ok(p), Err(e) => Err("TPM: " + tpm_error_text(e)) };
}
