// Symbolon Home (agent/home.resid, agent/boxseal.resid): the box's keys
// sealed at rest (R3U-3), the box never a witness majority (R3U-3), the
// invite spent on first use (R3U-9), over fresh directories under /tmp.

import "../types.resid";
import "state.resid";
import "common.resid";
import "boxseal.resid";
import "device.resid";
import "home.resid";
import "alerts.resid";
import "../net/store.resid";
import "httpserv.resid";
import "ecdsa.resid";
import "crypto.resid";
import "aesgcm.resid";

@requires(filesystem, declassify)
Str tmp_dir() {
    Str d = "/tmp/symbolon-home-test-" + hex_encode(random_bytes(8));
    _ = filesystem.create_dir(d);
    return d;
}

List(Int) key32(Int n) { return sha256_bytes([n]); }

// Whether `needle` occurs in `hay`.
Bool contains_bytes(List(Int) hay, List(Int) needle, Int i) {
    if (needle.len() == 0) { return true; }
    if (i + needle.len() > hay.len()) { return false; }
    return hay[i..i + needle.len()] == needle || contains_bytes(hay, needle, i + 1);
}

Str wkey(Int n) { return hex_encode(ec_public_key(P256, key32(n))); }

// ─── Sealing ────────────────────────────────────────────────────

test "a sealed file opens only under its key, and holds no byte run of what it seals" {
    List(Int) k = key32(1);
    List(Int) secret = key32(2);
    List(Int) s = seal_bytes(k, "root", secret);
    expect(is_sealed(s)).toBeTrue();
    expect(contains_bytes(s, secret[0..8], 0)).toBeFalse();
    expect(unseal_bytes(k, "root", s)).toEqual(Some(secret));
    expect(unseal_bytes(key32(3), "root", s)).toEqual(None);
    // A changed byte, or the box key on the wrong file, is refused.
    List(Int) t = s[0..30].concat([s[30] ^ 1]).concat(s[31..s.len()]);
    expect(unseal_bytes(k, "root", t)).toEqual(None);
    expect(seal_bytes([1, 2, 3], "root", secret)).toEqual([]);
    // Sealed for one path, it opens under no other (R4-9).
    expect(unseal_bytes(k, "cg-1.cfg", s)).toEqual(None);
}

@requires(declassify)
test "the box key sealed to a passphrase opens with it and not with another" {
    List(Int) k = key32(7);
    List(Int) b = box_key_seal_pass(k, "correct horse battery", 64, 1);
    expect(box_key_kind(b)).toEqual(kind_passphrase());
    expect(contains_bytes(b, k[0..8], 0)).toBeFalse();
    expect(box_key_open_pass(b, "correct horse battery")).toEqual(Some(k));
    expect(box_key_open_pass(b, "correct horse batterY")).toEqual(None);
    expect(box_key_open_pass(b, "")).toEqual(None);
    // Not the TPM kind: the passphrase path refuses a TPM-sealed file.
    expect(box_key_open_pass(b[0..8].concat([kind_tpm()]).concat(b[9..b.len()]), "correct horse battery")).toEqual(None);
}

@requires(filesystem, declassify)
test "a cosigner directory that names the box key writes its secrets sealed, and none without the key" {
    Str d = tmp_dir();
    Str run = tmp_dir();
    List(Int) k = key32(9);
    List(Int) root = key32(10);
    // Not sealed: a plain 0600 file, as before.
    expect(seal_put(d + "/root", root)).toBeTrue();
    expect(filesystem.read_bytes(d + "/root")).toEqual(root);
    // Sealed: the disk holds no key bytes; get_file opens it.
    _ = filesystem.write_secret(run + "/box.key", k);
    _ = filesystem.write_all(d + "/" + seal_ptr_name(), run + "/box.key");
    expect(put_secret_file(d + "/root", root)).toBeTrue();
    List(Int) disk = filesystem.read_bytes(d + "/root");
    expect(is_sealed(disk)).toBeTrue();
    expect(contains_bytes(disk, root[0..8], 0)).toBeFalse();
    expect(get_file(d + "/root")).toEqual(root);
    // A public file is read as it is.
    _ = filesystem.write_bytes(d + "/cosigner.cbor", [1, 2, 3]);
    expect(get_file(d + "/cosigner.cbor")).toEqual([1, 2, 3]);
    // The box key gone from memory (the box stopped): nothing opens, and a
    // secret is not written in the clear instead.
    _ = filesystem.write_secret(run + "/box.key", []);
    expect(get_file(d + "/root")).toEqual([]);
    expect(put_secret_file(d + "/cg-1.cfg", root)).toBeFalse();
    expect(filesystem.exists(d + "/cg-1.cfg")).toBeFalse();
}

@requires(filesystem, declassify)
test "home secure seals every key file of an existing box in place, and leaves the public ones" {
    Str d = tmp_dir();
    _ = filesystem.create_dir(d + "/tls");
    _ = filesystem.create_dir(d + "/people");
    _ = filesystem.create_dir(d + "/people/alice");
    _ = filesystem.create_dir(d + "/people/alice/cos");
    Str cos = d + "/people/alice/cos";
    List(Int) k = key32(20);
    _ = filesystem.write_secret(d + "/w1.key", key32(21));
    _ = filesystem.write_secret(d + "/w2.key", key32(22));
    _ = filesystem.write_secret(d + "/tls/ca.key", key32(23));
    _ = filesystem.write_secret(cos + "/root", key32(24));
    _ = filesystem.write_secret(cos + "/cg-2.cfg", key32(25));
    _ = filesystem.write_secret(cos + "/kit-half-2.raw", key32(26));
    _ = filesystem.write_secret(cos + "/pending-3-ab.kb", key32(27));
    _ = filesystem.write_bytes(cos + "/cosigner.cbor", [9, 9]);
    _ = filesystem.write_all(cos + "/pending.tag", "3-ab");
    expect(seal_box_files(d, k)).toBeTrue();
    expect(is_sealed(filesystem.read_bytes(d + "/w1.key"))).toBeTrue();
    expect(is_sealed(filesystem.read_bytes(d + "/w2.key"))).toBeTrue();
    expect(is_sealed(filesystem.read_bytes(d + "/tls/ca.key"))).toBeTrue();
    expect(is_sealed(filesystem.read_bytes(cos + "/root"))).toBeTrue();
    expect(is_sealed(filesystem.read_bytes(cos + "/cg-2.cfg"))).toBeTrue();
    expect(is_sealed(filesystem.read_bytes(cos + "/kit-half-2.raw"))).toBeTrue();
    expect(is_sealed(filesystem.read_bytes(cos + "/pending-3-ab.kb"))).toBeTrue();
    expect(filesystem.read_bytes(cos + "/cosigner.cbor")).toEqual([9, 9]);
    expect(filesystem.read_all(cos + "/pending.tag")).toEqual("3-ab");
    expect(box_file(d, "w1.key", k)).toEqual(key32(21));
    expect(box_file(d, "w2.key", k)).toEqual(key32(22));
    // Running it again changes nothing (no file sealed twice).
    List(Int) once = filesystem.read_bytes(cos + "/root");
    expect(seal_box_files(d, k)).toBeTrue();
    expect(filesystem.read_bytes(cos + "/root")).toEqual(once);
}

@requires(filesystem, declassify)
test "home secure seals the relay's store, the alert settings and the cosigner's mail token in place" {
    Str d = tmp_dir();
    Str cos = d + "/people/bob/cos";
    _ = filesystem.create_dir(d + "/people");
    _ = filesystem.create_dir(d + "/people/bob");
    _ = filesystem.create_dir(cos);
    _ = filesystem.create_dir(d + "/relay");
    _ = filesystem.create_dir(d + "/relay/auth");
    _ = filesystem.create_dir(d + "/relay/log");
    _ = filesystem.create_dir(d + "/relay/log/ab");
    List(Int) k = key32(60);
    List(Int) claim = key32(61);
    List(Int) chal = key32(62);
    _ = filesystem.write_bytes(d + "/relay/auth/claim-key", claim);
    _ = filesystem.write_bytes(d + "/relay/auth/challenge-key", chal);
    _ = filesystem.write_bytes(d + "/relay/log/ab/0", [1, 2, 3]);
    _ = filesystem.write_all(d + "/relay/log/ab/.1.claim", "1700000000");
    _ = filesystem.write_all(d + "/alerts.conf", "smtp_pass=hunter2-secret\nntfy_token=tk_abcdef\n");
    _ = filesystem.write_all(cos + "/relay.mtoken", "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef 1900000000");
    expect(seal_box_files(d, k)).toBeTrue();
    List(Int) ck = filesystem.read_bytes(d + "/relay/auth/claim-key");
    expect(is_sealed(ck)).toBeTrue();
    expect(contains_bytes(ck, claim[0..8], 0)).toBeFalse();
    expect(contains_bytes(filesystem.read_bytes(d + "/relay/auth/challenge-key"), chal[0..8], 0)).toBeFalse();
    expect(is_sealed(filesystem.read_bytes(d + "/relay/log/ab/0"))).toBeTrue();
    // A claim beside an object holds no data and is left as it is.
    expect(filesystem.read_all(d + "/relay/log/ab/.1.claim")).toEqual("1700000000");
    List(Int) conf = filesystem.read_bytes(d + "/alerts.conf");
    expect(is_sealed(conf)).toBeTrue();
    expect(contains_bytes(conf, str_to_bytes("hunter2"), 0)).toBeFalse();
    expect(contains_bytes(conf, str_to_bytes("tk_abc"), 0)).toBeFalse();
    List(Int) mt = filesystem.read_bytes(cos + "/relay.mtoken");
    expect(is_sealed(mt)).toBeTrue();
    expect(contains_bytes(mt, str_to_bytes("0123456789abcdef"), 0)).toBeFalse();
    expect(box_file(d + "/relay", "auth/claim-key", k)).toEqual(claim);
}

@requires(filesystem, declassify, network, clock(readonly))
test "the relay's directory store on a sealed box writes every object sealed, and none without the key" {
    Str d = tmp_dir();
    Str run = tmp_dir();
    List(Int) k = key32(70);
    List(Int) claim = key32(71);
    Store st = FsStore(d);
    // Not sealed: objects as they are.
    expect(st_put(st, "blob/x", [5, 6])).toBeTrue();
    expect(filesystem.read_bytes(d + "/blob/x")).toEqual([5, 6]);
    // Sealed: written sealed, read opened; an object left in the clear
    // reads as none (home secure and home serve seal those in place).
    _ = filesystem.write_secret(run + "/box.key", k);
    _ = filesystem.write_all(d + "/" + seal_ptr_name(), run + "/box.key");
    expect(st_put_new(st, "auth/claim-key", claim)).toEqual(1);
    List(Int) disk = filesystem.read_bytes(d + "/auth/claim-key");
    expect(is_sealed(disk)).toBeTrue();
    expect(contains_bytes(disk, claim[0..8], 0)).toBeFalse();
    expect(st_bytes(st, "auth/claim-key")).toEqual(claim);
    expect(st_put(st, "auth/challenge-key", key32(72))).toBeTrue();
    expect(contains_bytes(filesystem.read_bytes(d + "/auth/challenge-key"), key32(72)[0..8], 0)).toBeFalse();
    expect(st_bytes(st, "auth/challenge-key")).toEqual(key32(72));
    expect(st_get(st, "blob/x")).toEqual(None);
    // The listing does not show the pointer.
    expect(st_list(st, "", "", 100).contains(seal_ptr_name())).toBeFalse();
    // The box key gone from memory: nothing opens, nothing is written.
    _ = filesystem.write_secret(run + "/box.key", []);
    expect(st_get(st, "auth/claim-key")).toEqual(None);
    expect(st_put(st, "blob/y", [1])).toBeFalse();
    expect(st_put_new(st, "blob/z", [1])).toEqual(-1);
    expect(filesystem.exists(d + "/blob/y")).toBeFalse();
}

@requires(filesystem, declassify)
test "the alert settings on a sealed box are written sealed and read by the cosigners through the box key" {
    Str d = tmp_dir();
    Str run = tmp_dir();
    List(Int) k = key32(80);
    _ = filesystem.write_all(d + "/home.txt", "47100\n192.168.1.20\n");
    expect(home_alerts_with(d, ["set", "smtp_pass", "hunter2-secret"], k)).toEqual(0);
    List(Int) conf = filesystem.read_bytes(d + "/alerts.conf");
    expect(is_sealed(conf)).toBeTrue();
    expect(contains_bytes(conf, str_to_bytes("hunter2"), 0)).toBeFalse();
    expect(home_alerts_with(d, ["set", "ntfy_token", "tk_abcdef"], k)).toEqual(0);
    // Another key opens nothing and changes nothing.
    expect(home_alerts_with(d, ["set", "smtp_user", "x"], key32(81))).toEqual(1);
    // The cosigners read it through the box key the box's directory names.
    _ = filesystem.write_secret(run + "/box.key", k);
    _ = filesystem.write_all(d + "/" + seal_ptr_name(), run + "/box.key");
    BoxAlerts b = box_alerts(d);
    expect(setting(b, "smtp_pass")).toEqual("hunter2-secret");
    expect(setting(b, "ntfy_token")).toEqual("tk_abcdef");
}

// "SYMBSEAL" || IV || AES-256-GCM under the one constant: a file sealed
// before R4-9 (format 1).
List(Int) seal1(List(Int) k, List(Int) pt) {
    List(Int) iv = key32(250)[0..12];
    return seal_magic().concat(iv).concat(aes_gcm_seal(k, iv, pt, str_to_bytes("symbolon v1 home sealed file")));
}

// R4-9: one constant as associated data let someone who writes the box's
// disk swap two sealed files; with the pointer deleted the directory was
// "not sealed", and planted plaintext was read and new secrets written
// in the clear.
@requires(filesystem, declassify, network, clock(readonly))
test "a sealed file opens only at its own path, and a sealed directory stays sealed without its pointer" {
    Str d = tmp_dir();
    Str run = tmp_dir();
    List(Int) k = key32(90);
    _ = filesystem.write_secret(run + "/box.key", k);
    _ = filesystem.write_all(d + "/" + seal_ptr_name(), run + "/box.key");
    expect(put_secret_file(d + "/root", key32(91))).toBeTrue();
    expect(put_secret_file(d + "/cg-1.cfg", key32(92))).toBeTrue();
    expect(put_secret_file(d + "/cg-2.cfg", key32(93))).toBeTrue();
    expect(get_file(d + "/cg-1.cfg")).toEqual(key32(92));
    // the epoch-1 share put where epoch 2's is: it does not open there
    _ = filesystem.write_secret(d + "/cg-2.cfg", filesystem.read_bytes(d + "/cg-1.cfg"));
    expect(get_file(d + "/cg-2.cfg")).toEqual([]);
    // a secret planted in the clear is not read, the pointer there or not
    _ = filesystem.write_secret(d + "/kv-1", key32(94));
    expect(get_file(d + "/kv-1")).toEqual([]);
    _ = filesystem.remove(d + "/" + seal_ptr_name());
    expect(filesystem.exists(d + "/" + seal_ptr_name())).toBeFalse();
    expect(get_file(d + "/kv-1")).toEqual([]);
    // without the pointer: nothing written in the clear, nothing opens
    expect(put_secret_file(d + "/kv-2", key32(95))).toBeFalse();
    expect(filesystem.exists(d + "/kv-2")).toBeFalse();
    expect(get_file(d + "/root")).toEqual([]);
    // the relay's store: an object opens only under its own key
    Str r = tmp_dir();
    Store st = FsStore(r);
    _ = filesystem.write_all(r + "/" + seal_ptr_name(), run + "/box.key");
    expect(st_put(st, "auth/challenge-key", key32(96))).toBeTrue();
    expect(st_put(st, "blob/a", [1, 1])).toBeTrue();
    expect(st_put(st, "blob/b", [2, 2])).toBeTrue();
    _ = filesystem.write_bytes(r + "/blob/b", filesystem.read_bytes(r + "/blob/a"));
    expect(st_get(st, "blob/b")).toEqual(None);
    expect(st_get(st, "blob/a")).toEqual(Some([1, 1]));
    // its pointer gone, the store stays sealed: no object in the clear
    _ = filesystem.remove(r + "/" + seal_ptr_name());
    expect(st_put(st, "blob/c", [3])).toBeFalse();
    _ = filesystem.write_bytes(r + "/blob/d", [4]);
    expect(st_get(st, "blob/d")).toEqual(None);
}

// Files sealed before (format 1) are sealed again for their paths once,
// by home serve; after that format 1 opens nowhere.
@requires(filesystem, declassify, network, clock(readonly))
test "home serve seals files of the old format again for their paths, once" {
    Str d = tmp_dir();
    Str run = tmp_dir();
    Str cos = d + "/people/alice/cos";
    _ = filesystem.create_dir(d + "/tls");
    _ = filesystem.create_dir(d + "/seal");
    _ = filesystem.create_dir(d + "/people");
    _ = filesystem.create_dir(d + "/people/alice");
    _ = filesystem.create_dir(cos);
    _ = filesystem.create_dir(d + "/relay");
    _ = filesystem.create_dir(d + "/relay/blob");
    List(Int) k = key32(100);
    _ = filesystem.write_secret(d + "/w1.key", seal1(k, key32(101)));
    _ = filesystem.write_secret(cos + "/root", seal1(k, key32(102)));
    _ = filesystem.write_secret(cos + "/cg-1.cfg", seal1(k, key32(103)));
    _ = filesystem.write_bytes(d + "/relay/blob/x", seal1(k, [7, 7]));
    _ = filesystem.write_secret(run + "/box.key", k);
    _ = filesystem.write_all(cos + "/" + seal_ptr_name(), run + "/box.key");
    _ = filesystem.write_all(d + "/relay/" + seal_ptr_name(), run + "/box.key");
    // format 1 does not open as it is
    expect(get_file(cos + "/cg-1.cfg")).toEqual([]);
    expect(box_file(d, "w1.key", k)).toEqual([]);
    expect(seal_migrate(d, k)).toBeTrue();
    expect(seal_format_at(d, k)).toEqual(3);
    expect(is_sealed(filesystem.read_bytes(seal_format_file(d)))).toBeTrue();
    expect(box_file(d, "w1.key", k)).toEqual(key32(101));
    expect(get_file(cos + "/root")).toEqual(key32(102));
    expect(get_file(cos + "/cg-1.cfg")).toEqual(key32(103));
    expect(st_get(FsStore(d + "/relay"), "blob/x")).toEqual(Some([7, 7]));
    // once: a format-1 file put back later is not taken
    _ = filesystem.write_secret(cos + "/cg-1.cfg", seal1(k, key32(104)));
    expect(seal_migrate(d, k)).toBeTrue();
    expect(get_file(cos + "/cg-1.cfg")).toEqual([]);
}

// A box sealed in format 2: its cosigner `alice` holds a format-2 root
// key; `run` holds the box key `k` in memory. The box's directory.
@requires(filesystem, declassify)
Str box2(List(Int) k) {
    Str d = tmp_dir();
    Str run = tmp_dir();
    Str cos = d + "/people/alice/cos";
    _ = filesystem.create_dir(d + "/seal");
    _ = filesystem.create_dir(d + "/people");
    _ = filesystem.create_dir(d + "/people/alice");
    _ = filesystem.create_dir(cos);
    _ = filesystem.create_dir(d + "/relay");
    _ = filesystem.write_secret(run + "/box.key", k);
    _ = filesystem.write_all(cos + "/" + seal_ptr_name(), run + "/box.key");
    _ = filesystem.write_secret(cos + "/root", seal_bytes(k, "root", key32(102)));
    return d;
}

// R5-7: the marker taken away (Resid deletes no file: overwritten, which
// reads as missing) does not run the migration again: a format-1 file put back
// from an old backup is not opened and sealed for its new path, and a
// plaintext secret planted on the disk is not sealed.
@requires(filesystem, declassify, network, clock(readonly))
test "a box whose seal/format marker is taken away does not seal anything again (R5-7)" {
    List(Int) k = key32(100);
    Str d = box2(k);
    Str cos = d + "/people/alice/cos";
    expect(seal_migrate(d, k)).toBeTrue();
    expect(hex_encode(get_file(cos + "/root"))).toEqual(hex_encode(key32(102)));
    _ = filesystem.write_all(seal_format_file(d), "x");
    _ = filesystem.write_secret(cos + "/cg-1.cfg", seal1(k, key32(104)));
    _ = filesystem.write_secret(cos + "/kv-2", [9, 9]);
    expect(seal_migrate(d, k)).toBeTrue();
    expect(hex_encode(get_file(cos + "/cg-1.cfg"))).toEqual("");
    expect(hex_encode(filesystem.read_bytes(cos + "/kv-2"))).toEqual(hex_encode([9, 9]));
    expect(hex_encode(get_file(cos + "/kv-2"))).toEqual("");
    // Nor a plain "2" put in its place.
    _ = filesystem.write_all(seal_format_file(d), "2");
    expect(seal_migrate(d, k)).toBeTrue();
    expect(hex_encode(get_file(cos + "/cg-1.cfg"))).toEqual("");
    expect(hex_encode(get_file(cos + "/root"))).toEqual(hex_encode(key32(102)));
}

// R5-7: the cosigner's state (state.cbor, veto-*, spread-*) is sealed on a
// box; one planted in the clear reads as nothing. A box at format 2 from
// before seals its plaintext state once.
@requires(filesystem, declassify, network, clock(readonly))
test "the cosigner's state on a box is sealed, and a planted state file, veto or spread mark reads as nothing (R5-7)" {
    List(Int) k = key32(200);
    Str d = box2(k);
    Str cos = d + "/people/alice/cos";
    // A box at format 2 from before: the plain marker, the state in the clear.
    _ = filesystem.write_all(seal_format_file(d), "2");
    _ = filesystem.write_bytes(cos + "/state.cbor", [5, 5]);
    _ = filesystem.write_bytes(cos + "/veto-3-4", str_to_bytes("1000 aa"));
    expect(seal_migrate(d, k)).toBeTrue();
    expect(is_sealed(filesystem.read_bytes(cos + "/state.cbor"))).toBeTrue();
    expect(hex_encode(get_file(cos + "/state.cbor"))).toEqual(hex_encode([5, 5]));
    expect(hex_encode(get_file(cos + "/veto-3-4"))).toEqual(hex_encode(str_to_bytes("1000 aa")));
    // Written by the cosigner: sealed, and read back.
    expect(put_secret_file(cos + "/spread-3-4", str_to_bytes("done\n"))).toBeTrue();
    expect(is_sealed(filesystem.read_bytes(cos + "/spread-3-4"))).toBeTrue();
    expect(hex_encode(get_file(cos + "/spread-3-4"))).toEqual(hex_encode(str_to_bytes("done\n")));
    // Planted in the clear, or a sealed one put under another name: nothing.
    _ = filesystem.write_bytes(cos + "/spread-7-8", str_to_bytes("done\n"));
    _ = filesystem.write_bytes(cos + "/veto-7-8", str_to_bytes("1000 aa"));
    _ = filesystem.write_bytes(cos + "/state.cbor", [6, 6]);
    expect(hex_encode(get_file(cos + "/spread-7-8"))).toEqual("");
    expect(hex_encode(get_file(cos + "/veto-7-8"))).toEqual("");
    expect(hex_encode(get_file(cos + "/state.cbor"))).toEqual("");
    _ = filesystem.write_bytes(cos + "/spread-9-9", filesystem.read_bytes(cos + "/spread-3-4"));
    expect(hex_encode(get_file(cos + "/spread-9-9"))).toEqual("");
    // The plain "2" put back does not seal the planted ones.
    _ = filesystem.write_all(seal_format_file(d), "2");
    expect(seal_migrate(d, k)).toBeTrue();
    expect(hex_encode(get_file(cos + "/spread-7-8"))).toEqual("");
    expect(hex_encode(get_file(cos + "/state.cbor"))).toEqual("");
}

test "the unsealed keys go only to a directory in memory" {
    Str m = "rootfs / rootfs rw 0 0\n/dev/sda1 / ext4 rw 0 0\ntmpfs /dev/shm tmpfs rw,nosuid,nodev 0 0\n/dev/sda2 /dev/shm/disk ext4 rw 0 0\noverlay /data overlay rw 0 0\n";
    expect(in_memory_fs("/dev/shm", m)).toBeTrue();
    expect(in_memory_fs("/dev/shm/x", m)).toBeTrue();
    expect(in_memory_fs("/dev/shm/disk/x", m)).toBeFalse();
    expect(in_memory_fs("/dev/shmx", m)).toBeFalse();
    expect(in_memory_fs("/data", m)).toBeFalse();
    expect(in_memory_fs("/tmp", m)).toBeFalse();
    expect(in_memory_fs("/dev/shm", "")).toBeFalse();
}

// ─── Witnesses outside the box ──────────────────────────────────

test "home init needs witnesses outside the box that outnumber the box's own" {
    List(Str) box = ["192.168.1.20", "home.lan"];
    Str a = "pc.lan:47110:" + wkey(31);
    Str b = "witness.example.org:443:" + wkey(32);
    expect(box_minority(1, 3)).toBeTrue();
    expect(box_minority(2, 3)).toBeFalse();
    expect(box_minority(3, 3)).toBeFalse();
    expect(box_minority(2, 5)).toBeTrue();
    expect(witnesses_problem([a, b], box, [], 1)).toEqual("");
    // One outside the box: the box's own would be half; none: all of them.
    expect(str_contains(witnesses_problem([a], box, [], 1), "majority")).toBeTrue();
    expect(str_contains(witnesses_problem([], box, [], 1), "majority")).toBeTrue();
    // An odd number in all (R4-6): three outside and the box's one are four.
    expect(str_contains(witnesses_problem([a, b, "w3.example.org:443:" + wkey(34)], box, [], 1), "odd")).toBeTrue();
    // A legacy box running three needs four outside.
    expect(str_contains(witnesses_problem([a, b], box, [], 3), "majority")).toBeTrue();
    // The same witness twice, or the box's own key, counts once.
    expect(str_len(witnesses_problem([a, "other.lan:47110:" + wkey(31)], box, [], 1)) > 0).toBeTrue();
    expect(str_len(witnesses_problem([a, b], box, [wkey(32)], 1)) > 0).toBeTrue();
    // A witness on the box itself is not outside it.
    expect(str_contains(witnesses_problem([a, "HOME.lan:47103:" + wkey(33)], box, [], 1), "this box")).toBeTrue();
    expect(str_contains(witnesses_problem([a, "127.0.0.1:47103:" + wkey(33)], box, [], 1), "this box")).toBeTrue();
    // Malformed.
    expect(str_len(witness_problem("pc.lan:47110", box)) > 0).toBeTrue();
    expect(str_len(witness_problem("pc.lan:x:" + wkey(31), box)) > 0).toBeTrue();
    expect(str_len(witness_problem("pc.lan:47110:abcd", box)) > 0).toBeTrue();
}

WitnessRef wref(Str url, Int n) { return WitnessRef {.url = url, .key = ec_public_key(P256, key32(n))}; }

@requires(filesystem, declassify)
test "a cosigner on the box reaches its one witness locally and the two outside it where they are" {
    // The policy as the devices hold it: the box's witness at the address
    // the devices use, two witnesses outside the box.
    List(WitnessRef) ws = [wref("192.168.1.20:47102", 40), wref("pc.lan:47110", 41), wref("w.example.org:443", 42)];
    // What `home serve` writes into each cosigner's local_host.
    Str d = tmp_dir();
    _ = filesystem.write_all(d + "/w1.pub", str_to_upper(wkey(40)));
    HomeCfg c = HomeCfg {.base = 47100, .hosts = ["192.168.1.20"], .bind = "0.0.0.0"};
    Str here = local_witnesses(d, c);
    expect(here).toEqual("127.0.0.1 " + wkey(40));
    List(WitnessRef) at = witnesses_at(ws, here);
    expect(at[0].url).toEqual("127.0.0.1:47102");
    expect(at[1].url).toEqual("pc.lan:47110");
    expect(at[2].url).toEqual("w.example.org:443");
    // So two of the three a cosigner asks are outside the box: a majority
    // it can only get from them (before, all three went to 127.0.0.1,
    // where only the box's one listens, and no majority ever answered).
    expect(at[1].key).toEqual(ws[1].key);
    // A box that runs all three (set up before): every witness at the box.
    List(WitnessRef) old = witnesses_at([wref("192.168.1.20:47102", 40), wref("192.168.1.20:47103", 43), wref("192.168.1.20:47104", 44)], "127.0.0.1");
    expect(old[2].url).toEqual("127.0.0.1:47104");
    expect(witnesses_at(ws, "")[0].url).toEqual("192.168.1.20:47102");
}

test "home init listens on the first host's address unless told otherwise" {
    expect(bind_for("", ["192.168.1.20", "10.8.0.1"])).toEqual("192.168.1.20");
    expect(bind_for("0.0.0.0", ["192.168.1.20"])).toEqual("0.0.0.0");
    expect(bind_for("", ["home.lan"])).toEqual("");
}

test "the reminder stays until the keys are sealed, the box is a witness minority, and no identity rests on it" {
    HomeStatus legacy = HomeStatus {.sealed = false, .on_box = 3, .off_box = 0, .people_on_box = ["alice"]};
    expect(status_secure(legacy)).toBeFalse();
    expect(str_contains(status_reminder(legacy), "not sealed")).toBeTrue();
    expect(str_contains(status_reminder(legacy), "every witness")).toBeTrue();
    expect(str_contains(status_reminder(legacy), "alice")).toBeTrue();
    expect(str_contains(status_json(legacy), "\"secure\": false")).toBeTrue();
    HomeStatus moved = HomeStatus {.sealed = true, .on_box = 1, .off_box = 2, .people_on_box = ["alice"]};
    expect(status_secure(moved)).toBeFalse();
    expect(str_contains(status_reminder(moved), "not sealed")).toBeFalse();
    expect(str_contains(status_reminder(moved), "alice")).toBeTrue();
    HomeStatus done = HomeStatus {.sealed = true, .on_box = 1, .off_box = 2, .people_on_box = []};
    expect(status_secure(done)).toBeTrue();
    expect(status_reminder(done)).toEqual("");
    expect(str_contains(status_json(done), "\"secure\": true")).toBeTrue();
}

// ─── The invite (R3U-9) ─────────────────────────────────────────

HttpRequest hreq(Str method, Str path, Str query, List(Int) body) {
    Map(Str, Str) none = {};
    return HttpRequest { .method = method, .target = path, .path = path, .query = query, .version = "HTTP/1.1", .headers = none, .body = body, .keep_alive = false, .ok = true, .status = 0 };
}

Str body_of(HttpReply r) { return http_text(r.body, 0, r.body.len()); }

Str token_in(Str json) {
    Str at = "\"pair_token\": \"";
    Int i = str_index_of(json, at, 0);
    return if (i < 0) { "" } else { str_slice(json, i + str_len(at), i + str_len(at) + 22) };
}

@requires(filesystem, declassify, clock(readonly))
Str invited_box() {
    Str d = tmp_dir();
    _ = filesystem.create_dir(d + "/people");
    _ = filesystem.create_dir(d + "/invites");
    _ = filesystem.create_dir(d + "/tls");
    _ = filesystem.create_dir(d + "/people/alice");
    _ = filesystem.create_dir(d + "/people/alice/cos");
    _ = filesystem.write_all(d + "/home.txt", "47100\n192.168.1.20\n");
    _ = filesystem.write_all(d + "/w1.pub", wkey(40));
    _ = filesystem.write_all(d + "/witnesses.txt", "pc.lan:47110:" + wkey(41) + "\nw.example.org:443:" + wkey(42) + "\n");
    _ = filesystem.write_all(d + "/tls/ca.pem", "-----BEGIN CERTIFICATE-----\n-----END CERTIFICATE-----\n");
    _ = filesystem.write_all(d + "/people/alice/keys", "a1b2");
    _ = filesystem.write_bytes(d + "/people/alice/cos/cosigner.cbor", [1]);
    _ = filesystem.write_all(d + "/invites/AAAAAAAAAAAAAAAAAAAAAA", f"alice {clock_now_seconds() + invite_secs()}");
    _ = filesystem.write_all(d + "/invites/BBBBBBBBBBBBBBBBBBBBBB", f"alice {clock_now_seconds() - 1}");
    return d;
}

Str device_keys() {
    List(Int) p = ec_public_key(P256, key32(50));
    return hex_encode(cbor_of_keys(PartyKeys {.party = sha256_bytes(p), .auth_key = p, .hpke_key = p}));
}

@requires(filesystem, declassify, clock(readonly), provision)
test "the invite code gives the setup once, and only the device that fetched it pairs, once" {
    Str d = invited_box();
    Str c = "c=AAAAAAAAAAAAAAAAAAAAAA";
    HttpReply s1 = pair_handle(d, hreq("GET", "/setup", c, []));
    expect(s1.status).toEqual(200);
    Str j = body_of(s1);
    Str t = token_in(j);
    expect(str_len(t)).toEqual(22);
    // The box's one witness and the two outside it, and the reminder fields.
    expect(str_contains(j, "192.168.1.20:47102:" + wkey(40))).toBeTrue();
    expect(str_contains(j, "pc.lan:47110:")).toBeTrue();
    expect(str_contains(j, "\"secure\": false")).toBeTrue();
    // The code is spent: a second setup, by anyone, is refused.
    expect(pair_handle(d, hreq("GET", "/setup", c, [])).status).toEqual(403);
    // Pairing needs the token the setup gave.
    expect(pair_handle(d, hreq("POST", "/pair", c, str_to_bytes(device_keys()))).status).toEqual(403);
    expect(pair_handle(d, hreq("POST", "/pair", c + "&t=CCCCCCCCCCCCCCCCCCCCCC", str_to_bytes(device_keys()))).status).toEqual(403);
    // Not device keys: refused, and the pairing is not spent by it.
    expect(pair_handle(d, hreq("POST", "/pair", c + "&t=" + t, str_to_bytes("not keys"))).status).toEqual(400);
    HttpReply p = pair_handle(d, hreq("POST", "/pair", c + "&t=" + t, str_to_bytes(device_keys())));
    expect(p.status).toEqual(200);
    expect(str_trim(filesystem.read_all(d + "/people/alice/cos/pair.keys"))).toEqual(device_keys());
    expect(pair_handle(d, hreq("POST", "/pair", c + "&t=" + t, str_to_bytes(device_keys()))).status).toEqual(403);
    // An expired code gets nothing; a wrong one neither.
    expect(pair_handle(d, hreq("GET", "/setup", "c=BBBBBBBBBBBBBBBBBBBBBB", [])).status).toEqual(403);
    expect(pair_handle(d, hreq("GET", "/setup", "c=../../etc/passwd", [])).status).toEqual(403);
    expect(invite_secs()).toEqual(86400);
}

@requires(filesystem, declassify, clock(readonly))
test "the code is spent by exactly one of two racing claims" {
    Str d = invited_box();
    expect(spend(d, "AAAAAAAAAAAAAAAAAAAAAA", "setup", "x")).toBeTrue();
    expect(spend(d, "AAAAAAAAAAAAAAAAAAAAAA", "setup", "y")).toBeFalse();
    expect(filesystem.read_all(d + "/invites/AAAAAAAAAAAAAAAAAAAAAA.setup")).toEqual("x");
}

Str ep_text(Option(Endpoint) oe) { return match oe { None => "none", Some(e) => e.host + f":{e.port}" }; }

test "R5-5: a witness URL is dialled at the address the weakening test compares" {
    expect(ep_text(endpoint_of_url("https://w1.example:443", ""))).toEqual("w1.example:443");
    expect(ep_text(endpoint_of_url("HTTPS://W1.example:443", ""))).toEqual("w1.example:443");
    expect(ep_text(endpoint_of_url(" http://w1:7 ", ""))).toEqual("w1:7");
    expect(ep_text(endpoint_of_url("w1:7", ""))).toEqual("w1:7");
}

test "R5-3: a witness key named twice is asked and counted once" {
    List(WitnessRef) ws = [wref("a.lan:1", 40), wref("b.lan:1", 40), wref("c.lan:1", 43), wref("d.lan:1", 44)];
    List(WitnessRef) at = witnesses_at(ws, "");
    expect(at.len()).toEqual(3);
    expect(at[0].url).toEqual("a.lan:1");
    expect(at[1].url).toEqual("c.lan:1");
    expect(witnesses_at(ws, "127.0.0.1").len()).toEqual(3);
}
