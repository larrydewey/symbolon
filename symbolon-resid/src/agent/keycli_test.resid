// Under the duress PIN (SPEC 14.2), adding or removing a security key
// (keycli.resid) and changing the PIN (device.resid device_pin_with) are
// acted: they report success, the real profile and the key list are as
// they were, and a later list under the duress PIN shows the acted change.
// A fast-KDF unprotected device in target/test-keycli/ (a fresh directory
// per test); the touches of a key are past (key_add_commit takes their
// results), since no authenticator answers here.

import "../types.resid";
import "../duress/duress.resid";
import "state.resid";
import "common.resid";
import "device.resid";
import "fidokey.resid";
import "keycli.resid";
import "crypto.resid";
import "word.resid";

List(Int) rep(Int b, Int n) { return if (n <= 0) { [] } else { [b].concat(rep(b, n - 1)) }; }

@requires(filesystem)
Str fresh_dir() {
    _ = filesystem.create_dir("target/test-keycli");
    Str d = "target/test-keycli/" + hex_encode(random_bytes(8));
    _ = filesystem.create_dir(d);
    return d;
}

DeviceConfig cfg_none() {
    return DeviceConfig {.relay_host = "", .relay_port = 0, .ca = "", .witnesses = [], .unprotected = true, .argon_m_kib = 0, .argon_t = 0, .salt = [],
        .tpm_dk = 0, .tpm_unlock_a = 0, .tpm_unlock_b = 0, .party = [], .dk_pub = [], .hpke_pub = [], .log_id = [], .mbox_next = 0, .peers = []};
}

// A device with PIN 1111 and duress PIN 2222, its log id set (no relay is asked).
@requires(filesystem, device, declassify, provision, network, environment)
DeviceConfig made(Str dir) {
    _ = device_new_pins(dir, "relay.invalid", 1, true, false, true, "", "1111", "2222");
    DeviceConfig c0 = load_config(dir) else { cfg_none() };
    DeviceConfig c = with_log(c0, [], rep(9, 32), 0, []);
    _ = save_config(dir, c);
    return c;
}

@requires(filesystem)
Str files(Str dir) {
    return hex_encode(get_file(dir + "/blob_a")) + "/" + hex_encode(get_file(dir + "/blob_b")) + "/" + hex_encode(get_file(dir + "/blob_a.k")) + "/"
         + hex_encode(get_file(dir + "/blob_b.k")) + "/" + hex_encode(get_file(dir + "/security-keys")) + "/" + hex_encode(get_file(dir + "/config.cbor"));
}

@requires(filesystem, declassify, provision)
Str real_blob(DeviceConfig c, Str dir, Str pin) {
    List(Secret(UInt(8))) k = unlock_key(stretch(c, pin_bytes(pin)), c.salt);
    List(Int) a = get_file(dir + "/blob_a");
    return hex_encode(if (unlock(k, a, []).kind == 1) { a } else { get_file(dir + "/blob_b") });
}

Str joined(List(Str) ns) { return str_join(ns, ","); }

@requires(filesystem, device, declassify, provision, network, environment, clock)
Int add_acted(Str dir, DeviceConfig c, Str pin, Str name) {
    Unlocked u = unlock_dir(dir, c, pin);
    Int r = key_add_commit(dir, c, u, read_keys(dir), name, rep(1, 16), [4].concat(rep(2, 64)), rep(5, 32), secret_bytes(rep(3, 32)));
    return r;
}

@requires(filesystem, device, declassify, provision, network, environment, clock)
test "under the duress PIN a key add and remove report success, change nothing, and a later list shows them" {
    Str dir = fresh_dir();
    DeviceConfig c = made(dir);
    Str before = files(dir);
    Str realb = real_blob(c, dir, "1111");
    expect(unlock_dir(dir, c, "2222").kind).toEqual(2);
    expect(add_acted(dir, c, "2222", "yubi")).toEqual(0);
    expect(add_acted(dir, c, "2222", "backup")).toEqual(0);
    // Nothing the real PIN sees changed: no key enrolled, the profiles as they were.
    expect(read_keys(dir).keys.len()).toEqual(0);
    expect(files(dir)).toEqual(before);
    expect(unlock_dir(dir, c, "1111").kind).toEqual(1);
    expect(real_blob(c, dir, "1111")).toEqual(realb);
    // The list under each PIN.
    expect(joined(shown_names(dir, c, stretch(c, pin_bytes("2222"))))).toEqual("yubi,backup");
    expect(joined(shown_names(dir, c, stretch(c, pin_bytes("1111"))))).toEqual("");
    expect(joined(shown_names(dir, c, stretch(c, pin_bytes("9999"))))).toEqual("");
    expect(get_file(key_view_file(dir)).len()).toEqual(view_file_len());
    // Adding a name the duress list has is refused as a real one would be,
    // before any key is asked for.
    expect(key_add_pin(dir, "yubi", "2222")).toEqual(1);
    // Removing: success for a name in the acted list; refused otherwise.
    expect(key_remove_pin(dir, "yubi", "2222")).toEqual(0);
    expect(key_remove_pin(dir, "nope", "2222")).toEqual(1);
    expect(joined(shown_names(dir, c, stretch(c, pin_bytes("2222"))))).toEqual("backup");
    expect(key_remove_pin(dir, "backup", "2222")).toEqual(0);
    expect(joined(shown_names(dir, c, stretch(c, pin_bytes("2222"))))).toEqual("");
    expect(get_file(key_view_file(dir)).len()).toEqual(view_file_len());
    expect(files(dir)).toEqual(before);
    expect(unlock_dir(dir, c, "1111").kind).toEqual(1);
    expect(unlock_dir(dir, c, "2222").kind).toEqual(2);
    // The real PIN still refuses a name that is not enrolled.
    expect(key_remove_pin(dir, "backup", "1111")).toEqual(1);
}

@requires(filesystem, device, declassify, provision, network, environment, clock)
test "a real add writes the view file too, so its size and presence tell nothing, and ends an acted view" {
    Str dir = fresh_dir();
    DeviceConfig c = made(dir);
    expect(add_acted(dir, c, "2222", "fake")).toEqual(0);
    List(Int) v1 = get_file(key_view_file(dir));
    // The real add (after its touches): the key enrolled, the view file random, same size.
    expect(add_acted(dir, c, "1111", "real")).toEqual(0);
    expect(read_keys(dir).keys.len()).toEqual(1);
    List(Int) v2 = get_file(key_view_file(dir));
    expect(v2.len()).toEqual(v1.len());
    expect(hex_encode(v2) == hex_encode(v1)).toBeFalse();
    expect(joined(shown_names(dir, c, stretch(c, pin_bytes("2222"))))).toEqual("real");
    expect(joined(shown_names(dir, c, stretch(c, pin_bytes("1111"))))).toEqual("real");
}

@requires(declassify)
test "the acted view: sealed to one size, opened only by its key, applied to the real list" {
    List(Secret(UInt(8))) k = secret_bytes(rep(7, 32));
    KeyView small = view_add(empty_view(), "a");
    KeyView big = view_remove(view_add(view_add(empty_view(), "a"), "bb"), "main", ["main", "spare"]);
    expect(seal_view(k, small).len()).toEqual(view_file_len());
    expect(seal_view(k, big).len()).toEqual(view_file_len());
    expect(match open_view(k, seal_view(k, big)) { None => "none", Some(v) => joined(apply_view(["main", "spare"], v)) }).toEqual("spare,a,bb");
    expect(match open_view(secret_bytes(rep(8, 32)), seal_view(k, big)) { None => true, Some(_) => false }).toBeTrue();
    expect(match open_view(k, random_bytes(view_file_len())) { None => true, Some(_) => false }).toBeTrue();
    // Removing a key the act added takes it out; adding back a real one acted away restores it.
    expect(joined(apply_view(["main"], view_remove(view_add(empty_view(), "x"), "x", ["main"])))).toEqual("main");
    expect(joined(apply_view(["main"], view_add(view_remove(empty_view(), "main", ["main"]), "main")))).toEqual("main");
    expect(joined(apply_view(["main"], view_remove(empty_view(), "main", ["main"])))).toEqual("");
}

@requires(filesystem, device, declassify, provision, network, environment, clock)
test "under the duress PIN a PIN change reports success and changes nothing that lasts" {
    Str dir = fresh_dir();
    DeviceConfig c = made(dir);
    Str realb = real_blob(c, dir, "1111");
    Int la = get_file(dir + "/blob_a").len();
    Int lb = get_file(dir + "/blob_b").len();
    Str cfg = hex_encode(get_file(dir + "/config.cbor"));
    Str both = hex_encode(get_file(dir + "/blob_a")) + "/" + hex_encode(get_file(dir + "/blob_b"));
    expect(device_pin_with(dir, c, "2222", "3333")).toEqual(0);
    expect(unlock_dir(dir, c, "1111").kind).toEqual(1);
    expect(unlock_dir(dir, c, "2222").kind).toEqual(2);
    expect(unlock_dir(dir, c, "3333").kind).toEqual(0);
    expect(real_blob(c, dir, "1111")).toEqual(realb);
    // The duress profile's file was written again (other bytes, same size),
    // as the real profile's is on a real change.
    expect(get_file(dir + "/blob_a").len()).toEqual(la);
    expect(get_file(dir + "/blob_b").len()).toEqual(lb);
    expect(hex_encode(get_file(dir + "/blob_a")) + "/" + hex_encode(get_file(dir + "/blob_b")) == both).toBeFalse();
    expect(hex_encode(get_file(dir + "/config.cbor"))).toEqual(cfg);
    // A new PIN equal to the real one, under the duress PIN: success, nothing changed.
    expect(device_pin_with(dir, c, "2222", "1111")).toEqual(0);
    expect(unlock_dir(dir, c, "1111").kind).toEqual(1);
    expect(unlock_dir(dir, c, "2222").kind).toEqual(2);
    // The real PIN: the duress PIN refused as a new PIN; another one taken.
    expect(device_pin_with(dir, c, "1111", "2222")).toEqual(1);
    expect(device_pin_with(dir, c, "1111", "4444")).toEqual(0);
    expect(unlock_dir(dir, c, "4444").kind).toEqual(1);
    expect(unlock_dir(dir, c, "1111").kind).toEqual(0);
    expect(unlock_dir(dir, c, "2222").kind).toEqual(2);
}
