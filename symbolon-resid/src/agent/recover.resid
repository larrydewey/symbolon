// Recovery from the command line (SPEC 13): `symbolon device recover` (R2,
// the kit), `symbolon device veto` (SPEC 13.4) and `symbolon device
// recover-release` (asking the cosigner for its half of the kit's material,
// which it gives only after the delay and never after a veto).
//
// The release and the re-share that follows it run only after the
// recovery delay (at least 24 hours of witness time); tests/cli_e2e.sh
// covers everything before that point, and src/recovery/recovery_ref_test
// the release rules themselves.

import "../types.resid";
import "../core/log.resid";
import "../core/event.resid";
import "../recovery/recovery.resid";
import "../net/proto.resid";
import "../net/services.resid";
import "state.resid";
import "common.resid";
import "session.resid";
import "device.resid";
import "fidokey.resid";
import "enroll.resid";
import "serials.resid";
import "../threshold/threshold.resid";
import "../threshold/reshare.resid";
import "../duress/duress.resid";
import "cosignerd.resid";
import "vaultcli.resid";
import "duresscli.resid";
import "kvagent.resid";
import "kitpass.resid";
import "../vault/kvshare.resid";
import "word.resid";
import "crypto.resid";
import "clock.resid";

// `symbolon device recover DIR KIT LOG_ID`, on a device made with `device
// new`: reveals the kit's key in a recover event naming this device, the
// cosigner and a new kit, which it prints. KIT is the sheet's text; when
// it is protected its passphrase is the first line of standard input (a
// wrong one is refused before anything is sent). Then the new kit's
// passphrase, twice (an empty line: none; SPEC 13.2).
@requires(filesystem, network, device, declassify, clock)
pub Int device_recover(Str dir, Str kit_text, Str log_hex) {
    Option(DeviceConfig) oc = load_config(dir);
    List(Int) l = cose_hex_decode(log_hex);
    if (l.len() != 32) { return dfail("a 32-byte log id"); }
    return match oc {
        None => dfail("run `symbolon device new` first"),
        Some(c) => recover_kit(dir, c, read_kit(kit_text), l)
    };
}

@requires(filesystem, network, device, declassify, clock)
Int recover_kit(Str dir, DeviceConfig c, Result(KitKeys, Str) rk, List(Int) l) {
    return match rk {
        Err(m) => dfail(m),
        Ok(kit) => recover_new_pass(dir, c, kit, l, read_new_kit_pass())
    };
}

@requires(filesystem, network, device, declassify, clock)
Int recover_new_pass(Str dir, DeviceConfig c, KitKeys kit, List(Int) l, NewKitPass np) {
    if (!np.ok) { return dfail(kit_pass_mismatch()); }
    return recover_with(dir, c, kit, l, np.pass);
}

@requires(filesystem, network, device, declassify, clock)
Int recover_with(Str dir, DeviceConfig c0, KitKeys kit, List(Int) l, Str new_pass) {
    Result(VerifiedHead, SymbolonError) rv = verified_log(relay_ep(c0), l);
    return match rv {
        Err(e) => dfail(err_text(e)),
        Ok(vh) => recover_event(dir, with_log(c0, eps_of(vh.head.policy.witnesses, 0, []), l, c0.mbox_next, []), kit, vh, new_pass)
    };
}

@requires(filesystem, network, device, declassify, clock)
Int recover_event(Str dir, DeviceConfig c, KitKeys kit, VerifiedHead vh, Str new_pass) {
    Quorum q = vh.head.quorum;
    Party cos = cosigner_of(q.parties, 0) else { none_party() };
    List(Int) new_seed = random_bytes(32);
    KitKeys nk = kit_keys(new_seed) else { kit };
    // The new kit's sheet before the event that names it.
    if (str_len(new_pass) > 0) { println("device: sealing the new kit under its passphrase (Argon2id; this takes a while)..."); }
    List(Int) sheet = new_kit_sheet(new_seed, new_pass);
    if (sheet.len() == 0) { return dfail("cannot seal the new kit"); }
    Party me = Party {.id = c.party, .kind = party_kind_device(), .auth_key = c.dk_pub, .hpke_key = c.hpke_pub, .label = "recovered device", .attestation = NoAttestation};
    Party nkp = Party {.id = recovery_key_digest(nk.sign_pub), .kind = party_kind_kit(), .auth_key = nk.sign_pub, .hpke_key = nk.hpke_pub, .label = "recovery kit", .attestation = NoAttestation};
    List(Party) np = if (cos.id.len() > 0) { [me, nkp, cos] } else { [me, nkp] };
    Result(SignedEvent, SymbolonError) re = recover_by_kit(vh.head, kit, np, [recovery_key_digest(nk.sign_pub)], (UInt(64))clock_now_seconds());
    return match re {
        Err(e) => dfail(err_text(e)),
        Ok(se) => match publish_event(c, se.payload, se.encoded, se.sigs) {
            Err(m) => dfail("recover: " + m),
            Ok(vh2) => recover_posted(dir, c, vh2, sheet)
        }
    };
}

@requires(filesystem)
Int recover_posted(Str dir, DeviceConfig c, VerifiedHead vh, List(Int) sheet) {
    if (!save_config(dir, c)) { return dfail("cannot store the configuration"); }
    _ = mark_kit_sheet(dir, sheet);
    println(f"recovery pending: {vh.pending.len()} delayed event(s); it takes effect after {vh.head.policy.recovery_delay_sec} s of witness time unless a device vetoes");
    println("NEW RECOVERY KIT (write it down; it is shown once): " + kit_sheet_text(sheet));
    println(kit_sheet_note(sheet));
    return 0;
}

// `symbolon device veto DIR`: vetoes the most recent pending event.
@requires(filesystem, network, device, declassify, clock, provision, environment)
pub Int device_veto(Str dir) {
    Option(DeviceConfig) oc = load_config(dir);
    return match oc {
        None => dfail("not set up"),
        Some(c) => veto_with(dir, c, read_pin())
    };
}

@requires(filesystem, network, device, declassify, clock, provision, environment)
Int veto_with(Str dir, DeviceConfig c, Str pin) {
    Unlocked u = unlock_dir(dir, c, pin);
    if (u.kind == 2) { return dfail(duress_refusal(dir, c)); }
    if (u.kind != 1) { return dfail("wrong PIN"); }
    Result(VerifiedHead, SymbolonError) rv = verified_log(relay_ep(c), c.log_id);
    return match rv {
        Err(e) => dfail(err_text(e)),
        Ok(vh) => if (vh.pending.len() == 0) { dfail("nothing is pending") } else { veto_target(dir, c, u, vh, vh.pending[vh.pending.len() - 1], pin) }
    };
}

// A veto carries advisory time 0 (R3P-3): every device's veto of one
// target at one sequence is then the same event, which the witnesses
// co-sign without the relay's claim when it vetoes what the kit filed
// (core/log.resid il_claimless). It also goes straight to the cosigner's
// mailbox, so that a relay that keeps it out of the log cannot have the
// kit's half released while the cosigner holds it (cosignerd.resid
// on_veto).
@requires(filesystem, network, device, declassify, clock, environment)
Int veto_target(Str dir, DeviceConfig c, Unlocked u, VerifiedHead vh, UInt(64) target, Str pin) {
    List(SignedEvent) es = fetch_log(relay_ep(c), c.log_id, 0, []);
    EventPayload p = EventPayload {.log_id = Some(vh.head.log_id), .sequence = vh.head.sequence + 1, .predecessor_digest = Some(vh.head.digest),
                                   .suite = 1, .body = VetoBody(target), .next_recovery_key_digests = field6_in_force(es, vh.pending, es.len() - 1), .advisory_time = (UInt(64))0};
    List(Int) enc = payload_cbor(p) else { [] };
    Result(List(Int), Str) s = dk_sign(c, u.real, u.st, enc);
    return match s {
        Err(m) => dfail(m),
        Ok(sig) => veto_publish(dir, c, u, vh.head.quorum.parties, p, enc, [EventSig {.signer = c.party, .sig = sig}], target)
    };
}

@requires(filesystem, network, device, declassify, clock, environment)
Int veto_publish(Str dir, DeviceConfig c, Unlocked u, List(Party) ps, EventPayload p, List(Int) enc, List(EventSig) sigs, UInt(64) target) {
    Bool told = veto_to_cosigner(dir, c, u, ps, cbor_of_event(StoredEvent {.encoded = enc, .sigs = sigs, .cosigs = []}));
    if (!told) { eprintln("veto: could not leave the veto in the cosigner's mailbox"); }
    return match publish_event(c, p, enc, sigs) {
        Err(m) => dfail("veto: " + m + if (told) { " (the cosigner holds the veto and releases nothing for that recovery)" } else { "" }),
        Ok(vh2) => veto_done(target, vh2)
    };
}

@requires(filesystem, network, device, declassify, clock, environment)
Bool veto_to_cosigner(Str dir, DeviceConfig c, Unlocked u, List(Party) ps, List(Int) veto) {
    Party cos = cosigner_of(ps, 0) else { none_party() };
    if (cos.id.len() == 0) { return false; }
    Local me = Local {.party = c.party, .cg = 0, .hpke_sk = device_transport(c, u.real.dek).sk};
    Remote cr = Remote {.party = cos.id, .cg = 0, .hpke_pub = cos.hpke_key};
    return send_to(mail_ep(dir, c, u), me, cr, WVeto(veto));
}

// `symbolon device kit-escape DIR KIT_SEED` (SPEC 20.3, R3P-3): the kit
// signs a set-policy that drops the log's sequencing relay and changes
// nothing else, with advisory time 0, and it goes to the witnesses with
// or without the relay's claim. It takes effect after the recovery delay
// unless a device vetoes it; the devices then name another relay
// (`device sequence`).
@requires(filesystem, network, device, declassify, clock)
pub Int device_kit_escape(Str dir, Str seed_hex) {
    Option(DeviceConfig) oc = load_config(dir);
    Option(KitKeys) ok = kit_keys(cose_hex_decode(seed_hex));
    return match oc {
        None => dfail("not set up"),
        Some(c) => match ok {
            None => dfail("that is not a kit seed"),
            Some(kit) => kit_escape_with(c, kit)
        }
    };
}

@requires(filesystem, network, device, declassify, clock)
Int kit_escape_with(DeviceConfig c, KitKeys kit) {
    Result(VerifiedHead, SymbolonError) rv = verified_log(relay_ep(c), c.log_id);
    return match rv {
        Err(e) => dfail(err_text(e)),
        Ok(vh) => kit_escape_at(c, kit, vh)
    };
}

@requires(filesystem, network, device, declassify, clock)
Int kit_escape_at(DeviceConfig c, KitKeys kit, VerifiedHead vh) {
    Policy p0 = vh.head.policy;
    if (p0.sequencer.len() == 0) { println("the log's policy names no sequencing relay"); return 0; }
    Policy np = Policy {.device_sigs_for_authority = p0.device_sigs_for_authority, .recovery_delay_sec = p0.recovery_delay_sec, .guardians = p0.guardians,
                        .guardian_threshold = p0.guardian_threshold, .witnesses = p0.witnesses, .duress_window_sec = p0.duress_window_sec,
                        .sequencer = [], .cosigner_policy = p0.cosigner_policy};
    List(SignedEvent) es = fetch_log(relay_ep(c), c.log_id, 0, []);
    EventPayload p = next_event(vh, SetPolicyBody(np), field6_in_force(es, vh.pending, es.len() - 1));
    List(Int) enc = payload_cbor(p) else { [] };
    if (enc.len() == 0) { return dfail("the policy does not encode"); }
    return match publish_event(c, p, enc, [event_sig(recovery_key_digest(kit.sign_pub), kit.sign_priv, enc)]) {
        Err(m) => dfail("kit-escape: " + m),
        Ok(vh2) => kit_escaped(vh2)
    };
}

Int kit_escaped(VerifiedHead vh) {
    println(f"the kit's set-policy is witnessed: the log drops its sequencing relay once the recovery delay has run, unless a device vetoes ({vh.pending.len()} pending)");
    return 0;
}


// ─── `device pending DIR` and `device confirm DIR SEQ` (SPEC 8.2) ───
// In a household of two devices or more, an authority event one device
// signs alone (a proposal, a removal, a set-policy, a kit renewal) waits
// out the recovery delay, during which any other device may veto it. Or
// another device confirms it: a confirm event, signed by that device,
// naming the pending event's sequence and digest, with which the event
// takes effect at once once its signers and the confirm's reach policy[1]
// (core/log.resid do_confirm). Never for a recover, the kit's set-policy
// or a set-policy that weakens the policy.

// What a pending event is, in a word or two.
Str event_kind(EventBody b) {
    return match b {
        ProposePartyBody(p, _) => "propose-party (\"" + p.label + "\")",
        RemovePartyBody(_) => "remove-party",
        SetPolicyBody(_) => "set-policy",
        RotateRecoveryBody => "rotate-recovery (a new kit)",
        RecoverBody(_) => "recover",
        MigrateBody(_) => "migrate",
        _ => "other"
    };
}

// The labels of the parties of `ps` that `sigs` name.
Str signer_labels(List(EventSig) sigs, List(Party) ps, Int i, Str acc) {
    if (i >= sigs.len()) { return acc; }
    Party p = pend_party(ps, sigs[i].signer, 0) else { none_party() };
    Str one = if (p.id.len() == 0) { "?" } else { "\"" + p.label + "\"" };
    return signer_labels(sigs, ps, i + 1, if (str_len(acc) == 0) { one } else { acc + ", " + one });
}

Option(Party) pend_party(List(Party) ps, List(Int) id, Int i) {
    if (i >= ps.len()) { return None; }
    if (bytes_eq(ps[i].id, id)) { return Some(ps[i]); }
    return pend_party(ps, id, i + 1);
}

Bool pend_signed_by(List(EventSig) sigs, List(Int) id, Int i) {
    if (i >= sigs.len()) { return false; }
    return bytes_eq(sigs[i].signer, id) || pend_signed_by(sigs, id, i + 1);
}

// The events pending now: those il_pending_events reports and the head
// still lists (it was verified at the current witness time).
List(PendingEvent) pend_live(List(PendingEvent) pe, List(UInt(64)) now, Int i, List(PendingEvent) acc) {
    if (i >= pe.len()) { return acc; }
    return pend_live(pe, now, i + 1, if (now.contains(pe[i].seq)) { acc.concat([pe[i]]) } else { acc });
}

Str pending_line(List(SignedEvent) es, List(Party) ps, PendingEvent p) {
    Int s = (Int)p.seq;
    SignedEvent e = es[s];
    EventBody b = e.payload.body;
    Str d = str_slice(hex_encode(p.digest), 0, 16);
    Str how = if (p.confirmable) { "confirmable" } else { "not-confirmable" };
    return f"{s} " + d + f" {p.ready_at} " + how + " " + event_kind(b) + "; signed by " + signer_labels(e.sigs, ps, 0, "");
}

// `symbolon device pending DIR`: the log's pending events, one per line:
// "SEQ DIGEST READY confirmable|not-confirmable KIND; signed by LABELS":
// DIGEST the first 16 hex digits of the event's digest, READY the witness
// time it takes effect at unless vetoed, and whether devices may confirm
// it (a recover, the kit's set-policy or a weakening set-policy may only
// be vetoed or left to run).
@requires(filesystem, network, clock(readonly), declassify)
pub Int device_pending(Str dir) {
    Option(DeviceConfig) oc = load_config(dir);
    return match oc {
        None => dfail("not set up"),
        Some(c) => match verified_log(relay_ep(c), c.log_id) {
            Err(e) => dfail(err_text(e)),
            Ok(vh) => pending_list(c, vh)
        }
    };
}

@requires(network, clock(readonly), declassify)
Int pending_list(DeviceConfig c, VerifiedHead vh) {
    List(SignedEvent) es = fetch_log(relay_ep(c), c.log_id, 0, []);
    List(PendingEvent) pe = pend_live(il_pending_events(c.log_id, es, 0, lambda(x) { false }), vh.pending, 0, []);
    if (pe.len() == 0) { println("nothing is pending"); return 0; }
    pend_print(es, vh.head.quorum.parties, pe, 0);
    return 0;
}

Int pend_print(List(SignedEvent) es, List(Party) ps, List(PendingEvent) pe, Int i) {
    if (i >= pe.len()) { return 0; }
    println(pending_line(es, ps, pe[i]));
    return pend_print(es, ps, pe, i + 1);
}

// `symbolon device confirm DIR SEQ`: this device confirms the pending
// event at SEQ, so that it takes effect at once. Standard input: the PIN,
// then "y" once the event shown is the one meant.
@requires(filesystem, network, device, declassify, clock, provision, environment)
pub Int device_confirm(Str dir, Str seq) {
    Option(DeviceConfig) oc = load_config(dir);
    if (!str_is_int(seq) || str_parse_int(seq) < 1) { return dfail("give the pending event's sequence number (`symbolon device pending DIR` lists them)"); }
    return match oc {
        None => dfail("not set up"),
        Some(c) => confirm_with(dir, c, (UInt(64))str_parse_int(seq), read_pin())
    };
}

@requires(filesystem, network, device, declassify, clock, provision, environment)
Int confirm_with(Str dir, DeviceConfig c, UInt(64) seq, Str pin) {
    Unlocked u = unlock_dir(dir, c, pin);
    if (u.kind == 2) { return dfail(duress_refusal(dir, c)); }
    if (u.kind != 1) { return dfail("wrong PIN"); }
    Result(VerifiedHead, SymbolonError) rv = verified_log(relay_ep(c), c.log_id);
    return match rv {
        Err(e) => dfail(err_text(e)),
        Ok(vh) => confirm_target(c, u, vh, fetch_log(relay_ep(c), c.log_id, 0, []), seq)
    };
}

@requires(network, device, declassify, clock(readonly), environment)
Int confirm_target(DeviceConfig c, Unlocked u, VerifiedHead vh, List(SignedEvent) es, UInt(64) seq) {
    List(PendingEvent) pe = pend_live(il_pending_events(c.log_id, es, 0, lambda(x) { false }), vh.pending, 0, []);
    List(PendingEvent) at = pending_at(pe, seq, 0, []);
    if (at.len() == 0) { return dfail(f"no event is pending at {seq} (`symbolon device pending` lists them)"); }
    PendingEvent p = at[0];
    if (!p.confirmable) { return dfail(f"event {seq} cannot be confirmed (a recover, the kit's set-policy or a set-policy that weakens the policy): veto it or let the delay run"); }
    if (pend_signed_by(es[(Int)seq].sigs, c.party, 0)) { return dfail(f"this device signed event {seq}: another device of the household must confirm it"); }
    println("pending " + pending_line(es, vh.head.quorum.parties, p));
    eprintln(f"device: confirm event {seq}, so that it takes effect now? (y/N)");
    Str a = str_to_lower(str_trim(read_pin()));
    if (a != "y" && a != "yes") { return dfail("not confirmed"); }
    EventPayload np = next_event(vh, ConfirmBody(seq, p.digest), field6_in_force(es, vh.pending, es.len() - 1));
    List(Int) enc = payload_cbor(np) else { [] };
    if (enc.len() == 0) { return dfail("the confirm does not encode"); }
    Result(List(Int), Str) s = dk_sign(c, u.real, u.st, enc);
    return match s {
        Err(m) => dfail(m),
        Ok(sig) => match publish_event(c, np, enc, [EventSig {.signer = c.party, .sig = sig}]) {
            Err(m) => dfail("confirm: " + m),
            Ok(vh2) => confirm_done(seq, vh2)
        }
    };
}

List(PendingEvent) pending_at(List(PendingEvent) pe, UInt(64) seq, Int i, List(PendingEvent) acc) {
    if (i >= pe.len()) { return acc; }
    return pending_at(pe, seq, i + 1, if (pe[i].seq == seq) { acc.concat([pe[i]]) } else { acc });
}

Int confirm_done(UInt(64) seq, VerifiedHead vh) {
    println(f"confirmed event {seq}: in force now; pending now {vh.pending.len()}");
    return 0;
}

Int veto_done(UInt(64) target, VerifiedHead vh) {
    println(f"vetoed event {target}; pending now {vh.pending.len()}");
    return 0;
}

// `symbolon device recover-release DIR`: asks the cosigner for its half of
// the kit's material. Before the recovery has taken effect, or after a
// veto, the cosigner refuses.
@requires(filesystem, network, device, declassify, clock, provision, environment)
pub Int device_recover_release(Str dir) {
    Option(DeviceConfig) oc = load_config(dir);
    return match oc {
        None => dfail("not set up"),
        Some(c) => release_with(dir, c, read_pin())
    };
}

@requires(filesystem, network, device, declassify, clock, provision, environment)
Int release_with(Str dir, DeviceConfig c, Str pin) {
    Unlocked u = unlock_dir(dir, c, pin);
    if (u.kind == 2) { return dfail(duress_refusal(dir, c)); }
    if (u.kind != 1) { return dfail("wrong PIN"); }
    Endpoint relay = mail_ep(dir, c, u);
    List(SignedEvent) es = fetch_log(relay, c.log_id, 0, []);
    Party cos = cosigner_of(quorum_before(es), 0) else { none_party() };
    if (cos.id.len() == 0) { return dfail("no cosigner"); }
    Local me = Local {.party = c.party, .cg = 0, .hpke_sk = device_transport(c, u.real.dek).sk};
    Remote cr = Remote {.party = cos.id, .cg = 0, .hpke_pub = cos.hpke_key};
    Int start = mailbox_end(relay, c.party, c.mbox_next);
    if (!send_to(relay, me, cr, WKitRelease(c.log_id))) { return dfail("cannot reach the relay"); }
    Waited w = wait_release(relay, me, cr, Cursor {.party = c.party, .next = start}, clock_now_seconds());
    Option(Packet) ow = w.w;
    return match ow {
        None => dfail("no answer from the cosigner"),
        Some(x) => match x {
            WKitHalf(_) => released(),
            _ => dfail("the cosigner refused to release its half (the recovery has not taken effect)")
        }
    };
}

// The cosigner's kit half, wrapped to this device's transport key: the
// current one, or v1 for a half wrapped before the security update.
@requires(declassify)
pub List(Int) half_unwrap(List(List(Secret(UInt(8)))) sks, Int i, List(Int) l, UInt(32) epoch, List(Int) party, Wrapped w) {
    if (i >= sks.len()) { return []; }
    List(Int) h = offline_unwrap(reveal(sks[i]), l, epoch, party, w) else { [] };
    return if (h.len() > 0) { h } else { half_unwrap(sks, i + 1, l, epoch, party, w) };
}

Int released() { println("the cosigner released its half of the kit's material"); return 0; }

// The quorum of the inception (the cosigner named there).
List(Party) quorum_before(List(SignedEvent) es) {
    if (es.len() == 0) { return []; }
    EventBody b = es[0].payload.body;
    return match b { InceptionBody(q, _) => q.parties, _ => [] };
}

Int answer_kind(Packet w) { return match w { WKitHalf(_) => 1, WRefused(_) => 1, _ => 0 }; }

Option(Packet) first_answer(List(Got) gs, Int i) {
    if (i >= gs.len()) { return None; }
    if (answer_kind(gs[i].w) == 1) { return Some(gs[i].w); }
    return first_answer(gs, i + 1);
}

@requires(network, declassify, clock)
Waited wait_release(Endpoint relay, Local me, Remote from, Cursor cur, Int since) {
    Drained d = drain(relay, me, [from], cur, ListBuf());
    Option(Packet) w = first_answer(d.got, 0);
    if (match w { Some(_) => true, None => false } || clock_now_seconds() - since > 60) { return Waited {.w = w, .all = d.got, .cur = d.cur}; }
    _ = clock_sleep_ms(200);
    return wait_release(relay, me, from, d.cur, since);
}

// ─── `device recover-finish DIR KIT [PRIMES]` (SPEC 13.2 step 4) ──
// Standard input: the PIN, then the kit's passphrase if KIT is protected.
// After the delay: the cosigner's half and the kit's half give the kit's
// share x_K and key k_K; k_K opens the chain code and vault key; this
// device, holding x_K at the kit's x-coordinate, re-shares with the
// cosigner to the recovered quorum, and the new kit gets fresh material.

@requires(filesystem, network, device, declassify, clock, provision, environment)
pub Int device_recover_finish(Str dir, Str kit_text, Str primes_file) {
    Option(DeviceConfig) oc = load_config(dir);
    return match oc {
        None => dfail("not set up"),
        Some(c) => finish_kit(dir, c, read_pin(), kit_text, primes_file)
    };
}

@requires(filesystem, network, device, declassify, clock, provision, environment)
Int finish_kit(Str dir, DeviceConfig c, Str pin, Str kit_text, Str primes_file) {
    Result(KitKeys, Str) rk = read_kit(kit_text);
    return match rk {
        Err(m) => dfail(m),
        Ok(kit) => finish_with(dir, c, kit, pin, primes_file)
    };
}

// The quorum in force just before the latest recover that names `me`.
@requires(network, clock(readonly))
Option(Quorum) quorum_before_recover(List(SignedEvent) es, List(Int) l, List(Int) me) {
    Int k = last_recover_for(es, me, 0, -1);
    if (k < 1) { return None; }
    List(SignedEvent) prefix = es[0..k];
    return match il_verify(l, prefix, last_time(prefix, policy_of_e0(prefix)), lambda(p) { false }) { Ok(v) => Some(v.head.quorum), Err(_) => None };
}

Int last_recover_for(List(SignedEvent) es, List(Int) me, Int i, Int acc) {
    if (i >= es.len()) { return acc; }
    EventBody b = es[i].payload.body;
    Bool hit = match b { RecoverBody(r) => pos1(r.new_parties, me, 0) > 0, _ => false };
    return last_recover_for(es, me, i + 1, if (hit) { i } else { acc });
}

@requires(filesystem, network, device, declassify, clock, provision, environment)
Int finish_with(Str dir, DeviceConfig c, KitKeys kit, Str pin, Str primes_file) {
    Unlocked u = unlock_dir(dir, c, pin);
    if (u.kind == 2) { return dfail(duress_refusal(dir, c)); }
    if (u.kind != 1) { return dfail("wrong PIN"); }
    Endpoint relay = relay_ep(c);
    Result(VerifiedHead, SymbolonError) rv = verified_log(relay, c.log_id);
    List(SignedEvent) es = fetch_log(relay, c.log_id, 0, []);
    Option(Quorum) opre = quorum_before_recover(es, c.log_id, c.party);
    return match rv {
        Err(e) => dfail(err_text(e)),
        Ok(vh) => match opre {
            None => dfail("no recovery names this device"),
            Some(pre) => if (pos1(vh.head.quorum.parties, c.party, 0) == 0) { dfail("the recovery has not taken effect (delay, or vetoed)") } else { release_then(dir, c, u, kit, vh, pre, pin, primes_file) }
        }
    };
}

@requires(filesystem, network, device, declassify, clock, provision, environment)
Int release_then(Str dir, DeviceConfig c, Unlocked u, KitKeys kit, VerifiedHead vh, Quorum pre, Str pin, Str primes_file) {
    Endpoint relay = mail_ep(dir, c, u);
    Party cos = cosigner_of(vh.head.quorum.parties, 0) else { none_party() };
    Party oldkit = kit_of(pre.parties, 0) else { none_party() };
    Local me = Local {.party = c.party, .cg = 0, .hpke_sk = device_transport(c, u.real.dek).sk};
    Remote cr = Remote {.party = cos.id, .cg = 0, .hpke_pub = cos.hpke_key};
    Int start = mailbox_end(relay, c.party, c.mbox_next);
    if (!send_to(relay, me, cr, WKitRelease(c.log_id))) { return dfail("cannot reach the relay"); }
    Waited w = wait_release(relay, me, cr, Cursor {.party = c.party, .next = start}, clock_now_seconds());
    Option(Packet) ow = w.w;
    List(Int) theirs = match ow {
        Some(x) => match x { WKitHalf(b) => half_unwrap(device_open_keys(c, u.real.dek), 0, c.log_id, vh.head.quorum.epoch, c.party, Wrapped {.enc = b.enc, .ct = b.ct}), _ => [] },
        None => []
    };
    if (theirs.len() != 64) { return dfail("the cosigner did not release its half"); }
    Option(WrappedBlob) oa = blob_of_cbor(kit_blob_get(relay, kit_a_blob(c.log_id, (Int)pre.epoch), kit_a_legacy(c.log_id)) else { [] });
    List(Int) mine = match oa { Some(b) => offline_unwrap(kit.hpke_priv, c.log_id, pre.epoch, oldkit.id, Wrapped {.enc = b.enc, .ct = b.ct}) else { [] }, None => [] };
    Half hb = half_of(theirs) else { Half {.share = [], .key = []} };
    Half ha = half_of(mine) else { Half {.share = [], .key = []} };
    Half full = kit_assemble(ha, hb) else { Half {.share = [], .key = []} };
    if (full.key.len() != 32) { return dfail("the kit's halves do not assemble"); }
    Result(KitSecrets, SymbolonError) ks = kit_secrets_open(secret_bytes(full.key), c.log_id, pre.epoch, kit_blob_get(relay, kit_secrets_blob(c.log_id, (Int)pre.epoch), kit_secrets_legacy(c.log_id)) else { [] });
    // The kit's share of the vault OPRF key (SPEC 18.10.1): a_v from the
    // relay and the cosigner's b_v, released with its kit half.
    Bool has_kv = vh.head.quorum.kv_commits.len() > 0;
    Result(KvScalar, Str) kvs = if (!has_kv) { Err("") } else {
        kv_kit_share(relay, c.log_id, kit.hpke_priv, pre.epoch, oldkit.id, reveal(device_transport(c, u.real.dek).sk), vh.head.quorum.epoch, c.party,
                     kv_wait_half(relay, me, cr, Cursor {.party = c.party, .next = start}, clock_now_seconds() + 60), vh.head.quorum.kv_commits, pos1(pre.parties, oldkit.id, 0))
    };
    if (has_kv && match kvs { Err(_) => true, Ok(_) => false }) { return dfail(match kvs { Err(m) => m, Ok(_) => "" }); }
    KvMode kvm = match kvs { Ok(k) => KvReshare(k), Err(_) => KvNone };
    return match ks {
        Err(e) => dfail(err_text(e)),
        Ok(s) => reshare_as_kit(dir, c, u, s, full.share, vh, pre, oldkit, cos, pin, primes_file, w.cur, kvm)
    };
}

@requires(filesystem, network, device, declassify, clock, provision, environment)
Int reshare_as_kit(Str dir, DeviceConfig c, Unlocked u0, KitSecrets s, List(UInt(64)) xk, VerifiedHead vh, Quorum pre, Party oldkit, Party cos, Str pin, Str primes_file, Cursor cur, KvMode kvm) {
    // The recovered chain code and vault key replace this device's own.
    Unlocked u = Unlocked {.kind = 1, .duress = u0.duress, .st = u0.st, .wrap = u0.wrap, .ukey = u0.ukey, .real = RealProfile {.share = u0.real.share, .cc = s.cc, .vault_key = s.vault_rk, .dek = u0.real.dek, .duress_hpke_pub = u0.real.duress_hpke_pub}};
    Quorum q = vh.head.quorum;
    List(Party) np = q.parties;
    Int kit_old = pos1(pre.parties, oldkit.id, 0);
    List(Int) sid = random_bytes(32);
    ReshareInvite inv0 = ReshareInvite {.session_id = sid, .log_id = c.log_id, .new_parties = np, .dealers = [kit_old, pos1(pre.parties, cos.id, 0)],
        .receivers = receivers_of(np, 0, []), .offline = offline_of(np, 0, []), .degree = (Int)q.t - 1, .epoch = (Int)q.epoch + 1, .requester = c.party, .sig = []};
    Result(List(Int), Str) rs = dk_sign(c, u.real, u.st, request_tbs(sid, reshare_message(inv0), q.epoch, c.party, request_reshare()));
    List(Int) rsig = match rs { Ok(x) => x, Err(_) => [] };
    ReshareInvite inv = ReshareInvite {.session_id = sid, .log_id = c.log_id, .new_parties = np, .dealers = inv0.dealers, .receivers = inv0.receivers,
        .offline = inv0.offline, .degree = inv0.degree, .epoch = inv0.epoch, .requester = c.party, .sig = rsig};
    Endpoint relay = mail_ep(dir, c, u);
    Int me_new = pos1(np, c.party, 0);
    Local me = Local {.party = c.party, .cg = me_new, .hpke_sk = device_transport(c, u.real.dek).sk};
    List(Remote) rem = session_remotes(np, inv.receivers, c.party, 0, []);
    if (rsig.len() != 64 || !send_all_invites(relay, me, rem, WReshare(inv), 0)) { return dfail("cannot send the re-share request"); }
    println("device: re-sharing to the recovered quorum...");
    CgConfig kitcfg = CgConfig {.id = kit_old, .threshold = (Int)q.t - 1, .ecdsa = xk, .elgamal = [], .p = [], .q = [], .rid = [], .chain_key = [], .public = []};
    RsCtx rc = RsCtx {.self = me_new, .old_self = kit_old, .dealers = inv.dealers, .receivers = inv.receivers, .offline = inv.offline, .degree = inv.degree,
        .old = [kitcfg], .root = q.root_pubkey, .session_id = sid, .seed = random_bytes(32), .primes = primes_of(primes_file)};
    return match rs_start(rc) {
        Err(e) => dfail("re-share: " + e.why),
        Ok(s0) => sealed_after(dir, c, u, pin, pre, after_session(dir, c, u, vh, np, inv, rem, pin, kvm,
            run_session(relay, sid, [Seat {.me = me, .st = s0.state, .round = 1, .out = s0.out, .done = false}], rem, [cur], [],
                        lambda(t, msgs) { rs_adapt(t, msgs) }, 1800)))
    };
}

// The recovered device's profile, resealed with the recovered secrets.
@requires(filesystem, network, device, declassify, clock, provision, environment)
Int sealed_after(Str dir, DeviceConfig c, Unlocked u, Str pin, Quorum pre, Int r) {
    if (r != 0) { return r; }
    List(Secret(UInt(8))) k = u.ukey;
    List(Secret(UInt(8))) rp = encode_real(u.real) else { [] };
    Bool a_real = unlock(k, read_blob(dir, "a", u.wrap), []).kind == 1;
    if (!write_blob(dir, if (a_real) { "a" } else { "b" }, seal_blob(k, random_bytes(12), rp), u.wrap)) { return dfail("cannot reseal the profile"); }
    println("recovered: this device holds a share of the recovered quorum");
    Result(VerifiedHead, SymbolonError) rv0 = verified_log(relay_ep(c), c.log_id);
    _ = match rv0 { Ok(v) => send_duress_key(dir, mail_ep(dir, c, u), Local {.party = c.party, .cg = 0, .hpke_sk = device_transport(c, u.real.dek).sk}, cos_remote(v)), Err(_) => false };
    // The vault, re-anchored to the recovered quorum (SPEC 18.4).
    Result(VerifiedHead, SymbolonError) rv = verified_log(relay_ep(c), c.log_id);
    List(SignedEvent) es = fetch_log(relay_ep(c), c.log_id, 0, []);
    Int rk = last_recover_for(es, c.party, 0, -1);
    return match rv {
        Err(e) => dfail(err_text(e)),
        Ok(vh) => if (rk < 0) { 0 } else { vault_reanchor(dir, c, u, vh, pre, es[rk].payload.sequence, pin) }
    };
}
