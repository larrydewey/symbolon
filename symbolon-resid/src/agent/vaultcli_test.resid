// The own vault on the device (src/agent/vaultcli.resid) and the duress
// subset file (duresscli.resid): what a device accepts from the relay over
// time, what the duress PIN shows, and that subset.enc tells nothing.
// Files go to target/test-vaultcli/ (a fresh directory per test).

import "../types.resid";
import "../vault/vault.resid";
import "../duress/duress.resid";
import "state.resid";
import "common.resid";
import "device.resid";
import "duresscli.resid";
import "vaultcli.resid";
import "alertscli.resid";
import "home.resid";
import "sharecli.resid";
import "webauthn.resid";
import "link.resid";
import "recover.resid";
import "enroll.resid";
import "protect.resid";
import "crypto.resid";
import "ecdsa.resid";
import "hash.resid";
import "word.resid";

List(Int) rep(Int b, Int n) { return if (n <= 0) { [] } else { [b].concat(rep(b, n - 1)) }; }

@requires(filesystem)
Str fresh_dir() {
    Str d = "target/test-vaultcli/" + hex_encode(random_bytes(8));
    _ = filesystem.create_dir(d);
    return d;
}

List(Int) log_id() { return rep(9, 32); }
List(Secret(UInt(8))) vk() { return secret_bytes(rep(5, 32)); }
List(Int) privk(Int n) { return rep(0, 31).concat([n]); }
List(Int) idn(Int n) { return sha256_bytes([n]); }

DeviceConfig config() {
    return DeviceConfig {.relay_host = "", .relay_port = 0, .ca = "", .witnesses = [], .unprotected = true, .argon_m_kib = 0, .argon_t = 0, .salt = [],
        .tpm_dk = 0, .tpm_unlock_a = 0, .tpm_unlock_b = 0, .party = idn(2), .dk_pub = [], .hpke_pub = [], .log_id = log_id(), .mbox_next = 0, .peers = []};
}

VerifiedHead vhead() {
    Party a = Party {.id = idn(2), .kind = party_kind_device(), .auth_key = ec_public_key(P256, privk(2)), .hpke_key = [], .label = "a", .attestation = NoAttestation};
    LogHead h = LogHead {.log_id = log_id(), .sequence = 10, .digest = [],
        .quorum = Quorum {.parties = [a], .t = 1, .root_pubkey = [], .epoch = 0, .transcript_digest = [], .kv_commits = []},
        .policy = Policy {.device_sigs_for_authority = 1, .recovery_delay_sec = 86400, .guardians = [], .guardian_threshold = 0, .witnesses = [],
                          .duress_window_sec = 0, .sequencer = [], .cosigner_policy = NoCosignerPolicy}};
    return VerifiedHead {.head = h, .witness_cosigs = [], .pending = []};
}

@requires(declassify)
List(Item) items() {
    List(Int) id = item_id_of(vk(), "mail");
    Item it = item_seal(vk(), vault_id_of(log_id()), id, 1, "password", [FieldPlain {.name = "name", .value = secret_bytes(utf8("mail"))},
        FieldPlain {.name = "secret", .value = secret_bytes(utf8("hunter2"))}], false, None) else {
        Item {.id = [], .version = 0, .kind = "", .fields = {}, .in_duress_subset = false, .handling_policy = None} };
    return [it];
}

VaultState state_at(List(Item) its, UInt(64) ver) {
    VaultHead h0 = VaultHead {.vault_id = vault_id_of(log_id()), .version = ver, .merkle_root = merkle_root(its), .log_id = log_id(),
                              .log_sequence = 4, .suite = 1, .signer = idn(2), .sig = []};
    EcSig s = ecdsa_sign_digest(P256, Sha256, privk(2), hash_bytes(Sha256, head_tbs(h0)));
    return VaultState {.head = VaultHead {.vault_id = h0.vault_id, .version = ver, .merkle_root = h0.merkle_root, .log_id = h0.log_id,
                                          .log_sequence = 4, .suite = 1, .signer = h0.signer, .sig = ecdsa_raw_of(P256, s)}, .items = its};
}

// A state as the relay serves it (CBOR), by way of the device's own copy.
@requires(filesystem, declassify)
List(Int) served_bytes(VaultState st) {
    Str local = fresh_dir() + "/enc";
    _ = keep_place_copy(local, vk(), st);
    return get_file(local + ".cache");
}

Bool is_ok(Result(VaultState, Str) r) { return match r { Ok(_) => true, Err(_) => false }; }

RealProfile real_none() { return RealProfile {.share = [], .cc = [], .vault_key = [], .dek = [], .duress_hpke_pub = []}; }
DuressFull duress_none() { return DuressFull {.share = [], .subkey = [], .vault_key = [], .hpke_priv = [], .tweaks = []}; }

Unlocked as_real() {
    return Unlocked {.kind = 1, .duress = duress_none(), .st = [], .wrap = [],
        .real = RealProfile {.share = secret_bytes(rep(1, 32)), .cc = secret_bytes(rep(2, 32)), .vault_key = vk(), .dek = secret_bytes(rep(3, 32)), .duress_hpke_pub = []}};
}

Unlocked as_duress() {
    return Unlocked {.kind = 2, .real = real_none(), .st = [], .wrap = [],
        .duress = DuressFull {.share = secret_bytes(rep(6, 32)), .subkey = secret_bytes(rep(7, 32)), .vault_key = secret_bytes(rep(8, 32)), .hpke_priv = secret_bytes(rep(4, 32)), .tweaks = []}};
}

Unlocked as_neither() { return Unlocked {.kind = 0, .real = real_none(), .duress = duress_none(), .st = [], .wrap = []}; }

Str err_of(Result(View, Str) r) { return match r { Ok(_) => "ok", Err(m) => m }; }
Int count_of(Result(View, Str) r) { return match r { Ok(v) => v.st.items.len(), Err(_) => 0 - 1 }; }
Int version_of(Result(View, Str) r) { return match r { Ok(v) => (Int)v.st.head.version, Err(_) => 0 - 1 }; }

// ─── Rollback (A-14) ────────────────────────────────────────────

@requires(filesystem, declassify)
test "a vault read once is never taken back to an older state or to none" {
    Str dir = fresh_dir();
    List(Item) its = items();
    expect(is_ok(vault_from(dir, config(), vhead(), Some(served_bytes(state_at(its, 3)))))).toBeTrue();
    // A read-only device: no publish wrote vault.version, the read did.
    expect(is_ok(vault_from(dir, config(), vhead(), None))).toBeFalse();
    expect(is_ok(vault_from(dir, config(), vhead(), Some(served_bytes(state_at(its, 2)))))).toBeFalse();
    expect(is_ok(vault_from(dir, config(), vhead(), Some(served_bytes(state_at([], 2)))))).toBeFalse();
    expect(is_ok(vault_from(dir, config(), vhead(), Some(served_bytes(state_at(its, 3)))))).toBeTrue();
    expect(is_ok(vault_from(dir, config(), vhead(), Some(served_bytes(state_at([], 4)))))).toBeTrue();
}

@requires(filesystem, declassify)
test "a kept copy counts as seen: the relay cannot answer no vault" {
    Str dir = fresh_dir();
    _ = keep_copy(dir, vk(), state_at(items(), 3));
    expect(is_ok(vault_from(dir, config(), vhead(), None))).toBeFalse();
    expect(is_ok(vault_from(dir, config(), vhead(), Some(served_bytes(state_at(items(), 2)))))).toBeFalse();
    // A device that never saw a vault still starts from none.
    expect(is_ok(vault_from(fresh_dir(), config(), vhead(), None))).toBeTrue();
}

// ─── The duress PIN (SPEC 14.2, 14.3) ───────────────────────────

@requires(filesystem, declassify)
test "under the duress PIN the vault reads as the empty subset, never as a wrong PIN" {
    Str dir = fresh_dir();
    Option(List(Int)) b = Some(served_bytes(state_at(items(), 3)));
    Result(View, Str) real = view_for(dir, config(), as_real(), Ok(vhead()), b);
    Result(View, Str) dur = view_for(fresh_dir(), config(), as_duress(), Ok(vhead()), b);
    expect(err_of(real)).toEqual("ok");
    expect(err_of(dur)).toEqual("ok");
    expect(count_of(real)).toEqual(1);
    expect(count_of(dur)).toEqual(0);
    expect(version_of(dur)).toEqual(3);
    // The relay cannot be had and there is no copy: the same error for both.
    Result(VerifiedHead, SymbolonError) off = Err(ErrInvalidLog("no log at the relay"));
    expect(err_of(view_for(fresh_dir(), config(), as_duress(), off, None))).toEqual(err_of(view_for(fresh_dir(), config(), as_real(), off, None)));
    expect(err_of(view_for(fresh_dir(), config(), as_duress(), off, None))).toEqual(unreachable_text());
    // With a copy: both read it (the duress PIN without its items).
    expect(count_of(view_for(dir, config(), as_duress(), off, None))).toEqual(0);
    expect(version_of(view_for(dir, config(), as_duress(), off, None))).toEqual(3);
    expect(count_of(view_for(dir, config(), as_real(), off, None))).toEqual(1);
    // A PIN that opened neither profile.
    expect(err_of(view_for(fresh_dir(), config(), as_neither(), Ok(vhead()), b))).toEqual("wrong PIN");
    // A change under the duress PIN fails as the real profile's does: as
    // an unreachable relay when the log cannot be had, else as a relay
    // that refused the write.
    expect(duress_change(off)).toEqual(unreachable_text());
}

// R2A-3 (a): right after a duress read found the relay, a refused change
// must not say there is no log at the relay; it says what the real
// profile says when the relay fails after the log.
test "a duress refusal after the log verified is not 'no log at the relay'" {
    Result(VerifiedHead, SymbolonError) off = Err(ErrInvalidLog("no log at the relay"));
    expect(duress_change(Ok(vhead()))).toEqual("the relay refused the vault");
    expect(duress_change(Ok(vhead())) == unreachable_text()).toBeFalse();
    expect(duress_refusal_for(Ok(vhead()))).toEqual("cannot reach the relay");
    expect(duress_refusal_for(off)).toEqual(unreachable_text());
}

// R2A-3 (b): an online read under the duress PIN writes vault.cache and
// vault.tag as a real one does, without spoiling the real copy.
@requires(filesystem, declassify)
test "a duress online read writes the copy's files, and never spoils the real copy" {
    Option(List(Int)) b3 = Some(served_bytes(state_at(items(), 3)));
    Option(List(Int)) b4 = Some(served_bytes(state_at(items(), 4)));
    // No copy yet: the duress read leaves one, as a real read would.
    Str d0 = fresh_dir();
    expect(err_of(view_for(d0, config(), as_duress(), Ok(vhead()), b3))).toEqual("ok");
    expect(get_file(d0 + "/vault.cache").len() > 0).toBeTrue();
    expect(get_file(d0 + "/vault.tag").len()).toEqual(32);
    // Its tag is not the real one: the real profile does not trust it, and
    // its next online read replaces it.
    expect(match kept_place_copy(d0 + "/vault", vk()) { None => true, Some(_) => false }).toBeTrue();
    expect(count_of(view_for(d0, config(), as_real(), Ok(vhead()), b3))).toEqual(1);
    expect(match kept_place_copy(d0 + "/vault", vk()) { None => false, Some(_) => true }).toBeTrue();
    // A real copy: written back byte for byte, still the real profile's.
    Str d1 = fresh_dir();
    expect(err_of(view_for(d1, config(), as_real(), Ok(vhead()), b3))).toEqual("ok");
    List(Int) c3 = get_file(d1 + "/vault.cache");
    List(Int) t3 = get_file(d1 + "/vault.tag");
    expect(err_of(view_for(d1, config(), as_duress(), Ok(vhead()), b4))).toEqual("ok");
    expect(hex_encode(get_file(d1 + "/vault.cache"))).toEqual(hex_encode(c3));
    expect(hex_encode(get_file(d1 + "/vault.tag"))).toEqual(hex_encode(t3));
    expect(match kept_place_copy(d1 + "/vault", vk()) { None => false, Some(_) => true }).toBeTrue();
}

// ─── Items a newer agent wrote (SPEC 18.3) ──────────────────────

// "note" as a newer agent might write it: its name in format 2, its secret
// in format 7, which this agent does not know.
@requires(declassify)
Item newer_item() {
    List(Int) id = item_id_of(vk(), "note");
    Item it = item_seal(vk(), vault_id_of(log_id()), id, 4, "password", [FieldPlain {.name = "name", .value = secret_bytes(utf8("note"))}], false, None) else {
        Item {.id = [], .version = 0, .kind = "", .fields = {}, .in_duress_subset = false, .handling_policy = None} };
    return Item {.id = it.id, .version = it.version, .kind = it.kind, .fields = it.fields.insert("secret", [83, 89, 77, 70, 7].concat(rep(66, 48))),
                 .in_duress_subset = false, .handling_policy = None};
}

Str reseal_err(Result(Item, Str) r) { return match r { Ok(_) => "ok", Err(m) => m }; }
Str open_err(Result(List(FieldPlain), Str) r) { return match r { Ok(_) => "ok", Err(m) => m }; }

@requires(filesystem, network, device, declassify, clock, environment)
test "an item a newer agent wrote opens to the update message and survives a re-save byte for byte" {
    Item nw = newer_item();
    List(Int) before = item_cbor(nw);
    Option(List(Int)) b3 = Some(served_bytes(state_at(items().concat([nw]), 3)));
    Str dir = fresh_dir();
    Result(VaultState, Str) r3 = vault_from(dir, config(), vhead(), b3);
    expect(is_ok(r3)).toBeTrue();
    VaultState s3 = r3 else { state_at([], 0) };
    Item got = item_by_id(s3.items, nw.id, 0) else { items()[0] };
    // Opening it says to update, and nothing about tampering.
    expect(open_err(open_full(dir, None, vk(), vault_id_of(log_id()), got))).toEqual("This item was saved by a newer Symbolon; update to open it.");
    // Writing it again (vault put / set of the same name) is refused with
    // the same message; the item is left as it is.
    List(FieldPlain) fs = [FieldPlain {.name = "name", .value = secret_bytes(utf8("note"))}, FieldPlain {.name = "secret", .value = secret_bytes(utf8("new"))}];
    expect(reseal_err(reseal_item(dir, None, vk(), vault_id_of(log_id()), Some(got), got.id, "password", fs))).toEqual("This item was saved by a newer Symbolon; update to open it.");
    // A re-save of the vault (another item changed) carries it byte for byte.
    List(Int) mid = item_id_of(vk(), "mail");
    Item mail = item_by_id(s3.items, mid, 0) else { items()[0] };
    Item mail2 = reseal_item(dir, None, vk(), vault_id_of(log_id()), Some(mail), mid, "password",
        [FieldPlain {.name = "name", .value = secret_bytes(utf8("mail"))}, FieldPlain {.name = "secret", .value = secret_bytes(utf8("changed"))}]) else { mail };
    expect(mail2.version).toEqual(2);
    List(Item) next = without_item(s3.items, mid, 0, ListBuf()).concat([mail2]);
    Result(VaultState, Str) r4 = vault_from(dir, config(), vhead(), Some(served_bytes(state_at(next, 4))));
    expect(is_ok(r4)).toBeTrue();
    VaultState s4 = r4 else { state_at([], 0) };
    expect(s4.items.len()).toEqual(2);
    expect(hex_encode(item_cbor(item_by_id(s4.items, nw.id, 0) else { mail }))).toEqual(hex_encode(before));
}

// ─── Forks (R2A-2, SPEC 18.4) ───────────────────────────────────

@requires(declassify)
test "vault_accept_seen refuses another root at the accepted version" {
    VaultState one = state_at(items(), 5);
    VaultState two = state_at([], 5);
    List(Int) root1 = one.head.merkle_root;
    LogHead h = vhead().head;
    expect(match vault_accept_seen(one, vault_id_of(log_id()), h, 5, root1) { Ok(_) => true, Err(_) => false }).toBeTrue();
    Str m = match vault_accept_seen(two, vault_id_of(log_id()), h, 5, root1) { Ok(_) => "ok", Err(e) => err_text(e) };
    expect(m).toEqual(fork_text(5));
    expect(str_contains(m, "vault fork detected (SPEC 18.4): the relay served two different states at version 5")).toBeTrue();
    expect(match vault_accept_seen(two, vault_id_of(log_id()), h, 4, root1) { Ok(_) => true, Err(_) => false }).toBeTrue();
    // No root recorded (an older device): the version rule alone.
    expect(match vault_accept_seen(two, vault_id_of(log_id()), h, 5, []) { Ok(_) => true, Err(_) => false }).toBeTrue();
}

@requires(filesystem, declassify)
test "a device refuses a sibling state at the version it accepted" {
    Str dir = fresh_dir();
    VaultState mine = state_at(items(), 3);
    expect(is_ok(vault_from(dir, config(), vhead(), Some(served_bytes(mine))))).toBeTrue();
    // The relay now serves another device's state at the same version.
    Result(VaultState, Str) r = vault_from(dir, config(), vhead(), Some(served_bytes(state_at([], 3))));
    expect(match r { Ok(_) => "ok", Err(m) => m }).toEqual(fork_text(3));
    // The same state again is fine, and any later one ends the fork.
    expect(is_ok(vault_from(dir, config(), vhead(), Some(served_bytes(mine))))).toBeTrue();
    expect(is_ok(vault_from(dir, config(), vhead(), Some(served_bytes(state_at([], 4)))))).toBeTrue();
    // vault.version holds the version and the root.
    expect(str_trim(filesystem.read_all(dir + "/vault.version"))).toEqual("4 " + hex_encode(merkle_root([])));
    expect(seen_version(dir + "/vault")).toEqual(4);
    // A state this device kept (its own write) counts as accepted at its version.
    Str d2 = fresh_dir();
    _ = keep_copy(d2, vk(), mine);
    _ = filesystem.write_all(d2 + "/vault.version", "3");
    expect(is_ok(vault_from(d2, config(), vhead(), Some(served_bytes(state_at([], 3)))))).toBeFalse();
    // A record without a root, and no copy: accepted, then the root recorded.
    Str d3 = fresh_dir();
    _ = filesystem.write_all(d3 + "/vault.version", "3");
    expect(is_ok(vault_from(d3, config(), vhead(), Some(served_bytes(mine))))).toBeTrue();
    expect(str_trim(filesystem.read_all(d3 + "/vault.version"))).toEqual("3 " + hex_encode(mine.head.merkle_root));
    expect(is_ok(vault_from(d3, config(), vhead(), Some(served_bytes(state_at([], 3)))))).toBeFalse();
}

// ─── subset.enc (D-6) ───────────────────────────────────────────

@requires(filesystem, declassify)
test "subset.enc is the same size whatever the subset holds" {
    Str dir = fresh_dir();
    RealProfile real = as_real().real;
    expect(update_duress(dir, real, rep(1, 32), rep(2, 32), false)).toBeTrue();
    Int empty = get_file(dir + "/subset.enc").len();
    expect(update_duress(dir, real, rep(3, 32), rep(4, 32), true)).toBeTrue();
    expect(get_file(dir + "/subset.enc").len()).toEqual(empty);
    expect(update_duress(dir, real, rep(5, 32), rep(6, 32), true)).toBeTrue();
    expect(get_file(dir + "/subset.enc").len()).toEqual(empty);
    expect(empty).toEqual(12 + 1 + 64 * max_subset() + 16);
    // The records come back, in either format.
    List(Int) two = rep(3, 32).concat(rep(4, 32)).concat(rep(5, 32)).concat(rep(6, 32));
    expect(hex_encode(subset_records(subset_plain(two)))).toEqual(hex_encode(two));
    expect(hex_encode(subset_records(two))).toEqual(hex_encode(two));
    expect(subset_records(subset_plain([])).len()).toEqual(0);
}
