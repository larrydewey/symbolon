Result(Parsed(Leave, F), SerialError) derive_leave_fields(F s, Option(List(Int)) f_coll_id, Option(List(Int)) f_log_id, Option(UInt(64)) f_roster_version, Option(UInt(64)) f_log_sequence, Option(List(Int)) f_signer, Option(List(Int)) f_sig) {
    Parsed(FieldKey, F) k = read_field(s, derive_leave_names())?;
    FieldKey key = k.value;
    return match key {
        KnownField(i) => derive_leave_field(k.rest, i, f_coll_id, f_log_id, f_roster_version, f_log_sequence, f_signer, f_sig),
        UnknownField(name) => derive_leave_fields(skip_unknown(k.rest, name, derive_leave_names(), false)?, f_coll_id, f_log_id, f_roster_version, f_log_sequence, f_signer, f_sig),
        EndOfFields => derive_leave_done(k.rest, f_coll_id, f_log_id, f_roster_version, f_log_sequence, f_signer, f_sig)
    };
}
@needs(Decoder(F))
Result(Parsed(Leave, F), SerialError) derive_leave_field(F s, Int i, Option(List(Int)) f_coll_id, Option(List(Int)) f_log_id, Option(UInt(64)) f_roster_version, Option(UInt(64)) f_log_sequence, Option(List(Int)) f_signer, Option(List(Int)) f_sig) {
    if (i == 0) { Parsed(Option(List(Int)), F) p = read_slot(s, f_coll_id, "coll_id")?; return derive_leave_fields(p.rest, p.value, f_log_id, f_roster_version, f_log_sequence, f_signer, f_sig); }
    if (i == 1) { Parsed(Option(List(Int)), F) p = read_slot(s, f_log_id, "log_id")?; return derive_leave_fields(p.rest, f_coll_id, p.value, f_roster_version, f_log_sequence, f_signer, f_sig); }
    if (i == 2) { Parsed(Option(UInt(64)), F) p = read_slot(s, f_roster_version, "roster_version")?; return derive_leave_fields(p.rest, f_coll_id, f_log_id, p.value, f_log_sequence, f_signer, f_sig); }
    if (i == 3) { Parsed(Option(UInt(64)), F) p = read_slot(s, f_log_sequence, "log_sequence")?; return derive_leave_fields(p.rest, f_coll_id, f_log_id, f_roster_version, p.value, f_signer, f_sig); }
    if (i == 4) { Parsed(Option(List(Int)), F) p = read_slot(s, f_signer, "signer")?; return derive_leave_fields(p.rest, f_coll_id, f_log_id, f_roster_version, f_log_sequence, p.value, f_sig); }
    Parsed(Option(List(Int)), F) p = read_slot(s, f_sig, "sig")?; return derive_leave_fields(p.rest, f_coll_id, f_log_id, f_roster_version, f_log_sequence, f_signer, p.value);
}
Result(Parsed(Leave, F), SerialError) derive_leave_done(F s, Option(List(Int)) f_coll_id, Option(List(Int)) f_log_id, Option(UInt(64)) f_roster_version, Option(UInt(64)) f_log_sequence, Option(List(Int)) f_signer, Option(List(Int)) f_sig) {
    List(Int) d_coll_id = require(f_coll_id, "coll_id")?;
    List(Int) d_log_id = require(f_log_id, "log_id")?;
    UInt(64) d_roster_version = require(f_roster_version, "roster_version")?;
    UInt(64) d_log_sequence = require(f_log_sequence, "log_sequence")?;
    List(Int) d_signer = require(f_signer, "signer")?;
    List(Int) d_sig = require(f_sig, "sig")?;
    return parsed(Leave {.coll_id = d_coll_id, .log_id = d_log_id, .roster_version = d_roster_version, .log_sequence = d_log_sequence, .signer = d_signer, .sig = d_sig}, s);
}
Decode(Leave, F) = derive_leave_decode;
