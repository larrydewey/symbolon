// The security update (D-4; SPEC 9.2, 14.2, 19.2): `symbolon device
// security-update DIR`, the PIN then the duress PIN (an empty line: this
// device has none) on standard input.
//
// A device made before it has a duress profile whose `share` field is the
// seed of the device's own (v1) transport key, which opens every folder-key
// wrap, kit half and enrolment or re-share envelope addressed to the
// device: whoever is given the duress PIN could read every shared folder.
// The update, under the PIN only:
//   1. re-seals the duress profile with a transport key of its own (fresh
//      random seed in the same field: the blob keeps its size), and
//      registers it with the cosigner with the duress sub-key (duress.pub,
//      130 bytes); without a duress PIN, the second blob, the slot and the
//      registered keys are made again as decoys of the same shape;
//   2. moves the device to its v2 transport key (from the DEK under a label
//      the duress profile never had) with a party-key log event (SPEC 8.1),
//      signed by the DK; others wrap to v2 from then on;
//   3. makes every shared folder's wraps again (sharecli rewrap_all): the
//      ones this device made with v1 no longer authenticate, and the ones
//      others made to v1 are made to v2. What is left is done the next
//      time this device opens that folder under the PIN.
// Then `security-update` is written and the reminder stops. Each step can
// run again: an update cut short is finished by running it again.
//
// Under the duress PIN the command fails as a change does under duress
// (duress_refusal), and the reminder, which depends on that file alone,
// stays exactly as it is under the PIN.

import "../types.resid";
import "../core/log.resid";
import "../core/event.resid";
import "../duress/duress.resid";
import "../net/proto.resid";
import "../net/services.resid";
import "state.resid";
import "common.resid";
import "session.resid";
import "device.resid";
import "fidokey.resid";
import "duresscli.resid";
import "enroll.resid";
import "orgcore.resid";
import "sharecli.resid";
import "hpkeg.resid";
import "word.resid";
import "crypto.resid";
import "clock.resid";
import "dev/tpm.resid";

@requires(filesystem, network, device, declassify, clock, provision, environment)
pub Int device_security_update(Str dir) {
    Option(DeviceConfig) oc = load_config(dir);
    return match oc {
        None => dfail("not set up"),
        Some(c) => update_with(dir, c, read_pin(), read_pin())
    };
}

@requires(filesystem, network, device, declassify, clock, provision, environment)
pub Int update_with(Str dir, DeviceConfig c, Str pin, Str dpin) {
    if (!security_update_due(dir)) { println("security update: done already"); return 0; }
    Unlocked u = unlock_dir(dir, c, pin);
    if (u.kind == 2) { return dfail(duress_refusal(dir, c)); }
    if (u.kind != 1) { return dfail("wrong PIN"); }
    if (str_len(dpin) > 0 && dpin == pin) { return dfail("that is the PIN: give the duress PIN second (an empty line if this device has none)"); }
    // The transport keys ran before: the profile format is what is left.
    if (transport_update_done(dir)) { Int k = keys_update(dir, c, u, dpin, false); return k; }
    // The duress PIN checked before anything changes; then the device moves
    // to v2 first, so that the duress keys are registered with the cosigner
    // under v2: the v1 key is the one the old duress profile holds, and
    // whoever has the duress PIN could otherwise register keys of their
    // own under it, in the device's name, until the move.
    Result(Int, Str) r0 = duress_pin_check(dir, c, u, dpin);
    if (match r0 { Err(_) => true, Ok(_) => false }) { return dfail(match r0 { Err(m) => m, Ok(_) => "" }); }
    Result(DeviceConfig, Str) r2 = move_transport(dir, c, u);
    return match r2 {
        Err(m) => dfail(m),
        Ok(n) => resealed_then_finish(dir, n, u, pin, dpin)
    };
}

@requires(filesystem, network, device, declassify, clock, provision, environment)
Int resealed_then_finish(Str dir, DeviceConfig n, Unlocked u, Str pin, Str dpin) {
    Result(Int, Str) r1 = reseal_duress(dir, n, u, dpin);
    if (match r1 { Err(_) => true, Ok(_) => false }) { return dfail(match r1 { Err(m) => m + " (the device key moved to v2: run the update again)", Ok(_) => "" }); }
    println("security update: the duress profile has its own transport key");
    Int r = finish_update(dir, n, u, pin, dpin);
    return r;
}

// Whether `dpin` is this device's duress PIN, or empty on a device without
// one, before the update changes anything (reseal_duress checks again).
@requires(filesystem, network, device, declassify, clock, provision, environment)
pub Result(Int, Str) duress_pin_check(Str dir, DeviceConfig c, Unlocked u, Str dpin) {
    List(Secret(UInt(8))) ka = unlock_key_for(c, u.st, true);
    Bool real_in_a = unlock(ka, read_blob(dir, "a", u.wrap), []).kind == 1;
    Bool real_in_b = !real_in_a && unlock(ka, read_blob(dir, "b", u.wrap), []).kind == 1;
    if (!real_in_a && !real_in_b) { return Err("the profile does not open again under the PIN; nothing changed"); }
    // An empty line: no duress PIN from now on (no_duress).
    if (str_len(dpin) == 0) { return Ok(0); }
    List(Secret(UInt(8))) dst = stretch(c, pin_bytes(dpin));
    List(Secret(UInt(8))) kb = if (c.unprotected) { unlock_key(dst, c.salt) } else { unlock_key_for(c, dst, false) };
    Unlocked d = unlock(kb, read_blob(dir, if (real_in_a) { "b" } else { "a" }, u.wrap), []);
    if (d.kind != 2) { return Err("that is not this device's duress PIN (an empty line if it has none); nothing changed"); }
    return Ok(0);
}

@requires(filesystem, network, device, declassify, clock, provision, environment)
Int finish_update(Str dir, DeviceConfig c, Unlocked u, Str pin, Str dpin) {
    println("security update: this device's transport key is new (v2)");
    Int left = if (c.log_id.len() == 0) { 0 } else { rewrap_with(dir, c, u, pin) };
    if (!transport_update_record(dir)) { return dfail("cannot record the update"); }
    if (left > 0) { println(f"security update: {left} shared folder(s) get new wraps when next opened"); }
    Int k = keys_update(dir, c, u, dpin, str_len(dpin) == 0);
    return k;
}

@requires(filesystem, network, device, declassify, clock, provision, environment)
Int rewrap_with(Str dir, DeviceConfig c, Unlocked u, Str pin) {
    _ = keep_relay_session(dir, c, u);
    Result(VerifiedHead, SymbolonError) rv = verified_log_dir(dir, relay_ep(c), c.log_id);
    return match rv {
        Err(_) => rewrap_later(dir, c),
        Ok(vh) => rewrap_all(dir, Ctx {.c = c, .u = u, .vh = vh, .pin = pin, .ep = relay_at(dir, c)})
    };
}

// The folders are listed for later when the log cannot be had now.
@requires(filesystem, network, clock(readonly), declassify)
Int rewrap_later(Str dir, DeviceConfig c) {
    List(Str) ids = folder_ids(relay_at(dir, c), c.log_id);
    _ = set_rewrap_todo(dir, ids);
    return ids.len();
}

@requires(filesystem, network, device, declassify, clock, environment)
Bool keep_relay_session(Str dir, DeviceConfig c, Unlocked u) {
    if (session_fresh(dir)) { return true; }
    return match relay_sign_in(dir, c, u) { Ok(_) => true, Err(_) => false };
}

// ─── 1. The duress profile ──────────────────────────────────────

@requires(filesystem, network, device, declassify, clock, provision, environment)
Result(Int, Str) reseal_duress(Str dir, DeviceConfig c, Unlocked u, Str dpin) {
    List(Secret(UInt(8))) ka = unlock_key_for(c, u.st, true);
    Bool real_in_a = unlock(ka, read_blob(dir, "a", u.wrap), []).kind == 1;
    Bool real_in_b = !real_in_a && unlock(ka, read_blob(dir, "b", u.wrap), []).kind == 1;
    if (!real_in_a && !real_in_b) { return Err("the profile does not open again under the PIN; nothing changed"); }
    Str other = if (real_in_a) { "b" } else { "a" };
    if (str_len(dpin) == 0) { return no_duress(dir, c, u, ka, if (real_in_a) { "a" } else { "b" }, other); }
    List(Secret(UInt(8))) dst = stretch(c, pin_bytes(dpin));
    List(Secret(UInt(8))) kb = if (c.unprotected) { unlock_key(dst, c.salt) } else { unlock_key_for(c, dst, false) };
    Unlocked d = unlock(kb, read_blob(dir, other, u.wrap), []);
    if (d.kind != 2) { return Err("that is not this device's duress PIN (an empty line if it has none); nothing changed"); }
    DuressFull nd = new_transport(d.duress, random_secret(32));
    List(Secret(UInt(8))) dp = encode_duress(nd) else { [] };
    if (dp.len() == 0) { return Err("cannot encode the duress profile"); }
    List(Int) blob = seal_blob(kb, random_bytes(12), dp);
    if (unlock(kb, blob, []).kind != 2) { return Err("the duress profile does not open again; nothing changed"); }
    List(Int) dpub = duress_pub_of(nd.subkey, nd.share);
    // Registered first, under the device's v2 key (update_with moves the
    // device before this): until the cosigner has the new key, the duress
    // profile as it was keeps the key it had.
    register_keys(dir, c, u, dpub)?;
    if (!filesystem.write_bytes(dir + "/duress.pub", dpub) || !write_blob(dir, other, blob, u.wrap)) { return Err("cannot write the duress profile"); }
    return Ok(0);
}

// The duress profile with a transport key of its own: the seed in the
// field that held the device's key, everything else as it was.
pub DuressFull new_transport(DuressFull d, List(Secret(UInt(8))) seed) {
    return DuressFull {.share = seed, .subkey = d.subkey, .vault_key = d.vault_key, .hpke_priv = d.hpke_priv, .tweaks = d.tweaks};
}

// Without a duress PIN: whatever the other blob holds becomes a decoy, as
// on a device made without one, and the real profile stops writing to a
// duress profile (slot, dshare and subset as decoys).
@requires(filesystem, network, device, declassify, clock, provision, environment)
Result(Int, Str) no_duress(Str dir, DeviceConfig c, Unlocked u, List(Secret(UInt(8))) ka, Str mine, Str other) {
    List(Int) dpub = duress_pub_of(random_secret(32), random_secret(32));
    register_keys(dir, c, u, dpub)?;
    RealProfile nr = RealProfile {.share = u.real.share, .cc = u.real.cc, .vault_key = u.real.vault_key, .dek = u.real.dek, .duress_hpke_pub = []};
    Bool resealed = if (u.real.duress_hpke_pub.len() == 0) { true } else { reseal_real_in(dir, ka, nr, mine, u.wrap) };
    if (!resealed) { return Err("cannot write the profile"); }
    List(Int) ds = get_file(dir + "/dshare");
    Bool ok = filesystem.write_bytes(dir + "/duress.pub", dpub) && write_blob(dir, other, decoy_blob(random_bytes(blob_len())), u.wrap)
           && update_duress(dir, nr, [], [], false) && (ds.len() == 0 || filesystem.write_bytes(dir + "/dshare", random_bytes(ds.len())));
    return if (ok) { Ok(0) } else { Err("cannot write the duress files") };
}

@requires(filesystem, declassify, provision)
Bool reseal_real_in(Str dir, List(Secret(UInt(8))) ka, RealProfile r, Str which, List(Secret(UInt(8))) w) {
    List(Secret(UInt(8))) rp = encode_real(r) else { [] };
    if (rp.len() == 0) { return false; }
    List(Int) blob = seal_blob(ka, random_bytes(12), rp);
    return unlock(ka, blob, []).kind == 1 && write_blob(dir, which, blob, w);
}

// The duress keys to the cosigner, under this device's transport key (the
// cosigner takes a registration under no other), which is v2 by now:
// never under v1, which the old duress profile holds. A device not in a
// log yet registers at `device init`.
@requires(filesystem, network, declassify, clock)
pub Result(Int, Str) register_keys(Str dir, DeviceConfig c, Unlocked u, List(Int) dpub) {
    if (!registers_under_v2(c, u)) { return Err("the device has not moved to its v2 key: nothing registered"); }
    if (c.log_id.len() == 0) { return Ok(0); }
    VerifiedHead vh = log_or(verified_log_dir(dir, relay_ep(c), c.log_id))?;
    Remote cos = cos_remote(vh);
    if (cos.party.len() == 0) { return Err("no cosigner in the quorum"); }
    Local me = Local {.party = c.party, .cg = 0, .hpke_sk = device_transport(c, u.real.dek).sk};
    return if (send_to(mail_relay(dir, c), me, cos, WDuressKey(dpub))) { Ok(0) } else { Err("cannot reach the relay; nothing changed") };
}

// Whether a registration from configuration `c` goes under the device's
// v2 transport key.
@requires(declassify)
pub Bool registers_under_v2(DeviceConfig c, Unlocked u) { return bytes_eq(device_transport(c, u.real.dek).pk, device_hpke2(u.real.dek).pk); }

// ─── 2. The device's transport key ──────────────────────────────

@requires(filesystem, network, device, declassify, clock, environment)
Result(DeviceConfig, Str) move_transport(Str dir, DeviceConfig c, Unlocked u) {
    List(Int) k2 = device_hpke2(u.real.dek).pk;
    DeviceConfig n = with_transport(c, k2);
    if (c.log_id.len() == 0) {
        if (!save_config(dir, n)) { return Err("cannot store the configuration"); }
        // Not in a log yet: the cosigner's operator pairs with these keys.
        println(hex_encode(cbor_of_keys(PartyKeys {.party = n.party, .auth_key = n.dk_pub, .hpke_key = n.hpke_pub})));
        return Ok(n);
    }
    VerifiedHead vh = log_or(verified_log(relay_ep(c), c.log_id))?;
    Party me = party_in(vh.head.quorum.parties, c.party, 0) else { none_party() };
    if (me.id.len() == 0) { return Err("this device is not in its log's quorum yet"); }
    if (!bytes_eq(me.hpke_key, k2)) {
        List(SignedEvent) es = fetch_log(relay_ep(c), c.log_id, 0, []);
        EventPayload p = EventPayload {.log_id = Some(vh.head.log_id), .sequence = vh.head.sequence + 1, .predecessor_digest = Some(vh.head.digest),
                                       .suite = 1, .body = PartyKeyBody(c.party, k2), .next_recovery_key_digests = field6_in_force(es, vh.pending, es.len() - 1),
                                       .advisory_time = (UInt(64))clock_now_seconds()};
        List(Int) enc = payload_cbor(p) else { [] };
        if (enc.len() == 0) { return Err("the party-key event does not encode"); }
        List(Int) sig = dk_sign(c, u.real, u.st, enc)?;
        VerifiedHead after = prefixed("party-key: ", publish_event(c, p, enc, [EventSig {.signer = c.party, .sig = sig}]))?;
        Party now = party_in(after.head.quorum.parties, c.party, 0) else { none_party() };
        if (!bytes_eq(now.hpke_key, k2)) { return Err("the log does not hold the new key"); }
    }
    return if (save_config(dir, n)) { Ok(n) } else { Err("cannot store the configuration (the log names the new key: run the update again)") };
}

Result(VerifiedHead, Str) log_or(Result(VerifiedHead, SymbolonError) r) {
    Result(VerifiedHead, Str) out = match r { Ok(v) => Ok(v), Err(e) => Err("the log does not verify: " + err_text(e)) };
    return out;
}

Result(VerifiedHead, Str) prefixed(Str p, Result(VerifiedHead, Str) r) {
    Result(VerifiedHead, Str) out = match r { Ok(v) => Ok(v), Err(m) => Err(p + m) };
    return out;
}

pub DeviceConfig with_transport(DeviceConfig c, List(Int) k) {
    return DeviceConfig {.relay_host = c.relay_host, .relay_port = c.relay_port, .ca = c.ca, .witnesses = c.witnesses, .unprotected = c.unprotected,
        .argon_m_kib = c.argon_m_kib, .argon_t = c.argon_t, .salt = c.salt, .tpm_dk = c.tpm_dk, .tpm_unlock_a = c.tpm_unlock_a, .tpm_unlock_b = c.tpm_unlock_b,
        .party = c.party, .dk_pub = c.dk_pub, .hpke_pub = k, .log_id = c.log_id, .mbox_next = c.mbox_next, .peers = c.peers};
}

Option(Party) party_in(List(Party) ps, List(Int) id, Int i) {
    if (i >= ps.len()) { return None; }
    if (bytes_eq(ps[i].id, id)) { return Some(ps[i]); }
    return party_in(ps, id, i + 1);
}

// ─── 3. The profile files (format 2, SPEC 9.4, 14.2) ────────────
// Before format 2 the security keys were listed in the clear
// (security-keys) and both profiles were sealed under one W. Each profile
// gets its own file with its own key list (sealed under a key its PIN
// gives) and its own W:
//   - the real profile keeps the W it had, its list the keys enrolled;
//   - the duress profile gets a new W, and the same keys: their entries
//     give the old W, which `via` turns into the new one (no key needs a
//     touch now). A key added under the duress PIN later is sealed to the
//     new W alone, so it never opens the real profile;
//   - without a duress PIN, the other file is random bytes (and an update
//     slot to a key no one holds, as every profile file has one);
//   - on a TPM, the device key moves to an authValue from the DEK (it no
//     longer moves with the PIN), which unlock key is the real one becomes
//     random in the configuration, and both unlock keys move to a random
//     pair of handles (place_unlock_keys), so the handles no longer say.
// The old files are removed. Each step can run again.
@requires(filesystem, network, device, declassify, clock, provision, environment)
Int keys_update(Str dir, DeviceConfig c0, Unlocked u, Str dpin, Bool dropped) {
    Option(DeviceConfig) oc = load_config(dir);
    DeviceConfig c = oc else { c0 };
    if (!keys_v2(dir)) {
        Result(Int, Str) r = to_format2(dir, c, u, dpin, dropped);
        if (match r { Err(_) => true, Ok(_) => false }) { return dfail(match r { Err(m) => m, Ok(_) => "" }); }
    }
    Option(DeviceConfig) oc2 = load_config(dir);
    DeviceConfig c2 = oc2 else { c };
    Result(Int, Str) d = dk_to_v2(dir, c2, u);
    if (match d { Err(_) => true, Ok(_) => false }) { return dfail(match d { Err(m) => m, Ok(_) => "" }); }
    Option(DeviceConfig) oc3 = load_config(dir);
    DeviceConfig c3 = oc3 else { c2 };
    Result(Int, Str) pl = place_unlock_keys(dir, c3, u, dpin, dropped);
    if (match pl { Err(_) => true, Ok(_) => false }) { return dfail(match pl { Err(m) => m, Ok(_) => "" }); }
    _ = filesystem.remove(dir + "/blob_a");
    _ = filesystem.remove(dir + "/blob_b");
    _ = filesystem.remove(dir + "/blob_a.k");
    _ = filesystem.remove(dir + "/blob_b.k");
    _ = filesystem.remove(dir + "/security-keys");
    _ = filesystem.remove(dir + "/security-keys.view");
    if (!security_update_done(dir)) { return dfail("cannot record the update"); }
    println("security update: each profile has its own sealed list of security keys");
    println("security update: done");
    return 0;
}

@requires(filesystem, network, device, declassify, clock, provision, environment)
pub Result(Int, Str) to_format2(Str dir, DeviceConfig c, Unlocked u, Str dpin, Bool dropped) {
    Bool has = str_len(dpin) > 0;
    if (!has && !dropped && u.real.duress_hpke_pub.len() == 65) { return Err("this device has a duress PIN: give it second (it is kept)"); }
    SecKeys ks = read_keys(dir);
    Bool keyed = ks.keys.len() > 0;
    if (keyed && u.wrap.len() != 32) { return Err("an enrolled key must be present"); }
    Str rw = if (unlock(u.ukey, read_blob(dir, "a", u.wrap), []).kind == 1) { "a" } else { "b" };
    Str dw = if (rw == "a") { "b" } else { "a" };
    List(Int) rb = read_blob(dir, rw, u.wrap);
    List(Int) db = read_blob(dir, dw, u.wrap);
    if (unlock(u.ukey, rb, []).kind != 1) { return Err("the profile does not open again under the PIN; nothing changed"); }
    // On a TPM the unlock key fields are swapped at random: before format
    // 2 the real profile's was always tpm_unlock_a.
    Bool tpm = !c.unprotected && !on_keystore(c);
    if (tpm && (random_bytes(1)[0] & 1) == 0) {
        if (!save_config(dir, with_handles(c, c.tpm_dk, c.tpm_unlock_b, c.tpm_unlock_a))) { return Err("cannot store the configuration"); }
    }
    Option(DeviceConfig) oc = load_config(dir);
    DeviceConfig cs = oc else { c };
    Bool real_on_a = own_on_a(dir, cs, u);
    List(Secret(UInt(8))) dst = if (has) { stretch(cs, pin_bytes(dpin)) } else { random_secret(32) };
    List(Secret(UInt(8))) kd = if (has) { unlock_key_at(cs, dst, !real_on_a) } else { random_secret(32) };
    if (has && unlock(kd, db, []).kind != 2) { return Err("that is not this device's duress PIN (an empty line if it has none); nothing changed"); }
    List(Int) salt = if (ks.salt.len() == 32) { ks.salt } else { random_bytes(32) };
    List(Secret(UInt(8))) wr = if (keyed) { u.wrap } else { random_secret(32) };
    List(Secret(UInt(8))) wd = random_secret(32);
    List(Secret(UInt(8))) lr = random_secret(32);
    List(Secret(UInt(8))) ld = random_secret(32);
    List(Secret(UInt(8))) sr = random_secret(32);
    List(Secret(UInt(8))) sd = random_secret(32);
    List(Secret(UInt(8))) none = [];
    KeyList rl = KeyList {.w = if (keyed) { none } else { wr }, .salt = salt, .via = [], .mine = if (real_on_a) { "a" } else { "b" }, .peer_l = ld, .peer_w = wd, .keys = ks.keys,
                          .sk = sr, .peer_pk = slot_pub(sd), .fill = ""};
    KeyList dl = KeyList {.w = if (keyed) { none } else { wd }, .salt = salt, .via = if (keyed) { seal_via(wd, u.wrap) } else { [] }, .mine = if (real_on_a) { "b" } else { "a" },
                          .peer_l = none, .peer_w = none, .keys = ks.keys, .sk = sd, .peer_pk = slot_pub(sr), .fill = ""};
    List(Int) rf = own_file(u.ukey, lr, rl, wr, rw, rb);
    if (rf.len() == 0) { return Err("too many security keys for one list; remove one first"); }
    List(Int) df = if (has) { own_file(kd, ld, dl, wd, dw, db) } else { decoy_file(rl.peer_pk) };
    // The other first: profile_a marks format 2.
    return if (put_new_pair(dir, rw, rf, df)) { Ok(0) } else { Err("cannot write the profile files") };
}

// TPM: the device key made before format 2 (its authValue the stretched
// PIN) at the format 2 handle with its authValue from the DEK, the
// configuration naming it, the old one evicted.
@requires(filesystem, device, declassify, provision, network, environment)
Result(Int, Str) dk_to_v2(Str dir, DeviceConfig c, Unlocked u) {
    if (c.unprotected || on_keystore(c) || c.tpm_dk == dk_v2_handle()) { return Ok(0); }
    moved_key(c.tpm_dk, dk_v2_handle(), u.st, dk_auth(u.real.dek))?;
    if (!save_config(dir, with_handles(c, dk_v2_handle(), c.tpm_unlock_a, c.tpm_unlock_b))) { return Err("cannot store the configuration (the device key is at its new handle: run the update again)"); }
    _ = tpm_evict(c.tpm_dk);
    return Ok(0);
}

// TPM (SPEC 9.1): before format 2 the real profile's unlock key was in
// tpm_unlock_a's handle family (0x81000112, or 0x81000212 after a PIN
// change) and the other's in tpm_unlock_b's, so the handles said which is
// real; to_format2 swapped the configuration fields at random but not the
// handles. Both keys move here to a random pair of the four pool handles,
// so the exposure ends with the update: the real one under the PIN and the
// duress one under the duress PIN, each with its authValue as it was;
// without a duress PIN the other key, whose authValue no one knows and on
// which no profile depends (its file is random), is replaced by a new one
// under a random authValue. After each move the configuration names the
// new handle before the old one is evicted, so a cut leaves a device that
// opens, and running the update again moves them again.
@requires(filesystem, device, declassify, provision, network, environment)
Result(Int, Str) place_unlock_keys(Str dir, DeviceConfig c, Unlocked u, Str dpin, Bool dropped) {
    if (c.unprotected || on_keystore(c)) { return Ok(0); }
    Bool has = str_len(dpin) > 0;
    if (!has && !dropped && u.real.duress_hpke_pub.len() == 65) { return Err("this device has a duress PIN: give it second (it is kept)"); }
    Bool real_on_a = own_on_a(dir, c, u);
    List(Secret(UInt(8))) dst = if (has) { stretch(c, pin_bytes(dpin)) } else { random_secret(32) };
    if (has) {
        List(Secret(UInt(8))) kd = unlock_key_at(c, dst, !real_on_a);
        OwnList od = if (kd.len() == 32) { open_own(dir, kd) } else { no_own() };
        KeyList dl = od.list;
        if (od.which == "" || dl.peer_l.len() == 32) { return Err("that is not this device's duress PIN (an empty line if it has none); nothing changed"); }
    }
    List(Int) pool = unlock_pool();
    Int i = (random_bytes(1)[0] & 255) % 4;
    Int j = (i + 1 + (random_bytes(1)[0] & 255) % 3) % 4;
    Int hr = if (real_on_a) { c.tpm_unlock_a } else { c.tpm_unlock_b };
    Int hd = if (real_on_a) { c.tpm_unlock_b } else { c.tpm_unlock_a };
    List(List(Int)) moves = placement(pool, hr, hd, pool[i], pool[j]);
    Result(DeviceConfig, Str) r = run_moves(dir, c, u.st, dst, has, real_on_a, moves, 0);
    Result(Int, Str) out = match r { Ok(_) => Ok(0), Err(m) => Err(m) };
    return out;
}

// The moves that take the real profile's unlock key from `hr` to `tr` and
// the other's from `hd` to `td` (tr != td, all in `pool`), each to a handle
// free at its time: [from, to, 0 for the real key or 1 for the other].
pub List(List(Int)) placement(List(Int) pool, Int hr, Int hd, Int tr, Int td) {
    if (tr == hd && td == hr) {
        List(Int) free = pool_others(pool, hr, hd, 0, ListBuf());
        Int t = if (free.len() > 0) { free[0] } else { 0 };
        return [[hr, t, 0], [hd, hr, 1], [t, hd, 0]];
    }
    if (tr == hd) { return [[hd, td, 1], [hr, tr, 0]]; }
    List(List(Int)) first = if (tr == hr) { [] } else { [[hr, tr, 0]] };
    List(List(Int)) second = if (td == hd) { [] } else { [[hd, td, 1]] };
    return first.concat(second);
}

List(Int) pool_others(List(Int) pool, Int x, Int y, Int i, ListBuf(Int) acc) {
    if (i >= pool.len()) { return acc.finish(); }
    return pool_others(pool, x, y, i + 1, if (pool[i] == x || pool[i] == y) { acc } else { acc.push(pool[i]) });
}

// Each move: the key persistent at its new handle (moved under its own
// authValue, or for a decoy made afresh), the configuration naming it, the
// old handle evicted.
@requires(filesystem, device, declassify, provision, network, environment)
Result(DeviceConfig, Str) run_moves(Str dir, DeviceConfig c, List(Secret(UInt(8))) st, List(Secret(UInt(8))) dst, Bool has, Bool real_on_a, List(List(Int)) ms, Int i) {
    if (i >= ms.len()) { return Ok(c); }
    List(Int) m = ms[i];
    Int from = m[0];
    Int to = m[1];
    Bool real = m[2] == 0;
    if (real || has) {
        moved_key(from, to, if (real) { st } else { dst }, if (real) { st } else { dst })?;
    } else {
        _ = tpm_evict(to);
        if (!make_unlock_key(to, random_secret(32))) { return Err("TPM: cannot make the unlock key"); }
    }
    Bool on_a = if (real) { real_on_a } else { !real_on_a };
    DeviceConfig n = with_handles(c, c.tpm_dk, if (on_a) { to } else { c.tpm_unlock_a }, if (on_a) { c.tpm_unlock_b } else { to });
    if (!save_config(dir, n)) { return Err("cannot store the configuration (run the update again)"); }
    _ = tpm_evict(from);
    return run_moves(dir, n, st, dst, has, real_on_a, ms, i + 1);
}
