pub OrgPolicy default_policy() {
    return OrgPolicy {.min_pin_len = 4, .allow_biometric = true, .allow_duress = true, .allow_offline_copy = true, .max_offline_days = 0,
                      .allow_personal_export = true, .require_attestation = [], .password_rules = ""};
}

OrgRecovery no_recovery() { return OrgRecovery {.on = false, .public_key = [], .threshold = 0, .admins = [], .delay_sec = 0, .since = (UInt(64))0, .owner = []}; }

// ─── Signing and storing ────────────────────────────────────────

@requires(device, declassify, network, environment)
Result(OrgGov, Str) sign_gov(Ctx x, OrgGov g0) {
    OrgGov g = OrgGov {.org_id = g0.org_id, .version = g0.version, .founder = g0.founder, .nonce = g0.nonce, .name = g0.name, .owners = g0.owners, .admins = g0.admins,
                       .policy = g0.policy, .recovery = g0.recovery, .log_sequence = x.vh.head.sequence, .signer_log = x.c.log_id, .signer = x.c.party, .sig = []};
    List(Int) sig = dk_sign(x.c, x.u.real, x.u.st, gov_tbs(g))?;
    return Ok(gov_signed(g, sig));
}

@requires(device, declassify, network, environment)
Result(Org, Str) sign_org(Ctx x, List(Int) id, UInt(64) version, UInt(64) gov_version, List(OrgMember) ms, List(OrgGroup) gs, List(List(Int)) att) {
    Org o = Org {.org_id = id, .version = version, .gov_version = gov_version, .members = ms, .groups = gs, .attested = att, .log_sequence = x.vh.head.sequence,
                 .signer_log = x.c.log_id, .signer = x.c.party, .sig = []};
    List(Int) sig = dk_sign(x.c, x.u.real, x.u.st, org_tbs(o))?;
    return Ok(org_signed(o, sig));
}

@requires(network, clock(readonly), declassify)
Result(Int, Str) put_blob(Ctx x, Str name, List(Int) b, Str what) {
    if (b.len() == 0 || !blob_put(x.ep, name, b)) { return Err("the server refused the " + what); }
    return Ok(0);
}

// The membership record again, one version up, under governance `gv`.
@requires(filesystem, network, device, declassify, clock, environment)
Result(Int, Str) store_org(Str dir, Ctx x, OrgState st, UInt(64) gv, List(OrgMember) ms, List(OrgGroup) gs, Str action, Str detail) {
    Org o = sign_org(x, st.org.org_id, st.org.version + (UInt(64))1, gv, ms, gs, st.org.attested)?;
    Int stored = put_blob(x, org_blob(o.org_id), cbor_or_empty(to_cbor(o)), "membership record")?;
    _ = filesystem.write_all(dir + "/org.version", f"{o.version}");
    _ = audit(dir, x, o.org_id, action, hex_encode(o.org_id), detail);
    println(f"organization version {o.version}, {ms.len()} people, {gs.len()} groups");
    return Ok(stored);
}

// A new governance version (an owner only), then the membership record under it.
@requires(filesystem, network, device, declassify, clock, environment)
Result(Int, Str) store_gov(Str dir, Ctx x, OrgState st, List(List(Int)) owners, List(OrgAdmin) admins, OrgPolicy p, Str action, Str detail) {
    return store_gov_r(dir, x, st, owners, admins, p, st.gov.recovery, action, detail);
}

@requires(filesystem, network, device, declassify, clock, environment)
Result(Int, Str) store_gov_r(Str dir, Ctx x, OrgState st, List(List(Int)) owners, List(OrgAdmin) admins, OrgPolicy p, OrgRecovery rec, Str action, Str detail) {
    if (!is_owner(st.gov, x.c.log_id)) { return Err("only an owner changes roles and policy"); }
    if (owners.len() == 0) { return Err("an organization needs an owner"); }
    OrgGov g = sign_gov(x, OrgGov {.org_id = st.gov.org_id, .version = st.gov.version + (UInt(64))1, .founder = st.gov.founder, .nonce = st.gov.nonce, .name = st.gov.name,
                                   .owners = owners, .admins = admins, .policy = p, .recovery = rec, .log_sequence = (UInt(64))0, .signer_log = [], .signer = [], .sig = []})?;
    Int put = put_blob(x, gov_blob(g.org_id, g.version), cbor_or_empty(to_cbor(g)), "governance record")?;
    _ = filesystem.write_all(dir + "/org.gov", f"{g.version}");
    return store_org(dir, x, st, g.version, st.org.members, st.org.groups, action, detail);
}

// This device unlocked, with its organization verified.
pub type OrgCtx = { Ctx x; OrgState st; };

// This device signed in at the relay now (founding, joining).
@requires(filesystem, network, device, declassify, clock, environment)
Result(Ctx, Str) signed_in_ctx(Str dir, Ctx x) {
    Int ok = relay_sign_in(dir, x.c, x.u)?;
    return Ok(Ctx {.c = x.c, .u = x.u, .vh = x.vh, .pin = x.pin, .ep = relay_at(dir, x.c)});
}

@requires(filesystem, network, device, declassify, clock, provision, environment)
Result(OrgCtx, Str) org_unlocked(Str dir) {
    Ctx x = unlocked(dir)?;
    OrgState st = org_at(dir, x.c, x.vh)?;
    return Ok(OrgCtx {.x = x, .st = st});
}

Result(Int, Str) admin_only(OrgCtx o) { return if (is_admin(o.st.gov, o.x.c.log_id)) { Ok(0) } else { Err("only an owner or administrator does that") }; }

// ─── Founding and joining ───────────────────────────────────────

@requires(filesystem, network, device, declassify, clock, provision, environment)
pub Int org_new(Str dir, Str name) { return done(found(dir, name)); }

@requires(filesystem, network, device, declassify, clock, provision, environment)
Result(Int, Str) found(Str dir, Str name) {
    if (!label_ok(name)) { return Err("a name of 1-64 characters"); }
    Ctx x0 = unlocked(dir)?;
    if (match org_ref(dir) { Some(_) => true, None => false }) { return Err("this device is already in an organization"); }
    Ctx x = signed_in_ctx(dir, x0)?;
    List(Int) nonce = random_bytes(16);
    List(Int) id = org_id_of(x.c.log_id, nonce);
    OrgGov g = sign_gov(x, OrgGov {.org_id = id, .version = (UInt(64))1, .founder = x.c.log_id, .nonce = nonce, .name = name, .owners = [x.c.log_id], .admins = [],
                                   .policy = default_policy(), .recovery = no_recovery(), .log_sequence = (UInt(64))0, .signer_log = [], .signer = [], .sig = []})?;
    Str me = own_name(x.c);
    Org o = sign_org(x, id, (UInt(64))1, (UInt(64))1, [OrgMember {.log_id = x.c.log_id, .label = if (str_len(me) > 0) { me } else { "Founder" }, .ext_id = ""}], [], [])?;
    Int a = put_blob(x, gov_blob(id, g.version), cbor_or_empty(to_cbor(g)), "governance record")?;
    Int b = put_blob(x, org_blob(id), cbor_or_empty(to_cbor(o)), "membership record")?;
    if (!filesystem.write_all(dir + "/org", hex_encode(id) + " " + hex_encode(x.c.log_id))) { return Err("cannot write the organization to the device"); }
    _ = filesystem.write_all(dir + "/org.gov", "1");
    _ = filesystem.write_all(dir + "/org.version", "1");
    _ = audit(dir, x, id, "policy", hex_encode(id), "founded");
    println(hex_encode(id) + " " + hex_encode(x.c.log_id));
    return Ok(0);
}

// `org join DIR ORG-ID FOUNDER`: the founder's log id binds the org id
// (SPEC 29.1), so a server cannot hand the device another organization.
@requires(filesystem, network, device, declassify, clock, provision, environment)
pub Int org_join(Str dir, Str id, Str founder, Str code) { return done(join(dir, id, founder, code)); }

@requires(filesystem, network, device, declassify, clock, provision, environment)
Result(Int, Str) join(Str dir, Str id, Str founder, Str code) {
    if (str_len(code) > 0 && !share_id_ok(code)) { return Err("an invite code is 32 hex digits"); }
    if (!share_id_ok(id) || !log_hex_ok(founder)) { return Err("an organization id (32 hex digits) and its founder's log id (64)"); }
    Ctx x0 = unlocked(dir)?;
    Option(OrgRef) old = org_ref(dir);
    if (match old { Some(r) => !bytes_eq(r.id, cose_hex_decode(id)), None => false }) { return Err("this device is already in another organization"); }
    Ctx x = signed_in_ctx(dir, x0)?;
    Str before = filesystem.read_all(dir + "/org");
    if (!filesystem.write_all(dir + "/org", id + " " + founder)) { return Err("cannot write the organization to the device"); }
    OrgRef ref = OrgRef {.id = cose_hex_decode(id), .founder = cose_hex_decode(founder)};
    Result(OrgGov, Str) rg = gov_chain(dir, x.c, x.vh, ref);
    return match rg {
        Err(m) => forget_org(dir, before, m),
        Ok(g) => answered(dir, x, g, code)
    };
}

// The governance verified: the invite answered, when there is a code; a
// member already, or waiting for an administrator's device to add them
// (org sync), until when the relay does not show them the membership.
@requires(filesystem, network, device, declassify, clock, provision, environment)
Result(Int, Str) answered(Str dir, Ctx x, OrgGov g, Str code) {
    if (str_len(x.pin) < g.policy.min_pin_len) { return Err(f"the organization asks for a PIN of at least {g.policy.min_pin_len} characters: change it first (device pin)"); }
    Int sent = if (str_len(code) == 0) { 0 } else { send_accept(x, g.org_id, code)? };
    Result(OrgState, Str) rs = org_at(dir, x.c, x.vh);
    return match rs {
        Ok(st) => joined(dir, x, st),
        Err(m) => pending(g, m)
    };
}

Result(Int, Str) pending(OrgGov g, Str m) {
    eprintln("not a member yet: " + m);
    println(hex_encode(g.org_id) + " " + hex_encode(utf8(g.name)) + " pending");
    return Ok(0);
}

// An invite code's key (SPEC 29.3).
pub List(Int) code_key(Str code) { return sha256_bytes(utf8("symbolon v1 invite key").concat(cose_hex_decode(code))); }

@requires(network, device, declassify, clock, environment)
Result(Int, Str) send_accept(Ctx x, List(Int) org, Str code) {
    List(Int) pub_key = ec_public_key(P256, code_key(code));
    List(Int) iid = invite_id_of(pub_key);
    List(Int) csig = ecdsag_sign_raw(P256, Sha256, secret_bytes(code_key(code)), code_message(org, x.c.log_id));
    OrgAccept a0 = OrgAccept {.org_id = org, .id = iid, .log_id = x.c.log_id, .code_sig = csig, .log_sequence = x.vh.head.sequence, .signer = x.c.party, .sig = []};
    List(Int) sig = dk_sign(x.c, x.u.real, x.u.st, accept_tbs(a0))?;
    if (!blob_put(x.ep, accept_blob(org, iid), cbor_or_empty(to_cbor(accept_signed(a0, sig))))) { return Err("the server refused the answer to the invite (used already?)"); }
    return Ok(0);
}

// `org invite DIR EXT-ID NAME [GROUP,...]`: an invite for one person of the
// company directory, good for 14 days; prints "CODE ID". The person's
// device answers it with `org join ... CODE`; an administrator's `org
// sync` then adds them with this directory id and these groups.
@requires(filesystem, network, device, declassify, clock, provision, environment)
pub Int org_invite(Str dir, Str ext, Str label, Str groups_arg) { return done(invite(dir, ext, label, groups_arg)); }

pub Int invite_secs() { return 1209600; }

@requires(filesystem, network, device, declassify, clock, provision, environment)
Result(Int, Str) invite(Str dir, Str ext, Str label, Str groups_arg) {
    if (!label_ok(label) || str_len(ext) == 0 || str_len(ext) > 256) { return Err("a directory id of 1-256 characters and a name of 1-64"); }
    OrgCtx o = org_unlocked(dir)?;
    Int ok = admin_only(o)?;
    Str made = make_invite(dir, o, ext, label, if (str_len(groups_arg) == 0) { [] } else { group_ids(o.st.org.groups, str_split(groups_arg, ","), 0, ListBuf())? })?;
    println(made);
    return Ok(0);
}

// A new invite stored at the relay; "CODE ID".
@requires(filesystem, network, device, declassify, clock, environment)
pub Result(Str, Str) make_invite(Str dir, OrgCtx o, Str ext, Str label, List(List(Int)) gs) {
    Str code = hex_encode(random_bytes(16));
    List(Int) pub_key = ec_public_key(P256, code_key(code));
    List(Int) iid = invite_id_of(pub_key);
    Int now = witness_now(o.x.vh.head.policy.witnesses, o.x.c.ca, random_bytes(32));
    if (now == 0) { return Err("the witnesses did not answer for the time"); }
    OrgInvite v0 = OrgInvite {.org_id = o.st.org.org_id, .id = iid, .public_key = pub_key, .ext_id = ext, .label = label, .groups = gs, .expires = now + invite_secs(),
                              .log_sequence = o.x.vh.head.sequence, .signer_log = o.x.c.log_id, .signer = o.x.c.party, .sig = []};
    List(Int) sig = dk_sign(o.x.c, o.x.u.real, o.x.u.st, invite_tbs(v0))?;
    Int put = put_blob(o.x, invite_blob(v0.org_id, iid), cbor_or_empty(to_cbor(invite_signed(v0, sig))), "invite")?;
    _ = audit(dir, o.x, v0.org_id, "member", hex_encode(iid), "invite " + ext);
    return Ok(code + " " + hex_encode(iid));
}

@requires(filesystem)
Result(Int, Str) forget_org(Str dir, Str before, Str m) { _ = filesystem.write_all(dir + "/org", before); return Err(m); }

@requires(filesystem, network, device, declassify, clock, environment)
Result(Int, Str) joined(Str dir, Ctx x, OrgState st) {
    Bool member = member_index(st.org.members, x.c.log_id, 0) >= 0;
    _ = audit(dir, x, st.org.org_id, "member", hex_encode(x.c.log_id), "joined");
    println(hex_encode(st.org.org_id) + " " + hex_encode(utf8(st.gov.name)) + (if (member) { " member" } else { " pending" }));
    return Ok(0);
}

// ─── Reading ────────────────────────────────────────────────────

// Reading needs the verified log, not the PIN.
@requires(filesystem, network, clock(readonly), declassify)
pub Result(OrgCtx, Str) org_view(Str dir) {
    DeviceConfig c = set_up(dir)?;
    Result(VerifiedHead, SymbolonError) rv = verified_log(relay_ep(c), c.log_id);
    VerifiedHead vh = match rv { Err(e) => Err(err_text(e)), Ok(h) => Ok(h) }?;
    OrgState st = org_at(dir, c, vh)?;
    List(Secret(UInt(8))) none = [];
    Unlocked u = Unlocked {.kind = 0, .real = RealProfile {.share = none, .cc = none, .vault_key = none, .dek = none, .duress_hpke_pub = []},
                           .duress = DuressFull {.share = none, .subkey = none, .vault_key = none, .hpke_priv = none, .tweaks = []}, .st = none};
    return Ok(OrgCtx {.x = Ctx {.c = c, .u = u, .vh = vh, .pin = "", .ep = relay_at(dir, c)}, .st = st});
}

pub Str role_of(OrgGov g, List(Int) l) { return if (is_owner(g, l)) { "owner" } else { if (is_admin(g, l)) { "admin" } else { "member" } }; }

pub Str yes(Bool b) { return if (b) { "yes" } else { "no" }; }

@requires(filesystem, network, clock(readonly), declassify)
pub Int org_show(Str dir) { return done(show(dir)); }

@requires(filesystem, network, clock(readonly), declassify)
Result(Int, Str) show(Str dir) {
    OrgCtx o = org_view(dir)?;
    OrgGov g = o.st.gov;
    OrgPolicy p = g.policy;
    Bool member = member_index(o.st.org.members, o.x.c.log_id, 0) >= 0;
    println("org " + hex_encode(g.org_id) + " " + hex_encode(utf8(g.name)));
    println(f"version {o.st.org.version} gov {g.version}");
    println("role " + (if (member) { role_of(g, o.x.c.log_id) } else { "pending" }));
    println(f"policy min_pin_len={p.min_pin_len} allow_biometric={yes(p.allow_biometric)} allow_duress={yes(p.allow_duress)} allow_offline_copy={yes(p.allow_offline_copy)} max_offline_days={p.max_offline_days} allow_personal_export={yes(p.allow_personal_export)}");
    println(if (g.recovery.on) { f"recovery on {g.recovery.threshold}/{g.recovery.admins.len()} delay {g.recovery.delay_sec}" } else { "recovery off" });
    return Ok(notices(o, blob_list(o.x.ep, "recreq-" + hex_encode(g.org_id) + "-"), 0));
}

// The person is told (SPEC 29.8): "recovery-request CID REQUESTER OPENS-AT"
// for each request to open one of their work folders.
@requires(network, clock(readonly), declassify)
Int notices(OrgCtx o, List(Str) names, Int i) {
    if (i >= names.len()) { return 0; }
    Option(OrgRecoveryRequest) oq = recreq_of(blob_get(o.x.ep, names[i]) else { [] });
    _ = match oq {
        None => 0,
        Some(q) => match escrow_of(blob_get(o.x.ep, escrow_blob(q.org_id, hex_encode(q.coll_id))) else { [] }) {
            None => 0,
            Some(e) => if (bytes_eq(e.owner, o.x.c.log_id)) { notice(q, o.st.gov.recovery.delay_sec) } else { 0 }
        }
    };
    return notices(o, names, i + 1);
}

Int notice(OrgRecoveryRequest q, Int delay) { println("recovery-request " + hex_encode(q.coll_id) + " " + hex_encode(q.requester) + f" {q.time + delay}"); return 0; }

@requires(filesystem, network, clock(readonly), declassify)
pub Int org_members(Str dir) { return done(members(dir)); }

@requires(filesystem, network, clock(readonly), declassify)
Result(Int, Str) members(Str dir) {
    OrgCtx o = org_view(dir)?;
    return Ok(print_members(o.st, 0));
}

Int print_members(OrgState st, Int i) {
    if (i >= st.org.members.len()) { return 0; }
    OrgMember m = st.org.members[i];
    Str gs = groups_of(st.org.groups, m.log_id, 0, StrBuf(), true);
    println(hex_encode(m.log_id) + " " + hex_or_dash(m.label) + " " + hex_or_dash(m.ext_id) + " " + role_of(st.gov, m.log_id) + " " + (if (str_len(gs) == 0) { "-" } else { gs }));
    return print_members(st, i + 1);
}

Str hex_or_dash(Str s) { return if (str_len(s) == 0) { "-" } else { hex_encode(utf8(s)) }; }

Str groups_of(List(OrgGroup) gs, List(Int) l, Int i, StrBuf acc, Bool first) {
    if (i >= gs.len()) { return acc.finish(); }
    Bool inside = has_log(gs[i].members, l);
    return groups_of(gs, l, i + 1, if (inside) { acc.push(if (first) { "" } else { "," }).push(hex_encode(gs[i].group_id)) } else { acc }, first && !inside);
}

@requires(filesystem, network, clock(readonly), declassify)
pub Int org_groups(Str dir) { return done(groups(dir)); }

@requires(filesystem, network, clock(readonly), declassify)
Result(Int, Str) groups(Str dir) {
    OrgCtx o = org_view(dir)?;
    return Ok(print_groups(o.st.org.groups, 0));
}

Int print_groups(List(OrgGroup) gs, Int i) {
    if (i >= gs.len()) { return 0; }
    println(hex_encode(gs[i].group_id) + " " + hex_encode(utf8(gs[i].name)) + f" {gs[i].members.len()}");
    return print_groups(gs, i + 1);
}

// ─── People ─────────────────────────────────────────────────────

@requires(filesystem, network, device, declassify, clock, provision, environment)
pub Int org_add(Str dir, Str who, Str label, Str ext) { return done(add(dir, who, label, ext)); }

@requires(filesystem, network, device, declassify, clock, provision, environment)
Result(Int, Str) add(Str dir, Str who, Str label, Str ext) {
    if (!log_hex_ok(who)) { return Err("a person is named by their log id, 64 hex digits"); }
    if (!label_ok(label) || str_len(ext) > 256) { return Err("a name of 1-64 characters and a directory id of at most 256"); }
    OrgCtx o = org_unlocked(dir)?;
    Int ok = admin_only(o)?;
    List(Int) l = cose_hex_decode(who);
    if (member_index(o.st.org.members, l, 0) >= 0) { return Err("already in the organization"); }
    VerifiedHead known = head_of(o.x.c, o.x.vh, l)?;
    return store_org(dir, o.x, o.st, o.st.gov.version, o.st.org.members.concat([OrgMember {.log_id = l, .label = label, .ext_id = ext}]), o.st.org.groups, "member", "add " + who);
}

@requires(filesystem, network, device, declassify, clock, provision, environment)
pub Int org_remove(Str dir, Str who) { return done(remove(dir, who)); }

@requires(filesystem, network, device, declassify, clock, provision, environment)
Result(Int, Str) remove(Str dir, Str who) {
    OrgCtx o = org_unlocked(dir)?;
    return remove_in(dir, o, who);
}

@requires(filesystem, network, device, declassify, clock, provision, environment)
Result(Int, Str) remove_in(Str dir, OrgCtx o, Str who) {
    if (!log_hex_ok(who)) { return Err("a person is named by their log id, 64 hex digits"); }
    Int ok = admin_only(o)?;
    List(Int) l = cose_hex_decode(who);
    if (member_index(o.st.org.members, l, 0) < 0) { return Err("not in the organization"); }
    if (is_admin(o.st.gov, l)) { return Err("an owner or administrator: an owner makes them a member first (org role)"); }
    Int stored = store_org(dir, o.x, o.st, o.st.gov.version, without_member(o.st.org.members, l, 0, ListBuf()), without_in_groups(o.st.org.groups, l, 0, ListBuf()), "member", "remove " + who)?;
    eprintln("the group folders they were in get a new key at the next org sync");
    return Ok(stored);
}

List(OrgMember) without_member(List(OrgMember) ms, List(Int) l, Int i, ListBuf(OrgMember) acc) {
    if (i >= ms.len()) { return acc.finish(); }
    return without_member(ms, l, i + 1, if (bytes_eq(ms[i].log_id, l)) { acc } else { acc.push(ms[i]) });
}

List(List(Int)) without_log(List(List(Int)) ls, List(Int) l, Int i, ListBuf(List(Int)) acc) {
    if (i >= ls.len()) { return acc.finish(); }
    return without_log(ls, l, i + 1, if (bytes_eq(ls[i], l)) { acc } else { acc.push(ls[i]) });
}

List(OrgGroup) without_in_groups(List(OrgGroup) gs, List(Int) l, Int i, ListBuf(OrgGroup) acc) {
    if (i >= gs.len()) { return acc.finish(); }
    return without_in_groups(gs, l, i + 1, acc.push(OrgGroup {.group_id = gs[i].group_id, .name = gs[i].name, .members = without_log(gs[i].members, l, 0, ListBuf())}));
}

List(OrgAdmin) without_admin(List(OrgAdmin) xs, List(Int) l, Int i, ListBuf(OrgAdmin) acc) {
    if (i >= xs.len()) { return acc.finish(); }
    return without_admin(xs, l, i + 1, if (bytes_eq(xs[i].log_id, l)) { acc } else { acc.push(xs[i]) });
}

// `org role DIR LOG owner|admin|member`: an owner only.
@requires(filesystem, network, device, declassify, clock, provision, environment)
pub Int org_role(Str dir, Str who, Str role) { return done(set_role(dir, who, role)); }

@requires(filesystem, network, device, declassify, clock, provision, environment)
Result(Int, Str) set_role(Str dir, Str who, Str role) {
    if (!log_hex_ok(who)) { return Err("a person is named by their log id, 64 hex digits"); }
    if (role != "owner" && role != "admin" && role != "member") { return Err("owner, admin or member"); }
    OrgCtx o = org_unlocked(dir)?;
    List(Int) l = cose_hex_decode(who);
    Int mi = member_index(o.st.org.members, l, 0);
    if (mi < 0) { return Err("not in the organization: add them first"); }
    List(List(Int)) owners = without_log(o.st.gov.owners, l, 0, ListBuf());
    List(OrgAdmin) admins = without_admin(o.st.gov.admins, l, 0, ListBuf());
    return store_gov(dir, o.x, o.st, if (role == "owner") { owners.concat([l]) } else { owners },
                     if (role == "admin") { admins.concat([OrgAdmin {.log_id = l, .label = o.st.org.members[mi].label}]) } else { admins },
                     o.st.gov.policy, "member", "role " + who + " " + role);
}

// `org policy DIR KEY VALUE`: an owner only.
@requires(filesystem, network, device, declassify, clock, provision, environment)
pub Int org_policy(Str dir, Str key, Str value) { return done(set_policy(dir, key, value)); }

@requires(filesystem, network, device, declassify, clock, provision, environment)
Result(Int, Str) set_policy(Str dir, Str key, Str value) {
    OrgCtx o = org_unlocked(dir)?;
    return set_policy_in(dir, o, key, value);
}

@requires(filesystem, network, device, declassify, clock, provision, environment)
Result(Int, Str) set_policy_in(Str dir, OrgCtx o, Str key, Str value) {
    OrgPolicy p = changed_policy(o.st.gov.policy, key, value)?;
    // Requiring attestation from a device that is not attested would shut its owner out.
    if (key == "require_attestation" && value != "none" && !has_log(o.st.org.attested, o.x.c.party)) { return Err("attest this device first (org attest), or the policy shuts it out"); }
    return store_gov(dir, o.x, o.st, o.st.gov.owners, o.st.gov.admins, p, "policy", key + "=" + value);
}

Result(Bool, Str) flag(Str v) { return if (v == "yes") { Ok(true) } else { if (v == "no") { Ok(false) } else { Err("yes or no") } }; }

Result(Int, Str) count(Str v, Int lo, Int hi) {
    Int n = str_parse_int(v);
    if (f"{n}" != v || n < lo || n > hi) { return Err(f"a number from {lo} to {hi}"); }
    return Ok(n);
}

Result(OrgPolicy, Str) changed_policy(OrgPolicy p, Str k, Str v) {
    if (k == "min_pin_len") { Int n = count(v, 4, 32)?; return Ok(OrgPolicy {.min_pin_len = n, .allow_biometric = p.allow_biometric, .allow_duress = p.allow_duress, .allow_offline_copy = p.allow_offline_copy, .max_offline_days = p.max_offline_days, .allow_personal_export = p.allow_personal_export, .require_attestation = p.require_attestation, .password_rules = p.password_rules}); }
    if (k == "allow_biometric") { Bool b = flag(v)?; return Ok(OrgPolicy {.min_pin_len = p.min_pin_len, .allow_biometric = b, .allow_duress = p.allow_duress, .allow_offline_copy = p.allow_offline_copy, .max_offline_days = p.max_offline_days, .allow_personal_export = p.allow_personal_export, .require_attestation = p.require_attestation, .password_rules = p.password_rules}); }
    if (k == "allow_duress") { Bool b = flag(v)?; return Ok(OrgPolicy {.min_pin_len = p.min_pin_len, .allow_biometric = p.allow_biometric, .allow_duress = b, .allow_offline_copy = p.allow_offline_copy, .max_offline_days = p.max_offline_days, .allow_personal_export = p.allow_personal_export, .require_attestation = p.require_attestation, .password_rules = p.password_rules}); }
    if (k == "allow_offline_copy") { Bool b = flag(v)?; return Ok(OrgPolicy {.min_pin_len = p.min_pin_len, .allow_biometric = p.allow_biometric, .allow_duress = p.allow_duress, .allow_offline_copy = b, .max_offline_days = p.max_offline_days, .allow_personal_export = p.allow_personal_export, .require_attestation = p.require_attestation, .password_rules = p.password_rules}); }
    if (k == "max_offline_days") { Int n = count(v, 0, 3650)?; return Ok(OrgPolicy {.min_pin_len = p.min_pin_len, .allow_biometric = p.allow_biometric, .allow_duress = p.allow_duress, .allow_offline_copy = p.allow_offline_copy, .max_offline_days = n, .allow_personal_export = p.allow_personal_export, .require_attestation = p.require_attestation, .password_rules = p.password_rules}); }
    if (k == "allow_personal_export") { Bool b = flag(v)?; return Ok(OrgPolicy {.min_pin_len = p.min_pin_len, .allow_biometric = p.allow_biometric, .allow_duress = p.allow_duress, .allow_offline_copy = p.allow_offline_copy, .max_offline_days = p.max_offline_days, .allow_personal_export = b, .require_attestation = p.require_attestation, .password_rules = p.password_rules}); }
    if (k == "require_attestation" && v != "tpm" && v != "none") { return Err("require_attestation: tpm or none"); }
    if (k == "require_attestation") { return Ok(OrgPolicy {.min_pin_len = p.min_pin_len, .allow_biometric = p.allow_biometric, .allow_duress = p.allow_duress, .allow_offline_copy = p.allow_offline_copy, .max_offline_days = p.max_offline_days, .allow_personal_export = p.allow_personal_export, .require_attestation = if (v == "none") { [] } else { [v] }, .password_rules = p.password_rules}); }
    if (k == "password_rules" && str_len(v) > 0 && v != "none" && !rules_ok(v)) { return Err("password_rules: a comma list of min=N, upper, lower, digit, symbol (or none)"); }
    if (k == "password_rules") { return Ok(OrgPolicy {.min_pin_len = p.min_pin_len, .allow_biometric = p.allow_biometric, .allow_duress = p.allow_duress, .allow_offline_copy = p.allow_offline_copy, .max_offline_days = p.max_offline_days, .allow_personal_export = p.allow_personal_export, .require_attestation = p.require_attestation, .password_rules = if (v == "none") { "" } else { v }}); }
    return Err("policy keys: min_pin_len, allow_biometric, allow_duress, allow_offline_copy, max_offline_days, allow_personal_export, password_rules");
}

// ─── Groups ─────────────────────────────────────────────────────

@requires(filesystem, network, device, declassify, clock, provision, environment)
pub Int org_group_new(Str dir, Str name) { return done(group_new(dir, name)); }

@requires(filesystem, network, device, declassify, clock, provision, environment)
Result(Int, Str) group_new(Str dir, Str name) {
    if (!label_ok(name)) { return Err("a name of 1-64 characters"); }
    OrgCtx o = org_unlocked(dir)?;
    Int ok = admin_only(o)?;
    List(Int) gid = random_bytes(16);
    Int stored = store_org(dir, o.x, o.st, o.st.gov.version, o.st.org.members, o.st.org.groups.concat([OrgGroup {.group_id = gid, .name = name, .members = []}]), "group", "new " + hex_encode(gid))?;
    println(hex_encode(gid));
    return Ok(stored);
}

// `org group add|remove DIR GROUP LOG`.
@requires(filesystem, network, device, declassify, clock, provision, environment)
pub Int org_group_set(Str dir, Str gid, Str who, Bool add_it) { return done(group_set(dir, gid, who, add_it)); }

@requires(filesystem, network, device, declassify, clock, provision, environment)
Result(Int, Str) group_set(Str dir, Str gid, Str who, Bool add_it) {
    OrgCtx o = org_unlocked(dir)?;
    return group_set_in(dir, o, gid, who, add_it);
}

@requires(filesystem, network, device, declassify, clock, provision, environment)
Result(Int, Str) group_set_in(Str dir, OrgCtx o, Str gid, Str who, Bool add_it) {
    if (!share_id_ok(gid) || !log_hex_ok(who)) { return Err("a group id (32 hex digits) and a log id (64)"); }
    Int ok = admin_only(o)?;
    List(Int) g = cose_hex_decode(gid);
    List(Int) l = cose_hex_decode(who);
    Int gi = group_index(o.st.org.groups, g, 0);
    if (gi < 0) { return Err("no such group"); }
    if (member_index(o.st.org.members, l, 0) < 0) { return Err("not in the organization: add them first"); }
    Bool inside = has_log(o.st.org.groups[gi].members, l);
    if (add_it && inside) { return Err("already in the group"); }
    if (!add_it && !inside) { return Err("not in the group"); }
    OrgGroup old = o.st.org.groups[gi];
    OrgGroup nw = OrgGroup {.group_id = old.group_id, .name = old.name, .members = if (add_it) { old.members.concat([l]) } else { without_log(old.members, l, 0, ListBuf()) }};
    return store_org(dir, o.x, o.st, o.st.gov.version, o.st.org.members, replace_group(o.st.org.groups, nw, 0, ListBuf()), "group", (if (add_it) { "add " } else { "remove " }) + gid + " " + who);
}

List(OrgGroup) replace_group(List(OrgGroup) gs, OrgGroup g, Int i, ListBuf(OrgGroup) acc) {
    if (i >= gs.len()) { return acc.finish(); }
    return replace_group(gs, g, i + 1, acc.push(if (bytes_eq(gs[i].group_id, g.group_id)) { g } else { gs[i] }));
}

// ─── Group folders ──────────────────────────────────────────────

@requires(device, declassify, network, environment)
Result(GroupFolder, Str) sign_gfolder(Ctx x, List(Int) id, UInt(64) version, List(Int) org_id, List(List(Int)) gs, List(Secret(UInt(8))) key, Str name, Bool deleted) {
    GroupFolder f = GroupFolder {.coll_id = id, .version = version, .org_id = org_id, .groups = gs, .name_ct = sealed_name(key, id, version, name), .deleted = deleted,
                                 .log_sequence = x.vh.head.sequence, .signer_log = x.c.log_id, .signer = x.c.party, .sig = []};
    List(Int) sig = dk_sign(x.c, x.u.real, x.u.st, gfolder_tbs(f))?;
    return Ok(gfolder_signed(f, sig));
}

List(List(Int)) people_logs(List(Member) ms, Int i, ListBuf(List(Int)) acc) {
    if (i >= ms.len()) { return acc.finish(); }
    return people_logs(ms, i + 1, acc.push(ms[i].log_id));
}

// `org folder new DIR NAME GROUP[,GROUP...]`.
@requires(filesystem, network, device, declassify, clock, provision, environment)
pub Int org_folder_new(Str dir, Str name, Str groups_arg) { return done(folder_new(dir, name, groups_arg)); }

@requires(filesystem, network, device, declassify, clock, provision, environment)
Result(Int, Str) folder_new(Str dir, Str name, Str groups_arg) {
    if (!label_ok(name)) { return Err("a name of 1-64 characters"); }
    OrgCtx o = org_unlocked(dir)?;
    Int ok = admin_only(o)?;
    List(List(Int)) gs = group_ids(o.st.org.groups, str_split(groups_arg, ","), 0, ListBuf())?;
    List(Int) id = random_bytes(16);
    List(Secret(UInt(8))) key = random_secret(32);
    GroupFolder f = sign_gfolder(o.x, id, (UInt(64))1, o.st.org.org_id, gs, key, name, false)?;
    Str m = put_wraps(o.x, id, f.version, key, people_logs(folder_people(o.st, gs), 0, ListBuf()), 0);
    if (str_len(m) > 0) { return Err(m); }
    Str cid = hex_encode(id);
    Int put = put_blob(o.x, gfolder_blob(cid), cbor_or_empty(to_cbor(f)), "group folder")?;
    _ = filesystem.write_all(place_local(dir, cid) + ".roster", "1");
    _ = audit(dir, o.x, o.st.org.org_id, "share", cid, "group folder for " + groups_arg);
    println(cid);
    return Ok(0);
}

Result(List(List(Int)), Str) group_ids(List(OrgGroup) gs, List(Str) ids, Int i, ListBuf(List(Int)) acc) {
    if (i >= ids.len()) { List(List(Int)) done_ids = acc.finish(); return if (done_ids.len() == 0) { Err("at least one group") } else { Ok(done_ids) }; }
    if (!share_id_ok(ids[i]) || group_index(gs, cose_hex_decode(ids[i]), 0) < 0) { acc.discard(); return Err("no such group " + ids[i]); }
    return group_ids(gs, ids, i + 1, acc.push(cose_hex_decode(ids[i])));
}

// `org sync DIR`: per group folder, "ID ok" when everyone holding its key
// is still one of its people (adding wraps for new people), "ID rekeyed N"
// after giving it a new key because N people left, "ID - WHY-HEX" when it
// cannot.
@requires(filesystem, network, device, declassify, clock, provision, environment)
pub Int org_sync(Str dir) { return done(sync(dir)); }

@requires(filesystem, network, device, declassify, clock, provision, environment)
Result(Int, Str) sync(Str dir) {
    OrgCtx o0 = org_unlocked(dir)?;
    return sync_in(dir, o0);
}

@requires(filesystem, network, device, declassify, clock, provision, environment)
Result(Int, Str) sync_in(Str dir, OrgCtx o0) {
    Int ok = admin_only(o0)?;
    OrgCtx o1 = admit(dir, o0)?;
    OrgCtx o2 = directory_sync(dir, o1)?;
    OrgCtx o = attest_sync(dir, o2)?;
    List(Str) wraps = blob_list(o.x.ep, "wrap-");
    return Ok(sync_all(dir, o, wraps, ids_of(blob_list(o.x.ep, "gfolder-"), 0, ListBuf()), 0));
}

// ─── Answered invites (SPEC 29.3) ───────────────────────────────

type Admit = { OrgMember m; List(List(Int)) gids; Str inv; Str acc; };

// Everyone who answered a valid invite, added in one new membership
// record with the invite's directory id, name and groups; "joined LOG
// EXT-HEX" for each. The invite and the answer are then cleared.
@requires(filesystem, network, device, declassify, clock, environment)
Result(OrgCtx, Str) admit(Str dir, OrgCtx o) {
    List(Str) names = blob_list(o.x.ep, "accept-" + hex_encode(o.st.org.org_id) + "-");
    if (names.len() == 0) { return Ok(o); }
    Int now = witness_now(o.x.vh.head.policy.witnesses, o.x.c.ca, random_bytes(32));
    List(Admit) ads = admits(o, names, now, 0, [], ListBuf());
    if (ads.len() == 0) { return Ok(o); }
    Int stored = store_org(dir, o.x, o.st, o.st.gov.version, o.st.org.members.concat(admit_members(ads, 0, ListBuf())), with_admits(o.st.org.groups, ads, 0, ListBuf()),
                           "member", f"{ads.len()} joined by invite")?;
    _ = clear_admits(o.x, ads, 0);
    OrgState st = org_at(dir, o.x.c, o.x.vh)?;
    return Ok(OrgCtx {.x = o.x, .st = st});
}

@requires(network, clock(readonly), declassify)
List(Admit) admits(OrgCtx o, List(Str) names, Int now, Int i, List(List(Int)) seen, ListBuf(Admit) acc) {
    if (i >= names.len()) { return acc.finish(); }
    Option(Admit) oa = admit_one(o, names[i], now);
    return match oa {
        None => admits(o, names, now, i + 1, seen, acc),
        Some(a) => if (has_log(seen, a.m.log_id) || member_index(o.st.org.members, a.m.log_id, 0) >= 0) { admits(o, names, now, i + 1, seen, acc) }
                   else { admits(o, names, now, i + 1, seen.concat([a.m.log_id]), acc.push(a)) }
    };
}

Option(T) ok_of(Result(T, Str) r) { return match r { Ok(v) => Some(v), Err(_) => None }; }

// An answer that verifies: for this organization, to an unexpired invite
// an owner or administrator signed, the code's key over the person's log
// id, and a device of that log over the answer.
@requires(network, clock(readonly), declassify)
Option(Admit) admit_one(OrgCtx o, Str name, Int now) {
    OrgAccept a = accept_of(blob_get(o.x.ep, name) else { [] })?;
    if (name != accept_blob(o.st.org.org_id, a.id) || !bytes_eq(a.org_id, o.st.org.org_id)) { return None; }
    OrgInvite v = invite_of(blob_get(o.x.ep, invite_blob(a.org_id, a.id)) else { [] })?;
    if (!bytes_eq(v.org_id, a.org_id) || !bytes_eq(v.id, a.id) || !bytes_eq(invite_id_of(v.public_key), v.id) || v.expires < now || !is_admin(o.st.gov, v.signer_log)) { return None; }
    if (!ecdsa_verify_raw(P256, Sha256, v.public_key, code_message(a.org_id, a.log_id), a.code_sig)) { return None; }
    VerifiedHead hv = ok_of(head_of(o.x.c, o.x.vh, v.signer_log))?;
    if (!signed_by(hv, v.log_sequence, v.signer, invite_tbs(v), v.sig)) { return None; }
    VerifiedHead ha = ok_of(head_of(o.x.c, o.x.vh, a.log_id))?;
    if (!signed_by(ha, a.log_sequence, a.signer, accept_tbs(a), a.sig)) { return None; }
    return Some(Admit {.m = OrgMember {.log_id = a.log_id, .label = v.label, .ext_id = v.ext_id}, .gids = v.groups, .inv = invite_blob(a.org_id, a.id), .acc = name});
}

List(OrgMember) admit_members(List(Admit) ads, Int i, ListBuf(OrgMember) acc) {
    if (i >= ads.len()) { return acc.finish(); }
    println("joined " + hex_encode(ads[i].m.log_id) + " " + hex_encode(utf8(ads[i].m.ext_id)));
    return admit_members(ads, i + 1, acc.push(ads[i].m));
}

List(OrgGroup) with_admits(List(OrgGroup) gs, List(Admit) ads, Int i, ListBuf(OrgGroup) acc) {
    if (i >= gs.len()) { return acc.finish(); }
    OrgGroup g = gs[i];
    return with_admits(gs, ads, i + 1, acc.push(OrgGroup {.group_id = g.group_id, .name = g.name, .members = g.members.concat(admits_in(ads, g.group_id, 0, ListBuf()))}));
}

List(List(Int)) admits_in(List(Admit) ads, List(Int) gid, Int i, ListBuf(List(Int)) acc) {
    if (i >= ads.len()) { return acc.finish(); }
    return admits_in(ads, gid, i + 1, if (has_log(ads[i].gids, gid)) { acc.push(ads[i].m.log_id) } else { acc });
}

@requires(network, clock(readonly), declassify)
Bool clear_admits(Ctx x, List(Admit) ads, Int i) {
    if (i >= ads.len()) { return true; }
    _ = blob_put(x.ep, ads[i].inv, []);
    _ = blob_put(x.ep, ads[i].acc, []);
    return clear_admits(x, ads, i + 1);
}

// ─── The company directory (SPEC 29.7) ──────────────────────────
// What the relay's SCIM service holds, applied by this device's
// signature: members with a directory id the directory no longer has (or
// turned off) are taken out, the directory's groups are set by name, and
// the directory's people who are not members get an invite, once.
// Members added by hand (no directory id) and owners are left alone; an
// administrator must lose the role first. Prints "removed LOG EXT-HEX",
// "kept LOG EXT-HEX administrator", "group NAME-HEX N", "invite
// USERNAME-HEX CODE ID".

@requires(filesystem, network, device, declassify, clock, environment)
Result(OrgCtx, Str) directory_sync(Str dir, OrgCtx o) {
    HttpOut r = http_call_ep(o.x.ep, "GET", "/directory/" + hex_encode(o.st.org.org_id), []);
    if (r.status == 404) { return Ok(o); }
    if (r.status != 200) { return Err(f"the relay did not give the directory ({r.status})"); }
    List(Str) lines = str_split(http_text(r.body, 0, r.body.len()), "\n");
    List(DirUser) us = dir_users(lines, 0, ListBuf());
    List(DirGroup) dgs = dir_groups(lines, 0, ListBuf());
    List(OrgMember) kept = still_listed(o.st, us, 0, ListBuf());
    List(OrgGroup) gs0 = drop_gone(o.st.org.groups, kept, 0, ListBuf());
    List(OrgGroup) gs = set_groups(gs0, dgs, us, kept, 0);
    Bool changed = kept.len() != o.st.org.members.len() || !same_groups(o.st.org.groups, gs, 0);
    OrgCtx o2 = if (changed) { stored_again(dir, o, kept, gs)? } else { o };
    List(Str) pending = invited(o2, blob_list(o2.x.ep, "invite-" + hex_encode(o2.st.org.org_id) + "-"), 0, ListBuf());
    Int made = invite_new(dir, o2, us, dgs, pending, 0)?;
    return Ok(o2);
}

@requires(filesystem, network, device, declassify, clock, environment)
Result(OrgCtx, Str) stored_again(Str dir, OrgCtx o, List(OrgMember) ms, List(OrgGroup) gs) {
    Int stored = store_org(dir, o.x, o.st, o.st.gov.version, ms, gs, "member", "directory")?;
    OrgState st = org_at(dir, o.x.c, o.x.vh)?;
    return Ok(OrgCtx {.x = o.x, .st = st});
}

Str unhx(Str s) { List(Int) b = if (s == "-") { [] } else { cose_hex_decode(s) }; return http_text(b, 0, b.len()); }

List(DirUser) dir_users(List(Str) lines, Int i, ListBuf(DirUser) acc) {
    if (i >= lines.len()) { return acc.finish(); }
    List(Str) p = str_split(lines[i], " ");
    Bool ok = p.len() == 4 && p[0] == "U";
    return dir_users(lines, i + 1, if (ok) { acc.push(DirUser {.id = "", .user_name = unhx(p[1]), .external_id = unhx(p[2]), .display = unhx(p[3]), .active = true}) } else { acc });
}

List(DirGroup) dir_groups(List(Str) lines, Int i, ListBuf(DirGroup) acc) {
    if (i >= lines.len()) { return acc.finish(); }
    List(Str) p = str_split(lines[i], " ");
    Bool ok = p.len() == 3 && p[0] == "G" && p[1] != "-";
    return dir_groups(lines, i + 1, if (ok) { acc.push(DirGroup {.id = "", .display = unhx(p[1]), .members = if (p[2] == "-") { [] } else { unhx_all(str_split(p[2], ","), 0, ListBuf()) }}) } else { acc });
}

List(Str) unhx_all(List(Str) xs, Int i, ListBuf(Str) acc) { return if (i >= xs.len()) { acc.finish() } else { unhx_all(xs, i + 1, acc.push(unhx(xs[i]))) }; }

Bool listed_user(List(DirUser) us, Str ext, Int i) {
    if (i >= us.len()) { return false; }
    return names_user(ext, us[i]) || listed_user(us, ext, i + 1);
}

List(OrgMember) still_listed(OrgState st, List(DirUser) us, Int i, ListBuf(OrgMember) acc) {
    if (i >= st.org.members.len()) { return acc.finish(); }
    OrgMember m = st.org.members[i];
    Bool keep = str_len(m.ext_id) == 0 || is_owner(st.gov, m.log_id) || listed_user(us, m.ext_id, 0);
    Bool admin = !keep && is_admin(st.gov, m.log_id);
    if (!keep) { println((if (admin) { "kept " } else { "removed " }) + hex_encode(m.log_id) + " " + hex_encode(utf8(m.ext_id)) + (if (admin) { " administrator" } else { "" })); }
    return still_listed(st, us, i + 1, if (keep || admin) { acc.push(m) } else { acc });
}

List(OrgGroup) drop_gone(List(OrgGroup) gs, List(OrgMember) ms, Int i, ListBuf(OrgGroup) acc) {
    if (i >= gs.len()) { return acc.finish(); }
    return drop_gone(gs, ms, i + 1, acc.push(OrgGroup {.group_id = gs[i].group_id, .name = gs[i].name, .members = in_members(gs[i].members, ms, 0, ListBuf())}));
}

List(List(Int)) in_members(List(List(Int)) ls, List(OrgMember) ms, Int i, ListBuf(List(Int)) acc) {
    if (i >= ls.len()) { return acc.finish(); }
    return in_members(ls, ms, i + 1, if (member_index(ms, ls[i], 0) >= 0) { acc.push(ls[i]) } else { acc });
}

// Each directory group as the organization's group of that name (a new
// one when there is none), its members the members the directory puts in it.
List(OrgGroup) set_groups(List(OrgGroup) gs, List(DirGroup) dgs, List(DirUser) us, List(OrgMember) ms, Int i) {
    if (i >= dgs.len()) { return gs; }
    List(List(Int)) want = members_named(ms, dgs[i].members, us, 0, ListBuf());
    Int at = group_named(gs, dgs[i].display, 0);
    List(OrgGroup) next = if (at >= 0) { replace_group(gs, OrgGroup {.group_id = gs[at].group_id, .name = gs[at].name, .members = want}, 0, ListBuf()) }
                          else { gs.concat([OrgGroup {.group_id = sha256_bytes(utf8("symbolon v1 directory group").concat(utf8(dgs[i].display)))[0..16], .name = dgs[i].display, .members = want}]) };
    if (at < 0 || !same_logs(gs[at].members, want)) { println("group " + hex_encode(utf8(dgs[i].display)) + f" {want.len()}"); }
    return set_groups(next, dgs, us, ms, i + 1);
}

Int group_named(List(OrgGroup) gs, Str name, Int i) {
    if (i >= gs.len()) { return -1; }
    if (gs[i].name == name) { return i; }
    return group_named(gs, name, i + 1);
}


// The members whose directory id names one of these user names.
List(List(Int)) members_named(List(OrgMember) ms, List(Str) names, List(DirUser) us, Int i, ListBuf(List(Int)) acc) {
    if (i >= ms.len()) { return acc.finish(); }
    Bool inside = str_len(ms[i].ext_id) > 0 && named_in(ms[i].ext_id, names, us, 0);
    return members_named(ms, names, us, i + 1, if (inside) { acc.push(ms[i].log_id) } else { acc });
}

Bool named_in(Str ext, List(Str) names, List(DirUser) us, Int i) {
    if (i >= us.len()) { return false; }
    return (has_str(names, us[i].user_name, 0) && names_user(ext, us[i])) || named_in(ext, names, us, i + 1);
}

Bool same_logs(List(List(Int)) a, List(List(Int)) b) { return a.len() == b.len() && all_in(a, b, 0); }
Bool all_in(List(List(Int)) a, List(List(Int)) b, Int i) { return i >= a.len() || (has_log(b, a[i]) && all_in(a, b, i + 1)); }

Bool same_groups(List(OrgGroup) a, List(OrgGroup) b, Int i) {
    if (a.len() != b.len()) { return false; }
    if (i >= a.len()) { return true; }
    return bytes_eq(a[i].group_id, b[i].group_id) && same_logs(a[i].members, b[i].members) && same_groups(a, b, i + 1);
}

// The directory ids of the invites still at the relay.
@requires(network, clock(readonly), declassify)
List(Str) invited(OrgCtx o, List(Str) names, Int i, ListBuf(Str) acc) {
    if (i >= names.len()) { return acc.finish(); }
    Option(OrgInvite) v = invite_of(blob_get(o.x.ep, names[i]) else { [] });
    return invited(o, names, i + 1, match v { Some(x) => acc.push(str_to_lower(x.ext_id)), None => acc });
}

@requires(filesystem, network, device, declassify, clock, environment)
Result(Int, Str) invite_new(Str dir, OrgCtx o, List(DirUser) us, List(DirGroup) dgs, List(Str) pending, Int i) {
    if (i >= us.len()) { return Ok(0); }
    DirUser u = us[i];
    Bool member = members_named(o.st.org.members, [u.user_name], [u], 0, ListBuf()).len() > 0;
    if (member || has_str(pending, str_to_lower(u.user_name), 0)) { return invite_new(dir, o, us, dgs, pending, i + 1); }
    Str made = make_invite(dir, o, u.user_name, if (label_ok(u.display)) { u.display } else { str_slice(u.user_name, 0, min_int(64, str_len(u.user_name))) }, groups_for(o.st.org.groups, dgs, u.user_name, 0, ListBuf()))?;
    println("invite " + hex_encode(utf8(u.user_name)) + " " + made);
    return invite_new(dir, o, us, dgs, pending, i + 1);
}

Int min_int(Int a, Int b) { return if (a < b) { a } else { b }; }

List(List(Int)) groups_for(List(OrgGroup) gs, List(DirGroup) dgs, Str user, Int i, ListBuf(List(Int)) acc) {
    if (i >= dgs.len()) { return acc.finish(); }
    Int at = group_named(gs, dgs[i].display, 0);
    return groups_for(gs, dgs, user, i + 1, if (at >= 0 && has_str(dgs[i].members, user, 0)) { acc.push(gs[at].group_id) } else { acc });
}

List(Str) ids_of(List(Str) names, Int i, ListBuf(Str) acc) {
    if (i >= names.len()) { return acc.finish(); }
    Str id = if (str_len(names[i]) == 40) { str_slice(names[i], 8, 40) } else { "" };
    return ids_of(names, i + 1, if (share_id_ok(id)) { acc.push(id) } else { acc });
}

@requires(filesystem, network, device, declassify, clock, environment)
Int sync_all(Str dir, OrgCtx o, List(Str) wraps, List(Str) ids, Int i) {
    if (i >= ids.len()) { return 0; }
    Result(Str, Str) r = sync_one(dir, o, wraps, ids[i]);
    println(ids[i] + " " + match r { Ok(s) => s, Err(m) => "- " + hex_encode(utf8(m)) });
    return sync_all(dir, o, wraps, ids, i + 1);
}

@requires(filesystem, network, device, declassify, clock, environment)
Result(Str, Str) sync_one(Str dir, OrgCtx o, List(Str) wraps, Str cid) {
    Loaded ld = load_folder(dir, o.x, cid)?;
    if (ld.r.deleted) { return Ok("deleted"); }
    List(List(Int)) people = people_of(ld.r);
    List(List(Int)) gone = holders_gone(o.x, wraps, cid, ld.r.version, people, 0, ListBuf());
    if (gone.len() == 0) {
        _ = fill_wraps(o.x, ld, people, 0, 0);
        return Ok("ok");
    }
    GroupFolder f = need(gfolder_of(blob_get(o.x.ep, gfolder_blob(cid)) else { [] }), "the group folder does not decode")?;
    Opened op = opened_with(dir, o.x, cid, true)?;
    List(Secret(UInt(8))) key = random_secret(32);
    List(Item) items = reseal(ld.key, key, op.p.vid, op.st.items, 0, ListBuf())?;
    Opened next = Opened {.c = op.c, .u = op.u, .vh = op.vh, .st = op.st, .pin = op.pin, .p = Place {.share = cid, .vk = key, .vid = op.p.vid}, .ep = op.ep};
    if (publish_items(dir, next, items) != 0) { return Err("the server refused the items sealed again"); }
    UInt(64) v = ld.r.version + (UInt(64))1;
    GroupFolder nf = sign_gfolder(o.x, ld.r.coll_id, v, f.org_id, f.groups, key, ld.name, false)?;
    Str m = put_wraps(o.x, ld.r.coll_id, v, key, people, 0);
    if (str_len(m) > 0) { return Err(m); }
    if (!clear_wraps(o.x, ld.r.coll_id, v, gone, 0)) { return Err("the server refused a key wrap"); }
    Int put = put_blob(o.x, gfolder_blob(cid), cbor_or_empty(to_cbor(nf)), "group folder")?;
    _ = filesystem.write_all(place_local(dir, cid) + ".roster", f"{v}");
    _ = load_folder(dir, o.x, cid);       // this device's copy of the new key
    _ = audit(dir, o.x, o.st.org.org_id, "share", cid, f"rekeyed: {gone.len()} left");
    return Ok(f"rekeyed {gone.len()}");
}

// The people holding a wrap set of the folder at `version` who are no
// longer among its people.
@requires(network, clock(readonly), declassify)
List(List(Int)) holders_gone(Ctx x, List(Str) wraps, Str cid, UInt(64) version, List(List(Int)) people, Int i, ListBuf(List(Int)) acc) {
    if (i >= wraps.len()) { return acc.finish(); }
    Str n = wraps[i];
    Bool mine = str_len(n) == 5 + 64 + 1 + 32 && str_slice(n, 70, 102) == cid;
    List(Int) l = if (mine) { cose_hex_decode(str_slice(n, 5, 69)) } else { [] };
    Bool holds = mine && !has_log(people, l) && match wraps_of(blob_get(x.ep, n) else { [] }) { None => false, Some(ws) => ws.roster_version == version && ws.wraps.len() > 0 };
    return holders_gone(x, wraps, cid, version, people, i + 1, if (holds) { acc.push(l) } else { acc });
}

// ─── Opt-in recovery of work folders (SPEC 29.8) ────────────────
// An owner turns recovery on: a new HPKE P-256 key whose private key is
// split among recovery administrators (any `threshold` of them recover
// it) and then forgotten; each share is wrapped to its administrator's
// devices. A member escrows a work folder they own (never their own
// vault): its key sealed to the recovery key. A recovery administrator
// asks to open one; after the delay (witness time), `threshold` of them
// approve, each re-wrapping their share to the requester's devices; the
// requester rebuilds the recovery key and opens that folder. The folder's
// owner sees the request in `org show`, and every step is audited.

pub List(Int) rec_share_id(List(Int) org, UInt(64) since, Int i) { return sha256_bytes(utf8("symbolon v1 recovery share").concat(org).concat(utf8(f"{since} {i}")))[0..16]; }
pub List(Int) rec_part_id(List(Int) cid, List(Int) admin, Int time) { return sha256_bytes(utf8("symbolon v1 recovery part").concat(cid).concat(admin).concat(utf8(f"{time}")))[0..16]; }

List(Int) be_bytes(UInt(256) v, Int n, List(Int) acc) {
    if (n == 0) { return acc; }
    UInt(256) base = 256;
    Int d = (Int)(v % base);
    return be_bytes(v / base, n - 1, [d].concat(acc));
}

UInt(256) u256_of(List(Int) b, Int i, UInt(256) acc) {
    if (i >= b.len()) { return acc; }
    UInt(256) base = 256;
    UInt(256) d = (UInt(256))b[i];
    return u256_of(b, i + 1, acc * base + d);
}

// A scalar below the P-256 order: 31 random bytes.
List(Int) small_secret() { return [0].concat(random_bytes(31)); }

List(UInt(256)) coeffs(Int k, ListBuf(UInt(256)) acc) {
    if (k <= 0) { return acc.finish(); }
    return coeffs(k - 1, acc.push(u256_of(small_secret(), 0, (UInt(256))0)));
}

@requires(filesystem, network, device, declassify, clock, provision, environment)
pub Int org_recovery(Str dir, Str on, Str k, Str delay, Str admins_arg, Bool short) { return done(recovery(dir, on, k, delay, admins_arg, short)); }

// The shortest delay an owner sets without --short-delay: 72 hours.
pub Int min_recovery_delay() { return 259200; }

@requires(filesystem, network, device, declassify, clock, provision, environment)
Result(Int, Str) recovery(Str dir, Str on, Str k_arg, Str delay_arg, Str admins_arg, Bool short) {
    OrgCtx o = org_unlocked(dir)?;
    if (!is_owner(o.st.gov, o.x.c.log_id)) { return Err("only an owner turns recovery on or off"); }
    if (on == "off") { return store_gov_r(dir, o.x, o.st, o.st.gov.owners, o.st.gov.admins, o.st.gov.policy, no_recovery(), "recovery", "off"); }
    List(List(Int)) admins = logs_arg(str_split(admins_arg, ","), 0, ListBuf());
    Int k = str_parse_int(k_arg);
    Int delay = str_parse_int(delay_arg);
    if (admins.len() == 0 || admins.len() > 255 || k < 1 || k > admins.len() || delay < 0) { return Err("recovery on K DELAY-SECONDS ADMIN-LOG,...: 1 <= K <= administrators <= 255"); }
    if (delay < min_recovery_delay() && !short) { return Err(f"a delay under {min_recovery_delay()} seconds (72 hours) leaves a person little time to see a request: add --short-delay to mean it"); }
    if (!all_admins(o.st, admins, 0)) { return Err("each recovery administrator must be an owner or administrator in the organization"); }
    List(Int) r = small_secret();
    HpkeKeyPair kp = hpke_derive_keypair(16, r);
    if (!kp.ok) { return Err("cannot make the recovery key"); }
    List(UInt(256)) shares = sh_split([u256_of(r, 0, (UInt(256))0)].concat(coeffs(k - 1, ListBuf())), admins.len());
    UInt(64) since = o.st.gov.version + (UInt(64))1;
    Str m = wrap_shares(o.x, o.st.org.org_id, since, shares, admins, 0);
    if (str_len(m) > 0) { return Err(m); }
    OrgRecovery rec = OrgRecovery {.on = true, .public_key = kp.pk, .threshold = k, .admins = admins, .delay_sec = delay, .since = since, .owner = o.x.c.log_id};
    return store_gov_r(dir, o.x, o.st, o.st.gov.owners, o.st.gov.admins, o.st.gov.policy, rec, "recovery", f"on {k}/{admins.len()} delay {delay}");
}

List(List(Int)) logs_arg(List(Str) xs, Int i, ListBuf(List(Int)) acc) {
    if (i >= xs.len()) { return acc.finish(); }
    return logs_arg(xs, i + 1, if (log_hex_ok(xs[i])) { acc.push(cose_hex_decode(xs[i])) } else { acc });
}

Bool all_admins(OrgState st, List(List(Int)) ls, Int i) {
    if (i >= ls.len()) { return true; }
    return is_admin(st.gov, ls[i]) && member_index(st.org.members, ls[i], 0) >= 0 && all_admins(st, ls, i + 1);
}

@requires(network, clock(readonly), declassify)
Str wrap_shares(Ctx x, List(Int) org, UInt(64) since, List(UInt(256)) shares, List(List(Int)) admins, Int i) {
    if (i >= admins.len()) { return ""; }
    Str m = put_wraps(x, rec_share_id(org, since, i), since, secret_bytes(be_bytes(shares[i], 32, [])), [admins[i]], 0);
    return if (str_len(m) > 0) { m } else { wrap_shares(x, org, since, shares, admins, i + 1) };
}

// `org escrow DIR CID`: a work folder this person owns, its key sealed to
// the recovery key. Run again after the folder's key changes.
@requires(filesystem, network, device, declassify, clock, provision, environment)
pub Int org_escrow(Str dir, Str cid) { return done(escrow(dir, cid)); }

@requires(filesystem, network, device, declassify, clock, provision, environment)
Result(Int, Str) escrow(Str dir, Str cid) {
    OrgCtx o = org_unlocked(dir)?;
    OrgRecovery rec = o.st.gov.recovery;
    if (!rec.on) { return Err("the organization has not turned recovery on"); }
    Loaded ld = load_folder(dir, o.x, cid)?;
    if (is_group_roster(ld.r) || !bytes_eq(ld.r.owner, o.x.c.log_id)) { return Err("only a shared folder you own is escrowed (group folders need none)"); }
    OrgEscrow e0 = put_escrow(o.x.c, o.x.u, o.x.vh, o.x.ep, o.st.org.org_id, rec, ld.r.coll_id, ld.r.version, ld.key)?;
    _ = audit(dir, o.x, e0.org_id, "recovery", cid, f"escrowed at version {ld.r.version}");
    println(f"escrowed {cid} {ld.r.version}");
    return Ok(0);
}

// `org recover request|approve|open DIR CID`.
@requires(filesystem, network, device, declassify, clock, provision, environment)
pub Int org_recover(Str dir, Str step, Str cid) {
    if (!share_id_ok(cid)) { return done(Err("a folder id is 32 hex digits")); }
    if (step == "request") { return done(rec_request(dir, cid)); }
    if (step == "approve") { return done(rec_approve(dir, cid)); }
    if (step == "open") { return done(rec_open(dir, cid)); }
    return done(Err("org recover request|approve|open DIR CID"));
}

Result(Int, Str) rec_admin_only(OrgCtx o) {
    OrgRecovery rec = o.st.gov.recovery;
    if (!rec.on) { return Err("the organization has not turned recovery on"); }
    return if (log_at(rec.admins, o.x.c.log_id, 0) >= 0) { Ok(log_at(rec.admins, o.x.c.log_id, 0)) } else { Err("only a recovery administrator does that") };
}

@requires(filesystem, network, device, declassify, clock, provision, environment)
Result(Int, Str) rec_request(Str dir, Str cid) {
    OrgCtx o = org_unlocked(dir)?;
    Int me = rec_admin_only(o)?;
    Int now = witness_now(o.x.vh.head.policy.witnesses, o.x.c.ca, random_bytes(32));
    if (now == 0) { return Err("the witnesses did not answer for the time"); }
    OrgRecoveryRequest q0 = OrgRecoveryRequest {.org_id = o.st.org.org_id, .coll_id = cose_hex_decode(cid), .requester = o.x.c.log_id, .time = now,
                                                .log_sequence = o.x.vh.head.sequence, .signer = o.x.c.party, .sig = []};
    List(Int) sig = dk_sign(o.x.c, o.x.u.real, o.x.u.st, recreq_tbs(q0))?;
    Int put = put_blob(o.x, recreq_blob(q0.org_id, cid), cbor_or_empty(to_cbor(recreq_signed(q0, sig))), "recovery request")?;
    _ = audit(dir, o.x, q0.org_id, "recovery", cid, "requested by " + hex_encode(o.x.c.log_id));
    println("requested " + cid + f" {now + o.st.gov.recovery.delay_sec}");
    return Ok(0);
}

// The request at the relay, signed by a recovery administrator's device.
@requires(network, clock(readonly), declassify)
Result(OrgRecoveryRequest, Str) verified_request(OrgCtx o, Str cid) {
    OrgRecoveryRequest q = need(recreq_of(blob_get(o.x.ep, recreq_blob(o.st.org.org_id, cid)) else { [] }), "no one asked to open this folder")?;
    if (!bytes_eq(q.org_id, o.st.org.org_id) || hex_encode(q.coll_id) != cid || log_at(o.st.gov.recovery.admins, q.requester, 0) < 0) { return Err("the request is not a recovery administrator's"); }
    VerifiedHead h = head_of(o.x.c, o.x.vh, q.requester)?;
    if (!signed_by(h, q.log_sequence, q.signer, recreq_tbs(q), q.sig)) { return Err("the request's signature does not verify"); }
    return Ok(q);
}

// A wrapped secret for this device: id `id`, version `v`, wrapped by `from`.
@requires(network, clock(readonly), declassify)
Result(List(Secret(UInt(8))), Str) unwrapped(Ctx x, List(Int) id, UInt(64) v, List(Int) from) {
    WrapSet ws = need(wraps_of(blob_get(x.ep, wrap_blob(x.c.log_id, hex_encode(id))) else { [] }), "no wrapped share for you")?;
    if (ws.roster_version != v || !bytes_eq(ws.coll_id, id) || !bytes_eq(ws.member, x.c.log_id)) { return Err("the wrapped share is for something else"); }
    ShareWrap w = need(wrap_to(ws.wraps, x.c.party, 0), "no wrapped share for this device")?;
    return unwrap(x, Roster {.coll_id = id, .version = v, .owner = from, .owner_label = "", .members = [], .name_ct = [], .deleted = false,
                             .log_sequence = (UInt(64))0, .signer = [], .sig = []}, w);
}

@requires(filesystem, network, device, declassify, clock, provision, environment)
Result(Int, Str) rec_approve(Str dir, Str cid) {
    OrgCtx o = org_unlocked(dir)?;
    Int me = rec_admin_only(o)?;
    OrgRecovery rec = o.st.gov.recovery;
    OrgRecoveryRequest q = verified_request(o, cid)?;
    Int now = witness_now(o.x.vh.head.policy.witnesses, o.x.c.ca, random_bytes(32));
    if (now < q.time + rec.delay_sec) { return Err(f"the request opens at {q.time + rec.delay_sec} (witness time now {now})"); }
    List(Secret(UInt(8))) share = unwrapped(o.x, rec_share_id(o.st.org.org_id, rec.since, me), rec.since, rec.owner)?;
    Str m = put_wraps(o.x, rec_part_id(q.coll_id, o.x.c.log_id, q.time), (UInt(64))q.time, share, [q.requester], 0);
    if (str_len(m) > 0) { return Err(m); }
    _ = audit(dir, o.x, o.st.org.org_id, "recovery", cid, "approved for " + hex_encode(q.requester));
    println("approved " + cid);
    return Ok(0);
}

type Share = { Int id; UInt(256) v; };

@requires(network, clock(readonly), declassify)
List(Share) parts(OrgCtx o, OrgRecoveryRequest q, Int i, ListBuf(Share) acc) {
    List(List(Int)) admins = o.st.gov.recovery.admins;
    if (i >= admins.len()) { return acc.finish(); }
    Result(List(Secret(UInt(8))), Str) r = unwrapped(o.x, rec_part_id(q.coll_id, admins[i], q.time), (UInt(64))q.time, admins[i]);
    return parts(o, q, i + 1, match r { Ok(b) => acc.push(Share {.id = i + 1, .v = u256_of(reveal(b), 0, (UInt(256))0)}), Err(_) => acc });
}

List(Int) share_ids(List(Share) xs, Int i, ListBuf(Int) acc) { return if (i >= xs.len()) { acc.finish() } else { share_ids(xs, i + 1, acc.push(xs[i].id)) }; }
List(UInt(256)) share_vals(List(Share) xs, Int i, ListBuf(UInt(256)) acc) { return if (i >= xs.len()) { acc.finish() } else { share_vals(xs, i + 1, acc.push(xs[i].v)) }; }

@requires(filesystem, network, device, declassify, clock, provision, environment)
Result(Int, Str) rec_open(Str dir, Str cid) {
    OrgCtx o = org_unlocked(dir)?;
    Int me = rec_admin_only(o)?;
    OrgRecovery rec = o.st.gov.recovery;
    OrgRecoveryRequest q = verified_request(o, cid)?;
    if (!bytes_eq(q.requester, o.x.c.log_id)) { return Err("the request is someone else's"); }
    List(Share) got = parts(o, q, 0, ListBuf());
    if (got.len() < rec.threshold) { return Err(f"{got.len()} of {rec.threshold} recovery administrators approved so far"); }
    List(Share) use = got[0..rec.threshold];
    List(Int) r = be_bytes(sh_reconstruct(share_ids(use, 0, ListBuf()), share_vals(use, 0, ListBuf())), 32, []);
    HpkeKeyPair kp = hpke_derive_keypair(16, r);
    if (!kp.ok || !bytes_eq(kp.pk, rec.public_key)) { return Err("the shares do not rebuild the recovery key"); }
    OrgEscrow e = need(escrow_of(blob_get(o.x.ep, escrow_blob(o.st.org.org_id, cid)) else { [] }), "the folder has no escrow")?;
    VerifiedHead eh = head_of(o.x.c, o.x.vh, e.owner)?;
    if (!signed_by(eh, e.log_sequence, e.signer, escrow_tbs(e), e.sig) || hex_encode(e.coll_id) != cid) { return Err("the escrow's signature does not verify"); }
    Roster ro = roster_at(dir, o.x, cid)?;
    if (!bytes_eq(ro.owner, e.owner)) { return Err("the escrow is not the folder owner's"); }
    if (ro.version != e.roster_version) { return Err(f"the escrow is for version {e.roster_version}, the folder is at {ro.version}: its owner escrows it again"); }
    HpkeCtxG(Secret(UInt(8))) hc = hpkeg_setup_receiver(share_suite(), e.enc, secret_bytes(kp.sk), escrow_info(e.org_id, e.coll_id, e.roster_version));
    if (!hc.ok) { return Err("the escrow does not open"); }
    HpkeOpenedG(Secret(UInt(8))) op = hpkeg_open(hc, [], e.ct);
    if (!op.ok || op.pt.len() != 32) { return Err("the escrow does not open"); }
    VaultState st = fetch_coll(dir, o.x, ro, cid, false)?;
    _ = audit(dir, o.x, o.st.org.org_id, "recovery", cid, "opened by " + hex_encode(o.x.c.log_id));
    println("opened " + cid + f" {st.items.len()}");
    return Ok(list_items(View {.vk = op.pt, .vid = coll_vid(ro.coll_id), .st = st, .offline = false}, 0, 0));
}

// ─── Audit ──────────────────────────────────────────────────────
// Each device chains its events: dir/audit.seq holds the last sequence
// number, dir/audit.prev the SHA-256 of the last event's CBOR.

@requires(filesystem, network, device, declassify, clock, environment)
pub Bool audit(Str dir, Ctx x, List(Int) org_id, Str action, Str object, Str detail) { return audit_event(dir, x.c, x.u, x.vh, x.ep, org_id, action, object, detail); }

// `org audit DIR`: every event at the server for the organization, in
// order per device: "TIME LOG SEQ ACTION OBJECT DETAIL-HEX ok", or
// "... broken WHY-HEX" for one whose signature, chain or sequence fails.
@requires(filesystem, network, clock(readonly), declassify)
pub Int org_audit(Str dir) { return done(audit_list(dir)); }

@requires(filesystem, network, clock(readonly), declassify)
Result(Int, Str) audit_list(Str dir) {
    OrgCtx o = org_view(dir)?;
    List(Str) names = blob_list(o.x.ep, "audit-" + hex_encode(o.st.org.org_id) + "-");
    return Ok(print_events(o, names, 0, [], (UInt(64))0, []));
}

@requires(network, clock(readonly), declassify)
Int print_events(OrgCtx o, List(Str) names, Int i, List(Int) log, UInt(64) last, List(Int) prev) {
    if (i >= names.len()) { return 0; }
    Option(AuditEvent) oe = event_of(blob_get(o.x.ep, names[i]) else { [] });
    return match oe {
        None => print_events(o, names, i + 1, log, last, prev),
        Some(e) => next_event(o, names, i, e, bytes_eq(e.log_id, log), last, prev)
    };
}

@requires(network, clock(readonly), declassify)
Int next_event(OrgCtx o, List(Str) names, Int i, AuditEvent e, Bool same, UInt(64) last, List(Int) prev) {
    List(Int) b = blob_get(o.x.ep, names[i]) else { [] };
    Str why = event_problem(o, names[i], e, if (same) { last } else { (UInt(64))0 }, if (same) { prev } else { [] });
    println(f"{e.time} " + hex_encode(e.log_id) + f" {e.seq} " + e.action + " " + e.object + " " + hex_or_dash(e.detail) + (if (str_len(why) == 0) { " ok" } else { " broken " + hex_encode(utf8(why)) }));
    return print_events(o, names, i + 1, e.log_id, e.seq, sha256_bytes(b));
}

@requires(network, clock(readonly), declassify)
pub Str event_problem(OrgCtx o, Str name, AuditEvent e, UInt(64) last, List(Int) prev) {
    if (name != audit_blob(e.org_id, e.log_id, e.seq) || !bytes_eq(e.org_id, o.st.org.org_id)) { return "stored under another name"; }
    if (e.seq != last + (UInt(64))1) { return f"after {last} comes {e.seq}: events are missing"; }
    if (!bytes_eq(e.prev, prev)) { return "does not follow the event before"; }
    Result(VerifiedHead, Str) rh = head_of(o.x.c, o.x.vh, e.log_id);
    return match rh {
        Err(m) => m,
        Ok(h) => if (match device_party(h.head.quorum.parties, e.party, 0) { None => false, Some(d) => ecdsa_verify_raw(P256, Sha256, d.auth_key, event_tbs(e), e.sig) }) { "" } else { "signature does not verify" }
    };
}

// ─── Export to a SIEM (SPEC 29.6) ───────────────────────────────
// `org export DIR [--https URL [--token T] [--ca FILE]] [--syslog HOST:PORT [--ca FILE]]`:
// every audit event, verified here first, as one JSON object per line:
// {"time","org","log","seq","action","object","detail","verified","problem"}.
// Without a destination the lines go to standard output; --https POSTs
// them (application/x-ndjson, "Authorization: Bearer T"); --syslog sends
// each as an RFC 5424 message over TLS (RFC 5425, octet counting) when
// --ca is given, else over TCP (RFC 6587).

@requires(filesystem, network, clock(readonly), declassify)
pub Int org_export(Str dir, Str https, Str token, Str syslog, Str ca_file) { return done(export(dir, https, token, syslog, ca_file)); }

@requires(filesystem, network, clock(readonly), declassify)
Result(Int, Str) export(Str dir, Str https, Str token, Str syslog, Str ca_file) {
    OrgCtx o = org_view(dir)?;
    List(Str) names = blob_list(o.x.ep, "audit-" + hex_encode(o.st.org.org_id) + "-");
    List(Str) lines = event_lines(o, names, 0, [], (UInt(64))0, [], ListBuf());
    Str ca = if (str_len(ca_file) == 0) { "" } else { filesystem.read_all(ca_file) };
    if (str_len(https) > 0) { return post_lines(https, token, ca, lines); }
    if (str_len(syslog) > 0) { return syslog_lines(syslog, ca, hex_encode(o.st.org.org_id), lines); }
    println(str_join(lines, "\n"));
    return Ok(0);
}

@requires(network, clock(readonly), declassify)
List(Str) event_lines(OrgCtx o, List(Str) names, Int i, List(Int) log, UInt(64) last, List(Int) prev, ListBuf(Str) acc) {
    if (i >= names.len()) { return acc.finish(); }
    List(Int) b = blob_get(o.x.ep, names[i]) else { [] };
    Option(AuditEvent) oe = event_of(b);
    return match oe {
        None => event_lines(o, names, i + 1, log, last, prev, acc),
        Some(e) => event_lines(o, names, i + 1, e.log_id, e.seq, sha256_bytes(b), acc.push(event_json(e, event_problem(o, names[i], e, if (bytes_eq(e.log_id, log)) { last } else { (UInt(64))0 }, if (bytes_eq(e.log_id, log)) { prev } else { [] }))))
    };
}

Str event_json(AuditEvent e, Str why) {
    return f"{{\"time\":{e.time},\"org\":" + json_quote(hex_encode(e.org_id)) + ",\"log\":" + json_quote(hex_encode(e.log_id)) + f",\"seq\":{e.seq},\"action\":" + json_quote(e.action)
         + ",\"object\":" + json_quote(e.object) + ",\"detail\":" + json_quote(e.detail) + ",\"verified\":" + (if (str_len(why) == 0) { "true" } else { "false" })
         + ",\"problem\":" + json_quote(why) + "}";
}

// scheme, host, port, path of an http(s) URL.
List(Str) url_parts(Str u) {
    Bool tls = str_starts_with(u, "https://");
    Str rest = str_slice(u, if (tls) { 8 } else { 7 }, str_len(u));
    Int slash = str_index_of(rest, "/", 0);
    Str hp = if (slash < 0) { rest } else { str_slice(rest, 0, slash) };
    Int colon = str_index_of(hp, ":", 0);
    return [if (tls) { "https" } else { "http" }, if (colon < 0) { hp } else { str_slice(hp, 0, colon) },
            if (colon < 0) { if (tls) { "443" } else { "80" } } else { str_slice(hp, colon + 1, str_len(hp)) }, if (slash < 0) { "/" } else { str_slice(rest, slash, str_len(rest)) }];
}

@requires(network, clock(readonly), declassify)
Result(Int, Str) post_lines(Str url, Str token, Str ca, List(Str) lines) {
    List(Str) u = url_parts(url);
    Str heads = "Content-Type: application/x-ndjson\r\n" + (if (str_len(token) > 0) { "Authorization: Bearer " + token + "\r\n" } else { "" });
    List(Int) body = utf8(str_join(lines, "\n") + "\n");
    HttpOut r = if (u[0] == "https") { https_post(url, ca, heads, body) } else { http_call_head(u[1], str_parse_int(u[2]), "POST", u[3], heads, body) };
    if (r.status < 200 || r.status > 299) { return Err(f"the SIEM answered {r.status}"); }
    println(f"exported {lines.len()} events");
    return Ok(0);
}

@requires(network, clock(readonly), declassify)
HttpOut https_post(Str url, Str ca, Str heads, List(Int) body) {
    HttpsGet g = tls_https_request(url, "", trust_store_add_pem(trust_store_empty(), ca), ["http/1.1"], 30000, "POST", heads, body);
    return HttpOut {.status = g.status, .body = g.bytes};
}

// <110>1 TIME - symbolon - audit - MSG  (facility 13 log audit, severity info)
Str syslog_frame(Str org, Str line) {
    Str m = "<110>1 - - symbolon - audit [symbolon@32473 org=\"" + org + "\"] " + line;
    return f"{str_len(m)} " + m;
}

@requires(network, clock(readonly), declassify)
Result(Int, Str) syslog_lines(Str hp, Str ca, Str org, List(Str) lines) {
    List(Str) p = str_split(hp, ":");
    if (p.len() != 2) { return Err("--syslog HOST:PORT"); }
    List(Int) data = utf8(str_join(frames(org, lines, 0, ListBuf()), ""));
    if (str_len(ca) == 0) {
        Int fd = resid_tcp_connect(p[0], str_parse_int(p[1]));
        if (fd < 0) { return Err("cannot reach the syslog server"); }
        Bool sent = resid_tcp_send_bin(fd, data);
        _ = resid_tcp_close(fd);
        return if (sent) { exported(lines.len()) } else { Err("cannot send to the syslog server") };
    }
    TlsDial d = tls_client_connect(p[0], str_parse_int(p[1]), tls_client_cfg(p[0], trust_store_add_pem(trust_store_empty(), ca), []));
    if (d.err != "") { return Err("syslog over TLS: " + d.err); }
    WireOut(TlsClient) w = wire_send(d.conn, data);
    _ = wire_close(w.conn);
    return if (w.ok) { exported(lines.len()) } else { Err("cannot send to the syslog server") };
}

Result(Int, Str) exported(Int n) { println(f"exported {n} events"); return Ok(0); }

List(Str) frames(Str org, List(Str) lines, Int i, ListBuf(Str) acc) {
    if (i >= lines.len()) { return acc.finish(); }
    return frames(org, lines, i + 1, acc.push(syslog_frame(org, lines[i])));
}


// ─── The relay's console, from this device (SPEC 29.10) ─────────
// `org console-key DIR CODE`: approves the passkey waiting at the console
// with this code, for this owner or administrator. `org changes DIR`:
// "ID KIND A-HEX B-HEX C-HEX BY STATUS RESULT-HEX" per change queued at the
// console. `org approve DIR ID`: makes that change, signed here, and tells
// the console what came of it.

@requires(filesystem, network, device, declassify, clock, provision, environment)
pub Int org_console_key(Str dir, Str code) { return done(console_key(dir, code)); }

@requires(filesystem, network, device, declassify, clock, provision, environment)
Result(Int, Str) console_key(Str dir, Str code) {
    OrgCtx o = org_unlocked(dir)?;
    Int ok = admin_only(o)?;
    HttpOut r = http_call_ep(o.x.ep, "GET", "/console/" + hex_encode(o.st.org.org_id) + "/pending", []);
    if (r.status != 200) { return Err(f"the relay's console did not answer ({r.status})"); }
    List(Str) p = pending_with(str_split(http_text(r.body, 0, r.body.len()), "\n"), code, 0);
    if (p.len() != 4) { return Err("no passkey with this code is waiting at the console"); }
    OrgConsoleKey k0 = OrgConsoleKey {.org_id = o.st.org.org_id, .cred_id = cose_hex_decode(p[1]), .public_key = cose_hex_decode(p[2]), .rp_id = p[3], .log_id = o.x.c.log_id,
                                      .log_sequence = o.x.vh.head.sequence, .signer = o.x.c.party, .sig = []};
    List(Int) sig = dk_sign(o.x.c, o.x.u.real, o.x.u.st, conkey_tbs(k0))?;
    Int put = put_blob(o.x, conkey_blob(k0.org_id, k0.cred_id), cbor_or_empty(to_cbor(conkey_signed(k0, sig))), "console key")?;
    _ = audit(dir, o.x, k0.org_id, "member", hex_encode(sha256_bytes(k0.cred_id)[0..16]), "console passkey approved");
    println("approved " + code);
    return Ok(0);
}

List(Str) pending_with(List(Str) lines, Str code, Int i) {
    if (i >= lines.len()) { return []; }
    List(Str) p = str_split(lines[i], " ");
    return if (p.len() == 4 && p[0] == code) { p } else { pending_with(lines, code, i + 1) };
}

@requires(filesystem, network, clock(readonly), declassify)
pub Int org_changes(Str dir) { return done(changes(dir)); }

@requires(filesystem, network, clock(readonly), declassify)
Result(Int, Str) changes(Str dir) {
    OrgCtx o = org_view(dir)?;
    HttpOut r = http_call_ep(o.x.ep, "GET", "/console/" + hex_encode(o.st.org.org_id) + "/changes", []);
    if (r.status != 200) { return Err(f"the relay's console did not answer ({r.status})"); }
    Str t = http_text(r.body, 0, r.body.len());
    if (str_len(t) > 0) { println(t); }
    return Ok(0);
}

@requires(filesystem, network, device, declassify, clock, provision, environment)
pub Int org_approve(Str dir, Str id) { return done(approve(dir, id)); }

Str unhex_s(Str s) { List(Int) b = if (s == "-") { [] } else { cose_hex_decode(s) }; return http_text(b, 0, b.len()); }

@requires(filesystem, network, device, declassify, clock, provision, environment)
Result(Int, Str) approve(Str dir, Str id) {
    if (!share_id_ok(id)) { return Err("a change id is 32 hex digits"); }
    OrgCtx o = org_unlocked(dir)?;
    Int ok = admin_only(o)?;
    Str org = hex_encode(o.st.org.org_id);
    HttpOut r = http_call_ep(o.x.ep, "GET", "/console/" + org + "/changes", []);
    if (r.status != 200) { return Err(f"the relay's console did not answer ({r.status})"); }
    List(Str) p = change_with(str_split(http_text(r.body, 0, r.body.len()), "\n"), id, 0);
    if (p.len() != 8) { return Err("no such change"); }
    if (p[6] != "pending") { return Err("the change is " + p[6]); }
    println("change " + p[1] + " " + unhex_s(p[2]) + " " + unhex_s(p[3]) + " " + unhex_s(p[4]) + " queued by " + str_slice(p[5], 0, 12));
    Result(Str, Str) res = run_change(dir, o, p[1], unhex_s(p[2]), unhex_s(p[3]), unhex_s(p[4]));
    Str told = match res { Ok(t) => t, Err(m) => "refused: " + m };
    _ = http_call_ep(o.x.ep, "POST", "/console/" + org + "/done/" + id, utf8(told));
    _ = audit(dir, o.x, o.st.org.org_id, "member", id, "console change " + p[1] + ": " + told);
    return match res { Ok(t) => Ok(say_ok(t)), Err(m) => Err(m) };
}

Int say_ok(Str t) { println(t); return 0; }

List(Str) change_with(List(Str) lines, Str id, Int i) {
    if (i >= lines.len()) { return []; }
    List(Str) p = str_split(lines[i], " ");
    return if (p.len() == 8 && p[0] == id) { p } else { change_with(lines, id, i + 1) };
}

@requires(filesystem, network, device, declassify, clock, provision, environment)
Result(Str, Str) run_change(Str dir, OrgCtx o, Str kind, Str a, Str b, Str c) {
    if (kind == "invite") {
        if (!label_ok(b) || str_len(a) == 0) { return Err("an invite needs a directory id and a name"); }
        List(List(Int)) gs = if (str_len(c) == 0) { [] } else { group_ids(o.st.org.groups, str_split(c, ","), 0, ListBuf())? };
        return make_invite(dir, o, a, b, gs);
    }
    Int n = if (kind == "group-add" || kind == "group-remove") { group_set_in(dir, o, a, b, kind == "group-add")? } else {
        if (kind == "remove") { remove_in(dir, o, a)? } else { if (kind == "policy") { set_policy_in(dir, o, a, b)? } else { if (kind == "sync") { sync_in(dir, o)? } else { -1 } } } };
    return if (n < 0) { Err("unknown change " + kind) } else { Ok("done") };
}

// ─── Platform attestation (SPEC 29.5, 21.1) ─────────────────────
// `org attest DIR [CHAIN-FILE,...] [CRL-FILE,...]` on a device in the TPM
// profile: first its evidence (the TPM's EK certificate, any chain the TPM
// stores and the DER files given, the CRLs given, the AK), then, once an
// administrator's sync answered with a credential challenge, its response
// (the credential the TPM activates for that EK and AK, and TPM2_Certify of
// the device key by the AK over the challenge and its log id). The
// administrator's next sync verifies it with Resid's TPM verifier: the EK
// chain to a TPM maker's root with a current CRL for every certificate
// below the root (a chain without one is refused as stale), the AK in the
// same TPM, the device key fixed to it, PIN-gated, signing only; and adds
// the device's party to the membership record's `attested`.

List(UInt(8)) u8b(List(Int) b) { return u8s(b); }
List(Int) intb(List(UInt(8)) b) { return ints(b); }

@requires(filesystem)
List(List(Int)) der_files(Str arg, Int i, List(Str) fs, ListBuf(List(Int)) acc) {
    if (i >= fs.len()) { return acc.finish(); }
    Str f = fs[i];
    return der_files(arg, i + 1, fs, if (str_len(f) > 0 && filesystem.exists(f)) { acc.push(filesystem.read_bytes(f)) } else { acc });
}

@requires(filesystem, network, device, declassify, clock, provision, environment)
pub Int org_attest(Str dir, Str chain_arg, Str crl_arg) { return done(attest_step(dir, chain_arg, crl_arg)); }

@requires(filesystem, network, device, declassify, clock, provision, environment)
Result(Int, Str) attest_step(Str dir, Str chain_arg, Str crl_arg) {
    OrgCtx o = org_unlocked(dir)?;
    DeviceConfig c = o.x.c;
    if (c.unprotected || on_keystore(c)) { return Err("only a device in the TPM profile attests its key (the Keystore and unprotected profiles cannot)"); }
    List(Int) org = o.st.org.org_id;
    if (has_log(o.st.org.attested, c.party)) { println("attested"); return Ok(0); }
    Option(OrgAttestChallenge) och = attchal_of(blob_get(o.x.ep, att_blob("attchal", org, c.party)) else { [] });
    return match och {
        None => send_evidence(dir, o, str_split(chain_arg, ","), str_split(crl_arg, ",")),
        Some(ch) => answer_challenge(dir, o, ch)
    };
}

@requires(filesystem, network, device, declassify, clock, provision, environment)
Result(Int, Str) send_evidence(Str dir, OrgCtx o, List(Str) chain_files, List(Str) crl_files) {
    Bool ecc = match tpm_ek_cert(true) { Ok(b) => b.len() > 0, Err(_) => false };
    List(UInt(8)) ek = match tpm_ek_cert(ecc) { Ok(b) => b, Err(e) => [] };
    if (ek.len() == 0) { return Err("the TPM holds no EK certificate"); }
    List(List(Int)) nv_chain = match tpm_ek_chain_certs() { Ok(cs) => ints_all(cs, 0, ListBuf()), Err(_) => [] };
    TpmKeys keys = match tpm_ek_ak(ecc) { Ok(k) => k, Err(e) => return_none_keys() };
    if (keys.ak.public_area.len() == 0) { return Err("the TPM did not make its attestation key"); }
    _ = filesystem.write_all(dir + "/attest.ecc", if (ecc) { "1" } else { "0" });
    // What the TPM does not store, from where its certificates say: the
    // issuers (authority information access) and their CRLs (distribution
    // points), from the TPM maker's servers. Signed, so whoever serves them
    // cannot forge them; files given add to them (an organization's mirror).
    List(List(Int)) given = nv_chain.concat(der_files("", 0, chain_files, ListBuf()));
    List(List(Int)) fetched = if (given.len() == 0) { issuers_of(o.x.c, intb(ek), 0, ListBuf()) } else { [] };
    List(List(Int)) chain_all = given.concat(fetched);
    List(List(Int)) crls_all = der_files("", 0, crl_files, ListBuf()).concat(crls_of(o.x.c, [intb(ek)].concat(chain_all), 0, ListBuf()));
    OrgAttestEvidence e0 = OrgAttestEvidence {.org_id = o.st.org.org_id, .log_id = o.x.c.log_id, .party = o.x.c.party, .kind = "tpm", .ek_cert = intb(ek),
        .ek_chain = chain_all, .crls = crls_all, .ak_public = intb(keys.ak.public_area),
        .log_sequence = o.x.vh.head.sequence, .signer = o.x.c.party, .sig = []};
    List(Int) sig = dk_sign(o.x.c, o.x.u.real, o.x.u.st, attev_tbs(e0))?;
    Int put = put_blob(o.x, att_blob("attev", e0.org_id, e0.party), cbor_or_empty(to_cbor(attev_signed(e0, sig))), "attestation evidence")?;
    println(f"evidence sent ({e0.ek_chain.len()} chain certificates, {e0.crls.len()} CRLs): run org attest again after an administrator's sync");
    return Ok(0);
}

// URLs a certificate names after the extension `oid` (DER bytes): the
// GeneralName uniformResourceIdentifier entries ([6] IA5String) that
// follow it, within the extension.
List(Str) urls_after(List(Int) der, List(Int) oid) {
    Int at = find_bytes(der, oid, 0);
    if (at < 0) { return []; }
    Int end = if (at + 400 < der.len()) { at + 400 } else { der.len() };
    return uri_names(der, at + oid.len(), end, ListBuf());
}

Int find_bytes(List(Int) b, List(Int) pat, Int i) {
    if (i + pat.len() > b.len()) { return -1; }
    if (bytes_eq(b[i..i + pat.len()], pat)) { return i; }
    return find_bytes(b, pat, i + 1);
}

List(Str) uri_names(List(Int) b, Int i, Int end, ListBuf(Str) acc) {
    if (i + 2 >= end) { return acc.finish(); }
    Int n = b[i + 1];
    Bool uri = b[i] == 134 && n > 7 && n < 128 && i + 2 + n <= b.len() && b[i + 2] == 104;   // [6] "h..."
    return if (uri) { uri_names(b, i + 2 + n, end, acc.push(http_text(b, i + 2, i + 2 + n))) } else { uri_names(b, i + 1, end, acc) };
}

// authorityInfoAccess (1.3.6.1.5.5.7.1.1) and cRLDistributionPoints (2.5.29.31).
List(Int) oid_aia() { return [6, 8, 43, 6, 1, 5, 5, 7, 1, 1]; }
List(Int) oid_crldp() { return [6, 3, 85, 29, 31]; }

// A DER object by URL: https first (makers redirect there), the body as
// DER, or PEM (any label) decoded.
@requires(filesystem, network, clock(readonly), declassify)
List(Int) fetch_der(DeviceConfig c, Str url) {
    Str u = if (str_starts_with(url, "http://")) { "https://" + str_slice(url, 7, str_len(url)) } else { url };
    HttpsGet g = tls_https_request(u, "", trust_store_add_pem(trust_store_empty(), filesystem.read_all("/etc/ssl/certs/ca-certificates.crt")), ["http/1.1"], 30000, "GET", "", []);
    List(Int) b = if (g.status == 200) { g.bytes } else { [] };
    if (b.len() > 0 && b[0] == 48) { return b; }
    Str t = http_text(b, 0, b.len());
    Int s0 = str_index_of(t, "-----BEGIN", 0);
    if (s0 < 0) { return []; }
    Int s1 = str_index_of(t, "\n", s0);
    Int e0 = str_index_of(t, "-----END", s1);
    return if (s1 < 0 || e0 < 0) { [] } else { base64_decode(str_replace(str_replace(str_slice(t, s1 + 1, e0), "\r", ""), "\n", "")) };
}

// The issuers above `cert`, by authority information access, up to three.
@requires(filesystem, network, clock(readonly), declassify)
List(List(Int)) issuers_of(DeviceConfig c, List(Int) cert, Int depth, ListBuf(List(Int)) acc) {
    List(Str) us = urls_after(cert, oid_aia());
    if (depth >= 3 || us.len() == 0) { return acc.finish(); }
    List(Int) up = fetch_der(c, us[0]);
    return if (up.len() == 0 || bytes_eq(up, cert)) { acc.finish() } else { issuers_of(c, up, depth + 1, acc.push(up)) };
}

// The CRLs the certificates' distribution points give.
@requires(filesystem, network, clock(readonly), declassify)
List(List(Int)) crls_of(DeviceConfig c, List(List(Int)) certs, Int i, ListBuf(List(Int)) acc) {
    if (i >= certs.len()) { return acc.finish(); }
    List(Str) us = urls_after(certs[i], oid_crldp());
    List(Int) crl = if (us.len() > 0) { fetch_der(c, us[0]) } else { [] };
    return crls_of(c, certs, i + 1, if (crl.len() > 0) { acc.push(crl) } else { acc });
}

TpmKeys return_none_keys() { return TpmKeys {.ek = TpmCreated {.handle = 0, .public_area = [], .name = []}, .ak = TpmCreated {.handle = 0, .public_area = [], .name = []}}; }

List(List(Int)) ints_all(List(List(UInt(8))) xs, Int i, ListBuf(List(Int)) acc) { return if (i >= xs.len()) { acc.finish() } else { ints_all(xs, i + 1, acc.push(intb(xs[i]))) }; }

@requires(filesystem, network, device, declassify, clock, provision, environment)
Result(Int, Str) answer_challenge(Str dir, OrgCtx o, OrgAttestChallenge ch) {
    if (!is_admin(o.st.gov, ch.by_log)) { return Err("the challenge is not an administrator's"); }
    VerifiedHead h = head_of(o.x.c, o.x.vh, ch.by_log)?;
    if (match device_party(h.head.quorum.parties, ch.signer, 0) { None => true, Some(d) => !ecdsa_verify_raw(P256, Sha256, d.auth_key, attchal_tbs(ch), ch.sig) }) { return Err("the challenge's signature does not verify"); }
    Bool ecc = str_trim(filesystem.read_all(dir + "/attest.ecc")) == "1";
    List(UInt(8)) act = match tpm_activate_credential(ecc, u8b(ch.blob), u8b(ch.secret)) { Ok(a) => a, Err(e) => [] };
    if (act.len() == 0) { return Err("the TPM did not activate the credential (not its EK and AK?)"); }
    TpmCertified2 cert = match tpm_certify(o.x.c.tpm_dk, o.x.u.st, u8b(enroll_extra(ch.value, o.x.c.log_id))) { Ok(x) => x, Err(e) => TpmCertified2 {.ak_public = [], .attest = [], .sig = []} };
    if (cert.attest.len() == 0) { return Err("the TPM did not certify the device key"); }
    List(UInt(8)) dkp = match tpm_read_public(o.x.c.tpm_dk) { Ok(p) => p.public_area, Err(_) => [] };
    OrgAttestResponse r0 = OrgAttestResponse {.org_id = o.st.org.org_id, .party = o.x.c.party, .activated = intb(act), .attest = intb(cert.attest), .attest_sig = intb(cert.sig),
        .dk_public = intb(dkp), .log_sequence = o.x.vh.head.sequence, .signer = o.x.c.party, .sig = []};
    List(Int) sig = dk_sign(o.x.c, o.x.u.real, o.x.u.st, attresp_tbs(r0))?;
    Int put = put_blob(o.x, att_blob("attresp", r0.org_id, r0.party), cbor_or_empty(to_cbor(attresp_signed(r0, sig))), "attestation response")?;
    println("answered: an administrator's next sync verifies it");
    return Ok(0);
}

// The administrator's side, in `org sync`: challenges new evidence, and
// verifies answers to this device's challenges. "challenged PARTY",
// "attested PARTY", "refused PARTY WHY-HEX".
@requires(filesystem, network, device, declassify, clock, provision, environment)
Result(OrgCtx, Str) attest_sync(Str dir, OrgCtx o) {
    List(Str) names = blob_list(o.x.ep, "attev-" + hex_encode(o.st.org.org_id) + "-");
    if (names.len() == 0) { return Ok(o); }
    _ = filesystem.create_dir(dir + "/attest");
    List(List(Int)) newly = attest_each(dir, o, names, 0, ListBuf());
    if (newly.len() == 0) { return Ok(o); }
    Org cur = o.st.org;
    Org o2 = sign_org(o.x, cur.org_id, cur.version + (UInt(64))1, cur.gov_version, cur.members, cur.groups, cur.attested.concat(newly))?;
    Int put = put_blob(o.x, org_blob(o2.org_id), cbor_or_empty(to_cbor(o2)), "membership record")?;
    _ = filesystem.write_all(dir + "/org.version", f"{o2.version}");
    _ = audit(dir, o.x, o2.org_id, "member", hex_encode(o2.org_id), f"{newly.len()} devices attested");
    OrgState st = org_at(dir, o.x.c, o.x.vh)?;
    return Ok(OrgCtx {.x = o.x, .st = st});
}

@requires(filesystem, network, device, declassify, clock, provision, environment)
List(List(Int)) attest_each(Str dir, OrgCtx o, List(Str) names, Int i, ListBuf(List(Int)) acc) {
    if (i >= names.len()) { return acc.finish(); }
    Option(OrgAttestEvidence) oe = attev_of(blob_get(o.x.ep, names[i]) else { [] });
    Result(Str, Str) r = match oe { None => Err("the evidence does not decode"), Some(e) => attest_one(dir, o, e) };
    Str p = str_slice(names[i], str_len(names[i]) - 32, str_len(names[i]));
    _ = match r { Ok(s) => say_line(s + " " + p), Err(m) => say_line("refused " + p + " " + hex_encode(utf8(m))) };
    return attest_each(dir, o, names, i + 1, match r { Ok(s) => if (s == "attested") { acc.push(match oe { Some(e) => e.party, None => [] }) } else { acc }, Err(_) => acc });
}

Int say_line(Str s) { println(s); return 0; }

List(Secret(UInt(8))) att_export_key(Unlocked u) { return hk(u.real.vault_key, "symbolon v1 attest export", 32); }

@requires(filesystem, network, device, declassify, clock, provision, environment)
Result(Str, Str) attest_one(Str dir, OrgCtx o, OrgAttestEvidence e) {
    if (has_log(o.st.org.attested, e.party)) { return Ok("already"); }
    if (member_index(o.st.org.members, e.log_id, 0) < 0 || e.kind != "tpm") { return Err("not a member's TPM evidence"); }
    VerifiedHead h = head_of(o.x.c, o.x.vh, e.log_id)?;
    Party d = need(device_party(h.head.quorum.parties, e.party, 0), "the device is not in its owner's log")?;
    if (!signed_by(h, e.log_sequence, e.signer, attev_tbs(e), e.sig) || !bytes_eq(e.signer, e.party)) { return Err("the evidence is not signed by its device"); }
    Str tf = dir + "/attest/" + hex_encode(e.party[0..16]);
    Option(OrgAttestChallenge) och = attchal_of(blob_get(o.x.ep, att_blob("attchal", e.org_id, e.party)) else { [] });
    Bool mine = match och { None => false, Some(ch) => bytes_eq(ch.by_log, o.x.c.log_id) && filesystem.exists(tf + ".tok") };
    if (!mine) { return challenge_device(o, e, tf); }
    Option(OrgAttestResponse) orr = attresp_of(blob_get(o.x.ep, att_blob("attresp", e.org_id, e.party)) else { [] });
    return match orr {
        None => Ok("waiting"),
        Some(r) => verify_response(o, e, d, och else { OrgAttestChallenge {.org_id = [], .party = [], .blob = [], .secret = [], .value = [], .by_log = [], .signer = [], .sig = []} }, r, tf, h)
    };
}

@requires(filesystem, network, device, declassify, clock, provision, environment)
Result(Str, Str) challenge_device(OrgCtx o, OrgAttestEvidence e, Str tf) {
    ChallengeRecord c = challenge_issue(32, [], 2592000);
    TpmCredential cred = match tpm_ak_challenge(u8b(e.ek_cert), u8b(e.ak_public), c) { Ok(x) => x, Err(ve) => TpmCredential {.blob = [], .secret = []} };
    if (cred.blob.len() == 0) { return Err("the EK certificate or the AK cannot take a credential"); }
    List(Int) value = intb(challenge_value(c));
    List(UInt(8)) tok = match challenge_export(c, export_key(att_export_key(o.x.u))) { Ok(t) => t, Err(ce) => [] };
    if (tok.len() == 0 || !filesystem.write_secret(tf + ".tok", intb(tok))) { return Err("cannot keep the challenge"); }
    OrgAttestChallenge ch0 = OrgAttestChallenge {.org_id = e.org_id, .party = e.party, .blob = cred.blob, .secret = cred.secret, .value = value,
                                                 .by_log = o.x.c.log_id, .signer = o.x.c.party, .sig = []};
    List(Int) sig = dk_sign(o.x.c, o.x.u.real, o.x.u.st, attchal_tbs(ch0))?;
    if (!blob_put(o.x.ep, att_blob("attchal", e.org_id, e.party), cbor_or_empty(to_cbor(attchal_signed(ch0, sig))))) { return Err("the relay refused the challenge"); }
    return Ok("challenged");
}

@requires(filesystem, network, device, declassify, clock, provision, environment)
Result(Str, Str) verify_response(OrgCtx o, OrgAttestEvidence e, Party d, OrgAttestChallenge ch, OrgAttestResponse r, Str tf, VerifiedHead h) {
    if (!signed_by(h, r.log_sequence, r.signer, attresp_tbs(r), r.sig) || !bytes_eq(r.signer, e.party)) { return Err("the response is not signed by its device"); }
    if (str_trim(filesystem.read_all(tf + ".used")) == "1") { return Err("the challenge was spent: the device sends new evidence"); }
    _ = filesystem.write_all(tf + ".used", "1");
    Result(Imported(MemSpentStore), ChallengeError) im = challenge_import(u8b(filesystem.read_bytes(tf + ".tok")), export_key(att_export_key(o.x.u)), mem_spent_store());
    return match im {
        Err(ce) => Err("the challenge: " + challenge_error_text(ce)),
        Ok(imp) => match tpm_verify_ak(u8s_all([e.ek_cert].concat(e.ek_chain), 0, ListBuf()), u8s_all(e.crls, 0, ListBuf()), u8b(e.ak_public), u8b(r.activated), imp.record, tpm_ek_roots(), kernel_time()) {
            Err(ve) => Err(verify_error_text(ve)),
            Ok(v) => match dk_certified(DkEvidence {.attest = u8b(r.attest), .sig = u8b(r.attest_sig), .dk_public = u8b(r.dk_public)}, u8b(e.ak_public), d.auth_key, ch.value, e.log_id) {
                Err(se) => Err(err_text(se)),
                Ok(_) => Ok("attested")
            }
        }
    };
}

List(List(UInt(8))) u8s_all(List(List(Int)) xs, Int i, ListBuf(List(UInt(8))) acc) { return if (i >= xs.len()) { acc.finish() } else { u8s_all(xs, i + 1, acc.push(u8b(xs[i]))) }; }
