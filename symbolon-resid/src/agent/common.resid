// Helpers shared by the device and the cosigner agents: files, keys derived
// from a profile's DEK, software signing keys, and encodings of the stored
// objects.

import "../types.resid";
import "../core/log.resid";
import "../core/event_decode.resid";
import "../vault/vault.resid";
import "../net/proto.resid";
import "../net/services.resid";
import "state.resid";
import "serials.resid";
import "cggmp_store.resid";
import "sha256g.resid";
import "hpkeg.resid";
import "word.resid";
import "ecdsa.resid";
import "crypto.resid";
import "cbor.resid";
import "boxseal.resid";

pub List(Int) ints(List(UInt(8)) b) { return ints_at(b, 0, ListBuf()); }
List(Int) ints_at(List(UInt(8)) b, Int i, ListBuf(Int) acc) {
    if (i >= b.len()) { return acc.finish(); }
    return ints_at(b, i + 1, acc.push((Int)b[i]));
}

@requires(declassify)
pub List(Int) reveal(List(Secret(UInt(8))) s) { return ints(declassify(secret_join(s), "agent: value published by design")); }

pub List(Secret(UInt(8))) hk(List(Secret(UInt(8))) ikm, Str label, Int n) {
    List(Secret(UInt(8))) nil = [];
    return hkdf256g_expand(hkdf256g_extract(nil, ikm), secret_bytes(utf8(label)), n);
}

// The device's share-transport (HPKE) key pairs, from its DEK (SPEC 9.2).
// v1 is the key devices made before the security update: its 32-byte seed
// was also the duress profile's `share` field, so whoever opens the duress
// profile holds it. v2 comes from a label the duress profile never had;
// new devices start with it, and `device security-update` moves an older
// device to it with a party-key log event (SPEC 8.1).
@requires(declassify)
pub HpkeKeyPairG(Secret(UInt(8))) device_hpke(List(Secret(UInt(8))) dek) { return hpkeg_derive_keypair(16, hk(dek, "symbolon v1 device hpke", 32)); }

@requires(declassify)
pub HpkeKeyPairG(Secret(UInt(8))) device_hpke2(List(Secret(UInt(8))) dek) { return hpkeg_derive_keypair(16, hk(dek, "symbolon v2 device hpke", 32)); }

// The key the device's configuration (and its log entry) names: v2 once
// moved, else v1. Envelopes and wraps this device sends use it.
@requires(declassify)
pub HpkeKeyPairG(Secret(UInt(8))) device_transport(DeviceConfig c, List(Secret(UInt(8))) dek) {
    HpkeKeyPairG(Secret(UInt(8))) k2 = device_hpke2(dek);
    return if (bytes_eq(c.hpke_pub, k2.pk)) { k2 } else { device_hpke(dek) };
}

// The keys a wrap made to this device may be addressed to, the current one
// first: after the move, wraps others made to v1 still open under the PIN
// until they are made again (SPEC 19.2). Never under the duress PIN.
@requires(declassify)
pub List(List(Secret(UInt(8)))) device_open_keys(DeviceConfig c, List(Secret(UInt(8))) dek) {
    HpkeKeyPairG(Secret(UInt(8))) k2 = device_hpke2(dek);
    HpkeKeyPairG(Secret(UInt(8))) k1 = device_hpke(dek);
    return if (bytes_eq(c.hpke_pub, k2.pk)) { [k2.sk, k1.sk] } else { [k1.sk] };
}

// A software ECDSA key from a 32-byte secret (the unprotected profile's
// DK, a cosigner's DK, a duress sub-key).
pub List(Secret(UInt(8))) software_key(List(Secret(UInt(8))) root, Str label) { return hk(root, label, 32); }

@requires(declassify)
pub List(Int) sw_public(List(Secret(UInt(8))) priv) { return ec_public_keyg(P256, priv); }

@requires(declassify)
pub List(Int) sw_sign(List(Secret(UInt(8))) priv, List(Int) msg) { return ecdsag_sign_raw(P256, Sha256, priv, msg); }

pub List(Int) party_of_key(List(Int) auth_key) { return sha256_bytes(auth_key); }

// ─── Files ───────────────────────────────────────────────────────

// Mode 0600; on a sealed Symbolon Home box, sealed under the box key in
// memory, and opened again by get_file (boxseal.resid). Elsewhere a plain
// write and read.
@requires(filesystem)
pub Bool put_secret_file(Str path, List(Int) b) { return seal_put(path, b); }

@requires(filesystem)
pub List(Int) get_file(Str path) { return seal_get(path); }

pub List(Int) cbor_of_device(DeviceConfig c) { return match to_cbor(c) { Ok(b) => b, Err(_) => [] }; }
pub Option(DeviceConfig) device_of_cbor(List(Int) b) {
    if (!cbor_well_formed(b, 16)) { return None; }
    Result(DeviceConfig, SerialError) r = from_cbor(b);
    return match r { Ok(x) => Some(x), Err(_) => None };
}

pub List(Int) cbor_of_cosigner(CosignerConfig c) { return match to_cbor(c) { Ok(b) => b, Err(_) => [] }; }
pub Option(CosignerConfig) cosigner_of_cbor(List(Int) b) {
    if (!cbor_well_formed(b, 16)) { return None; }
    Result(CosignerConfig, SerialError) r = from_cbor(b);
    return match r { Ok(x) => Some(x), Err(_) => None };
}

pub List(Int) cbor_of_state(CosignerState s) { return match to_cbor(s) { Ok(b) => b, Err(_) => [] }; }
pub Option(CosignerState) state_of_cbor(List(Int) b) {
    if (!cbor_well_formed(b, 24)) { return None; }
    Result(CosignerState, SerialError) r = from_cbor(b);
    return match r { Ok(x) => Some(x), Err(_) => None };
}

pub List(Int) cbor_of_event(StoredEvent e) { return match to_cbor(e) { Ok(b) => b, Err(_) => [] }; }
pub Option(StoredEvent) event_of_cbor(List(Int) b) {
    if (b.len() > 1048576 || !cbor_well_formed(b, 16)) { return None; }
    Result(StoredEvent, SerialError) r = from_cbor(b);
    return match r { Ok(x) => Some(x), Err(_) => None };
}

pub List(Int) cbor_of_keys(PartyKeys k) { return match to_cbor(k) { Ok(b) => b, Err(_) => [] }; }
pub Option(PartyKeys) keys_of_cbor(List(Int) b) {
    if (!cbor_well_formed(b, 8)) { return None; }
    Result(PartyKeys, SerialError) r = from_cbor(b);
    return match r { Ok(x) => Some(x), Err(_) => None };
}

pub List(Int) cbor_of_blob(WrappedBlob w) { return match to_cbor(w) { Ok(b) => b, Err(_) => [] }; }
pub Option(WrappedBlob) blob_of_cbor(List(Int) b) {
    if (!cbor_well_formed(b, 8)) { return None; }
    Result(WrappedBlob, SerialError) r = from_cbor(b);
    return match r { Ok(x) => Some(x), Err(_) => None };
}

// ─── The log ─────────────────────────────────────────────────────

pub Option(SignedEvent) signed_of(StoredEvent s) {
    Option(EventPayload) p = payload_decode(s.encoded);
    return match p { None => None, Some(x) => Some(SignedEvent {.payload = x, .encoded = s.encoded, .sigs = s.sigs, .cosigs = s.cosigs}) };
}

// The whole log `l` from the relay, from sequence 0 until the first gap.
@requires(network, clock(readonly), declassify)
pub List(SignedEvent) fetch_log(Endpoint relay, List(Int) l, UInt(64) seq, List(SignedEvent) acc) {
    Option(List(Int)) b = log_get(relay, l, seq);
    return match b {
        None => acc,
        Some(x) => match event_of_cbor(x) {
            None => acc,
            Some(se) => match signed_of(se) { None => acc, Some(e) => fetch_log(relay, l, seq + 1, acc.concat([e])) }
        }
    };
}

// The raw events of log `l` from `seq` until the first gap, as the relay
// returned them (for the local copy below), and whether the relay itself
// said where the log ends (a 404 for the next event). A fetch cut short by
// a dead link or a refusal has `ended` false: the copy then says nothing
// about whether the log has moved on.
pub type Fetched = { List(List(Int)) evs; Bool ended; };

@requires(network, clock(readonly), declassify)
Fetched fetch_raw(Endpoint relay, List(Int) l, UInt(64) seq, List(List(Int)) acc) {
    HttpOut o = log_get_out(relay, l, seq);
    if (o.status != 200) { return Fetched {.evs = acc, .ended = o.status == 404}; }
    return match event_of_cbor(o.body) {
        None => Fetched {.evs = acc, .ended = false},
        Some(se) => match signed_of(se) { None => Fetched {.evs = acc, .ended = false}, Some(_) => fetch_raw(relay, l, seq + 1, acc.concat([o.body])) }
    };
}

// The raw events of log `l` from 0 until the first gap (each as the relay
// stores it): what a device shows the witnesses before the next event.
@requires(network, clock(readonly), declassify)
pub List(List(Int)) log_raw(Endpoint relay, List(Int) l) { return fetch_raw(relay, l, (UInt(64))0, []).evs; }

// Whether `e` may be stored at sequence `seq` of log `l` after `before`
// (the log as stored, from E0): the log with `e` verifies, `e`'s own
// witness co-signatures included (SPEC 8.3); at 0, `e` is an inception whose
// digest is `l`. The relay's test for a log write (relaysrv.resid).
pub Bool log_next_ok(List(Int) l, List(SignedEvent) before, SignedEvent e, Int seq) {
    if (before.len() != seq || (Int)e.payload.sequence != seq) { return false; }
    // Verified as of the end of time: every check of every event uses its
    // own witness time; `now` only decides what is still pending at the head.
    return match il_verify(l, before.concat([e]), 4611686018427387904, lambda(x) { false }) { Ok(_) => true, Err(_) => false };
}

pub List(SignedEvent) events_of_raw(List(List(Int)) rs, Int i, List(SignedEvent) acc) {
    if (i >= rs.len()) { return acc; }
    Option(StoredEvent) se = event_of_cbor(rs[i]);
    Option(SignedEvent) e = match se { None => None, Some(x) => signed_of(x) };
    return match e { None => acc, Some(x) => events_of_raw(rs, i + 1, acc.concat([x])) };
}

// This device's copy of a log's events it has verified, from 0 until the
// first missing one.
@requires(filesystem)
pub List(List(Int)) cached_raw(Str cd, Int seq, List(List(Int)) acc) {
    Str f = cd + "/" + f"{seq}";
    if (!filesystem.exists(f)) { return acc; }
    List(Int) b = filesystem.read_bytes(f);
    return if (b.len() == 0) { acc } else { cached_raw(cd, seq + 1, acc.concat([b])) };
}

@requires(filesystem)
Bool cache_from(Str cd, List(List(Int)) rs, Int i) {
    if (i >= rs.len()) { return true; }
    if (!filesystem.write_bytes(cd + "/" + f"{i}", rs[i])) { return false; }
    return cache_from(cd, rs, i + 1);
}

// The log verified now, as verified_log, fetching from the relay only the
// events after those this device has already verified (DIR/logcache/<log>/):
// a log only grows, and every event, kept or new, is verified again here,
// so the copy saves round trips, not checks. A relay that serves fewer
// events than the copy holds cannot roll the log back. If the copy and the
// relay's events do not verify together, the whole log is fetched again,
// and taken only if it holds every kept event, unchanged, at its sequence,
// and verifies (SPEC 8.4): a shorter log or one that differs from the copy
// is a fork or a rollback, refused, never a reason to forget what was seen.
@requires(filesystem, network, clock(readonly), declassify)
pub Result(VerifiedHead, SymbolonError) verified_log_dir(Str dir, Endpoint relay, List(Int) l) {
    Result(LogView, SymbolonError) r = log_view_dir(dir, relay, l, "");
    return match r { Ok(v) => Ok(v.vh), Err(e) => Err(e) };
}

// A verified head with the events it was verified from (one fetch: the
// events are those the head describes).
pub type LogView = { VerifiedHead vh; List(SignedEvent) events; };

// As verified_log_dir, with the events; the witnesses reached at `here`
// when it is set (verified_log_at). The log is the relay's, extended by
// what the witnesses co-signed past it (log_seen).
@requires(filesystem, network, clock(readonly), declassify)
pub Result(LogView, SymbolonError) log_view_dir(Str dir, Endpoint relay, List(Int) l, Str here) {
    Result(WitnessedView, SymbolonError) r = log_seen(dir, relay, l, here);
    return match r { Ok(s) => Ok(s.view), Err(e) => Err(e) };
}

// The log as this device verified it from the relay (relay_view_dir), then
// held against the witnesses (SPEC 13.4 "Notification", R5-1): every
// witness of its policy is asked how far it co-signed the log (POST /head),
// and the events a majority co-signed past what the relay serves are taken
// from the witnesses themselves (POST /event, witness_fill). A relay that
// keeps an event from the devices (a recovery the kit filed, a veto) cannot
// keep it from the witnesses that co-signed it, so it cannot keep it from
// the devices either.
@requires(filesystem, network, clock(readonly), declassify)
pub Result(WitnessedView, SymbolonError) log_seen(Str dir, Endpoint relay, List(Int) l, Str here) {
    Result(LogView, SymbolonError) r = relay_view_dir(dir, relay, l, here);
    return match r { Err(e) => Err(e), Ok(v) => Ok(witness_fill(dir, relay, l, here, v)) };
}

// As log_seen, and when the relay does not answer, or serves no log that
// verifies with this device's kept copy, from the kept copy alone held
// against the witnesses: what a device vetoes from, and what the cosigner
// takes and publishes a veto from (R5-1), so that a relay that serves a
// short log, an error or a fork cannot keep a veto from the witnesses.
@requires(filesystem, network, clock(readonly), declassify)
pub Result(WitnessedView, SymbolonError) log_seen_any(Str dir, Endpoint relay, List(Int) l, Str here) {
    Result(WitnessedView, SymbolonError) r = log_seen(dir, relay, l, here);
    if (match r { Ok(_) => true, Err(_) => false }) { return r; }
    List(SignedEvent) kept = events_of_raw(cached_raw(dir + "/logcache/" + hex_encode(l), 0, []), 0, []);
    if (kept.len() == 0) { return r; }
    Result(VerifiedHead, SymbolonError) vk = verified_events(l, kept, relay.ca, here);
    return match vk {
        Err(_) => r,
        Ok(vh) => Ok(witness_fill(dir, relay, l, here, LogView {.vh = vh, .events = kept}))
    };
}

// The relay's log verified with this device's kept copy (verified_log_dir).
@requires(filesystem, network, clock(readonly), declassify)
Result(LogView, SymbolonError) relay_view_dir(Str dir, Endpoint relay, List(Int) l, Str here) {
    Str cd = dir + "/logcache/" + hex_encode(l);
    List(List(Int)) kept = cached_raw(cd, 0, []);
    // The witnesses the kept log names are asked while the rest of the log
    // is fetched; their answer is used only if the log still names them.
    List(WitnessRef) ws0 = policy_of_e0(events_of_raw(kept, 0, [])).witnesses;
    List(WitnessRef) ask0 = witnesses_at(ws0, here);
    List(Int) nonce = random_bytes(32);
    Result(Int, RegionError) early = spawn (network, clock(readonly), declassify) { return if (ask0.len() == 0) { 0 } else { witness_now(ask0, relay.ca, nonce) }; };
    Fetched got = fetch_raw(relay, l, (UInt(64))kept.len(), kept);
    List(List(Int)) all = got.evs;
    Int now0 = match early { Ok(t) => t, Err(_) => 0 };
    // The kept copy alone proves nothing current: unless the relay said
    // where the log ends, it is as if the log could not be fetched.
    if (!got.ended) { return Err(ErrInvalidLog("no log at the relay")); }
    List(SignedEvent) es = events_of_raw(all, 0, []);
    Result(VerifiedHead, SymbolonError) r = verified_events_now(l, es, relay.ca, ws0, now0, here);
    if (match r { Ok(_) => true, Err(_) => false }) {
        _ = filesystem.create_dir(dir + "/logcache");
        _ = filesystem.create_dir(cd);
        _ = cache_from(cd, all, kept.len());
        return view_of(r, es);
    }
    if (kept.len() == 0) { return view_of(r, es); }
    Fetched fr = fetch_raw(relay, l, (UInt(64))0, []);
    List(List(Int)) fresh = fr.evs;
    if (!fr.ended) { return Err(ErrInvalidLog("no log at the relay")); }
    if (!extends_kept(kept, fresh, 0)) { return Err(ErrInvalidLog("the relay's log does not extend the events already verified: a fork or a rollback (SPEC 8.4)")); }
    List(SignedEvent) fes = events_of_raw(fresh, 0, []);
    Result(VerifiedHead, SymbolonError) r2 = verified_events(l, fes, relay.ca, here);
    if (match r2 { Ok(_) => true, Err(_) => false }) { _ = cache_from(cd, fresh, 0); }
    return view_of(r2, fes);
}

Result(LogView, SymbolonError) view_of(Result(VerifiedHead, SymbolonError) r, List(SignedEvent) es) {
    return match r { Ok(vh) => Ok(LogView {.vh = vh, .events = es}), Err(e) => Err(e) };
}

// Whether `fresh` holds every event of `kept`, the same signed bytes at the
// same sequence (their signatures and co-signatures may differ).
pub Bool extends_kept(List(List(Int)) kept, List(List(Int)) fresh, Int i) {
    if (i >= kept.len()) { return true; }
    if (i >= fresh.len()) { return false; }
    List(Int) a = encoded_of(kept[i]);
    List(Int) b = encoded_of(fresh[i]);
    return a.len() > 0 && bytes_eq(a, b) && extends_kept(kept, fresh, i + 1);
}

List(Int) encoded_of(List(Int) raw) { return match event_of_cbor(raw) { Some(se) => se.encoded, None => [] }; }

// The median witness time of the last event: the `now` a freshly fetched
// log is verified at.
pub Int last_time(List(SignedEvent) es, Policy pol) {
    if (es.len() == 0) { return 0; }
    SignedEvent e = es[es.len() - 1];
    return match witness_time(e.cosigs, pol, e.payload.log_id else { sha256_bytes(e.encoded) }, e.payload.sequence, sha256_bytes(e.encoded)) { Ok(t) => t, Err(_) => 0 };
}

pub Policy policy_of_e0(List(SignedEvent) es) {
    if (es.len() == 0) { return Policy {.device_sigs_for_authority = 0, .recovery_delay_sec = 0, .guardians = [], .guardian_threshold = 0, .witnesses = [], .duress_window_sec = 0, .sequencer = [], .cosigner_policy = NoCosignerPolicy}; }
    EventBody b = es[0].payload.body;
    return match b { InceptionBody(_, p) => p, _ => Policy {.device_sigs_for_authority = 0, .recovery_delay_sec = 0, .guardians = [], .guardian_threshold = 0, .witnesses = [], .duress_window_sec = 0, .sequencer = [], .cosigner_policy = NoCosignerPolicy} };
}

// The log verified now (SPEC 8.3): fetched, verified once at the witness
// time of its last event to learn its policy, then again at the current
// witness time, the median of what the policy's witnesses sign for a fresh
// nonce (never this machine's clock: a delay runs by witness time, SPEC
// 13.4). Guardian approvals are not accepted yet.
@requires(network, clock(readonly), declassify)
pub Result(VerifiedHead, SymbolonError) verified_log(Endpoint relay, List(Int) l) { return verified_log_at(relay, l, ""); }

// As verified_log, reaching the witnesses at `here` (their ports kept)
// when it is set: a cosigner on a Symbolon Home box, which may not reach
// the box at the address its devices use.
@requires(network, clock(readonly), declassify)
pub Result(VerifiedHead, SymbolonError) verified_log_at(Endpoint relay, List(Int) l, Str here) { return verified_events(l, fetch_log(relay, l, 0, []), relay.ca, here); }

Bool same_witnesses(List(WitnessRef) a, List(WitnessRef) b, Int i) {
    if (a.len() != b.len()) { return false; }
    if (i >= a.len()) { return true; }
    if (a[i].url != b[i].url || hex_encode(a[i].key) != hex_encode(b[i].key)) { return false; }
    return same_witnesses(a, b, i + 1);
}

// As verified_events, with a witness time `now0` already asked of the
// witnesses `ws0`: used when the log's policy still names exactly those
// witnesses and they answered, else the witnesses are asked now.
@requires(network, clock(readonly), declassify)
Result(VerifiedHead, SymbolonError) verified_events_now(List(Int) l, List(SignedEvent) es, Str ca, List(WitnessRef) ws0, Int now0, Str here) {
    if (es.len() == 0) { return Err(ErrInvalidLog("no log at the relay")); }
    Int t = last_time(es, policy_of_e0(es));
    Result(VerifiedHead, SymbolonError) v0 = il_verify(l, es, t, lambda(p) { false });
    return match v0 {
        Err(e) => Err(e),
        Ok(vh) => il_verify(l, es, at_least(if (now0 > 0 && same_witnesses(vh.head.policy.witnesses, ws0, 0)) { now0 } else { witness_now(witnesses_at(vh.head.policy.witnesses, here), ca, random_bytes(32)) }, t), lambda(p) { false })
    };
}

// The events of log `l`, however they were fetched, verified now; `ca`
// as Endpoint.ca for the witnesses.
@requires(network, clock(readonly), declassify)
pub Result(VerifiedHead, SymbolonError) verified_events(List(Int) l, List(SignedEvent) es, Str ca, Str here) {
    if (es.len() == 0) { return Err(ErrInvalidLog("no log at the relay")); }
    Int t = last_time(es, policy_of_e0(es));
    Result(VerifiedHead, SymbolonError) v0 = il_verify(l, es, t, lambda(p) { false });
    return match v0 {
        Err(e) => Err(e),
        Ok(vh) => il_verify(l, es, at_least(witness_now(witnesses_at(vh.head.policy.witnesses, here), ca, random_bytes(32)), t), lambda(p) { false })
    };
}

// The witnesses as a process on a Symbolon Home box reaches them. `here`
// is "" (as the policy names them), "HOST" (every witness at HOST, on its
// port: a box that runs all of them), or "HOST KEY..." (KEY: a witness
// public key, hex): only the witnesses with those keys, the box's own, are
// at HOST; the others, outside the box, at their own addresses.
//
// Each witness key once (core/log.resid witnesses_distinct, R5-3): a
// policy from before the release cutover may name a key at two addresses,
// and every majority counted over this list is a majority of witnesses.
pub List(WitnessRef) witnesses_at(List(WitnessRef) ws0, Str here) {
    List(WitnessRef) ws = witnesses_distinct(ws0);
    List(Str) parts = str_split(str_trim(here), " ");
    if (str_len(str_trim(here)) == 0) { return ws; }
    return witnesses_local(ws, parts[0], lower_keys(parts, 1, ListBuf()), 0, ListBuf());
}

List(Str) lower_keys(List(Str) ps, Int i, ListBuf(Str) acc) {
    if (i >= ps.len()) { return acc.finish(); }
    return lower_keys(ps, i + 1, if (str_len(ps[i]) > 0) { acc.push(str_to_lower(ps[i])) } else { acc });
}

List(WitnessRef) witnesses_local(List(WitnessRef) ws, Str host, List(Str) keys, Int i, ListBuf(WitnessRef) acc) {
    if (i >= ws.len()) { return acc.finish(); }
    List(Str) p = str_split(ws[i].url, ":");
    Bool here = keys.len() == 0 || keys.contains(str_to_lower(hex_encode(ws[i].key)));
    Str url = if (here && p.len() >= 2) { host + ":" + p[p.len() - 1] } else { ws[i].url };
    return witnesses_local(ws, host, keys, i + 1, acc.push(WitnessRef {.url = url, .key = ws[i].key}));
}

Int at_least(Int a, Int b) { return if (a > b) { a } else { b }; }

// The median of the witnesses' signed times, or 0 when fewer than a
// majority answer.
@requires(network, clock(readonly), declassify)
pub Int witness_now(List(WitnessRef) ws0, Str ca, List(Int) nonce) {
    // Each witness key once (R5-3): a majority of distinct witnesses.
    List(WitnessRef) ws = witnesses_distinct(ws0);
    List(Int) ts = sort(witness_times_par(ws, ca, nonce));
    if (ts.len() * 2 <= ws.len()) { return 0; }
    return ts[(ts.len() - 1) / 2];
}

// The witnesses asked three at once, each in its own region (a region
// bound to a name runs while this goes on and is waited for where it is
// used). Over a slow link this is one round of connections instead of
// three. No batch is started once witness_deadline_secs() have passed
// (R3P-4: a log may name 32 witnesses that never answer): the ones left
// count as not answering.
@requires(network, clock(readonly), declassify)
List(Int) witness_times_par(List(WitnessRef) ws, Str ca, List(Int) nonce) {
    List(Int) ts = times_batched(ws, ca, nonce, 0, [], clock_now_seconds() + witness_deadline_secs());
    return ts;
}

// How long one round of witness calls may go on starting new calls.
pub Int witness_deadline_secs() { return 20; }

@requires(network, clock(readonly), declassify)
List(Int) times_batched(List(WitnessRef) ws, Str ca, List(Int) nonce, Int i, List(Int) acc, Int until) {
    if (i >= ws.len() || (i > 0 && clock_now_seconds() > until)) { return acc; }
    Result(Option(Int), RegionError) a = spawn (network, clock(readonly), declassify) { return time_of(ws, i, ca, nonce); };
    Result(Option(Int), RegionError) b = spawn (network, clock(readonly), declassify) { return time_of(ws, i + 1, ca, nonce); };
    Result(Option(Int), RegionError) c = spawn (network, clock(readonly), declassify) { return time_of(ws, i + 2, ca, nonce); };
    List(Int) here = got(a).concat(got(b)).concat(got(c));
    return times_batched(ws, ca, nonce, i + 3, acc.concat(here), until);
}

List(Int) got(Result(Option(Int), RegionError) r) {
    return match r { Err(_) => [], Ok(o) => match o { None => [], Some(t) => [t] } };
}

@requires(network, clock(readonly), declassify)
Option(Int) time_of(List(WitnessRef) ws, Int i, Str ca, List(Int) nonce) {
    if (i >= ws.len()) { return None; }
    Option(Endpoint) oe = endpoint_of_url(ws[i].url, ca);
    return match oe { None => None, Some(e) => time_from(e, ws[i].key, nonce) };
}

// host:port of an http(s)://host:port URL; TLS under `ca` when it is set
// (one trust anchor for the relay and the witnesses, from the config).
// Read through core/log.resid witness_addr, the address the weakening
// test compares (R5-5): two spellings that test takes for one witness
// ("HTTPS://H:P", " h:p") reach the same host and port. A policy names
// canonical URLs only (witness_url_ok) from the release cutover on; this
// keeps the two in step for the policies from before it as well.
pub Option(Endpoint) endpoint_of_url(Str u, Str ca) {
    Str hp = witness_addr(u);
    List(Str) parts = str_split(hp, ":");
    return if (parts.len() == 2) { Some(Endpoint {.host = parts[0], .port = str_parse_int(parts[1]), .ca = ca, .token = ""}) } else { None };
}

// Whether a policy's witnesses include one at a loopback, private,
// link-local or otherwise internal address, by its URL (R3P-4): a relay
// asks a log's witnesses for the time and to co-sign, and anyone can make
// a log naming any URLs, so it calls such a host only when started to
// (relay serve --allow-private-witnesses), or one named in `allowed`
// (HOST:PORT, comma-separated: --allow-witness, the household box's own
// witnesses). A host name is judged as written: one that resolves to an
// internal address is not caught here.
pub Bool witnesses_private(List(WitnessRef) ws, Str allowed) {
    if (ws.len() == 0) { return false; }
    Option(Endpoint) oe = endpoint_of_url(ws[0].url, "");
    Bool here = match oe { None => false, Some(e) => host_private(e.host) && !str_split(allowed, ",").contains(str_to_lower(e.host) + f":{e.port}") };
    return here || witnesses_private(ws[1..ws.len()], allowed);
}

// "localhost" and its subdomains, ".local", ".internal", and IPv4
// literals in 0/8, 10/8, 100.64/10, 127/8, 169.254/16, 172.16/12,
// 192.168/16 and 224/3; a numeric host in any other form than four
// decimal octets is refused as well (resolvers read "2130706433" or
// "0x7f.1" as 127.0.0.1).
pub Bool host_private(Str host) {
    Str h = str_to_lower(host);
    if (str_len(h) == 0 || h == "localhost" || str_ends_with(h, ".localhost") || str_ends_with(h, ".local") || str_ends_with(h, ".internal")) { return true; }
    List(Str) ls = str_split(h, ".");
    Str last = ls[ls.len() - 1];
    Bool numeric = all_digits(last, 0) || (str_len(last) > 1 && str_slice(last, 0, 2) == "0x");
    if (!numeric) { return false; }
    if (ls.len() != 4 || !octets_ok(ls, 0)) { return true; }
    Int a = str_parse_int(ls[0]);
    Int b = str_parse_int(ls[1]);
    return a == 0 || a == 10 || a == 127 || a >= 224 || (a == 100 && b >= 64 && b < 128) || (a == 169 && b == 254) || (a == 172 && b >= 16 && b < 32) || (a == 192 && b == 168);
}

Bool all_digits(Str s, Int i) {
    if (str_len(s) == 0) { return false; }
    if (i >= str_len(s)) { return true; }
    Int c = str_char_at(s, i);
    return c >= 48 && c <= 57 && all_digits(s, i + 1);
}

// Four decimal octets 0..255, without leading zeros.
Bool octets_ok(List(Str) ls, Int i) {
    if (i >= ls.len()) { return true; }
    Str o = ls[i];
    Bool ok = all_digits(o, 0) && str_len(o) <= 3 && (str_len(o) == 1 || str_char_at(o, 0) != 48) && str_parse_int(o) <= 255;
    return ok && octets_ok(ls, i + 1);
}

// ─── How far the witnesses co-signed a log (SPEC 20.3, POST /head) ──

// A witness's answer to POST /head (agent/witnesssrv.resid): CBOR [seq,
// digest, time, r || s], checked under its key `wkey` for log `l` and
// `nonce` (core/log.resid head_message). None when it does not parse or
// verify.
pub Option(WitnessHead) head_answer(List(Int) b, List(Int) wkey, List(Int) l, List(Int) nonce) {
    Rd a = rd(b, 0);
    if (a.major != 4 || a.val != 4) { return None; }
    Rd s = rd(b, a.next);
    Rd dh = rd(b, s.next);
    if (s.major != 0 || dh.major != 2 || (dh.val != 0 && dh.val != 32) || dh.next + dh.val > b.len()) { return None; }
    List(Int) d = b[dh.next..dh.next + dh.val];
    Rd t = rd(b, dh.next + dh.val);
    Rd sh = rd(b, t.next);
    if (t.major != 0 || sh.major != 2 || sh.val != 64 || sh.next + 64 != b.len()) { return None; }
    if (d.len() == 0 && s.val != 0) { return None; }
    List(Int) sig = b[sh.next..b.len()];
    if (!ecdsa_verify_raw(P256, Sha256, wkey, head_message(l, s.val, d, nonce, t.val), sig)) { return None; }
    return Some(WitnessHead {.seq = s.val, .digest = d, .time = t.val});
}

@requires(network, clock(readonly), declassify)
Option(WitnessHead) head_from(Endpoint e, List(Int) wkey, List(Int) l, List(Int) nonce) {
    HttpOut o = http_call_ep(e, "POST", "/head", nonce.concat(l));
    Option(WitnessHead) h = if (o.status == 200) { head_answer(o.body, wkey, l, nonce) } else { None };
    return h;
}

// Every witness's verified answer for log `l` and one fresh nonce, in the
// order of `ws` (None for a witness that did not answer).
@requires(network, clock(readonly), declassify)
pub List(Option(WitnessHead)) witness_heads(List(WitnessRef) ws, Str ca, List(Int) l) {
    List(Option(WitnessHead)) hs = heads_from(ws, ca, l, random_bytes(32), 0, [], clock_now_seconds() + witness_deadline_secs());
    return hs;
}

// Each witness asked in turn; after `until` the rest count as not
// answering (R3P-4), which every user of the answers treats as failing
// closed.
@requires(network, clock(readonly), declassify)
List(Option(WitnessHead)) heads_from(List(WitnessRef) ws, Str ca, List(Int) l, List(Int) nonce, Int i, List(Option(WitnessHead)) acc, Int until) {
    if (i >= ws.len()) { return acc; }
    Option(Endpoint) oe = if (i > 0 && clock_now_seconds() > until) { None } else { endpoint_of_url(ws[i].url, ca) };
    Option(WitnessHead) h = match oe { None => None, Some(e) => head_from(e, ws[i].key, l, nonce) };
    return heads_from(ws, ca, l, nonce, i + 1, acc.concat([h]), until);
}

// Whether the head `vh` is the log's head as a majority of its policy's
// witnesses know it (core/log.resid heads_problem): "" when it is, else
// why not. What the cosigner requires before it releases the kit's half or
// deals a re-share (R2W-5), so a relay that serves the log cut before a
// veto gets nothing. `here` as for verified_log_at.
@requires(network, clock(readonly), declassify)
pub Str witness_head_check(VerifiedHead vh, Str ca, Str here) {
    List(WitnessRef) ws = witnesses_at(vh.head.policy.witnesses, here);
    List(Option(WitnessHead)) hs = witness_heads(ws, ca, vh.head.log_id);
    Str why = heads_problem(hs, ws.len(), (Int)vh.head.sequence, vh.head.digest);
    return why;
}

// After the witnesses refused an event at `seq` (R2W-2): the freeze alarm
// when no event can get a majority there any more, else "".
@requires(network, clock(readonly), declassify)
pub Str freeze_check(List(WitnessEp) ws, Str ca, List(Int) l, UInt(64) seq) {
    List(WitnessRef) rs = witnesses_distinct(refs_of_eps(ws, 0, []));
    Str why = freeze_problem(witness_heads(rs, ca, l), rs.len(), (Int)seq);
    return why;
}

pub List(WitnessRef) refs_of_eps(List(WitnessEp) ws, Int i, List(WitnessRef) acc) {
    if (i >= ws.len()) { return acc; }
    return refs_of_eps(ws, i + 1, acc.concat([WitnessRef {.url = ws[i].host + ":" + f"{ws[i].port}", .key = ws[i].key}]));
}

// ─── What the witnesses co-signed past the relay (R5-1) ─────────

// A log view held against the witnesses (log_seen): `view`, the log with
// the events a majority of its witnesses co-signed past the relay's;
// `fetched`, how many of those came from the witnesses; `hidden`, how many
// of them the relay still does not serve after this device gave them to it
// (the alarm: the relay may be hiding them); `loose`, the events some
// witness co-signed at the sequence after `view` that no majority holds
// (a veto that reached too few witnesses, or one being co-signed now).
pub type WitnessedView = { LogView view; Int fetched; Int hidden; List(SignedEvent) loose; };

// One witness's answer to POST /event (agent/witnesssrv.resid): the event
// it co-signed at (log, seq), without co-signatures, and its co-signature.
pub type WitEvent = { SignedEvent e; WitnessCosignature cs; };

// At most this many events are taken from the witnesses per view.
pub Int max_fill() { return 32; }

// POST /event's body: the log id, then the sequence (8 bytes, big-endian).
pub List(Int) event_query(List(Int) l, Int seq) { return l.concat(seq_be8(seq, 8, [])); }

List(Int) seq_be8(Int v, Int n, List(Int) acc) {
    if (n == 0) { return acc; }
    return seq_be8(v / 256, n - 1, [v % 256].concat(acc));
}

// A witness's answer to POST /event: CBOR [event, [time, r || s]], the
// event as StoredEvent CBOR (no co-signatures) and the witness's answer to
// its co-sign request; checked under its key `wkey` for log `l` and `seq`.
// None when it does not parse, is another sequence or log, or the
// co-signature does not verify.
pub Option(WitEvent) event_answer(List(Int) b, List(Int) wkey, List(Int) l, Int seq) {
    Rd a = rd(b, 0);
    if (a.major != 4 || a.val != 2) { return None; }
    Rd h = rd(b, a.next);
    if (h.major != 2 || h.next + h.val > b.len()) { return None; }
    Option(StoredEvent) se = event_of_cbor(b[h.next..h.next + h.val]);
    Option(SignedEvent) oe = match se { None => None, Some(x) => signed_of(x) };
    return match oe { None => None, Some(e) => event_cosigned(e, b[h.next + h.val..b.len()], wkey, l, seq) };
}

Option(WitEvent) event_cosigned(SignedEvent e, List(Int) ans, List(Int) wkey, List(Int) l, Int seq) {
    if ((Int)e.payload.sequence != seq) { return None; }
    if (seq > 0 && !opt_bytes_is(e.payload.log_id, l)) { return None; }
    if (seq == 0 && !bytes_eq(sha256_bytes(e.encoded), l)) { return None; }
    Option(WitnessCosignature) c = cosig_of(ans, wkey, l, (UInt(64))seq, sha256_bytes(e.encoded));
    return match c {
        None => None,
        Some(x) => Some(WitEvent {.e = SignedEvent {.payload = e.payload, .encoded = e.encoded, .sigs = e.sigs, .cosigs = []}, .cs = x})
    };
}

@requires(network, clock(readonly), declassify)
Option(WitEvent) event_from(Endpoint e, List(Int) wkey, List(Int) l, Int seq) {
    HttpOut o = http_call_ep(e, "POST", "/event", event_query(l, seq));
    Option(WitEvent) w = if (o.status == 200) { event_answer(o.body, wkey, l, seq) } else { None };
    return w;
}

// Each witness of `ws` asked for what it co-signed at `seq`, in the order
// of `ws`; after `until` the rest count as not answering (R3P-4).
@requires(network, clock(readonly), declassify)
pub List(Option(WitEvent)) events_from(List(WitnessRef) ws, Str ca, List(Int) l, Int seq, Int i, List(Option(WitEvent)) acc, Int until) {
    if (i >= ws.len()) { return acc; }
    Option(Endpoint) oe = if (i > 0 && clock_now_seconds() > until) { None } else { endpoint_of_url(ws[i].url, ca) };
    Option(WitEvent) w = match oe { None => None, Some(e) => event_from(e, ws[i].key, l, seq) };
    return events_from(ws, ca, l, seq, i + 1, acc.concat([w]), until);
}

// The event a majority of the `n` witnesses co-signed, from their answers
// `ans` (each checked under the key of the witness asked), with every
// co-signature on it; None when no digest has a majority.
pub Option(SignedEvent) witnessed_at(List(Option(WitEvent)) ans, Int n, Int i) {
    if (i >= ans.len()) { return None; }
    Option(WitEvent) o = ans[i];
    Option(SignedEvent) here = match o { None => None, Some(x) => majority_on(ans, n, x.e) };
    return match here { Some(e) => Some(e), None => witnessed_at(ans, n, i + 1) };
}

Option(SignedEvent) majority_on(List(Option(WitEvent)) ans, Int n, SignedEvent e) {
    List(WitnessCosignature) cs = cosigs_on(ans, sha256_bytes(e.encoded), 0, []);
    if (cs.len() * 2 <= n || cs.len() < 2) { return None; }
    return Some(SignedEvent {.payload = e.payload, .encoded = e.encoded, .sigs = e.sigs, .cosigs = cs});
}

List(WitnessCosignature) cosigs_on(List(Option(WitEvent)) ans, List(Int) d, Int i, List(WitnessCosignature) acc) {
    if (i >= ans.len()) { return acc; }
    Option(WitEvent) o = ans[i];
    List(WitnessCosignature) next = match o { None => acc, Some(x) => if (bytes_eq(sha256_bytes(x.e.encoded), d)) { acc.concat([x.cs]) } else { acc } };
    return cosigs_on(ans, d, i + 1, next);
}

// The distinct events in `ans`.
pub List(SignedEvent) loose_at(List(Option(WitEvent)) ans, Int i, List(SignedEvent) acc) {
    if (i >= ans.len()) { return acc; }
    Option(WitEvent) o = ans[i];
    List(SignedEvent) next = match o { None => acc, Some(x) => if (has_digest(acc, sha256_bytes(x.e.encoded), 0)) { acc } else { acc.concat([x.e]) } };
    return loose_at(ans, i + 1, next);
}

Bool has_digest(List(SignedEvent) es, List(Int) d, Int i) {
    if (i >= es.len()) { return false; }
    return bytes_eq(sha256_bytes(es[i].encoded), d) || has_digest(es, d, i + 1);
}

// The highest sequence a witness reports having co-signed, or `best`.
pub Int top_head(List(Option(WitnessHead)) hs, Int i, Int best) {
    if (i >= hs.len()) { return best; }
    Option(WitnessHead) o = hs[i];
    Int s = match o { None => -1, Some(h) => if (h.digest.len() == 32) { h.seq } else { -1 } };
    return top_head(hs, i + 1, if (s > best) { s } else { best });
}

// Every witness's answer to POST /head, three at a time (as
// witness_times_par): a device asks on every view of the log.
@requires(network, clock(readonly), declassify)
pub List(Option(WitnessHead)) witness_heads_par(List(WitnessRef) ws, Str ca, List(Int) l) {
    List(Option(WitnessHead)) hs = heads_batched(ws, ca, l, random_bytes(32), 0, [], clock_now_seconds() + witness_deadline_secs());
    return hs;
}

@requires(network, clock(readonly), declassify)
List(Option(WitnessHead)) heads_batched(List(WitnessRef) ws, Str ca, List(Int) l, List(Int) nonce, Int i, List(Option(WitnessHead)) acc, Int until) {
    if (i >= ws.len() || (i > 0 && clock_now_seconds() > until)) { return acc; }
    Result(Option(WitnessHead), RegionError) a = spawn (network, clock(readonly), declassify) { return head_of(ws, i, ca, l, nonce); };
    Result(Option(WitnessHead), RegionError) b = spawn (network, clock(readonly), declassify) { return head_of(ws, i + 1, ca, l, nonce); };
    Result(Option(WitnessHead), RegionError) c = spawn (network, clock(readonly), declassify) { return head_of(ws, i + 2, ca, l, nonce); };
    List(Option(WitnessHead)) here = [head_got(a), head_got(b), head_got(c)];
    return heads_batched(ws, ca, l, nonce, i + 3, acc.concat(here), until);
}

Option(WitnessHead) head_got(Result(Option(WitnessHead), RegionError) r) { return match r { Err(_) => None, Ok(o) => o }; }

@requires(network, clock(readonly), declassify)
Option(WitnessHead) head_of(List(WitnessRef) ws, Int i, Str ca, List(Int) l, List(Int) nonce) {
    if (i >= ws.len()) { return None; }
    Option(Endpoint) oe = endpoint_of_url(ws[i].url, ca);
    Option(WitnessHead) h = match oe { None => None, Some(e) => head_from(e, ws[i].key, l, nonce) };
    return h;
}

// The view `v` of the relay's log held against the witnesses its policy
// names (reached at `here`): when one reports a head past it, the events a
// majority co-signed from there on are taken from them (at most
// max_fill()), and the whole log is verified again; then kept with the
// device's copy and given to the relay. An event that no majority holds is
// never taken (`loose` reports those at the first such sequence). A relay
// that still does not serve them is reported (ALARM, `hidden`).
@requires(filesystem, network, clock(readonly), declassify)
pub WitnessedView witness_fill(Str dir, Endpoint relay, List(Int) l, Str here, LogView v) {
    List(WitnessRef) ws = witnesses_at(v.vh.head.policy.witnesses, here);
    Int have = v.events.len();
    Int top = top_head(witness_heads_par(ws, relay.ca, l), 0, -1);
    if (top < have) { return WitnessedView {.view = v, .fetched = 0, .hidden = 0, .loose = []}; }
    Took t = take_witnessed(ws, relay.ca, l, have, top, []);
    return fill_with(dir, relay, l, here, v, t);
}

pub type Took = { List(SignedEvent) events; List(SignedEvent) loose; };

// The events a majority of `ws` co-signed from `seq` on, up to `top`.
@requires(network, clock(readonly), declassify)
Took take_witnessed(List(WitnessRef) ws, Str ca, List(Int) l, Int seq, Int top, List(SignedEvent) acc) {
    if (seq > top || acc.len() >= max_fill()) { return Took {.events = acc, .loose = []}; }
    List(Option(WitEvent)) ans = events_from(ws, ca, l, seq, 0, [], clock_now_seconds() + witness_deadline_secs());
    Option(SignedEvent) e = witnessed_at(ans, ws.len(), 0);
    return match e {
        None => Took {.events = acc, .loose = loose_at(ans, 0, [])},
        Some(x) => take_witnessed(ws, ca, l, seq + 1, top, acc.concat([x]))
    };
}

// The log `v` extended by `t`'s events when the whole verifies: the
// witnesses' events with a log that does not lead to them are refused.
pub Result(LogView, SymbolonError) extended_view(List(Int) l, LogView v, List(SignedEvent) more, Int now) {
    List(SignedEvent) all = v.events.concat(more);
    Result(VerifiedHead, SymbolonError) r = il_verify(l, all, at_least(now, last_time(all, policy_of_e0(all))), lambda(p) { false });
    return match r { Err(e) => Err(e), Ok(vh) => Ok(LogView {.vh = vh, .events = all}) };
}

@requires(filesystem, network, clock(readonly), declassify)
WitnessedView fill_with(Str dir, Endpoint relay, List(Int) l, Str here, LogView v, Took t) {
    if (t.events.len() == 0) { return WitnessedView {.view = v, .fetched = 0, .hidden = 0, .loose = t.loose}; }
    Int now = witness_now(witnesses_at(v.vh.head.policy.witnesses, here), relay.ca, random_bytes(32));
    Result(LogView, SymbolonError) r = extended_view(l, v, t.events, now);
    return match r {
        Err(e) => unverified_fill(v, e),
        Ok(x) => filled(dir, relay, l, x, v.events.len(), t)
    };
}

WitnessedView unverified_fill(LogView v, SymbolonError e) {
    eprintln("ALARM: the witnesses co-signed events past the relay's log that do not verify with it (" + match e { ErrInvalidLog(s) => s, _ => "error" } + "); possible fork (SPEC 20.4)");
    return WitnessedView {.view = v, .fetched = 0, .hidden = 0, .loose = []};
}

@requires(filesystem, network, clock(readonly), declassify)
WitnessedView filled(Str dir, Endpoint relay, List(Int) l, LogView v, Int have, Took t) {
    List(List(Int)) raw = raw_events(v.events, 0, []);
    Str cd = dir + "/logcache/" + hex_encode(l);
    _ = filesystem.create_dir(dir + "/logcache");
    _ = filesystem.create_dir(cd);
    _ = cache_from(cd, raw, have);
    // Given to the relay: one that only lagged then serves them.
    _ = put_from(relay, l, raw, have);
    Bool served = relay_serves(relay, l, (UInt(64))have, sha256_bytes(t.events[0].encoded));
    Int hidden = if (served) { 0 } else { t.events.len() };
    if (hidden > 0) {
        eprintln(f"ALARM: the witnesses co-signed {hidden} event(s) of the log that the relay does not serve (sequence {have} to {have + hidden - 1}); taken from the witnesses: the relay may be hiding them (SPEC 13.4, 20.4)");
    }
    return WitnessedView {.view = v, .fetched = t.events.len(), .hidden = hidden, .loose = t.loose};
}

// Each event as the relay stores it (StoredEvent CBOR).
pub List(List(Int)) raw_events(List(SignedEvent) es, Int i, List(List(Int)) acc) {
    if (i >= es.len()) { return acc; }
    return raw_events(es, i + 1, acc.concat([cbor_of_event(StoredEvent {.encoded = es[i].encoded, .sigs = es[i].sigs, .cosigs = es[i].cosigs})]));
}

@requires(network, clock(readonly), declassify)
Bool put_from(Endpoint relay, List(Int) l, List(List(Int)) raw, Int i) {
    if (i >= raw.len()) { return true; }
    if (!log_put(relay, l, (UInt(64))i, raw[i])) { return false; }
    return put_from(relay, l, raw, i + 1);
}

// Whether the relay serves the event with digest `d` at `seq`.
@requires(network, clock(readonly), declassify)
pub Bool relay_serves(Endpoint relay, List(Int) l, UInt(64) seq, List(Int) d) {
    HttpOut o = log_get_out(relay, l, seq);
    if (o.status != 200) { return false; }
    Option(StoredEvent) se = event_of_cbor(o.body);
    return match se { None => false, Some(x) => bytes_eq(sha256_bytes(x.encoded), d) };
}

// ─── The relay's sign-in message (SPEC 29.4) ────────────────────
// What a device signs to sign in to its relay: the relay's name as the
// device reaches it ("HOST:PORT", the host in lower case) bound in, so a
// relay cannot pass another relay's challenge to a device and sign in
// there as it. The relay checks the name is one of its own.
pub Str relay_name(Str host, Int port) { return str_to_lower(host) + ":" + f"{port}"; }

pub List(Int) relay_auth_message(Str name, List(Int) chal) { return utf8("symbolon v2 relay auth " + name + "\n").concat(chal); }
