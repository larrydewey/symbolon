// Helpers shared by the device and the cosigner agents: files, keys derived
// from a profile's DEK, software signing keys, and encodings of the stored
// objects.

import "../types.resid";
import "../core/log.resid";
import "../core/event_decode.resid";
import "../vault/vault.resid";
import "../net/proto.resid";
import "../net/services.resid";
import "state.resid";
import "serials.resid";
import "cggmp_store.resid";
import "sha256g.resid";
import "hpkeg.resid";
import "word.resid";
import "ecdsa.resid";
import "crypto.resid";
import "cbor.resid";

pub List(Int) ints(List(UInt(8)) b) { return ints_at(b, 0, ListBuf()); }
List(Int) ints_at(List(UInt(8)) b, Int i, ListBuf(Int) acc) {
    if (i >= b.len()) { return acc.finish(); }
    return ints_at(b, i + 1, acc.push((Int)b[i]));
}

@requires(declassify)
pub List(Int) reveal(List(Secret(UInt(8))) s) { return ints(declassify(secret_join(s), "agent: value published by design")); }

pub List(Secret(UInt(8))) hk(List(Secret(UInt(8))) ikm, Str label, Int n) {
    List(Secret(UInt(8))) nil = [];
    return hkdf256g_expand(hkdf256g_extract(nil, ikm), secret_bytes(utf8(label)), n);
}

// The device's HPKE key pair, from its DEK (no new profile field).
@requires(declassify)
pub HpkeKeyPairG(Secret(UInt(8))) device_hpke(List(Secret(UInt(8))) dek) { return hpkeg_derive_keypair(16, hk(dek, "symbolon v1 device hpke", 32)); }

// A software ECDSA key from a 32-byte secret (the unprotected profile's
// DK, a cosigner's DK, a duress sub-key).
pub List(Secret(UInt(8))) software_key(List(Secret(UInt(8))) root, Str label) { return hk(root, label, 32); }

@requires(declassify)
pub List(Int) sw_public(List(Secret(UInt(8))) priv) { return ec_public_keyg(P256, priv); }

@requires(declassify)
pub List(Int) sw_sign(List(Secret(UInt(8))) priv, List(Int) msg) { return ecdsag_sign_raw(P256, Sha256, priv, msg); }

pub List(Int) party_of_key(List(Int) auth_key) { return sha256_bytes(auth_key); }

// ─── Files ───────────────────────────────────────────────────────

@requires(filesystem)
pub Bool put_secret_file(Str path, List(Int) b) { return filesystem.write_secret(path, b); }

@requires(filesystem)
pub List(Int) get_file(Str path) { return filesystem.read_bytes(path); }

pub List(Int) cbor_of_device(DeviceConfig c) { return match to_cbor(c) { Ok(b) => b, Err(_) => [] }; }
pub Option(DeviceConfig) device_of_cbor(List(Int) b) {
    if (!cbor_well_formed(b, 16)) { return None; }
    Result(DeviceConfig, SerialError) r = from_cbor(b);
    return match r { Ok(x) => Some(x), Err(_) => None };
}

pub List(Int) cbor_of_cosigner(CosignerConfig c) { return match to_cbor(c) { Ok(b) => b, Err(_) => [] }; }
pub Option(CosignerConfig) cosigner_of_cbor(List(Int) b) {
    if (!cbor_well_formed(b, 16)) { return None; }
    Result(CosignerConfig, SerialError) r = from_cbor(b);
    return match r { Ok(x) => Some(x), Err(_) => None };
}

pub List(Int) cbor_of_state(CosignerState s) { return match to_cbor(s) { Ok(b) => b, Err(_) => [] }; }
pub Option(CosignerState) state_of_cbor(List(Int) b) {
    if (!cbor_well_formed(b, 24)) { return None; }
    Result(CosignerState, SerialError) r = from_cbor(b);
    return match r { Ok(x) => Some(x), Err(_) => None };
}

pub List(Int) cbor_of_event(StoredEvent e) { return match to_cbor(e) { Ok(b) => b, Err(_) => [] }; }
pub Option(StoredEvent) event_of_cbor(List(Int) b) {
    if (b.len() > 1048576 || !cbor_well_formed(b, 16)) { return None; }
    Result(StoredEvent, SerialError) r = from_cbor(b);
    return match r { Ok(x) => Some(x), Err(_) => None };
}

pub List(Int) cbor_of_keys(PartyKeys k) { return match to_cbor(k) { Ok(b) => b, Err(_) => [] }; }
pub Option(PartyKeys) keys_of_cbor(List(Int) b) {
    if (!cbor_well_formed(b, 8)) { return None; }
    Result(PartyKeys, SerialError) r = from_cbor(b);
    return match r { Ok(x) => Some(x), Err(_) => None };
}

pub List(Int) cbor_of_blob(WrappedBlob w) { return match to_cbor(w) { Ok(b) => b, Err(_) => [] }; }
pub Option(WrappedBlob) blob_of_cbor(List(Int) b) {
    if (!cbor_well_formed(b, 8)) { return None; }
    Result(WrappedBlob, SerialError) r = from_cbor(b);
    return match r { Ok(x) => Some(x), Err(_) => None };
}

// ─── The log ─────────────────────────────────────────────────────

pub Option(SignedEvent) signed_of(StoredEvent s) {
    Option(EventPayload) p = payload_decode(s.encoded);
    return match p { None => None, Some(x) => Some(SignedEvent {.payload = x, .encoded = s.encoded, .sigs = s.sigs, .cosigs = s.cosigs}) };
}

// The whole log `l` from the relay, from sequence 0 until the first gap.
@requires(network, clock(readonly), declassify)
pub List(SignedEvent) fetch_log(Endpoint relay, List(Int) l, UInt(64) seq, List(SignedEvent) acc) {
    Option(List(Int)) b = log_get(relay, l, seq);
    return match b {
        None => acc,
        Some(x) => match event_of_cbor(x) {
            None => acc,
            Some(se) => match signed_of(se) { None => acc, Some(e) => fetch_log(relay, l, seq + 1, acc.concat([e])) }
        }
    };
}

// The raw events of log `l` from `seq` until the first gap, as the relay
// returned them (for the local copy below), and whether the relay itself
// said where the log ends (a 404 for the next event). A fetch cut short by
// a dead link or a refusal has `ended` false: the copy then says nothing
// about whether the log has moved on.
pub type Fetched = { List(List(Int)) evs; Bool ended; };

@requires(network, clock(readonly), declassify)
Fetched fetch_raw(Endpoint relay, List(Int) l, UInt(64) seq, List(List(Int)) acc) {
    HttpOut o = log_get_out(relay, l, seq);
    if (o.status != 200) { return Fetched {.evs = acc, .ended = o.status == 404}; }
    return match event_of_cbor(o.body) {
        None => Fetched {.evs = acc, .ended = false},
        Some(se) => match signed_of(se) { None => Fetched {.evs = acc, .ended = false}, Some(_) => fetch_raw(relay, l, seq + 1, acc.concat([o.body])) }
    };
}

List(SignedEvent) events_of_raw(List(List(Int)) rs, Int i, List(SignedEvent) acc) {
    if (i >= rs.len()) { return acc; }
    Option(StoredEvent) se = event_of_cbor(rs[i]);
    Option(SignedEvent) e = match se { None => None, Some(x) => signed_of(x) };
    return match e { None => acc, Some(x) => events_of_raw(rs, i + 1, acc.concat([x])) };
}

// This device's copy of a log's events it has verified, from 0 until the
// first missing one.
@requires(filesystem)
List(List(Int)) cached_raw(Str cd, Int seq, List(List(Int)) acc) {
    Str f = cd + "/" + f"{seq}";
    if (!filesystem.exists(f)) { return acc; }
    List(Int) b = filesystem.read_bytes(f);
    return if (b.len() == 0) { acc } else { cached_raw(cd, seq + 1, acc.concat([b])) };
}

@requires(filesystem)
Bool cache_from(Str cd, List(List(Int)) rs, Int i) {
    if (i >= rs.len()) { return true; }
    if (!filesystem.write_bytes(cd + "/" + f"{i}", rs[i])) { return false; }
    return cache_from(cd, rs, i + 1);
}

// The log verified now, as verified_log, fetching from the relay only the
// events after those this device has already verified (DIR/logcache/<log>/):
// a log only grows, and every event, kept or new, is verified again here,
// so the copy saves round trips, not checks. A relay that serves fewer
// events than the copy holds cannot roll the log back. If the copy and the
// relay's events do not verify together, the whole log is fetched again.
@requires(filesystem, network, clock(readonly), declassify)
pub Result(VerifiedHead, SymbolonError) verified_log_dir(Str dir, Endpoint relay, List(Int) l) {
    Str cd = dir + "/logcache/" + hex_encode(l);
    List(List(Int)) kept = cached_raw(cd, 0, []);
    // The witnesses the kept log names are asked while the rest of the log
    // is fetched; their answer is used only if the log still names them.
    List(WitnessRef) ws0 = policy_of_e0(events_of_raw(kept, 0, [])).witnesses;
    List(Int) nonce = random_bytes(32);
    Result(Int, RegionError) early = spawn (network, clock(readonly), declassify) { return if (ws0.len() == 0) { 0 } else { witness_now(ws0, relay.ca, nonce) }; };
    Fetched got = fetch_raw(relay, l, (UInt(64))kept.len(), kept);
    List(List(Int)) all = got.evs;
    Int now0 = match early { Ok(t) => t, Err(_) => 0 };
    // The kept copy alone proves nothing current: unless the relay said
    // where the log ends, it is as if the log could not be fetched.
    if (!got.ended) { return Err(ErrInvalidLog("no log at the relay")); }
    Result(VerifiedHead, SymbolonError) r = verified_events_now(l, events_of_raw(all, 0, []), relay.ca, ws0, now0);
    if (match r { Ok(_) => true, Err(_) => false }) {
        _ = filesystem.create_dir(dir + "/logcache");
        _ = filesystem.create_dir(cd);
        _ = cache_from(cd, all, kept.len());
        return r;
    }
    if (kept.len() == 0) { return r; }
    Fetched fr = fetch_raw(relay, l, (UInt(64))0, []);
    List(List(Int)) fresh = fr.evs;
    if (!fr.ended) { return Err(ErrInvalidLog("no log at the relay")); }
    Result(VerifiedHead, SymbolonError) r2 = verified_events(l, events_of_raw(fresh, 0, []), relay.ca, "");
    if (match r2 { Ok(_) => true, Err(_) => false }) { _ = cache_from(cd, fresh, 0); }
    return r2;
}

// The median witness time of the last event: the `now` a freshly fetched
// log is verified at.
pub Int last_time(List(SignedEvent) es, Policy pol) {
    if (es.len() == 0) { return 0; }
    SignedEvent e = es[es.len() - 1];
    return match witness_time(e.cosigs, pol, e.payload.log_id else { sha256_bytes(e.encoded) }, e.payload.sequence, sha256_bytes(e.encoded)) { Ok(t) => t, Err(_) => 0 };
}

pub Policy policy_of_e0(List(SignedEvent) es) {
    if (es.len() == 0) { return Policy {.device_sigs_for_authority = 0, .recovery_delay_sec = 0, .guardians = [], .guardian_threshold = 0, .witnesses = [], .duress_window_sec = 0, .cosigner_policy = NoCosignerPolicy}; }
    EventBody b = es[0].payload.body;
    return match b { InceptionBody(_, p) => p, _ => Policy {.device_sigs_for_authority = 0, .recovery_delay_sec = 0, .guardians = [], .guardian_threshold = 0, .witnesses = [], .duress_window_sec = 0, .cosigner_policy = NoCosignerPolicy} };
}

// The log verified now (SPEC 8.3): fetched, verified once at the witness
// time of its last event to learn its policy, then again at the current
// witness time, the median of what the policy's witnesses sign for a fresh
// nonce (never this machine's clock: a delay runs by witness time, SPEC
// 13.4). Guardian approvals are not accepted yet.
@requires(network, clock(readonly), declassify)
pub Result(VerifiedHead, SymbolonError) verified_log(Endpoint relay, List(Int) l) { return verified_log_at(relay, l, ""); }

// As verified_log, reaching the witnesses at `here` (their ports kept)
// when it is set: a cosigner on a Symbolon Home box, which may not reach
// the box at the address its devices use.
@requires(network, clock(readonly), declassify)
pub Result(VerifiedHead, SymbolonError) verified_log_at(Endpoint relay, List(Int) l, Str here) { return verified_events(l, fetch_log(relay, l, 0, []), relay.ca, here); }

Bool same_witnesses(List(WitnessRef) a, List(WitnessRef) b, Int i) {
    if (a.len() != b.len()) { return false; }
    if (i >= a.len()) { return true; }
    if (a[i].url != b[i].url || hex_encode(a[i].key) != hex_encode(b[i].key)) { return false; }
    return same_witnesses(a, b, i + 1);
}

// As verified_events, with a witness time `now0` already asked of the
// witnesses `ws0`: used when the log's policy still names exactly those
// witnesses and they answered, else the witnesses are asked now.
@requires(network, clock(readonly), declassify)
Result(VerifiedHead, SymbolonError) verified_events_now(List(Int) l, List(SignedEvent) es, Str ca, List(WitnessRef) ws0, Int now0) {
    if (es.len() == 0) { return Err(ErrInvalidLog("no log at the relay")); }
    Int t = last_time(es, policy_of_e0(es));
    Result(VerifiedHead, SymbolonError) v0 = il_verify(l, es, t, lambda(p) { false });
    return match v0 {
        Err(e) => Err(e),
        Ok(vh) => il_verify(l, es, at_least(if (now0 > 0 && same_witnesses(vh.head.policy.witnesses, ws0, 0)) { now0 } else { witness_now(vh.head.policy.witnesses, ca, random_bytes(32)) }, t), lambda(p) { false })
    };
}

// The events of log `l`, however they were fetched, verified now; `ca`
// as Endpoint.ca for the witnesses.
@requires(network, clock(readonly), declassify)
pub Result(VerifiedHead, SymbolonError) verified_events(List(Int) l, List(SignedEvent) es, Str ca, Str here) {
    if (es.len() == 0) { return Err(ErrInvalidLog("no log at the relay")); }
    Int t = last_time(es, policy_of_e0(es));
    Result(VerifiedHead, SymbolonError) v0 = il_verify(l, es, t, lambda(p) { false });
    return match v0 {
        Err(e) => Err(e),
        Ok(vh) => il_verify(l, es, at_least(witness_now(witnesses_at(vh.head.policy.witnesses, here), ca, random_bytes(32)), t), lambda(p) { false })
    };
}

pub List(WitnessRef) witnesses_at(List(WitnessRef) ws, Str here) {
    return if (str_len(here) == 0) { ws } else { witnesses_local(ws, here, 0, ListBuf()) };
}

List(WitnessRef) witnesses_local(List(WitnessRef) ws, Str host, Int i, ListBuf(WitnessRef) acc) {
    if (i >= ws.len()) { return acc.finish(); }
    List(Str) p = str_split(ws[i].url, ":");
    Str url = if (p.len() >= 2) { host + ":" + p[p.len() - 1] } else { ws[i].url };
    return witnesses_local(ws, host, i + 1, acc.push(WitnessRef {.url = url, .key = ws[i].key}));
}

Int at_least(Int a, Int b) { return if (a > b) { a } else { b }; }

// The median of the witnesses' signed times, or 0 when fewer than a
// majority answer.
@requires(network, clock(readonly), declassify)
pub Int witness_now(List(WitnessRef) ws, Str ca, List(Int) nonce) {
    List(Int) ts = sort(witness_times_par(ws, ca, nonce));
    if (ts.len() * 2 <= ws.len()) { return 0; }
    return ts[(ts.len() - 1) / 2];
}

// The first three witnesses asked at once, each in its own region (a
// region bound to a name runs while this goes on and is waited for where
// it is used); any others after. Over a slow link this is one round of
// connections instead of three.
@requires(network, clock(readonly), declassify)
List(Int) witness_times_par(List(WitnessRef) ws, Str ca, List(Int) nonce) {
    Result(Option(Int), RegionError) a = spawn (network, clock(readonly), declassify) { return time_of(ws, 0, ca, nonce); };
    Result(Option(Int), RegionError) b = spawn (network, clock(readonly), declassify) { return time_of(ws, 1, ca, nonce); };
    Result(Option(Int), RegionError) c = spawn (network, clock(readonly), declassify) { return time_of(ws, 2, ca, nonce); };
    List(Int) rest = witness_times(ws, ca, nonce, 3, []);
    return got(a).concat(got(b)).concat(got(c)).concat(rest);
}

List(Int) got(Result(Option(Int), RegionError) r) {
    return match r { Err(_) => [], Ok(o) => match o { None => [], Some(t) => [t] } };
}

@requires(network, clock(readonly), declassify)
Option(Int) time_of(List(WitnessRef) ws, Int i, Str ca, List(Int) nonce) {
    if (i >= ws.len()) { return None; }
    Option(Endpoint) oe = endpoint_of_url(ws[i].url, ca);
    return match oe { None => None, Some(e) => time_from(e, ws[i].key, nonce) };
}

@requires(network, clock(readonly), declassify)
List(Int) witness_times(List(WitnessRef) ws, Str ca, List(Int) nonce, Int i, List(Int) acc) {
    if (i >= ws.len()) { return acc; }
    Option(Endpoint) oe = endpoint_of_url(ws[i].url, ca);
    Option(Int) t = match oe { None => None, Some(e) => time_from(e, ws[i].key, nonce) };
    return witness_times(ws, ca, nonce, i + 1, match t { Some(x) => acc.concat([x]), None => acc });
}

// host:port of an http(s)://host:port URL; TLS under `ca` when it is set
// (one trust anchor for the relay and the witnesses, from the config).
pub Option(Endpoint) endpoint_of_url(Str u, Str ca) {
    Str hp = if (str_len(u) > 8 && str_slice(u, 0, 8) == "https://") { str_slice(u, 8, str_len(u)) } else {
        if (str_len(u) > 7 && str_slice(u, 0, 7) == "http://") { str_slice(u, 7, str_len(u)) } else { u } };
    List(Str) parts = str_split(hp, ":");
    return if (parts.len() == 2) { Some(Endpoint {.host = parts[0], .port = str_parse_int(parts[1]), .ca = ca, .token = ""}) } else { None };
}
