// Enrolling a device (SPEC 11.1, 11.3): `symbolon device enroll` on a
// device of the quorum, `symbolon device join` on the new one.
//
// The enrolling device X appends propose-party(N), then runs a re-share
// with the cosigner and N (X and the cosigner deal; X, the cosigner and N
// receive; the kit is offline and gets fresh material), collects every
// participant's signature on the reshare event, publishes it, refreshes
// the kit's material for the new epoch (SPEC 10.6), and sends N the chain
// code and the vault key.
//
// Attestation of N (SPEC 21) is checked when N's evidence is given; an
// unprotected-profile device has none, and `status` says so.

import "../types.resid";
import "../core/log.resid";
import "../core/event.resid";
import "../core/event_decode.resid";
import "../cosigner/cosigner.resid";
import "../threshold/threshold.resid";
import "../threshold/reshare.resid";
import "../recovery/recovery.resid";
import "../duress/duress.resid";
import "../net/proto.resid";
import "../net/services.resid";
import "state.resid";
import "common.resid";
import "session.resid";
import "cosignerd.resid";
import "device.resid";
import "fidokey.resid";
import "duresscli.resid";
import "serials.resid";
import "kvagent.resid";
import "../vault/kvshare.resid";
import "word.resid";
import "crypto.resid";
import "ecdsa.resid";
import "clock.resid";

pub Party none_party() { return Party {.id = [], .kind = 0, .auth_key = [], .hpke_key = [], .label = "", .attestation = NoAttestation}; }

Int count_devices(List(Party) ps, Int i, Int acc) {
    if (i >= ps.len()) { return acc; }
    return count_devices(ps, i + 1, acc + (if (ps[i].kind == party_kind_device()) { 1 } else { 0 }));
}

// Field 6 in force: that of the latest event that set it (the inception,
// a rotate-recovery or a recover) and is neither pending nor vetoed. A
// pending rotate-recovery or recover carries the new digests, in force only
// once it takes effect; events made while it was pending carry the old
// ones, so the latest event alone is not enough once it has.
pub List(List(Int)) field6(List(SignedEvent) es) { return field6_in_force(es, [], es.len() - 1); }

pub List(List(Int)) field6_in_force(List(SignedEvent) es, List(UInt(64)) pending, Int i) {
    List(List(Int)) f = field6_from(es, pending, vetoed_seqs(es, 0, []), i);
    return f;
}

List(List(Int)) field6_from(List(SignedEvent) es, List(UInt(64)) pending, List(UInt(64)) vetoed, Int i) {
    if (i < 0) { return []; }
    UInt(64) sq = es[i].payload.sequence;
    EventBody b = es[i].payload.body;
    Bool sets = match b { InceptionBody(_, _) => true, RotateRecoveryBody => true, RecoverBody(_) => true, _ => false };
    Bool skip = !sets || in_seqs(pending, sq, 0) || in_seqs(vetoed, sq, 0);
    return if (skip) { field6_from(es, pending, vetoed, i - 1) } else { es[i].payload.next_recovery_key_digests };
}

List(UInt(64)) vetoed_seqs(List(SignedEvent) es, Int i, List(UInt(64)) acc) {
    if (i >= es.len()) { return acc; }
    EventBody b = es[i].payload.body;
    return vetoed_seqs(es, i + 1, match b { VetoBody(t) => acc.concat([t]), _ => acc });
}

Bool in_seqs(List(UInt(64)) xs, UInt(64) s, Int i) {
    if (i >= xs.len()) { return false; }
    if (xs[i] == s) { return true; }
    return in_seqs(xs, s, i + 1);
}

pub EventPayload next_event(VerifiedHead vh, EventBody b, List(List(Int)) digests) {
    return EventPayload {.log_id = Some(vh.head.log_id), .sequence = vh.head.sequence + 1, .predecessor_digest = Some(vh.head.digest),
                         .suite = 1, .body = b, .next_recovery_key_digests = digests, .advisory_time = (UInt(64))0};
}

// An event signed by `sigs`, witnessed and published; then the log again.
// The witnesses are shown the log before the event, as the relay holds it:
// they verify it, and the event as its next one, before they co-sign.
// First the relay claims the sequence for the event (SPEC 20.3, R2W-2): a
// log whose policy names a sequencing relay is co-signed only with that
// relay's claim. A relay that does not sequence (404) gives none: the
// witnesses then co-sign as before for a log whose policy names no relay,
// and refuse for one that does. A relay that gives no claim, or claims
// another event that is then not witnessed, cannot hold back what it must
// not (R3P-3): the event goes to the witnesses without a claim, and they
// co-sign it if it is a veto of what the kit filed or an escape
// set-policy (core/log.resid il_claimless), and refuse anything else.
@requires(network, clock(readonly), declassify)
pub Result(VerifiedHead, Str) publish_event(DeviceConfig c, EventPayload p, List(Int) enc, List(EventSig) sigs) {
    return publish_on(c, log_raw(relay_ep(c), c.log_id), false, p, enc, sigs);
}

// As publish_event, after the log `before` this device verified itself
// (common.resid log_seen_any: its kept copy, the relay's events and what
// the witnesses co-signed past them), never the relay's answer to GET
// /log (R5-1): what a veto, or the kit's escape, is published from. A
// relay that serves a short log, an error or a fork then cannot keep
// them from the witnesses, who co-sign them without its claim (core/log
// il_claimless). Once a majority co-signed the event it is the log's next
// event whether or not the relay stores it: the witnesses show it (POST
// /head, /event) to every device and to the cosigner. The head returned
// is then this device's own verification of the log with the event.
@requires(network, clock(readonly), declassify)
pub Result(VerifiedHead, Str) publish_own(DeviceConfig c, List(SignedEvent) before, EventPayload p, List(Int) enc, List(EventSig) sigs) {
    return publish_on(c, raw_events(before, 0, []), true, p, enc, sigs);
}

@requires(network, clock(readonly), declassify)
Result(VerifiedHead, Str) publish_on(DeviceConfig c, List(List(Int)) before, Bool own, EventPayload p, List(Int) enc, List(EventSig) sigs) {
    Int have = before.len();
    if (have != (Int)p.sequence) {
        return Err(if (own) { f"the log has {have} events, not the {p.sequence} this event follows" } else { f"the relay's log has {have} events, not the {p.sequence} this event follows" });
    }
    List(Int) bare = cbor_of_event(StoredEvent {.encoded = enc, .sigs = sigs, .cosigs = []});
    List(Int) d = sha256_bytes(enc);
    ClaimOut co = claim_post(relay_ep(c), c.log_id, p.sequence, bare);
    Taken tk = if (co.status == 409) { claimed_by_other(c, before, p.sequence, co) } else { Taken {.done = false, .msg = ""} };
    if (tk.done) { return Err(tk.msg); }
    Option(RelayClaim) cl = if (co.status == 200) { co.claim } else { None };
    List(WitnessEp) ws = witnesses_for(c, before);
    List(CosignOut) outs = cosign_all(ws, c.ca, c.log_id, p.sequence, d, before.concat([bare]), cl, 0, []);
    List(WitnessCosignature) cs = cosigs_in(outs, 0, []);
    if (cs.len() * 2 <= ws.len() || cs.len() < 2) {
        if (str_len(tk.msg) > 0) { return Err(tk.msg); }
        // The relay's two claims at one sequence, when the witnesses hold
        // another event under a claim of the same relay (not one it
        // showed as lapsed, R3P-6).
        Str eq = equivocation(c, before, p.sequence, d, cl, co.lapsed, outs);
        if (str_len(eq) > 0) { return Err(eq); }
        // The freeze alarm (SPEC 20.4): witnesses that co-signed different
        // events at this sequence, so none can get a majority there.
        Str frozen = freeze_check(ws, c.ca, c.log_id, p.sequence);
        Str none = if (co.status == 200) { "" } else { f" (the relay gave no claim on the event: {co.status})" };
        return Err(if (str_len(frozen) > 0) { frozen } else { "too few witnesses co-signed" + none });
    }
    List(Int) full = cbor_of_event(StoredEvent {.encoded = enc, .sigs = sigs, .cosigs = cs});
    Bool put = log_put(relay_ep(c), c.log_id, p.sequence, full);
    // The relay may have stored it already (it carries what it claims to
    // the witnesses itself, agent/relaysrv.resid claim_complete).
    Bool stored = put || relay_holds(relay_ep(c), c.log_id, p.sequence, d);
    if (!stored && !own) { return Err("the relay refused the event"); }
    if (!stored) { eprintln(f"the witnesses co-signed the event at sequence {p.sequence}; the relay did not store it (the witnesses show it to every device and to the cosigner)"); }
    if (own) { return own_head(c, before.concat([full])); }
    return match verified_log(relay_ep(c), c.log_id) { Ok(v) => Ok(v), Err(e) => Err("the log does not verify: " + err_text(e)) };
}

// The log `raw` (this device's, with the event it published) verified now.
@requires(network, clock(readonly), declassify)
Result(VerifiedHead, Str) own_head(DeviceConfig c, List(List(Int)) raw) {
    Result(VerifiedHead, SymbolonError) mine = verified_events(c.log_id, events_of_raw(raw, 0, []), c.ca, "");
    return match mine { Ok(v) => Ok(v), Err(e) => Err("the log does not verify: " + err_text(e)) };
}

// The witnesses whose co-signatures the event after the log `before`
// needs: those its policy names as the log stands (il_witnesses), so that
// every device follows a set-policy that changes them (`device
// witnesses`), once it is in force, whatever its own configuration
// recorded at inception or enrollment. The configured ones only when
// `before` does not verify (the event is then refused anyway).
pub List(WitnessEp) witnesses_for(DeviceConfig c, List(List(Int)) before) {
    List(WitnessRef) ws = il_witnesses(c.log_id, events_of_raw(before, 0, []));
    return if (ws.len() == 0) { c.witnesses } else { eps_of(ws, 0, []) };
}

// Each witness's answer to a co-sign request with the relay's claim.
@requires(network, clock(readonly), declassify)
List(CosignOut) cosign_all(List(WitnessEp) ws, Str ca, List(Int) l, UInt(64) seq, List(Int) d, List(List(Int)) events, Option(RelayClaim) cl, Int i, List(CosignOut) acc) {
    if (i >= ws.len()) { return acc; }
    CosignOut o = cosign_try(Endpoint {.host = ws[i].host, .port = ws[i].port, .ca = ca, .token = ""}, ws[i].key, l, seq, d, events, cl);
    return cosign_all(ws, ca, l, seq, d, events, cl, i + 1, acc.concat([o]));
}

List(WitnessCosignature) cosigs_in(List(CosignOut) os, Int i, List(WitnessCosignature) acc) {
    if (i >= os.len()) { return acc; }
    Option(WitnessCosignature) w = os[i].cosig;
    return cosigs_in(os, i + 1, match w { None => acc, Some(x) => acc.concat([x]) });
}

// Whether the relay's log holds the event with digest `d` at `seq` (the
// log is verified after, as always).
@requires(network, clock(readonly), declassify)
Bool relay_holds(Endpoint relay, List(Int) l, UInt(64) seq, List(Int) d) {
    HttpOut o = log_get_out(relay, l, seq);
    if (o.status != 200) { return false; }
    Option(StoredEvent) se = event_of_cbor(o.body);
    return match se { None => false, Some(x) => bytes_eq(sha256_bytes(x.encoded), d) };
}

// The relay claimed sequence `n` for another event. That event is valid
// there (the relay checked it, the witnesses check it again) and anyone
// may carry it, with its claim, to the witnesses: this device does, and
// stores it, so that a key holder who claims a sequence and never
// finishes cannot stall the log. Then it reports which event took the
// sequence; one this principal did not make is pending at worst (a
// single key's authority event or recovery is delayed) and can be vetoed.
type Taken = { Bool done; Str msg; };

@requires(network, clock(readonly), declassify)
Taken claimed_by_other(DeviceConfig c, List(List(Int)) before, UInt(64) n, ClaimOut co) {
    Option(StoredEvent) se = event_of_cbor(co.event);
    List(Int) od = match se { None => [], Some(x) => sha256_bytes(x.encoded) };
    if (od.len() == 0) { return Taken {.done = false, .msg = f"the relay claimed sequence {n} of the log for another event it does not show"}; }
    List(WitnessEp) ws = witnesses_for(c, before);
    List(CosignOut) outs = cosign_all(ws, c.ca, c.log_id, n, od, before.concat([co.event]), co.claim, 0, []);
    List(WitnessCosignature) cs = cosigs_in(outs, 0, []);
    StoredEvent x = se else { StoredEvent {.encoded = [], .sigs = [], .cosigs = []} };
    Bool done = cs.len() * 2 > ws.len() && cs.len() >= 2
        && (log_put(relay_ep(c), c.log_id, n, cbor_of_event(StoredEvent {.encoded = x.encoded, .sigs = x.sigs, .cosigs = cs})) || relay_holds(relay_ep(c), c.log_id, n, od));
    Str what = f"sequence {n} of the log is claimed at the relay by another event (digest {hex_encode(od)})";
    return Taken {.done = done, .msg = what + if (done) { ", now witnessed and stored: check it (device status) and try again" } else { ", not witnessed yet" }};
}

// ─── `device sequence DIR [HOST:PORT]` (SPEC 20.3) ───────────────
// Names a relay as the log's sequencer (policy field 8): the relay at
// HOST:PORT, or this device's own. For a log made before field 8 this is
// the transition: until the set-policy is in force any single key holder
// can freeze the log, as before. Signed by this device only, it is
// delayed (and may be vetoed) when the policy wants more devices; adding
// a relay never weakens the policy, so with enough devices it is
// immediate. Moving a log to another relay is the same event, claimed by
// the relay the policy names now: run it while this device still uses
// that relay, then point the devices at the new one, which takes the log
// event by event (POST /log verifies each).
@requires(filesystem, network, device, declassify, clock, provision, environment)
pub Int device_sequence(Str dir, Str at) {
    Option(DeviceConfig) oc = load_config(dir);
    return match oc {
        None => dfail("not set up"),
        Some(c) => sequence_with(dir, c, at, read_pin())
    };
}

@requires(filesystem, network, device, declassify, clock, provision, environment)
Int sequence_with(Str dir, DeviceConfig c, Str at, Str pin) {
    Unlocked u = unlock_dir(dir, c, pin);
    if (u.kind == 2) { return dfail(duress_refusal(dir, c)); }
    if (u.kind != 1) { return dfail("wrong PIN"); }
    Str name = if (str_len(at) > 0) { at } else { c.relay_host + f":{c.relay_port}" };
    List(Str) hp = str_split(name, ":");
    if (hp.len() != 2 || str_len(hp[0]) == 0 || str_parse_int(hp[1]) < 1 || str_parse_int(hp[1]) > 65535) { return dfail("give the relay as HOST:PORT"); }
    List(Int) ck = claim_key_get(Endpoint {.host = hp[0], .port = str_parse_int(hp[1]), .ca = c.ca, .token = ""});
    if (ck.len() == 0) { return dfail("that relay serves no claim key (GET /claim-key)"); }
    Result(VerifiedHead, SymbolonError) rv = verified_log(relay_ep(c), c.log_id);
    return match rv {
        Err(e) => dfail(err_text(e)),
        Ok(vh) => sequence_set(c, u, vh, WitnessRef {.url = name, .key = ck})
    };
}

@requires(filesystem, network, device, declassify, clock, environment)
Int sequence_set(DeviceConfig c, Unlocked u, VerifiedHead vh, WitnessRef sq) {
    Policy p0 = vh.head.policy;
    if (p0.sequencer.len() == 1 && bytes_eq(p0.sequencer[0].key, sq.key) && p0.sequencer[0].url == sq.url) {
        println("the log's policy names that relay already");
        return 0;
    }
    // A policy from before a second device was enrolled may ask for one
    // device signature: the new one asks for the floor (SPEC 8.2), or
    // it would not be valid.
    Int floor = if (count_devices(vh.head.quorum.parties, 0, 0) >= 2) { 2 } else { 1 };
    UInt(8) dsigs = if ((Int)p0.device_sigs_for_authority < floor) { (UInt(8))floor } else { p0.device_sigs_for_authority };
    Policy np = Policy {.device_sigs_for_authority = dsigs, .recovery_delay_sec = p0.recovery_delay_sec, .guardians = p0.guardians,
                        .guardian_threshold = p0.guardian_threshold, .witnesses = p0.witnesses, .duress_window_sec = p0.duress_window_sec,
                        .sequencer = [sq], .cosigner_policy = p0.cosigner_policy};
    List(SignedEvent) es = fetch_log(relay_ep(c), c.log_id, 0, []);
    EventPayload p = next_event(vh, SetPolicyBody(np), field6_in_force(es, vh.pending, es.len() - 1));
    List(Int) enc = payload_cbor(p) else { [] };
    if (enc.len() == 0) { return dfail("the policy does not encode"); }
    Result(List(Int), Str) s = dk_sign(c, u.real, u.st, enc);
    return match s {
        Err(m) => dfail(m),
        Ok(sig) => match publish_event(c, p, enc, [EventSig {.signer = c.party, .sig = sig}]) {
            Err(m) => dfail("set-policy: " + m),
            Ok(vh2) => sequence_done(sq, vh2)
        }
    };
}

Int sequence_done(WitnessRef sq, VerifiedHead vh) {
    Bool now = vh.head.policy.sequencer.len() == 1 && bytes_eq(vh.head.policy.sequencer[0].key, sq.key);
    println("relay " + sq.url + " " + hex_encode(sq.key) + if (now) { " sequences the log now" } else { f" sequences the log once the set-policy's delay has run ({vh.pending.len()} pending)" });
    return 0;
}

// ─── `device witnesses DIR [--add HOST:PORT:KEY]... [--remove HOST:PORT]...` (SPEC 20.3) ─
// Changes the log's witnesses: a set-policy that adds the witnesses named
// with --add and takes out those at the addresses named with --remove,
// every other field of the policy kept (the sequencing relay above all).
// Signed by this device: it takes effect at once only when that is
// policy[1] devices (a quorum of one) and the change does not weaken the
// policy; otherwise it waits out the recovery delay, during which any
// device may veto it (`device veto`), as for a recovery (SPEC 8.2).
// Removing or replacing a witness always weakens the policy, and so does
// adding so many that the added ones and a minority of the old ones make a
// majority. Each witness added is asked its time first, for a fresh nonce,
// and must sign it under the key given: a typo in an address or key is
// refused here instead of leaving the log needing a witness that never
// answers. A household whose box (an old Symbolon Home) runs every
// witness moves the majority off it this way; every device follows the
// policy in force (publish_event), so only one of them runs it, and the
// others may run the same command to see that it is pending or done.
@requires(filesystem, network, device, declassify, clock, provision, environment)
pub Int device_witnesses(Str dir, List(Str) add, List(Str) remove) {
    Option(DeviceConfig) oc = load_config(dir);
    Result(List(WitnessRef), Str) ra = witness_specs(add, 0, []);
    return match oc {
        None => dfail("not set up"),
        Some(c) => match ra {
            Err(m) => dfail(m),
            Ok(ws) => witnesses_with(dir, c, ws, remove, read_pin())
        }
    };
}

// HOST:PORT:KEY (KEY: the witness's P-256 public key, 130 hex digits, as
// `symbolon witness keygen` prints it), as the policy names a witness.
pub Result(List(WitnessRef), Str) witness_specs(List(Str) xs, Int i, List(WitnessRef) acc) {
    if (i >= xs.len()) { return Ok(acc); }
    List(Str) p = str_split(xs[i], ":");
    if (p.len() != 3 || str_len(p[0]) == 0) { return Err(xs[i] + ": a witness is HOST:PORT:KEY"); }
    Int port = if (str_is_int(p[1])) { str_parse_int(p[1]) } else { 0 };
    if (port < 1 || port > 65535) { return Err(xs[i] + ": the port is not a number from 1 to 65535"); }
    List(Int) k = cose_hex_decode(p[2]);
    if (k.len() != 65 || str_len(p[2]) != 130 || !ec_public_ok(P256, k)) { return Err(xs[i] + ": the key is not a P-256 public key (130 hex digits, as `symbolon witness keygen` prints it)"); }
    return witness_specs(xs, i + 1, acc.concat([WitnessRef {.url = "http://" + str_to_lower(p[0]) + ":" + f"{port}", .key = k}]));
}

@requires(filesystem, network, device, declassify, clock, provision, environment)
Int witnesses_with(Str dir, DeviceConfig c, List(WitnessRef) add, List(Str) remove, Str pin) {
    Unlocked u = unlock_dir(dir, c, pin);
    if (u.kind == 2) { return dfail(duress_refusal(dir, c)); }
    if (u.kind != 1) { return dfail("wrong PIN"); }
    Result(VerifiedHead, SymbolonError) rv = verified_log(relay_ep(c), c.log_id);
    return match rv {
        Err(e) => dfail(err_text(e)),
        Ok(vh) => witnesses_change(c, u, vh, add, remove)
    };
}

@requires(filesystem, network, device, declassify, clock, environment)
Int witnesses_change(DeviceConfig c, Unlocked u, VerifiedHead vh, List(WitnessRef) add, List(Str) remove) {
    Policy p0 = vh.head.policy;
    if (witnesses_done(p0.witnesses, add, remove)) {
        println("the log's policy names those witnesses already: " + witness_names(p0.witnesses, 0, StrBuf()));
        return 0;
    }
    Result(Policy, Str) rp = policy_with_witnesses(p0, vh.head.quorum, add, remove);
    Policy np = match rp { Ok(x) => x, Err(_) => p0 };
    Str why = match rp { Ok(_) => "", Err(m) => m };
    if (str_len(why) > 0) { return dfail(why); }
    List(SignedEvent) es = fetch_log(relay_ep(c), c.log_id, 0, []);
    UInt(64) waiting = pending_witness_change(es, vh.pending, np.witnesses, 0);
    if ((Int)waiting > 0) {
        println(f"a set-policy naming those witnesses is pending already (event {waiting}): it takes effect once its delay has run, unless a device vetoes it");
        return 0;
    }
    Str dead = unanswered(add, c.ca, 0);
    if (str_len(dead) > 0) { return dfail(dead); }
    EventPayload p = next_event(vh, SetPolicyBody(np), field6_in_force(es, vh.pending, es.len() - 1));
    List(Int) enc = payload_cbor(p) else { [] };
    if (enc.len() == 0) { return dfail("the policy does not encode"); }
    Result(List(Int), Str) s = dk_sign(c, u.real, u.st, enc);
    return match s {
        Err(m) => dfail(m),
        Ok(sig) => match publish_event(c, p, enc, [EventSig {.signer = c.party, .sig = sig}]) {
            Err(m) => dfail("set-policy: " + m),
            Ok(vh2) => witnesses_published(p0, np, vh2)
        }
    };
}

// Whether the policy's witnesses `ws` already hold every witness of `add`
// (the same key at the same address) and none at an address of `remove`.
Bool witnesses_done(List(WitnessRef) ws, List(WitnessRef) add, List(Str) remove) {
    return (add.len() > 0 || remove.len() > 0) && adds_present(ws, add, 0) && removes_absent(ws, remove, 0);
}

Bool adds_present(List(WitnessRef) ws, List(WitnessRef) add, Int i) {
    if (i >= add.len()) { return true; }
    return has_witness(ws, add[i], 0) && adds_present(ws, add, i + 1);
}

Bool has_witness(List(WitnessRef) ws, WitnessRef w, Int i) {
    if (i >= ws.len()) { return false; }
    if (bytes_eq(ws[i].key, w.key) && witness_addr(ws[i].url) == witness_addr(w.url)) { return true; }
    return has_witness(ws, w, i + 1);
}

Bool removes_absent(List(WitnessRef) ws, List(Str) remove, Int i) {
    if (i >= remove.len()) { return true; }
    return !addr_in(ws, witness_addr(remove[i]), 0) && removes_absent(ws, remove, i + 1);
}

Bool addr_in(List(WitnessRef) ws, Str a, Int i) {
    if (i >= ws.len()) { return false; }
    return witness_addr(ws[i].url) == a || addr_in(ws, a, i + 1);
}

// The sequence of a pending set-policy whose witnesses are `ws`, or 0.
UInt(64) pending_witness_change(List(SignedEvent) es, List(UInt(64)) pending, List(WitnessRef) ws, Int i) {
    if (i >= es.len()) { return (UInt(64))0; }
    EventPayload ep = es[i].payload;
    EventBody b = ep.body;
    Bool same = in_seqs(pending, ep.sequence, 0) && match b { SetPolicyBody(np) => same_witness_keys(np.witnesses, ws), _ => false };
    if (same) { return ep.sequence; }
    return pending_witness_change(es, pending, ws, i + 1);
}

// Why a witness of `ws` cannot be used: it does not answer POST /time for
// a fresh nonce with a time signed under its key (SPEC 20.3); "" when
// every one does.
@requires(network, clock(readonly), declassify)
Str unanswered(List(WitnessRef) ws, Str ca, Int i) {
    if (i >= ws.len()) { return ""; }
    Option(Endpoint) oe = endpoint_of_url(witness_addr(ws[i].url), ca);
    Option(Int) t = match oe { None => None, Some(e) => time_from(e, ws[i].key, random_bytes(32)) };
    Bool ok = match t { Some(_) => true, None => false };
    if (!ok) {
        return "the witness at " + witness_addr(ws[i].url) + " does not answer with a time signed by that key (POST /time): check its address, its key and that it is running; nothing was changed";
    }
    return unanswered(ws, ca, i + 1);
}

Str witness_names(List(WitnessRef) ws, Int i, StrBuf acc) {
    if (i >= ws.len()) { return acc.finish(); }
    return witness_names(ws, i + 1, if (i == 0) { acc.push(witness_addr(ws[i].url)) } else { acc.push(", ").push(witness_addr(ws[i].url)) });
}

Int witnesses_published(Policy p0, Policy np, VerifiedHead vh) {
    Bool now = same_witness_keys(vh.head.policy.witnesses, np.witnesses);
    if (now) {
        println("the log's witnesses are now " + witness_names(np.witnesses, 0, StrBuf()));
        return 0;
    }
    Str weak = if (weakens(p0, np)) { "removing or replacing witnesses (or adding enough to outvote the old ones) always waits out the delay" } else { "the policy asks for more devices' signatures than this one" };
    Str conf = if (weakens(p0, np)) { "" } else { " or at once when another device confirms it (device confirm)" };
    println(f"set-policy published; the new witnesses take effect once the recovery delay ({p0.recovery_delay_sec} s of witness time) has run, unless a device vetoes it (device veto)" + conf + ": "
        + weak + f". Pending events: {vh.pending.len()}");
    return 0;
}

// Proof that the log's relay equivocated (SPEC 20.4): it claimed `d` at
// `n` for this device (`cl`) and a witness holds another digest there
// under a claim of the same relay. "" when there is no such pair.
@requires(network, clock(readonly), declassify)
Str equivocation(DeviceConfig c, List(List(Int)) before, UInt(64) n, List(Int) d, Option(RelayClaim) cl, List(List(Int)) lapsed, List(CosignOut) outs) {
    RelayClaim mine = cl else { RelayClaim {.time = -1, .sig = []} };
    if (mine.time < 0) { return ""; }
    List(SignedEvent) bs = events_of_raw(before, 0, []);
    List(WitnessRef) sq = il_sequencer(c.log_id, bs);
    if (sq.len() == 0 || !claim_ok(sq[0], c.log_id, (Int)n, d, mine)) { return ""; }
    // A claim the relay says lapsed counts as lapsed only if its event can
    // no longer be co-signed, at witness time now.
    Int now = if (lapsed.len() == 0) { 0 } else { witness_now(refs_of_eps(witnesses_for(c, before), 0, []), c.ca, random_bytes(32)) };
    List(List(Int)) gone = if (now > 0) { really_lapsed(sq[0], c.log_id, (Int)n, bs, lapsed, now, 0, []) } else { [] };
    Str why = equivocation_after(sq[0], c.log_id, (Int)n, d, mine, gone, outs, 0);
    return why;
}

// The lapsed claim records that are the relay's claim on their own event
// at (l, n), and whose event can no longer be co-signed at `now`.
List(List(Int)) really_lapsed(WitnessRef sq, List(Int) l, Int n, List(SignedEvent) bs, List(List(Int)) recs, Int now, Int i, List(List(Int)) acc) {
    if (i >= recs.len()) { return acc; }
    Option(ClaimRecord) r = claim_record_of(recs[i]);
    RelayClaim rc = match r { None => RelayClaim {.time = -1, .sig = []}, Some(x) => x.claim };
    Option(StoredEvent) se = match r { None => None, Some(x) => event_of_cbor(x.event) };
    Option(SignedEvent) e = match se { None => None, Some(x) => signed_of(x) };
    Bool gone = match e { None => false, Some(x) => claim_ok(sq, l, n, sha256_bytes(x.encoded), rc) && il_lapsed(l, bs, x, now) };
    return really_lapsed(sq, l, n, bs, recs, now, i + 1, if (gone) { acc.concat([recs[i]]) } else { acc });
}

// ─── `device protection enable DIR [PRIMES]` (SPEC 18.10.1) ─────
// Gives a quorum without one a vault OPRF key: a re-share to the same
// parties at the next epoch (a refresh of x too, so it takes minutes, once)
// in which this device and the cosigner deal a fresh k_v. The kit's half
// a_v goes to the relay and the cosigner keeps b_v, as at an enrollment.
// Every online party takes part in a re-share, so with another device in
// the quorum that device would have to join it: turned on while this is
// the only device, or at inception, which deals k_v from the start.

@requires(filesystem, network, device, declassify, clock, provision, environment)
pub Int device_protection_enable(Str dir, Str primes_file) {
    Option(DeviceConfig) oc = load_config(dir);
    return match oc { None => dfail("not set up"), Some(c) => protection_unlocked(dir, c, read_pin(), primes_file) };
}

@requires(filesystem, network, device, declassify, clock, provision, environment)
Int protection_unlocked(Str dir, DeviceConfig c, Str pin, Str primes_file) {
    Unlocked u = unlock_dir(dir, c, pin);
    if (u.kind == 2) { return dfail(duress_refusal(dir, c)); }
    if (u.kind != 1) { return dfail("wrong PIN"); }
    Result(VerifiedHead, SymbolonError) rv = verified_log(relay_ep(c), c.log_id);
    Option(CgConfig) cg = load_share(dir, u.real.dek);
    return match rv {
        Err(e) => dfail(err_text(e)),
        Ok(vh) => match cg {
            None => dfail("no share"),
            Some(x) => protection_refresh(dir, c, u, x, vh, pin, primes_file)
        }
    };
}

@requires(filesystem, network, device, declassify, clock, provision, environment)
Int protection_refresh(Str dir, DeviceConfig c, Unlocked u, CgConfig x, VerifiedHead vh, Str pin, Str primes_file) {
    Quorum q = vh.head.quorum;
    if (q.kv_commits.len() > 0) { println("protected items are on already"); return 0; }
    if (match cosigner_of(q.parties, 0) { None => true, Some(_) => false }) { return dfail("protected items need a cosigner (SPEC 18.10.5: without one, not built yet)"); }
    if (count_devices(q.parties, 0, 0) > 1) { return dfail("other devices would have to join the re-share: turn protected items on from a quorum with this device only"); }
    if (vh.pending.len() > 0) { return dfail("a change is pending in the log: let it take effect or veto it first"); }
    println("device: turning protected items on (a re-share with the cosigner; this can take minutes)...");
    return reshare_in(dir, c, u, x, vh, q.parties, pin, primes_file, KvGenerate);
}

// ─── `device enroll DIR NEW_DEVICE_KEYS [PRIMES]` ───────────────

@requires(filesystem, network, device, declassify, clock, provision, environment)
pub Int device_enroll(Str dir, Str keys_hex, Str primes_file) {
    Option(DeviceConfig) oc = load_config(dir);
    Option(PartyKeys) ok = keys_of_cbor(cose_hex_decode(keys_hex));
    return match oc {
        None => dfail("not set up"),
        Some(c) => match ok {
            None => dfail("those are not a device's keys"),
            Some(nk) => enroll_unlocked(dir, c, nk, read_pin(), primes_file)
        }
    };
}

@requires(filesystem, network, device, declassify, clock, provision, environment)
pub Int enroll_unlocked(Str dir, DeviceConfig c, PartyKeys nk, Str pin, Str primes_file) {
    Unlocked u = unlock_dir(dir, c, pin);
    if (u.kind == 2) { return dfail(duress_refusal(dir, c)); }
    if (u.kind != 1) { return dfail("wrong PIN"); }
    Result(VerifiedHead, SymbolonError) rv = verified_log(relay_ep(c), c.log_id);
    Option(CgConfig) cg = load_share(dir, u.real.dek);
    return match rv {
        Err(e) => dfail(err_text(e)),
        Ok(vh) => match cg {
            None => dfail("no share"),
            Some(x) => propose(dir, c, u, x, vh, nk, pin, primes_file)
        }
    };
}

@requires(filesystem, network, device, declassify, clock, environment)
Int propose(Str dir, DeviceConfig c, Unlocked u, CgConfig x, VerifiedHead vh, PartyKeys nk, Str pin, Str primes_file) {
    Quorum q = vh.head.quorum;
    if (pos1(q.parties, nk.party, 0) != 0) { return dfail("that device is already a party"); }
    Party np = Party {.id = nk.party, .kind = party_kind_device(), .auth_key = nk.auth_key, .hpke_key = nk.hpke_key,
                      .label = f"device {count_devices(q.parties, 0, 0) + 1}", .attestation = NoAttestation};
    List(SignedEvent) es = fetch_log(relay_ep(c), c.log_id, 0, []);
    // An earlier try that was cut short after its propose-party: the log
    // refuses a second one ("party already known"). If the verified log
    // still holds that proposal (not vetoed, not re-shared in, not cleared
    // by a recovery) with the same keys, re-share with it. The events must
    // end at the head verified above, and a delayed proposal counts once its
    // delay has run by the witnesses' time now.
    Bool at_head = es.len() > 0 && (Int)vh.head.sequence == es.len() - 1 && bytes_eq(sha256_bytes(es[es.len() - 1].encoded), vh.head.digest);
    Int t_last = if (at_head) { last_time(es, policy_of_e0(es)) } else { 0 };
    Int t_wit = if (at_head) { witness_now(vh.head.policy.witnesses, relay_ep(c).ca, random_bytes(32)) } else { 0 };
    List(Party) proposed = if (at_head) { il_proposed(c.log_id, es, if (t_wit > t_last) { t_wit } else { t_last }, lambda(e) { false }) } else { [] };
    Int at = pos1(proposed, nk.party, 0);
    if (at != 0) {
        Party ep = proposed[at - 1];
        if (!bytes_eq(ep.auth_key, nk.auth_key) || !bytes_eq(ep.hpke_key, nk.hpke_key)) {
            return dfail("that device was proposed earlier with other keys");
        }
        println("device: the new device was proposed by an earlier try; re-sharing");
        return reshare_in(dir, c, u, x, vh, q.parties.concat([np]), pin, primes_file, kv_mode_of(dir, u, q, c.party, false));
    }
    EventPayload p = next_event(vh, ProposePartyBody(np, sha256_bytes(cbor_of_keys(nk))), field6_in_force(es, vh.pending, es.len() - 1));
    List(Int) enc = payload_cbor(p) else { [] };
    Result(List(Int), Str) s = dk_sign(c, u.real, u.st, enc);
    return match s {
        Err(m) => dfail(m),
        Ok(sig) => match publish_event(c, p, enc, [EventSig {.signer = c.party, .sig = sig}]) {
            Err(m) => dfail("propose-party: " + m),
            Ok(vh2) => if (proposal_pending(vh2.pending, p.sequence, 0)) { proposal_delayed(dir, vh2) } else {
                reshare_in(dir, c, u, x, vh2, q.parties.concat([np]), pin, primes_file, kv_mode_of(dir, u, q, c.party, false)) }
        }
    };
}

Bool proposal_pending(List(UInt(64)) ps, UInt(64) seq, Int i) {
    if (i >= ps.len()) { return false; }
    return ps[i] == seq || proposal_pending(ps, seq, i + 1);
}

// SPEC 8.2: with two devices or more one device's propose-party is delayed
// (whatever policy[1] says), so the re-share waits for its delay.
Int proposal_delayed(Str dir, VerifiedHead vh) {
    println(f"device: the proposal is pending: it takes effect after {vh.head.policy.recovery_delay_sec} s of witness time, unless a device vetoes it, or at once when another device confirms it (`device confirm`; SPEC 8.2: one device of several cannot add a party at once).");
    println("Then run `symbolon device enroll " + dir + " ...` again, and `symbolon device join` on the new device, to re-share it in.");
    return 0;
}

pub List(Int) receivers_of(List(Party) ps, Int i, List(Int) acc) {
    if (i >= ps.len()) { return acc; }
    Bool offline = ps[i].kind == party_kind_kit() || ps[i].kind == party_kind_guardian();
    return receivers_of(ps, i + 1, if (offline) { acc } else { acc.concat([i + 1]) });
}

pub List(Int) offline_of(List(Party) ps, Int i, List(Int) acc) {
    if (i >= ps.len()) { return acc; }
    Bool offline = ps[i].kind == party_kind_kit() || ps[i].kind == party_kind_guardian();
    return offline_of(ps, i + 1, if (offline) { acc.concat([i + 1]) } else { acc });
}

pub Option(Party) kit_of(List(Party) ps, Int i) {
    if (i >= ps.len()) { return None; }
    if (ps[i].kind == party_kind_kit()) { return Some(ps[i]); }
    return kit_of(ps, i + 1);
}

// How this device deals the vault OPRF key in a re-share of quorum q
// (SPEC 18.10.1): its share re-shared when q has the key (KvNone if the
// share is missing, which the re-share then refuses), a fresh secret when
// q has none and `enable` asks for one, else not at all.
@requires(filesystem, declassify)
pub KvMode kv_mode_of(Str dir, Unlocked u, Quorum q, List(Int) me, Bool enable) {
    if (q.kv_commits.len() == 0) { return if (enable) { KvGenerate } else { KvNone }; }
    Option(KvKept) k = kv_load(dir, u.real.dek);
    return match k { None => KvNone, Some(x) => if (x.epoch == (Int)q.epoch && x.id == pos1(q.parties, me, 0)) { KvReshare(x.share) } else { KvNone } };
}

// X and the cosigner deal (t = 2 of the old quorum); every online party of
// the new quorum receives.
@requires(filesystem, network, device, declassify, clock, environment)
pub Int reshare_in(Str dir, DeviceConfig c, Unlocked u, CgConfig x, VerifiedHead vh, List(Party) np, Str pin, Str primes_file, KvMode kv) {
    if (vh.head.quorum.kv_commits.len() > 0 && !kv_on(kv)) { return dfail("this device holds no share of the vault OPRF key to re-share"); }
    Quorum q = vh.head.quorum;
    Party cos = cosigner_of(q.parties, 0) else { none_party() };
    if (cos.id.len() == 0) { return dfail("no cosigner to re-share with"); }
    List(Int) sid = random_bytes(32);
    ReshareInvite inv0 = ReshareInvite {.session_id = sid, .log_id = c.log_id, .new_parties = np, .dealers = [pos1(q.parties, c.party, 0), pos1(q.parties, cos.id, 0)],
        .receivers = receivers_of(np, 0, []), .offline = offline_of(np, 0, []), .degree = (Int)q.t - 1, .epoch = (Int)q.epoch + 1, .requester = c.party, .sig = []};
    Result(List(Int), Str) rs = dk_sign(c, u.real, u.st, request_tbs(sid, reshare_message(inv0), q.epoch, c.party, request_reshare()));
    List(Int) rsig = match rs { Ok(s) => s, Err(_) => [] };
    if (rsig.len() != 64) { return dfail("the device key did not sign the request"); }
    ReshareInvite inv = ReshareInvite {.session_id = sid, .log_id = c.log_id, .new_parties = np, .dealers = inv0.dealers, .receivers = inv0.receivers,
        .offline = inv0.offline, .degree = inv0.degree, .epoch = inv0.epoch, .requester = c.party, .sig = rsig};
    Endpoint relay = mail_ep(dir, c, u);
    Int me_new = pos1(np, c.party, 0);
    Local me = Local {.party = c.party, .cg = me_new, .hpke_sk = device_transport(c, u.real.dek).sk};
    List(Remote) rem = session_remotes(np, inv.receivers, c.party, 0, []);
    Int start = mailbox_end(relay, c.party, c.mbox_next);
    if (!send_all_invites(relay, me, rem, WReshare(inv), 0)) { return dfail("cannot reach the relay"); }
    println("device: re-sharing to the new quorum (Paillier keys: this can take minutes)...");
    RsCtx rc = RsCtx {.self = me_new, .old_self = pos1(q.parties, c.party, 0), .dealers = inv.dealers, .receivers = inv.receivers, .offline = inv.offline,
        .degree = inv.degree, .old = [x], .root = q.root_pubkey, .session_id = sid, .seed = random_bytes(32), .primes = primes_of(primes_file)};
    return match rs_start(rc) {
        Err(e) => dfail("re-share: " + e.why),
        Ok(s0) => after_session(dir, c, u, vh, np, inv, rem, pin, kv,
            run_session(relay, sid, [Seat {.me = me, .st = s0.state, .round = 1, .out = s0.out, .done = false}], rem, [Cursor {.party = c.party, .next = start}], [],
                        lambda(t, msgs) { rs_adapt(t, msgs) }, 1800))
    };
}

@requires(network, declassify, clock(readonly))
pub Bool send_all_invites(Endpoint relay, Local me, List(Remote) rs, Packet w, Int i) {
    if (i >= rs.len()) { return true; }
    return send_to(relay, me, rs[i], w) && send_all_invites(relay, me, rs, w, i + 1);
}

@requires(filesystem, network, device, declassify, clock, environment)
pub Int after_session(Str dir, DeviceConfig c, Unlocked u, VerifiedHead vh, List(Party) np, ReshareInvite inv, List(Remote) rem, Str pin, KvMode kv, Run(RsState) r) {
    if (str_len(r.fail) > 0) { return dfail("re-share: " + r.fail); }
    KvDone kd = kv_reshare(mail_ep(dir, c, u), Local {.party = c.party, .cg = 0, .hpke_sk = device_transport(c, u.real.dek).sk}, vh.head.quorum, np, inv, rem, kv, mailbox_end(relay_ep(c), c.party, c.mbox_next));
    if (str_len(kd.why) > 0) { return dfail(kd.why); }
    RsResult res = rs_result(r.seats[0].st) else { RsResult {.cfg = None, .offline = [], .transcript = []} };
    Option(CgConfig) ocfg = res.cfg;
    CgConfig ncfg = ocfg else { CgConfig {.id = 0, .threshold = 0, .ecdsa = [], .elgamal = [], .p = [], .q = [], .rid = [], .chain_key = [], .public = []} };
    if (ncfg.ecdsa.len() == 0 || res.offline.len() != 1) { return dfail("the re-share gave no share"); }
    Quorum q = vh.head.quorum;
    Quorum nq = Quorum {.parties = np, .t = q.t, .root_pubkey = q.root_pubkey, .epoch = q.epoch + 1, .transcript_digest = res.transcript, .kv_commits = kd.out.commits};
    List(SignedEvent) es = fetch_log(relay_ep(c), c.log_id, 0, []);
    EventPayload p = next_event(vh, ReshareBody(nq), field6_in_force(es, vh.pending, es.len() - 1));
    List(Int) enc = payload_cbor(p) else { [] };
    Endpoint relay = mail_ep(dir, c, u);
    Local me = Local {.party = c.party, .cg = 0, .hpke_sk = device_transport(c, u.real.dek).sk};
    Int start = mailbox_end(relay, c.party, c.mbox_next);
    if (!send_all_invites(relay, me, rem, WSignEvent(enc), 0)) { return dfail("cannot reach the relay"); }
    List(EventSig) theirs = collect_sigs(relay, me, rem, Cursor {.party = c.party, .next = start}, enc, 0, []);
    if (theirs.len() != rem.len()) { return dfail("not every party signed the reshare event"); }
    Result(List(Int), Str) ms = dk_sign(c, u.real, u.st, enc);
    List(Int) mine = match ms { Ok(s) => s, Err(_) => [] };
    return match publish_event(c, p, enc, [EventSig {.signer = c.party, .sig = mine}].concat(theirs)) {
        Err(m) => dfail("reshare: " + m),
        Ok(vh2) => finish_enroll(dir, c, u, vh2, ncfg, res, rem, kd)
    };
}

// The vault OPRF key's round of a re-share: this device deals (as
// inv.dealers[0]) to every online receiver, the cosigner answers with its
// dealing; both checked, and this device's new share and the new field 6.
pub type KvDone = { Bool on; KvOut out; KvDealing mine; Int me; Int kit; Str why; };

@requires(network, declassify, clock)
KvDone kv_reshare(Endpoint relay, Local me, Quorum q, List(Party) np, ReshareInvite inv, List(Remote) rem, KvMode kv, Int start) {
    KvOut none = KvOut {.share = kv_scalar(classify((UInt(576)) 0)), .commits = []};
    Int me_new = pos1(np, me.party, 0);
    Int kit = if (inv.offline.len() > 0) { inv.offline[0] } else { 0 };
    KvDealing mine = kv_dealing(kv, inv.degree + 1, np.len(), inv.dealers, inv.dealers[0]);
    if (!kv_on(kv)) { return KvDone {.on = false, .out = none, .mine = mine, .me = me_new, .kit = kit, .why = ""}; }
    Party cos = cosigner_of(np, 0) else { none_party() };
    Remote cr = Remote {.party = cos.id, .cg = pos1(np, cos.id, 0), .hpke_pub = cos.hpke_key};
    if (!kv_send(relay, me, rem, inv.session_id, inv.dealers[0], mine, 0)) { return KvDone {.on = false, .out = none, .mine = mine, .me = me_new, .kit = kit, .why = "cannot reach the relay"}; }
    List(KvGot) got = kv_collect(relay, me, [cr], Cursor {.party = me.party, .next = start}, inv.session_id, 120);
    if (got.len() == 0) { return KvDone {.on = false, .out = none, .mine = mine, .me = me_new, .kit = kit, .why = "the cosigner did not deal the vault OPRF key"}; }
    List(List(Int)) old = if (q.kv_commits.len() > 0) { kv_from_sec1(q.kv_commits) } else { [] };
    return match kv_combine(me_new, got, Some(mine), inv.dealers[0], old, inv.dealers) {
        Err(m) => KvDone {.on = false, .out = none, .mine = mine, .me = me_new, .kit = kit, .why = "vault OPRF key: " + m},
        Ok(o) => KvDone {.on = true, .out = o, .mine = mine, .me = me_new, .kit = kit, .why = ""}
    };
}

@requires(network, declassify, clock)
List(EventSig) collect_sigs(Endpoint relay, Local me, List(Remote) rem, Cursor cur, List(Int) enc, Int i, List(EventSig) acc) {
    if (i >= rem.len()) { return acc; }
    // Each signature is checked by the log verifier when the event is published.
    List(Int) s = wait_event_sig(relay, me, rem[i], cur, clock_now_seconds());
    return collect_sigs(relay, me, rem, cur, enc, i + 1, if (s.len() == 64) { acc.concat([EventSig {.signer = rem[i].party, .sig = s}]) } else { acc });
}

// The new epoch: the kit's fresh material (a to the kit, k_b to the
// cosigner, the kit secrets under the new k_K), the secrets to the new
// device, and this device's new share.
@requires(filesystem, network, device, declassify, clock, environment)
Int finish_enroll(Str dir, DeviceConfig c, Unlocked u, VerifiedHead vh, CgConfig ncfg, RsResult res, List(Remote) rem, KvDone kd) {
    Quorum nq = vh.head.quorum;
    Party kit = kit_of(nq.parties, 0) else { none_party() };
    Party cos = cosigner_of(nq.parties, 0) else { none_party() };
    // The kit's blobs go to the relay from a signed-in device of the log
    // (SPEC 29.4): this one, a party of the new epoch.
    Endpoint relay = relay_session(dir, c, u);
    Local me = Local {.party = c.party, .cg = 0, .hpke_sk = device_transport(c, u.real.dek).sk};
    List(Int) kk = random_bytes(32);
    List(Int) kb = random_bytes(32);
    List(Int) ka = kit_key(kk, kb);
    Wrapped wa = offline_wrap(kit.hpke_key, c.log_id, nq.epoch, kit.id, half_bytes(res.offline[0].share, ka), random_bytes(32)) else { Wrapped {.enc = [], .ct = []} };
    Bool ok = wa.ct.len() > 0
        && blob_put(relay, kit_a_blob(c.log_id, (Int)nq.epoch), cbor_of_blob(WrappedBlob {.enc = wa.enc, .ct = wa.ct}))
        && blob_put(relay, kit_secrets_blob(c.log_id, (Int)nq.epoch), kit_secrets_seal(secret_bytes(kk), c.log_id, nq.epoch, u.real.cc, u.real.vault_key))
        && send_to(relay, me, Remote {.party = cos.id, .cg = 0, .hpke_pub = cos.hpke_key}, WKitKey(kb))
        && send_secrets(relay, me, rem, cos.id, u, 0)
        && store_share(dir, u.real.dek, ncfg) && store_dshare(dir, u.real, ncfg)
        // k_v: this device's new share, and its part for the kit (a_v)
        && (!kd.on || (kv_store(dir, u.real.dek, KvKept {.epoch = (Int)nq.epoch, .id = kd.me, .share = kd.out.share})
                       && kv_put_kit_half(relay, kit, c.log_id, nq.epoch, kd.mine, kd.kit)))
        && save_config(dir, with_log(c, c.witnesses, c.log_id, mailbox_end(relay, c.party, c.mbox_next), c.peers));
    if (!ok) { return dfail("cannot finish the enrollment"); }
    println(f"enrolled: epoch {nq.epoch}, {nq.parties.len()} parties");
    return 0;
}

// The chain code and vault key go to the new devices (every remote but the
// cosigner).
@requires(network, declassify, clock(readonly))
Bool send_secrets(Endpoint relay, Local me, List(Remote) rem, List(Int) cos, Unlocked u, Int i) {
    if (i >= rem.len()) { return true; }
    if (bytes_eq(rem[i].party, cos)) { return send_secrets(relay, me, rem, cos, u, i + 1); }
    Bool ok = send_to(relay, me, rem[i], WEnrollSecrets(EnrollSecrets {.cc = reveal(u.real.cc), .vault_key = reveal(u.real.vault_key)}));
    return ok && send_secrets(relay, me, rem, cos, u, i + 1);
}

// ─── `device join DIR ENROLLING_DEVICE_KEYS [PRIMES]` ───────────

@requires(filesystem, network, device, declassify, clock, provision, environment)
pub Int device_join(Str dir, Str keys_hex, Str primes_file) {
    Option(DeviceConfig) oc = load_config(dir);
    Option(PartyKeys) ok = keys_of_cbor(cose_hex_decode(keys_hex));
    return match oc {
        None => dfail("run `symbolon device new` first"),
        Some(c) => match ok {
            None => dfail("those are not a device's keys"),
            Some(xk) => join_unlocked(dir, c, xk, read_pin(), primes_file)
        }
    };
}

@requires(filesystem, network, device, declassify, clock, provision, environment)
pub Int join_unlocked(Str dir, DeviceConfig c, PartyKeys xk, Str pin, Str primes_file) {
    Unlocked u = unlock_dir(dir, c, pin);
    if (u.kind == 2) { return dfail(duress_refusal(dir, c)); }
    if (u.kind != 1) { return dfail("wrong PIN"); }
    Local me = Local {.party = c.party, .cg = 0, .hpke_sk = device_transport(c, u.real.dek).sk};
    Remote x = Remote {.party = xk.party, .cg = 0, .hpke_pub = xk.hpke_key};
    println("device: waiting for the enrolling device...");
    Waited w = wait_wire(relay_ep(c), me, [x], Cursor {.party = c.party, .next = c.mbox_next}, clock_now_seconds(), 600, 1);
    Option(Packet) ow = w.w;
    return match ow {
        None => dfail("no re-share invitation"),
        Some(wire) => match wire {
            WReshare(inv) => join_session(dir, c, u, x, inv, w, pin, primes_file),
            _ => dfail("unexpected message")
        }
    };
}

// The first Packet of kind `kind` (1 reshare invite, 2 sign event, 3 enroll
// secrets) from one of `from`, and the messages read with it.
pub type Waited = { Option(Packet) w; List(Got) all; Cursor cur; };

Int kind_of(Packet w) { return match w { WReshare(_) => 1, WSignEvent(_) => 2, WEnrollSecrets(_) => 3, _ => 0 }; }

Option(Packet) first_kind(List(Got) gs, Int kind, Int i) {
    if (i >= gs.len()) { return None; }
    if (kind_of(gs[i].w) == kind) { return Some(gs[i].w); }
    return first_kind(gs, kind, i + 1);
}

@requires(network, declassify, clock)
pub Waited wait_wire(Endpoint relay, Local me, List(Remote) from, Cursor cur, Int since, Int limit_s, Int kind) {
    Drained d = drain(relay, me, from, cur, ListBuf());
    Option(Packet) w = first_kind(d.got, kind, 0);
    return match w {
        Some(x) => Waited {.w = Some(x), .all = d.got, .cur = d.cur},
        None => if (clock_now_seconds() - since > limit_s) { Waited {.w = None, .all = d.got, .cur = d.cur} } else { wait_more(relay, me, from, d.cur, since, limit_s, kind) }
    };
}

@requires(network, declassify, clock)
Waited wait_more(Endpoint relay, Local me, List(Remote) from, Cursor cur, Int since, Int limit_s, Int kind) {
    _ = clock_sleep_ms(200);
    return wait_wire(relay, me, from, cur, since, limit_s, kind);
}

@requires(filesystem, network, device, declassify, clock, provision, environment)
Int join_session(Str dir, DeviceConfig c, Unlocked u, Remote x, ReshareInvite inv, Waited w, Str pin, Str primes_file) {
    DeviceConfig c1 = with_log(c, c.witnesses, inv.log_id, w.cur.next, c.peers);
    // Not one of the log's devices yet: a mail session as a proposed party.
    Endpoint relay = mail_ep(dir, c1, u);
    Result(VerifiedHead, SymbolonError) rv = verified_log(relay, inv.log_id);
    VerifiedHead vh = match rv { Ok(v) => v, Err(_) => VerifiedHead {.head = LogHead {.log_id = [], .sequence = 0, .digest = [], .quorum = Quorum {.parties = [], .t = 0, .root_pubkey = [], .epoch = 0, .transcript_digest = [], .kv_commits = []}, .policy = policy_of_e0([])}, .witness_cosigs = [], .pending = []} };
    if (vh.head.log_id.len() == 0) { return dfail("the log does not verify"); }
    Int me_new = pos1(inv.new_parties, c.party, 0);
    if (me_new == 0 || (Int)vh.head.quorum.epoch + 1 != inv.epoch) { return dfail("this device is not in that re-share"); }
    List(Remote) rem = session_remotes(inv.new_parties, inv.receivers, c.party, 0, []);
    Local me = Local {.party = c.party, .cg = me_new, .hpke_sk = device_transport(c, u.real.dek).sk};
    RsCtx rc = RsCtx {.self = me_new, .old_self = 0, .dealers = inv.dealers, .receivers = inv.receivers, .offline = inv.offline, .degree = inv.degree,
        .old = [], .root = vh.head.quorum.root_pubkey, .session_id = inv.session_id, .seed = random_bytes(32), .primes = primes_of(primes_file)};
    return match rs_start(rc) {
        Err(e) => dfail("re-share: " + e.why),
        Ok(s0) => join_after(dir, c1, u, x, inv, vh, pin, w.cur,
            run_session(relay, inv.session_id, [Seat {.me = me, .st = s0.state, .round = 1, .out = s0.out, .done = false}], rem, [w.cur], w.all,
                        lambda(t, msgs) { rs_adapt(t, msgs) }, 1800))
    };
}

@requires(filesystem, network, device, declassify, clock, provision, environment)
Int join_after(Str dir, DeviceConfig c, Unlocked u, Remote x, ReshareInvite inv, VerifiedHead vh, Str pin, Cursor before, Run(RsState) r) {
    if (str_len(r.fail) > 0) { return dfail("re-share: " + r.fail); }
    RsResult res = rs_result(r.seats[0].st) else { RsResult {.cfg = None, .offline = [], .transcript = []} };
    Option(CgConfig) ocfg = res.cfg;
    CgConfig ncfg = ocfg else { CgConfig {.id = 0, .threshold = 0, .ecdsa = [], .elgamal = [], .p = [], .q = [], .rid = [], .chain_key = [], .public = []} };
    if (ncfg.ecdsa.len() == 0) { return dfail("the re-share gave no share"); }
    Endpoint relay = mail_ep(dir, c, u);
    Local me = Local {.party = c.party, .cg = 0, .hpke_sk = device_transport(c, u.real.dek).sk};
    Cursor cur = r.cursors[0];
    Waited ev = wait_wire(relay, me, [x], cur, clock_now_seconds(), 600, 2);
    Option(Packet) evw = ev.w;
    List(Int) enc = match evw { Some(wv) => sign_event_of(wv), None => [] };
    Option(EventPayload) op = payload_decode(enc);
    Bool ok = match op {
        None => false,
        Some(p) => reshare_matches(p, res, inv)
    };
    if (!ok) { return dfail("not the reshare event of this re-share"); }
    // The vault OPRF key (SPEC 18.10.1): when the event names one, a
    // dealing from each dealer, read from before the session (its drains
    // skip them), that add up to the event's field 6.
    List(List(Int)) want = match op { Some(p) => kv_named(p), None => [] };
    Result(KvOut, Str) kvr = if (want.len() == 0) { Err("") } else {
        kv_combine(pos1(inv.new_parties, c.party, 0), kv_collect(relay, me, [x, cos_remote(vh)], before, inv.session_id, 120), None, 0,
                   if (vh.head.quorum.kv_commits.len() > 0) { kv_from_sec1(vh.head.quorum.kv_commits) } else { [] }, inv.dealers)
    };
    Option(KvOut) kvo = match kvr { Ok(o) => if (flat_keys(o.commits, 0, []) == flat_keys(want, 0, [])) { Some(o) } else { None }, Err(_) => None };
    if (want.len() > 0 && match kvo { None => true, Some(_) => false }) {
        return dfail("the vault OPRF key's dealings do not match the reshare event" + match kvr { Err(m) => ": " + m, Ok(_) => "" });
    }
    Result(List(Int), Str) s = dk_sign(c, u.real, u.st, enc);
    List(Int) sig = match s { Ok(v) => v, Err(_) => [] };
    if (sig.len() != 64 || !send_to(relay, me, x, WEventSig(sig))) { return dfail("cannot sign the reshare event"); }
    Waited sec = wait_wire(relay, me, [x], ev.cur, clock_now_seconds(), 600, 3);
    Option(Packet) sw = sec.w;
    return match sw {
        Some(wv) => match wv { WEnrollSecrets(es) => joined(dir, c, u, pin, ncfg, es, vh, sec.cur, kvo, inv), _ => dfail("no secrets") },
        None => dfail("no secrets from the enrolling device")
    };
}

List(Int) sign_event_of(Packet w) { return match w { WSignEvent(b) => b, _ => [] }; }

List(List(Int)) kv_named(EventPayload p) {
    EventBody b = p.body;
    return match b { ReshareBody(nq) => nq.kv_commits, _ => [] };
}

List(Int) flat_keys(List(List(Int)) xs, Int i, List(Int) acc) { return if (i >= xs.len()) { acc } else { flat_keys(xs, i + 1, acc.concat(xs[i])) }; }

Bool reshare_matches(EventPayload p, RsResult res, ReshareInvite inv) {
    EventBody b = p.body;
    return match b { ReshareBody(nq) => bytes_eq(nq.transcript_digest, res.transcript) && (Int)nq.epoch == inv.epoch, _ => false };
}

// The new device's profile, resealed with the quorum's chain code and vault
// key, and its share and configuration stored.
@requires(filesystem, network, device, declassify, clock, provision, environment)
Int joined(Str dir, DeviceConfig c, Unlocked u, Str pin, CgConfig ncfg, EnrollSecrets es, VerifiedHead vh, Cursor cur, Option(KvOut) kvo, ReshareInvite inv) {
    if (es.cc.len() != 32 || es.vault_key.len() != 32) { return dfail("malformed secrets"); }
    RealProfile real = RealProfile {.share = u.real.share, .cc = secret_bytes(es.cc), .vault_key = secret_bytes(es.vault_key), .dek = u.real.dek, .duress_hpke_pub = u.real.duress_hpke_pub};
    List(Secret(UInt(8))) k = u.ukey;
    List(Secret(UInt(8))) rp = encode_real(real) else { [] };
    // Which file held the real profile: the one this key opens.
    Bool a_real = unlock(k, read_blob(dir, "a", u.wrap), []).kind == 1;
    List(Int) blob = seal_blob(k, random_bytes(12), rp);
    Bool ok = write_blob(dir, if (a_real) { "a" } else { "b" }, blob, u.wrap)
        && store_share(dir, u.real.dek, ncfg) && store_dshare(dir, real, ncfg)
        && match kvo { None => true, Some(o) => kv_store(dir, u.real.dek, KvKept {.epoch = inv.epoch, .id = pos1(inv.new_parties, c.party, 0), .share = o.share}) }
        && send_duress_key(dir, mail_ep(dir, c, u), Local {.party = c.party, .cg = 0, .hpke_sk = device_transport(c, u.real.dek).sk}, cos_remote(vh))
        && save_config(dir, with_log(c, eps_of(vh.head.policy.witnesses, 0, []), c.log_id, cur.next, c.peers));
    if (!ok) { return dfail("cannot store the enrollment"); }
    println("joined the quorum: log " + hex_encode(c.log_id));
    return 0;
}

pub Remote cos_remote(VerifiedHead vh) {
    Party cos = cosigner_of(vh.head.quorum.parties, 0) else { none_party() };
    return Remote {.party = cos.id, .cg = 0, .hpke_pub = cos.hpke_key};
}

// Witness endpoints from the policy's URLs (http://host:port).
pub List(WitnessEp) eps_of(List(WitnessRef) ws, Int i, List(WitnessEp) acc) {
    if (i >= ws.len()) { return acc; }
    Str u = ws[i].url;
    Str hp = witness_addr(u);
    List(Str) parts = str_split(hp, ":");
    List(WitnessEp) next = if (parts.len() == 2) { acc.concat([WitnessEp {.host = parts[0], .port = str_parse_int(parts[1]), .key = ws[i].key}]) } else { acc };
    return eps_of(ws, i + 1, next);
}
