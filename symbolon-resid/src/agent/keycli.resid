// `symbolon device key add|list|remove|fills` (SPEC 9.4): security keys
// that must be present to open this device's profiles. See fidokey.resid.
//
// Each profile has its own key list, sealed under a key only its PIN
// gives (fidokey.resid, format 2), so whichever PIN opens the device sees
// and changes its own profile's keys only:
// - under the real PIN, a key added or removed is added to or removed from
//   both lists (the real profile holds the duress profile's list key and
//   W, and sends the duress list through its update slot), so the duress
//   profile asks for the same keys as the real one, as a coerced principal
//   expects;
// - under the duress PIN (SPEC 14.2), the change is made to the duress
//   profile's list alone: a key added there is asked for at the next
//   duress unlock (its touch gives the duress profile's W, never the real
//   one's), and one removed is not. The real profile and its keys are not
//   touched.
// The output is the same under either PIN, and so are the writes: both
// profile files, a then b, the changing profile's whole and the other's
// update slot (fidokey write_change, SPEC 14.2).

import "../duress/duress.resid";
import "../vault/vault.resid";
import "state.resid";
import "common.resid";
import "device.resid";
import "fidokey.resid";
import "ctap2.resid";
import "crypto.resid";
import "word.resid";
import "aesgcmg.resid";
import "cose.resid";
import "httpserv.resid";

DeviceConfig return_cfg_none() {
    return DeviceConfig {.relay_host = "", .relay_port = 0, .ca = "", .witnesses = [], .unprotected = true, .argon_m_kib = 0, .argon_t = 0, .salt = [],
        .tpm_dk = 0, .tpm_unlock_a = 0, .tpm_unlock_b = 0, .party = [], .dk_pub = [], .hpke_pub = [], .log_id = [], .mbox_next = 0, .peers = []};
}

pub Str update_first(Str dir) { return "finish the security update first: symbolon device security-update " + dir; }

// `device key list DIR [--pin]`: the enrolled keys' names, hex, one a
// line. In format 2 the list is sealed: --pin (the PIN on standard input)
// is needed, and shows the list of the profile that PIN opens; no touch
// is asked for. Before format 2, the security-keys file's list.
@requires(filesystem)
pub Int key_list(Str dir) {
    if (keys_v2(dir)) { return dfail("the list opens with the PIN: device key list " + dir + " --pin (the PIN on standard input)"); }
    return print_names(names_of(read_keys(dir).keys, 0, []), 0);
}

@requires(filesystem, device, declassify, provision, network, environment)
pub Int key_list_pin(Str dir) {
    if (!keys_v2(dir)) { return key_list(dir); }
    Option(DeviceConfig) oc = load_config(dir);
    DeviceConfig c = oc else { return_cfg_none() };
    List(Str) ns = shown_names(dir, c, stretch(c, pin_bytes(read_pin())));
    if (ns.len() == 1 && ns[0] == "\n") { return dfail("wrong PIN"); }
    return print_names(ns, 0);
}

// The names in the list the PIN stretched to `st` opens; ["\n"] (no name
// can be a newline) when it opens none.
@requires(filesystem, device, declassify, provision, network, environment)
pub List(Str) shown_names(Str dir, DeviceConfig c, List(Secret(UInt(8))) st) {
    Found f = find_own(dir, c, st, (random_bytes(1)[0] & 1) == 0);
    OwnList o = f.o;
    if (o.which == "") { return ["\n"]; }
    return list_names(o.list);
}

Int print_names(List(Str) ns, Int i) {
    if (i >= ns.len()) { return 0; }
    println(hex_encode(utf8(ns[i])));
    return print_names(ns, i + 1);
}

List(Str) names_of(List(SecKey) ks, Int i, List(Str) acc) {
    if (i >= ks.len()) { return acc; }
    return names_of(ks, i + 1, acc.concat([ks[i].name]));
}

// The unlocked profile's own list (format 2).
@requires(filesystem, declassify)
OwnList own_list(Str dir, Unlocked u) { OwnList o = open_own(dir, u.ukey); return o; }

// A key change's writes (fidokey write_change): the profile's file sealed
// afresh with its list `nl`, its header and blob as they are under the
// same keys; in the other file the slot alone, carrying under the real PIN
// the duress profile's list `next`. One pattern under either PIN, with or
// without a duress PIN (SPEC 14.2).
@requires(filesystem, declassify)
Bool write_list(Str dir, Unlocked u, OwnList o, KeyList nl, Option(KeyList) next) {
    List(Int) blob = read_blob(dir, o.which, u.wrap);
    if (blob.len() != blob_len()) { return false; }
    Bool ok = write_change(dir, o, nl, u.ukey, u.wrap, blob, next);
    return ok;
}

// The duress profile's list with key `name` (credential `cred_id`) sealing
// its W (`dw`, the real list's peer_w) in place of any of that name or
// credential.
@requires(declassify)
KeyList duress_with_key(KeyList dl, Str name, List(Int) cred_id, List(Int) cred_point, List(Secret(UInt(8))) out, List(Secret(UInt(8))) dw) {
    List(SecKey) dks = keys_without_cred(keys_without_name(dl.keys, name, 0, ListBuf()), cred_id, 0, ListBuf()).concat([key_entry(name, cred_id, cred_point, out, dw)]);
    KeyList n = list_with_keys(dl, dks, dw);
    return n;
}

KeyList duress_without_key(KeyList dl, List(Int) cred_id, List(Secret(UInt(8))) dw) {
    KeyList n = list_with_keys(dl, keys_without_cred(dl.keys, cred_id, 0, ListBuf()), dw);
    return n;
}

// `device key add DIR NAME`: the PIN; then the key is touched to make its
// credential and again to give its hmac-secret output.
@requires(filesystem, network, device, declassify, clock, provision, environment)
pub Int key_add(Str dir, Str name) { Int r = key_add_pin(dir, name, read_pin()); return r; }

@requires(filesystem, network, device, declassify, clock, provision, environment)
pub Int key_add_pin(Str dir, Str name, Str pin) {
    if (str_len(name) == 0 || str_len(name) > 64 || str_contains(name, "\n")) { return dfail("a name of 1-64 characters"); }
    Option(DeviceConfig) oc = load_config(dir);
    DeviceConfig c = oc else { return_cfg_none() };
    if (c.log_id.len() == 0) { return dfail("not set up (device new, device init)"); }
    if (!keys_v2(dir)) { return dfail(update_first(dir)); }
    Unlocked u = unlock_dir(dir, c, pin);
    if (u.kind != 1 && u.kind != 2) { return dfail("wrong PIN, or no enrolled key present"); }
    OwnList o = own_list(dir, u);
    if (names_of(o.list.keys, 0, []).contains(name)) { return dfail("a key named " + name + " is already enrolled"); }
    Resp ir = resp_of(fido_exchange(req_get_info()));
    if (ir.status != 0) { return dfail(if (ir.status == -1) { "no security key answers" } else { ctap_status_text(ir.status) }); }
    Info info = info_of(ir.body);
    if (!info.hmac_secret || !info.protocol2) { return dfail("this key lacks hmac-secret or PIN protocol 2 (a FIDO2.1 key is needed)"); }
    eprintln("device: touch the new security key");
    Made m = made_of(resp_of(fido_exchange(req_make_credential(random_bytes(32), "symbolon.unlock", c.party, "symbolon device"))), "symbolon.unlock");
    if (!m.ok) { return dfail(m.why); }
    SecKey fresh = SecKey {.name = name, .cred_id = m.cred_id, .cred_point = m.cred_point, .sealed = []};
    eprintln("device: touch it once more");
    Touch t = touch_key([fresh], o.list.salt, random_bytes(32));
    if (!t.ok) { return dfail(t.why); }
    Int r = key_add_commit(dir, c, u, name, m.cred_id, m.cred_point, t.out);
    return r;
}

// The writes of an add, after the touches (`out`: the key's hmac-secret
// output for the device's salt). The profile's W sealed under it in the
// profile's list; under the real PIN, the duress profile's W in its list
// too (the key opens each profile only with that profile's PIN).
@requires(filesystem, device, declassify, provision, network, environment)
pub Int key_add_commit(Str dir, DeviceConfig c, Unlocked u, Str name, List(Int) cred_id, List(Int) cred_point, List(Secret(UInt(8))) out) {
    OwnList o = own_list(dir, u);
    if (o.which == "" || u.wrap.len() != 32) { return dfail("wrong PIN, or no enrolled key present"); }
    List(SecKey) ks = keys_without_name(o.list.keys, name, 0, ListBuf()).concat([key_entry(name, cred_id, cred_point, out, u.wrap)]);
    KeyList ol = o.list;
    // Under the real PIN, the duress profile's list with the key too (None
    // under the duress PIN, and without a duress PIN).
    Option(KeyList) pl = duress_list(dir, o);
    Option(KeyList) next = match pl { None => None, Some(dl) => Some(duress_with_key(dl, name, cred_id, cred_point, out, ol.peer_w)) };
    if (!write_list(dir, u, o, list_with_keys(ol, ks, u.wrap), next)) { return dfail("cannot write " + profile_file(dir, o.which) + " (at most a few keys fit)"); }
    println("security key " + name + " added; this device now opens only with it (or another enrolled key) present");
    return 0;
}

// `device key fills DIR keys|any`: whether this device fills only with a
// security key (SPEC 22.7 item 2). The PIN, and a touch when a key is
// enrolled: the policy is changed only by whoever can open the device.
@requires(filesystem, network, device, declassify, clock, provision, environment)
pub Int key_fills(Str dir, Str mode) { Int r = key_fills_pin(dir, mode, read_pin()); return r; }

// Under the duress PIN the change is acted (SPEC 14.2): the same unlock,
// list and file write, the same answer for the duress profile's own keys,
// but the device's fill policy is written back as it was, since it is the
// real profile's.
@requires(filesystem, network, device, declassify, clock, provision, environment)
pub Int key_fills_pin(Str dir, Str mode, Str pin) {
    if (mode != "keys" && mode != "any") { return dfail("say keys (fill only with a security key) or any"); }
    Option(DeviceConfig) oc = load_config(dir);
    DeviceConfig c = oc else { return_cfg_none() };
    if (c.log_id.len() == 0) { return dfail("not set up (device new, device init)"); }
    Unlocked u = unlock_dir(dir, c, pin);
    if (u.kind != 1 && u.kind != 2) { return dfail("wrong PIN, or no enrolled key present"); }
    OwnList o = if (keys_v2(dir)) { own_list(dir, u) } else { no_own() };
    KeyList ol = o.list;
    Bool keyed = if (keys_v2(dir)) { ol.keys.len() > 0 } else { keys_enrolled(dir) };
    Str was = filesystem.read_all(fill_policy_file(dir));
    Str written = if (u.kind == 1) { mode + "\n" } else { was };
    if (!filesystem.write_all(fill_policy_file(dir), written)) { return dfail("cannot write " + fill_policy_file(dir)); }
    println(if (mode == "keys") { "fills need a security key" + if (keyed) { "" } else { "; none is enrolled, so this device fills nothing until one is" } } else { "fills need the PIN" + if (keyed) { " and the enrolled key" } else { "" } });
    return 0;
}

// `device key remove DIR NAME`: the PIN and a touch of any enrolled key
// of the profile it opens. Removing the last key returns that profile to
// the PIN alone (W kept in its list).
@requires(filesystem, network, device, declassify, clock, provision, environment)
pub Int key_remove(Str dir, Str name) { Int r = key_remove_pin(dir, name, read_pin()); return r; }

@requires(filesystem, network, device, declassify, clock, provision, environment)
pub Int key_remove_pin(Str dir, Str name, Str pin) {
    Option(DeviceConfig) oc = load_config(dir);
    DeviceConfig c = oc else { return_cfg_none() };
    if (c.log_id.len() == 0) { return dfail("not set up (device new, device init)"); }
    if (!keys_v2(dir)) { return dfail(update_first(dir)); }
    Unlocked u = unlock_dir(dir, c, pin);
    if (u.kind != 1 && u.kind != 2) { return dfail("wrong PIN, or no enrolled key present"); }
    Int r = key_remove_commit(dir, u, name);
    return r;
}

// The writes of a remove, after the unlock: the key out of the profile's
// list; under the real PIN, out of the duress profile's too.
@requires(filesystem, declassify)
pub Int key_remove_commit(Str dir, Unlocked u, Str name) {
    OwnList o = own_list(dir, u);
    Option(SecKey) x = key_named(o.list.keys, name, 0);
    SecKey k = x else { SecKey {.name = "", .cred_id = [], .cred_point = [], .sealed = []} };
    if (str_len(k.name) == 0 || u.wrap.len() != 32) { return dfail("no key named " + name); }
    List(SecKey) rest = keys_without_name(o.list.keys, name, 0, ListBuf());
    KeyList ol = o.list;
    Option(KeyList) pl = duress_list(dir, o);
    Option(KeyList) next = match pl { None => None, Some(dl) => Some(duress_without_key(dl, k.cred_id, ol.peer_w)) };
    if (!write_list(dir, u, o, list_with_keys(ol, rest, u.wrap), next)) { return dfail("cannot write " + profile_file(dir, o.which)); }
    println("security key " + name + " removed" + if (rest.len() == 0) { "; this device opens with the PIN alone" } else { "" });
    return 0;
}
