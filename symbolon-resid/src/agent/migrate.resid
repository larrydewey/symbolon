// After the Paillier nonce fix (SPEC 6.2.1, 6.2.2): the household's one
// re-share, and the root-key rotation advice.
//
// Before the fix, a signature or re-share could carry a Paillier
// ciphertext with the nonce 1, which shows its plaintext to the party that
// receives it: in some cases the counterparty (the cosigner, or a device)
// could work out the household's root key. Nothing kept tells whether it
// happened (only the relay's mail of the last 30 days, which the scan in
// leakscan.resid reads).
//
// 1. The re-share. Once per household after the upgrade, its own quorum
//    re-shares to itself (enroll.resid reshare_in: this device and the
//    cosigner deal, every online party receives, the reshare event is
//    signed by them all as every re-share is, SPEC 8.2): fresh Paillier
//    keys and shares, so a value leaked in part is of no use. No new
//    authority: it is the re-share a device can already ask for, with the
//    same party set (less parties removed in force), checked by the
//    cosigner against the log (reshare_plan_problem). It runs from
//    `device security-update` (the PIN), never under the duress PIN, and is
//    done once this device holds a valid nonce-fix marker (nfmark.resid);
//    until then it can run again at any time, and a run cut short or
//    refused is simply run again. Every party of the session must run the
//    fixed build (session protocol 2, SPEC 6.2.1): an old cosigner or
//    device makes it fail with the party to upgrade, which `device status`
//    then says (`security-reshare waiting-cosigner`).
//    With other devices in the household, each one joins when it runs the
//    update: the first device of the quorum leads at once, any other
//    waits two minutes for an invitation and then leads. An invitation is
//    joined only when it is a refresh of this quorum (refresh_problem): a
//    device that sent anything else (a party added, another threshold,
//    other dealers) is refused, and a leader that sends another chain code
//    or vault key than this device holds is ignored: a device already in
//    the log keeps its own (enroll.resid chosen_secret).
//
// 2. The advice (security_advice): the re-share does not undo a root key
//    that was already worked out, so every household made before the fix
//    is told, in plain words, to replace its root key (a new identity,
//    then each passkey re-registered, SPEC 26.5), "strongly" when it
//    signed more than 300 times or re-shared before the fix, or when that
//    is not known (no build before the fix counted signatures: it is
//    never known for a household made before the fix). Where someone else
//    may hold a device or the root key (a recover or a removed party in
//    the log, a device reported lost, an incident the cosigner's operator
//    reported, or a scan hit) the passkey rollover must not be used (an
//    attacker with the root key can roll over too, SPEC 26.5, A-19): each
//    site's own account recovery instead. Everything the advice rests on
//    is the verified log and this device's own files: the relay can hide
//    the log (then the advice is the strictest) but cannot write a word of
//    it.

import "../types.resid";
import "../core/log.resid";
import "../cosigner/cosigner.resid";
import "../threshold/threshold.resid";
import "../net/proto.resid";
import "../net/services.resid";
import "state.resid";
import "common.resid";
import "session.resid";
import "cosignerd.resid";
import "device.resid";
import "enroll.resid";
import "nfmark.resid";
import "leakscan.resid";
import "ecdsa.resid";
import "crypto.resid";
import "clock.resid";
import "cose.resid";
import "../vault/vault.resid";

// ─── What the user reported (DIR/security-reports) ──────────────
// `device security-advice DIR --report lost|cosigner`: a device of the
// household lost or stolen, or the cosigner's operator reported a security
// incident. One line each, "lost TIME" / "cosigner TIME". A report only
// makes the advice stricter, so it needs no PIN.

pub Str reports_file(Str dir) { return dir + "/security-reports"; }

pub type Reports = { Bool lost; Bool incident; };

pub Reports reports_parse(Str s) {
    List(Str) ls = str_split(s, "\n");
    return Reports {.lost = has_report(ls, "lost", 0), .incident = has_report(ls, "cosigner", 0)};
}

Bool has_report(List(Str) ls, Str kind, Int i) {
    if (i >= ls.len()) { return false; }
    List(Str) f = str_split(str_trim(ls[i]), " ");
    return (f.len() >= 1 && f[0] == kind) || has_report(ls, kind, i + 1);
}

@requires(filesystem)
pub Reports reports_of(Str dir) {
    Reports r = if (filesystem.exists(reports_file(dir))) { reports_parse(filesystem.read_all(reports_file(dir))) } else { Reports {.lost = false, .incident = false} };
    return r;
}

// ─── The mail scan's result (leakscan.resid) ─────────────────

pub type ScanSeen = { Int checked; Int hits; Int unreadable; };

pub ScanSeen scan_none() { return ScanSeen {.checked = -1, .hits = -1, .unreadable = -1}; }

// What the advice takes from the scan (MR-3, MR-7):
//   - a hit counts from any source, and stays: every hit seen is kept in
//     DIR/nonce-hits, and a later clean or empty scan never lowers it;
//   - a clean result counts only when this device's key signed it
//     (DIR/nonce-scan.sig, written by `device scan-leaks` here) and it is
//     no older than the 30 days of mail it read (and not from the
//     future); otherwise the scan reads as not run.
pub Int scan_window_s() { return 30 * 86400; }

pub ScanSeen scan_effective(ScanResult raw, Bool signed_ok, Int now, Int sticky) {
    Int hits = if (raw.hits > sticky) { raw.hits } else { sticky };
    if (hits > 0) { return ScanSeen {.checked = if (raw.checked > 0) { raw.checked } else { 0 }, .hits = hits, .unreadable = if (raw.unreadable > 0) { raw.unreadable } else { 0 }}; }
    Bool fresh = raw.time > 0 && raw.time <= now + 300 && now - raw.time <= scan_window_s();
    if (!signed_ok || !fresh || raw.checked <= 0) { return scan_none(); }
    return ScanSeen {.checked = raw.checked, .hits = 0, .unreadable = raw.unreadable};
}

pub Str hits_file(Str dir) { return dir + "/nonce-hits"; }
pub Str scan_sig_file(Str dir) { return dir + "/nonce-scan.sig"; }

// The most hits any scan of this device has shown ("hits N time T" lines).
pub Int sticky_parse(Str s) { return sticky_from(str_split(s, "\n"), 0, 0); }

Int sticky_from(List(Str) ls, Int i, Int best) {
    if (i >= ls.len()) { return best; }
    List(Str) f = str_split(str_trim(ls[i]), " ");
    Int n = if (f.len() >= 2 && f[0] == "hits") { str_parse_int(f[1]) } else { 0 };
    return sticky_from(ls, i + 1, if (n > best) { n } else { best });
}

@requires(filesystem, clock(readonly))
pub Int sticky_hits(Str dir, Int seen) {
    Str before = if (filesystem.exists(hits_file(dir))) { filesystem.read_all(hits_file(dir)) } else { "" };
    Int kept = sticky_parse(before);
    if (seen > kept) { _ = filesystem.write_all(hits_file(dir), before + f"hits {seen} time {clock_now_seconds()}\n"); }
    return if (seen > kept) { seen } else { kept };
}

// What this device's key signs over a kept scan line.
pub List(Int) scan_tbs(List(Int) log_id, List(Int) party, Str line) {
    return utf8("symbolon v1 nonce-scan").concat([0, log_id.len() & 255]).concat(log_id).concat([party.len() & 255]).concat(party).concat(utf8(str_trim(line)));
}

// The scan as the advice takes it, `key` this device's key in the
// verified quorum ([] when the log could not be had: no clean result
// counts then).
@requires(filesystem, clock(readonly))
pub ScanSeen scan_seen(Str dir, List(Int) log_id, List(Int) party, List(Int) key) {
    ScanResult r = scan_result(dir);
    Str line = if (filesystem.exists(scan_file(dir))) { filesystem.read_all(scan_file(dir)) } else { "" };
    List(Int) sig = if (filesystem.exists(scan_sig_file(dir))) { cose_hex_decode(str_trim(filesystem.read_all(scan_sig_file(dir)))) } else { [] };
    Bool signed_ok = key.len() == 65 && sig.len() == 64 && str_len(line) > 0 && ecdsa_verify_raw(P256, Sha256, key, scan_tbs(log_id, party, line), sig);
    Int sticky = sticky_hits(dir, if (r.hits > 0) { r.hits } else { 0 });
    return scan_effective(r, signed_ok, clock_now_seconds(), sticky);
}

// `symbolon device scan-leaks DIR` (the PIN on standard input): the scan
// (leakscan.resid), its line kept and signed by this device's key, a hit
// kept for good, then its words.
@requires(filesystem, network, device, declassify, clock, environment, provision)
pub Int device_scan_leaks_kept(Str dir) {
    Str pin = read_pin();
    LeakScan r = device_scan_result(dir, pin);
    _ = keep_scan(dir, pin, r);
    _ = print_lines(scan_words(r), 0);
    return scan_exit(r);
}

@requires(filesystem, network, device, declassify, clock, environment, provision)
Bool keep_scan(Str dir, Str pin, LeakScan r) {
    if (str_len(r.problem) > 0) { return false; }
    Str line = scan_line(r, clock_now_seconds());
    _ = filesystem.write_all(scan_sig_file(dir), "");
    if (!filesystem.write_all(scan_file(dir), line + "\n")) { return false; }
    _ = sticky_hits(dir, r.hits);
    Option(DeviceConfig) oc = load_config(dir);
    return match oc { None => false, Some(c) => sign_scan(dir, c, pin, line) };
}

@requires(filesystem, network, device, declassify, clock, environment, provision)
Bool sign_scan(Str dir, DeviceConfig c, Str pin, Str line) {
    Unlocked u = unlock_dir(dir, c, pin);
    if (u.kind != 1) { return false; }
    Result(List(Int), Str) s = dk_sign(c, u.real, u.st, scan_tbs(c.log_id, c.party, line));
    List(Int) sig = match s { Ok(x) => x, Err(_) => [] };
    return sig.len() == 64 && filesystem.write_all(scan_sig_file(dir), hex_encode(sig) + "\n");
}

// ─── The advice ─────────────────────────────────────────────────

// log_ok: the log verified now; hidden: events the witnesses co-signed
// that the relay does not serve; born: the household was made by a fixed
// build (nfmark); prefix_reshares: re-shares before the fix; sigs: the
// signatures before the fix, -1 when not known; lost_log: a recover or a
// removed party in the log; lost, incident: what the user reported; scan:
// the mail scan (-1: it has not run).
pub type AdviceIn = { Bool log_ok; Int hidden; Bool born; Int prefix_reshares; Int sigs; Bool lost_log; Bool lost; Bool incident; ScanSeen scan; };

// level: "none", "recommended", "strongly-recommended" or "compromised";
// rollover: "ok" or "avoid".
pub type Advice = { Str level; Str rollover; List(Str) lines; };

pub Int many_sigs() { return 300; }

pub Str adv_what() {
    return "What happened: an older version of Symbolon had a flaw. In rare cases it could let your cosigner or one of your devices work out your household key, while signing in somewhere or while a device was added. No one can tell for sure whether it happened to your household.";
}
pub Str adv_compromised() { return "A check of your recent messages found that it did happen. Treat your household key as known to someone else: they may be able to sign in as you."; }
pub Str adv_do_strong() { return "We strongly recommend a new household key."; }
pub Str adv_do_rec() { return "We recommend a new household key."; }
pub Str adv_do_now() { return "Make a new household key now."; }
pub Str adv_why_unknown() { return "Why: Symbolon did not count signatures before the fix, so it cannot tell how often your key was used."; }
pub Str adv_why_many() { return "Why: your key signed more than 300 times before the fix."; }
pub Str adv_why_reshare() { return "Why: a device was added, or your keys were refreshed, before the fix."; }
pub Str adv_why_lost() { return "Why: someone else may hold one of your devices."; }
pub Str adv_avoid_lost() { return "Your identity log shows a recovery or a removed device, so someone else may hold one of your devices."; }
pub Str adv_avoid_reported() { return "You reported a lost or stolen device."; }
pub Str adv_avoid_incident() { return "Your cosigner's operator reported a security incident."; }
pub Str adv_avoid_unchecked() { return "Symbolon could not check your identity log just now, so it cannot rule out a lost device. Until it can, follow the stricter advice."; }
pub Str adv_steps() { return "What to do, in this order:"; }
pub Str adv_step_new() { return "  1. Create a new household key (Symbolon calls this a root-key rotation)."; }
// Moving each login when the old key is the household's alone (SPEC 26.5
// methods 2 and 3) ...
pub Str adv_rollover_ok() { return "  2. For each website or service, sign in and add a passkey from the new key in the site's security settings."; }
pub Str adv_rollover_ok_2() { return "  3. Check that the new passkey works, then remove the old one."; }
// ... and when someone else may hold it (A-19): each site's own recovery.
pub Str adv_rollover_avoid_2() { return "  2. For each website or service, move your login to the new key using that site's own account recovery or security settings."; }
pub Str adv_rollover_avoid() { return "  3. Don't use the rollover browser extension for this: whoever has the old key could use it too."; }
pub Str adv_scan_never(Str dir) {
    return "Also check your recent messages soon: the relay keeps them for 30 days only. Run `symbolon device scan-leaks " + dir + "` (it asks for your PIN).";
}
pub Str adv_scan_clean(ScanSeen s) {
    Str part = if (s.unreadable > 0) { f" ({s.unreadable} could not be read)" } else { "" };
    return f"The check of your recent messages found no problem in the {s.checked} it could read{part}. Older messages are gone, so this can't prove nothing happened.";
}
pub Str adv_born() { return "Your household key was made after the fix. There is nothing to do."; }

pub Advice security_advice(AdviceIn a, Str dir) {
    Bool hit = a.scan.hits > 0;
    Bool other_hands = a.lost_log || a.lost || a.incident;
    // A marker is a fact about an epoch: it never outweighs a sign that
    // someone else may hold a device or the key (MR-2).
    if (a.born && a.log_ok && !hit && !other_hands && a.hidden == 0) { return Advice {.level = "none", .rollover = "ok", .lines = [adv_born()]}; }
    Bool avoid = hit || other_hands || !a.log_ok || a.hidden > 0;
    Str level = if (hit) { "compromised" } else {
        if (a.prefix_reshares > 0 || a.sigs < 0 || a.sigs > many_sigs() || other_hands || !a.log_ok) { "strongly-recommended" } else { "recommended" } };
    List(Str) why = if (level != "strongly-recommended") { [] } else {
        if (other_hands) { [adv_why_lost()] } else { if (a.prefix_reshares > 0) { [adv_why_reshare()] } else { if (a.sigs < 0) { [adv_why_unknown()] } else { [adv_why_many()] } } } };
    List(Str) head = if (hit) { [adv_what(), adv_compromised(), adv_do_now()] } else { [adv_what(), if (level == "recommended") { adv_do_rec() } else { adv_do_strong() }] };
    List(Str) reasons = (if (a.lost_log) { [adv_avoid_lost()] } else { [] }).concat(if (a.lost) { [adv_avoid_reported()] } else { [] })
        .concat(if (a.incident) { [adv_avoid_incident()] } else { [] }).concat(if (!a.log_ok || a.hidden > 0) { [adv_avoid_unchecked()] } else { [] });
    List(Str) scan = if (hit) { [] } else { if (a.scan.checked <= 0) { [adv_scan_never(dir)] } else { [adv_scan_clean(a.scan)] } };
    List(Str) steps = [adv_steps(), adv_step_new()].concat(if (avoid) { [adv_rollover_avoid_2(), adv_rollover_avoid()] } else { [adv_rollover_ok(), adv_rollover_ok_2()] });
    List(Str) lines = head.concat(why).concat(reasons).concat(steps).concat(scan);
    return Advice {.level = level, .rollover = if (avoid) { "avoid" } else { "ok" }, .lines = lines};
}

// ─── The re-share's state ───────────────────────────────────────

// "done" (a valid marker), "waiting-cosigner" (the last re-share ended on
// the cosigner's old build), "waiting-device" (on another party's old
// build), or "due".
pub Str reshare_state(Bool done, Str fail, List(Int) cos) {
    if (done) { return "done"; }
    if (!str_starts_with(str_trim(fail), old_build_prefix())) { return "due"; }
    Str short = hex_encode(if (cos.len() > 8) { cos[0..8] } else { cos });
    return if (str_len(short) > 0 && str_contains(fail, short)) { "waiting-cosigner" } else { "waiting-device" };
}

pub Str reshare_words(Str state, Str dir) {
    if (state == "done") { return "Your household's keys were refreshed after the fix."; }
    if (state == "waiting-cosigner") {
        return "The key refresh is waiting for your cosigner to be updated. Whoever runs your cosigner (your Symbolon Home box, or your provider) must install the update first; then finish the security update here again.";
    }
    if (state == "waiting-device") {
        return "The key refresh is waiting for another of your devices to be updated. Update Symbolon on each of your devices, then finish the security update here again.";
    }
    return "Symbolon needs to refresh your household's keys once after a fix to its signing software. It takes a few minutes with your cosigner: run `symbolon device security-update " + dir + "` (or tap \"Finish the update\" in the app), with your other devices at hand.";
}

// The reminder after every device command (main.resid): files only, the
// same under either PIN.
@requires(filesystem)
pub Bool reshare_due_here(Str dir) {
    Option(DeviceConfig) oc = load_config(dir);
    return match oc { None => false, Some(c) => c.log_id.len() > 0 && !fix_mark_present(dir) };
}

pub Str reshare_reminder(Str dir) {
    return "Finish the security update: run `symbolon device security-update " + dir + "`. It refreshes your household's keys once after a fix to the signing software; then see `symbolon device security-advice " + dir + "`.";
}

// ─── What the device knows now ──────────────────────────────────

pub type Known = { Bool log_ok; Advice advice; Str reshare; };

@requires(filesystem, network, clock(readonly), declassify)
pub Known known_now(Str dir, DeviceConfig c) {
    Result(WitnessedView, SymbolonError) rv = log_seen(dir, relay_ep(c), c.log_id, "");
    Reports rp = reports_of(dir);
    Str fail = filesystem.read_all(reshare_fail_file(dir));
    return match rv {
        Err(_) => Known {.log_ok = false, .reshare = if (fix_mark_present(dir)) { "unknown" } else { reshare_state(false, fail, []) },
            .advice = security_advice(AdviceIn {.log_ok = false, .hidden = 0, .born = false, .prefix_reshares = 0, .sigs = -1, .lost_log = false, .lost = rp.lost, .incident = rp.incident, .scan = scan_seen(dir, c.log_id, c.party, [])}, dir)},
        Ok(w) => known_in(dir, c, w, rp, fail)
    };
}

@requires(filesystem, clock(readonly))
Known known_in(Str dir, DeviceConfig c, WitnessedView w, Reports rp, Str fail) {
    Quorum q = w.view.vh.head.quorum;
    FixState st = fix_mark_check(fix_mark_read(dir), c.log_id, c.party, q, w.view.events);
    FixFacts f = fix_facts(w.view.events, st);
    Party cos = cosigner_of(q.parties, 0) else { none_party() };
    AdviceIn a = AdviceIn {.log_ok = true, .hidden = w.hidden, .born = st.ok && st.born, .prefix_reshares = f.prefix_reshares, .sigs = if (st.ok && st.born) { 0 } else { -1 },
                           .lost_log = f.recovers + f.removals > 0, .lost = rp.lost, .incident = rp.incident, .scan = scan_seen(dir, c.log_id, c.party, fix_device_key(q.parties, c.party))};
    return Known {.log_ok = true, .advice = security_advice(a, dir), .reshare = reshare_state(st.ok, fail, cos.id)};
}

// ─── `device status` and `device security-advice` ──────────────

// `device status`, then the migration's lines (each "key value"):
//   security-reshare done|due|waiting-cosigner|waiting-device|unknown
//   rotation none|recommended|strongly-recommended|compromised
//   rotation-rollover ok|avoid
@requires(filesystem, network, clock(readonly), declassify)
pub Int device_status_plus(Str dir) {
    Option(DeviceConfig) oc = load_config(dir);
    return match oc { None => device_status(dir), Some(c) => if (c.log_id.len() == 0) { device_status(dir) } else { status_then(dir, known_now(dir, c)) } };
}

// These lines come first and the status's own lines last, as before: a
// reader that stops at the line it wants (`grep -q 'head sequence ...'`)
// is gone before any later write, which would end this process with
// SIGPIPE (and fail a `set -o pipefail` script).
@requires(filesystem, network, clock(readonly), declassify)
Int status_then(Str dir, Known k) {
    _ = status_lines(dir, k, 0);
    Int r = device_status(dir);
    return r;
}

Int status_lines(Str dir, Known k, Int r) {
    println("security-reshare " + k.reshare);
    println("rotation " + k.advice.level);
    println("rotation-rollover " + k.advice.rollover);
    if (k.advice.level != "none") { eprintln("Your household should act after a security fix: see `symbolon device security-advice " + dir + "`."); }
    return r;
}

// `device security-advice DIR [--report lost|cosigner]`: the advice in
// words; a report is kept first.
@requires(filesystem, network, clock, declassify)
pub Int device_security_advice(Str dir, Str report) {
    Option(DeviceConfig) oc = load_config(dir);
    if (match oc { None => true, Some(_) => false }) { return dfail("not set up"); }
    if (str_len(report) > 0 && report != "lost" && report != "cosigner") { return dfail("--report takes lost (a device lost or stolen) or cosigner (an incident your cosigner's operator reported)"); }
    if (str_len(report) > 0) {
        Str before = if (filesystem.exists(reports_file(dir))) { filesystem.read_all(reports_file(dir)) } else { "" };
        if (!filesystem.write_all(reports_file(dir), before + report + f" {clock_now_seconds()}\n")) { return dfail("cannot store the report"); }
        println("report kept: the advice below takes it into account");
    }
    return match oc { None => dfail("not set up"), Some(c) => advice_for(dir, c) };
}

@requires(filesystem, network, clock(readonly), declassify)
Int advice_for(Str dir, DeviceConfig c) {
    if (c.log_id.len() == 0) { println("Not in an identity yet: nothing to do."); return 0; }
    Known k = known_now(dir, c);
    println(reshare_words(k.reshare, dir));
    return print_lines(k.advice.lines, 0);
}

Int print_lines(List(Str) ls, Int i) {
    if (i >= ls.len()) { return 0; }
    println(ls[i]);
    return print_lines(ls, i + 1);
}

// ─── The re-share (`device security-update`, after the update) ──

// Whether `inv` may be joined as this household's refresh: for log `l`
// and the quorum `q` in force (`removed`: parties removed in force), from
// another device of q that signed it, at session protocol 2 or later, with
// the same parties (less those removed), the requester and the cosigner
// dealing, the threshold kept. "" when it may.
pub Str refresh_problem(ReshareInvite inv, List(Int) l, List(Int) me, Quorum q, List(List(Int)) removed) {
    if (!bytes_eq(inv.log_id, l) || inv.epoch != (Int)q.epoch + 1) { return "the invitation is for another log or epoch"; }
    if (inv.proto < session_proto_min()) { return old_build_refusal("the inviting device", inv.proto); }
    Party rq = party_of_id(q.parties, inv.requester, 0) else { none_party() };
    if (rq.id.len() == 0 || rq.kind != party_kind_device() || bytes_eq(rq.id, me)) { return "the invitation is not from another device of this household"; }
    if (!ecdsa_verify_raw(P256, Sha256, rq.auth_key, request_tbs(inv.session_id, reshare_message(inv), q.epoch, inv.requester, request_reshare()), inv.sig)) {
        return "the invitation is not signed by the device it names";
    }
    List(Party) keep = kept_parties(q.parties, removed, 0, []);
    if (!parties_same(inv.new_parties, keep, 0)) { return "the invitation changes who is in the household: it is not a refresh, refused"; }
    Party cos = cosigner_of(q.parties, 0) else { none_party() };
    List(Int) dealers = [pos1(q.parties, inv.requester, 0), pos1(q.parties, cos.id, 0)];
    if (cos.id.len() == 0 || !ints_same(inv.dealers, dealers) || inv.degree != (Int)q.t - 1) { return "the invitation changes the dealers or the threshold: refused"; }
    if (!ints_same(inv.receivers, receivers_of(inv.new_parties, 0, [])) || !ints_same(inv.offline, offline_of(inv.new_parties, 0, []))) { return "the invitation's receivers do not follow the parties: refused"; }
    if (pos1(inv.new_parties, me, 0) == 0) { return "this device is not in that re-share"; }
    return "";
}

Option(Party) party_of_id(List(Party) ps, List(Int) id, Int i) {
    if (i >= ps.len()) { return None; }
    if (bytes_eq(ps[i].id, id)) { return Some(ps[i]); }
    return party_of_id(ps, id, i + 1);
}

pub List(Party) kept_parties(List(Party) ps, List(List(Int)) removed, Int i, List(Party) acc) {
    if (i >= ps.len()) { return acc; }
    return kept_parties(ps, removed, i + 1, if (id_in(removed, ps[i].id, 0)) { acc } else { acc.concat([ps[i]]) });
}

Bool id_in(List(List(Int)) xs, List(Int) id, Int i) { return i < xs.len() && (bytes_eq(xs[i], id) || id_in(xs, id, i + 1)); }


Bool ints_same(List(Int) a, List(Int) b) { return a.len() == b.len() && ints_same_from(a, b, 0); }

Bool ints_same_from(List(Int) a, List(Int) b, Int i) { return i >= a.len() || (a[i] == b[i] && ints_same_from(a, b, i + 1)); }

// The other devices of the quorum (removed ones left out), as remotes.
List(Remote) other_devices(List(Party) ps, List(Int) me, Int i, List(Remote) acc) {
    if (i >= ps.len()) { return acc; }
    Bool other = ps[i].kind == party_kind_device() && !bytes_eq(ps[i].id, me);
    return other_devices(ps, me, i + 1, if (other) { acc.concat([Remote {.party = ps[i].id, .cg = 0, .hpke_pub = ps[i].hpke_key}]) } else { acc });
}

// Whether `me` is the quorum's first device (it leads at once).
Bool first_device(List(Party) ps, List(Int) me, Int i) {
    if (i >= ps.len()) { return false; }
    if (ps[i].kind == party_kind_device()) { return bytes_eq(ps[i].id, me); }
    return first_device(ps, me, i + 1);
}

pub Int invite_wait_s() { return 120; }

// The re-share step of `device security-update DIR` (secupdate.resid),
// after the update itself. Done already: says so, under any PIN (a check of
// the verified log and this device's marker, nothing else). Otherwise
// under the PIN only: the duress PIN fails as a change does (SPEC 14).
@requires(filesystem, network, device, declassify, clock, provision, environment)
pub Int nonce_reshare(Str dir, Str pin, Str primes) {
    Option(DeviceConfig) oc = load_config(dir);
    return match oc { None => dfail("not set up"), Some(c) => if (c.log_id.len() == 0) { 0 } else { reshare_with_log(dir, c, pin, primes) } };
}

@requires(filesystem, network, device, declassify, clock, provision, environment)
Int reshare_with_log(Str dir, DeviceConfig c, Str pin, Str primes) {
    Result(LogView, SymbolonError) rv = log_view_dir(dir, relay_ep(c), c.log_id, "");
    return match rv {
        Err(e) => dfail("the key refresh needs your identity log, which does not verify now: " + err_text(e)),
        Ok(v) => reshare_at(dir, c, v, pin, primes)
    };
}

@requires(filesystem, network, device, declassify, clock, provision, environment)
Int reshare_at(Str dir, DeviceConfig c, LogView v, Str pin, Str primes) {
    if (fix_mark_check(fix_mark_read(dir), c.log_id, c.party, v.vh.head.quorum, v.events).ok) { println("security re-share: done already"); return 0; }
    Unlocked u = unlock_dir(dir, c, pin);
    if (u.kind == 2) { return dfail(duress_refusal(dir, c)); }
    if (u.kind != 1) { return dfail("wrong PIN"); }
    // A share kept aside and taken into use since (MR-9): its epoch is
    // marked now, the PIN given.
    SharePending pr = next_share_parse(filesystem.read_all(next_share_promoted(dir)));
    if (pr.epoch >= 0 && mark_fixed_quorum(dir, u, pr.epoch, pr.transcript, [], false)) {
        _ = filesystem.write_all(next_share_promoted(dir), "");
        println("security re-share: done already");
        return 0;
    }
    Option(CgConfig) cg = load_share(dir, u.real.dek);
    return match cg { None => dfail("no share"), Some(x) => reshare_or_join(dir, c, u, x, v, pin, primes) };
}

@requires(filesystem, network, device, declassify, clock, provision, environment)
Int reshare_or_join(Str dir, DeviceConfig c, Unlocked u, CgConfig x, LogView v, Str pin, Str primes) {
    Quorum q = v.vh.head.quorum;
    Party cos = cosigner_of(q.parties, 0) else { none_party() };
    if (cos.id.len() == 0) { return dfail("this identity has no cosigner: nothing to refresh with"); }
    Int t_last = last_time(v.events, policy_of_e0(v.events));
    Int t_wit = witness_now(v.vh.head.policy.witnesses, relay_ep(c).ca, random_bytes(32));
    Option(Membership) om = il_membership(c.log_id, v.events, if (t_wit > t_last) { t_wit } else { t_last }, lambda(p) { false });
    return match om { None => dfail("the identity log does not verify now"), Some(mem) => reshare_in_force(dir, c, u, x, v, pin, primes, mem) };
}

@requires(filesystem, network, device, declassify, clock, provision, environment)
Int reshare_in_force(Str dir, DeviceConfig c, Unlocked u, CgConfig x, LogView v, Str pin, Str primes, Membership mem) {
    Quorum q = v.vh.head.quorum;
    if (mem.rotated_to.len() > 0) { return dfail("a recovery kit replacement is under way: finish it first (`symbolon device kit renew " + dir + "`); its re-share is the key refresh"); }
    List(Remote) others = other_devices(kept_parties(q.parties, mem.removed, 0, []), c.party, 0, []);
    if (others.len() == 0) { return lead(dir, c, u, x, v.vh, q, mem, pin, primes); }
    Local me = Local {.party = c.party, .cg = 0, .hpke_sk = device_transport(c, u.real.dek).sk};
    Int wait = if (first_device(q.parties, c.party, 0)) { 0 } else { invite_wait_s() };
    if (wait > 0) { println(f"security re-share: waiting up to {wait} s for another of your devices to start it..."); }
    Waited w = wait_wire(mail_ep(dir, c, u), me, others, Cursor {.party = c.party, .next = c.mbox_next}, clock_now_seconds(), wait, 1);
    Option(Packet) ow = w.w;
    return match ow {
        None => lead(dir, c, u, x, v.vh, q, mem, pin, primes),
        Some(p) => match p { WReshare(inv) => join_refresh(dir, c, u, inv, w, q, mem, pin, primes), _ => lead(dir, c, u, x, v.vh, q, mem, pin, primes) }
    };
}

@requires(filesystem, network, device, declassify, clock, provision, environment)
Int join_refresh(Str dir, DeviceConfig c, Unlocked u, ReshareInvite inv, Waited w, Quorum q, Membership mem, Str pin, Str primes) {
    Str bad = refresh_problem(inv, c.log_id, c.party, q, mem.removed);
    if (str_len(bad) > 0) { return dfail("security re-share: " + bad); }
    Party rq = party_of_id(q.parties, inv.requester, 0) else { none_party() };
    println("security re-share: joining the refresh another of your devices started...");
    Int r = join_session(dir, c, u, Remote {.party = rq.id, .cg = 0, .hpke_pub = rq.hpke_key}, inv, w, pin, primes);
    return done_or(dir, r);
}

@requires(filesystem, network, device, declassify, clock, provision, environment)
Int lead(Str dir, DeviceConfig c, Unlocked u, CgConfig x, VerifiedHead vh, Quorum q, Membership mem, Str pin, Str primes) {
    List(Party) np = kept_parties(q.parties, mem.removed, 0, []);
    if (other_devices(np, c.party, 0, []).len() > 0) {
        println("security re-share: your other devices take part: on each, finish the security update now (`symbolon device security-update DIR`, or \"Finish the update\" in the app).");
    }
    println("security re-share: refreshing your household's keys with the cosigner (this can take minutes)...");
    Int r = reshare_in(dir, c, u, x, vh, np, pin, primes, kv_mode_of(dir, u, q, c.party, false));
    return done_or(dir, r);
}

@requires(filesystem, network, clock(readonly), declassify)
Int done_or(Str dir, Int r) {
    if (r == 0) { println("security re-share: done"); return 0; }
    Option(DeviceConfig) oc = load_config(dir);
    List(Int) cos = match oc { None => [], Some(c) => cos_id_of(verified_log(relay_ep(c), c.log_id)) };
    eprintln(reshare_words(reshare_state(false, filesystem.read_all(reshare_fail_file(dir)), cos), dir));
    return r;
}

List(Int) cos_id_of(Result(VerifiedHead, SymbolonError) rv) {
    Party p = match rv { Ok(vh) => cosigner_of(vh.head.quorum.parties, 0) else { none_party() }, Err(_) => none_party() };
    return p.id;
}
