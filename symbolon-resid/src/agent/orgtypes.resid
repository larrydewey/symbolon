// Organizations (SPEC 29) as the server stores them. Governance (owners,
// administrators, policy, recovery) is a chain of records each signed by
// an owner of the one before ("orggov-<id>-<version>"), from a founder
// bound into the org id, so a device verifies it with no history of its
// own. The membership record ("org-<id>") cites the governance version it
// was signed under; owners and administrators sign it. A group folder
// ("gfolder-<id>") is a shared collection whose people are the members of
// its groups.

import "../types.resid";

//@ serial
pub type OrgAdmin = { List(Int) log_id; Str label; };

//@ serial
pub type OrgPolicy = {
    Int min_pin_len;
    Bool allow_biometric;
    Bool allow_duress;
    Bool allow_offline_copy;
    Int max_offline_days;                // 0: no limit
    Bool allow_personal_export;
    List(Str) require_attestation;
    Str password_rules;
};

// Opt-in recovery of work folders (SPEC 29.8); off unless the owners turn it on.
//@ serial
// `public_key`: HPKE P-256, its private key split among `admins` (Shamir,
// `threshold` of them), the shares wrapped to them by `owner` at
// governance version `since` (SPEC 29.8).
pub type OrgRecovery = { Bool on; List(Int) public_key; Int threshold; List(List(Int)) admins; Int delay_sec; UInt(64) since; List(Int) owner; };

// "orggov-<id>-<version>": version 1 is signed by the founder; each later
// one by an owner of the version before.
//@ serial
pub type OrgGov = {
    List(Int) org_id;                    // first 16 bytes of SHA-256("symbolon v1 org" || founder || nonce)
    UInt(64) version;
    List(Int) founder;                   // the founder's log id
    List(Int) nonce;                     // 16 random bytes
    Str name;
    List(List(Int)) owners;
    List(OrgAdmin) admins;
    OrgPolicy policy;
    OrgRecovery recovery;
    UInt(64) log_sequence;               // signer's log sequence
    List(Int) signer_log;
    List(Int) signer;                    // party id of the signing device
    List(Int) sig;
};

//@ serial
pub type OrgMember = { List(Int) log_id; Str label; Str ext_id; };

//@ serial
pub type OrgGroup = { List(Int) group_id; Str name; List(List(Int)) members; };

// "org-<id>": who is in the organization and its groups.
//@ serial
pub type Org = {
    List(Int) org_id;
    UInt(64) version;
    UInt(64) gov_version;                // must be the latest governance version
    List(OrgMember) members;             // everyone, owners and administrators too
    List(OrgGroup) groups;
    UInt(64) log_sequence;
    List(Int) signer_log;                // an owner or administrator at gov_version
    List(Int) signer;
    List(Int) sig;
};

// "gfolder-<id>": a group folder.
//@ serial
pub type GroupFolder = {
    List(Int) coll_id;
    UInt(64) version;
    List(Int) org_id;
    List(List(Int)) groups;
    List(Int) name_ct;                   // the name, sealed under the folder key at this version
    Bool deleted;
    UInt(64) log_sequence;
    List(Int) signer_log;                // an owner or administrator
    List(Int) signer;
    List(Int) sig;
};

// "audit-<org>-<log>-<seq>": what a device did, chained per device.
//@ serial
pub type AuditEvent = {
    List(Int) org_id;
    List(Int) log_id;
    List(Int) party;
    UInt(64) seq;
    List(Int) prev;                      // SHA-256 of the previous event's CBOR, empty for the first
    Int time;
    Str action;
    Str object;
    Str detail;
    List(Int) sig;
};

// "invite-<org>-<id>": an administrator's invitation for one person from
// the company directory. The invite code is a key: `public_key` is its
// P-256 public key, `id` the first 16 bytes of SHA-256("symbolon v1
// invite" || public_key), so neither the server nor anyone without the
// code can answer it.
//@ serial
pub type OrgInvite = {
    List(Int) org_id;
    List(Int) id;
    List(Int) public_key;
    Str ext_id;
    Str label;
    List(List(Int)) groups;
    Int expires;                         // seconds since the epoch, by witness time
    UInt(64) log_sequence;
    List(Int) signer_log;                // an owner or administrator
    List(Int) signer;
    List(Int) sig;
};

// "accept-<org>-<id>": a device answering an invite: the code's key signs
// the person's log id, and a device of that log signs the whole.
//@ serial
pub type OrgAccept = {
    List(Int) org_id;
    List(Int) id;
    List(Int) log_id;
    List(Int) code_sig;                  // by the invite's key over "symbolon v1 accept" || org_id || log_id
    UInt(64) log_sequence;
    List(Int) signer;
    List(Int) sig;
};

// "escrow-<org>-<cid>": a work folder's key sealed to the organization's
// recovery key by the folder's owner (SPEC 29.8).
//@ serial
pub type OrgEscrow = {
    List(Int) org_id;
    List(Int) coll_id;
    List(Int) owner;                     // the folder's owner, who signs
    UInt(64) roster_version;             // the key is the folder's at this version
    List(Int) enc;
    List(Int) ct;
    UInt(64) log_sequence;
    List(Int) signer;
    List(Int) sig;
};

// "recreq-<org>-<cid>": a recovery administrator asks to open a work
// folder; the others approve no earlier than `time` + the delay.
//@ serial
pub type OrgRecoveryRequest = {
    List(Int) org_id;
    List(Int) coll_id;
    List(Int) requester;
    Int time;                            // witness time of the request
    UInt(64) log_sequence;
    List(Int) signer;
    List(Int) sig;
};

// "conkey-<org>-<id>": a passkey an owner or administrator uses to sign in
// to the relay's console (SPEC 29.10), approved by one of their devices;
// `id` is the first 16 bytes of SHA-256 of the credential id.
//@ serial
pub type OrgConsoleKey = {
    List(Int) org_id;
    List(Int) cred_id;
    List(Int) public_key;                // uncompressed P-256 point
    Str rp_id;
    List(Int) log_id;                    // the administrator
    UInt(64) log_sequence;
    List(Int) signer;
    List(Int) sig;
};
