// The Android Keystore profile (SPEC 9.1): on a phone the app, not the
// agent, can reach the hardware key store, so the agent asks it. The app
// serves loopback HTTP on a random port; SYMBOLON_KEYSTORE = "PORT TOKEN"
// tells the agent where, and the token (random per app start) keeps other
// apps on the phone out. The keys are made non-exportable in StrongBox
// where the phone has it (else the TEE) and usable only while the phone is
// unlocked:
//   unlock_a, unlock_b   HMAC-SHA256 keys; an unlock key is
//                        HMAC(key, stretched PIN || salt), as the TPM's HMAC
//                        is in the TPM profile
//   dk                   the device key (ECDSA P-256)
// Unlike a TPM, the Keystore keeps no count of wrong PINs: copying the
// device's files gains nothing without the phone's chip, but someone who
// runs code as this app on the unlocked phone can try PINs at the speed
// of the PIN stretch. The profile is marked by DeviceConfig.tpm_dk ==
// keystore_profile() (no TPM handle is negative).

import "../types.resid";
import "../duress/duress.resid";
import "state.resid";
import "common.resid";
import "crypto.resid";
import "cose.resid";
import "../net/services.resid";

pub Int keystore_profile() { return -2; }

pub Bool on_keystore(DeviceConfig c) { return !c.unprotected && c.tpm_dk == keystore_profile(); }

// The key's name in the Keystore: per device (its salt), so devices in
// other directories keep their own keys.
pub Str ks_alias(DeviceConfig c, Str name) { return "symbolon-" + hex_encode(c.salt) + "-" + name; }

// One request to the app: the body back, or why not.
@requires(environment, network)
pub Result(List(Int), Str) ks_call(Str op, Str alias, List(Int) body) {
    List(Str) e = str_split(str_trim(environment.get("SYMBOLON_KEYSTORE")), " ");
    if (e.len() != 2) { return Err("the Android Keystore is reached through the Symbolon app (SYMBOLON_KEYSTORE is not set)"); }
    HttpOut r = http_call_bytes("127.0.0.1", str_parse_int(e[0]), "POST", "/" + op + "?t=" + e[1] + "&k=" + alias, body);
    if (r.status == 200) { return Ok(r.body); }
    return Err(if (r.status == 0) { "the app's key store does not answer" } else { "Keystore: " + http_text(r.body, 0, r.body.len()) });
}

// The unlock key under `name` for the stretched PIN `st`, or [].
@requires(environment, network, declassify, provision)
pub List(Secret(UInt(8))) ks_unlock_key(DeviceConfig c, Str name, List(Secret(UInt(8))) st) {
    Result(List(Int), Str) h = ks_call("hmac", ks_alias(c, name), reveal(st).concat(c.salt));
    return match h {
        Ok(b) => if (b.len() != 32) { [] } else { unlock_key(provisioned_key(secret_bytes(b), "the Keystore's HMAC of the stretched PIN under a hardware-held unlock key"), c.salt) },
        Err(_) => []
    };
}

@requires(environment, network)
pub Bool ks_make_hmac(DeviceConfig c, Str name) { return match ks_call("create-hmac", ks_alias(c, name), []) { Ok(_) => true, Err(_) => false }; }

// The device key's public point (65 bytes), made in the Keystore.
@requires(environment, network)
pub Result(List(Int), Str) ks_make_dk(DeviceConfig c) {
    Result(List(Int), Str) r = ks_call("create-ec", ks_alias(c, "dk"), []);
    return match r { Err(m) => Err(m), Ok(p) => if (p.len() == 65) { Ok(p) } else { Err("Keystore: no device key") } };
}

// r || s over SHA-256(msg).
@requires(environment, network)
pub Result(List(Int), Str) ks_sign(DeviceConfig c, List(Int) msg) {
    Result(List(Int), Str) r = ks_call("sign", ks_alias(c, "dk"), sha256_bytes(msg));
    return match r { Err(m) => Err(m), Ok(s) => if (s.len() == 64) { Ok(s) } else { Err("Keystore: no signature") } };
}

@requires(environment, network)
pub Int ks_forget(DeviceConfig c) {
    Int n = (if (ks_delete(c, "dk")) { 1 } else { 0 }) + (if (ks_delete(c, "unlock_a")) { 1 } else { 0 }) + (if (ks_delete(c, "unlock_b")) { 1 } else { 0 });
    println(f"removed {n} Keystore key(s)");
    return 0;
}

@requires(environment, network)
Bool ks_delete(DeviceConfig c, Str name) { return match ks_call("delete", ks_alias(c, name), []) { Ok(_) => true, Err(_) => false }; }
