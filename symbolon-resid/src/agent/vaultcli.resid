// The legacy vault from the command line (SPEC 18): `symbolon device vault
// put | get | list`. The vault lives at the relay as one CBOR VaultState
// (blob "vault-<log id>"): items sealed field by field under the vault key,
// and a head signed by a device's DK over the items' Merkle root, anchored
// to the verified log. A device accepts a state only through vault_accept
// and never one older than it accepted before (vault.version, A-14), nor
// another state at the version it accepted (a fork, SPEC 18.4).

import "../types.resid";
import "../core/log.resid";
import "../vault/vault.resid";
import "../duress/duress.resid";
import "../net/services.resid";
import "state.resid";
import "common.resid";
import "device.resid";
import "auditlog.resid";
import "protect.resid";
import "serials.resid";
import "crypto.resid";
import "word.resid";
import "cbor.resid";
import "cose.resid";
import "httpserv.resid";

pub List(Int) vault_id_of(List(Int) log_id) { return sha256_bytes(utf8("symbolon v1 vault").concat(log_id)); }

Str vault_blob(List(Int) log_id) { return "vault-" + hex_encode(log_id); }

// Where items live: the person's own vault (share ""), or a shared
// collection (SPEC 19; share is its id in hex) with its own key.
pub type Place = { Str share; List(Secret(UInt(8))) vk; List(Int) vid; };

pub Place own_place(DeviceConfig c, Unlocked u) { return Place {.share = "", .vk = u.real.vault_key, .vid = vault_id_of(c.log_id)}; }

// The relay's blob for a place's items, and the prefix of the files this
// device keeps for it (.version, .cache, .tag).
pub Str place_blob(DeviceConfig c, Str share) { return if (str_len(share) == 0) { vault_blob(c.log_id) } else { "coll-" + share }; }
pub Str place_local(Str dir, Str share) { return if (str_len(share) == 0) { dir + "/vault" } else { dir + "/share-" + share }; }

// An item's id: from the vault key and the name, so the relay learns no names.
@requires(declassify)
pub List(Int) item_id_of(List(Secret(UInt(8))) vk, Str name) { return reveal(hk(vk, "symbolon v1 item id " + name, 16)); }

pub VaultState empty_state(List(Int) vid, List(Int) l) {
    return VaultState {.head = VaultHead {.vault_id = vid, .version = 0, .merkle_root = merkle_root([]), .log_id = l, .log_sequence = 0, .suite = 1, .signer = [], .sig = []}, .items = []};
}

pub Option(VaultState) state_of(List(Int) b) {
    if (b.len() == 0 || b.len() > 16777216 || !cbor_well_formed(b, 24)) { return None; }
    Result(VaultState, SerialError) r = from_cbor(b);
    return match r { Ok(x) => Some(x), Err(_) => None };
}

List(Int) cbor_of_vault(VaultState s) { return match to_cbor(s) { Ok(b) => b, Err(_) => [] }; }

@requires(filesystem)
pub Int kept_version(Str path) {
    Str s = str_trim(filesystem.read_all(path));
    if (str_len(s) == 0) { return 0; }
    // "N", or "N ROOT-HEX" in local.version (seen_at).
    List(Str) p = str_split(s, " ");
    return str_parse_int(p[0]);
}

// The vault as the relay holds it, accepted against the verified log; an
// empty vault when there is none yet and none was ever accepted.
@requires(filesystem, network, clock(readonly), declassify)
pub Result(VaultState, Str) fetch_vault(Str dir, DeviceConfig c, VerifiedHead vh) { return vault_from(dir, c, vh, blob_get(relay_ep(c), vault_blob(c.log_id))); }

// The vault in `b` (as the relay gave it, perhaps fetched ahead), accepted
// against the verified log, never older than any version this device saw.
@requires(filesystem, declassify)
pub Result(VaultState, Str) vault_from(Str dir, DeviceConfig c, VerifiedHead vh, Option(List(Int)) b) {
    List(Int) vid = vault_id_of(c.log_id);
    Str local = place_local(dir, "");
    Seen seen = seen_at(local);
    return match b {
        None => if (seen.version == 0) { Ok(empty_state(vid, c.log_id)) } else { Err("the relay has no vault, but this device accepted version " + f"{seen.version}") },
        Some(x) => match state_of(x) {
            None => Err("the vault does not decode"),
            Some(st) => match vault_accept_seen(st, vid, vh.head, (UInt(64))seen.version, seen.root) { Ok(v) => note_accepted(local, v), Err(e) => Err(err_text(e)) }
        }
    };
}

// The highest version of a place this device has seen (A-14): the one it
// recorded in local.version, or its kept copy's (local.cache) when that is
// higher. Every state a device accepts, also one it only reads, raises
// local.version, so a relay cannot roll a read-only device back to an
// older signed state or answer "no vault" once it showed one. The copy
// counts too, for a device that kept one before versions were recorded on
// reading; its tag is not checked here (the key is not at hand): a copy
// written by someone else can only raise the floor, making the relay's
// state refused, never accept an older one.
@requires(filesystem)
pub Int seen_version(Str local) {
    Seen s = seen_at(local);
    return s.version;
}

// The highest version seen, with the Merkle root of the state accepted at
// it (SPEC 18.4: another state at that version is a fork). local.version
// holds "VERSION ROOT-HEX", or "VERSION" alone as a device wrote it before
// roots were recorded (root []). The kept copy's head counts when it is
// the higher, or gives the root when the file has none at its version.
pub type Seen = { Int version; List(Int) root; };

@requires(filesystem)
pub Seen seen_at(Str local) {
    Str s = str_trim(filesystem.read_all(local + ".version"));
    List(Str) p = str_split(s, " ");
    Int a = if (str_len(s) == 0) { 0 } else { str_parse_int(p[0]) };
    List(Int) ar = if (p.len() >= 2 && str_len(p[1]) == 64) { cose_hex_decode(p[1]) } else { [] };
    Option(VaultState) kc = state_of(get_file(local + ".cache"));
    Seen k = match kc { None => Seen {.version = 0, .root = []}, Some(st) => Seen {.version = (Int)st.head.version, .root = st.head.merkle_root} };
    if (k.version > a || (k.version == a && ar.len() == 0)) { return k; }
    return Seen {.version = a, .root = ar};
}

// What local.version records for an accepted state.
pub Str seen_record(VaultState v) { return f"{v.head.version} " + hex_encode(v.head.merkle_root); }

// After a state is accepted: its version and root recorded, never lowering
// the version (a record of the same version without a root gains one).
@requires(filesystem)
pub Result(VaultState, Str) note_accepted(Str local, VaultState v) {
    Int n = (Int)v.head.version;
    Str was = str_trim(filesystem.read_all(local + ".version"));
    Int k = kept_version(local + ".version");
    Bool record = n > k || (n == k && !str_contains(was, " "));
    _ = if (record) { filesystem.write_all(local + ".version", seen_record(v)) } else { true };
    return Ok(v);
}

// `ep`: the relay with this device's session (orgcore relay_at).
pub type Opened = { DeviceConfig c; Unlocked u; VerifiedHead vh; VaultState st; Str pin; Place p; Endpoint ep; };

@requires(filesystem, network, device, declassify, clock, provision, environment)
pub Result(Opened, Str) open_vault(Str dir) {
    Option(DeviceConfig) oc = load_config(dir);
    DeviceConfig c = oc else { return_none() };
    if (c.log_id.len() == 0) { return Err("not set up (device new, device init)"); }
    // The log and the vault are fetched while the PIN is checked.
    Result(Result(VerifiedHead, SymbolonError), RegionError) pl = spawn (filesystem, network, clock(readonly), declassify) { return verified_log_dir(dir, relay_ep(c), c.log_id); };
    Result(Option(List(Int)), RegionError) pb = spawn (network, clock(readonly), declassify) { return blob_get(relay_ep(c), vault_blob(c.log_id)); };
    Str pin = read_pin();
    Unlocked u = unlock_dir(dir, c, pin);
    if (u.kind != 1) { return Err(if (u.kind == 2) { duress_change(region_log(pl)) } else { "wrong PIN" }); }
    Result(VerifiedHead, SymbolonError) rv = region_log(pl);
    return match rv {
        Err(e) => Err(err_text(e)),
        Ok(vh) => match vault_from(dir, c, vh, region_blob(pb)) { Err(m) => Err(m), Ok(st) => Ok(Opened {.c = c, .u = u, .vh = vh, .st = st, .pin = pin, .p = own_place(c, u), .ep = relay_ep(c)}) }
    };
}

// A change to the vault under the duress PIN (SPEC 14.2 item 3, 14.3): the
// duress profile cannot sign a vault head, and must not say "wrong PIN"
// (the PIN opened something, which a coercer would learn). It fails as a
// change fails for the real profile: the log's own error when it did not
// verify; when it did (a duress read just found the relay), as the real
// profile's write fails at a relay that answers reads but not the write
// (store_vault), never "no log at the relay".
pub Str vault_refused_text() { return "the relay refused the vault"; }

pub Str duress_change(Result(VerifiedHead, SymbolonError) rv) {
    return match rv { Err(e) => err_text(e), Ok(_) => vault_refused_text() };
}

// What a region that verified the log or fetched the vault gave back; a
// region that failed counts as the relay not answering.
pub Result(VerifiedHead, SymbolonError) region_log(Result(Result(VerifiedHead, SymbolonError), RegionError) r) {
    return match r { Ok(v) => v, Err(e) => Err(ErrInvalidLog("cannot verify the log: " + e.message)) };
}
pub Option(List(Int)) region_blob(Result(Option(List(Int)), RegionError) r) { return match r { Ok(b) => b, Err(_) => None }; }

DeviceConfig return_none() {
    return DeviceConfig {.relay_host = "", .relay_port = 0, .ca = "", .witnesses = [], .unprotected = true, .argon_m_kib = 0, .argon_t = 0, .salt = [],
        .tpm_dk = 0, .tpm_unlock_a = 0, .tpm_unlock_b = 0, .party = [], .dk_pub = [], .hpke_pub = [], .log_id = [], .mbox_next = 0, .peers = []};
}

pub Option(Item) item_by_id(List(Item) xs, List(Int) id, Int i) {
    if (i >= xs.len()) { return None; }
    if (bytes_eq(xs[i].id, id)) { return Some(xs[i]); }
    return item_by_id(xs, id, i + 1);
}

pub List(Item) without_item(List(Item) xs, List(Int) id, Int i, ListBuf(Item) acc) {
    if (i >= xs.len()) { return acc.finish(); }
    return without_item(xs, id, i + 1, if (bytes_eq(xs[i].id, id)) { acc } else { acc.push(xs[i]) });
}

// `symbolon device vault put DIR NAME`: the PIN, then the secret, on stdin.
@requires(filesystem, network, device, declassify, clock, provision, environment)
pub Int vault_put(Str dir, Str name) {
    Result(Opened, Str) ro = open_vault(dir);
    return match ro { Err(m) => dfail(m), Ok(o) => put_item(dir, o, name, read_pin()) };
}

@requires(filesystem, network, device, declassify, clock, environment)
Int put_item(Str dir, Opened o, Str name, Str secret) {
    if (str_len(name) == 0 || str_len(secret) == 0) { return dfail("a name and a secret"); }
    List(Secret(UInt(8))) vk = o.p.vk;
    List(Int) vid = o.p.vid;
    List(Int) id = item_id_of(vk, name);
    Option(Item) old = item_by_id(o.st.items, id, 0);
    Result(Item, Str) ri = reseal_item(dir, opened_ctx(o), vk, vid, old, id, "password",
        [FieldPlain {.name = "name", .value = secret_bytes(utf8(name))}, FieldPlain {.name = "secret", .value = secret_bytes(utf8(secret))}]);
    return match ri {
        Err(m) => dfail(m),
        Ok(it) => publish_items(dir, o, without_item(o.st.items, id, 0, ListBuf()).concat([it]))
    };
}

@requires(filesystem, network, device, declassify, clock, environment)
pub Int publish_items(Str dir, Opened o, List(Item) items) {
    VaultHead h0 = VaultHead {.vault_id = o.p.vid, .version = o.st.head.version + 1, .merkle_root = merkle_root(items), .log_id = o.c.log_id,
                              .log_sequence = o.vh.head.sequence, .suite = 1, .signer = o.c.party, .sig = []};
    Result(List(Int), Str) rs = dk_sign(o.c, o.u.real, o.u.st, head_tbs(h0));
    return match rs {
        Err(m) => dfail(m),
        Ok(sig) => store_vault(dir, o, VaultState {.head = VaultHead {.vault_id = h0.vault_id, .version = h0.version, .merkle_root = h0.merkle_root, .log_id = h0.log_id,
                                                                      .log_sequence = h0.log_sequence, .suite = 1, .signer = h0.signer, .sig = sig}, .items = items})
    };
}

@requires(filesystem, network, device, declassify, clock, environment)
Int store_vault(Str dir, Opened o, VaultState st) {
    // Accepting our own state first: what other devices will check.
    Result(VaultState, SymbolonError) self_check = vault_accept(st, o.p.vid, o.vh.head, st.head.version);
    if (match self_check { Ok(_) => false, Err(_) => true }) { return dfail("the new vault state does not verify"); }
    // Writes need a signed-in device (SPEC 29.4); a context that has no
    // session yet signs in here.
    Endpoint ep = if (str_len(o.ep.token) > 0) { o.ep } else { relay_session(dir, o.c, o.u) };
    if (!blob_put(ep, place_blob(o.c, o.p.share), cbor_of_vault(st))) { return dfail(vault_refused_text()); }
    _ = filesystem.write_all(place_local(dir, o.p.share) + ".version", seen_record(st));
    _ = keep_place_copy(place_local(dir, o.p.share), o.p.vk, st);
    println(f"vault version {st.head.version}, {st.items.len()} items");
    // A change to a shared folder of an organization member is audited
    // (SPEC 29.6): which folder, its version and item count, never item
    // names (they are sealed).
    _ = if (str_len(o.p.share) > 0) { audit_event(dir, o.c, o.u, o.vh, o.ep, org_id_here(dir), "item", o.p.share, f"version {st.head.version}, {st.items.len()} items") } else { false };
    return 0;
}

// ─── Reading, also offline ──────────────────────────────────────
// After every state it accepts or publishes, the device keeps a copy in
// vault.cache with an HMAC under a key from the vault key in vault.tag
// (SPEC 18.8). Reading falls back to that copy when the relay or the log
// cannot be had, and says so on standard error; a change always needs the
// relay and the verified log.

// `dir` and `ctx`: what opening a protected item of the person's own
// vault needs (protect.resid); a shared folder's view has no ctx.
pub type View = { List(Secret(UInt(8))) vk; List(Int) vid; VaultState st; Bool offline; Str dir; Option(Opener) ctx; };

// Every field of an item of this view (protect.resid open_full).
@requires(filesystem, network, device, declassify, clock, environment)
pub Result(List(FieldPlain), Str) view_open(View v, Item it) { return open_full(v.dir, v.ctx, v.vk, v.vid, it); }

// The context for protected items: the person's own vault only.
pub Option(Opener) opened_ctx(Opened o) { return if (str_len(o.p.share) == 0) { Some(Opener {.c = o.c, .u = o.u}) } else { None }; }

@requires(declassify)
List(Int) cache_tag(List(Secret(UInt(8))) vk, List(Int) b) { return hmac_sha256_bytes(reveal(hk(vk, "symbolon v1 vault cache", 32)), b); }

@requires(filesystem, declassify)
pub Bool keep_copy(Str dir, List(Secret(UInt(8))) vk, VaultState st) { return keep_place_copy(dir + "/vault", vk, st); }

// `local` is place_local(...): the copy is local + ".cache", its tag local + ".tag".
@requires(filesystem, declassify)
pub Bool keep_place_copy(Str local, List(Secret(UInt(8))) vk, VaultState st) {
    List(Int) b = cbor_of_vault(st);
    return filesystem.write_bytes(local + ".cache", b) && filesystem.write_bytes(local + ".tag", cache_tag(vk, b));
}

@requires(filesystem, declassify)
Option(VaultState) kept_copy(Str dir, List(Secret(UInt(8))) vk) { return kept_place_copy(dir + "/vault", vk); }

@requires(filesystem, declassify)
pub Option(VaultState) kept_place_copy(Str local, List(Secret(UInt(8))) vk) {
    List(Int) b = get_file(local + ".cache");
    if (b.len() == 0 || !bytes_eq(get_file(local + ".tag"), cache_tag(vk, b))) { return None; }
    return state_of(b);
}

// The vault for reading: as the relay holds it, verified, or else this
// device's copy.
@requires(filesystem, network, device, declassify, clock, provision, environment)
pub Result(View, Str) open_view(Str dir) {
    Option(DeviceConfig) oc = load_config(dir);
    DeviceConfig c = oc else { return_none() };
    if (c.log_id.len() == 0) { return Err("not set up (device new, device init)"); }
    Result(Result(VerifiedHead, SymbolonError), RegionError) pl = spawn (filesystem, network, clock(readonly), declassify) { return verified_log_dir(dir, relay_ep(c), c.log_id); };
    Result(Option(List(Int)), RegionError) pb = spawn (network, clock(readonly), declassify) { return blob_get(relay_ep(c), vault_blob(c.log_id)); };
    Unlocked u = unlock_dir(dir, c, read_pin());
    return view_for(dir, c, u, region_log(pl), region_blob(pb));
}

// The vault for reading under whichever profile the PIN opened: the real
// vault under the PIN; under the duress PIN its duress subset (SPEC 14.2,
// 18.5), found the same way, never "wrong PIN"; "wrong PIN" only when the
// PIN opened neither.
@requires(filesystem, declassify)
pub Result(View, Str) view_for(Str dir, DeviceConfig c, Unlocked u, Result(VerifiedHead, SymbolonError) rv, Option(List(Int)) b) {
    if (u.kind == 2) { return duress_view(dir, c, u, rv, b); }
    if (u.kind != 1) { return Err("wrong PIN"); }
    return view_of(dir, c, u, rv, b);
}

// Under the duress PIN: the relay's vault, fetched and checked as for the
// PIN (a head that does not verify or goes back fails the same way), but
// holding only the duress subset, which for the own vault is empty: no
// item can be marked for it yet (item field 5 is never set), and the
// duress profile holds no key to the others (18.5). When the relay or the
// log cannot be had it falls back, as the real vault does, to this
// device's copy, as of that copy's version, again without its items (the
// duress profile has no key to check the copy's tag).
@requires(filesystem, declassify)
Result(View, Str) duress_view(Str dir, DeviceConfig c, Unlocked u, Result(VerifiedHead, SymbolonError) rv, Option(List(Int)) b) {
    List(Int) vid = vault_id_of(c.log_id);
    Result(VaultState, Str) rs = match rv { Err(e) => Err(err_text(e)), Ok(vh) => vault_from(dir, c, vh, b) };
    return match rs {
        Ok(st) => duress_online(dir, View {.vk = u.duress.vault_key, .vid = vid, .st = no_items(st), .offline = false, .dir = dir, .ctx = None}, st),
        Err(m) => match state_of(get_file(place_local(dir, "") + ".cache")) {
            None => Err(m),
            Some(st) => offline_view(m, View {.vk = u.duress.vault_key, .vid = vid, .st = no_items(st), .offline = true, .dir = dir, .ctx = None})
        }
    };
}

// An online read under the duress PIN writes the files a real online read
// writes (online_view: vault.cache, then vault.tag), so their times do not
// tell the two apart (SPEC 14.2 item 3). It cannot make the real copy's
// tag (no vault key), and never puts anything there the real profile
// would lose: an existing copy is written back as it is; only where there
// is none yet does it keep the verified state, with a random tag (the
// real profile finds the tag wrong, as for no copy, and its next online
// read replaces both). Residual: after the relay moved past the kept
// copy, the copy stays at its older version, where a real read would
// have advanced it.
@requires(filesystem, declassify)
Result(View, Str) duress_online(Str dir, View v, VaultState st) {
    _ = touch_copy(place_local(dir, ""), st);
    return Ok(v);
}

@requires(filesystem)
pub Bool touch_copy(Str local, VaultState st) {
    List(Int) have = get_file(local + ".cache");
    if (have.len() == 0) { return filesystem.write_bytes(local + ".cache", cbor_of_vault(st)) && filesystem.write_bytes(local + ".tag", random_bytes(32)); }
    List(Int) tag = get_file(local + ".tag");
    return filesystem.write_bytes(local + ".cache", have) && filesystem.write_bytes(local + ".tag", tag);
}

VaultState no_items(VaultState st) { return VaultState {.head = st.head, .items = []}; }

// The vault for reading, the profiles already unlocked (the real one).
@requires(filesystem, network, declassify, clock)
pub Result(View, Str) view_unlocked(Str dir, DeviceConfig c, Unlocked u) {
    if (c.log_id.len() == 0) { return Err("not set up (device new, device init)"); }
    return view_of(dir, c, u, verified_log_dir(dir, relay_ep(c), c.log_id), blob_get(relay_ep(c), vault_blob(c.log_id)));
}

@requires(filesystem, declassify)
Result(View, Str) view_of(Str dir, DeviceConfig c, Unlocked u, Result(VerifiedHead, SymbolonError) rv, Option(List(Int)) b) {
    List(Secret(UInt(8))) vk = u.real.vault_key;
    List(Int) vid = vault_id_of(c.log_id);
    Result(VaultState, Str) rs = match rv { Err(e) => Err(err_text(e)), Ok(vh) => vault_from(dir, c, vh, b) };
    return match rs {
        Ok(st) => online_view(dir, vk, vid, st, Opener {.c = c, .u = u}),
        Err(m) => match kept_copy(dir, vk) {
            None => Err(m),
            Some(st) => offline_view(m, View {.vk = vk, .vid = vid, .st = st, .offline = true, .dir = dir, .ctx = Some(Opener {.c = c, .u = u})})
        }
    };
}

@requires(filesystem, declassify)
Result(View, Str) online_view(Str dir, List(Secret(UInt(8))) vk, List(Int) vid, VaultState st, Opener x) {
    _ = keep_copy(dir, vk, st);
    return Ok(View {.vk = vk, .vid = vid, .st = st, .offline = false, .dir = dir, .ctx = Some(x)});
}

pub Result(View, Str) offline_view(Str why, View v) {
    eprintln(f"local copy: {why}; showing vault version {v.st.head.version} as this device last verified it");
    return Ok(v);
}

// `symbolon device vault get DIR NAME`: the PIN on stdin; prints the secret.
@requires(filesystem, network, device, declassify, clock, provision, environment)
pub Int vault_get(Str dir, Str name) {
    Result(View, Str) rv = open_view(dir);
    return match rv {
        Err(m) => dfail(m),
        Ok(v) => match item_by_id(v.st.items, item_id_of(v.vk, name), 0) {
            None => dfail("no such item"),
            Some(it) => print_field(v, it, if (it.fields.contains("secret")) { "secret" } else { "current" })
        }
    };
}

@requires(filesystem, network, device, declassify, clock, environment)
Int print_field(View v, Item it, Str field) { return print_field_after(v, it, field, ""); }

// The field's text after [prefix], on one line.
@requires(filesystem, network, device, declassify, clock, environment)
Int print_field_after(View v, Item it, Str field, Str prefix) {
    Result(List(FieldPlain), Str) r = view_open(v, it);
    return match r {
        Err(m) => dfail(m),
        Ok(fs) => print_named(fs, field, prefix, 0)
    };
}

@requires(declassify)
Int print_named(List(FieldPlain) fs, Str field, Str prefix, Int i) {
    if (i >= fs.len()) { return dfail("no field " + field); }
    if (fs[i].name == field) { println(prefix + text_of(reveal(fs[i].value))); return 0; }
    return print_named(fs, field, prefix, i + 1);
}

pub Str text_of(List(Int) b) { return http_text(b, 0, b.len()); }

// `symbolon device vault list DIR [--kinds | --long]`: the PIN on stdin;
// prints the names; with --kinds "TYPE NAME" per item; with --long "TYPE
// NAME-HEX DETAIL-HEX FOLDER-HEX", the detail being a login's origin or a
// card's last four digits, else "-", and the folder "-" when it has none. An item's type is its sealed "type" field; an
// older item without one is a secret if it has a secret, else a login.
@requires(filesystem, network, device, declassify, clock, provision, environment)
pub Int vault_list(Str dir, Int form) {
    Result(View, Str) rv = open_view(dir);
    return match rv { Err(m) => dfail(m), Ok(v) => list_items(v, form, 0) };
}

@requires(filesystem, declassify)
pub Int list_items(View v, Int form, Int i) {
    if (i >= v.st.items.len()) { return 0; }
    // Listing needs only the standard tier (18.10.2): a protected item's
    // name, type, folder and site open under vault_key alone. An item a
    // newer agent wrote fields of (SPEC 18.3) is listed, locked, with
    // what of it opens.
    Result(Listed, SymbolonError) r = item_open_listed(v.vk, v.vid, v.st.items[i]);
    _ = match r { Err(e) => dfail(err_text(e)), Ok(l) => print_entry(l.fields, v.st.items[i].fields.contains("secret"), form, item_is_protected(v.st.items[i]), l.newer || item_is_newer(v.st.items[i])) };
    return list_items(v, form, i + 1);
}

// An item a newer agent wrote (SPEC 18.3): its name when that opens, else
// a stand-in; the plain listings add " (newer)", the long one a flag.
@requires(declassify)
Int print_entry(List(FieldPlain) fs, Bool has_secret, Int form, Bool prot, Bool newer) {
    Str t = type_of(fs, has_secret);
    Str name = field_text(fs, "name");
    Str shown = if (str_len(name) == 0 && newer) { "(an item saved by a newer Symbolon)" } else { name + if (newer) { " (newer)" } else { "" } };
    if (form == 0) { println(shown); return 0; }
    if (form == 1) { println(t + " " + shown); return 0; }
    Str d = if (t == "login") { field_text(fs, "origin") } else { if (t == "card") { last4(field_text(fs, "number")) } else { if (t == "passkey") { field_text(fs, "rp_id") } else { "" } } };
    Str f = field_text(fs, "folder");
    // A login's linked apps (SPEC 22.6 item 8), "PACKAGE CERT-SHA256" lines,
    // as a fifth column when there are any: public, like the site.
    Str a = if (t == "login") { field_text(fs, "apps") } else { "" };
    // A protected item (SPEC 18.10) says so in a sixth column, "protected",
    // after the apps ("-" when there are none); an item a newer agent wrote
    // (18.3) has "newer" there ("protected,newer" when both), and its name
    // is "-" when that did not open.
    Str flags = if (prot && newer) { "protected,newer" } else { if (prot) { "protected" } else { if (newer) { "newer" } else { "" } } };
    Str apps = if (str_len(a) == 0) { if (str_len(flags) > 0) { " -" } else { "" } } else { " " + hex_encode(utf8(a)) };
    println(t + " " + (if (str_len(name) == 0) { "-" } else { hex_encode(utf8(name)) }) + " " + (if (str_len(d) == 0) { "-" } else { hex_encode(utf8(d)) }) + " " + (if (str_len(f) == 0) { "-" } else { hex_encode(utf8(f)) })
            + apps + (if (str_len(flags) > 0) { " " + flags } else { "" }));
    return 0;
}

@requires(declassify)
pub Str type_of(List(FieldPlain) fs, Bool has_secret) {
    Str t = field_text(fs, "type");
    return if (str_len(t) > 0) { t } else { if (has_secret) { "secret" } else { "login" } };
}

Str last4(Str n) { Int k = str_len(n); return if (k < 4) { "" } else { str_slice(n, k - 4, k) }; }

// A field's text, or "" when the item has no such field.
@requires(declassify)
pub Str field_text(List(FieldPlain) fs, Str n) { return field_text_at(fs, n, 0); }

@requires(declassify)
Str field_text_at(List(FieldPlain) fs, Str n, Int i) {
    if (i >= fs.len()) { return ""; }
    if (fs[i].name == n) { return text_of(reveal(fs[i].value)); }
    return field_text_at(fs, n, i + 1);
}

// After a kit recovery (SPEC 13.2, 18.4): every device of the recovered
// quorum is new, so no current device signed the vault head. The recovered
// device accepts the head under the quorum in force before the recover
// event, only if it cites a log sequence before that event (a head a
// removed device signs afterwards is refused), and re-signs it, so later
// accepts pass the ordinary rule. Residual risk: an older pre-recovery head
// cannot be told from the latest (the new device has no history).
@requires(filesystem, network, device, declassify, clock, environment)
pub Int vault_reanchor(Str dir, DeviceConfig c, Unlocked u, VerifiedHead vh, Quorum pre, UInt(64) recover_seq, Str pin) {
    Option(List(Int)) b = blob_get(relay_ep(c), vault_blob(c.log_id));
    if (match b { None => true, Some(_) => false }) { println("no vault to re-anchor"); return 0; }
    Option(VaultState) os = state_of(b else { [] });
    VaultState st = os else { empty_state(vault_id_of(c.log_id), c.log_id) };
    LogHead before = LogHead {.log_id = c.log_id, .sequence = recover_seq - 1, .digest = [], .quorum = pre, .policy = vh.head.policy};
    Result(VaultState, SymbolonError) ok = vault_accept(st, vault_id_of(c.log_id), before, 0);
    return match ok {
        Err(e) => dfail("the vault does not verify under the quorum before the recovery: " + err_text(e)),
        Ok(v) => publish_items(dir, Opened {.c = c, .u = u, .vh = vh, .st = v, .pin = pin, .p = own_place(c, u), .ep = relay_ep(c)}, v.items)
    };
}
