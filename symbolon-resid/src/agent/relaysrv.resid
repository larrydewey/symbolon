// The relay with sign-in and access control for organizations (SPEC
// 29.4), in front of the plain relay (net/services.resid).
//
// The relay stays untrusted for confidentiality and integrity: devices
// verify everything. For an organization it adds what a company expects
// of its server: only current members read the membership record, the
// group folders and the audit log; only a folder's people write to it, so
// someone taken out of a group cannot write with the old key until the
// next re-key; governance and membership records, group folders and audit
// events are verified before they are stored, written once where they are
// a history; and a person the company directory turns off loses access at
// once (SPEC 29.7), before an administrator's device signs them out.
//
//   GET  /auth/challenge       32 bytes, hex (time, nonce, MAC; nothing stored);
//                              good for five minutes, once
//   POST /auth                 "CHALLENGE LOG PARTY SIG NAME" (hex, then HOST:PORT): SIG by
//                              device PARTY of log LOG over "symbolon v2 relay auth NAME\n"
//                              || CHALLENGE, NAME one of the relay's names (--name);
//                              answers "TOKEN UNTIL", a bearer token for seven days, good
//                              while PARTY stays a device of LOG
//   GET  /healthz              "ok"
//   GET  /directory/<org>      the company directory (scim.resid) for an owner's or
//                              administrator's device; 404 when there is none
//   /scim/v2/...               the directory's SCIM 2.0 service (scim.resid)
//   GET  /list/<prefix>?after=<name>   as the plain relay, from after <name>, without
//                              the names the caller may not read
//
// The relay verifies the device's log itself, from the events it stores,
// at the time its witnesses sign. Records are checked against the device
// that signed in: a record's signer must be that device. Every write but a
// cosigner's alert needs a signed-in device, and a name that is one log's
// (vault-, kit-, kitv-, card-) or one folder's (roster-, coll-, wrap-,
// leave-) is written only by that log's devices or that folder's people.

import "../types.resid";
import "../core/log.resid";
import "../net/services.resid";
import "../net/store.resid";
import "state.resid";
import "common.resid";
import "serials.resid";
import "orgtypes.resid";
import "orgcore.resid";
import "scim.resid";
import "../browser/json.resid";
import "crypto.resid";
import "ecdsa.resid";
import "cose.resid";
import "httpserv.resid";
import "clock.resid";

// `ca`: the trust anchor for the witnesses the relay asks for the time;
// `store`: where it keeps everything (net/store.resid).
// `console`: the console's origin ("https://HOST:PORT", HOST its WebAuthn
// RP ID), "" for no console.
// `names`: the "HOST:PORT"s devices reach the relay at, comma-separated
// (--name); a device signs one of them into its sign-in. With none (and no
// console) the relay takes the name the device signed, unchecked.
pub type RelayCfg = { StoreCfg store; Str ca; Str console; Str names; };

// The relay's names: --name, and the console's origin (it is served on
// the relay's own port).
pub List(Str) relay_names(RelayCfg g) {
    List(Str) given = nonblank(str_split(str_to_lower(g.names), ","), 0, ListBuf());
    Int at = str_index_of(g.console, "://", 0);
    return if (at < 0) { given } else { given.concat([str_to_lower(str_slice(g.console, at + 3, str_len(g.console)))]) };
}

List(Str) nonblank(List(Str) xs, Int i, ListBuf(Str) acc) {
    if (i >= xs.len()) { return acc.finish(); }
    Str t = str_trim(xs[i]);
    return nonblank(xs, i + 1, if (str_len(t) > 0) { acc.push(t) } else { acc });
}

// Why a relay may not start with these names; "" when it may. With no
// --name and no console origin, a device's sign-in would not be bound to
// this relay (a relay it signs in to could pass its challenge on and sign
// in elsewhere as it): only --insecure-any-name, said in so many words,
// starts such a relay.
pub Str relay_names_problem(Str names, Str console, Bool any_name) {
    if (any_name) { return ""; }
    Str probe = str_trim(names) + str_trim(console);
    return if (str_len(probe) == 0) { "no --name HOST:PORT[,...]: give the names devices reach this relay at (or --insecure-any-name to take any)" } else { "" };
}

// Whether a device may sign `name` in to this relay.
pub Bool name_ok(RelayCfg g, Str name) {
    List(Str) ns = relay_names(g);
    return str_len(name) > 0 && str_len(name) <= 260 && !str_contains(name, " ") && (ns.len() == 0 || ns.contains(name));
}

// Who made a request: the device of a log that signed in, or nobody.
pub type Who = { Bool on; List(Int) log; List(Int) party; List(Int) key; };

pub Who nobody() { return Who {.on = false, .log = [], .party = [], .key = []}; }

Int session_secs() { return 604800; }

Bool hex_ok(Str s, Int i) {
    if (i >= str_len(s)) { return str_len(s) > 0 && str_len(s) % 2 == 0; }
    Int c = str_char_at(s, i);
    return ((c >= 48 && c <= 57) || (c >= 97 && c <= 102)) && hex_ok(s, i + 1);
}

Bool hex_len(Str s, Int n) { return str_len(s) == n && hex_ok(s, 0); }

Str seg_at(List(Str) p, Int i) { return if (i < p.len()) { p[i] } else { "" }; }

// A log one organization's directory turned off (SPEC 29.7), in that
// organization only: "suspended/<org>/<log>", the file holding why. One
// organization's directory says nothing about another's members, nor
// about a household. (A relay before this kept "suspended/<log>" for all
// organizations at once; such a file is honoured only in an organization
// whose own directory has that person turned off.)
@requires(filesystem, network, clock(readonly), declassify)
pub Bool suspended_in(Store root, Str org, List(Int) l) {
    Option(List(Int)) b = st_get(root, "suspended/" + org + "/" + hex_encode(l));
    return match b {
        Some(x) => str_len(str_trim(st_read_text(root, "suspended/" + org + "/" + hex_encode(l)))) > 0,
        None => str_len(str_trim(st_read_text(root, "suspended/" + hex_encode(l)))) > 0 && directory_off(root, org, l)
    };
}

@requires(filesystem, network, clock(readonly), declassify)
Bool directory_off(Store root, Str org, List(Int) l) {
    if (!scim_on(root, org)) { return false; }
    Option(Org) o = org_of(stored(root, "org-" + org));
    return match o {
        None => false,
        Some(ov) => if (member_index(ov.members, l, 0) < 0) { false } else { names_inactive(ov.members[member_index(ov.members, l, 0)].ext_id, all_users(root, org), 0) }
    };
}

Bool names_inactive(Str ext, List(DirUser) us, Int i) {
    if (i >= us.len()) { return false; }
    return (!us[i].active && names_user(ext, us[i])) || names_inactive(ext, us, i + 1);
}

// The device a bearer token names. The token holds the length of the
// device's log when it signed in: when the log has grown since (a device
// removed, a new epoch), the relay verifies the log again and the token
// is good only while its device is still one of the log's devices with
// the same key (SPEC 29.4).
@requires(filesystem, network, clock(readonly), declassify)
pub Who who_of(RelayCfg g, Store root, HttpRequest r) {
    Str h = http_header(r, "authorization");
    if (str_len(h) != 71 || str_slice(h, 0, 7) != "Bearer ") { return nobody(); }
    Str t = str_slice(h, 7, 71);
    if (!hex_len(t, 64)) { return nobody(); }
    Str k = "auth/tok-" + hex_encode(sha256_bytes(utf8(t)));
    List(Str) p = str_split(str_trim(st_read_text(root, k)), " ");
    // "LOG PARTY KEY UNTIL LENGTH"; a token from before has no LENGTH and
    // is checked against the log at once.
    if ((p.len() != 4 && p.len() != 5) || !hex_len(p[0], 64) || !hex_ok(p[1], 0) || !hex_ok(p[2], 0) || str_parse_int(p[3]) < clock_now_seconds()) { return nobody(); }
    List(Int) l = cose_hex_decode(p[0]);
    Who w = Who {.on = true, .log = l, .party = cose_hex_decode(p[1]), .key = cose_hex_decode(p[2])};
    Int n = if (p.len() == 5 && dec_ok(p[4], 0)) { str_parse_int(p[4]) } else { -1 };
    if (n >= 0 && match st_get(root, "log/" + p[0] + "/" + f"{n}") { None => true, Some(_) => false }) { return w; }
    return still_device(g, root, k, w, p[3]);
}

// The log again, verified: the token's device still a device of it with
// the same key; the token then names the log's new length, so the log is
// not verified again until it grows. When the verified log says the party
// is no longer that device (removed, or another key), the token is
// deleted: it is never good again, and a removed device's requests cost
// no further verification. A log that does not verify (or is not there:
// a store that does not answer) only refuses this request.
@requires(filesystem, network, clock(readonly), declassify)
Who still_device(RelayCfg g, Store root, Str k, Who w, Str until) {
    List(SignedEvent) evs = log_dir(root, w.log, (UInt(64))0, []);
    Result(VerifiedHead, SymbolonError) rv = verified_events(w.log, evs, g.ca, "");
    Int verdict = match rv {
        Err(_) => 0,
        Ok(vh) => match device_party(vh.head.quorum.parties, w.party, 0) { None => -1, Some(d) => if (bytes_eq(d.auth_key, w.key)) { 1 } else { -1 } }
    };
    if (verdict < 0) { _ = st_delete(root, k); }
    if (verdict <= 0) { return nobody(); }
    _ = st_text(root, k, hex_encode(w.log) + " " + hex_encode(w.party) + " " + hex_encode(w.key) + " " + until + f" {evs.len()}");
    return w;
}

// ─── Signing in ─────────────────────────────────────────────────

// What the device signs: the relay's name and the challenge (common.resid).
pub List(Int) auth_message(Str name, List(Int) chal) { return relay_auth_message(name, chal); }

// A challenge proves itself, so handing one out writes nothing: anyone may
// ask for one, and a store written per anonymous request could be filled.
// It is 32 bytes: the time it was made (8, big-endian), a nonce (8) and an
// HMAC-SHA256 (first 16 bytes) over the purpose, the time and the nonce
// under a key the relay keeps in its store (shared by every relay process
// on the store). It is good for five minutes and once: the use is
// recorded, write-once, only after a signature over it verifies, so only
// a signed-in device's sign-in writes anything.
pub Int challenge_secs() { return 300; }

@requires(filesystem, network, clock(readonly), declassify)
List(Int) challenge_key(Store root) {
    Str k = "auth/challenge-key";
    List(Int) b = st_bytes(root, k);
    if (b.len() == 32) { return b; }
    // The first relay process to come here makes it; the others read the
    // winner's.
    _ = st_put_new(root, k, random_bytes(32));
    List(Int) b2 = st_bytes(root, k);
    return if (b2.len() == 32) { b2 } else { [] };
}

List(Int) be64(Int v) { return [(v >> 56) & 255, (v >> 48) & 255, (v >> 40) & 255, (v >> 32) & 255, (v >> 24) & 255, (v >> 16) & 255, (v >> 8) & 255, v & 255]; }

Int be64_of(List(Int) b) { return (b[0] << 56) | (b[1] << 48) | (b[2] << 40) | (b[3] << 32) | (b[4] << 24) | (b[5] << 16) | (b[6] << 8) | b[7]; }

pub List(Int) challenge_mac(List(Int) key, Str purpose, List(Int) tn) {
    return hmac_sha256_bytes(key, utf8("symbolon v1 challenge " + purpose + " ").concat(tn))[0..16];
}

// A new challenge for `purpose` ("relay" or "console"); [] without a key.
pub List(Int) challenge_make(List(Int) key, Str purpose, Int now) {
    if (key.len() != 32) { return []; }
    List(Int) tn = be64(now).concat(random_bytes(8));
    return tn.concat(challenge_mac(key, purpose, tn));
}

// Whether `c` is a challenge this relay made for `purpose` within the last
// five minutes (and not in the future). Single use is checked apart, by
// challenge_spend, after the signature.
pub Bool challenge_good(List(Int) key, Str purpose, List(Int) c, Int now) {
    if (key.len() != 32 || c.len() != 32) { return false; }
    Int t = be64_of(c[0..8]);
    return ct_equal(challenge_mac(key, purpose, c[0..16]), c[16..32]) && t <= now + 5 && t + challenge_secs() >= now;
}

// Records the challenge as used; false when it was used already.
@requires(filesystem, network, clock(readonly), declassify)
Bool challenge_spend(Store root, Str purpose, List(Int) c) {
    return st_put_new(root, "auth/used-" + purpose + "-" + hex_encode(c), utf8(f"{clock_now_seconds()}")) == 1;
}

@requires(filesystem, network, clock(readonly), declassify)
HttpReply challenge(Store root) {
    List(Int) c = challenge_make(challenge_key(root), "relay", clock_now_seconds());
    return if (c.len() == 32) { http_reply_text(200, "text/plain", hex_encode(c)) } else { http_reply_status(500) };
}

// A sign-in costs the relay no outbound connection until it is known to be
// a device's: the stored log is verified offline first, at its own last
// witness time, to find the device's key; the signature is checked and the
// challenge spent; only then are the log's witnesses asked the time and the
// log verified at it (a removal that has taken effect since then counts).
// A failed attempt never makes the relay connect to the witness URLs a log
// names, and each challenge buys at most one such round.
@requires(filesystem, network, clock(readonly), declassify)
HttpReply sign_in(RelayCfg g, Store root, HttpRequest r) {
    List(Str) p = str_split(str_trim(http_body_text(r)), " ");
    if (p.len() != 5 || !hex_len(p[0], 64) || !hex_len(p[1], 64) || !hex_ok(p[2], 0) || !hex_ok(p[3], 0)) { return http_reply_status(400); }
    if (!name_ok(g, str_to_lower(p[4]))) { return http_reply_status(403); }
    if (!challenge_good(challenge_key(root), "relay", cose_hex_decode(p[0]), clock_now_seconds())) { return http_reply_status(403); }
    List(Int) l = cose_hex_decode(p[1]);
    List(SignedEvent) evs = log_dir(root, l, (UInt(64))0, []);
    if (evs.len() == 0) { return http_reply_status(403); }
    Int t = last_time(evs, policy_of_e0(evs));
    Result(VerifiedHead, SymbolonError) v0 = il_verify(l, evs, t, lambda(x) { false });
    return match v0 {
        Err(_) => http_reply_status(403),
        Ok(vh) => signed_in(g, root, vh, l, evs, t, cose_hex_decode(p[2]), str_to_lower(p[4]), cose_hex_decode(p[0]), cose_hex_decode(p[3]))
    };
}

@requires(filesystem, network, clock(readonly), declassify)
HttpReply signed_in(RelayCfg g, Store root, VerifiedHead vh, List(Int) l, List(SignedEvent) evs, Int t, List(Int) party, Str name, List(Int) chal, List(Int) sig) {
    Option(Party) d = device_party(vh.head.quorum.parties, party, 0);
    return match d {
        None => http_reply_status(403),
        Some(x) => if (ecdsa_verify_raw(P256, Sha256, x.auth_key, auth_message(name, chal), sig) && challenge_spend(root, "relay", chal)) { witnessed(g, root, vh, l, evs, t, x) } else { http_reply_status(403) }
    };
}

// The log verified at the witnesses' time now: the device still one of
// its devices, with the same key.
@requires(filesystem, network, clock(readonly), declassify)
HttpReply witnessed(RelayCfg g, Store root, VerifiedHead vh, List(Int) l, List(SignedEvent) evs, Int t, Party x) {
    Int now = witness_now(witnesses_at(vh.head.policy.witnesses, ""), g.ca, random_bytes(32));
    Result(VerifiedHead, SymbolonError) rv = il_verify(l, evs, if (now > t) { now } else { t }, lambda(y) { false });
    Bool still = match rv {
        Err(_) => false,
        Ok(vh2) => match device_party(vh2.head.quorum.parties, x.id, 0) { None => false, Some(y) => bytes_eq(y.auth_key, x.auth_key) }
    };
    return if (still) { issue(root, l, x, evs.len()) } else { http_reply_status(403) };
}

@requires(filesystem, network, clock(readonly), declassify)
HttpReply issue(Store root, List(Int) l, Party d, Int len) {
    _ = prune_auth(root);
    Str t = hex_encode(random_bytes(32));
    Int until = clock_now_seconds() + session_secs();
    Bool ok = st_text(root, "auth/tok-" + hex_encode(sha256_bytes(utf8(t))), hex_encode(l) + " " + hex_encode(d.id) + " " + hex_encode(d.auth_key) + f" {until} {len}");
    return if (ok) { http_reply_text(200, "text/plain", t + f" {until}") } else { http_reply_status(500) };
}

// ─── Expiry ─────────────────────────────────────────────────────
// Sessions, console sessions and used challenges are of no use once their
// time is past; each sign-in removes a few expired ones (from a random
// place, so over time all of them), so the store does not keep them.

pub Int prune_batch() { return 16; }

@requires(filesystem, network, clock(readonly), declassify)
pub Int prune_auth(Store root) {
    Int now = clock_now_seconds();
    return prune(root, "auth/tok-", 3, 0, now) + prune(root, "auth/con-", 2, 0, now)
         + prune(root, "auth/used-relay-", 0, challenge_secs() + 300, now) + prune(root, "auth/used-console-", 0, challenge_secs() + 300, now);
}

// Removes the expired objects among a few under `prefix`: field `at` of
// the object's text (space-separated) plus `grace` is its end.
@requires(filesystem, network, clock(readonly), declassify)
pub Int prune(Store root, Str prefix, Int at, Int grace, Int now) {
    List(Str) ks = st_list(root, prefix, prefix + hex_encode(random_bytes(2)), prune_batch());
    List(Str) more = if (ks.len() < prune_batch()) { st_list(root, prefix, "", prune_batch() - ks.len()) } else { [] };
    return prune_each(root, ks.concat(more), at, grace, now, 0, 0);
}

@requires(filesystem, network, clock(readonly), declassify)
Int prune_each(Store root, List(Str) ks, Int at, Int grace, Int now, Int i, Int n) {
    if (i >= ks.len()) { return n; }
    List(Str) p = str_split(str_trim(st_read_text(root, ks[i])), " ");
    Bool dead = p.len() <= at || !dec_ok(p[at], 0) || str_parse_int(p[at]) + grace < now;
    Bool gone = dead && st_delete(root, ks[i]);
    return prune_each(root, ks, at, grace, now, i + 1, n + (if (gone) { 1 } else { 0 }));
}

// The log `l` as this relay stores it, from `seq` until the first gap.
@requires(filesystem, network, clock(readonly), declassify)
pub List(SignedEvent) log_dir(Store root, List(Int) l, UInt(64) seq, List(SignedEvent) acc) {
    Option(List(Int)) b = st_get(root, "log/" + hex_encode(l) + "/" + f"{seq}");
    if (match b { None => true, Some(_) => false }) { return acc; }
    return match event_of_cbor(b else { [] }) {
        None => acc,
        Some(se) => match signed_of(se) { None => acc, Some(e) => log_dir(root, l, seq + (UInt(64))1, acc.concat([e])) }
    };
}

// ─── An organization as the relay holds it ──────────────────────
// What is stored was verified when it was written (below), so the relay
// reads it back as it is.

@requires(filesystem, network, clock(readonly), declassify)
List(Int) stored(Store root, Str name) { return st_bytes(root, "blob/" + name); }

// The number of governance versions stored for `id` (hex), from at least
// `n`. Versions are written once and in order, so the relay keeps a
// pointer to the latest, "orggovhead/<id>", moved when a version is stored:
// counting reads the pointer's version and the one after it (a pointer
// one behind, from two relays storing at once, is walked on and moved),
// not every version from the first. With no pointer (versions stored
// before it), or one naming a version not there, the versions are counted
// from `n` and the pointer written.
@requires(filesystem, network, clock(readonly), declassify)
pub Int gov_count(Store root, Str id, Int n) {
    Str h = str_trim(st_read_text(root, "orggovhead/" + id));
    Int at = if (dec_ok(h, 0)) { str_parse_int(h) } else { 0 };
    Bool good = at > n && stored(root, "orggov-" + id + "-" + f"{at}").len() > 0;
    Int c = gov_walk(root, id, if (good) { at } else { n });
    if (c != at && c > 0) { _ = st_text(root, "orggovhead/" + id, f"{c}"); }
    return c;
}

@requires(filesystem, network, clock(readonly), declassify)
Int gov_walk(Store root, Str id, Int n) {
    return if (stored(root, "orggov-" + id + "-" + f"{n + 1}").len() > 0) { gov_walk(root, id, n + 1) } else { n };
}

@requires(filesystem, network, clock(readonly), declassify)
pub Option(OrgState) relay_org(Store root, Str id) {
    Int n = gov_count(root, id, 0);
    if (n == 0) { return None; }
    Option(OrgGov) g = gov_of(stored(root, "orggov-" + id + "-" + f"{n}"));
    Option(Org) o = org_of(stored(root, "org-" + id));
    return match g { None => None, Some(gv) => match o { None => None, Some(ov) => Some(OrgState {.gov = gv, .org = ov}) } };
}

// ─── What one request has read of an organization ───────────────
// A listing asks may_read of up to list_scan() pages of names, most of
// them about the same few organizations and folders; each organization's
// state (its governance head, membership record, the caller's suspension,
// its directory) and each group folder record is read once per request
// and kept here, not once per name.

// The caller `w` in organization `id`: its state, whether `w` is a member
// not suspended there, and an owner or administrator (attested where the
// policy asks); the directory's groups and users once a folder needed them.
pub type OrgSeen = { Str id; Option(OrgState) st; Bool member; Bool admin; Bool dirs; List(DirGroup) dgs; List(DirUser) us; };
pub type FolderSeen = { Str cid; Option(GroupFolder) f; Bool any; };
pub type Seen = { List(OrgSeen) orgs; List(FolderSeen) folders; };

pub Seen seen_none() { return Seen {.orgs = [], .folders = []}; }

type SeenOrg = { OrgSeen o; Seen s; };
type SeenFolder = { FolderSeen f; Seen s; };
type ReadOk = { Bool ok; Seen s; };

@requires(filesystem, network, clock(readonly), declassify)
OrgSeen org_seen_new(Store root, Str id, Who w) {
    if (!w.on || !hex_len(id, 32)) { return OrgSeen {.id = id, .st = None, .member = false, .admin = false, .dirs = false, .dgs = [], .us = []}; }
    Option(OrgState) ost = relay_org(root, id);
    Bool m = match ost { None => false, Some(st) => member_index(st.org.members, w.log, 0) >= 0 };
    Bool member = m && !suspended_in(root, id, w.log);
    Bool admin = member && match ost { None => false, Some(st) => is_admin(st.gov, w.log) && att_ok(st, w) };
    return OrgSeen {.id = id, .st = ost, .member = member, .admin = admin, .dirs = false, .dgs = [], .us = []};
}

Option(OrgSeen) org_seen_at(List(OrgSeen) os, Str id, Int i) {
    if (i >= os.len()) { return None; }
    return if (os[i].id == id) { Some(os[i]) } else { org_seen_at(os, id, i + 1) };
}

@requires(filesystem, network, clock(readonly), declassify)
SeenOrg org_seen(Store root, Str id, Who w, Seen s) {
    // Nobody is in no organization: nothing read, nothing to keep.
    if (!w.on) { return SeenOrg {.o = org_seen_new(root, id, w), .s = s}; }
    Option(OrgSeen) got = org_seen_at(s.orgs, id, 0);
    return match got {
        Some(o) => SeenOrg {.o = o, .s = s},
        None => seen_org_kept(org_seen_new(root, id, w), s)
    };
}

// At most the last 64 organizations are kept, so a listing of names of many
// organizations costs a bounded search per name (and reads one again).
SeenOrg seen_org_kept(OrgSeen o, Seen s) {
    List(OrgSeen) keep = if (s.orgs.len() >= 64) { s.orgs[1..s.orgs.len()] } else { s.orgs };
    return SeenOrg {.o = o, .s = Seen {.orgs = keep.concat([o]), .folders = s.folders}};
}

// The same, with the directory read (once) when the organization has one.
@requires(filesystem, network, clock(readonly), declassify)
SeenOrg org_seen_dirs(Store root, Str id, Who w, Seen s) {
    SeenOrg so = org_seen(root, id, w, s);
    if (so.o.dirs || !so.o.member || !scim_on(root, id)) { return so; }
    OrgSeen o = OrgSeen {.id = so.o.id, .st = so.o.st, .member = so.o.member, .admin = so.o.admin, .dirs = true, .dgs = all_groups(root, id), .us = all_users(root, id)};
    return SeenOrg {.o = o, .s = Seen {.orgs = org_seen_put(so.s.orgs, o, 0, ListBuf()), .folders = so.s.folders}};
}

List(OrgSeen) org_seen_put(List(OrgSeen) os, OrgSeen o, Int i, ListBuf(OrgSeen) acc) {
    if (i >= os.len()) { return acc.finish(); }
    return org_seen_put(os, o, i + 1, acc.push(if (os[i].id == o.id) { o } else { os[i] }));
}

Option(FolderSeen) folder_seen_at(List(FolderSeen) fs, Str cid, Int i) {
    if (i >= fs.len()) { return None; }
    return if (fs[i].cid == cid) { Some(fs[i]) } else { folder_seen_at(fs, cid, i + 1) };
}

// The group folder record of `cid`, if any (`any`: something is stored
// under the name, whether or not it decodes).
@requires(filesystem, network, clock(readonly), declassify)
SeenFolder folder_seen(Store root, Str cid, Seen s) {
    Option(FolderSeen) got = folder_seen_at(s.folders, cid, 0);
    return match got {
        Some(f) => SeenFolder {.f = f, .s = s},
        None => folder_seen_kept(root, cid, stored(root, "gfolder-" + cid), s)
    };
}

// At most the last 64 folders are kept, as organizations above.
SeenFolder folder_seen_kept(Store root, Str cid, List(Int) b, Seen s) {
    FolderSeen f = FolderSeen {.cid = cid, .f = gfolder_of(b), .any = b.len() > 0};
    List(FolderSeen) keep = if (s.folders.len() >= 64) { s.folders[1..s.folders.len()] } else { s.folders };
    return SeenFolder {.f = f, .s = Seen {.orgs = s.orgs, .folders = keep.concat([f])}};
}

@requires(filesystem, network, clock(readonly), declassify)
Bool in_org(Store root, Str id, Who w) { return org_seen_new(root, id, w).member; }

@requires(filesystem, network, clock(readonly), declassify)
Bool admin_of(Store root, Str id, Who w) { return org_seen_new(root, id, w).admin; }

// The org id in "audit-<org>-...", "invite-<org>-...", "accept-<org>-...".
Str org_part(Str name, Int at) { return if (str_len(name) >= at + 32) { str_slice(name, at, at + 32) } else { "" }; }

// The collection a blob belongs to: "coll-<cid>", "roster-<cid>",
// "wrap-<log>-<cid>", "leave-<cid>-<log>"; "" for any other.
pub Str folder_of(Str n) {
    Int len = str_len(n);
    if (len == 37 && str_starts_with(n, "coll-")) { return str_slice(n, 5, 37); }
    if (len == 39 && str_starts_with(n, "roster-")) { return str_slice(n, 7, 39); }
    if (len == 102 && str_starts_with(n, "wrap-")) { return str_slice(n, 70, 102); }
    if (len == 103 && str_starts_with(n, "leave-")) { return str_slice(n, 6, 38); }
    return "";
}

// Whether `w` is one of a group folder's people; true for a collection
// that is not a group folder (a household's shared folders keep the
// plain relay's rules: their records are signed, their items sealed).
@requires(filesystem, network, clock(readonly), declassify)
Bool folder_person(Store root, Str cid, Who w) { return folder_person_in(root, cid, w, seen_none()).ok; }

@requires(filesystem, network, clock(readonly), declassify)
ReadOk folder_person_in(Store root, Str cid, Who w, Seen s0) {
    SeenFolder sf = folder_seen(root, cid, s0);
    if (!sf.f.any) { return ReadOk {.ok = true, .s = sf.s}; }
    if (!w.on) { return ReadOk {.ok = false, .s = sf.s}; }
    Option(GroupFolder) of = sf.f.f;
    return match of {
        None => ReadOk {.ok = false, .s = sf.s},
        Some(f) => group_person(root, f, w, org_seen_dirs(root, hex_encode(f.org_id), w, sf.s))
    };
}

ReadOk group_person(Store root, GroupFolder f, Who w, SeenOrg so) {
    Option(OrgState) ost = so.o.st;
    Bool ok = so.o.member && match ost { None => false, Some(st) => person_in(folder_people(st, f.groups), w.log, 0) && directory_allows(so.o, st, f.groups, w.log) && att_ok(st, w) };
    return ReadOk {.ok = ok, .s = so.s};
}

// The company directory can only take away (SPEC 29.7): an owner or
// administrator keeps a group folder; anyone else needs one of its groups
// that the directory does not contradict: a directory group of the same
// name that does not list them takes that group away at once, before an
// administrator's device signs the change.
Bool directory_allows(OrgSeen o, OrgState st, List(List(Int)) gids, List(Int) l) {
    if (is_admin(st.gov, l) || !o.dirs) { return true; }
    Int mi = member_index(st.org.members, l, 0);
    if (mi < 0) { return false; }
    return any_group_ok(st.org.groups, gids, l, st.org.members[mi].ext_id, o.dgs, o.us, 0);
}

Bool any_group_ok(List(OrgGroup) gs, List(List(Int)) gids, List(Int) l, Str ext, List(DirGroup) dgs, List(DirUser) us, Int i) {
    if (i >= gs.len()) { return false; }
    Bool ok = has_log(gids, gs[i].group_id) && has_log(gs[i].members, l) && directory_keeps(gs[i].name, ext, dgs, us, 0);
    return ok || any_group_ok(gs, gids, l, ext, dgs, us, i + 1);
}

// No directory group of this name, or one that lists the user `ext` names.
Bool directory_keeps(Str name, Str ext, List(DirGroup) dgs, List(DirUser) us, Int i) {
    if (i >= dgs.len()) { return true; }
    if (dgs[i].display == name) { return lists_user(dgs[i].members, ext, us, 0); }
    return directory_keeps(name, ext, dgs, us, i + 1);
}

Bool lists_user(List(Str) ids, Str ext, List(DirUser) us, Int i) {
    if (i >= us.len()) { return false; }
    return (us[i].active && has_str(ids, us[i].id, 0) && names_user(ext, us[i])) || lists_user(ids, ext, us, i + 1);
}

Bool person_in(List(Member) ms, List(Int) l, Int i) {
    if (i >= ms.len()) { return false; }
    return bytes_eq(ms[i].log_id, l) || person_in(ms, l, i + 1);
}

@requires(filesystem, network, clock(readonly), declassify)
pub Bool may_read(Store root, Str name, Who w) { return may_read_in(root, name, w, seen_none()).ok; }

// may_read, with what this request has already read (`s`) and what it read now.
@requires(filesystem, network, clock(readonly), declassify)
ReadOk may_read_in(Store root, Str name, Who w, Seen s) {
    if (str_starts_with(name, "orggov-")) { return ReadOk {.ok = w.on, .s = s}; }
    if (str_starts_with(name, "org-")) { return member_read(org_seen(root, str_slice(name, 4, str_len(name)), w, s)); }
    if (str_starts_with(name, "audit-")) { return admin_read(org_seen(root, org_part(name, 6), w, s)); }
    if (str_starts_with(name, "escrow-")) { return escrow_read_in(root, name, w, org_seen(root, org_part(name, 7), w, s)); }
    if (str_starts_with(name, "conkey-")) { return admin_read(org_seen(root, org_part(name, 7), w, s)); }
    if (str_starts_with(name, "attev-") || str_starts_with(name, "attresp-") || str_starts_with(name, "attchal-")) { return member_read(org_seen(root, org_part(name, str_index_of(name, "-", 0) + 1), w, s)); }
    if (str_starts_with(name, "recreq-")) { return member_read(org_seen(root, org_part(name, 7), w, s)); }
    if (str_starts_with(name, "recat-")) { return member_read(org_seen(root, org_part(name, 6), w, s)); }
    if (str_starts_with(name, "invite-") || str_starts_with(name, "accept-")) { return admin_read(org_seen(root, org_part(name, 7), w, s)); }
    if (str_starts_with(name, "gfolder-")) {
        SeenFolder sf = folder_seen(root, str_slice(name, 8, str_len(name)), s);
        Option(GroupFolder) of = sf.f.f;
        return match of { None => ReadOk {.ok = w.on, .s = sf.s}, Some(f) => member_read(org_seen(root, hex_encode(f.org_id), w, sf.s)) };
    }
    Str cid = folder_of(name);
    return if (str_len(cid) == 0) { ReadOk {.ok = true, .s = s} } else { folder_person_in(root, cid, w, s) };
}

ReadOk member_read(SeenOrg so) { return ReadOk {.ok = so.o.member, .s = so.s}; }
ReadOk admin_read(SeenOrg so) { return ReadOk {.ok = so.o.admin, .s = so.s}; }

// Why `w` may not store `body` as `name`; "" when it may.
@requires(filesystem, network, clock(readonly), declassify)
pub Str may_write(Store root, Str name, List(Int) body, Who w) {
    // A cosigner's sealed alert for its person: the cosigner has no
    // sign-in, so an alert is written once, never replaced (handle); a
    // device of that person's log removes it (an empty body).
    if (str_starts_with(name, "alrt-")) { return alert_write(root, name, body, w); }
    if (!w.on) { return "sign in first"; }
    if (str_starts_with(name, "recat-")) { return "only the relay writes when it took a request"; }
    if (str_starts_with(name, "orggov-")) { return gov_write(root, name, body, w); }
    if (str_starts_with(name, "org-")) { return org_write(root, name, body, w); }
    if (str_starts_with(name, "gfolder-")) { return gfolder_write(root, name, body, w); }
    if (str_starts_with(name, "audit-")) { return audit_write(root, name, body, w); }
    if (str_starts_with(name, "invite-")) { return if (admin_of(root, org_part(name, 7), w)) { "" } else { "only an owner or administrator writes an invite" }; }
    if (str_starts_with(name, "accept-")) { return accept_write(root, name, body, w); }
    if (str_starts_with(name, "escrow-")) { return escrow_write(root, name, body, w); }
    if (str_starts_with(name, "conkey-")) { return conkey_write(root, name, body, w); }
    if (str_starts_with(name, "attev-") || str_starts_with(name, "attresp-") || str_starts_with(name, "attchal-")) { return att_write(root, name, body, w); }
    if (str_starts_with(name, "recreq-")) { return recreq_write(root, name, body, w); }
    Str owner = log_named(name);
    if (str_len(owner) > 0) { return if (owner == hex_encode(w.log)) { "" } else { "only a device of that log writes it" }; }
    Str cid = folder_of(name);
    if (str_len(cid) > 0) { return folder_write(root, name, cid, body, w); }
    return "not a name this relay keeps";
}

// The log a name is one person's: "vault-<log>", "kit-<log>-a",
// "kit-<log>-secrets", "kitv-<log>-a", "card-<log>"; "" for any other.
pub Str log_named(Str n) {
    Int len = str_len(n);
    Str l = if (len == 70 && str_starts_with(n, "vault-")) { str_slice(n, 6, 70) } else {
        if (len == 70 && str_starts_with(n, "kit-") && str_slice(n, 68, 70) == "-a") { str_slice(n, 4, 68) } else {
            if (len == 76 && str_starts_with(n, "kit-") && str_slice(n, 68, 76) == "-secrets") { str_slice(n, 4, 68) } else {
                if (len == 71 && str_starts_with(n, "kitv-") && str_slice(n, 69, 71) == "-a") { str_slice(n, 5, 69) } else {
                    if (len == 69 && str_starts_with(n, "card-")) { str_slice(n, 5, 69) } else { "" } } } } };
    return if (hex_len(l, 64)) { l } else { "" };
}

pub Int max_alert() { return 65536; }

pub Str alerts_full() { return "too many alerts wait for this person"; }

// At most this many alerts wait for one log at once.
pub Int max_alerts() { return 64; }

// "alrt-<log>-<time>-<8 hex>": an alert a cosigner sealed (HPKE mode_auth
// from its key, which the person's devices check) to its person's alert
// keys. The relay cannot tell a cosigner's alert from anyone else's: HPKE
// mode_auth is checked only by the recipient, and a cosigner has no
// sign-in or key the relay could check a signature with; so what anyone
// can make it keep for one log is bounded: max_alerts() of max_alert()
// bytes. A cosigner keeps an alert the relay refuses and sends it again
// later; the person's devices remove what they have read.
@requires(filesystem, network, clock(readonly), declassify)
pub Str alert_write(Store root, Str name, List(Int) body, Who w) {
    List(Str) p = str_split(name, "-");
    if (p.len() != 4 || !hex_len(p[1], 64) || !dec_ok(p[2], 0) || !hex_len(p[3], 8)) { return "not an alert's name"; }
    if (body.len() == 0) { return if (w.on && p[1] == hex_encode(w.log)) { "" } else { "only a device of that log removes its alerts" }; }
    if (body.len() > max_alert()) { return "an alert is 1 to 65536 bytes"; }
    if (st_list(root, "blob/alrt-" + p[1] + "-", "", max_alerts()).len() >= max_alerts()) { return alerts_full(); }
    return "";
}

// A household folder (SPEC 19): the roster is its owner's, written by a
// device of the owner (the first roster of an id makes its writer the
// owner); its items and key wraps are written by the owner's or a
// member's devices; a member's word that they left by that member's
// devices, cleared by the owner's. A group folder keeps its own rule (its
// people). Wraps for an id with no roster yet (a folder being made, a
// recovery share) are their writer's: only the device's log that wrote
// them first replaces them.
//
// "wrap-<log>-<cid>" holds the folder key wrapped to the devices of <log>:
// the owner (an owner or administrator, in a group folder) writes anyone's,
// a person their own; another of the folder's people only adds to what is
// stored for that person at the same roster version (a wrap for a device
// they added since, SPEC 19), never takes a wrap away or replaces one, so
// no one in a folder locks another out of it. In a group folder the roster
// is written only by an owner or administrator, and a word that someone
// left only by them or by an owner or administrator.
@requires(filesystem, network, clock(readonly), declassify)
Str folder_write(Store root, Str name, Str cid, List(Int) body, Who w) {
    if (stored(root, "gfolder-" + cid).len() > 0) { return group_write(root, name, cid, body, w); }
    Option(Roster) ro = relay_roster_of(stored(root, "roster-" + cid));
    if (str_starts_with(name, "roster-")) {
        return match relay_roster_of(body) {
            None => "the roster does not decode",
            Some(r) => if (!bytes_eq(r.owner, w.log) || hex_encode(r.coll_id) != cid) { "a roster is written by its owner's device" } else {
                match ro { None => "", Some(prev) => if (bytes_eq(prev.owner, w.log)) { "" } else { "the folder is someone else's" } } }
        };
    }
    if (str_starts_with(name, "leave-")) {
        Str who = str_slice(name, 39, 103);
        Bool owner = match ro { None => false, Some(r) => bytes_eq(r.owner, w.log) };
        return if (who == hex_encode(w.log) || (body.len() == 0 && owner)) { "" } else { "only the member, or the owner clearing it, writes that" };
    }
    return match ro {
        Some(r) => if (bytes_eq(r.owner, w.log)) { "" } else { if (member_of(r.members, w.log, 0)) { wrap_by_person(root, name, body, w) } else { "not one of the folder's people" } },
        None => if (str_starts_with(name, "wrap-")) { first_wrapper(stored(root, name), body, w) } else { "no such folder" }
    };
}

// A group folder: its people write its items; see folder_write for the rest.
@requires(filesystem, network, clock(readonly), declassify)
Str group_write(Store root, Str name, Str cid, List(Int) body, Who w) {
    if (!folder_person(root, cid, w)) { return "not one of the group folder's people"; }
    Bool admin = match gfolder_of(stored(root, "gfolder-" + cid)) { None => false, Some(f) => admin_of(root, hex_encode(f.org_id), w) };
    if (admin) { return ""; }
    if (str_starts_with(name, "roster-")) { return "only an owner or administrator writes a group folder's roster"; }
    if (str_starts_with(name, "leave-")) { return if (str_slice(name, 39, 103) == hex_encode(w.log)) { "" } else { "only the person, or an owner or administrator, writes that" }; }
    return wrap_by_person(root, name, body, w);
}

// One of a folder's people, not its owner (or an administrator): items, and
// wraps as folder_write says.
@requires(filesystem, network, clock(readonly), declassify)
Str wrap_by_person(Store root, Str name, List(Int) body, Who w) {
    if (!str_starts_with(name, "wrap-")) { return ""; }
    Str to = str_slice(name, 5, 69);
    if (to == hex_encode(w.log)) { return ""; }
    return if (wraps_added(relay_wraps_of(stored(root, name)), relay_wraps_of(body), to)) { "" } else { "only the owner replaces another person's wraps; others only add to them" };
}

// `next` keeps every wrap of `prev`, for the same person and roster version.
Bool wraps_added(Option(WrapSet) prev, Option(WrapSet) next, Str to) {
    return match prev {
        None => false,
        Some(p) => match next {
            None => false,
            Some(n) => hex_encode(n.member) == to && bytes_eq(n.member, p.member) && bytes_eq(n.coll_id, p.coll_id) && n.roster_version == p.roster_version && keeps_all(p.wraps, n.wraps, 0)
        }
    };
}

Bool keeps_all(List(ShareWrap) old, List(ShareWrap) now, Int i) {
    if (i >= old.len()) { return true; }
    return has_wrap(now, old[i], 0) && keeps_all(old, now, i + 1);
}

Bool has_wrap(List(ShareWrap) ws, ShareWrap x, Int i) {
    if (i >= ws.len()) { return false; }
    ShareWrap y = ws[i];
    Bool same = bytes_eq(y.to, x.to) && bytes_eq(y.from_log, x.from_log) && bytes_eq(y.from_party, x.from_party) && bytes_eq(y.enc, x.enc) && bytes_eq(y.ct, x.ct);
    return same || has_wrap(ws, x, i + 1);
}

Bool member_of(List(Member) ms, List(Int) l, Int i) { return i < ms.len() && (bytes_eq(ms[i].log_id, l) || member_of(ms, l, i + 1)); }

// Wraps with no roster: each from the writer's log, and any stored before
// from it too.
Str first_wrapper(List(Int) prev, List(Int) body, Who w) {
    Bool mine = match relay_wraps_of(body) { None => false, Some(ws) => all_from(ws.wraps, w.log, 0) };
    if (!mine) { return "wraps are signed by the writer's own devices"; }
    return match relay_wraps_of(prev) { None => "", Some(ps) => if (all_from(ps.wraps, w.log, 0)) { "" } else { "these wraps are someone else's" } };
}

Bool all_from(List(ShareWrap) ws, List(Int) l, Int i) { return i >= ws.len() || (bytes_eq(ws[i].from_log, l) && all_from(ws, l, i + 1)); }

@requires(declassify)
Bool by_device(Who w, List(Int) log, List(Int) party, List(Int) tbs, List(Int) sig) {
    return w.on && bytes_eq(log, w.log) && bytes_eq(party, w.party) && ecdsa_verify_raw(P256, Sha256, w.key, tbs, sig);
}

@requires(filesystem, network, clock(readonly), declassify)
Str gov_write(Store root, Str name, List(Int) body, Who w) {
    if (!w.on) { return "sign in first"; }
    return match gov_of(body) { None => "the governance record does not decode", Some(g) => gov_ok(root, name, g, w) };
}

@requires(filesystem, network, clock(readonly), declassify)
Str gov_ok(Store root, Str name, OrgGov g, Who w) {
    Str id = hex_encode(g.org_id);
    if (name != gov_blob(g.org_id, g.version) || g.org_id.len() != 16) { return "stored under another name"; }
    Int n = gov_count(root, id, 0);
    if ((Int)g.version != n + 1) { return "governance versions are written once, in order"; }
    if (g.owners.len() == 0) { return "an organization needs an owner"; }
    if (!by_device(w, g.signer_log, g.signer, gov_tbs(g), g.sig)) { return "not signed by the device that signed in"; }
    if (n == 0) {
        return if (bytes_eq(g.signer_log, g.founder) && bytes_eq(org_id_of(g.founder, g.nonce), g.org_id)) { "" } else { "the first version is the founder's" };
    }
    return match gov_of(stored(root, gov_blob(g.org_id, (UInt(64))n))) {
        None => "the version before does not decode",
        Some(p) => if (is_owner(p, g.signer_log) && bytes_eq(p.nonce, g.nonce) && bytes_eq(p.founder, g.founder)) { "" } else { "not signed by an owner of the version before" }
    };
}

@requires(filesystem, network, clock(readonly), declassify)
Str org_write(Store root, Str name, List(Int) body, Who w) {
    if (!w.on) { return "sign in first"; }
    return match org_of(body) { None => "the membership record does not decode", Some(o) => org_ok(root, name, o, w) };
}

@requires(filesystem, network, clock(readonly), declassify)
Str org_ok(Store root, Str name, Org o, Who w) {
    Str id = hex_encode(o.org_id);
    if (name != org_blob(o.org_id) || o.org_id.len() != 16) { return "stored under another name"; }
    Int n = gov_count(root, id, 0);
    if (n == 0 || (Int)o.gov_version != n) { return "not under the latest governance"; }
    Option(OrgGov) og = gov_of(stored(root, gov_blob(o.org_id, (UInt(64))n)));
    Bool admin = match og { None => false, Some(g) => is_admin(g, o.signer_log) };
    if (!admin) { return "not signed by an owner or administrator"; }
    if (!by_device(w, o.signer_log, o.signer, org_tbs(o), o.sig)) { return "not signed by the device that signed in"; }
    return match org_of(stored(root, name)) {
        None => "",
        Some(prev) => if (o.version > prev.version) { "" } else { "an older membership record" }
    };
}

@requires(filesystem, network, clock(readonly), declassify)
Str gfolder_write(Store root, Str name, List(Int) body, Who w) {
    if (!w.on) { return "sign in first"; }
    return match gfolder_of(body) { None => "the group folder does not decode", Some(f) => gfolder_ok(root, name, f, w) };
}

@requires(filesystem, network, clock(readonly), declassify)
Str gfolder_ok(Store root, Str name, GroupFolder f, Who w) {
    if (name != gfolder_blob(hex_encode(f.coll_id)) || f.coll_id.len() != 16) { return "stored under another name"; }
    Bool admin = match relay_org(root, hex_encode(f.org_id)) { None => false, Some(st) => is_admin(st.gov, f.signer_log) };
    if (!admin) { return "not signed by an owner or administrator"; }
    if (!by_device(w, f.signer_log, f.signer, gfolder_tbs(f), f.sig)) { return "not signed by the device that signed in"; }
    return match gfolder_of(stored(root, name)) {
        None => unclaimed(root, hex_encode(f.coll_id), f),
        Some(prev) => if (f.version > prev.version && bytes_eq(f.org_id, prev.org_id)) { "" } else { "an older group folder" }
    };
}

// A folder id someone else's household folder already has is not taken
// for a group folder (that would turn its people out): the first record
// of an id wins. Only a roster whose owner signed the group folder record
// becomes a group folder: being listed as a member of an organization is
// no consent (anyone founding an organization may list anyone), so a
// member's household folder is never taken by an administrator. Items
// with no roster are someone's too: refused.
@requires(filesystem, network, clock(readonly), declassify)
Str unclaimed(Store root, Str cid, GroupFolder f) {
    Option(Roster) ro = relay_roster_of(stored(root, "roster-" + cid));
    Bool ours = match ro {
        None => stored(root, "coll-" + cid).len() == 0,
        Some(r) => bytes_eq(r.owner, f.signer_log)
    };
    return if (ours) { "" } else { "a folder of this id is someone else's" };
}

@requires(filesystem, network, clock(readonly), declassify)
Str audit_write(Store root, Str name, List(Int) body, Who w) {
    if (stored(root, name).len() > 0) { return "audit events are written once"; }
    return match event_of(body) {
        None => "the event does not decode",
        Some(e) => if (name != audit_blob(e.org_id, e.log_id, e.seq)) { "stored under another name" } else {
            if (!in_org(root, hex_encode(e.org_id), w)) { "not in the organization" } else {
                if (by_device(w, e.log_id, e.party, event_tbs(e), e.sig)) { "" } else { "not signed by the device that signed in" } } }
    };
}

@requires(filesystem, network, clock(readonly), declassify)
Str accept_write(Store root, Str name, List(Int) body, Who w) {
    if (body.len() == 0) { return if (admin_of(root, org_part(name, 7), w)) { "" } else { "only an owner or administrator clears an answer" }; }
    if (stored(root, name).len() > 0) { return "the invite was answered already"; }
    return match accept_of(body) {
        None => "the answer does not decode",
        Some(a) => if (name != accept_blob(a.org_id, a.id)) { "stored under another name" } else {
            if (!by_device(w, a.log_id, a.signer, accept_tbs(a), a.sig)) { "not signed by the device that signed in" } else {
                if (code_ok(root, a)) { "" } else { "not answered with the invite's code" } } }
    };
}

// The answer carries a signature by the invite's code over the person's
// log: only someone who has the code answers it.
@requires(filesystem, network, clock(readonly), declassify)
Bool code_ok(Store root, OrgAccept a) {
    return match invite_of(stored(root, invite_blob(a.org_id, a.id))) {
        None => false,
        Some(v) => bytes_eq(v.id, a.id) && bytes_eq(invite_id_of(v.public_key), a.id) && ecdsa_verify_raw(P256, Sha256, v.public_key, code_message(a.org_id, a.log_id), a.code_sig)
    };
}

// A work folder's escrow is its owner's; a recovery administrator reads it
// only with a request of their own whose delay has passed by this relay's
// clock, a second line behind the approving devices' witness time (SPEC 29.8).
@requires(filesystem, network, clock(readonly), declassify)
ReadOk escrow_read_in(Store root, Str name, Who w, SeenOrg so) {
    return ReadOk {.ok = so.o.member && escrow_open(root, name, w, so.o), .s = so.s};
}

@requires(filesystem, network, clock(readonly), declassify)
Bool escrow_open(Store root, Str name, Who w, OrgSeen o) {
    Str org = o.id;
    Option(OrgState) ost = o.st;
    Option(OrgEscrow) oe = escrow_of(stored(root, name));
    if (match oe { None => true, Some(e) => bytes_eq(e.owner, w.log) }) { return true; }
    Str cid = str_slice(name, 40, str_len(name));
    List(Int) qb = stored(root, "recreq-" + str_slice(name, 7, str_len(name)));
    Option(OrgRecoveryRequest) oq = recreq_of(qb);
    // The delay runs from when this relay took the request (it refuses one
    // whose own time is not now), never from the requester's word alone.
    Int got = received_at(root, cose_hex_decode(org), cid, qb);
    return match oq {
        None => false,
        Some(q) => match ost {
            None => false,
            Some(st) => got > 0 && st.gov.recovery.on && has_log(st.gov.recovery.admins, w.log) && bytes_eq(q.requester, w.log) && clock_now_seconds() >= recovery_opens(q.time, got, st.gov.recovery.delay_sec)
        }
    };
}

// When this relay took a recovery request (its bytes `qb`); 0 for none.
@requires(filesystem, network, clock(readonly), declassify)
pub Int received_at(Store root, List(Int) org, Str cid, List(Int) qb) {
    if (qb.len() == 0) { return 0; }
    Str t = str_trim(st_read_text(root, "blob/" + recat_blob(org, cid, qb)));
    return if (dec_ok(t, 0)) { str_parse_int(t) } else { 0 };
}

// A work folder's escrow, by its owner's device, in the organization: the
// owner is the folder's (its roster's), so no other member replaces it.
@requires(filesystem, network, clock(readonly), declassify)
Str escrow_write(Store root, Str name, List(Int) body, Who w) {
    return match escrow_of(body) {
        None => "the escrow does not decode",
        Some(e) => if (name != escrow_blob(e.org_id, hex_encode(e.coll_id)) || !in_org(root, hex_encode(e.org_id), w)) { "stored under another name, or not in the organization" } else {
            if (!by_device(w, e.owner, e.signer, escrow_tbs(e), e.sig)) { "not signed by the device that signed in" } else {
                if (folder_owner(root, name, hex_encode(e.coll_id), e.owner)) { "" } else { "only the folder's owner escrows it" } } }
    };
}

@requires(filesystem, network, clock(readonly), declassify)
Bool folder_owner(Store root, Str name, Str cid, List(Int) l) {
    Bool roster = match relay_roster_of(stored(root, "roster-" + cid)) { None => false, Some(r) => bytes_eq(r.owner, l) };
    Bool prev = match escrow_of(stored(root, name)) { None => true, Some(p) => bytes_eq(p.owner, l) };
    return roster && prev;
}

// Attestation records (SPEC 29.5): evidence and answers by the device they
// are about, challenges by an owner's or administrator's device.
@requires(filesystem, network, clock(readonly), declassify)
Str att_write(Store root, Str name, List(Int) body, Who w) {
    Str org = org_part(name, str_index_of(name, "-", 0) + 1);
    if (!in_org(root, org, w)) { return "not in the organization"; }
    if (str_starts_with(name, "attev-")) {
        return match attev_of(body) { None => "the evidence does not decode", Some(e) => if (name == att_blob("attev", e.org_id, e.party) && bytes_eq(e.party, w.party) && by_device(w, e.log_id, e.signer, attev_tbs(e), e.sig)) { "" } else { "not the signed-in device's own evidence" } };
    }
    if (str_starts_with(name, "attresp-")) {
        return match attresp_of(body) { None => "the response does not decode", Some(r) => if (name == att_blob("attresp", r.org_id, r.party) && bytes_eq(r.party, w.party) && by_device(w, w.log, r.signer, attresp_tbs(r), r.sig)) { "" } else { "not the signed-in device's own response" } };
    }
    if (!admin_of(root, org, w)) { return "only an owner or administrator challenges a device"; }
    return match attchal_of(body) { None => "the challenge does not decode", Some(c) => if (name == att_blob("attchal", c.org_id, c.party) && by_device(w, c.by_log, c.signer, attchal_tbs(c), c.sig)) { "" } else { "not signed by the device that signed in" } };
}

// When the policy requires attestation, an unattested device of a member
// reads and writes no group folder and no audit event (SPEC 29.5).
Bool att_ok(OrgState st, Who w) { return !requires_att(st.gov, "tpm") || has_log(st.org.attested, w.party); }

// A console passkey, approved by an owner's or administrator's device for
// themselves, of one waiting at the console (empty: withdrawn by an admin).
@requires(filesystem, network, clock(readonly), declassify)
Str conkey_write(Store root, Str name, List(Int) body, Who w) {
    Str org = org_part(name, 7);
    if (!admin_of(root, org, w)) { return "only an owner or administrator approves a console passkey"; }
    if (body.len() == 0) { return ""; }
    return match conkey_of(body) {
        None => "the console key does not decode",
        Some(k) => if (name != conkey_blob(k.org_id, k.cred_id) || !bytes_eq(k.log_id, w.log) || !by_device(w, k.log_id, k.signer, conkey_tbs(k), k.sig)) { "not signed by the device that signed in, for itself" } else {
            if (pending_matches(str_split(str_trim(st_read_text(root, "console/" + org + "/pend-" + str_slice(hex_encode(sha256_bytes(k.cred_id)), 0, 32))), " "), k)) { "" } else { "no such passkey waiting at the console" } }
    };
}

Bool pending_matches(List(Str) p, OrgConsoleKey k) { return p.len() == 5 && p[1] == hex_encode(k.cred_id) && p[2] == hex_encode(k.public_key) && p[3] == k.rp_id; }

// A recovery request, by a recovery administrator's device, while recovery is on.
@requires(filesystem, network, clock(readonly), declassify)
Str recreq_write(Store root, Str name, List(Int) body, Who w) {
    if (body.len() == 0) { return if (rec_admin(root, org_part(name, 7), w)) { "" } else { "only a recovery administrator clears a request" }; }
    return match recreq_of(body) {
        None => "the request does not decode",
        Some(q) => if (name != recreq_blob(q.org_id, hex_encode(q.coll_id)) || !rec_admin(root, hex_encode(q.org_id), w)) { "not a recovery administrator" } else {
            if (!by_device(w, q.requester, q.signer, recreq_tbs(q), q.sig)) { "not signed by the device that signed in" } else {
                if (stored(root, name).len() > 0) { "a request is waiting: it is cleared first" } else {
                    if (!near_now(q.time, clock_now_seconds())) { "the request's time is not now" } else { "" } } } }
    };
}

// A request's own time within five minutes of this relay's clock.
pub Bool near_now(Int t, Int now) { return t <= now + challenge_secs() && t + challenge_secs() >= now; }

@requires(filesystem, network, clock(readonly), declassify)
Bool rec_admin(Store root, Str id, Who w) {
    if (!w.on || !hex_len(id, 32)) { return false; }
    return match relay_org(root, id) { None => false, Some(st) => st.gov.recovery.on && has_log(st.gov.recovery.admins, w.log) && member_index(st.org.members, w.log, 0) >= 0 && !suspended_in(root, id, w.log) };
}

// ─── Requests ───────────────────────────────────────────────────

// One request: the store opened for it (one database connection) and
// closed after.
@requires(filesystem, network, clock(readonly), declassify)
pub HttpReply relay_serve_handle(RelayCfg g, HttpRequest r) {
    if (r.path == "/healthz" && r.method == "GET") { return http_reply_text(200, "text/plain", "ok"); }
    Store st = store_open(g.store);
    HttpReply rep = if (store_ok(st)) { handle(g, st, r) } else { http_reply_status(503) };
    _ = store_close(st);
    return rep;
}

@requires(filesystem, network, clock(readonly), declassify)
HttpReply handle(RelayCfg g, Store root, HttpRequest r) {
    if (r.path == "/auth/challenge" && r.method == "GET") { return challenge(root); }
    if (r.path == "/auth" && r.method == "POST") { return sign_in(g, root, r); }
    if (str_starts_with(r.path, "/scim/")) { return scim_handle(root, r); }
    if (str_starts_with(r.path, "/console/") || r.path == "/console") { return console_handle(g, root, r); }
    List(Str) p = str_split(r.path, "/");
    Str kind = seg_at(p, 1);
    if (p.len() == 3 && kind == "directory" && r.method == "GET") { return directory_reply(root, p[2], who_of(g, root, r)); }
    if (kind == "mbox" || kind == "log") { return plain(root, r, p); }
    if (p.len() != 3 || (kind != "blob" && kind != "list") || !blob_ok(p[2], 0)) { return http_reply_status(404); }
    Who w = who_of(g, root, r);
    Str name = p[2];
    Int denied = if (w.on) { 403 } else { 401 };
    if (kind == "list") { return if (r.method == "GET") { listed(root, name, http_query_param(r.query, "after"), w) } else { http_reply_status(404) }; }
    if (r.method == "GET") {
        if (!may_read(root, name, w)) { return http_reply_status(denied); }
        return match st_get(root, "blob/" + name) { Some(b) => http_reply_bytes(200, "application/octet-stream", b), None => http_reply_status(404) };
    }
    if (r.method == "PUT") {
        Str why = may_write(root, name, r.body, w);
        if (why == alerts_full()) { return http_reply_text(429, "text/plain", why); }
        if (str_len(why) > 0) { return http_reply_text(denied, "text/plain", why); }
        if (r.body.len() > max_body()) { return http_reply_status(413); }
        return stored_reply(root, name, r.body);
    }
    return http_reply_status(404);
}

// Names that are a history, or a request or answer that stands until it
// is cleared: an alert, a governance version, an audit event, an answer
// to an invite, a recovery request. may_write checked that the name is
// free, but two writers can both pass that check; the write itself is
// write-once (st_put_new), so only one lands and the other gets 409.
pub Bool write_once(Str name) {
    return str_starts_with(name, "alrt-") || str_starts_with(name, "orggov-") || str_starts_with(name, "audit-") || str_starts_with(name, "accept-") || str_starts_with(name, "recreq-");
}

// Stores a write may_write allowed: a write-once name once (409 when it is
// taken; an empty body, where may_write allows one, removes it so it can
// be written again); a recovery request with the time this relay took it;
// a governance version with the organization's head pointer.
@requires(filesystem, network, clock(readonly), declassify)
pub HttpReply stored_reply(Store root, Str name, List(Int) body) {
    if (write_once(name) && body.len() == 0) { return http_reply_status(if (st_delete(root, "blob/" + name)) { 200 } else { 500 }); }
    if (write_once(name)) {
        Int n = st_put_new(root, "blob/" + name, body);
        if (n != 1) { return http_reply_status(if (n == 0) { 409 } else { 500 }); }
    } else {
        if (!st_put(root, "blob/" + name, body)) { return http_reply_status(500); }
    }
    if (str_starts_with(name, "recreq-")) {
        Int got = st_put_new(root, "blob/" + recat_blob(cose_hex_decode(org_part(name, 7)), str_slice(name, 40, str_len(name)), body), utf8(f"{clock_now_seconds()}"));
        if (got < 0) { return http_reply_status(500); }
    }
    if (str_starts_with(name, "orggov-")) { _ = gov_head_moved(root, name); }
    return http_reply_status(200);
}

// After "orggov-<id>-<n>" is stored: the head pointer names n (or later).
@requires(filesystem, network, clock(readonly), declassify)
Bool gov_head_moved(Store root, Str name) {
    Str id = org_part(name, 7);
    Str v = str_slice(name, 40, str_len(name));
    if (!hex_len(id, 32) || !dec_ok(v, 0)) { return false; }
    return gov_count(root, id, 0) >= str_parse_int(v);
}

Int max_body() { return 16781312; }

Bool blob_ok(Str s, Int i) {
    if (str_len(s) == 0 || str_len(s) > 128) { return false; }
    if (i >= str_len(s)) { return true; }
    Int c = str_char_at(s, i);
    Bool ok = (c >= 48 && c <= 57) || (c >= 97 && c <= 122) || c == 46 || c == 95 || c == 45;
    return ok && !(i == 0 && c == 46) && blob_ok(s, i + 1);
}

Bool dec_ok(Str s, Int i) {
    if (str_len(s) == 0 || str_len(s) > 19) { return false; }
    if (i >= str_len(s)) { return true; }
    Int c = str_char_at(s, i);
    return c >= 48 && c <= 57 && dec_ok(s, i + 1);
}

// The plain relay's mailboxes and logs (net/services.resid), over the store.
@requires(filesystem, network, clock(readonly), declassify)
HttpReply plain(Store root, HttpRequest r, List(Str) p) {
    Str kind = seg_at(p, 1);
    Str who = seg_at(p, 2);
    if (str_len(who) > 128 || !hex_ok(who, 0)) { return http_reply_status(404); }
    if (kind == "mbox" && r.method == "POST" && p.len() == 3) {
        if (r.body.len() == 0 || r.body.len() > max_mbox()) { return http_reply_status(413); }
        Str q = mbox_quota(root, who, r.body.len(), clock_now_seconds());
        if (str_len(q) == 0) { return http_reply_status(429); }
        HttpReply rep = mbox_put_at(root, who, mbox_next(root, who), r.body, 0);
        if (rep.status == 200) { _ = st_text(root, "mboxq/" + who, q); }
        return rep;
    }
    if (p.len() != 4 || !dec_ok(p[3], 0)) { return http_reply_status(404); }
    Str k = kind + "/" + who + "/" + f"{str_parse_int(p[3])}";
    if (r.method == "GET") { return match st_get(root, k) { Some(b) => http_reply_bytes(200, "application/octet-stream", b), None => http_reply_status(404) }; }
    if (kind == "log" && r.method == "POST") {
        if (r.body.len() > max_body()) { return http_reply_status(413); }
        if (!next_event_ok(root, who, str_parse_int(p[3]), r.body)) { return http_reply_status(403); }
        Int w = st_put_new(root, k, r.body);
        return http_reply_status(if (w == 1) { 200 } else { if (w == 0) { 409 } else { 500 } });
    }
    return http_reply_status(404);
}

// A log event is stored only as the next event of the log as stored here
// (SPEC 8.3): with the events before it, from E0, it verifies, its own
// witness co-signatures included; at sequence 0 it is an inception whose
// digest is the log id. Anything else would sit at that sequence forever
// (st_put_new) and keep the log's next event from being stored.
@requires(filesystem, network, clock(readonly), declassify)
Bool next_event_ok(Store root, Str who, Int seq, List(Int) body) {
    List(Int) l = cose_hex_decode(who);
    if (l.len() != 32) { return false; }
    Option(StoredEvent) se = event_of_cbor(body);
    Option(SignedEvent) oe = match se { None => None, Some(x) => signed_of(x) };
    return match oe {
        None => false,
        Some(e) => log_next_ok(l, log_dir(root, l, (UInt(64))0, []), e, seq)
    };
}

// A mailbox message is one HPKE envelope of one Packet (net/proto.resid).
// The largest a device or cosigner sends is a re-share's announcement
// (threshold/rsmsg.resid RsAnnMsg: a 2048-bit Paillier modulus, Pedersen
// parameters and the mod and prm proofs, 80 rounds of 2048-bit numbers
// each: about 120 KiB in CBOR) or a cosigner's evaluation log (a week of
// entries); 1 MiB leaves room over both. Anyone may post (a device being
// enrolled has no sign-in), so what one recipient can be sent is bounded
// too: at most mbox_window_count() messages and mbox_window_bytes() bytes
// per recipient in any mbox_window_secs() (429 beyond). A multi-party
// session sends each party a few batches per round, far below either.
pub Int max_mbox() { return 1048576; }
pub Int mbox_window_secs() { return 600; }
pub Int mbox_window_count() { return 256; }
pub Int mbox_window_bytes() { return 67108864; }

// "mboxq/<to>": "START COUNT BYTES", the window the recipient's messages
// are counted in. The window as it would be with one more message of `n`
// bytes; "" when that is over the quota.
@requires(filesystem, network, clock(readonly), declassify)
Str mbox_quota(Store root, Str to, Int n, Int now) {
    List(Str) p = str_split(str_trim(st_read_text(root, "mboxq/" + to)), " ");
    Bool cur = p.len() == 3 && dec_ok(p[0], 0) && dec_ok(p[1], 0) && dec_ok(p[2], 0) && str_parse_int(p[0]) <= now && str_parse_int(p[0]) + mbox_window_secs() > now;
    Int start = if (cur) { str_parse_int(p[0]) } else { now };
    Int count = (if (cur) { str_parse_int(p[1]) } else { 0 }) + 1;
    Int bytes = (if (cur) { str_parse_int(p[2]) } else { 0 }) + n;
    return if (count > mbox_window_count() || bytes > mbox_window_bytes()) { "" } else { f"{start} {count} {bytes}" };
}

// Where to start looking for a mailbox's next free index: "mboxn/<to>",
// kept after each message, a hint (the write itself is st_put_new); a
// mailbox from before the hint is counted once.
@requires(filesystem, network, clock(readonly), declassify)
Int mbox_next(Store root, Str to) {
    Str h = str_trim(st_read_text(root, "mboxn/" + to));
    return if (dec_ok(h, 0)) { str_parse_int(h) } else { st_list(root, "mbox/" + to + "/", "", 1048576).len() };
}

// The next free index from `n`: only one writer wins each.
@requires(filesystem, network, clock(readonly), declassify)
HttpReply mbox_put_at(Store root, Str to, Int n, List(Int) body, Int tries) {
    if (tries > 1000) { return http_reply_status(500); }
    Int w = st_put_new(root, "mbox/" + to + "/" + f"{n}", body);
    if (w == 1) { _ = st_text(root, "mboxn/" + to, f"{n + 1}"); return http_reply_text(200, "text/plain", f"{n}"); }
    if (w < 0) { return http_reply_status(500); }
    return mbox_put_at(root, to, n + 1, body, tries + 1);
}

@requires(filesystem, network, clock(readonly), declassify)
HttpReply directory_reply(Store root, Str org, Who w) {
    if (!admin_of(root, org, w)) { return http_reply_status(if (w.on) { 403 } else { 401 }); }
    if (!scim_on(root, org)) { return http_reply_status(404); }
    return http_reply_text(200, "text/plain", directory_text(root, org));
}

// The names the caller may read that start with `prefix`, after `after`,
// sorted, at most max_listed(); a client asks again from the last name
// while it gets a full page.
@requires(filesystem, network, clock(readonly), declassify)
HttpReply listed(Store root, Str prefix, Str after, Who w) {
    if (!blob_ok(prefix, 0)) { return http_reply_status(404); }
    List(Str) names = list_page(root, prefix, if (str_len(after) == 0) { "" } else { "blob/" + after }, w, 0, [], seen_none());
    return http_reply_text(200, "text/plain", str_join(names, "\n"));
}

// Store pages of max_listed() keys at a time, at most list_scan(w) pages
// per request, until a page of readable names is full: eight for a
// signed-in device, one for anyone else (nobody reads an organization's
// or a group folder's names, so there is nothing to look further for).
pub Int list_scan(Who w) { return if (w.on) { 8 } else { 1 }; }

type Readable = { List(Str) names; Seen s; };

@requires(filesystem, network, clock(readonly), declassify)
List(Str) list_page(Store root, Str prefix, Str from, Who w, Int round, List(Str) acc, Seen s) {
    List(Str) keys = st_list(root, "blob/" + prefix, from, max_listed());
    Readable rd = readable(root, keys, w, 0, ListBuf(), s);
    List(Str) got = acc.concat(rd.names);
    if (got.len() >= max_listed()) { return got[0..max_listed()]; }
    if (keys.len() < max_listed() || round + 1 >= list_scan(w)) { return got; }
    return list_page(root, prefix, keys[keys.len() - 1], w, round + 1, got, rd.s);
}

@requires(filesystem, network, clock(readonly), declassify)
Readable readable(Store root, List(Str) keys, Who w, Int i, ListBuf(Str) acc, Seen s) {
    if (i >= keys.len()) { return Readable {.names = acc.finish(), .s = s}; }
    Str n = str_slice(keys[i], 5, str_len(keys[i]));
    ReadOk r = may_read_in(root, n, w, s);
    return readable(root, keys, w, i + 1, if (r.ok) { acc.push(n) } else { acc }, r.s);
}

// ─── The console (SPEC 29.10) ───────────────────────────────────
// Served by the relay at /console/<org> when it is given an origin
// (--console-origin). An owner or administrator signs in with a passkey
// their device approved (conkey-, below); the console shows the
// organization as the relay holds it (its records were verified when they
// were written) and queues changes, which only an owner's or
// administrator's device signs (`org changes`, `org approve`, or the app).
//
//   GET  /console/<org>                 the page;  GET /console/app.js  its script
//   GET  /console/<org>/challenge       {"challenge","rpId"} for a sign-in
//   POST /console/<org>/register        {"credentialId","publicKey"} (SPKI), base64url:
//                                       a passkey waiting for approval; {"code"}
//   POST /console/<org>/login           a WebAuthn assertion; sets the session cookie
//   GET  /console/<org>/state           the organization (session)
//   POST /console/<org>/change          {"kind","a","b","c"}: a change to approve (session)
//   GET  /console/<org>/pending         "CODE CRED-HEX PUB-HEX RP" per waiting passkey (device session)
//   DELETE /console/<org>/pending       clears the waiting passkeys, which anyone may add up to
//                                       pending_max() of a day (device session)
//   GET  /console/<org>/changes         "ID KIND A-HEX B-HEX C-HEX BY STATUS" (device session)
//   POST /console/<org>/done/<id>       the change done, the body its result (device session)

Str b64u_text(List(Int) b) { return str_replace(str_replace(str_replace(base64_encode(b), "+", "-"), "/", "_"), "=", ""); }

List(Int) b64u(Str s) {
    Str t = str_replace(str_replace(s, "-", "+"), "_", "/");
    Int pad = (4 - str_len(t) % 4) % 4;
    return base64_decode(t + (if (pad == 2) { "==" } else { if (pad == 1) { "=" } else { "" } }));
}

Str jq(Str s) { return json_quote(s); }

HttpReply json_reply(Int status, Str body) {
    return http_with_header(http_reply_text(status, "application/json", body), "Cache-Control", "no-store");
}

// The P-256 point of an SPKI (DER): its last 65 bytes, uncompressed.
List(Int) spki_point(List(Int) d) { return if (d.len() >= 65 && d[d.len() - 65] == 4) { d[d.len() - 65..d.len()] } else { [] }; }

// An ECDSA signature in DER as r || s, 32 bytes each.
List(Int) der_rs(List(Int) d) {
    if (d.len() < 8 || d[0] != 48 || d[2] != 2) { return []; }
    Int rl = d[3];
    if (4 + rl + 2 > d.len() || d[4 + rl] != 2) { return []; }
    Int sl = d[5 + rl];
    if (6 + rl + sl > d.len()) { return []; }
    return fixed32(d[4..4 + rl]).concat(fixed32(d[6 + rl..6 + rl + sl]));
}

List(Int) fixed32(List(Int) x) {
    if (x.len() > 32) { return x[x.len() - 32..x.len()]; }
    return zeros(32 - x.len()).concat(x);
}

List(Int) zeros(Int n) { return if (n <= 0) { [] } else { [0].concat(zeros(n - 1)) }; }

Str rp_of(Str origin) {
    Str h = str_slice(origin, str_index_of(origin, "://", 0) + 3, str_len(origin));
    Int c = str_index_of(h, ":", 0);
    return if (c < 0) { h } else { str_slice(h, 0, c) };
}

// The value of the cookie named exactly `name` in a Cookie header; "".
pub Str cookie_named(Str header, Str name) { return cookie_in(str_split(header, ";"), name + "=", 0); }

Str cookie_in(List(Str) xs, Str pre, Int i) {
    if (i >= xs.len()) { return ""; }
    Str c = str_trim(xs[i]);
    return if (str_starts_with(c, pre)) { str_slice(c, str_len(pre), str_len(c)) } else { cookie_in(xs, pre, i + 1) };
}

// The console session from the cookie: [org, log hex], or []. A session
// is "ORG LOG UNTIL CRED": it lasts while the passkey it was opened with
// (CRED, its credential id) is still approved: withdrawing the passkey
// ends every session opened with it. (A session from before, without
// CRED, is not taken: its holder signs in again.)
@requires(filesystem, network, clock(readonly), declassify)
List(Str) con_session(Store root, HttpRequest r) {
    Str t = cookie_named(http_header(r, "cookie"), "symcon");
    if (!hex_len(t, 64)) { return []; }
    List(Str) p = str_split(str_trim(st_read_text(root, "auth/con-" + hex_encode(sha256_bytes(utf8(t))))), " ");
    if (p.len() != 4 || !dec_ok(p[2], 0) || str_parse_int(p[2]) < clock_now_seconds() || !hex_len(p[0], 32) || !hex_ok(p[3], 0)) { return []; }
    List(Int) l = cose_hex_decode(p[1]);
    Bool key = match conkey_of(stored(root, conkey_blob(cose_hex_decode(p[0]), cose_hex_decode(p[3])))) { None => false, Some(k) => bytes_eq(k.log_id, l) && bytes_eq(k.cred_id, cose_hex_decode(p[3])) };
    if (!key || suspended_in(root, p[0], l)) { return []; }
    // Still an owner or administrator now.
    return match relay_org(root, p[0]) { None => [], Some(st) => if (is_admin(st.gov, l) && member_index(st.org.members, l, 0) >= 0) { p[0..2] } else { [] } };
}

@requires(filesystem, network, clock(readonly), declassify)
HttpReply console_handle(RelayCfg g, Store root, HttpRequest r) {
    if (str_len(g.console) == 0) { return http_reply_status(404); }
    if (r.path == "/console/app.js") { return http_with_header(http_reply_text(200, "text/javascript", console_js()), "Cache-Control", "no-store"); }
    List(Str) p = str_split(r.path, "/");
    Str org = seg_at(p, 2);
    if (!hex_len(org, 32)) { return http_reply_status(404); }
    Str what = seg_at(p, 3);
    if (p.len() == 3 && r.method == "GET") { return console_page_html(org); }
    if (what == "challenge" && r.method == "GET") {
        List(Int) c = challenge_make(challenge_key(root), "console", clock_now_seconds());
        if (c.len() != 32) { return json_reply(500, "{}"); }
        return json_reply(200, "{\"challenge\":" + jq(b64u_text(c)) + ",\"rpId\":" + jq(rp_of(g.console)) + "}");
    }
    if (what == "register" && r.method == "POST") { return con_register(g, root, org, r); }
    if (what == "login" && r.method == "POST") { return con_login(g, root, org, r); }
    if (what == "state" && r.method == "GET") { return con_state(root, org, con_session(root, r)); }
    if (what == "change" && r.method == "POST") { return con_change(root, org, con_session(root, r), r); }
    Who w = who_of(g, root, r);
    if (!admin_of(root, org, w)) { return http_reply_status(if (w.on) { 403 } else { 401 }); }
    if (what == "pending" && r.method == "GET") { return http_reply_text(200, "text/plain", str_join(pend_lines(root, st_list(root, "console/" + org + "/pend-", "", 4096), 0, ListBuf()), "\n")); }
    if (what == "pending" && r.method == "DELETE") { return http_reply_status(if (deleted_all(root, st_list(root, "console/" + org + "/pend-", "", 4096), 0)) { 200 } else { 500 }); }
    if (what == "changes" && r.method == "GET") { return http_reply_text(200, "text/plain", str_join(change_lines(root, st_list(root, "console/" + org + "/change-", "", 4096), 0, ListBuf()), "\n")); }
    if (what == "done" && r.method == "POST" && p.len() == 5 && hex_len(p[4], 32)) { return con_done(root, org, p[4], w, r); }
    return http_reply_status(404);
}

pub Int pending_max() { return 32; }

// Removes every key of `ks`.
@requires(filesystem, network, clock(readonly), declassify)
Bool deleted_all(Store root, List(Str) ks, Int i) {
    if (i >= ks.len()) { return true; }
    Bool d = st_delete(root, ks[i]);
    return deleted_all(root, ks, i + 1) && d;
}

@requires(filesystem, network, clock(readonly), declassify)
HttpReply con_register(RelayCfg g, Store root, Str org, HttpRequest r) {
    Jv v = json_parse(r.body) else { JNull };
    List(Int) cid = b64u(jstr(jget(v, "credentialId")));
    List(Int) pt = spki_point(b64u(jstr(jget(v, "publicKey"))));
    if (cid.len() < 16 || cid.len() > 1023 || pt.len() != 65) { return json_reply(400, "{\"error\":\"a credential id and an ES256 public key\"}"); }
    // Anyone may ask (the person has no session yet), so what they can make
    // the relay keep is bounded: only for an organization this relay has,
    // and at most pending_max() passkeys waiting at once per organization.
    if (match relay_org(root, org) { None => true, Some(_) => false }) { return json_reply(404, "{\"error\":\"no such organization\"}"); }
    Str pk = "console/" + org + "/pend-" + str_slice(hex_encode(sha256_bytes(cid)), 0, 32);
    _ = prune(root, "console/" + org + "/pend-", 4, 86400, clock_now_seconds());
    Bool again = str_len(str_trim(st_read_text(root, pk))) > 0;
    if (!again && pend_lines(root, st_list(root, "console/" + org + "/pend-", "", 4096), 0, ListBuf()).len() >= pending_max()) { return json_reply(429, "{\"error\":\"too many passkeys are waiting for approval; ask an administrator\"}"); }
    Str code = str_slice(hex_encode(sha256_bytes(cid)), 0, 8);
    Bool ok = st_text(root, pk, code + " " + hex_encode(cid) + " " + hex_encode(pt) + " " + rp_of(g.console) + f" {clock_now_seconds()}");
    return if (ok) { json_reply(200, "{\"code\":" + jq(code) + "}") } else { json_reply(500, "{}") };
}

@requires(filesystem, network, clock(readonly), declassify)
List(Str) pend_lines(Store root, List(Str) keys, Int i, ListBuf(Str) acc) {
    if (i >= keys.len()) { return acc.finish(); }
    List(Str) p = str_split(str_trim(st_read_text(root, keys[i])), " ");
    // A day to approve a waiting passkey.
    Bool live = p.len() == 5 && str_parse_int(p[4]) + 86400 > clock_now_seconds();
    return pend_lines(root, keys, i + 1, if (live) { acc.push(str_join(p[0..4], " ")) } else { acc });
}

@requires(filesystem, network, clock(readonly), declassify)
HttpReply con_login(RelayCfg g, Store root, Str org, HttpRequest r) {
    Jv v = json_parse(r.body) else { JNull };
    List(Int) cid = b64u(jstr(jget(v, "credentialId")));
    List(Int) ad = b64u(jstr(jget(v, "authenticatorData")));
    List(Int) cdj = b64u(jstr(jget(v, "clientDataJSON")));
    List(Int) sig = der_rs(b64u(jstr(jget(v, "signature"))));
    Option(OrgConsoleKey) ok = conkey_of(stored(root, conkey_blob(cose_hex_decode(org), cid)));
    if (cid.len() == 0 || sig.len() != 64 || ad.len() < 37) { return json_reply(400, "{\"error\":\"a WebAuthn assertion\"}"); }
    Jv cd = json_parse(cdj) else { JNull };
    List(Int) chal = b64u(jstr(jget(cd, "challenge")));
    Bool fresh = challenge_good(challenge_key(root), "console", chal, clock_now_seconds());
    Bool shape = jstr(jget(cd, "type")) == "webauthn.get" && jstr(jget(cd, "origin")) == g.console && bytes_eq(ad[0..32], sha256_bytes(utf8(rp_of(g.console)))) && (ad[32] & 1) == 1;
    return match ok {
        None => json_reply(403, "{\"error\":\"this passkey is not approved for the console\"}"),
        Some(k) => if (!fresh || !shape || !bytes_eq(k.cred_id, cid) || !bytes_eq(k.org_id, cose_hex_decode(org))) { json_reply(403, "{\"error\":\"the assertion is not for this console or challenge\"}") } else {
            if (!ecdsa_verify_raw(P256, Sha256, k.public_key, ad.concat(sha256_bytes(cdj)), sig)) { json_reply(403, "{\"error\":\"the signature does not verify\"}") } else {
                if (!challenge_spend(root, "console", chal)) { json_reply(403, "{\"error\":\"the challenge was used already\"}") } else { con_open(root, org, k.log_id, k.cred_id) } } }
    };
}

@requires(filesystem, network, clock(readonly), declassify)
HttpReply con_open(Store root, Str org, List(Int) l, List(Int) cred) {
    Option(OrgState) ost = relay_org(root, org);
    Bool admin = match ost { None => false, Some(st) => is_admin(st.gov, l) && member_index(st.org.members, l, 0) >= 0 };
    if (!admin || suspended_in(root, org, l)) { return json_reply(403, "{\"error\":\"not an owner or administrator\"}"); }
    _ = prune_auth(root);
    Str t = hex_encode(random_bytes(32));
    if (!st_text(root, "auth/con-" + hex_encode(sha256_bytes(utf8(t))), org + " " + hex_encode(l) + f" {clock_now_seconds() + 28800} " + hex_encode(cred))) { return json_reply(500, "{}"); }
    return http_with_header(json_reply(200, "{\"ok\":true}"), "Set-Cookie", "symcon=" + t + "; Path=/console/; HttpOnly; Secure; SameSite=Strict; Max-Age=28800");
}

@requires(filesystem, network, clock(readonly), declassify)
HttpReply con_state(Store root, Str org, List(Str) sess) {
    if (sess.len() != 2 || sess[0] != org) { return json_reply(401, "{\"error\":\"sign in\"}"); }
    Option(OrgState) ost = relay_org(root, org);
    return match ost {
        None => json_reply(404, "{}"),
        Some(st) => json_reply(200, "{\"name\":" + jq(st.gov.name) + f",\"version\":{st.org.version},\"gov\":{st.gov.version}" + ",\"you\":" + jq(sess[1])
            + f",\"policy\":{{\"min_pin_len\":{st.gov.policy.min_pin_len},\"max_offline_days\":{st.gov.policy.max_offline_days}" + ",\"allow_offline_copy\":" + (if (st.gov.policy.allow_offline_copy) { "true" } else { "false" })
            + ",\"allow_duress\":" + (if (st.gov.policy.allow_duress) { "true" } else { "false" }) + ",\"password_rules\":" + jq(st.gov.policy.password_rules) + "}"
            + ",\"recovery\":" + (if (st.gov.recovery.on) { f"{{\"threshold\":{st.gov.recovery.threshold},\"of\":{st.gov.recovery.admins.len()},\"delay\":{st.gov.recovery.delay_sec}}}" } else { "null" })
            + ",\"members\":[" + str_join(member_json(st, 0, ListBuf()), ",") + "],\"groups\":[" + str_join(group_json_list(st.org.groups, 0, ListBuf()), ",") + "]"
            + ",\"changes\":[" + str_join(change_json(root, st_list(root, "console/" + org + "/change-", "", 4096), 0, ListBuf()), ",") + "]}")
    };
}

List(Str) member_json(OrgState st, Int i, ListBuf(Str) acc) {
    if (i >= st.org.members.len()) { return acc.finish(); }
    OrgMember m = st.org.members[i];
    Str role = if (is_owner(st.gov, m.log_id)) { "owner" } else { if (is_admin(st.gov, m.log_id)) { "admin" } else { "member" } };
    return member_json(st, i + 1, acc.push("{\"log\":" + jq(hex_encode(m.log_id)) + ",\"name\":" + jq(m.label) + ",\"ext\":" + jq(m.ext_id) + ",\"role\":" + jq(role) + "}"));
}

List(Str) group_json_list(List(OrgGroup) gs, Int i, ListBuf(Str) acc) {
    if (i >= gs.len()) { return acc.finish(); }
    return group_json_list(gs, i + 1, acc.push("{\"id\":" + jq(hex_encode(gs[i].group_id)) + ",\"name\":" + jq(gs[i].name) + f",\"people\":{gs[i].members.len()}}}"));
}

// A queued change: "ID KIND A-HEX B-HEX C-HEX BY STATUS RESULT-HEX".
@requires(filesystem, network, clock(readonly), declassify)
List(Str) change_lines(Store root, List(Str) keys, Int i, ListBuf(Str) acc) {
    if (i >= keys.len()) { return acc.finish(); }
    Str t = str_trim(st_read_text(root, keys[i]));
    return change_lines(root, keys, i + 1, if (str_len(t) > 0) { acc.push(t) } else { acc });
}

@requires(filesystem, network, clock(readonly), declassify)
List(Str) change_json(Store root, List(Str) keys, Int i, ListBuf(Str) acc) {
    if (i >= keys.len()) { return acc.finish(); }
    List(Str) p = str_split(str_trim(st_read_text(root, keys[i])), " ");
    Bool ok = p.len() == 8 || p.len() == 9;
    return change_json(root, keys, i + 1, if (ok) { acc.push("{\"id\":" + jq(p[0]) + ",\"kind\":" + jq(p[1]) + ",\"a\":" + jq(unhex_text(p[2])) + ",\"b\":" + jq(unhex_text(p[3]))
        + ",\"c\":" + jq(unhex_text(p[4])) + ",\"status\":" + jq(p[6]) + ",\"result\":" + jq(unhex_text(p[7])) + ",\"by\":" + jq(seg_at(p, 8)) + "}") } else { acc });
}

Str hexd(Str s) { return if (str_len(s) == 0) { "-" } else { hex_encode(utf8(s)) }; }
Str unhex_text(Str s) { List(Int) b = if (s == "-") { [] } else { cose_hex_decode(s) }; return http_text(b, 0, b.len()); }

Bool change_kind_ok(Str k) { return k == "invite" || k == "group-add" || k == "group-remove" || k == "remove" || k == "policy" || k == "sync"; }

@requires(filesystem, network, clock(readonly), declassify)
HttpReply con_change(Store root, Str org, List(Str) sess, HttpRequest r) {
    if (sess.len() != 2 || sess[0] != org) { return json_reply(401, "{\"error\":\"sign in\"}"); }
    Jv v = json_parse(r.body) else { JNull };
    Str kind = jstr(jget(v, "kind"));
    Str a = jstr(jget(v, "a"));
    Str b = jstr(jget(v, "b"));
    Str c = jstr(jget(v, "c"));
    if (!change_kind_ok(kind) || str_len(a) > 256 || str_len(b) > 256 || str_len(c) > 1024) { return json_reply(400, "{\"error\":\"invite, group-add, group-remove, remove, policy or sync\"}"); }
    Str id = hex_encode(random_bytes(16));
    Bool ok = st_text(root, "console/" + org + "/change-" + id, id + " " + kind + " " + hexd(a) + " " + hexd(b) + " " + hexd(c) + " " + sess[1] + " pending -");
    return if (ok) { json_reply(200, "{\"id\":" + jq(id) + "}") } else { json_reply(500, "{}") };
}

@requires(filesystem, network, clock(readonly), declassify)
HttpReply con_done(Store root, Str org, Str id, Who w, HttpRequest r) {
    Str k = "console/" + org + "/change-" + id;
    List(Str) p = str_split(str_trim(st_read_text(root, k)), " ");
    if (p.len() != 8 || p[6] != "pending") { return http_reply_status(404); }
    Str result = http_body_text(r);
    Str status = if (str_starts_with(result, "refused")) { "refused" } else { "done" };
    // Who made the change (or refused it): the signed-in device's log, a
    // ninth field after the result.
    return if (st_text(root, k, str_join(p[0..6], " ") + " " + status + " " + hexd(result) + " " + hex_encode(w.log))) { http_reply_status(200) } else { http_reply_status(500) };
}

HttpReply console_page_html(Str org) {
    HttpReply rep = http_reply_text(200, "text/html; charset=utf-8", "<!doctype html><html><head><meta charset=utf-8><meta name=viewport content=\"width=device-width\"><title>Symbolon console</title>"
        + "<style>body{font:15px system-ui;margin:2em auto;max-width:60em;padding:0 1em}table{border-collapse:collapse;width:100%}td,th{border-bottom:1px solid #ddd;padding:.3em;text-align:left}"
        + "button{margin:.2em}input,select{margin:.2em}.note{color:#555}</style></head><body data-org=\"" + org + "\"><h1>Symbolon console</h1>"
        + "<div id=signin><p class=note>Owners and administrators sign in with a passkey their own device approved.</p><button id=login>Sign in with a passkey</button>"
        + "<button id=register>Register this device's passkey</button><p id=msg></p></div><div id=app hidden></div><script src=\"/console/app.js\"></script></body></html>");
    return http_with_header(http_with_header(rep, "Cache-Control", "no-store"), "Content-Security-Policy", "default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'");
}

// The console's script (no inline script: the page's policy allows only this file).
Str console_js() {
    return "const org = document.body.dataset.org, base = '/console/' + org;\n"
         + "const $ = id => document.getElementById(id);\n"
         + "const b64u = b => btoa(String.fromCharCode(...new Uint8Array(b))).replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');\n"
         + "const unb64u = s => Uint8Array.from(atob(s.replace(/-/g, '+').replace(/_/g, '/')), c => c.charCodeAt(0));\n"
         + "const esc = s => String(s).replace(/[&<>\"]/g, c => ({'&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;'}[c]));\n"
         + "async function api(path, body) {\n"
         + "  const r = await fetch(base + path, body ? {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(body)} : {});\n"
         + "  return {status: r.status, json: await r.json().catch(() => ({}))};\n"
         + "}\n"
         + "$('register').onclick = async () => {\n"
         + "  const c = await api('/challenge');\n"
         + "  const cred = await navigator.credentials.create({publicKey: {challenge: unb64u(c.json.challenge), rp: {id: c.json.rpId, name: 'Symbolon console'},\n"
         + "    user: {id: crypto.getRandomValues(new Uint8Array(16)), name: 'console', displayName: 'Symbolon console'}, pubKeyCredParams: [{type: 'public-key', alg: -7}]}});\n"
         + "  const r = await api('/register', {credentialId: b64u(cred.rawId), publicKey: b64u(cred.response.getPublicKey())});\n"
         + "  $('msg').textContent = r.json.code ? 'On your device: symbolon device org console-key DIR ' + r.json.code + ' (or approve it in the app), then sign in.' : (r.json.error || 'refused');\n"
         + "};\n"
         + "$('login').onclick = async () => {\n"
         + "  const c = await api('/challenge');\n"
         + "  const a = await navigator.credentials.get({publicKey: {challenge: unb64u(c.json.challenge), rpId: c.json.rpId, userVerification: 'preferred'}});\n"
         + "  const r = await api('/login', {credentialId: b64u(a.rawId), authenticatorData: b64u(a.response.authenticatorData), clientDataJSON: b64u(a.response.clientDataJSON), signature: b64u(a.response.signature)});\n"
         + "  if (r.status === 200) show(); else $('msg').textContent = r.json.error || 'refused';\n"
         + "};\n"
         + "async function show() {\n"
         + "  const r = await api('/state');\n"
         + "  if (r.status !== 200) return;\n"
         + "  const s = r.json;\n"
         + "  $('signin').hidden = true; $('app').hidden = false;\n"
         + "  $('app').innerHTML = '<h2>' + esc(s.name) + '</h2><p class=note>Membership version ' + s.version + ', governance ' + s.gov + '. Changes you queue here are signed on an owner\\'s or administrator\\'s own device.</p>'\n"
         + "    + '<h3>Policy</h3><p>PIN at least ' + s.policy.min_pin_len + '; offline copies ' + (s.policy.allow_offline_copy ? 'allowed' : 'not allowed') + '; offline days ' + (s.policy.max_offline_days || 'no limit') + '; password rules ' + esc(s.policy.password_rules || 'none') + '; recovery ' + (s.recovery ? s.recovery.threshold + ' of ' + s.recovery.of + ' after ' + s.recovery.delay + ' s' : 'off') + '</p>'\n"
         + "    + '<h3>People</h3><table><tr><th>Name</th><th>Directory id</th><th>Role</th></tr>' + s.members.map(m => '<tr><td>' + esc(m.name) + '</td><td>' + esc(m.ext) + '</td><td>' + m.role + '</td></tr>').join('') + '</table>'\n"
         + "    + '<h3>Groups</h3><table><tr><th>Name</th><th>People</th><th>Id</th></tr>' + s.groups.map(g => '<tr><td>' + esc(g.name) + '</td><td>' + g.people + '</td><td><code>' + g.id + '</code></td></tr>').join('') + '</table>'\n"
         + "    + '<h3>Queue a change</h3><select id=kind><option value=invite>Invite (directory id, name, group ids)</option><option value=group-add>Add to group (group id, log id)</option><option value=group-remove>Remove from group (group id, log id)</option><option value=remove>Remove person (log id)</option><option value=policy>Policy (key, value)</option><option value=sync>Sync</option></select>'\n"
         + "    + '<input id=a placeholder=first><input id=b placeholder=second><input id=c placeholder=third><button id=queue>Queue</button>'\n"
         + "    + '<h3>Changes</h3><table><tr><th>Change</th><th>Status</th><th>Result</th></tr>' + s.changes.map(c => '<tr><td>' + esc(c.kind + ' ' + c.a + ' ' + c.b + ' ' + c.c) + '</td><td>' + c.status + '</td><td>' + esc(c.result) + '</td></tr>').join('') + '</table>';\n"
         + "  $('queue').onclick = async () => { await api('/change', {kind: $('kind').value, a: $('a').value, b: $('b').value, c: $('c').value}); show(); };\n"
         + "}\n"
         + "show();\n"
         + "\n";
}
