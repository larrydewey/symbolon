// The relay with sign-in and access control for organizations (SPEC
// 29.4), in front of the plain relay (net/services.resid).
//
// The relay stays untrusted for confidentiality and integrity: devices
// verify everything. For an organization it adds what a company expects
// of its server: only current members read the membership record, the
// group folders and the audit log; only a folder's people write to it, so
// someone taken out of a group cannot write with the old key until the
// next re-key; governance and membership records, group folders and audit
// events are verified before they are stored, written once where they are
// a history; and a person the company directory turns off loses access at
// once (SPEC 29.7), before an administrator's device signs them out.
//
//   GET  /auth/challenge       32 random bytes, hex; good for five minutes, once
//   POST /auth                 "CHALLENGE LOG PARTY SIG" (hex): SIG by device PARTY of
//                              log LOG over "symbolon v1 relay auth" || CHALLENGE;
//                              answers "TOKEN UNTIL", a bearer token for seven days
//   GET  /healthz              "ok"
//   GET  /directory/<org>      the company directory (scim.resid) for an owner's or
//                              administrator's device; 404 when there is none
//   /scim/v2/...               the directory's SCIM 2.0 service (scim.resid)
//   GET  /list/<prefix>?after=<name>   as the plain relay, from after <name>, without
//                              the names the caller may not read
//
// The relay verifies the device's log itself, from the events it stores,
// at the time its witnesses sign. Records are checked against the device
// that signed in: a record's signer must be that device.

import "../types.resid";
import "../core/log.resid";
import "../net/services.resid";
import "../net/store.resid";
import "state.resid";
import "common.resid";
import "serials.resid";
import "orgtypes.resid";
import "orgcore.resid";
import "scim.resid";
import "../browser/json.resid";
import "crypto.resid";
import "ecdsa.resid";
import "cose.resid";
import "httpserv.resid";
import "clock.resid";

// `ca`: the trust anchor for the witnesses the relay asks for the time;
// `store`: where it keeps everything (net/store.resid).
// `console`: the console's origin ("https://HOST:PORT", HOST its WebAuthn
// RP ID), "" for no console.
pub type RelayCfg = { StoreCfg store; Str ca; Str console; };

// Who made a request: the device of a log that signed in, or nobody.
pub type Who = { Bool on; List(Int) log; List(Int) party; List(Int) key; };

Who nobody() { return Who {.on = false, .log = [], .party = [], .key = []}; }

Int session_secs() { return 604800; }

Bool hex_ok(Str s, Int i) {
    if (i >= str_len(s)) { return str_len(s) > 0 && str_len(s) % 2 == 0; }
    Int c = str_char_at(s, i);
    return ((c >= 48 && c <= 57) || (c >= 97 && c <= 102)) && hex_ok(s, i + 1);
}

Bool hex_len(Str s, Int n) { return str_len(s) == n && hex_ok(s, 0); }

Str seg_at(List(Str) p, Int i) { return if (i < p.len()) { p[i] } else { "" }; }

// A log the company directory turned off (SPEC 29.7): the file holds why.
@requires(filesystem, network, clock(readonly), declassify)
pub Bool suspended(Store root, List(Int) l) { return str_len(str_trim(st_read_text(root, "suspended/" + hex_encode(l)))) > 0; }

@requires(filesystem, network, clock(readonly), declassify)
pub Who who_of(Store root, HttpRequest r) {
    Str h = http_header(r, "authorization");
    if (str_len(h) != 71 || str_slice(h, 0, 7) != "Bearer ") { return nobody(); }
    Str t = str_slice(h, 7, 71);
    if (!hex_len(t, 64)) { return nobody(); }
    List(Str) p = str_split(str_trim(st_read_text(root, "auth/tok-" + hex_encode(sha256_bytes(utf8(t))))), " ");
    if (p.len() != 4 || !hex_len(p[0], 64) || !hex_ok(p[1], 0) || !hex_ok(p[2], 0) || str_parse_int(p[3]) < clock_now_seconds()) { return nobody(); }
    List(Int) l = cose_hex_decode(p[0]);
    if (suspended(root, l)) { return nobody(); }
    return Who {.on = true, .log = l, .party = cose_hex_decode(p[1]), .key = cose_hex_decode(p[2])};
}

// ─── Signing in ─────────────────────────────────────────────────

pub List(Int) auth_message(List(Int) chal) { return utf8("symbolon v1 relay auth").concat(chal); }

@requires(filesystem, network, clock(readonly), declassify)
HttpReply challenge(Store root) {
    List(Int) c = random_bytes(32);
    return if (st_text(root, "auth/chal-" + hex_encode(c), f"{clock_now_seconds()}")) { http_reply_text(200, "text/plain", hex_encode(c)) } else { http_reply_status(500) };
}

@requires(filesystem, network, clock(readonly), declassify)
HttpReply sign_in(RelayCfg g, Store root, HttpRequest r) {
    List(Str) p = str_split(str_trim(http_body_text(r)), " ");
    if (p.len() != 4 || !hex_len(p[0], 64) || !hex_len(p[1], 64) || !hex_ok(p[2], 0) || !hex_ok(p[3], 0)) { return http_reply_status(400); }
    Str cf = "auth/chal-" + p[0];
    Str ct = str_trim(st_read_text(root, cf));
    if (str_len(ct) == 0) { return http_reply_status(403); }
    _ = st_text(root, cf, "used");
    if (ct == "used" || str_parse_int(ct) + 300 < clock_now_seconds()) { return http_reply_status(403); }
    List(Int) l = cose_hex_decode(p[1]);
    if (suspended(root, l)) { return http_reply_status(403); }
    Result(VerifiedHead, SymbolonError) rv = verified_events(l, log_dir(root, l, (UInt(64))0, []), g.ca, "");
    return match rv {
        Err(_) => http_reply_status(403),
        Ok(vh) => signed_in(root, vh, l, cose_hex_decode(p[2]), cose_hex_decode(p[0]), cose_hex_decode(p[3]))
    };
}

@requires(filesystem, network, clock(readonly), declassify)
HttpReply signed_in(Store root, VerifiedHead vh, List(Int) l, List(Int) party, List(Int) chal, List(Int) sig) {
    Option(Party) d = device_party(vh.head.quorum.parties, party, 0);
    return match d {
        None => http_reply_status(403),
        Some(x) => if (ecdsa_verify_raw(P256, Sha256, x.auth_key, auth_message(chal), sig)) { issue(root, l, x) } else { http_reply_status(403) }
    };
}

@requires(filesystem, network, clock(readonly), declassify)
HttpReply issue(Store root, List(Int) l, Party d) {
    Str t = hex_encode(random_bytes(32));
    Int until = clock_now_seconds() + session_secs();
    Bool ok = st_text(root, "auth/tok-" + hex_encode(sha256_bytes(utf8(t))), hex_encode(l) + " " + hex_encode(d.id) + " " + hex_encode(d.auth_key) + f" {until}");
    return if (ok) { http_reply_text(200, "text/plain", t + f" {until}") } else { http_reply_status(500) };
}

// The log `l` as this relay stores it, from `seq` until the first gap.
@requires(filesystem, network, clock(readonly), declassify)
pub List(SignedEvent) log_dir(Store root, List(Int) l, UInt(64) seq, List(SignedEvent) acc) {
    Option(List(Int)) b = st_get(root, "log/" + hex_encode(l) + "/" + f"{seq}");
    if (match b { None => true, Some(_) => false }) { return acc; }
    return match event_of_cbor(b else { [] }) {
        None => acc,
        Some(se) => match signed_of(se) { None => acc, Some(e) => log_dir(root, l, seq + (UInt(64))1, acc.concat([e])) }
    };
}

// ─── An organization as the relay holds it ──────────────────────
// What is stored was verified when it was written (below), so the relay
// reads it back as it is.

@requires(filesystem, network, clock(readonly), declassify)
List(Int) stored(Store root, Str name) { return st_bytes(root, "blob/" + name); }

// The number of governance versions stored for `id` (hex).
@requires(filesystem, network, clock(readonly), declassify)
pub Int gov_count(Store root, Str id, Int n) {
    return if (stored(root, "orggov-" + id + "-" + f"{n + 1}").len() > 0) { gov_count(root, id, n + 1) } else { n };
}

@requires(filesystem, network, clock(readonly), declassify)
pub Option(OrgState) relay_org(Store root, Str id) {
    Int n = gov_count(root, id, 0);
    if (n == 0) { return None; }
    Option(OrgGov) g = gov_of(stored(root, "orggov-" + id + "-" + f"{n}"));
    Option(Org) o = org_of(stored(root, "org-" + id));
    return match g { None => None, Some(gv) => match o { None => None, Some(ov) => Some(OrgState {.gov = gv, .org = ov}) } };
}

@requires(filesystem, network, clock(readonly), declassify)
Bool in_org(Store root, Str id, Who w) {
    if (!w.on || !hex_len(id, 32)) { return false; }
    return match relay_org(root, id) { None => false, Some(st) => member_index(st.org.members, w.log, 0) >= 0 };
}

@requires(filesystem, network, clock(readonly), declassify)
Bool admin_of(Store root, Str id, Who w) {
    if (!w.on || !hex_len(id, 32)) { return false; }
    return match relay_org(root, id) { None => false, Some(st) => member_index(st.org.members, w.log, 0) >= 0 && is_admin(st.gov, w.log) && att_ok(st, w) };
}

// The org id in "audit-<org>-...", "invite-<org>-...", "accept-<org>-...".
Str org_part(Str name, Int at) { return if (str_len(name) >= at + 32) { str_slice(name, at, at + 32) } else { "" }; }

// The collection a blob belongs to: "coll-<cid>", "roster-<cid>",
// "wrap-<log>-<cid>", "leave-<cid>-<log>"; "" for any other.
pub Str folder_of(Str n) {
    Int len = str_len(n);
    if (len == 37 && str_starts_with(n, "coll-")) { return str_slice(n, 5, 37); }
    if (len == 39 && str_starts_with(n, "roster-")) { return str_slice(n, 7, 39); }
    if (len == 102 && str_starts_with(n, "wrap-")) { return str_slice(n, 70, 102); }
    if (len == 103 && str_starts_with(n, "leave-")) { return str_slice(n, 6, 38); }
    return "";
}

// Whether `w` is one of a group folder's people; true for a collection
// that is not a group folder (a household's shared folders keep the
// plain relay's rules: their records are signed, their items sealed).
@requires(filesystem, network, clock(readonly), declassify)
Bool folder_person(Store root, Str cid, Who w) {
    List(Int) b = stored(root, "gfolder-" + cid);
    if (b.len() == 0) { return true; }
    if (!w.on) { return false; }
    return match gfolder_of(b) {
        None => false,
        Some(f) => match relay_org(root, hex_encode(f.org_id)) { None => false, Some(st) => person_in(folder_people(st, f.groups), w.log, 0) && directory_allows(root, st, f.groups, w.log) && att_ok(st, w) }
    };
}

// The company directory can only take away (SPEC 29.7): an owner or
// administrator keeps a group folder; anyone else needs one of its groups
// that the directory does not contradict: a directory group of the same
// name that does not list them takes that group away at once, before an
// administrator's device signs the change.
@requires(filesystem, network, clock(readonly), declassify)
Bool directory_allows(Store root, OrgState st, List(List(Int)) gids, List(Int) l) {
    Str org = hex_encode(st.org.org_id);
    if (is_admin(st.gov, l) || !scim_on(root, org)) { return true; }
    Int mi = member_index(st.org.members, l, 0);
    if (mi < 0) { return false; }
    return any_group_ok(st.org.groups, gids, l, st.org.members[mi].ext_id, all_groups(root, org), all_users(root, org), 0);
}

Bool any_group_ok(List(OrgGroup) gs, List(List(Int)) gids, List(Int) l, Str ext, List(DirGroup) dgs, List(DirUser) us, Int i) {
    if (i >= gs.len()) { return false; }
    Bool ok = has_log(gids, gs[i].group_id) && has_log(gs[i].members, l) && directory_keeps(gs[i].name, ext, dgs, us, 0);
    return ok || any_group_ok(gs, gids, l, ext, dgs, us, i + 1);
}

// No directory group of this name, or one that lists the user `ext` names.
Bool directory_keeps(Str name, Str ext, List(DirGroup) dgs, List(DirUser) us, Int i) {
    if (i >= dgs.len()) { return true; }
    if (dgs[i].display == name) { return lists_user(dgs[i].members, ext, us, 0); }
    return directory_keeps(name, ext, dgs, us, i + 1);
}

Bool lists_user(List(Str) ids, Str ext, List(DirUser) us, Int i) {
    if (i >= us.len()) { return false; }
    return (us[i].active && has_str(ids, us[i].id, 0) && names_user(ext, us[i])) || lists_user(ids, ext, us, i + 1);
}

Bool person_in(List(Member) ms, List(Int) l, Int i) {
    if (i >= ms.len()) { return false; }
    return bytes_eq(ms[i].log_id, l) || person_in(ms, l, i + 1);
}

@requires(filesystem, network, clock(readonly), declassify)
pub Bool may_read(Store root, Str name, Who w) {
    if (str_starts_with(name, "orggov-")) { return w.on; }
    if (str_starts_with(name, "org-")) { return in_org(root, str_slice(name, 4, str_len(name)), w); }
    if (str_starts_with(name, "audit-")) { return admin_of(root, org_part(name, 6), w); }
    if (str_starts_with(name, "escrow-")) { return escrow_read(root, name, w); }
    if (str_starts_with(name, "conkey-")) { return admin_of(root, org_part(name, 7), w); }
    if (str_starts_with(name, "attev-") || str_starts_with(name, "attresp-") || str_starts_with(name, "attchal-")) { return in_org(root, org_part(name, str_index_of(name, "-", 0) + 1), w); }
    if (str_starts_with(name, "recreq-")) { return in_org(root, org_part(name, 7), w); }
    if (str_starts_with(name, "invite-") || str_starts_with(name, "accept-")) { return admin_of(root, org_part(name, 7), w); }
    if (str_starts_with(name, "gfolder-")) {
        return match gfolder_of(stored(root, name)) { None => w.on, Some(f) => in_org(root, hex_encode(f.org_id), w) };
    }
    Str cid = folder_of(name);
    return str_len(cid) == 0 || folder_person(root, cid, w);
}

// Why `w` may not store `body` as `name`; "" when it may.
@requires(filesystem, network, clock(readonly), declassify)
pub Str may_write(Store root, Str name, List(Int) body, Who w) {
    if (str_starts_with(name, "orggov-")) { return gov_write(root, name, body, w); }
    if (str_starts_with(name, "org-")) { return org_write(root, name, body, w); }
    if (str_starts_with(name, "gfolder-")) { return gfolder_write(root, name, body, w); }
    if (str_starts_with(name, "audit-")) { return audit_write(root, name, body, w); }
    if (str_starts_with(name, "invite-")) { return if (admin_of(root, org_part(name, 7), w)) { "" } else { "only an owner or administrator writes an invite" }; }
    if (str_starts_with(name, "accept-")) { return accept_write(root, name, body, w); }
    if (str_starts_with(name, "escrow-")) { return escrow_write(root, name, body, w); }
    if (str_starts_with(name, "conkey-")) { return conkey_write(root, name, body, w); }
    if (str_starts_with(name, "attev-") || str_starts_with(name, "attresp-") || str_starts_with(name, "attchal-")) { return att_write(root, name, body, w); }
    if (str_starts_with(name, "recreq-")) { return recreq_write(root, name, body, w); }
    Str cid = folder_of(name);
    if (str_len(cid) > 0 && !folder_person(root, cid, w)) { return "not one of the group folder's people"; }
    return "";
}

@requires(declassify)
Bool by_device(Who w, List(Int) log, List(Int) party, List(Int) tbs, List(Int) sig) {
    return w.on && bytes_eq(log, w.log) && bytes_eq(party, w.party) && ecdsa_verify_raw(P256, Sha256, w.key, tbs, sig);
}

@requires(filesystem, network, clock(readonly), declassify)
Str gov_write(Store root, Str name, List(Int) body, Who w) {
    if (!w.on) { return "sign in first"; }
    return match gov_of(body) { None => "the governance record does not decode", Some(g) => gov_ok(root, name, g, w) };
}

@requires(filesystem, network, clock(readonly), declassify)
Str gov_ok(Store root, Str name, OrgGov g, Who w) {
    Str id = hex_encode(g.org_id);
    if (name != gov_blob(g.org_id, g.version) || g.org_id.len() != 16) { return "stored under another name"; }
    Int n = gov_count(root, id, 0);
    if ((Int)g.version != n + 1) { return "governance versions are written once, in order"; }
    if (g.owners.len() == 0) { return "an organization needs an owner"; }
    if (!by_device(w, g.signer_log, g.signer, gov_tbs(g), g.sig)) { return "not signed by the device that signed in"; }
    if (n == 0) {
        return if (bytes_eq(g.signer_log, g.founder) && bytes_eq(org_id_of(g.founder, g.nonce), g.org_id)) { "" } else { "the first version is the founder's" };
    }
    return match gov_of(stored(root, gov_blob(g.org_id, (UInt(64))n))) {
        None => "the version before does not decode",
        Some(p) => if (is_owner(p, g.signer_log) && bytes_eq(p.nonce, g.nonce) && bytes_eq(p.founder, g.founder)) { "" } else { "not signed by an owner of the version before" }
    };
}

@requires(filesystem, network, clock(readonly), declassify)
Str org_write(Store root, Str name, List(Int) body, Who w) {
    if (!w.on) { return "sign in first"; }
    return match org_of(body) { None => "the membership record does not decode", Some(o) => org_ok(root, name, o, w) };
}

@requires(filesystem, network, clock(readonly), declassify)
Str org_ok(Store root, Str name, Org o, Who w) {
    Str id = hex_encode(o.org_id);
    if (name != org_blob(o.org_id) || o.org_id.len() != 16) { return "stored under another name"; }
    Int n = gov_count(root, id, 0);
    if (n == 0 || (Int)o.gov_version != n) { return "not under the latest governance"; }
    Option(OrgGov) og = gov_of(stored(root, gov_blob(o.org_id, (UInt(64))n)));
    Bool admin = match og { None => false, Some(g) => is_admin(g, o.signer_log) };
    if (!admin) { return "not signed by an owner or administrator"; }
    if (!by_device(w, o.signer_log, o.signer, org_tbs(o), o.sig)) { return "not signed by the device that signed in"; }
    return match org_of(stored(root, name)) {
        None => "",
        Some(prev) => if (o.version > prev.version) { "" } else { "an older membership record" }
    };
}

@requires(filesystem, network, clock(readonly), declassify)
Str gfolder_write(Store root, Str name, List(Int) body, Who w) {
    if (!w.on) { return "sign in first"; }
    return match gfolder_of(body) { None => "the group folder does not decode", Some(f) => gfolder_ok(root, name, f, w) };
}

@requires(filesystem, network, clock(readonly), declassify)
Str gfolder_ok(Store root, Str name, GroupFolder f, Who w) {
    if (name != gfolder_blob(hex_encode(f.coll_id)) || f.coll_id.len() != 16) { return "stored under another name"; }
    Bool admin = match relay_org(root, hex_encode(f.org_id)) { None => false, Some(st) => is_admin(st.gov, f.signer_log) };
    if (!admin) { return "not signed by an owner or administrator"; }
    if (!by_device(w, f.signer_log, f.signer, gfolder_tbs(f), f.sig)) { return "not signed by the device that signed in"; }
    return match gfolder_of(stored(root, name)) {
        None => "",
        Some(prev) => if (f.version > prev.version && bytes_eq(f.org_id, prev.org_id)) { "" } else { "an older group folder" }
    };
}

@requires(filesystem, network, clock(readonly), declassify)
Str audit_write(Store root, Str name, List(Int) body, Who w) {
    if (stored(root, name).len() > 0) { return "audit events are written once"; }
    return match event_of(body) {
        None => "the event does not decode",
        Some(e) => if (name != audit_blob(e.org_id, e.log_id, e.seq)) { "stored under another name" } else {
            if (!in_org(root, hex_encode(e.org_id), w)) { "not in the organization" } else {
                if (by_device(w, e.log_id, e.party, event_tbs(e), e.sig)) { "" } else { "not signed by the device that signed in" } } }
    };
}

@requires(filesystem, network, clock(readonly), declassify)
Str accept_write(Store root, Str name, List(Int) body, Who w) {
    if (body.len() == 0) { return if (admin_of(root, org_part(name, 7), w)) { "" } else { "only an owner or administrator clears an answer" }; }
    if (stored(root, name).len() > 0) { return "the invite was answered already"; }
    return match accept_of(body) {
        None => "the answer does not decode",
        Some(a) => if (name != accept_blob(a.org_id, a.id)) { "stored under another name" } else {
            if (by_device(w, a.log_id, a.signer, accept_tbs(a), a.sig)) { "" } else { "not signed by the device that signed in" } }
    };
}

// A work folder's escrow is its owner's; a recovery administrator reads it
// only with a request of their own whose delay has passed by this relay's
// clock, a second line behind the approving devices' witness time (SPEC 29.8).
@requires(filesystem, network, clock(readonly), declassify)
Bool escrow_read(Store root, Str name, Who w) {
    Str org = org_part(name, 7);
    if (!in_org(root, org, w)) { return false; }
    Option(OrgEscrow) oe = escrow_of(stored(root, name));
    if (match oe { None => true, Some(e) => bytes_eq(e.owner, w.log) }) { return true; }
    Option(OrgRecoveryRequest) oq = recreq_of(stored(root, "recreq-" + str_slice(name, 7, str_len(name))));
    Option(OrgState) ost = relay_org(root, org);
    return match oq {
        None => false,
        Some(q) => match ost {
            None => false,
            Some(st) => rec_admin(root, org, w) && bytes_eq(q.requester, w.log) && clock_now_seconds() >= q.time + st.gov.recovery.delay_sec
        }
    };
}

// A work folder's escrow, by its owner's device, in the organization.
@requires(filesystem, network, clock(readonly), declassify)
Str escrow_write(Store root, Str name, List(Int) body, Who w) {
    return match escrow_of(body) {
        None => "the escrow does not decode",
        Some(e) => if (name != escrow_blob(e.org_id, hex_encode(e.coll_id)) || !in_org(root, hex_encode(e.org_id), w)) { "stored under another name, or not in the organization" } else {
            if (by_device(w, e.owner, e.signer, escrow_tbs(e), e.sig)) { "" } else { "not signed by the device that signed in" } }
    };
}

// Attestation records (SPEC 29.5): evidence and answers by the device they
// are about, challenges by an owner's or administrator's device.
@requires(filesystem, network, clock(readonly), declassify)
Str att_write(Store root, Str name, List(Int) body, Who w) {
    Str org = org_part(name, str_index_of(name, "-", 0) + 1);
    if (!in_org(root, org, w)) { return "not in the organization"; }
    if (str_starts_with(name, "attev-")) {
        return match attev_of(body) { None => "the evidence does not decode", Some(e) => if (name == att_blob("attev", e.org_id, e.party) && bytes_eq(e.party, w.party) && by_device(w, e.log_id, e.signer, attev_tbs(e), e.sig)) { "" } else { "not the signed-in device's own evidence" } };
    }
    if (str_starts_with(name, "attresp-")) {
        return match attresp_of(body) { None => "the response does not decode", Some(r) => if (name == att_blob("attresp", r.org_id, r.party) && bytes_eq(r.party, w.party) && by_device(w, w.log, r.signer, attresp_tbs(r), r.sig)) { "" } else { "not the signed-in device's own response" } };
    }
    if (!admin_of(root, org, w)) { return "only an owner or administrator challenges a device"; }
    return match attchal_of(body) { None => "the challenge does not decode", Some(c) => if (name == att_blob("attchal", c.org_id, c.party) && by_device(w, c.by_log, c.signer, attchal_tbs(c), c.sig)) { "" } else { "not signed by the device that signed in" } };
}

// When the policy requires attestation, an unattested device of a member
// reads and writes no group folder and no audit event (SPEC 29.5).
Bool att_ok(OrgState st, Who w) { return !requires_att(st.gov, "tpm") || has_log(st.org.attested, w.party); }

// A console passkey, approved by an owner's or administrator's device for
// themselves, of one waiting at the console (empty: withdrawn by an admin).
@requires(filesystem, network, clock(readonly), declassify)
Str conkey_write(Store root, Str name, List(Int) body, Who w) {
    Str org = org_part(name, 7);
    if (!admin_of(root, org, w)) { return "only an owner or administrator approves a console passkey"; }
    if (body.len() == 0) { return ""; }
    return match conkey_of(body) {
        None => "the console key does not decode",
        Some(k) => if (name != conkey_blob(k.org_id, k.cred_id) || !bytes_eq(k.log_id, w.log) || !by_device(w, k.log_id, k.signer, conkey_tbs(k), k.sig)) { "not signed by the device that signed in, for itself" } else {
            if (pending_matches(str_split(str_trim(st_read_text(root, "console/" + org + "/pend-" + str_slice(hex_encode(sha256_bytes(k.cred_id)), 0, 32))), " "), k)) { "" } else { "no such passkey waiting at the console" } }
    };
}

Bool pending_matches(List(Str) p, OrgConsoleKey k) { return p.len() == 5 && p[1] == hex_encode(k.cred_id) && p[2] == hex_encode(k.public_key) && p[3] == k.rp_id; }

// A recovery request, by a recovery administrator's device, while recovery is on.
@requires(filesystem, network, clock(readonly), declassify)
Str recreq_write(Store root, Str name, List(Int) body, Who w) {
    if (body.len() == 0) { return if (rec_admin(root, org_part(name, 7), w)) { "" } else { "only a recovery administrator clears a request" }; }
    return match recreq_of(body) {
        None => "the request does not decode",
        Some(q) => if (name != recreq_blob(q.org_id, hex_encode(q.coll_id)) || !rec_admin(root, hex_encode(q.org_id), w)) { "not a recovery administrator" } else {
            if (by_device(w, q.requester, q.signer, recreq_tbs(q), q.sig)) { "" } else { "not signed by the device that signed in" } }
    };
}

@requires(filesystem, network, clock(readonly), declassify)
Bool rec_admin(Store root, Str id, Who w) {
    if (!w.on || !hex_len(id, 32)) { return false; }
    return match relay_org(root, id) { None => false, Some(st) => st.gov.recovery.on && has_log(st.gov.recovery.admins, w.log) && member_index(st.org.members, w.log, 0) >= 0 };
}

// ─── Requests ───────────────────────────────────────────────────

// One request: the store opened for it (one database connection) and
// closed after.
@requires(filesystem, network, clock(readonly), declassify)
pub HttpReply relay_serve_handle(RelayCfg g, HttpRequest r) {
    if (r.path == "/healthz" && r.method == "GET") { return http_reply_text(200, "text/plain", "ok"); }
    Store st = store_open(g.store);
    HttpReply rep = if (store_ok(st)) { handle(g, st, r) } else { http_reply_status(503) };
    _ = store_close(st);
    return rep;
}

@requires(filesystem, network, clock(readonly), declassify)
HttpReply handle(RelayCfg g, Store root, HttpRequest r) {
    if (r.path == "/auth/challenge" && r.method == "GET") { return challenge(root); }
    if (r.path == "/auth" && r.method == "POST") { return sign_in(g, root, r); }
    if (str_starts_with(r.path, "/scim/")) { return scim_handle(root, r); }
    if (str_starts_with(r.path, "/console/") || r.path == "/console") { return console_handle(g, root, r); }
    List(Str) p = str_split(r.path, "/");
    Str kind = seg_at(p, 1);
    if (p.len() == 3 && kind == "directory" && r.method == "GET") { return directory_reply(root, p[2], who_of(root, r)); }
    if (kind == "mbox" || kind == "log") { return plain(root, r, p); }
    if (p.len() != 3 || (kind != "blob" && kind != "list") || !blob_ok(p[2], 0)) { return http_reply_status(404); }
    Who w = who_of(root, r);
    Str name = p[2];
    Int denied = if (w.on) { 403 } else { 401 };
    if (kind == "list") { return if (r.method == "GET") { listed(root, name, http_query_param(r.query, "after"), w) } else { http_reply_status(404) }; }
    if (r.method == "GET") {
        if (!may_read(root, name, w)) { return http_reply_status(denied); }
        return match st_get(root, "blob/" + name) { Some(b) => http_reply_bytes(200, "application/octet-stream", b), None => http_reply_status(404) };
    }
    if (r.method == "PUT") {
        Str why = may_write(root, name, r.body, w);
        if (str_len(why) > 0) { return http_reply_text(denied, "text/plain", why); }
        if (r.body.len() > max_body()) { return http_reply_status(413); }
        return if (st_put(root, "blob/" + name, r.body)) { http_reply_status(200) } else { http_reply_status(500) };
    }
    return http_reply_status(404);
}

Int max_body() { return 16781312; }

Bool blob_ok(Str s, Int i) {
    if (str_len(s) == 0 || str_len(s) > 128) { return false; }
    if (i >= str_len(s)) { return true; }
    Int c = str_char_at(s, i);
    Bool ok = (c >= 48 && c <= 57) || (c >= 97 && c <= 122) || c == 46 || c == 95 || c == 45;
    return ok && !(i == 0 && c == 46) && blob_ok(s, i + 1);
}

Bool dec_ok(Str s, Int i) {
    if (str_len(s) == 0 || str_len(s) > 19) { return false; }
    if (i >= str_len(s)) { return true; }
    Int c = str_char_at(s, i);
    return c >= 48 && c <= 57 && dec_ok(s, i + 1);
}

// The plain relay's mailboxes and logs (net/services.resid), over the store.
@requires(filesystem, network, clock(readonly), declassify)
HttpReply plain(Store root, HttpRequest r, List(Str) p) {
    Str kind = seg_at(p, 1);
    Str who = seg_at(p, 2);
    if (str_len(who) > 128 || !hex_ok(who, 0)) { return http_reply_status(404); }
    if (kind == "mbox" && r.method == "POST" && p.len() == 3) {
        if (r.body.len() == 0 || r.body.len() > max_body()) { return http_reply_status(413); }
        return mbox_put_at(root, who, st_list(root, "mbox/" + who + "/", "", 1048576).len(), r.body, 0);
    }
    if (p.len() != 4 || !dec_ok(p[3], 0)) { return http_reply_status(404); }
    Str k = kind + "/" + who + "/" + f"{str_parse_int(p[3])}";
    if (r.method == "GET") { return match st_get(root, k) { Some(b) => http_reply_bytes(200, "application/octet-stream", b), None => http_reply_status(404) }; }
    if (kind == "log" && r.method == "POST") {
        if (r.body.len() > max_body()) { return http_reply_status(413); }
        Int w = st_put_new(root, k, r.body);
        return http_reply_status(if (w == 1) { 200 } else { if (w == 0) { 409 } else { 500 } });
    }
    return http_reply_status(404);
}

// The next free index from `n`: only one writer wins each.
@requires(filesystem, network, clock(readonly), declassify)
HttpReply mbox_put_at(Store root, Str to, Int n, List(Int) body, Int tries) {
    if (tries > 1000) { return http_reply_status(500); }
    Int w = st_put_new(root, "mbox/" + to + "/" + f"{n}", body);
    if (w == 1) { return http_reply_text(200, "text/plain", f"{n}"); }
    if (w < 0) { return http_reply_status(500); }
    return mbox_put_at(root, to, n + 1, body, tries + 1);
}

@requires(filesystem, network, clock(readonly), declassify)
HttpReply directory_reply(Store root, Str org, Who w) {
    if (!admin_of(root, org, w)) { return http_reply_status(if (w.on) { 403 } else { 401 }); }
    if (!scim_on(root, org)) { return http_reply_status(404); }
    return http_reply_text(200, "text/plain", directory_text(root, org));
}

// The names the caller may read that start with `prefix`, after `after`,
// sorted, at most max_listed(); a client asks again from the last name
// while it gets a full page.
@requires(filesystem, network, clock(readonly), declassify)
HttpReply listed(Store root, Str prefix, Str after, Who w) {
    if (!blob_ok(prefix, 0)) { return http_reply_status(404); }
    List(Str) keys = st_list(root, "blob/" + prefix, if (str_len(after) == 0) { "" } else { "blob/" + after }, 1048576);
    List(Str) names = readable(root, keys, w, 0, ListBuf());
    return http_reply_text(200, "text/plain", str_join(if (names.len() > max_listed()) { names[0..max_listed()] } else { names }, "\n"));
}

@requires(filesystem, network, clock(readonly), declassify)
List(Str) readable(Store root, List(Str) keys, Who w, Int i, ListBuf(Str) acc) {
    if (i >= keys.len()) { return acc.finish(); }
    Str n = str_slice(keys[i], 5, str_len(keys[i]));
    return readable(root, keys, w, i + 1, if (may_read(root, n, w)) { acc.push(n) } else { acc });
}

// ─── The console (SPEC 29.10) ───────────────────────────────────
// Served by the relay at /console/<org> when it is given an origin
// (--console-origin). An owner or administrator signs in with a passkey
// their device approved (conkey-, below); the console shows the
// organization as the relay holds it (its records were verified when they
// were written) and queues changes, which only an owner's or
// administrator's device signs (`org changes`, `org approve`, or the app).
//
//   GET  /console/<org>                 the page;  GET /console/app.js  its script
//   GET  /console/<org>/challenge       {"challenge","rpId"} for a sign-in
//   POST /console/<org>/register        {"credentialId","publicKey"} (SPKI), base64url:
//                                       a passkey waiting for approval; {"code"}
//   POST /console/<org>/login           a WebAuthn assertion; sets the session cookie
//   GET  /console/<org>/state           the organization (session)
//   POST /console/<org>/change          {"kind","a","b","c"}: a change to approve (session)
//   GET  /console/<org>/pending         "CODE CRED-HEX PUB-HEX RP" per waiting passkey (device session)
//   GET  /console/<org>/changes         "ID KIND A-HEX B-HEX C-HEX BY STATUS" (device session)
//   POST /console/<org>/done/<id>       the change done, the body its result (device session)

Str b64u_text(List(Int) b) { return str_replace(str_replace(str_replace(base64_encode(b), "+", "-"), "/", "_"), "=", ""); }

List(Int) b64u(Str s) {
    Str t = str_replace(str_replace(s, "-", "+"), "_", "/");
    Int pad = (4 - str_len(t) % 4) % 4;
    return base64_decode(t + (if (pad == 2) { "==" } else { if (pad == 1) { "=" } else { "" } }));
}

Str jq(Str s) { return json_quote(s); }

HttpReply json_reply(Int status, Str body) {
    return http_with_header(http_reply_text(status, "application/json", body), "Cache-Control", "no-store");
}

// The P-256 point of an SPKI (DER): its last 65 bytes, uncompressed.
List(Int) spki_point(List(Int) d) { return if (d.len() >= 65 && d[d.len() - 65] == 4) { d[d.len() - 65..d.len()] } else { [] }; }

// An ECDSA signature in DER as r || s, 32 bytes each.
List(Int) der_rs(List(Int) d) {
    if (d.len() < 8 || d[0] != 48 || d[2] != 2) { return []; }
    Int rl = d[3];
    if (4 + rl + 2 > d.len() || d[4 + rl] != 2) { return []; }
    Int sl = d[5 + rl];
    if (6 + rl + sl > d.len()) { return []; }
    return fixed32(d[4..4 + rl]).concat(fixed32(d[6 + rl..6 + rl + sl]));
}

List(Int) fixed32(List(Int) x) {
    if (x.len() > 32) { return x[x.len() - 32..x.len()]; }
    return zeros(32 - x.len()).concat(x);
}

List(Int) zeros(Int n) { return if (n <= 0) { [] } else { [0].concat(zeros(n - 1)) }; }

Str rp_of(Str origin) {
    Str h = str_slice(origin, str_index_of(origin, "://", 0) + 3, str_len(origin));
    Int c = str_index_of(h, ":", 0);
    return if (c < 0) { h } else { str_slice(h, 0, c) };
}

// The console session from the cookie: [org, log hex], or [].
@requires(filesystem, network, clock(readonly), declassify)
List(Str) con_session(Store root, HttpRequest r) {
    Str ck = http_header(r, "cookie");
    Int at = str_index_of(ck, "symcon=", 0);
    if (at < 0) { return []; }
    Str t0 = str_slice(ck, at + 7, str_len(ck));
    Int semi = str_index_of(t0, ";", 0);
    Str t = if (semi < 0) { t0 } else { str_slice(t0, 0, semi) };
    if (!hex_len(t, 64)) { return []; }
    List(Str) p = str_split(str_trim(st_read_text(root, "auth/con-" + hex_encode(sha256_bytes(utf8(t))))), " ");
    if (p.len() != 3 || str_parse_int(p[2]) < clock_now_seconds()) { return []; }
    List(Int) l = cose_hex_decode(p[1]);
    if (suspended(root, l)) { return []; }
    // Still an owner or administrator now.
    return match relay_org(root, p[0]) { None => [], Some(st) => if (is_admin(st.gov, l) && member_index(st.org.members, l, 0) >= 0) { p[0..2] } else { [] } };
}

@requires(filesystem, network, clock(readonly), declassify)
HttpReply console_handle(RelayCfg g, Store root, HttpRequest r) {
    if (str_len(g.console) == 0) { return http_reply_status(404); }
    if (r.path == "/console/app.js") { return http_with_header(http_reply_text(200, "text/javascript", console_js()), "Cache-Control", "no-store"); }
    List(Str) p = str_split(r.path, "/");
    Str org = seg_at(p, 2);
    if (!hex_len(org, 32)) { return http_reply_status(404); }
    Str what = seg_at(p, 3);
    if (p.len() == 3 && r.method == "GET") { return console_page_html(org); }
    if (what == "challenge" && r.method == "GET") {
        List(Int) c = random_bytes(32);
        _ = st_text(root, "auth/conchal-" + hex_encode(c), f"{clock_now_seconds()}");
        return json_reply(200, "{\"challenge\":" + jq(b64u_text(c)) + ",\"rpId\":" + jq(rp_of(g.console)) + "}");
    }
    if (what == "register" && r.method == "POST") { return con_register(g, root, org, r); }
    if (what == "login" && r.method == "POST") { return con_login(g, root, org, r); }
    if (what == "state" && r.method == "GET") { return con_state(root, org, con_session(root, r)); }
    if (what == "change" && r.method == "POST") { return con_change(root, org, con_session(root, r), r); }
    Who w = who_of(root, r);
    if (!admin_of(root, org, w)) { return http_reply_status(if (w.on) { 403 } else { 401 }); }
    if (what == "pending" && r.method == "GET") { return http_reply_text(200, "text/plain", str_join(pend_lines(root, st_list(root, "console/" + org + "/pend-", "", 4096), 0, ListBuf()), "\n")); }
    if (what == "changes" && r.method == "GET") { return http_reply_text(200, "text/plain", str_join(change_lines(root, st_list(root, "console/" + org + "/change-", "", 4096), 0, ListBuf()), "\n")); }
    if (what == "done" && r.method == "POST" && p.len() == 5 && hex_len(p[4], 32)) { return con_done(root, org, p[4], w, r); }
    return http_reply_status(404);
}

@requires(filesystem, network, clock(readonly), declassify)
HttpReply con_register(RelayCfg g, Store root, Str org, HttpRequest r) {
    Jv v = json_parse(r.body) else { JNull };
    List(Int) cid = b64u(jstr(jget(v, "credentialId")));
    List(Int) pt = spki_point(b64u(jstr(jget(v, "publicKey"))));
    if (cid.len() < 16 || cid.len() > 1023 || pt.len() != 65) { return json_reply(400, "{\"error\":\"a credential id and an ES256 public key\"}"); }
    Str code = str_slice(hex_encode(sha256_bytes(cid)), 0, 8);
    Bool ok = st_text(root, "console/" + org + "/pend-" + str_slice(hex_encode(sha256_bytes(cid)), 0, 32), code + " " + hex_encode(cid) + " " + hex_encode(pt) + " " + rp_of(g.console) + f" {clock_now_seconds()}");
    return if (ok) { json_reply(200, "{\"code\":" + jq(code) + "}") } else { json_reply(500, "{}") };
}

@requires(filesystem, network, clock(readonly), declassify)
List(Str) pend_lines(Store root, List(Str) keys, Int i, ListBuf(Str) acc) {
    if (i >= keys.len()) { return acc.finish(); }
    List(Str) p = str_split(str_trim(st_read_text(root, keys[i])), " ");
    // A day to approve a waiting passkey.
    Bool live = p.len() == 5 && str_parse_int(p[4]) + 86400 > clock_now_seconds();
    return pend_lines(root, keys, i + 1, if (live) { acc.push(str_join(p[0..4], " ")) } else { acc });
}

@requires(filesystem, network, clock(readonly), declassify)
HttpReply con_login(RelayCfg g, Store root, Str org, HttpRequest r) {
    Jv v = json_parse(r.body) else { JNull };
    List(Int) cid = b64u(jstr(jget(v, "credentialId")));
    List(Int) ad = b64u(jstr(jget(v, "authenticatorData")));
    List(Int) cdj = b64u(jstr(jget(v, "clientDataJSON")));
    List(Int) sig = der_rs(b64u(jstr(jget(v, "signature"))));
    Option(OrgConsoleKey) ok = conkey_of(stored(root, conkey_blob(cose_hex_decode(org), cid)));
    if (cid.len() == 0 || sig.len() != 64 || ad.len() < 37) { return json_reply(400, "{\"error\":\"a WebAuthn assertion\"}"); }
    Jv cd = json_parse(cdj) else { JNull };
    List(Int) chal = b64u(jstr(jget(cd, "challenge")));
    Str cf = "auth/conchal-" + hex_encode(chal);
    Str ct = str_trim(st_read_text(root, cf));
    _ = st_text(root, cf, "used");
    Bool fresh = chal.len() == 32 && str_len(ct) > 0 && ct != "used" && str_parse_int(ct) + 300 >= clock_now_seconds();
    Bool shape = jstr(jget(cd, "type")) == "webauthn.get" && jstr(jget(cd, "origin")) == g.console && bytes_eq(ad[0..32], sha256_bytes(utf8(rp_of(g.console)))) && (ad[32] & 1) == 1;
    return match ok {
        None => json_reply(403, "{\"error\":\"this passkey is not approved for the console\"}"),
        Some(k) => if (!fresh || !shape || !bytes_eq(k.cred_id, cid) || !bytes_eq(k.org_id, cose_hex_decode(org))) { json_reply(403, "{\"error\":\"the assertion is not for this console or challenge\"}") } else {
            if (!ecdsa_verify_raw(P256, Sha256, k.public_key, ad.concat(sha256_bytes(cdj)), sig)) { json_reply(403, "{\"error\":\"the signature does not verify\"}") } else { con_open(root, org, k.log_id) } }
    };
}

@requires(filesystem, network, clock(readonly), declassify)
HttpReply con_open(Store root, Str org, List(Int) l) {
    Option(OrgState) ost = relay_org(root, org);
    Bool admin = match ost { None => false, Some(st) => is_admin(st.gov, l) && member_index(st.org.members, l, 0) >= 0 };
    if (!admin || suspended(root, l)) { return json_reply(403, "{\"error\":\"not an owner or administrator\"}"); }
    Str t = hex_encode(random_bytes(32));
    if (!st_text(root, "auth/con-" + hex_encode(sha256_bytes(utf8(t))), org + " " + hex_encode(l) + f" {clock_now_seconds() + 28800}")) { return json_reply(500, "{}"); }
    return http_with_header(json_reply(200, "{\"ok\":true}"), "Set-Cookie", "symcon=" + t + "; Path=/console/; HttpOnly; Secure; SameSite=Strict; Max-Age=28800");
}

@requires(filesystem, network, clock(readonly), declassify)
HttpReply con_state(Store root, Str org, List(Str) sess) {
    if (sess.len() != 2 || sess[0] != org) { return json_reply(401, "{\"error\":\"sign in\"}"); }
    Option(OrgState) ost = relay_org(root, org);
    return match ost {
        None => json_reply(404, "{}"),
        Some(st) => json_reply(200, "{\"name\":" + jq(st.gov.name) + f",\"version\":{st.org.version},\"gov\":{st.gov.version}" + ",\"you\":" + jq(sess[1])
            + f",\"policy\":{{\"min_pin_len\":{st.gov.policy.min_pin_len},\"max_offline_days\":{st.gov.policy.max_offline_days}" + ",\"allow_offline_copy\":" + (if (st.gov.policy.allow_offline_copy) { "true" } else { "false" })
            + ",\"allow_duress\":" + (if (st.gov.policy.allow_duress) { "true" } else { "false" }) + ",\"password_rules\":" + jq(st.gov.policy.password_rules) + "}"
            + ",\"recovery\":" + (if (st.gov.recovery.on) { f"{{\"threshold\":{st.gov.recovery.threshold},\"of\":{st.gov.recovery.admins.len()},\"delay\":{st.gov.recovery.delay_sec}}}" } else { "null" })
            + ",\"members\":[" + str_join(member_json(st, 0, ListBuf()), ",") + "],\"groups\":[" + str_join(group_json_list(st.org.groups, 0, ListBuf()), ",") + "]"
            + ",\"changes\":[" + str_join(change_json(root, st_list(root, "console/" + org + "/change-", "", 4096), 0, ListBuf()), ",") + "]}")
    };
}

List(Str) member_json(OrgState st, Int i, ListBuf(Str) acc) {
    if (i >= st.org.members.len()) { return acc.finish(); }
    OrgMember m = st.org.members[i];
    Str role = if (is_owner(st.gov, m.log_id)) { "owner" } else { if (is_admin(st.gov, m.log_id)) { "admin" } else { "member" } };
    return member_json(st, i + 1, acc.push("{\"log\":" + jq(hex_encode(m.log_id)) + ",\"name\":" + jq(m.label) + ",\"ext\":" + jq(m.ext_id) + ",\"role\":" + jq(role) + "}"));
}

List(Str) group_json_list(List(OrgGroup) gs, Int i, ListBuf(Str) acc) {
    if (i >= gs.len()) { return acc.finish(); }
    return group_json_list(gs, i + 1, acc.push("{\"id\":" + jq(hex_encode(gs[i].group_id)) + ",\"name\":" + jq(gs[i].name) + f",\"people\":{gs[i].members.len()}}}"));
}

// A queued change: "ID KIND A-HEX B-HEX C-HEX BY STATUS RESULT-HEX".
@requires(filesystem, network, clock(readonly), declassify)
List(Str) change_lines(Store root, List(Str) keys, Int i, ListBuf(Str) acc) {
    if (i >= keys.len()) { return acc.finish(); }
    Str t = str_trim(st_read_text(root, keys[i]));
    return change_lines(root, keys, i + 1, if (str_len(t) > 0) { acc.push(t) } else { acc });
}

@requires(filesystem, network, clock(readonly), declassify)
List(Str) change_json(Store root, List(Str) keys, Int i, ListBuf(Str) acc) {
    if (i >= keys.len()) { return acc.finish(); }
    List(Str) p = str_split(str_trim(st_read_text(root, keys[i])), " ");
    Bool ok = p.len() == 8;
    return change_json(root, keys, i + 1, if (ok) { acc.push("{\"id\":" + jq(p[0]) + ",\"kind\":" + jq(p[1]) + ",\"a\":" + jq(unhex_text(p[2])) + ",\"b\":" + jq(unhex_text(p[3]))
        + ",\"c\":" + jq(unhex_text(p[4])) + ",\"status\":" + jq(p[6]) + ",\"result\":" + jq(unhex_text(p[7])) + "}") } else { acc });
}

Str hexd(Str s) { return if (str_len(s) == 0) { "-" } else { hex_encode(utf8(s)) }; }
Str unhex_text(Str s) { List(Int) b = if (s == "-") { [] } else { cose_hex_decode(s) }; return http_text(b, 0, b.len()); }

Bool change_kind_ok(Str k) { return k == "invite" || k == "group-add" || k == "group-remove" || k == "remove" || k == "policy" || k == "sync"; }

@requires(filesystem, network, clock(readonly), declassify)
HttpReply con_change(Store root, Str org, List(Str) sess, HttpRequest r) {
    if (sess.len() != 2 || sess[0] != org) { return json_reply(401, "{\"error\":\"sign in\"}"); }
    Jv v = json_parse(r.body) else { JNull };
    Str kind = jstr(jget(v, "kind"));
    Str a = jstr(jget(v, "a"));
    Str b = jstr(jget(v, "b"));
    Str c = jstr(jget(v, "c"));
    if (!change_kind_ok(kind) || str_len(a) > 256 || str_len(b) > 256 || str_len(c) > 1024) { return json_reply(400, "{\"error\":\"invite, group-add, group-remove, remove, policy or sync\"}"); }
    Str id = hex_encode(random_bytes(16));
    Bool ok = st_text(root, "console/" + org + "/change-" + id, id + " " + kind + " " + hexd(a) + " " + hexd(b) + " " + hexd(c) + " " + sess[1] + " pending -");
    return if (ok) { json_reply(200, "{\"id\":" + jq(id) + "}") } else { json_reply(500, "{}") };
}

@requires(filesystem, network, clock(readonly), declassify)
HttpReply con_done(Store root, Str org, Str id, Who w, HttpRequest r) {
    Str k = "console/" + org + "/change-" + id;
    List(Str) p = str_split(str_trim(st_read_text(root, k)), " ");
    if (p.len() != 8 || p[6] != "pending") { return http_reply_status(404); }
    Str result = http_body_text(r);
    Str status = if (str_starts_with(result, "refused")) { "refused" } else { "done" };
    return if (st_text(root, k, str_join(p[0..6], " ") + " " + status + " " + hexd(result) + " ")) { http_reply_status(200) } else { http_reply_status(500) };
}

HttpReply console_page_html(Str org) {
    HttpReply rep = http_reply_text(200, "text/html; charset=utf-8", "<!doctype html><html><head><meta charset=utf-8><meta name=viewport content=\"width=device-width\"><title>Symbolon console</title>"
        + "<style>body{font:15px system-ui;margin:2em auto;max-width:60em;padding:0 1em}table{border-collapse:collapse;width:100%}td,th{border-bottom:1px solid #ddd;padding:.3em;text-align:left}"
        + "button{margin:.2em}input,select{margin:.2em}.note{color:#555}</style></head><body data-org=\"" + org + "\"><h1>Symbolon console</h1>"
        + "<div id=signin><p class=note>Owners and administrators sign in with a passkey their own device approved.</p><button id=login>Sign in with a passkey</button>"
        + "<button id=register>Register this device's passkey</button><p id=msg></p></div><div id=app hidden></div><script src=\"/console/app.js\"></script></body></html>");
    return http_with_header(http_with_header(rep, "Cache-Control", "no-store"), "Content-Security-Policy", "default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'");
}

// The console's script (no inline script: the page's policy allows only this file).
Str console_js() {
    return "const org = document.body.dataset.org, base = '/console/' + org;\n"
         + "const $ = id => document.getElementById(id);\n"
         + "const b64u = b => btoa(String.fromCharCode(...new Uint8Array(b))).replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');\n"
         + "const unb64u = s => Uint8Array.from(atob(s.replace(/-/g, '+').replace(/_/g, '/')), c => c.charCodeAt(0));\n"
         + "const esc = s => String(s).replace(/[&<>\"]/g, c => ({'&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;'}[c]));\n"
         + "async function api(path, body) {\n"
         + "  const r = await fetch(base + path, body ? {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(body)} : {});\n"
         + "  return {status: r.status, json: await r.json().catch(() => ({}))};\n"
         + "}\n"
         + "$('register').onclick = async () => {\n"
         + "  const c = await api('/challenge');\n"
         + "  const cred = await navigator.credentials.create({publicKey: {challenge: unb64u(c.json.challenge), rp: {id: c.json.rpId, name: 'Symbolon console'},\n"
         + "    user: {id: crypto.getRandomValues(new Uint8Array(16)), name: 'console', displayName: 'Symbolon console'}, pubKeyCredParams: [{type: 'public-key', alg: -7}]}});\n"
         + "  const r = await api('/register', {credentialId: b64u(cred.rawId), publicKey: b64u(cred.response.getPublicKey())});\n"
         + "  $('msg').textContent = r.json.code ? 'On your device: symbolon device org console-key DIR ' + r.json.code + ' (or approve it in the app), then sign in.' : (r.json.error || 'refused');\n"
         + "};\n"
         + "$('login').onclick = async () => {\n"
         + "  const c = await api('/challenge');\n"
         + "  const a = await navigator.credentials.get({publicKey: {challenge: unb64u(c.json.challenge), rpId: c.json.rpId, userVerification: 'preferred'}});\n"
         + "  const r = await api('/login', {credentialId: b64u(a.rawId), authenticatorData: b64u(a.response.authenticatorData), clientDataJSON: b64u(a.response.clientDataJSON), signature: b64u(a.response.signature)});\n"
         + "  if (r.status === 200) show(); else $('msg').textContent = r.json.error || 'refused';\n"
         + "};\n"
         + "async function show() {\n"
         + "  const r = await api('/state');\n"
         + "  if (r.status !== 200) return;\n"
         + "  const s = r.json;\n"
         + "  $('signin').hidden = true; $('app').hidden = false;\n"
         + "  $('app').innerHTML = '<h2>' + esc(s.name) + '</h2><p class=note>Membership version ' + s.version + ', governance ' + s.gov + '. Changes you queue here are signed on an owner\\'s or administrator\\'s own device.</p>'\n"
         + "    + '<h3>Policy</h3><p>PIN at least ' + s.policy.min_pin_len + '; offline copies ' + (s.policy.allow_offline_copy ? 'allowed' : 'not allowed') + '; offline days ' + (s.policy.max_offline_days || 'no limit') + '; password rules ' + esc(s.policy.password_rules || 'none') + '; recovery ' + (s.recovery ? s.recovery.threshold + ' of ' + s.recovery.of + ' after ' + s.recovery.delay + ' s' : 'off') + '</p>'\n"
         + "    + '<h3>People</h3><table><tr><th>Name</th><th>Directory id</th><th>Role</th></tr>' + s.members.map(m => '<tr><td>' + esc(m.name) + '</td><td>' + esc(m.ext) + '</td><td>' + m.role + '</td></tr>').join('') + '</table>'\n"
         + "    + '<h3>Groups</h3><table><tr><th>Name</th><th>People</th><th>Id</th></tr>' + s.groups.map(g => '<tr><td>' + esc(g.name) + '</td><td>' + g.people + '</td><td><code>' + g.id + '</code></td></tr>').join('') + '</table>'\n"
         + "    + '<h3>Queue a change</h3><select id=kind><option value=invite>Invite (directory id, name, group ids)</option><option value=group-add>Add to group (group id, log id)</option><option value=group-remove>Remove from group (group id, log id)</option><option value=remove>Remove person (log id)</option><option value=policy>Policy (key, value)</option><option value=sync>Sync</option></select>'\n"
         + "    + '<input id=a placeholder=first><input id=b placeholder=second><input id=c placeholder=third><button id=queue>Queue</button>'\n"
         + "    + '<h3>Changes</h3><table><tr><th>Change</th><th>Status</th><th>Result</th></tr>' + s.changes.map(c => '<tr><td>' + esc(c.kind + ' ' + c.a + ' ' + c.b + ' ' + c.c) + '</td><td>' + c.status + '</td><td>' + esc(c.result) + '</td></tr>').join('') + '</table>';\n"
         + "  $('queue').onclick = async () => { await api('/change', {kind: $('kind').value, a: $('a').value, b: $('b').value, c: $('c').value}); show(); };\n"
         + "}\n"
         + "show();\n"
         + "\n";
}
