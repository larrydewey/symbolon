@needs(Decoder(F))
Result(Parsed(CosignerConfig, F), SerialError) derive_cosigner_config_fields(F s, Option(Str) f_relay_host, Option(Int) f_relay_port, Option(Str) f_ca, Option(List(Int)) f_party, Option(List(Int)) f_dk_pub, Option(List(Int)) f_hpke_pub, Option(List(Int)) f_log_id, Option(Int) f_mbox_next, Option(List(PartyKeys)) f_peers, Option(Bool) f_accept_inception) {
    Parsed(FieldKey, F) k = read_field(s, derive_cosigner_config_names())?;
    FieldKey key = k.value;
    return match key {
        KnownField(i) => derive_cosigner_config_field(k.rest, i, f_relay_host, f_relay_port, f_ca, f_party, f_dk_pub, f_hpke_pub, f_log_id, f_mbox_next, f_peers, f_accept_inception),
        UnknownField(name) => derive_cosigner_config_fields(skip_unknown(k.rest, name, derive_cosigner_config_names(), false)?, f_relay_host, f_relay_port, f_ca, f_party, f_dk_pub, f_hpke_pub, f_log_id, f_mbox_next, f_peers, f_accept_inception),
        EndOfFields => derive_cosigner_config_done(k.rest, f_relay_host, f_relay_port, f_ca, f_party, f_dk_pub, f_hpke_pub, f_log_id, f_mbox_next, f_peers, f_accept_inception)
    };
}
