    if (i == 1) { Parsed(Option(Int), F) p = read_slot(s, f_relay_port, "relay_port")?; return derive_cosigner_config_fields(p.rest, f_relay_host, p.value, f_ca, f_party, f_dk_pub, f_hpke_pub, f_log_id, f_mbox_next, f_peers, f_accept_inception); }
