    if (i == 6) { Parsed(Option(List(Int)), F) p = read_slot(s, f_log_id, "log_id")?; return derive_cosigner_config_fields(p.rest, f_relay_host, f_relay_port, f_ca, f_party, f_dk_pub, f_hpke_pub, p.value, f_mbox_next, f_peers, f_accept_inception); }
    if (i == 7) { Parsed(Option(Int), F) p = read_slot(s, f_mbox_next, "mbox_next")?; return derive_cosigner_config_fields(p.rest, f_relay_host, f_relay_port, f_ca, f_party, f_dk_pub, f_hpke_pub, f_log_id, p.value, f_peers, f_accept_inception); }
    if (i == 8) { Parsed(Option(List(PartyKeys)), F) p = read_slot(s, f_peers, "peers")?; return derive_cosigner_config_fields(p.rest, f_relay_host, f_relay_port, f_ca, f_party, f_dk_pub, f_hpke_pub, f_log_id, f_mbox_next, p.value, f_accept_inception); }
    Parsed(Option(Bool), F) p = read_slot(s, f_accept_inception, "accept_inception")?; return derive_cosigner_config_fields(p.rest, f_relay_host, f_relay_port, f_ca, f_party, f_dk_pub, f_hpke_pub, f_log_id, f_mbox_next, f_peers, p.value);
