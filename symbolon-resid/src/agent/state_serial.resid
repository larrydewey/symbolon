Result(Parsed(CosignerConfig, F), SerialError) derive_cosigner_config_done(F s, Option(Str) f_relay_host, Option(Int) f_relay_port, Option(Str) f_ca, Option(List(Int)) f_party, Option(List(Int)) f_dk_pub, Option(List(Int)) f_hpke_pub, Option(List(Int)) f_log_id, Option(Int) f_mbox_next, Option(List(PartyKeys)) f_peers, Option(Bool) f_accept_inception) {
    Str d_relay_host = require(f_relay_host, "relay_host")?;
    Int d_relay_port = require(f_relay_port, "relay_port")?;
    Str d_ca = require(f_ca, "ca")?;
    List(Int) d_party = require(f_party, "party")?;
    List(Int) d_dk_pub = require(f_dk_pub, "dk_pub")?;
    List(Int) d_hpke_pub = require(f_hpke_pub, "hpke_pub")?;
    List(Int) d_log_id = require(f_log_id, "log_id")?;
    Int d_mbox_next = require(f_mbox_next, "mbox_next")?;
    List(PartyKeys) d_peers = require(f_peers, "peers")?;
    Bool d_accept_inception = require(f_accept_inception, "accept_inception")?;
    return parsed(CosignerConfig {.relay_host = d_relay_host, .relay_port = d_relay_port, .ca = d_ca, .party = d_party, .dk_pub = d_dk_pub, .hpke_pub = d_hpke_pub, .log_id = d_log_id, .mbox_next = d_mbox_next, .peers = d_peers, .accept_inception = d_accept_inception}, s);
}
Decode(CosignerConfig, F) = derive_cosigner_config_decode;
