// symbolon: the Linux command-line agent and its services.
//
//   symbolon relay serve DIR PORT [--tls CERT KEY] [--bind ADDR] [--ca FILE] [--store SPEC] [--store-ca FILE]
//       the sync service (SPEC 20.1, 29.4, 29.9); --console-origin https://HOST:PORT serves the console (29.10); --store: a directory (DIR by default),
//       postgres://USER:PASSWORD@HOST:PORT/DB, s3://KEY:SECRET@HOST:PORT/BUCKET?region=R, or @FILE holding one
//   symbolon witness keygen KEYFILE            a witness's signing key; prints its public key
//   symbolon relay scim-token DIR ORG-ID          a bearer token for ORG-ID's SCIM directory (SPEC 29.7)
//   symbolon witness serve DIR PORT KEYFILE [OFFSET] [--tls CERT KEY] [--bind ADDR]
//                                              a witness (SPEC 20.3); OFFSET seconds added to its
//                                              clock (tests: time passing)
//       --tls: serve HTTPS with the PEM certificate chain CERT and private key KEY;
//       --bind: the address to listen on (default 127.0.0.1)
//   symbolon cosigner new DIR RELAY_HOST RELAY_PORT [--ca CA.pem]   prints the cosigner's keys
//   symbolon cosigner pair DIR DEVICE_KEYS              pins the device that runs the inception
//   symbolon cosigner serve DIR [PRIMES]
//   symbolon device new DIR RELAY_HOST RELAY_PORT [--unprotected] [--fast-kdf] [--ca CA.pem]
//       --ca: speak TLS to the relay and the witnesses, trusting the PEM anchor CA.pem
//                                              PIN and duress PIN on stdin; prints the device's keys
//   symbolon device init DIR COSIGNER_KEYS W1 W2 W3 [DEVICE_PRIMES KIT_PRIMES]
//                                              W as host:port:keyhex; PIN on stdin
//   symbolon device register DIR RP [--duress] PIN on stdin; prints a credential ID and public key;
//                                              --duress puts it in the duress subset
//   symbolon device sign DIR RP CID MESSAGE    PIN on stdin; prints r || s
//   symbolon device status DIR
//   symbolon device forget DIR
//   symbolon device vault login DIR NAME ORIGIN USERNAME     (PIN, password on stdin)
//   symbolon device rotate DIR NAME BUNDLE REPOSITORY [CHROMIUM] [--share ID]   (PIN on stdin)
//   symbolon device vault put DIR NAME         PIN then the secret on stdin
//   symbolon device vault get DIR NAME         PIN on stdin; prints the secret
//   symbolon device vault list DIR [--kinds|--long]  PIN on stdin; prints the names (--kinds: TYPE NAME;
//                                              --long: TYPE NAME-HEX DETAIL-HEX FOLDER-HEX); offline, this device's copy
//   symbolon device vault show DIR NAME        PIN on stdin; prints "FIELD VALUE-HEX" per field
//   symbolon device vault set DIR NAME TYPE    PIN, then "FIELD VALUE-HEX" lines, on stdin (card, identity,
//                                              note, bank, wifi, secret, login)
//   symbolon device vault delete DIR NAME      PIN on stdin
//   symbolon device vault import DIR FILE [--format auto|bitwarden-json|csv] [--dry-run]
//                                              PIN on stdin (not with --dry-run): another password
//                                              manager's export, as one new vault version
//   symbolon device vault move DIR NAME TO     PIN on stdin; to the own vault (TO "own") or the shared folder TO
//       list, show, set, delete, import and move take a last `--share ID`: in (from) that shared folder
//   symbolon device share new DIR NAME         PIN on stdin; a shared folder (SPEC 19); prints its ID
//   symbolon device share list DIR             PIN on stdin; "ID NAME-HEX owner|member PEOPLE" per folder
//                                              ("ID - waiting WHY-HEX": no key for this device yet)
//   symbolon device share members DIR ID       PIN on stdin; "LOG-ID NAME-HEX FINGERPRINT owner|member"
//   symbolon device share add DIR ID LOG-ID NAME   PIN on stdin; the owner adds a person
//   symbolon device share remove DIR ID LOG-ID PIN on stdin; the owner removes a person (new key)
//   symbolon device share delete DIR ID        PIN on stdin; the owner deletes the folder
//   symbolon device share leave DIR ID         PIN on stdin; a member leaves (the owner's device then re-keys)
//   symbolon device share duress DIR ID on|off PIN on stdin; read the folder under the duress PIN on this device
//   symbolon device share card DIR NAME        PIN on stdin; the name others see; prints LOG-ID FINGERPRINT
//   symbolon device org new|join|show|members|add|remove|role|policy|group|groups|folder|sync|audit ...
//                                              organizations (SPEC 29); see src/agent/orgcli.resid
//   symbolon device share me DIR               prints LOG-ID FINGERPRINT
//   symbolon device share people DIR           "LOG-ID NAME-HEX FINGERPRINT me|-" per card at the relay
//   symbolon ssh-agent DIR [SOCKET]            the SSH agent (SPEC 16.1) on a Unix socket
//   symbolon device ssh new|import|list|sign|delete ...   SSH keys in the vault (src/agent/sshcli.resid)
//   symbolon device link-new DIR [--host H,...] [...]   a new device: shows a code (QR) for an existing one (SPEC 11.5)
//   symbolon device link-add DIR LINK          adds the device whose code was scanned
//   symbolon device key add|list|remove DIR [NAME]   security keys as a second factor (SPEC 9.4)
//   symbolon browser host [ORIGIN...]          the browser extension's native messaging host (SPEC 22.5);
//                                              SYMBOLON_CONSENT is the consent window (the app)
//   symbolon home init DIR HOST [HOST...] [--ports BASE] [--bind ADDR]   Symbolon Home: the box's CA, certificates, witnesses
//   symbolon home invite DIR NAME              a cosigner for NAME; prints the pairing link (QR)
//   symbolon device pin DIR                    PIN and the new PIN on stdin; changes the PIN
//   symbolon home serve DIR                    pairing, relay, three witnesses and every cosigner
//   symbolon device webauthn register DIR RP_ID [--uv] [--duress]          PIN on stdin; adds authenticator-data
//                                              and attestation-object (fmt none) to what register prints
//   symbolon device webauthn assert DIR RP_ID CREDENTIAL_ID CDH [--uv]   PIN on stdin; authenticator-data,
//                                              signature-der, then r || s
//   symbolon device enroll DIR NEW_KEYS [PRIMES]   PIN on stdin; adds the device NEW_KEYS (re-share)
//   symbolon device join DIR ENROLLER_KEYS [PRIMES] PIN on stdin; joins when that device enrolls this one
//   symbolon device recover DIR KIT_SEED LOG_ID    a new device starts a kit recovery (SPEC 13.2)
//   symbolon device veto DIR                   PIN on stdin; vetoes the latest pending event
//   symbolon device recover-release DIR        PIN on stdin; asks the cosigner for its kit half
//   symbolon device recover-finish DIR KIT_SEED [PRIMES]  PIN on stdin; after the delay: release, re-share
//
// Services listen on 127.0.0.1 only; put a TLS terminator in front of them
// for anything else (SPEC 20.2: envelopes are end to end, objects signed).

import "net/services.resid";
import "net/store.resid";
import "agent/state.resid";
import "agent/device.resid";
import "agent/cosignerd.resid";
import "agent/vaultcli.resid";
import "agent/enroll.resid";
import "agent/recover.resid";
import "agent/rotatecli.resid";
import "agent/vaultitems.resid";
import "agent/importers.resid";
import "agent/sharecli.resid";
import "browser/nmhost.resid";
import "agent/sshcli.resid";
import "ssh/agentd.resid";
import "agent/keycli.resid";
import "agent/link.resid";
import "agent/orgcli.resid";
import "agent/orgconsole.resid";
import "agent/relaysrv.resid";
import "agent/scim.resid";
import "agent/webauthn.resid";
import "agent/home.resid";
import "httpserv.resid";
import "ecdsa.resid";
import "crypto.resid";
import "cose.resid";
import "wire.resid";
import "tlswire.resid";
import "tlskey.resid";

Int usage() {
    eprintln("usage: symbolon relay|witness|cosigner|device ... (see the header of src/main.resid)");
    return 2;
}

// The TLS configuration from --tls CERT KEY; None when not asked for. A
// server asked for TLS whose files do not load refuses to start.
pub type Tls = { Bool on; Bool ok; TlsCfg cfg; };

@requires(filesystem, declassify, provision)
Tls tls_from(Str cert, Str key) {
    if (str_len(cert) == 0) { return Tls {.on = false, .ok = true, .cfg = tls_cfg_none()}; }
    Option(ServerKey) k = tls_key_load(key);
    List(List(Int)) chain = tls_chain_load(cert);
    return match k {
        None => Tls {.on = true, .ok = false, .cfg = tls_cfg_none()},
        Some(x) => Tls {.on = true, .ok = chain.len() > 0 && tls_key_cert_matches(x, chain[0]), .cfg = tls_cfg(x, chain, ["http/1.1"])}
    };
}

TlsCfg tls_cfg_none() {
    List(Secret(UInt(8))) none = [];
    return tls_cfg(EdKey(none), [], []);
}

// A server listens once and answers in child processes, batch_conns()
// connections each, on the listening socket they inherit (opened without
// close-on-exec): there is no collector, and an accept loop that ran
// forever kept its per-connection state (gigabytes within minutes under
// TLS), regions included. Connections that arrive between two children
// wait in the listen backlog. `self` is this program's path; paths may not
// contain spaces (the child's command is split on them; no shell runs).
Int batch_conns() { return 100; }

Str tls_args(Str cert, Str key) { return if (str_len(cert) == 0) { "" } else { " --tls " + cert + " " + key }; }

@requires(process)
Int supervise_children(Str cmd) {
    Int rc = process.run(cmd);
    if (rc != 0) { eprintln(f"server: a child exited with {rc}; stopping"); return 1; }
    return supervise_children(cmd);
}

// --store SPEC (net/store.resid): a directory, postgres://... or s3://...;
// "@FILE" reads it from FILE, so a password is not on a command line.
// --store-ca FILE: the trust anchor for an S3 store over HTTPS.
@requires(filesystem)
Option(StoreCfg) store_of(Str dir, Str spec, Str store_ca) {
    Str sp = if (str_starts_with(spec, "@")) { str_trim(filesystem.read_all(str_slice(spec, 1, str_len(spec)))) } else { spec };
    return store_cfg(sp, dir, if (str_len(store_ca) == 0) { "" } else { filesystem.read_all(store_ca) });
}

Str opt(Str flag, Str v) { return if (str_len(v) == 0) { "" } else { " " + flag + " " + v }; }

@requires(network, filesystem, declassify, provision, process, clock(readonly))
Int relay_serve(Str dir, Int port, Str bind, Str cert, Str key, Str ca, Str spec, Str store_ca, Str console, Str self) {
    Tls t = tls_from(cert, key);
    if (!t.ok) { eprintln("relay: the TLS certificate or key does not load, or they do not match"); return 1; }
    _ = filesystem.create_dir(dir);
    Option(StoreCfg) sc = store_of(dir, spec, store_ca);
    if (match sc { None => true, Some(_) => false }) { eprintln("relay: --store is a directory, postgres://USER:PASSWORD@HOST:PORT/DB or s3://KEY:SECRET@HOST:PORT/BUCKET"); return 2; }
    Str why = store_prepare(sc else { Fs(dir) });
    if (str_len(why) > 0) { eprintln("relay: the store is not ready: " + why); return 1; }
    Int lfd = http_listen_at(bind, port);
    if (lfd < 0) { eprintln(f"relay: cannot listen on {port}"); return 1; }
    println(f"relay listening on {bind}:{http_bound_port(lfd)}" + if (t.on) { " (TLS)" } else { "" });
    return supervise_children(self + " relay child " + dir + f" {lfd}" + tls_args(cert, key) + opt("--ca", ca) + opt("--store", spec) + opt("--store-ca", store_ca) + opt("--console-origin", console));
}

// `symbolon relay child DIR FD [--tls CERT KEY] [--ca FILE] [--store SPEC] [--store-ca FILE]`
// (run by `relay serve`). --ca: the trust anchor for the witnesses the
// relay asks the time of when it verifies a device signing in (SPEC 29.4).
@requires(network, filesystem, declassify, provision, clock(readonly))
Int relay_child(Str dir, Int lfd, Str cert, Str key, Str ca, Str spec, Str store_ca, Str console) {
    Tls t = tls_from(cert, key);
    if (!t.ok) { return 2; }
    Option(StoreCfg) sc = store_of(dir, spec, store_ca);
    if (match sc { None => true, Some(_) => false }) { return 2; }
    RelayCfg g = RelayCfg {.store = sc else { Fs(dir) }, .ca = if (str_len(ca) == 0) { "" } else { filesystem.read_all(ca) }, .console = console};
    Int n = if (t.on) { tls_accept_loop(lfd, t.cfg, lambda(q) { relay_serve_handle(g, q) }, http_limits(), batch_conns()) }
            else { http_accept_loop(lfd, lambda(q) { relay_serve_handle(g, q) }, http_limits(), batch_conns()) };
    return if (n > 0) { 0 } else { 3 };
}

@requires(network, filesystem, declassify, clock(readonly))
Int relay_scim_token(Str dir, Str org, Str spec, Str store_ca) {
    Option(StoreCfg) sc = store_of(dir, spec, store_ca);
    if (match sc { None => true, Some(_) => false }) { eprintln("relay: bad --store"); return 2; }
    Store st = store_open(sc else { Fs(dir) });
    Int rc = if (store_ok(st)) { scim_token(st, org) } else { 1 };
    _ = store_close(st);
    return rc;
}

@requires(filesystem)
Int witness_keygen(Str keyfile) {
    List(Int) priv = ec_generate(P256);
    if (priv.len() != 32 || !filesystem.write_secret(keyfile, priv)) { eprintln("witness: cannot write the key"); return 1; }
    println(hex_encode(ec_public_key(P256, priv)));
    return 0;
}

@requires(network, filesystem, clock(readonly), declassify, provision, process)
Int witness_serve(Str dir, Int port, Str keyfile, Int offset, Str bind, Str cert, Str key, Str self) {
    Tls t = tls_from(cert, key);
    if (!t.ok) { eprintln("witness: the TLS certificate or key does not load, or they do not match"); return 1; }
    List(Int) raw = filesystem.read_bytes(keyfile);
    if (raw.len() != 32) { eprintln("witness: no key"); return 1; }
    List(Secret(UInt(8))) priv = provisioned_key(secret_bytes(raw), "the witness key from its key file (witness keygen)");
    _ = filesystem.create_dir(dir);
    Int lfd = http_listen_at(bind, port);
    if (lfd < 0) { eprintln(f"witness: cannot listen on {port}"); return 1; }
    println(f"witness listening on {bind}:{http_bound_port(lfd)} key {hex_encode(ec_public_keyg(P256, priv))}" + if (t.on) { " (TLS)" } else { "" });
    return supervise_children(self + " witness child " + dir + f" {lfd} " + keyfile + f" {offset}" + tls_args(cert, key));
}

// `symbolon witness child DIR FD KEYFILE OFFSET [--tls CERT KEY]` (run by `witness serve`).
@requires(network, filesystem, clock(readonly), declassify, provision)
Int witness_child(Str dir, Int lfd, Str keyfile, Int offset, Str cert, Str key) {
    Tls t = tls_from(cert, key);
    List(Int) raw = filesystem.read_bytes(keyfile);
    if (!t.ok || raw.len() != 32) { return 2; }
    List(Secret(UInt(8))) priv = provisioned_key(secret_bytes(raw), "the witness key from its key file (witness keygen)");
    Int n = if (t.on) { tls_accept_loop(lfd, t.cfg, lambda(q) { witness_handle(dir, priv, offset, q) }, http_limits(), batch_conns()) }
            else { http_accept_loop(lfd, lambda(q) { witness_handle(dir, priv, offset, q) }, http_limits(), batch_conns()) };
    return if (n > 0) { 0 } else { 3 };
}

Option(WitnessEp) witness_arg(Str s) {
    List(Str) p = str_split(s, ":");
    if (p.len() != 3) { return None; }
    List(Int) k = cose_hex_decode(p[2]);
    return if (k.len() == 65) { Some(WitnessEp {.host = p[0], .port = str_parse_int(p[1]), .key = k}) } else { None };
}

List(WitnessEp) witness_args(List(Str) ss, Int i, List(WitnessEp) acc) {
    if (i >= ss.len()) { return acc; }
    return witness_args(ss, i + 1, match witness_arg(ss[i]) { Some(w) => acc.concat([w]), None => acc });
}

// The argument after flag `f`, or "" (`k` = 1, 2: the first or second).
@requires(args)
Str flag_arg(Str f, Int k, Int i) {
    if (i + k >= args.count()) { return ""; }
    if (args.get(i) == f) { return args.get(i + k); }
    return flag_arg(f, k, i + 1);
}

// The number of arguments before the first flag.
@requires(args)
Int positional(Int i) {
    if (i >= args.count()) { return i; }
    if (str_len(args.get(i)) > 2 && str_slice(args.get(i), 0, 2) == "--") { return i; }
    return positional(i + 1);
}

// The PEM text of --ca FILE, or "".
@requires(args, filesystem)
Str ca_text() {
    Str f = flag_arg("--ca", 1, 3);
    return if (str_len(f) == 0) { "" } else { filesystem.read_all(f) };
}

// Arguments i..e-1.
@requires(args)
List(Str) arg_list(Int i, Int e, ListBuf(Str) acc) {
    if (i >= e) { return acc.finish(); }
    return arg_list(i + 1, e, acc.push(args.get(i)));
}

Str bind_or_all(Str b) { return if (str_len(b) == 0) { "0.0.0.0" } else { b }; }

Str bind_or(Str b) { return if (str_len(b) == 0) { "127.0.0.1" } else { b }; }

@requires(args)
Bool has_flag(Str f, Int i) {
    if (i >= args.count()) { return false; }
    if (args.get(i) == f) { return true; }
    return has_flag(f, i + 1);
}

// `symbolon device org ...` (src/agent/orgcli.resid).
@requires(filesystem, network, device, declassify, clock, provision, environment, args)
Int org_command(Int n) {
    Str c = args.get(3);
    Str d = args.get(4);
    if (c == "new" && n == 6) { return org_new(d, args.get(5)); }
    if (c == "join" && (n == 7 || n == 8)) { return org_join(d, args.get(5), args.get(6), if (n == 8) { args.get(7) } else { "" }); }
    if (c == "invite" && (n == 7 || n == 8)) { return org_invite(d, args.get(5), args.get(6), if (n == 8) { args.get(7) } else { "" }); }
    if (c == "show" && n == 5) { return org_show(d); }
    if (c == "members" && n == 5) { return org_members(d); }
    if (c == "groups" && n == 5) { return org_groups(d); }
    if (c == "add" && (n == 7 || n == 8)) { return org_add(d, args.get(5), args.get(6), if (n == 8) { args.get(7) } else { "" }); }
    if (c == "remove" && n == 6) { return org_remove(d, args.get(5)); }
    if (c == "role" && n == 7) { return org_role(d, args.get(5), args.get(6)); }
    if (c == "policy" && n == 7) { return org_policy(d, args.get(5), args.get(6)); }
    if (c == "sync" && n == 5) { return org_sync(d); }
    // `org recovery on DIR K DELAY ADMINS`, `org recovery off DIR`, `org escrow DIR CID`, `org recover request|approve|open DIR CID`
    if (c == "recovery" && d == "on" && (n == 9 || (n == 10 && args.get(9) == "--short-delay"))) { return org_recovery(args.get(5), "on", args.get(6), args.get(7), args.get(8), n == 10); }
    if (c == "recovery" && d == "off" && n == 6) { return org_recovery(args.get(5), "off", "", "", "", false); }
    if (c == "escrow" && n == 6) { return org_escrow(d, args.get(5)); }
    if (c == "recover" && n == 7) { return org_recover(args.get(5), d, args.get(6)); }
    if (c == "audit" && n == 5) { return org_audit(d); }
    if (c == "attest" && n >= 5 && n <= 7) { return org_attest(d, if (n >= 6) { args.get(5) } else { "" }, if (n == 7) { args.get(6) } else { "" }); }
    if (c == "console" && n == 6) { return org_console(d, str_parse_int(args.get(5))); }
    if (c == "console-key" && n == 6) { return org_console_key(d, args.get(5)); }
    if (c == "changes" && n == 5) { return org_changes(d); }
    if (c == "approve" && n == 6) { return org_approve(d, args.get(5)); }
    if (c == "export" && positional(3) == 5) { return org_export(d, flag_arg("--https", 1, 5), flag_arg("--token", 1, 5), flag_arg("--syslog", 1, 5), flag_arg("--ca", 1, 5)); }
    // `org group new DIR NAME`, `org group add|remove DIR GROUP LOG`, `org folder new DIR NAME GROUPS`
    if (c == "group" && d == "new" && n == 7) { return org_group_new(args.get(5), args.get(6)); }
    if (c == "group" && (d == "add" || d == "remove") && n == 8) { return org_group_set(args.get(5), args.get(6), args.get(7), d == "add"); }
    if (c == "folder" && d == "new" && n == 8) { return org_folder_new(args.get(5), args.get(6), args.get(7)); }
    eprintln("device org: unknown form (see src/agent/orgcli.resid)");
    return 2;
}

@requires(args, environment, network, filesystem, device, declassify, clock, process, provision)
Int main() {
    Str a1 = args.get(1);
    Str a2 = args.get(2);
    Int n = args.count();
    if (a1 == "home" && a2 == "init" && n >= 5) { Int hp = positional(4); return home_init(args.get(3), arg_list(4, hp, ListBuf()), if (str_len(flag_arg("--ports", 1, hp)) > 0) { str_parse_int(flag_arg("--ports", 1, hp)) } else { home_default_base() }, bind_or_all(flag_arg("--bind", 1, hp))); }
    if (a1 == "home" && a2 == "invite" && n == 5) { return home_invite(args.get(3), args.get(4)); }
    if (a1 == "device" && a2 == "pin" && n == 4) { return device_pin(args.get(3)); }
    // Started by the browser (native messaging); its own arguments follow.
    if (a1 == "ssh-agent" && (n == 3 || n == 4)) { return ssh_agent(args.get(2), if (n == 4) { args.get(3) } else { "" }); }
    if (a1 == "device" && a2 == "ssh" && args.get(3) == "new" && n == 6) { return ssh_new(args.get(4), args.get(5)); }
    if (a1 == "device" && a2 == "ssh" && args.get(3) == "import" && n == 7) { return ssh_import(args.get(4), args.get(5), args.get(6)); }
    if (a1 == "device" && a2 == "ssh" && args.get(3) == "list" && n == 5) { return ssh_list(args.get(4)); }
    if (a1 == "device" && a2 == "ssh" && args.get(3) == "sign" && (n == 6 || n == 7)) { return ssh_sign(args.get(4), args.get(5), if (n == 7) { args.get(6) } else { "" }); }
    if (a1 == "device" && a2 == "ssh" && args.get(3) == "delete" && n == 6) { return ssh_delete(args.get(4), args.get(5)); }
    if (a1 == "device" && a2 == "link-new" && n >= 4) { return link_new(args.get(3), flag_arg("--host", 1, 4), has_flag("--unprotected", 4), has_flag("--keystore", 4), has_flag("--fast-kdf", 4), flag_arg("--primes", 1, 4)); }
    if (a1 == "device" && a2 == "link-add" && n >= 5) { return link_add(args.get(3), args.get(4), flag_arg("--primes", 1, 5)); }
    if (a1 == "device" && a2 == "key" && args.get(3) == "add" && n == 6) { return key_add(args.get(4), args.get(5)); }
    if (a1 == "device" && a2 == "key" && args.get(3) == "list" && n == 5) { return key_list(args.get(4)); }
    if (a1 == "device" && a2 == "key" && args.get(3) == "remove" && n == 6) { return key_remove(args.get(4), args.get(5)); }
    if (a1 == "browser" && a2 == "host") { return browser_host([args.get(3), args.get(4)]); }
    if (a1 == "home" && a2 == "serve" && n == 4) { return home_serve(args.get(3), args.get(0)); }
    if (a1 == "home" && a2 == "pair-serve" && n == 4) { return home_pair_serve(args.get(3), args.get(0)); }
    if (a1 == "home" && a2 == "pair-child" && n == 5) { return home_pair_child(args.get(3), str_parse_int(args.get(4))); }
    if (a1 == "cosigner" && a2 == "new" && positional(3) == 6) { return cosignerd_new(args.get(3), args.get(4), str_parse_int(args.get(5)), ca_text()); }
    if (a1 == "cosigner" && a2 == "pair" && n == 5) { return cosignerd_pair(args.get(3), args.get(4)); }
