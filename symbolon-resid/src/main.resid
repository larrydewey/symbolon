import "tlskey.resid";
import "clock.resid";

Int usage() {
    eprintln("usage: symbolon relay|witness|cosigner|device ... (see the header of src/main.resid)");
    return 2;
}

// The TLS configuration from --tls CERT KEY; None when not asked for. A
// server asked for TLS whose files do not load refuses to start.
pub type Tls = { Bool on; Bool ok; TlsCfg cfg; };

@requires(filesystem, declassify, provision)
Tls tls_from(Str cert, Str key) {
    if (str_len(cert) == 0) { return Tls {.on = false, .ok = true, .cfg = tls_cfg_none()}; }
    Option(ServerKey) k = tls_key_load(key);
    List(List(Int)) chain = tls_chain_load(cert);
    return match k {
        None => Tls {.on = true, .ok = false, .cfg = tls_cfg_none()},
        Some(x) => Tls {.on = true, .ok = chain.len() > 0 && tls_key_cert_matches(x, chain[0]), .cfg = tls_cfg(x, chain, ["http/1.1"])}
    };
}

TlsCfg tls_cfg_none() {
    List(Secret(UInt(8))) none = [];
    return tls_cfg(EdKey(none), [], []);
}

// A server listens once and answers in child processes, batch_conns()
// connections each, on the listening socket they inherit: every runtime
// descriptor is close-on-exec, and process.run_with_fds keeps exactly the
// listening socket open in the child, at the same number. There is no collector, and an accept loop that ran
// forever kept its per-connection state (gigabytes within minutes under
// TLS), regions included. Connections that arrive between two children
// wait in the listen backlog. `self` is this program's path; paths may not
// contain spaces (the child's command is split on them; no shell runs).
Int batch_conns() { return 100; }

Str tls_args(Str cert, Str key) { return if (str_len(cert) == 0) { "" } else { " --tls " + cert + " " + key }; }

// A child that fails (a crash, a request that ran it out of memory) is
// replaced after a back-off that doubles from 100 ms to 10 s while
// children keep failing: one bad request no longer stops the server
// (R2W-1).
// `lfd` is the listening socket: the only descriptor the child inherits.
// The runtime refuses (-2) to pass a descriptor it does not own as a TCP or
// unix socket; that is a startup failure, not a child to restart.
@requires(process, clock)
Int supervise_children(Str cmd, Int lfd) { return supervise_from(cmd, lfd, 0); }

@requires(process, clock)
Int supervise_from(Str cmd, Int lfd, Int fails) {
    Int rc = process.run_with_fds(cmd, [lfd]);
    if (rc == -2) { eprintln(f"server: cannot pass the listening socket (fd {lfd}) to a child; not serving"); return 1; }
    if (rc == 0) { return supervise_from(cmd, lfd, 0); }
    Int wait = restart_delay_ms(fails);
    eprintln(f"server: a child exited with {rc}; another starts in {wait} ms");
    _ = clock_sleep_ms(wait);
    return supervise_from(cmd, lfd, fails + 1);
}

pub Int restart_delay_ms(Int fails) { return if (fails >= 7) { 10000 } else { 100 * pow2(fails) }; }

Int pow2(Int n) { return if (n <= 0) { 1 } else { 2 * pow2(n - 1) }; }

// --store SPEC (net/store.resid): a directory, postgres://... or s3://...;
// "@FILE" reads it from FILE, so a password is not on a command line.
// --store-ca FILE: the trust anchor for an S3 store over HTTPS.
@requires(filesystem)
Option(StoreCfg) store_of(Str dir, Str spec, Str store_ca) {
    Str sp = if (str_starts_with(spec, "@")) { str_trim(filesystem.read_all(str_slice(spec, 1, str_len(spec)))) } else { spec };
    return store_cfg(sp, dir, if (str_len(store_ca) == 0) { "" } else { filesystem.read_all(store_ca) });
}

Str opt(Str flag, Str v) { return if (str_len(v) == 0) { "" } else { " " + flag + " " + v }; }

@requires(network, filesystem, declassify, provision, process, clock)
Int relay_serve(Str dir, Int port, Str bind, Str cert, Str key, Str ca, Str spec, Str store_ca, Str console, Str names, Bool any_name, Bool private_witnesses, Str allowed, Str self) {
    Str unnamed = relay_names_problem(names, console, any_name);
    if (str_len(unnamed) > 0) { eprintln("relay: " + unnamed); return 2; }
    Tls t = tls_from(cert, key);
    if (!t.ok) { eprintln("relay: the TLS certificate or key does not load, or they do not match"); return 1; }
    _ = filesystem.create_dir(dir);
    Option(StoreCfg) sc = store_of(dir, spec, store_ca);
    if (match sc { None => true, Some(_) => false }) { eprintln("relay: --store is a directory, postgres://USER:PASSWORD@HOST:PORT/DB or s3://KEY:SECRET@HOST:PORT/BUCKET"); return 2; }
    Str why = store_prepare(sc else { Fs(dir) });
    if (str_len(why) > 0) { eprintln("relay: the store is not ready: " + why); return 1; }
    Int lfd = http_listen_at(bind, port);
    if (lfd < 0) { eprintln(f"relay: cannot listen on {port}"); return 1; }
    println(f"relay listening on {bind}:{http_bound_port(lfd)}" + if (t.on) { " (TLS)" } else { "" });
    if (any_name) { eprintln("relay: --insecure-any-name: a device's sign-in is not bound to this relay's name"); }
    return supervise_children(self + " relay child " + dir + f" {lfd}" + tls_args(cert, key) + opt("--ca", ca) + opt("--store", spec) + opt("--store-ca", store_ca) + opt("--console-origin", console) + opt("--name", names) + if (private_witnesses) { " --allow-private-witnesses" } else { "" } + opt("--allow-witness", allowed), lfd);
}

// `symbolon relay child DIR FD [--tls CERT KEY] [--ca FILE] [--store SPEC] [--store-ca FILE]`
// (run by `relay serve`). --ca: the trust anchor for the witnesses the
// relay asks the time of when it verifies a device signing in (SPEC 29.4).
@requires(network, filesystem, declassify, provision, clock(readonly))
Int relay_child(Str dir, Int lfd, Str cert, Str key, Str ca, Str spec, Str store_ca, Str console, Str names, Bool private_witnesses, Str allowed) {
    Tls t = tls_from(cert, key);
    if (!t.ok) { return 2; }
    Option(StoreCfg) sc = store_of(dir, spec, store_ca);
    if (match sc { None => true, Some(_) => false }) { return 2; }
    RelayCfg g = RelayCfg {.store = sc else { Fs(dir) }, .ca = if (str_len(ca) == 0) { "" } else { filesystem.read_all(ca) }, .console = console, .names = names, .private_witnesses = private_witnesses, .allowed_witnesses = str_to_lower(allowed)};
    Int n = if (t.on) { tls_accept_loop(lfd, t.cfg, lambda(q) { relay_serve_handle(g, q) }, http_limits(), batch_conns()) }
            else { http_accept_loop(lfd, lambda(q) { relay_serve_handle(g, q) }, http_limits(), batch_conns()) };
    return if (n > 0) { 0 } else { 3 };
}

@requires(network, filesystem, declassify, clock(readonly))
Int relay_scim_token(Str dir, Str org, Str spec, Str store_ca) {
    Option(StoreCfg) sc = store_of(dir, spec, store_ca);
    if (match sc { None => true, Some(_) => false }) { eprintln("relay: bad --store"); return 2; }
    Store st = store_open(sc else { Fs(dir) });
    Int rc = if (store_ok(st)) { scim_token(st, org) } else { 1 };
    _ = store_close(st);
    return rc;
}

@requires(filesystem)
Int witness_keygen(Str keyfile) {
    List(Int) priv = ec_generate(P256);
    if (priv.len() != 32 || !filesystem.write_secret(keyfile, priv)) { eprintln("witness: cannot write the key"); return 1; }
    println(hex_encode(ec_public_key(P256, priv)));
    return 0;
}

@requires(network, filesystem, clock, declassify, provision, process)
Int witness_serve(Str dir, Int port, Str keyfile, Int offset, Str bind, Str cert, Str key, Str self) {
    Tls t = tls_from(cert, key);
    if (!t.ok) { eprintln("witness: the TLS certificate or key does not load, or they do not match"); return 1; }
    List(Int) raw = filesystem.read_bytes(keyfile);
    if (raw.len() != 32) { eprintln("witness: no key"); return 1; }
    List(Secret(UInt(8))) priv = provisioned_key(secret_bytes(raw), "the witness key from its key file (witness keygen)");
    _ = filesystem.create_dir(dir);
    Int lfd = http_listen_at(bind, port);
    if (lfd < 0) { eprintln(f"witness: cannot listen on {port}"); return 1; }
    println(f"witness listening on {bind}:{http_bound_port(lfd)} key {hex_encode(ec_public_keyg(P256, priv))}" + if (t.on) { " (TLS)" } else { "" });
    return supervise_children(self + " witness child " + dir + f" {lfd} " + keyfile + f" {offset}" + tls_args(cert, key), lfd);
}

// `symbolon witness child DIR FD KEYFILE OFFSET [--tls CERT KEY]` (run by `witness serve`).
@requires(network, filesystem, clock(readonly), declassify, provision)
Int witness_child(Str dir, Int lfd, Str keyfile, Int offset, Str cert, Str key) {
    Tls t = tls_from(cert, key);
    List(Int) raw = filesystem.read_bytes(keyfile);
    if (!t.ok || raw.len() != 32) { return 2; }
    List(Secret(UInt(8))) priv = provisioned_key(secret_bytes(raw), "the witness key from its key file (witness keygen)");
    Int n = if (t.on) { tls_accept_loop(lfd, t.cfg, lambda(q) { witness_handle(dir, priv, offset, q) }, http_limits(), batch_conns()) }
            else { http_accept_loop(lfd, lambda(q) { witness_handle(dir, priv, offset, q) }, http_limits(), batch_conns()) };
    return if (n > 0) { 0 } else { 3 };
}

Option(WitnessEp) witness_arg(Str s) {
    List(Str) p = str_split(s, ":");
    if (p.len() != 3) { return None; }
    List(Int) k = cose_hex_decode(p[2]);
    return if (k.len() == 65) { Some(WitnessEp {.host = p[0], .port = str_parse_int(p[1]), .key = k}) } else { None };
}

List(WitnessEp) witness_args(List(Str) ss, Int i, List(WitnessEp) acc) {
    if (i >= ss.len()) { return acc; }
    return witness_args(ss, i + 1, match witness_arg(ss[i]) { Some(w) => acc.concat([w]), None => acc });
}

// The argument after flag `f`, or "" (`k` = 1, 2: the first or second).
@requires(args)
Str flag_arg(Str f, Int k, Int i) {
    if (i + k >= args.count()) { return ""; }
    if (args.get(i) == f) { return args.get(i + k); }
    return flag_arg(f, k, i + 1);
}

// The number of arguments before the first flag.
@requires(args)
Int positional(Int i) {
    if (i >= args.count()) { return i; }
    if (str_len(args.get(i)) > 2 && str_slice(args.get(i), 0, 2) == "--") { return i; }
    return positional(i + 1);
}

// The PEM text of --ca FILE, or "".
@requires(args, filesystem)
Str ca_text() {
    Str f = flag_arg("--ca", 1, 3);
    return if (str_len(f) == 0) { "" } else { filesystem.read_all(f) };
}

// Arguments i..e-1.
@requires(args)
List(Str) arg_list(Int i, Int e, ListBuf(Str) acc) {
    if (i >= e) { return acc.finish(); }
    return arg_list(i + 1, e, acc.push(args.get(i)));
}

// Every value of a flag that may repeat (`--witness A --witness B`).
@requires(args)
List(Str) flag_args(Str f, Int i, ListBuf(Str) acc) {
    if (i + 1 >= args.count()) { return acc.finish(); }
    return if (args.get(i) == f) { flag_args(f, i + 2, acc.push(args.get(i + 1))) } else { flag_args(f, i + 1, acc) };
}

// How `home init` and `home secure` seal the box's keys (home.resid).
@requires(args)
SealOpts seal_opts(Int i) { return SealOpts {.mode = flag_arg("--seal", 1, i), .pass_file = flag_arg("--passphrase-file", 1, i), .fast = has_flag("--fast-kdf", i)}; }

Str bind_or(Str b) { return if (str_len(b) == 0) { "127.0.0.1" } else { b }; }

@requires(args)
Bool has_flag(Str f, Int i) {
    if (i >= args.count()) { return false; }
    if (args.get(i) == f) { return true; }
    return has_flag(f, i + 1);
}

// `symbolon device org ...` (src/agent/orgcli.resid).
@requires(filesystem, network, device, declassify, clock, provision, environment, args)
Int org_command(Int n) {
    Str c = args.get(3);
    Str d = args.get(4);
    if (c == "new" && n == 6) { return org_new(d, args.get(5)); }
    // An invite code is a bearer secret: "-" reads it from standard input (its first line, before the PIN).
    if (c == "join" && (n == 7 || n == 8)) { Str code = if (n == 8) { if (args.get(7) == "-") { read_pin() } else { args.get(7) } } else { "" }; return org_join(d, args.get(5), args.get(6), code); }
    if (c == "invite" && (n == 7 || n == 8)) { return org_invite(d, args.get(5), args.get(6), if (n == 8) { args.get(7) } else { "" }); }
    if (c == "show" && n == 5) { return org_show(d); }
    if (c == "members" && n == 5) { return org_members(d); }
    if (c == "groups" && n == 5) { return org_groups(d); }
    if (c == "add" && (n == 7 || n == 8)) { return org_add(d, args.get(5), args.get(6), if (n == 8) { args.get(7) } else { "" }); }
    if (c == "remove" && n == 6) { return org_remove(d, args.get(5)); }
    if (c == "role" && n == 7) { return org_role(d, args.get(5), args.get(6)); }
    if (c == "policy" && n == 7) { return org_policy(d, args.get(5), args.get(6)); }
    if (c == "sync" && (n == 5 || (n == 7 && args.get(5) == "--yes"))) { return org_sync(d, if (n == 7) { args.get(6) } else { "" }); }
    // `org recovery on DIR K DELAY ADMINS`, `org recovery off DIR`, `org escrow DIR CID`, `org recover request|approve|open DIR CID`
    if (c == "recovery" && d == "on" && (n == 9 || (n == 10 && args.get(9) == "--short-delay"))) { return org_recovery(args.get(5), "on", args.get(6), args.get(7), args.get(8), n == 10); }
    if (c == "recovery" && d == "off" && n == 6) { return org_recovery(args.get(5), "off", "", "", "", false); }
    if (c == "escrow" && n == 6) { return org_escrow(d, args.get(5)); }
    if (c == "recover" && n == 7) { return org_recover(args.get(5), d, args.get(6)); }
    if (c == "audit" && n == 5) { return org_audit(d); }
    if (c == "attest" && n >= 5 && n <= 7) { return org_attest(d, if (n >= 6) { args.get(5) } else { "" }, if (n == 7) { args.get(6) } else { "" }); }
    if (c == "console" && n == 6) { return org_console(d, str_parse_int(args.get(5))); }
    if (c == "console-key" && (n == 6 || n == 7)) { return org_console_key(d, args.get(5), if (n == 7) { args.get(6) } else { "" }); }
    if (c == "changes" && n == 5) { return org_changes(d); }
    if (c == "approve" && (n == 6 || n == 7)) { return org_approve(d, args.get(5), if (n == 7) { args.get(6) } else { "" }); }
    if (c == "export" && positional(3) == 5) { return org_export(d, flag_arg("--https", 1, 5), flag_arg("--token", 1, 5), flag_arg("--syslog", 1, 5), flag_arg("--ca", 1, 5)); }
    // `org group new DIR NAME`, `org group add|remove DIR GROUP LOG`, `org folder new DIR NAME GROUPS`
    if (c == "group" && d == "new" && n == 7) { return org_group_new(args.get(5), args.get(6)); }
    if (c == "group" && (d == "add" || d == "remove") && n == 8) { return org_group_set(args.get(5), args.get(6), args.get(7), d == "add"); }
    if (c == "folder" && d == "new" && n == 8) { return org_folder_new(args.get(5), args.get(6), args.get(7)); }
    eprintln("device org: unknown form (see src/agent/orgcli.resid)");
    return 2;
}

// Every device command ends with the security update's reminder while it
// is due (D-4). It depends on the device directory's files alone, so it
// reads the same under the PIN, the duress PIN, or none (SPEC 9.2).
@requires(args, environment, network, filesystem, device, declassify, clock, process, provision)
Int main() {
    _ = settle();
    Int rc = main_cmd();
    _ = remind();
    return rc;
}

// A re-share's share kept aside is taken into use (or dropped) as the
// verified log says, before any device command, `ssh-agent` and
// `ssh-agent-stdio` (nextshare.resid; MR-9, MR-13).
@requires(args, filesystem, network, clock(readonly), declassify)
Bool settle() {
    Str d = dir_at(settle_positions(args.get(1)), 0);
    return str_len(d) > 0 && str_len(settle_pending(d)) > 0;
}

// The first of the arguments at `ps` that is a device directory.
@requires(args, filesystem)
Str dir_at(List(Int) ps, Int i) {
    if (i >= ps.len()) { return ""; }
    Int k = ps[i];
    Str a = if (k < args.count()) { args.get(k) } else { "" };
    if (str_len(a) > 0 && filesystem.exists(a + "/config.cbor")) { return a; }
    return dir_at(ps, i + 1);
}

@requires(args, filesystem)
Bool remind() {
    if (args.get(1) != "device" || args.get(2) == "status" || args.get(2) == "new" || args.get(2) == "link-new") { return false; }
    Str d = device_dir_arg(3);
    if (str_len(d) == 0) { return false; }
    Bool due = security_update_due(d);
    if (due) { eprintln(security_update_reminder(d)); }
    // The key refresh after the Paillier nonce fix (migrate.resid), also
    // from the files alone.
    Bool refresh = args.get(2) != "security-update" && reshare_due_here(d);
    if (refresh && !due) { eprintln(reshare_reminder(d)); }
    return due || refresh;
}

// The first of the arguments 3-5 that is a device directory.
@requires(args, filesystem)
Str device_dir_arg(Int i) {
    if (i > 5 || i >= args.count()) { return ""; }
    Str a = args.get(i);
    if (str_len(a) > 0 && filesystem.exists(a + "/config.cbor")) { return a; }
    return device_dir_arg(i + 1);
}

@requires(args, environment, network, filesystem, device, declassify, clock, process, provision)
Int main_cmd() {
    Str a1 = args.get(1);
    Str a2 = args.get(2);
    Int n = args.count();
    if (a1 == "home" && a2 == "init" && n >= 5) {
        Int hp = positional(4);
        return home_init(args.get(3), arg_list(4, hp, ListBuf()), if (str_len(flag_arg("--ports", 1, hp)) > 0) { str_parse_int(flag_arg("--ports", 1, hp)) } else { home_default_base() },
                         flag_arg("--bind", 1, hp), flag_args("--witness", hp, ListBuf()), flag_arg("--witness-ca", 1, hp), seal_opts(hp));
    }
    if (a1 == "home" && a2 == "secure" && n >= 4) { return home_secure(args.get(3), flag_args("--witness", 4, ListBuf()), flag_arg("--witness-ca", 1, 4), seal_opts(4)); }
    if (a1 == "home" && a2 == "status" && n == 4) { return home_status_cmd(args.get(3)); }
    if (a1 == "home" && a2 == "witness-cert" && n >= 6) { return home_witness_cert(args.get(3), args.get(4), args.get(5), flag_arg("--passphrase-file", 1, 6)); }
    if (a1 == "home" && a2 == "invite" && n == 5) { return home_invite(args.get(3), args.get(4)); }
    if (a1 == "device" && a2 == "pin" && n == 4) { return device_pin(args.get(3)); }
    // Started by the browser (native messaging); its own arguments follow.
    if (a1 == "ssh-agent-stdio" && n == 5) { return ssh_agent_stdio(args.get(2), args.get(3), args.get(4)); }
    if (a1 == "ssh-agent" && (n == 3 || n == 4)) { return ssh_agent(args.get(2), if (n == 4) { args.get(3) } else { "" }); }
    if (a1 == "device" && a2 == "ssh" && args.get(3) == "new" && n == 6) { return ssh_new(args.get(4), args.get(5)); }
    if (a1 == "device" && a2 == "ssh" && args.get(3) == "import" && n == 7) { return ssh_import(args.get(4), args.get(5), args.get(6)); }
    if (a1 == "device" && a2 == "ssh" && args.get(3) == "list" && n == 5) { return ssh_list(args.get(4)); }
    if (a1 == "device" && a2 == "ssh" && args.get(3) == "sign" && (n == 6 || n == 7)) { return ssh_sign(args.get(4), args.get(5), if (n == 7) { args.get(6) } else { "" }); }
    if (a1 == "device" && a2 == "ssh" && args.get(3) == "delete" && n == 6) { return ssh_delete(args.get(4), args.get(5)); }
    if (a1 == "device" && a2 == "ssh" && args.get(3) == "ca-new" && n == 6) { return ssh_ca_new(args.get(4), args.get(5)); }
    if (a1 == "device" && a2 == "ssh" && args.get(3) == "cas" && n == 5) { return ssh_cas(args.get(4)); }
    if (a1 == "device" && a2 == "ssh" && args.get(3) == "certify" && n >= 7) { return ssh_certify(args.get(4), args.get(5), args.get(6), arg_list(7, n, ListBuf())); }
    if (a1 == "device" && a2 == "ssh" && args.get(3) == "renew" && n == 6) { return ssh_renew(args.get(4), args.get(5)); }
    if (a1 == "device" && a2 == "ssh" && args.get(3) == "certs" && n == 5) { return ssh_certs(args.get(4)); }
    if (a1 == "device" && a2 == "ssh" && args.get(3) == "refresh" && n == 5) { return ssh_refresh(args.get(4)); }
    if (a1 == "device" && a2 == "link-new" && n >= 4) { return link_new(args.get(3), flag_arg("--host", 1, 4), has_flag("--unprotected", 4), has_flag("--keystore", 4), has_flag("--fast-kdf", 4), flag_arg("--primes", 1, 4)); }
    // The link carries the code's secret: on standard input, never on the command line.
    if (a1 == "device" && a2 == "link-add" && n >= 5 && str_starts_with(args.get(4), "symbolon:")) { eprintln("device: give the link on standard input (its first line, then the PIN), not on the command line"); return 2; }
    if (a1 == "device" && a2 == "link-add" && n >= 4) { return link_add_cmd(args.get(3), flag_arg("--primes", 1, 4)); }
    if (a1 == "device" && a2 == "key" && args.get(3) == "add" && n == 6) { return key_add(args.get(4), args.get(5)); }
    if (a1 == "device" && a2 == "key" && args.get(3) == "list" && n == 5) { return key_list(args.get(4)); }
    if (a1 == "device" && a2 == "key" && args.get(3) == "list" && n == 6 && args.get(5) == "--pin") { return key_list_pin(args.get(4)); }
    if (a1 == "device" && a2 == "key" && args.get(3) == "remove" && n == 6) { return key_remove(args.get(4), args.get(5)); }
    if (a1 == "device" && a2 == "key" && args.get(3) == "fills" && n == 6) { return key_fills(args.get(4), args.get(5)); }
    if (a1 == "browser" && a2 == "host") { return browser_host([args.get(3), args.get(4)]); }
    if (a1 == "home" && a2 == "serve" && n >= 4) { return home_serve(args.get(3), args.get(0), flag_arg("--passphrase-file", 1, 4), flag_arg("--run", 1, 4)); }
    if (a1 == "home" && a2 == "pair-serve" && n == 5) { return home_pair_serve(args.get(3), args.get(4), args.get(0)); }
    if (a1 == "home" && a2 == "pair-child" && n == 6) { return home_pair_child(args.get(3), str_parse_int(args.get(4)), args.get(5)); }
    if (a1 == "cosigner" && a2 == "new" && positional(3) == 6) { return cosignerd_new(args.get(3), args.get(4), str_parse_int(args.get(5)), ca_text()); }
    if (a1 == "cosigner" && a2 == "pair" && n == 5) { return cosignerd_pair(args.get(3), args.get(4)); }
    if (a1 == "cosigner" && a2 == "serve" && (n == 4 || n == 5)) { return cosignerd_serve(args.get(3), if (n == 5) { args.get(4) } else { "" }, args.get(0)); }
    if (a1 == "cosigner" && a2 == "serve-for" && n == 6) { return cosignerd_serve_for(args.get(3), args.get(4), str_parse_int(args.get(5))); }
    if (a1 == "device" && a2 == "new" && n >= 6) { return device_new(args.get(3), args.get(4), str_parse_int(args.get(5)), has_flag("--unprotected", 6), has_flag("--keystore", 6), has_flag("--fast-kdf", 6), ca_text()); }
    if (a1 == "device" && a2 == "init" && (n == 8 || n == 10)) {
        return device_init(args.get(3), InitArgs {.cosigner_keys = args.get(4), .witnesses = witness_args([args.get(5), args.get(6), args.get(7)], 0, []),
                                                   .device_primes = if (n == 10) { args.get(8) } else { "" }, .kit_primes = if (n == 10) { args.get(9) } else { "" }});
    }
    if (a1 == "device" && a2 == "register" && (n == 5 || n == 6)) { return device_register(args.get(3), args.get(4), has_flag("--duress", 5)); }
    if (a1 == "device" && a2 == "sign" && n == 7) { return device_sign(args.get(3), args.get(4), args.get(5), args.get(6)); }
    if (a1 == "device" && a2 == "status" && n == 4) { return device_status_plus(args.get(3)); }
    if (a1 == "device" && a2 == "security-advice" && (n == 4 || (n == 6 && args.get(4) == "--report"))) { return device_security_advice(args.get(3), if (n == 6) { args.get(5) } else { "" }); }
    if (a1 == "device" && a2 == "scan-leaks" && n == 4) { return device_scan_leaks_kept(args.get(3)); }
    if (a1 == "cosigner" && a2 == "scan-leaks" && n == 4) { return cosigner_scan_leaks(args.get(3)); }
    if (a1 == "device" && a2 == "security-update" && (n == 4 || n == 5)) { return device_security_update(args.get(3), if (n == 5) { args.get(4) } else { "" }); }
    if (a1 == "device" && a2 == "openings" && n == 4) { return device_openings(args.get(3)); }
    if (a1 == "device" && a2 == "protection" && args.get(3) == "enable" && (n == 5 || n == 6)) { return device_protection_enable(args.get(4), if (n == 6) { args.get(5) } else { "" }); }
    if (a1 == "device" && a2 == "forget" && n == 4) { return device_forget(args.get(3)); }
    if (a1 == "device" && a2 == "vault" && n == 8 && args.get(3) == "login") { return vault_login(args.get(4), args.get(5), args.get(6), args.get(7)); }
    if (a1 == "device" && a2 == "vault" && args.get(3) == "put" && n == 6) { return vault_put(args.get(4), args.get(5)); }
    if (a1 == "device" && a2 == "vault" && args.get(3) == "get" && n == 6) { return vault_get(args.get(4), args.get(5)); }
    if (a1 == "device" && a2 == "vault" && args.get(3) == "protect" && n == 6) { return vault_protect(args.get(4), args.get(5), true); }
    if (a1 == "device" && a2 == "vault" && args.get(3) == "unprotect" && n == 6) { return vault_protect(args.get(4), args.get(5), false); }
    // `--share ID` comes last: the folder the vault command works in.
    if (a1 == "device" && a2 == "vault" && n >= 5 && (args.get(3) == "list" || args.get(3) == "show" || args.get(3) == "code")) {
        Str no = fill_refusal(args.get(4));
        if (str_len(no) > 0) { return dfail(no); }
    }
    Str share = if (n >= 6 && args.get(n - 2) == "--share") { args.get(n - 1) } else { "" };
    Int ns = if (str_len(share) > 0) { n - 2 } else { n };
    if (a1 == "device" && a2 == "rotate" && (ns == 7 || ns == 8)) { return device_rotate(args.get(3), args.get(4), args.get(5), args.get(6), if (ns == 8) { args.get(7) } else { "chromium" }, share); }
    if (a1 == "device" && a2 == "vault" && args.get(3) == "move" && ns == 7) { return vault_move(args.get(4), args.get(5), args.get(6), share, false); }
    if (a1 == "device" && a2 == "vault" && args.get(3) == "move" && ns == 8 && args.get(7) == "--unprotect") { return vault_move(args.get(4), args.get(5), args.get(6), share, true); }
    if (a1 == "device" && a2 == "vault" && args.get(3) == "list" && ns == 5) { return vault_list_at(args.get(4), 0, share); }
    if (a1 == "device" && a2 == "vault" && args.get(3) == "breach" && ns == 5) { return vault_breach(args.get(4), share); }
    if (a1 == "device" && a2 == "vault" && args.get(3) == "list" && ns == 6 && args.get(5) == "--kinds") { return vault_list_at(args.get(4), 1, share); }
    if (a1 == "device" && a2 == "vault" && args.get(3) == "list" && ns == 6 && args.get(5) == "--long") { return vault_list_at(args.get(4), 2, share); }
    if (a1 == "device" && a2 == "webauthn" && args.get(3) == "register" && n >= 6) { return device_wa_register(args.get(4), args.get(5), has_flag("--uv", 6), has_flag("--duress", 6), flag_arg("--replaces", 1, 6)); }
    if (a1 == "device" && a2 == "webauthn" && args.get(3) == "retire" && n >= 6) { return device_wa_retire(args.get(4), args.get(5), has_flag("--force", 6)); }
    if (a1 == "device" && a2 == "webauthn" && args.get(3) == "synced" && n == 5) { return device_wa_synced(args.get(4)); }
    if (a1 == "device" && a2 == "webauthn" && args.get(3) == "assert" && n >= 8) { return device_wa_assert(args.get(4), args.get(5), args.get(6), args.get(7), has_flag("--uv", 8)); }
    if (a1 == "device" && a2 == "vault" && args.get(3) == "show" && ns == 6) { return vault_show(args.get(4), args.get(5), share); }
    if (a1 == "device" && a2 == "vault" && args.get(3) == "code" && ns == 6) { return vault_code(args.get(4), args.get(5), share); }
    if (a1 == "device" && a2 == "vault" && args.get(3) == "set" && ns == 7) { return vault_set(args.get(4), args.get(5), args.get(6), share); }
    if (a1 == "device" && a2 == "vault" && args.get(3) == "delete" && ns == 6) { return vault_delete(args.get(4), args.get(5), share); }
    if (a1 == "device" && a2 == "vault" && args.get(3) == "import" && n >= 6) {
        Str fmt = flag_arg("--format", 1, 6);
        return vault_import(args.get(4), args.get(5), if (str_len(fmt) == 0) { "auto" } else { fmt }, has_flag("--dry-run", 6), share);
    }
    if (a1 == "device" && a2 == "beacon" && n >= 4) { return device_beacon(args.get(3), flag_arg("--location", 1, 4)); }
    if (a1 == "device" && a2 == "alerts" && n == 4) { return device_alerts(args.get(3)); }
    if (a1 == "device" && a2 == "alerts" && args.get(3) == "set" && n == 5) { return device_alerts_set(args.get(4)); }
    if (a1 == "device" && a2 == "alerts" && args.get(3) == "register" && n == 5) { return device_alerts_register(args.get(4)); }
    if (a1 == "device" && a2 == "alerts" && args.get(3) == "inbox" && n == 5) { return device_alerts_inbox(args.get(4)); }
    if (a1 == "device" && a2 == "duress" && args.get(3) == "end" && n == 5) { return device_duress_end(args.get(4)); }
    if (a1 == "home" && a2 == "alerts" && n >= 4) { return home_alerts_cmd(args.get(3), arg_list(4, n, ListBuf())); }
    if (a1 == "device" && a2 == "vault" && args.get(3) == "signin-lastpass" && n >= 5) {
        return vault_signin_lastpass(args.get(4), has_flag("--dry-run", 5), share);
    }
    if (a1 == "device" && a2 == "vault" && args.get(3) == "signin-bitwarden" && n >= 6) {
        return vault_signin_bitwarden(args.get(4), args.get(5), has_flag("--dry-run", 6), share);
    }
    if (a1 == "device" && a2 == "share" && args.get(3) == "new" && n == 6) { return share_new(args.get(4), args.get(5)); }
    if (a1 == "device" && a2 == "share" && args.get(3) == "list" && n == 5) { return share_list(args.get(4)); }
    if (a1 == "device" && a2 == "share" && args.get(3) == "members" && n == 6) { return share_members(args.get(4), args.get(5)); }
    if (a1 == "device" && a2 == "share" && args.get(3) == "add" && n == 8) { return share_add(args.get(4), args.get(5), args.get(6), args.get(7)); }
    if (a1 == "device" && a2 == "share" && args.get(3) == "remove" && n == 7) { return share_remove(args.get(4), args.get(5), args.get(6)); }
    if (a1 == "device" && a2 == "share" && args.get(3) == "delete" && n == 6) { return share_delete(args.get(4), args.get(5)); }
    if (a1 == "device" && a2 == "org") { return org_command(n); }
    if (a1 == "device" && a2 == "share" && args.get(3) == "leave" && n == 6) { return share_leave(args.get(4), args.get(5)); }
    if (a1 == "device" && a2 == "share" && args.get(3) == "duress" && n == 7) { return share_duress(args.get(4), args.get(5), args.get(6)); }
    if (a1 == "device" && a2 == "share" && args.get(3) == "card" && n == 6) { return share_card(args.get(4), args.get(5)); }
    if (a1 == "device" && a2 == "share" && args.get(3) == "me" && n == 5) { return share_me(args.get(4)); }
