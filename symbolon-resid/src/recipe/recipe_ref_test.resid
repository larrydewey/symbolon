// Recipes (src/recipe/recipe.resid) against bytes, signatures and a Merkle
// tree made by an independent implementation (tests/gen_recipe_ref.py).
// Generated; do not edit by hand.

import "../types.resid";
import "recipe.resid";
import "crypto.resid";

Str hx(List(Int) b) { return hex_encode(b); }

RecipePayload v1() {
    return RecipePayload { .domain = "example.com", .version = 3,
        .password_rules = PasswordRules { .min_length = 12, .max_length = 64, .required_classes = 7, .forbidden_chars = "\"\\" },
        .steps = [StepNavigate("https://acct.example.com/security"), StepFill("#old", "old"), StepFill("#new", "new"), StepFill("#otp", "totp"), StepClick("#save"), StepExpect(ExpectText("Password changed")), StepPasskeyRegister], .allowed_origins = ["https://acct.example.com", "https://login.example.com"], .sign_in = [] };
}

RecipePayload with_sign_in() {
    return RecipePayload { .domain = "example.com", .version = 6, .password_rules = v1().password_rules, .steps = v1().steps,
        .allowed_origins = v1().allowed_origins,
        .sign_in = [StepNavigate("https://login.example.com/signin"), StepFill("#user", "username"), StepFill("#pw", "password"), StepClick("#go"), StepExpect(ExpectElement("#account"))] };
}

test "recipe bytes equal the reference and decode back" {
    expect(hx(recipe_cbor(v1()))).toEqual("");
    RecipePayload d = recipe_decode([165, 1, 107, 101, 120, 97, 109, 112, 108, 101, 46, 99, 111, 109, 2, 3, 3, 164, 1, 12, 2, 24, 64, 3, 7, 4, 98, 34, 92, 4, 135, 130, 0, 120, 33, 104, 116, 116, 112, 115, 58, 47, 47, 97, 99, 99, 116, 46, 101, 120, 97, 109, 112, 108, 101, 46, 99, 111, 109, 47, 115, 101, 99, 117, 114, 105, 116, 121, 131, 1, 100, 35, 111, 108, 100, 99, 111, 108, 100, 131, 1, 100, 35, 110, 101, 119, 99, 110, 101, 119, 131, 1, 100, 35, 111, 116, 112, 100, 116, 111, 116, 112, 130, 2, 101, 35, 115, 97, 118, 101, 130, 3, 130, 2, 112, 80, 97, 115, 115, 119, 111, 114, 100, 32, 99, 104, 97, 110, 103, 101, 100, 130, 4, 245, 5, 130, 120, 24, 104, 116, 116, 112, 115, 58, 47, 47, 97, 99, 99, 116, 46, 101, 120, 97, 109, 112, 108, 101, 46, 99, 111, 109, 120, 25, 104, 116, 116, 112, 115, 58, 47, 47, 108, 111, 103, 105, 110, 46, 101, 120, 97, 109, 112, 108, 101, 46, 99, 111, 109]) else { v1() };
    expect(hx(recipe_cbor(d))).toEqual("");
    expect(d.steps.len()).toEqual(7);
    expect(d.password_rules.forbidden_chars).toEqual("\"\\");
}

