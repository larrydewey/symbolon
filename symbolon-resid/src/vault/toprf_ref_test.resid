@requires(declassify)
test "RFC 9497 A.3.2 VOPRF P256-SHA256 vector 1: blind, evaluate, proof, finalize" {
    Secret(UInt(576)) sk = classify((UInt(576)) 91532539054822234701549471063345030610719078945367128598185272404387665476774);
    Secret(UInt(576)) r = classify((UInt(576)) 23168626897791761709447416394617165385208309107894447545438769048368017232740);
    List(Int) b = toprf_blind_with([0], r);
    assert(b == [2, 221, 5, 144, 16, 56, 187, 49, 166, 250, 224, 24, 40, 253, 141, 14, 73, 227, 90, 72, 107, 92, 93, 75, 73, 148, 1, 54, 72, 192, 18, 119, 218]);
    ToprfEval ev = toprf_evaluate_with(sk, [b], classify((UInt(576)) 113012839300483267075401517860400452017850732073207147837118508319505925060529));
    assert(ev.ok);
    assert(ev.elements[0] == [2, 9, 243, 60, 171, 96, 207, 143, 230, 146, 57, 176, 175, 188, 252, 210, 97, 175, 76, 28, 86, 50, 98, 79, 46, 155, 162, 155, 144, 174, 131, 228, 162]);
    assert(ev.proof == [231, 194, 179, 197, 201, 84, 192, 53, 148, 159, 31, 116, 230, 188, 226, 237, 83, 154, 59, 226, 103, 209, 72, 30, 157, 219, 23, 133, 51, 223, 76, 38, 100, 246, 157, 6, 92, 96, 74, 79, 217, 83, 225, 0, 184, 86, 173, 131, 128, 78, 179, 132, 81, 137, 186, 191, 165, 167, 2, 9, 13, 111, 197, 250]);
    assert(toprf_verify(pt_dec([3, 225, 126, 112, 96, 75, 202, 190, 25, 136, 130, 192, 161, 242, 122, 146, 68, 30, 119, 66, 36, 237, 156, 112, 46, 81, 221, 23, 3, 139, 16, 36, 98]), [b], ev.elements, ev.proof));
    List(Secret(UInt(8))) y = toprf_finalize([0], r, pt_dec(ev.elements[0]));
    assert(opened(y) == [4, 18, 232, 247, 139, 2, 196, 21, 171, 58, 40, 142, 34, 137, 120, 55, 111, 153, 146, 119, 103, 255, 55, 197, 113, 141, 66, 0, 16, 166, 69, 161]);
}

