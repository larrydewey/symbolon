@requires(declassify)
test "1-of-1 evaluation by parties [1]: shares verify, combine to the single-key PRF, and give the item key" {
    List(List(Int)) commits = [[2, 124, 61, 184, 98, 6, 57, 111, 230, 134, 34, 136, 238, 18, 204, 97, 24, 207, 70, 1, 174, 253, 247, 41, 126, 224, 175, 134, 100, 27, 109, 232, 202]];
    List(Int) vid = [225, 4, 2, 190, 59, 62, 18, 37, 24, 93, 196, 70, 24, 235, 72, 203, 142, 76, 112, 223, 8, 36, 152, 36, 13, 170, 63, 114, 10, 33, 200, 4];
    List(Int) iid = [80, 41, 74, 182, 133, 118, 221, 38, 2, 4, 232, 185, 192, 136, 94, 114];
    List(Int) inp = toprf_item_input(vid, iid);
    Secret(UInt(576)) r = classify((UInt(576)) 75008118914257622321040289785603210255310226077626686786947182106496597272583);
    List(Int) b = toprf_blind_with(inp, r);
    assert(b == [2, 173, 147, 243, 120, 220, 55, 125, 134, 152, 54, 141, 90, 124, 4, 69, 35, 201, 109, 205, 186, 121, 96, 43, 126, 244, 155, 21, 241, 174, 177, 173, 205]);
    P256Aff k1 = toprf_party_key(commits, 1);
    assert(k1.ok);
    ToprfEval e1 = toprf_evaluate_with(classify((UInt(576)) 16891079252031086813298817705889408502764911514789380292570559259612302522812), [b], classify((UInt(576)) 86667236227891666335449096416165133859587699730896844082450654105476332713442));
    assert(e1.ok);
    assert(e1.elements[0] == [3, 47, 125, 235, 220, 80, 141, 202, 80, 42, 146, 51, 47, 222, 223, 175, 180, 187, 107, 26, 49, 120, 5, 225, 207, 161, 136, 230, 230, 218, 246, 147, 24]);
    assert(e1.proof == [140, 135, 217, 100, 158, 161, 80, 57, 207, 135, 49, 251, 111, 189, 145, 116, 204, 252, 57, 11, 156, 76, 122, 192, 138, 161, 76, 96, 33, 71, 82, 129, 13, 175, 184, 173, 25, 35, 21, 75, 77, 129, 220, 168, 11, 77, 112, 153, 35, 193, 117, 180, 52, 36, 232, 67, 23, 20, 237, 26, 24, 101, 167, 15]);
    assert(toprf_verify(k1, [b], e1.elements, e1.proof));
    P256Aff z = toprf_combine([1], [e1.elements[0]]);
    assert(z.ok);
    List(Secret(UInt(8))) y = toprf_finalize(inp, r, z);
    assert(opened(y) == [125, 0, 193, 82, 102, 29, 241, 128, 139, 2, 133, 202, 51, 21, 158, 39, 197, 248, 230, 197, 110, 93, 102, 162, 202, 45, 126, 162, 142, 203, 141, 48]);
    List(Secret(UInt(8))) key = protected_item_key(secret_bytes([67, 195, 169, 232, 129, 255, 115, 131, 55, 202, 138, 180, 80, 171, 130, 153, 76, 175, 185, 114, 87, 121, 38, 131, 209, 197, 240, 189, 168, 28, 193, 14]), y, vid, iid);
    assert(opened(key) == [240, 30, 221, 77, 150, 180, 129, 26, 163, 225, 237, 92, 218, 233, 232, 61, 246, 187, 254, 198, 113, 91, 95, 148, 249, 128, 206, 54, 237, 60, 226, 80]);
}

test "a proof for another party's key, a tampered element or a tampered proof is refused" {
    List(List(Int)) commits = [[3, 81, 223, 249, 97, 20, 158, 151, 212, 215, 104, 168, 183, 183, 120, 163, 8, 158, 40, 55, 245, 221, 142, 197, 142, 46, 186, 206, 68, 39, 19, 103, 82], [3, 188, 124, 81, 175, 194, 206, 85, 72, 65, 47, 22, 189, 75, 208, 71, 195, 103, 49, 246, 177, 39, 189, 52, 214, 54, 28, 195, 2, 202, 183, 162, 89]];
    List(Int) b = [3, 221, 249, 140, 12, 159, 213, 180, 93, 236, 115, 202, 176, 240, 125, 218, 241, 121, 129, 210, 175, 68, 9, 138, 94, 6, 42, 114, 161, 1, 18, 129, 69];
    List(Int) z = [3, 107, 90, 196, 181, 117, 8, 187, 103, 242, 234, 15, 231, 56, 217, 193, 211, 159, 205, 156, 57, 240, 229, 248, 126, 98, 10, 153, 216, 178, 125, 100, 72];
    List(Int) pf = [149, 249, 223, 154, 239, 65, 231, 76, 173, 55, 33, 44, 63, 33, 187, 226, 218, 35, 8, 163, 143, 212, 45, 218, 221, 247, 109, 185, 132, 68, 5, 238, 98, 100, 133, 148, 89, 229, 92, 176, 92, 245, 214, 1, 8, 39, 198, 9, 145, 33, 90, 219, 19, 194, 114, 12, 92, 3, 182, 37, 84, 24, 191, 110];
    assert(toprf_verify(toprf_party_key(commits, 1), [b], [z], pf));
    assert(!toprf_verify(toprf_party_key(commits, 2), [b], [z], pf));
    assert(!toprf_verify(toprf_party_key(commits, 1), [b], [[2, 117, 42, 159, 162, 32, 192, 132, 98, 81, 43, 39, 40, 210, 133, 160, 107, 54, 162, 210, 121, 28, 106, 37, 29, 224, 66, 233, 254, 115, 216, 148, 217]], pf));
    List(Int) bad = pf[0..63].concat([pf[63] ^ 1]);
    assert(!toprf_verify(toprf_party_key(commits, 1), [b], [z], bad));
    assert(!toprf_verify(toprf_party_key(commits, 1), [b], [z], pf[0..32]));
}
