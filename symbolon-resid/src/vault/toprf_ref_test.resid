@requires(declassify)
test "RFC 9497 A.3.2 VOPRF P256-SHA256 vector 3: a batch of two, one proof" {
    Secret(UInt(576)) sk = classify((UInt(576)) 91532539054822234701549471063345030610719078945367128598185272404387665476774);
    List(Int) b0 = toprf_blind_with([0], classify((UInt(576)) 23168626897791761709447416394617165385208309107894447545438769048368017232740));
    List(Int) b1 = toprf_blind_with([90, 90, 90, 90, 90, 90, 90, 90, 90, 90, 90, 90, 90, 90, 90, 90, 90], classify((UInt(576)) 113012839300483267075401517860400452017850732073207147837118508319505925060529));
    ToprfEval ev = toprf_evaluate_with(sk, [b0, b1], classify((UInt(576)) 23998202008923202842477183501037102142629860680473610743955335943826182732131));
    assert(ev.ok);
    assert(ev.proof == [189, 204, 53, 23, 7, 208, 42, 114, 206, 73, 81, 28, 125, 185, 144, 86, 109, 41, 214, 21, 58, 214, 248, 152, 47, 173, 43, 67, 93, 108, 228, 214, 13, 161, 230, 179, 250, 116, 8, 17, 189, 227, 77, 212, 254, 10, 161, 181, 254, 102, 0, 208, 68, 12, 157, 222, 233, 94, 167, 250, 215, 166, 12, 242]);
    P256Aff pk = pt_dec([3, 225, 126, 112, 96, 75, 202, 190, 25, 136, 130, 192, 161, 242, 122, 146, 68, 30, 119, 66, 36, 237, 156, 112, 46, 81, 221, 23, 3, 139, 16, 36, 98]);
    assert(toprf_verify(pk, [b0, b1], ev.elements, ev.proof));
    assert(!toprf_verify(pk, [b1, b0], ev.elements, ev.proof));
}

@requires(declassify)
test "2-of-3 evaluation by parties [1, 2]: shares verify, combine to the single-key PRF, and give the item key" {
    List(List(Int)) commits = [[3, 81, 223, 249, 97, 20, 158, 151, 212, 215, 104, 168, 183, 183, 120, 163, 8, 158, 40, 55, 245, 221, 142, 197, 142, 46, 186, 206, 68, 39, 19, 103, 82], [3, 188, 124, 81, 175, 194, 206, 85, 72, 65, 47, 22, 189, 75, 208, 71, 195, 103, 49, 246, 177, 39, 189, 52, 214, 54, 28, 195, 2, 202, 183, 162, 89]];
