    List(Int) iid = [163, 89, 22, 15, 175, 116, 100, 158, 35, 113, 221, 6, 80, 81, 48, 63];
    List(Int) inp = toprf_item_input(vid, iid);
    Secret(UInt(576)) r = classify((UInt(576)) 15061396028710172185007620167458290850674117519264468483395476162433417727159);
    List(Int) b = toprf_blind_with(inp, r);
