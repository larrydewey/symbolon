// The threshold OPRF of SPEC 18.10 (src/vault/toprf.resid) against an
// independent Python implementation of RFC 9380, RFC 9497 and 2HashTDH
// (tests/gen_toprf_ref.py), which itself first reproduces the RFCs' published
// vectors. Generated; do not edit by hand.

import "../types.resid";
import "toprf.resid";
import "vault.resid";
import "word.resid";
import "crypto.resid";
import "p256ops.resid";

List(Int) widen(List(UInt(8)) b, Int i, ListBuf(Int) acc) {
    if (i >= b.len()) { return acc.finish(); }
    return widen(b, i + 1, acc.push((Int) b[i]));
}

@requires(declassify)
List(Int) opened(List(Secret(UInt(8))) b) {
    return widen(declassify(secret_join(b), "test compares to the reference"), 0, ListBuf());
}

test "RFC 9380 J.1.1 P256_XMD:SHA-256_SSWU_RO_ vector 0" {
    P256Aff pt = toprf_hash_to_curve([], [81, 85, 85, 88, 45, 86, 48, 49, 45, 67, 83, 48, 50, 45, 119, 105, 116, 104, 45, 80, 50, 53, 54, 95, 88, 77, 68, 58, 83, 72, 65, 45, 50, 53, 54, 95, 83, 83, 87, 85, 95, 82, 79, 95]);
    assert(pt.ok);
    assert(pt.x == 19939110987797896384999358838712942378328709725372625404958758733340714980324);
    assert(pt.y == 62635533156651938055399572357915645529892752307205894735512613587016694531093);
}

