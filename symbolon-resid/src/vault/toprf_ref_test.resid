    P256Aff k1 = toprf_party_key(commits, 1);
    assert(k1.ok);
    ToprfEval e1 = toprf_evaluate_with(classify((UInt(576)) 23227670904332781244775385595865048228887257383197486993484111303855309463787), [b], classify((UInt(576)) 88706482869852527322884327230273922551477126398526549842395452029554233891915));
    assert(e1.ok);
    assert(e1.elements[0] == [3, 107, 90, 196, 181, 117, 8, 187, 103, 242, 234, 15, 231, 56, 217, 193, 211, 159, 205, 156, 57, 240, 229, 248, 126, 98, 10, 153, 216, 178, 125, 100, 72]);
    assert(e1.proof == [149, 249, 223, 154, 239, 65, 231, 76, 173, 55, 33, 44, 63, 33, 187, 226, 218, 35, 8, 163, 143, 212, 45, 218, 221, 247, 109, 185, 132, 68, 5, 238, 98, 100, 133, 148, 89, 229, 92, 176, 92, 245, 214, 1, 8, 39, 198, 9, 145, 33, 90, 219, 19, 194, 114, 12, 92, 3, 182, 37, 84, 24, 191, 110]);
    assert(toprf_verify(k1, [b], e1.elements, e1.proof));
    P256Aff k2 = toprf_party_key(commits, 2);
    assert(k2.ok);
    ToprfEval e2 = toprf_evaluate_with(classify((UInt(576)) 76598377874662984546031166227551409407846210051227120603054931426591045337293), [b], classify((UInt(576)) 42510715549543616540937129082500014587073848141259212173083116263275160255291));
    assert(e2.ok);
    assert(e2.elements[0] == [2, 117, 42, 159, 162, 32, 192, 132, 98, 81, 43, 39, 40, 210, 133, 160, 107, 54, 162, 210, 121, 28, 106, 37, 29, 224, 66, 233, 254, 115, 216, 148, 217]);
    assert(e2.proof == [239, 5, 82, 3, 141, 180, 237, 222, 207, 207, 84, 98, 144, 24, 217, 147, 86, 165, 115, 191, 169, 30, 230, 115, 162, 194, 61, 191, 185, 3, 145, 82, 167, 253, 195, 43, 136, 59, 229, 122, 136, 53, 52, 239, 133, 203, 89, 172, 231, 111, 66, 155, 8, 104, 140, 93, 199, 135, 188, 120, 124, 2, 211, 216]);
    assert(toprf_verify(k2, [b], e2.elements, e2.proof));
    P256Aff z = toprf_combine([1, 2], [e1.elements[0], e2.elements[0]]);
    assert(z.ok);
    List(Secret(UInt(8))) y = toprf_finalize(inp, r, z);
    assert(opened(y) == [165, 57, 164, 197, 241, 5, 84, 15, 30, 1, 70, 30, 91, 87, 132, 57, 107, 87, 146, 127, 73, 35, 16, 123, 215, 233, 229, 11, 113, 104, 48, 39]);
    List(Secret(UInt(8))) key = protected_item_key(secret_bytes([88, 109, 101, 212, 150, 167, 88, 217, 193, 150, 6, 25, 163, 161, 135, 255, 254, 131, 60, 76, 94, 30, 240, 63, 211, 2, 30, 17, 25, 160, 154, 189]), y, vid, iid);
    assert(opened(key) == [34, 72, 28, 223, 117, 6, 31, 233, 157, 128, 219, 161, 77, 2, 245, 221, 143, 189, 42, 182, 61, 34, 177, 43, 194, 232, 83, 40, 92, 163, 247, 118]);
}

