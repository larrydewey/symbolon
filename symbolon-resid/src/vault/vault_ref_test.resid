List(Item) ref_items() { return [ref_item_0(), ref_item_1(), ref_item_2(), ref_item_3(), ref_item_4()];  }
List(Item) ref_items_shuffled() { return [ref_item_0(), ref_item_2(), ref_item_1(), ref_item_4(), ref_item_3()];  }

@requires(declassify)
test "item 0: the reference ciphertexts open to the reference plaintexts" {
    List(Secret(UInt(8))) vk = vault_key_bytes();
    Result(List(FieldPlain), SymbolonError) r = item_open(vk, vault_id(), ref_item_0());
    List(FieldPlain) got = r else { [] };
    expect(got.len()).toEqual(2);
    expect(hx(field_named(got, "password"))).toEqual("68756e74657232");
    expect(hx(field_named(got, "user"))).toEqual("616c696365");
}

@requires(declassify)
