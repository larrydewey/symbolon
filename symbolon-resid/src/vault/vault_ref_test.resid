@requires(declassify)
test "item 3: sealing twice gives other ciphertexts, both opening to the plaintexts" {
    List(Secret(UInt(8))) vk = vault_key_bytes();
    List(FieldPlain) plain = [FieldPlain {.name = "text", .value = secret_bytes(rt [45, 136, 177, 87, 203, 208, 209, 5, 139, 222, 23, 131, 205, 140, 45, 110, 145, 83, 191, 69, 224, 45, 54, 167, 133, 238, 45, 112, 38, 239, 161, 83, 47, 112, 186, 251, 194, 206, 157, 233, 10, 97, 104, 8, 42, 203, 186, 33, 6, 143, 109, 126, 71, 160, 9, 66, 117, 228, 141, 8, 217, 85, 137, 212, 70, 255, 124, 140, 243, 31, 179, 28, 232, 149, 146, 7, 97, 110, 11, 85, 152, 120, 96, 210, 34, 90, 14, 232, 127, 235, 42, 249, 245, 106, 96, 227, 165, 134, 221, 152, 68, 100, 193, 168, 134, 190, 109, 18, 32, 74, 200, 34, 46, 252, 132, 178, 108, 244, 35, 36, 184, 77, 174, 171, 7, 220, 179, 102, 18, 147, 107, 120, 93, 77, 176, 103, 10, 18, 64, 165, 76, 28, 123, 82, 173, 155, 164, 164, 170, 132, 145, 182, 119, 241, 188, 213, 213, 186, 59, 140, 238, 78, 105, 251, 184, 118, 239, 144, 97, 244, 75, 132, 157, 196, 176, 132, 251, 158, 98, 150, 11, 199, 117, 201, 23, 55, 182, 28, 201, 216, 35, 213, 183, 246, 176, 102, 218, 154, 200, 124, 40, 114, 35, 219, 174, 133, 216, 182, 160, 187, 181, 94, 144, 88, 18, 161, 10, 96, 196, 124, 167, 248, 55, 240, 153, 165, 73, 40, 152, 115, 138, 113, 209, 208, 105, 35, 62, 212, 160, 162, 173, 105, 15, 44, 83, 84, 4, 3, 67, 199, 63, 69, 107, 209, 207, 112, 173, 71, 198, 220, 24, 194, 104, 253, 167, 232, 237, 29, 211, 46, 21, 128, 80, 31, 138, 66, 173, 57, 13, 26, 14, 56, 154, 170, 137, 152, 233, 74, 173, 201, 148, 41, 32, 119, 214, 35, 65, 134, 163, 126])}];
    Item a = item_seal(vk, vault_id(), [4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4], 2, "note", plain, true, None) else { ref_item_3() };
    Item b = item_seal(vk, vault_id(), [4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4], 2, "note", plain, true, None) else { ref_item_3() };
    expect(hx(item_cbor(a)) == hx(item_cbor(b))).toBeFalse();
    expect(hx(item_cbor(a)) == hx(item_cbor(ref_item_3()))).toBeFalse();
    List(FieldPlain) ga = item_open(vk, vault_id(), a) else { [] };
    List(FieldPlain) gb = item_open(vk, vault_id(), b) else { [] };
    expect(ga.len()).toEqual(1);
    expect(gb.len()).toEqual(1);
    expect(hx(field_named(ga, "text"))).toEqual("");
    expect(hx(field_named(gb, "text"))).toEqual("");
}

