    List(FieldPlain) got = r else { [] };
    expect(got.len()).toEqual(3);
    expect(hx(field_named(got, "note"))).toEqual("68c903442cf4cccf5cc5d5428acbb849abad9a40de09d84a53da02ea330483d8cef5f1d44d73585a");
    expect(hx(field_named(got, "pässwörd"))).toEqual("c3a9e282ac");
    expect(hx(field_named(got, "user"))).toEqual("626f62");
}

