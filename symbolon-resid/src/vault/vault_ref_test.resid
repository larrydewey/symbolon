Bool r_ok(Result(Item, SymbolonError) r) { return match r { Ok(_) => true, Err(_) => false }; }

test "merkle root equals the reference, whatever the order" {
    expect(hx(merkle_root(ref_items()))).toEqual("7ac7f3f90cf4d74d30cfeaabf51027329aa83cb28463b7b27e049572be8f758d");
    expect(hx(merkle_root(ref_items_shuffled()))).toEqual("7ac7f3f90cf4d74d30cfeaabf51027329aa83cb28463b7b27e049572be8f758d");
}

List(Int) ref_dk() { return [4, 15, 81, 26, 190, 190, 31, 213, 248, 210, 186, 146, 211, 6, 107, 163, 112, 227, 101, 235, 209, 157, 249, 64, 6, 216, 201, 176, 11, 108, 45, 64, 24, 244, 166, 14, 144, 135, 61, 214, 124, 61, 68, 0, 208, 10, 204, 0, 2, 172, 52, 128, 127, 121, 204, 168, 225, 154, 161, 82, 29, 94, 74, 150, 179]; }

LogHead ref_log_head(UInt(64) seq) {
    Party p = Party { .id = [96, 72, 27, 85, 114, 47, 138, 84, 34, 12, 170, 123, 240, 126, 240, 6, 89, 77, 153, 205, 0, 0, 194, 217, 19, 103, 182, 145, 222, 56, 111, 158], .kind = party_kind_device(), .auth_key = ref_dk(),
                      .hpke_key = [], .label = "d", .attestation = NoAttestation };
    return LogHead {
        .log_id = [120, 59, 156, 3, 23, 44, 244, 125, 220, 44, 192, 186, 21, 149, 23, 169, 93, 176, 120, 48, 65, 85, 122, 89, 174, 21, 223, 142, 200, 64, 249, 108], .sequence = seq, .digest = [],
        .quorum = Quorum { .parties = [p], .t = 1, .root_pubkey = [], .epoch = 0, .transcript_digest = [] },
        .policy = Policy { .device_sigs_for_authority = 1, .recovery_delay_sec = 86400, .guardians = [],
                           .guardian_threshold = 0, .witnesses = [], .duress_window_sec = 0,
                           .cosigner_policy = NoCosignerPolicy } };
}

VaultHead ref_head(List(Int) sig) {
    return VaultHead {
        .vault_id = vault_id(), .version = 9, .merkle_root = [122, 199, 243, 249, 12, 244, 215, 77, 48, 207, 234, 171, 245, 16, 39, 50, 154, 168, 60, 178, 132, 99, 183, 178, 126, 4, 149, 114, 190, 143, 117, 141], .log_id = [120, 59, 156, 3, 23, 44, 244, 125, 220, 44, 192, 186, 21, 149, 23, 169, 93, 176, 120, 48, 65, 85, 122, 89, 174, 21, 223, 142, 200, 64, 249, 108],
        .log_sequence = 4, .suite = 1, .signer = [96, 72, 27, 85, 114, 47, 138, 84, 34, 12, 170, 123, 240, 126, 240, 6, 89, 77, 153, 205, 0, 0, 194, 217, 19, 103, 182, 145, 222, 56, 111, 158], .sig = sig };
}

Bool accepted(Result(VaultState, SymbolonError) r) { return match r { Ok(_) => true, Err(_) => false }; }

test "head signed by Python's ECDSA: tbs bytes equal the reference" {
    expect(hx(head_tbs(ref_head([193, 159, 180, 159, 172, 144, 102, 136, 36, 166, 41, 23, 30, 12, 249, 122, 197, 10, 134, 238, 143, 150, 12, 150, 177, 206, 202, 38, 159, 242, 206, 168, 68, 226, 37, 245, 195, 194, 142, 66, 130, 102, 66, 231, 50, 215, 127, 108, 59, 26, 250, 28, 69, 69, 114, 62, 114, 204, 74, 127, 166, 77, 68, 214])))).toEqual("846a5369676e61747572653143a10126405870a6015820cfb18b8a9b3a90f44afd526169df43d0f5336784adf02dfb4bf44dfa287f2fb402090358207ac7f3f90cf4d74d30cfeaabf51027329aa83cb28463b7b27e049572be8f758d045820783b9c03172cf47ddc2cc0ba159517a95db0783041557a59ae15df8ec840f96c05040601");
}

test "head signed by Python's ECDSA is accepted; a flipped signature bit is refused" {
    VaultState good = VaultState { .head = ref_head([193, 159, 180, 159, 172, 144, 102, 136, 36, 166, 41, 23, 30, 12, 249, 122, 197, 10, 134, 238, 143, 150, 12, 150, 177, 206, 202, 38, 159, 242, 206, 168, 68, 226, 37, 245, 195, 194, 142, 66, 130, 102, 66, 231, 50, 215, 127, 108, 59, 26, 250, 28, 69, 69, 114, 62, 114, 204, 74, 127, 166, 77, 68, 214]), .items = ref_items() };
    expect(accepted(vault_accept(good, vault_id(), ref_log_head(10), 9))).toBeTrue();
    VaultState bad = VaultState { .head = ref_head([193, 159, 180, 159, 172, 144, 102, 136, 36, 166, 40, 23, 30, 12, 249, 122, 197, 10, 134, 238, 143, 150, 12, 150, 177, 206, 202, 38, 159, 242, 206, 168, 68, 226, 37, 245, 195, 194, 142, 66, 130, 102, 66, 231, 50, 215, 127, 108, 59, 26, 250, 28, 69, 69, 114, 62, 114, 204, 74, 127, 166, 77, 68, 214]), .items = ref_items() };
    expect(accepted(vault_accept(bad, vault_id(), ref_log_head(10), 9))).toBeFalse();
}
