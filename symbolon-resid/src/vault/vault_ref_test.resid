@requires(declassify)
test "item 1: sealing twice gives other ciphertexts, both opening to the plaintexts" {
    List(Secret(UInt(8))) vk = vault_key_bytes();
    List(FieldPlain) plain = [FieldPlain {.name = "note", .value = secret_bytes(rt [104, 201, 3, 68, 44, 244, 204, 207, 92, 197, 213, 66, 138, 203, 184, 73, 171, 173, 154, 64, 222, 9, 216, 74, 83, 218, 2, 234, 51, 4, 131, 216, 206, 245, 241, 212, 77, 115, 88, 90])}, FieldPlain {.name = "pässwörd", .value = secret_bytes(rt [195, 169, 226, 130, 172])}, FieldPlain {.name = "user", .value = secret_bytes(rt [98, 111, 98])}];
    Item a = item_seal(vk, vault_id(), [2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2], 3, "login", plain, true, Some("confirm")) else { ref_item_1() };
    Item b = item_seal(vk, vault_id(), [2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2], 3, "login", plain, true, Some("confirm")) else { ref_item_1() };
    expect(hx(item_cbor(a)) == hx(item_cbor(b))).toBeFalse();
    expect(hx(item_cbor(a)) == hx(item_cbor(ref_item_1()))).toBeFalse();
    List(FieldPlain) ga = item_open(vk, vault_id(), a) else { [] };
    List(FieldPlain) gb = item_open(vk, vault_id(), b) else { [] };
    expect(ga.len()).toEqual(3);
    expect(gb.len()).toEqual(3);
    expect(hx(field_named(ga, "note"))).toEqual("68c903442cf4cccf5cc5d5428acbb849abad9a40de09d84a53da02ea330483d8cef5f1d44d73585a");
    expect(hx(field_named(gb, "note"))).toEqual("68c903442cf4cccf5cc5d5428acbb849abad9a40de09d84a53da02ea330483d8cef5f1d44d73585a");
    expect(hx(field_named(ga, "pässwörd"))).toEqual("c3a9e282ac");
    expect(hx(field_named(gb, "pässwörd"))).toEqual("c3a9e282ac");
    expect(hx(field_named(ga, "user"))).toEqual("626f62");
    expect(hx(field_named(gb, "user"))).toEqual("626f62");
}

