// Identity log verifier (SPEC Sections 8.2, 8.3, 13.4).
//
// Pure: no provider is touched, so nothing here needs a capability. The
// caller supplies the events, their witness co-signatures, the current
// witness time and (for guardian recoveries) the approval check; the
// verifier never repairs a log, it returns Ok(VerifiedHead) or Err.
//
// Invariant the wire decoder MUST keep: SignedEvent.encoded is the exact
// byte string that was signed and from which `payload` was decoded. The
// verifier hashes and checks signatures over `encoded` and reads rules from
// `payload`; it cannot tell the two apart.

import "../types.resid";
import "hash.resid";
import "ecdsa.resid";
import "crypto.resid";
import "cose.resid";

//@ serial
pub type EventSig = { List(Int) signer; List(Int) sig; };

pub type SignedEvent = {
    EventPayload payload;
    List(Int) encoded;
    List(EventSig) sigs;
    List(WitnessCosignature) cosigs;
};

// A delayed event, applied once its delay has run without a veto.
type Pending = {
    UInt(64) seq;
    Int ready_at;
    EventBody body;
    List(Int) event_digest;
    List(List(Int)) next_digests;
    // Filed by the kit (a recover, or the kit's escape set-policy, SPEC
    // 20.3): one at a time, and a device may veto it without the relay's
    // claim.
    Bool kit;
    // The devices whose signatures it carried (valid, of the quorum, not
    // removed, when it was witnessed), and whether it is delayed whatever
    // its signatures (a weakening set-policy): a confirm (do_confirm)
    // counts the first and never applies the second.
    List(List(Int)) signers;
    Bool forced;
};

type LogState = {
    Quorum quorum;
    Policy policy;
    List(List(Int)) recovery_digests;       // field 6 in force
    List(Party) proposed;                // effective at the next reshare
    List(List(Int)) removed;
    List(Pending) pending;
    Int vetoes;                          // consecutive vetoes of recoveries
    List(Int) prev_digest;
    UInt(64) next_seq;
    Int last_time;                       // witness time of the last event
    List(WitnessCosignature) last_cosigs;
    // The digests of the latest rotate-recovery in force (SPEC 13.2), []
    // when none or when a recovery has come since: the kit they name may
    // replace the quorum's kit party at a re-share.
    List(List(Int)) rotated_to;
};

// ============================================================================
// Byte helpers
// ============================================================================

pub Bool bytes_eq(List(Int) a, List(Int) b) {
    if (a.len() != b.len()) { return false; }
    return bytes_eq_from(a, b, 0);
}

Bool bytes_eq_from(List(Int) a, List(Int) b, Int i) {
    if (i >= a.len()) { return true; }
    if (a[i] != b[i]) { return false; }
    return bytes_eq_from(a, b, i + 1);
}

Eq(List(Int)) = bytes_eq;

Bool has_bytes(List(List(Int)) xs, List(Int) x, Int i) {
    if (i >= xs.len()) { return false; }
    if (bytes_eq(xs[i], x)) { return true; }
    return has_bytes(xs, x, i + 1);
}

pub Bool opt_bytes_is(Option(List(Int)) o, List(Int) want) {
    return match o { Some(b) => bytes_eq(b, want), None => false };
}

Bool opt_present(Option(List(Int)) o) {
    return match o { Some(_) => true, None => false };
}

Bool known_party(Option(Party) o) {
    return match o { Some(_) => true, None => false };
}

Bool known_witness(Option(WitnessRef) o) {
    return match o { Some(_) => true, None => false };
}

// ============================================================================
// Quorum lookups
// ============================================================================

Option(Party) party_by_id(List(Party) ps, List(Int) id, Int i) {
    if (i >= ps.len()) { return None; }
    if (bytes_eq(ps[i].id, id)) { return Some(ps[i]); }
    return party_by_id(ps, id, i + 1);
}

Int device_count(List(Party) ps, Int i, Int acc) {
    if (i >= ps.len()) { return acc; }
    Int add = if (ps[i].kind == party_kind_device()) { 1 } else { 0 };
    return device_count(ps, i + 1, acc + add);
}

Bool ids_distinct(List(Party) ps, Int i) {
    if (i >= ps.len()) { return true; }
    List(List(Int)) rest = ids_of(ps, i + 1, ListBuf());
    if (has_bytes(rest, ps[i].id, 0)) { return false; }
    return ids_distinct(ps, i + 1);
}

List(List(Int)) ids_of(List(Party) ps, Int i, ListBuf(List(Int)) acc) {
    if (i >= ps.len()) { return acc.finish(); }
    return ids_of(ps, i + 1, acc.push(ps[i].id));
}

Bool key_ok(List(Int) k) { return ec_public_ok(P256, k); }

// A party id is SHA-256 of the party's authentication key (SPEC 20.2.1),
// for every kind: device, cosigner and guardian ids are party_of_key(DK),
// the kit's is recovery_key_digest(sign_pub). Without the binding a log
// could list someone else's party id beside its own key and post to that
// party's mailbox at the relay.
Bool party_id_ok(Party p) { return key_ok(p.auth_key) && bytes_eq(p.id, sha256_bytes(p.auth_key)); }

Bool parties_ok(List(Party) ps, Int i) {
    if (i >= ps.len()) { return true; }
    if (!party_id_ok(ps[i])) { return false; }
    return parties_ok(ps, i + 1);
}

// SPEC 7: 1 to 8 parties, 1 <= t <= parties, distinct ids, valid keys.
Bool quorum_ok(Quorum q) {
    Int n = q.parties.len();
    if (n < 1 || n > 8) { return false; }
    Int t = (Int)q.t;
    if (t < 1 || t > n) { return false; }
    if (!key_ok(q.root_pubkey)) { return false; }
    if (!ids_distinct(q.parties, 0)) { return false; }
    // Field 6 (SPEC 18.10.1): none, or t commitments that are points.
    if (q.kv_commits.len() > 0 && (q.kv_commits.len() != t || !keys_ok(q.kv_commits, 0))) { return false; }
    return parties_ok(q.parties, 0);
}

Bool keys_ok(List(List(Int)) ks, Int i) { return i >= ks.len() || (key_ok(ks[i]) && keys_ok(ks, i + 1)); }

// SPEC 18.10.1: once the quorum has a vault OPRF key, every later quorum
// has one with the same C_0 (k_v never changes across epochs); a re-share
// may add field 6 to a quorum without it (protected items turned on).
Bool kv_kept(Quorum old, Quorum new) {
    if (old.kv_commits.len() == 0) { return true; }
    return new.kv_commits.len() > 0 && bytes_eq(new.kv_commits[0], old.kv_commits[0]);
}

// Distinct witness keys (SPEC 20.3: at least three; independence of their
// operators is a deployment matter the verifier cannot check).
Int witness_keys_distinct(List(WitnessRef) ws, Int i) {
    if (i >= ws.len()) { return 0; }
    List(List(Int)) rest = witness_key_list(ws, i + 1, ListBuf());
    return (if (has_bytes(rest, ws[i].key, 0)) { 0 } else { 1 }) + witness_keys_distinct(ws, i + 1);
}

List(List(Int)) witness_key_list(List(WitnessRef) ws, Int i, ListBuf(List(Int)) acc) {
    if (i >= ws.len()) { return acc.finish(); }
    return witness_key_list(ws, i + 1, acc.push(ws[i].key));
}

// SPEC 8.2: the device signatures an authority event needs to take effect
// at once. policy[1], but never fewer than two while `live` (the quorum in
// force, removed parties left out) holds two devices or more, whatever
// policy[1] says: a policy written while the quorum had one device (the
// inception's, which enrolment re-shares away from without a set-policy)
// may still say 1, and one device of a household must not then make
// authority events (remove the other devices, rotate the kit, propose
// parties) immediate (R4-1). Fewer signatures delay the event, vetoable.
// `t`: the event's witness time. The floor holds from the release cutover
// (authority_floor_from) on; an event witnessed before it keeps the stored
// policy[1] rule, so logs written before the release still verify as they
// did. Witness time is the median of a witness majority's co-signed times
// (and never goes backwards along a log), so a new event cannot be
// backdated below the cutover without a corrupt witness majority.
pub Int authority_sigs(Policy p, List(Party) live, Int t) {
    Int set = (Int)p.device_sigs_for_authority;
    if (t < authority_floor_from()) { return set; }
    Int floor = if (device_count(live, 0, 0) >= 2) { 2 } else { 1 };
    Int need = if (set < floor) { floor } else { set };
    return need;
}

// SPEC 8.2: the release cutover of the quorum-in-force floor,
// 2026-12-01T00:00:00Z as Unix seconds of witness time.
pub Int authority_floor_from() { return 1796083200; }

// SPEC 8.2 and 20.3: policy[1] >= 2 when the quorum holds two devices or more,
// recovery delay at least 24 hours.
Bool policy_ok(Policy p, Quorum q) {
    Int floor = if (device_count(q.parties, 0, 0) >= 2) { 2 } else { 1 };
    if ((Int)p.device_sigs_for_authority < floor) { return false; }
    if (p.recovery_delay_sec < 86400) { return false; }
    if (witness_keys_distinct(p.witnesses, 0) < 3) { return false; }
    if ((Int)p.guardian_threshold > p.guardians.len()) { return false; }
    // Field 8 (SPEC 20.3): at most one sequencing relay, with a valid key.
    if (p.sequencer.len() > 1) { return false; }
    if (p.sequencer.len() == 1 && (!key_ok(p.sequencer[0].key) || str_len(p.sequencer[0].url) > 260)) { return false; }
    return true;
}

// SPEC 8.2: a policy that shortens the delay or thins guardians or
// witnesses, or drops the sequencing relay (SPEC 20.3: without one, any
// single key holder can freeze the log again).
pub Bool weakens(Policy old, Policy new) {
    if (old.sequencer.len() > 0 && new.sequencer.len() == 0) { return true; }
    if (new.recovery_delay_sec < old.recovery_delay_sec) { return true; }
    if (new.guardians.len() < old.guardians.len()) { return true; }
    if (new.guardian_threshold < old.guardian_threshold) { return true; }
    if (new.witnesses.len() < old.witnesses.len()) { return true; }
    return witnesses_weaken(old.witnesses, new.witnesses);
}

// SPEC 8.2, 20.3: a witness change weakens the policy unless it only adds
// witnesses, and few enough that every majority of the new set still holds
// a majority of the old one. Removing or replacing a witness (any key of
// the old set missing from the new one) weakens it: the keys a log's
// holders chose to vouch against forks are gone. So does adding as many
// witnesses as could, with a minority of the old ones, make up a majority
// on their own (three added to three: three of the six new, with one old,
// co-sign), which would let whoever runs the added ones fork the log with
// fewer of the old witnesses than before.
//
// A witness is its key at its address (R4-7): an old key moved to another
// address weakens the policy as well, since clients reach witnesses only
// at the policy's addresses, and every one moved to a dead host would
// otherwise freeze the log at once, with no veto window.
pub Bool witnesses_weaken(List(WitnessRef) old, List(WitnessRef) new) {
    List(List(Int)) nk = witness_key_list(new, 0, ListBuf());
    if (!pairs_all_in(old, new, 0)) { return true; }
    Int added = keys_not_in(nk, witness_key_list(old, 0, ListBuf()), 0, []);
    return witnesses_need(new) - added < witnesses_need(old);
}

Int witnesses_need(List(WitnessRef) ws) { return ws.len() / 2 + 1; }

// Whether every witness of `xs` is in `ys` with the same key at the same
// address (witness_addr).
Bool pairs_all_in(List(WitnessRef) xs, List(WitnessRef) ys, Int i) {
    if (i >= xs.len()) { return true; }
    return pair_in(ys, xs[i], 0) && pairs_all_in(xs, ys, i + 1);
}

Bool pair_in(List(WitnessRef) ys, WitnessRef w, Int i) {
    if (i >= ys.len()) { return false; }
    if (bytes_eq(ys[i].key, w.key) && witness_addr(ys[i].url) == witness_addr(w.url)) { return true; }
    return pair_in(ys, w, i + 1);
}

// An odd number of distinct witness keys (R4-6): a sequence split between
// a claimed event and a claimless one can then always be settled by a
// majority once every witness has answered (il_claimless); with an even
// number a 2/2 split freezes the log for good. Required of every policy
// made from now on: `device init`, `device witnesses`
// (policy_with_witnesses), and any set-policy of a log whose policy has an
// odd number already (do_set_policy). A log that began with an even number
// before the rule still verifies, and its set-policies may keep an even
// number (`device witnesses` makes only odd ones).
pub Bool witnesses_odd(List(WitnessRef) ws) { return witness_keys_distinct(ws, 0) % 2 == 1; }

Bool keys_all_in(List(List(Int)) xs, List(List(Int)) ys, Int i) {
    if (i >= xs.len()) { return true; }
    return has_bytes(ys, xs[i], 0) && keys_all_in(xs, ys, i + 1);
}

// How many distinct keys of `xs` are not in `ys`.
Int keys_not_in(List(List(Int)) xs, List(List(Int)) ys, Int i, List(List(Int)) seen) {
    if (i >= xs.len()) { return seen.len(); }
    Bool count = !has_bytes(ys, xs[i], 0) && !has_bytes(seen, xs[i], 0);
    return keys_not_in(xs, ys, i + 1, if (count) { seen.concat([xs[i]]) } else { seen });
}

// ============================================================================
// A witness change (`symbolon device witnesses`, SPEC 20.3)
// ============================================================================

// A witness's address as HOST:PORT, lower case, without http:// or https://.
pub Str witness_addr(Str url) {
    Str u = str_to_lower(str_trim(url));
    Str a = if (str_starts_with(u, "https://")) { str_slice(u, 8, str_len(u)) } else {
        if (str_starts_with(u, "http://")) { str_slice(u, 7, str_len(u)) } else { u } };
    return a;
}

Int at_addr(List(WitnessRef) ws, Str a, Int i, Int n) {
    if (i >= ws.len()) { return n; }
    return at_addr(ws, a, i + 1, if (witness_addr(ws[i].url) == a) { n + 1 } else { n });
}

List(WitnessRef) not_at(List(WitnessRef) ws, List(Str) addrs, Int i, ListBuf(WitnessRef) acc) {
    if (i >= ws.len()) { return acc.finish(); }
    return not_at(ws, addrs, i + 1, if (addrs.contains(witness_addr(ws[i].url))) { acc } else { acc.push(ws[i]) });
}

List(Str) addrs_of(List(Str) xs, Int i, ListBuf(Str) acc) {
    if (i >= xs.len()) { return acc.finish(); }
    return addrs_of(xs, i + 1, acc.push(witness_addr(xs[i])));
}

// The first address of `remove` that names no witness of `ws`, or "".
Str unknown_addr(List(WitnessRef) ws, List(Str) remove, Int i) {
    if (i >= remove.len()) { return ""; }
    if (at_addr(ws, remove[i], 0, 0) == 0) { return remove[i]; }
    return unknown_addr(ws, remove, i + 1);
}

// Why witness `add[i]` cannot join `have` (the witnesses kept, then the
// ones added before it), or "" when every one can.
Str add_problem(List(WitnessRef) have, List(WitnessRef) add, Int i) {
    if (i >= add.len()) { return ""; }
    WitnessRef w = add[i];
    if (!key_ok(w.key)) { return w.url + ": the key is not a P-256 public key"; }
    if (has_bytes(witness_key_list(have, 0, ListBuf()), w.key, 0)) { return w.url + ": a witness with that key is in the policy already"; }
    if (at_addr(have, witness_addr(w.url), 0, 0) > 0) { return w.url + ": a witness at that address is in the policy already"; }
    return add_problem(have.concat([w]), add, i + 1);
}

// Policy `p0` with the witnesses at the addresses `remove` (HOST:PORT)
// taken out and `add` put in, every other field kept: the sequencing
// relay (field 8) above all. policy[1] is raised to the floor when the
// quorum `q` has grown past it (as `device sequence` does), or the policy
// would not be valid. Err(why) when an address names no witness, an added
// witness has a bad key or one the policy holds, nothing changes, or the
// result is no valid policy (at least three witnesses, distinct keys).
pub Result(Policy, Str) policy_with_witnesses(Policy p0, Quorum q, List(WitnessRef) add, List(Str) remove) {
    List(Str) rm = addrs_of(remove, 0, ListBuf());
    if (add.len() == 0 && rm.len() == 0) { return Err("name a witness to add or remove"); }
    Str unknown = unknown_addr(p0.witnesses, rm, 0);
    if (str_len(unknown) > 0) { return Err(unknown + ": no witness of the policy is at that address"); }
    List(WitnessRef) kept = not_at(p0.witnesses, rm, 0, ListBuf());
    Str bad = add_problem(kept, add, 0);
    if (str_len(bad) > 0) { return Err(bad); }
    List(WitnessRef) ws = kept.concat(add);
    if (witness_keys_distinct(ws, 0) != ws.len()) { return Err("two witnesses would have the same key"); }
    if (ws.len() < 3) { return Err(f"a policy names at least three witnesses (SPEC 20.3); this would leave {ws.len()}"); }
    if (!witnesses_odd(ws)) { return Err(f"a policy names an odd number of witnesses (SPEC 20.3: with an even number a split vote can freeze the log); this would leave {ws.len()}: add or remove one more"); }
    Int floor = if (device_count(q.parties, 0, 0) >= 2) { 2 } else { 1 };
    UInt(8) dsigs = if ((Int)p0.device_sigs_for_authority < floor) { (UInt(8))floor } else { p0.device_sigs_for_authority };
    Policy np = Policy {.device_sigs_for_authority = dsigs, .recovery_delay_sec = p0.recovery_delay_sec, .guardians = p0.guardians,
                        .guardian_threshold = p0.guardian_threshold, .witnesses = ws, .duress_window_sec = p0.duress_window_sec,
                        .sequencer = p0.sequencer, .cosigner_policy = p0.cosigner_policy};
    if (!policy_ok(np, q)) { return Err("the new policy is not valid (SPEC 8.2, 20.3)"); }
    return Ok(np);
}

// Whether `a` and `b` name the same witness keys (in any order).
pub Bool same_witness_keys(List(WitnessRef) a, List(WitnessRef) b) {
    List(List(Int)) ka = witness_key_list(a, 0, ListBuf());
    List(List(Int)) kb = witness_key_list(b, 0, ListBuf());
    return keys_all_in(ka, kb, 0) && keys_all_in(kb, ka, 0);
}

// ============================================================================
// Signatures
// ============================================================================

Bool sig_ok(List(Int) key, List(Int) msg, List(Int) sig) {
    return ecdsa_verify_raw(P256, Sha256, key, msg, sig);
}

// Distinct ids of parties in `ps` (filtered to devices when `devices_only`)
// with a valid signature over the event's encoding. Each party's first
// signature entry is the only one tried (`tried`): signatures are not
// covered by the event's digest, so anyone may pad an event, a victim's
// co-signed one included, with entries naming a real party, and every one
// of them would otherwise cost a verification (R2W-1).
List(List(Int)) valid_signers(List(EventSig) sigs, List(Party) ps, Bool devices_only, List(Int) msg, Int i, List(List(Int)) acc) {
    List(List(Int)) got = signers_from(sigs, ps, devices_only, msg, i, [], acc);
    return got;
}

List(List(Int)) signers_from(List(EventSig) sigs, List(Party) ps, Bool devices_only, List(Int) msg, Int i, List(List(Int)) tried, List(List(Int)) acc) {
    if (i >= sigs.len()) { return acc; }
    EventSig s = sigs[i];
    Option(Party) found = party_by_id(ps, s.signer, 0);
    Bool fresh = !has_bytes(tried, s.signer, 0);
    Bool counts = fresh && match found {
        Some(p) => (!devices_only || p.kind == party_kind_device()) && sig_ok(p.auth_key, msg, s.sig),
        None => false
    };
    List(List(Int)) tried2 = if (fresh && known_party(found)) { tried.concat([s.signer]) } else { tried };
    List(List(Int)) next = if (counts) { acc.concat([s.signer]) } else { acc };
    return signers_from(sigs, ps, devices_only, msg, i + 1, tried2, next);
}

// The parties of `ps` not in `removed`: a removed party's signature no
// longer counts (R2W-6), although its share lives until the next re-share.
List(Party) not_removed(List(Party) ps, List(List(Int)) removed, Int i, ListBuf(Party) acc) {
    if (i >= ps.len()) { return acc.finish(); }
    return not_removed(ps, removed, i + 1, if (has_bytes(removed, ps[i].id, 0)) { acc } else { acc.push(ps[i]) });
}

// The most signature entries an event may carry (R2W-1): one per party
// that can sign it (the quorum's, and those of the quorum a re-share or a
// recover names) and one for a kit's recovery key.
Int sigs_max(LogState s, EventBody body) {
    Int extra = match body { ReshareBody(nq) => nq.parties.len(), RecoverBody(r) => r.new_parties.len(), _ => 0 };
    return s.quorum.parties.len() + extra + 1;
}

// Whether any signature verifies under `key` (for the kit's recovery key).
Bool signed_by_key(List(EventSig) sigs, List(Int) key, List(Int) msg, Int i) {
    if (i >= sigs.len()) { return false; }
    if (sig_ok(key, msg, sigs[i].sig)) { return true; }
    return signed_by_key(sigs, key, msg, i + 1);
}

Bool signed_by_any(List(EventSig) sigs, List(Party) ps, List(Int) msg, Int i) {
    if (i >= ps.len()) { return false; }
    if (signed_by_key(sigs, ps[i].auth_key, msg, 0)) { return true; }
    return signed_by_any(sigs, ps, msg, i + 1);
}

// ============================================================================
// Witness co-signatures and witness time (SPEC 8.3, A-07)
// ============================================================================

// ============================================================================
// The sequencing relay's claim (SPEC 20.3, R2W-2)
// ============================================================================

// What the relay named in policy[8] signs when it reserves sequence `n` of
// log `l` for the event whose digest is `d`, at its time `t`: once per
// (l, n), never for a second digest. `name` is the relay's name as the
// policy records it.
pub List(Int) claim_message(Str name, List(Int) l, Int n, List(Int) d, Int t) {
    List(Int) m = cbe_uint(t, cbe_bytes(d, cbe_uint(n, cbe_bytes(l, cbe_text(name, cbe_text("symbolon v1 relay claim", cbe_array(6, [])))))));
    return m;
}

// A relay's claim: its time and r || s over claim_message.
pub type RelayClaim = { Int time; List(Int) sig; };

// CBOR [time, r || s].
pub List(Int) claim_cbor(RelayClaim c) {
    List(Int) b = cbe_bytes(c.sig, cbe_uint(c.time, cbe_array(2, [])));
    return b;
}

// The relay's record of its claim: CBOR [bstr event, [time, r || s]].
pub List(Int) claim_record_cbor(List(Int) event, RelayClaim c) {
    List(Int) b = cbe_bytes(event, cbe_array(2, [])).concat(claim_cbor(c));
    return b;
}

// Whether `c` is the claim of the sequencer `sq` (policy[8]) on (l, n, d).
pub Bool claim_ok(WitnessRef sq, List(Int) l, Int n, List(Int) d, RelayClaim c) {
    if (c.sig.len() != 64 || c.time < 0) { return false; }
    Bool ok = sig_ok(sq.key, claim_message(sq.url, l, n, d, c.time), c.sig);
    return ok;
}

// Why a witness may not co-sign event `n` (digest `d`) of log `l` whose
// policy before it names the sequencers `sqs` (none or one), with the
// claim `c` the request carried; "" when it may. A log whose policy names
// no sequencer (one made before policy[8]) needs no claim; at sequence 0
// none is needed either, as E0's digest is the log id.
pub Str claim_problem(List(WitnessRef) sqs, List(Int) l, Int n, List(Int) d, Option(RelayClaim) c) {
    if (sqs.len() == 0 || n == 0) { return ""; }
    return match c {
        None => "no claim from the log's relay for this sequence (SPEC 20.3)",
        Some(x) => if (claim_ok(sqs[0], l, n, d, x)) { "" } else { "the relay claim is not the log's relay's claim on this event (SPEC 20.3)" }
    };
}

pub List(Int) witness_message(List(Int) l, UInt(64) seq, List(Int) d) {
    List(Int) a = cbe_array(4, []);
    List(Int) b = cbe_text("symbolon v1 witness", a);
    List(Int) c = cbe_bytes(l, b);
    List(Int) e = cbe_uint((Int)seq, c);
    return cbe_bytes(d, e);
}

Option(WitnessRef) witness_by_key(List(WitnessRef) ws, List(Int) k, Int i) {
    if (i >= ws.len()) { return None; }
    if (bytes_eq(ws[i].key, k)) { return Some(ws[i]); }
    return witness_by_key(ws, k, i + 1);
}

// Witness times of the distinct, valid co-signatures of one event. Each
// witness key's first co-signature on (l, seq, d) is the only one tried
// (`seen`), as for valid_signers (R2W-1).
List(Int) cosig_times(List(WitnessCosignature) cs, List(WitnessRef) ws, List(Int) l, UInt(64) seq, List(Int) d, Int i, List(List(Int)) seen, List(Int) times) {
    if (i >= cs.len()) { return times; }
    WitnessCosignature c = cs[i];
    Bool tryit = c.sequence == seq
        && bytes_eq(c.log_id, l)
        && bytes_eq(c.digest, d)
        && !has_bytes(seen, c.witness_key, 0)
        && known_witness(witness_by_key(ws, c.witness_key, 0));
    Bool good = tryit && sig_ok(c.witness_key, witness_message(l, seq, d), c.signature);
    List(List(Int)) seen2 = if (tryit) { seen.concat([c.witness_key]) } else { seen };
    List(Int) times2 = if (good) { times.concat([(Int)c.witness_time]) } else { times };
    return cosig_times(cs, ws, l, seq, d, i + 1, seen2, times2);
}

// Median witness time, provided a majority of the policy's witnesses
// signed. More co-signatures than the policy has witnesses is refused
// before any is verified (R2W-1).
pub Result(Int, SymbolonError) witness_time(List(WitnessCosignature) cs, Policy pol, List(Int) l, UInt(64) seq, List(Int) d) {
    if (cs.len() > pol.witnesses.len()) {
        return Err(ErrInvalidLog("more co-signatures than the policy has witnesses"));
    }
    List(Int) ts = cosig_times(cs, pol.witnesses, l, seq, d, 0, [], []);
    Int need = pol.witnesses.len() / 2 + 1;
    if (ts.len() < need) {
        return Err(ErrInvalidLog("fewer than a majority of witnesses co-signed"));
    }
    List(Int) sorted = sort(ts);
    return Ok(sorted[sorted.len() / 2]);
}

// ============================================================================
// A witness's head for a log (SPEC 20.3: POST /head)
// ============================================================================

// What a witness signs when asked, for a fresh nonce, how far it has
// co-signed log `l`: the highest sequence `seq` it co-signed and the digest
// `d` it co-signed there; `d` empty (and `seq` 0) when it co-signed none.
pub List(Int) head_message(List(Int) l, Int seq, List(Int) d, List(Int) nonce, Int t) {
    return cbe_uint(t, cbe_bytes(nonce, cbe_bytes(d, cbe_uint(seq, cbe_bytes(l, cbe_text("symbolon v1 witness head", cbe_array(6, [])))))));
}

// One witness's verified answer; `digest` empty when it co-signed nothing
// of the log.
pub type WitnessHead = { Int seq; List(Int) digest; Int time; };

Bool head_above(WitnessHead h, Int seq) { return h.digest.len() == 32 && h.seq > seq; }

Int heads_answered(List(Option(WitnessHead)) hs, Int i, Int acc) {
    if (i >= hs.len()) { return acc; }
    Option(WitnessHead) o = hs[i];
    return heads_answered(hs, i + 1, acc + (match o { Some(_) => 1, None => 0 }));
}

// The first answer above sequence `seq`, or that co-signed another digest
// than `d` at `seq`; None when there is none.
Option(WitnessHead) head_beyond(List(Option(WitnessHead)) hs, Int seq, List(Int) d, Int i) {
    if (i >= hs.len()) { return None; }
    Option(WitnessHead) o = hs[i];
    Bool bad = match o { None => false, Some(h) => head_above(h, seq) || (h.digest.len() == 32 && h.seq == seq && !bytes_eq(h.digest, d)) };
    return if (bad) { o } else { head_beyond(hs, seq, d, i + 1) };
}

// Whether the head at `seq` with digest `d` is the log's head as the
// witnesses know it (R2W-5): `hs` are the answers of the policy's `n`
// witnesses to POST /head for a fresh nonce (None where a witness did not
// answer or its answer did not verify). "" when a majority answered and
// none co-signed past `seq` or another digest at `seq`; else why not. A
// relay that hides an event (a veto) past `seq` cannot hide it from the
// witnesses that co-signed it, and those are a majority, so at least one
// of any majority that answers. The check fails closed: an event a witness
// co-signed past `seq` that never reached a majority blocks it as well,
// until the log's next event takes that sequence.
pub Str heads_problem(List(Option(WitnessHead)) hs, Int n, Int seq, List(Int) d) {
    Option(WitnessHead) b = head_beyond(hs, seq, d, 0);
    Str why = match b {
        None => "",
        Some(h) => if (h.seq > seq) { f"a witness co-signed sequence {h.seq}, past the head {seq} the relay serves: it may be hiding events (SPEC 20.4)" }
                   else { f"a witness co-signed another event at the head {seq}: a fork (SPEC 20.4)" }
    };
    if (str_len(why) > 0) { return why; }
    if (heads_answered(hs, 0, 0) * 2 <= n) { return "fewer than a majority of the witnesses answered for the log's head"; }
    return "";
}

// Whether no event can be co-signed by a majority at `seq` any more (R2W-2:
// a freeze): `hs` as for heads_problem, after the witnesses refused the
// event a device took there. Witnesses that did not answer, or co-signed
// nothing at `seq`, may still co-sign any one event there; the others hold
// their digest at `seq` for good. "" when some event can still get a
// majority (or the log has moved past `seq`); else the alarm.
pub Str freeze_problem(List(Option(WitnessHead)) hs, Int n, Int seq) {
    if (head_past(hs, seq, 0)) { return ""; }
    List(List(Int)) at = digests_at(hs, seq, 0, []);
    Int free = n - at.len();
    if (most_of(at, 0, 0) + free >= n / 2 + 1) { return ""; }
    return f"log frozen at sequence {seq}: the witnesses co-signed different events there, so none can get a majority; possible attack (SPEC 20.4)";
}

Bool head_past(List(Option(WitnessHead)) hs, Int seq, Int i) {
    if (i >= hs.len()) { return false; }
    Option(WitnessHead) o = hs[i];
    Bool past = match o { None => false, Some(h) => head_above(h, seq) };
    return past || head_past(hs, seq, i + 1);
}

List(List(Int)) digests_at(List(Option(WitnessHead)) hs, Int seq, Int i, List(List(Int)) acc) {
    if (i >= hs.len()) { return acc; }
    Option(WitnessHead) o = hs[i];
    List(Int) hd = match o { None => [], Some(h) => if (h.seq == seq) { h.digest } else { [] } };
    Bool here = hd.len() == 32;
    return digests_at(hs, seq, i + 1, if (here) { acc.concat([hd]) } else { acc });
}

Int count_of(List(List(Int)) xs, List(Int) x, Int i, Int acc) {
    if (i >= xs.len()) { return acc; }
    return count_of(xs, x, i + 1, acc + (if (bytes_eq(xs[i], x)) { 1 } else { 0 }));
}

Int most_of(List(List(Int)) xs, Int i, Int best) {
    if (i >= xs.len()) { return best; }
    Int c = count_of(xs, xs[i], 0, 0);
    return most_of(xs, i + 1, if (c > best) { c } else { best });
}

// ============================================================================
// Applying effects
// ============================================================================

LogState apply_effect(LogState s, EventBody body, List(Int) event_digest, List(List(Int)) next_digests) {
    return match body {
        ProposePartyBody(party, _) => LogState {
            .quorum = s.quorum, .policy = s.policy, .recovery_digests = s.recovery_digests,
            .proposed = s.proposed.concat([party]), .removed = s.removed, .pending = s.pending,
            .vetoes = s.vetoes, .prev_digest = s.prev_digest, .next_seq = s.next_seq,
            .last_time = s.last_time, .last_cosigs = s.last_cosigs, .rotated_to = s.rotated_to },
        RemovePartyBody(id) => LogState {
            .quorum = s.quorum, .policy = s.policy, .recovery_digests = s.recovery_digests,
            .proposed = s.proposed, .removed = s.removed.concat([id]), .pending = s.pending,
            .vetoes = s.vetoes, .prev_digest = s.prev_digest, .next_seq = s.next_seq,
            .last_time = s.last_time, .last_cosigs = s.last_cosigs, .rotated_to = s.rotated_to },
        ReshareBody(nq) => LogState {
            .quorum = nq, .policy = s.policy, .recovery_digests = s.recovery_digests,
            .proposed = [], .removed = [], .pending = s.pending,
            .vetoes = s.vetoes, .prev_digest = s.prev_digest, .next_seq = s.next_seq,
            .last_time = s.last_time, .last_cosigs = s.last_cosigs, .rotated_to = s.rotated_to },
        SetPolicyBody(np) => LogState {
            .quorum = s.quorum, .policy = np, .recovery_digests = s.recovery_digests,
            .proposed = s.proposed, .removed = s.removed, .pending = s.pending,
            .vetoes = s.vetoes, .prev_digest = s.prev_digest, .next_seq = s.next_seq,
            .last_time = s.last_time, .last_cosigs = s.last_cosigs, .rotated_to = s.rotated_to },
        RotateRecoveryBody => LogState {
            .quorum = s.quorum, .policy = s.policy, .recovery_digests = next_digests,
            .proposed = s.proposed, .removed = s.removed, .pending = s.pending,
            .vetoes = s.vetoes, .prev_digest = s.prev_digest, .next_seq = s.next_seq,
            .last_time = s.last_time, .last_cosigs = s.last_cosigs, .rotated_to = next_digests },
        RecoverBody(r) => LogState {
            .quorum = Quorum {
                .parties = r.new_parties, .t = s.quorum.t, .root_pubkey = s.quorum.root_pubkey,
                .epoch = s.quorum.epoch + 1, .transcript_digest = event_digest, .kv_commits = s.quorum.kv_commits },
            .policy = s.policy, .recovery_digests = next_digests,
            .proposed = [], .removed = [], .pending = s.pending,
            .vetoes = 0, .prev_digest = s.prev_digest, .next_seq = s.next_seq,
            .last_time = s.last_time, .last_cosigs = s.last_cosigs, .rotated_to = [] },
        PartyKeyBody(id, k) => LogState {
            .quorum = Quorum {
                .parties = with_hpke(s.quorum.parties, id, k, 0, ListBuf()), .t = s.quorum.t, .root_pubkey = s.quorum.root_pubkey,
                .epoch = s.quorum.epoch, .transcript_digest = s.quorum.transcript_digest, .kv_commits = s.quorum.kv_commits },
            .policy = s.policy, .recovery_digests = s.recovery_digests,
            .proposed = s.proposed, .removed = s.removed, .pending = s.pending,
            .vetoes = s.vetoes, .prev_digest = s.prev_digest, .next_seq = s.next_seq,
            .last_time = s.last_time, .last_cosigs = s.last_cosigs, .rotated_to = s.rotated_to },
        _ => s
    };
}

LogState with_pending(LogState s, List(Pending) pending) {
    return LogState {
        .quorum = s.quorum, .policy = s.policy, .recovery_digests = s.recovery_digests,
        .proposed = s.proposed, .removed = s.removed, .pending = pending,
        .vetoes = s.vetoes, .prev_digest = s.prev_digest, .next_seq = s.next_seq,
        .last_time = s.last_time, .last_cosigs = s.last_cosigs, .rotated_to = s.rotated_to };
}

LogState with_vetoes(LogState s, Int vetoes) {
    return LogState {
        .quorum = s.quorum, .policy = s.policy, .recovery_digests = s.recovery_digests,
        .proposed = s.proposed, .removed = s.removed, .pending = s.pending,
        .vetoes = vetoes, .prev_digest = s.prev_digest, .next_seq = s.next_seq,
        .last_time = s.last_time, .last_cosigs = s.last_cosigs, .rotated_to = s.rotated_to };
}

LogState with_time(LogState s, Int time) {
    return LogState {
        .quorum = s.quorum, .policy = s.policy, .recovery_digests = s.recovery_digests,
        .proposed = s.proposed, .removed = s.removed, .pending = s.pending,
        .vetoes = s.vetoes, .prev_digest = s.prev_digest, .next_seq = s.next_seq,
        .last_time = time, .last_cosigs = s.last_cosigs, .rotated_to = s.rotated_to };
}

LogState advance(LogState s, List(Int) digest, Int time, List(WitnessCosignature) cosigs) {
    return LogState {
        .quorum = s.quorum, .policy = s.policy, .recovery_digests = s.recovery_digests,
        .proposed = s.proposed, .removed = s.removed, .pending = s.pending,
        .vetoes = s.vetoes, .prev_digest = digest, .next_seq = s.next_seq + 1,
        .last_time = time, .last_cosigs = cosigs, .rotated_to = s.rotated_to };
}

// Applies every pending event whose delay has run by `now`, oldest first.
LogState settle(LogState s, Int now) {
    return settle_from(s, now, 0, ListBuf());
}

LogState settle_from(LogState s, Int now, Int i, ListBuf(Pending) kept) {
    if (i >= s.pending.len()) { return with_pending(s, kept.finish()); }
    Pending p = s.pending[i];
    if (p.ready_at <= now) {
        LogState applied = apply_effect(s, p.body, p.event_digest, p.next_digests);
        return settle_from(applied, now, i + 1, kept);
    }
    return settle_from(s, now, i + 1, kept.push(p));
}

Option(Pending) pending_by_seq(List(Pending) ps, UInt(64) seq, Int i) {
    if (i >= ps.len()) { return None; }
    if (ps[i].seq == seq) { return Some(ps[i]); }
    return pending_by_seq(ps, seq, i + 1);
}

List(Pending) pending_without(List(Pending) ps, UInt(64) seq, Int i, ListBuf(Pending) acc) {
    if (i >= ps.len()) { return acc.finish(); }
    ListBuf(Pending) next = if (ps[i].seq == seq) { acc } else { acc.push(ps[i]) };
    return pending_without(ps, seq, i + 1, next);
}

Bool is_recover_body(EventBody b) {
    return match b { RecoverBody(_) => true, _ => false };
}

Bool recover_pending(List(Pending) ps, Int i) {
    if (i >= ps.len()) { return false; }
    return is_recover_body(ps[i].body) || ps[i].kit || recover_pending(ps, i + 1);
}

// The pending event the kit filed (a recover or its escape set-policy;
// at most one at a time), if any.
Option(Pending) kit_pending(List(Pending) ps, Int i) {
    if (i >= ps.len()) { return None; }
    if (ps[i].kit || is_recover_body(ps[i].body)) { return Some(ps[i]); }
    return kit_pending(ps, i + 1);
}

// ============================================================================
// Reshare checks (SPEC 8.2, 11.3)
// ============================================================================

// Every party of the new quorum is a surviving member of the old quorum, a
// proposed party, or the kit an in-force rotate-recovery names, and no
// removed party remains.
Bool reshare_parties_ok(LogState s, List(Party) np, Int i) {
    if (i >= np.len()) { return true; }
    Party p = np[i];
    Bool in_old = known_party(party_by_id(s.quorum.parties, p.id, 0));
    Bool in_proposed = known_party(party_by_id(s.proposed, p.id, 0));
    if (!in_old && !in_proposed && !rotated_kit(s, p)) { return false; }
    if (has_bytes(s.removed, p.id, 0)) { return false; }
    return reshare_parties_ok(s, np, i + 1);
}

// SPEC 13.2: a rotate-recovery in force names the new kit by field 6, its
// party id (SHA-256 of its recovery key, which party_id_ok checks). Until
// a re-share puts that kit in the quorum, the quorum's kit party is the old
// one, whose recovery key is no longer in field 6.
Bool rotated_kit(LogState s, Party p) {
    return p.kind == party_kind_kit() && has_bytes(s.rotated_to, p.id, 0) && has_bytes(s.recovery_digests, p.id, 0);
}

// Whether the new parties bring in the rotated kit (not already a party).
Bool brings_rotated_kit(LogState s, List(Party) np, Int i) {
    if (i >= np.len()) { return false; }
    if (rotated_kit(s, np[i]) && !known_party(party_by_id(s.quorum.parties, np[i].id, 0))) { return true; }
    return brings_rotated_kit(s, np, i + 1);
}

Int kit_count(List(Party) ps, Int i, Int acc) {
    if (i >= ps.len()) { return acc; }
    return kit_count(ps, i + 1, acc + (if (ps[i].kind == party_kind_kit()) { 1 } else { 0 }));
}

List(Party) online_parties(List(Party) ps, Int i, List(Party) acc) {
    if (i >= ps.len()) { return acc; }
    Bool offline = ps[i].kind == party_kind_kit() || ps[i].kind == party_kind_guardian();
    return online_parties(ps, i + 1, if (offline) { acc } else { acc.concat([ps[i]]) });
}

// Signers from the union of old and new parties.
Int signers_in(List(List(Int)) ids, List(Party) ps, Int i, Int acc) {
    if (i >= ids.len()) { return acc; }
    Int add = if (known_party(party_by_id(ps, ids[i], 0))) { 1 } else { 0 };
    return signers_in(ids, ps, i + 1, acc + add);
}

// ============================================================================
// One event
// ============================================================================

Result(LogState, SymbolonError) refuse(Str why) { return Err(ErrInvalidLog(why)); }

// Authority events: immediate when signed by policy[1] devices (at least
// two while the quorum in force holds two devices or more that are not
// removed: authority_sigs), otherwise delayed by the recovery delay (A-04).
Result(LogState, SymbolonError) authority(LogState s, SignedEvent e, List(Int) dig, Bool force_delay, Int dev_sigs) {
    if (dev_sigs < 1) { return refuse("authority event without a device signature"); }
    EventPayload ep = e.payload;
    // s.last_time is this event's witness time here (step_at: with_time).
    List(Party) live = not_removed(s.quorum.parties, s.removed, 0, ListBuf());
    Int need = authority_sigs(s.policy, live, s.last_time);
    Bool immediate = !force_delay && dev_sigs >= need;
    if (immediate) {
        return Ok(apply_effect(s, ep.body, dig, ep.next_recovery_key_digests));
    }
    Pending p = Pending {
        .seq = ep.sequence, .ready_at = s.last_time + (Int)s.policy.recovery_delay_sec,
        .body = ep.body, .event_digest = dig, .next_digests = ep.next_recovery_key_digests, .kit = false,
        .signers = valid_signers(e.sigs, live, true, e.encoded, 0, []), .forced = force_delay };
    return Ok(with_pending(s, s.pending.concat([p])));
}

Result(LogState, SymbolonError) do_propose(LogState s, SignedEvent e, List(Int) dig, Int dev_sigs, Party party) {
    if (known_party(party_by_id(s.quorum.parties, party.id, 0)) || known_party(party_by_id(s.proposed, party.id, 0))) {
        return refuse("party already known");
    }
    if (!key_ok(party.auth_key)) { return refuse("bad party key"); }
    if (!party_id_ok(party)) { return refuse("party id is not SHA-256 of its key"); }
    return authority(s, e, dig, false, dev_sigs);
}

Result(LogState, SymbolonError) do_remove(LogState s, SignedEvent e, List(Int) dig, Int dev_sigs, List(Int) id) {
    if (!known_party(party_by_id(s.quorum.parties, id, 0))) { return refuse("removing an unknown party"); }
    if (has_bytes(s.removed, id, 0)) { return refuse("party already removed"); }
    return authority(s, e, dig, false, dev_sigs);
}

Result(LogState, SymbolonError) do_set_policy(LogState s, SignedEvent e, List(Int) dig, Int dev_sigs, Policy np) {
    if (!policy_ok(np, s.quorum)) { return refuse("policy below the SPEC 8.2 floor"); }
    if (witnesses_odd(s.policy.witnesses) && !witnesses_odd(np.witnesses)) { return refuse("set-policy to an even number of witnesses (SPEC 20.3)"); }
    if (dev_sigs == 0 && kit_signed(s, e)) { return kit_escape(s, e, dig, np); }
    return authority(s, e, dig, weakens(s.policy, np), dev_sigs);
}

// The kit's escape from its relay (SPEC 20.3): a set-policy signed by the
// kit alone that drops the sequencing relay and changes nothing else, with
// advisory time 0, so the kit can sign exactly one such event per sequence
// and cannot split a sequence with variants of it. Delayed like a recover
// (four times after two vetoes), one at a time with recovers, and vetoed
// as one: a relay that is gone or refuses every claim then stalls the log
// for the delay at most, and a principal who still has a device keeps the
// relay by vetoing.
Result(LogState, SymbolonError) kit_escape(LogState s, SignedEvent e, List(Int) dig, Policy np) {
    if (s.policy.sequencer.len() == 0 || np.sequencer.len() != 0 || !same_but_sequencer(s.policy, np)) {
        return refuse("the kit's set-policy may only drop the sequencing relay");
    }
    if ((Int)e.payload.advisory_time != 0) { return refuse("the kit's set-policy carries advisory time 0"); }
    if (recover_pending(s.pending, 0)) { return refuse("a recover (or the kit's set-policy) is already pending"); }
    Int mult = if (s.vetoes >= 2) { 4 } else { 1 };
    Pending p = Pending {
        .seq = e.payload.sequence, .ready_at = s.last_time + (Int)s.policy.recovery_delay_sec * mult,
        .body = e.payload.body, .event_digest = dig, .next_digests = e.payload.next_recovery_key_digests, .kit = true,
        .signers = [], .forced = true };
    return Ok(with_pending(s, s.pending.concat([p])));
}

// Signed by a kit of the quorum, not removed, whose key's digest is in
// field 6 (the kit that could file a recover now).
Bool kit_signed(LogState s, SignedEvent e) {
    List(Party) kits = kits_in(not_removed(s.quorum.parties, s.removed, 0, ListBuf()), s.recovery_digests, 0, []);
    return valid_signers(e.sigs, kits, false, e.encoded, 0, []).len() > 0;
}

List(Party) kits_in(List(Party) ps, List(List(Int)) digests, Int i, List(Party) acc) {
    if (i >= ps.len()) { return acc; }
    Bool k = ps[i].kind == party_kind_kit() && has_bytes(digests, sha256_bytes(ps[i].auth_key), 0);
    return kits_in(ps, digests, i + 1, if (k) { acc.concat([ps[i]]) } else { acc });
}

// Policies equal in every field but the sequencing relay (field 8).
Bool same_but_sequencer(Policy a, Policy b) {
    return a.device_sigs_for_authority == b.device_sigs_for_authority
        && a.recovery_delay_sec == b.recovery_delay_sec
        && digests_eq(a.guardians, b.guardians, 0)
        && a.guardian_threshold == b.guardian_threshold
        && same_refs(a.witnesses, b.witnesses, 0)
        && a.duress_window_sec == b.duress_window_sec
        && cosigner_policy_code(a.cosigner_policy) == cosigner_policy_code(b.cosigner_policy);
}

Bool same_refs(List(WitnessRef) a, List(WitnessRef) b, Int i) {
    if (a.len() != b.len()) { return false; }
    if (i >= a.len()) { return true; }
    return a[i].url == b[i].url && bytes_eq(a[i].key, b[i].key) && same_refs(a, b, i + 1);
}

// One number per cosigner policy (each limit is a UInt(32)).
Int cosigner_policy_code(CosignerPolicy p) {
    return match p {
        NoCosignerPolicy => -1,
        CosignerLimit(n) => (Int)n,
        CosignerLimits(l) => 4294967296 + (Int)l.sign * 4294967296 + (Int)l.eval
    };
}

Bool no_device_signed(LogState s, SignedEvent e) {
    return valid_signers(e.sigs, not_removed(s.quorum.parties, s.removed, 0, ListBuf()), true, e.encoded, 0, []).len() == 0;
}

// Signed by every device of the quorum that is not removed (and at least
// one): the principal's whole authority.
Bool all_devices_signed(LogState s, SignedEvent e) {
    List(Party) live = not_removed(s.quorum.parties, s.removed, 0, ListBuf());
    Int n = device_count(live, 0, 0);
    return n >= 1 && valid_signers(e.sigs, live, true, e.encoded, 0, []).len() >= n;
}

Result(LogState, SymbolonError) do_rotate(LogState s, SignedEvent e, List(Int) dig, Int dev_sigs) {
    if (e.payload.next_recovery_key_digests.len() < 1) { return refuse("rotate-recovery without digests"); }
    return authority(s, e, dig, false, dev_sigs);
}

// party-key (SPEC 8.1, 8.2): a device of the quorum, not removed, names a
// new share-transport (HPKE) key for itself, signed by its own
// authentication key. It takes effect at once: it changes where others
// wrap to this device, not who signs, recovers or holds a share, and
// whoever holds the device's DK and its profile already reads everything
// the old key opened.
Result(LogState, SymbolonError) do_party_key(LogState s, SignedEvent e, List(Int) id, List(Int) k) {
    Option(Party) op = party_by_id(s.quorum.parties, id, 0);
    Party p = op else { Party {.id = [], .kind = 0, .auth_key = [], .hpke_key = [], .label = "", .attestation = NoAttestation} };
    if (p.id.len() == 0 || p.kind != party_kind_device()) { return refuse("party-key for a party that is not a device of the quorum"); }
    if (has_bytes(s.removed, id, 0)) { return refuse("party-key for a removed party"); }
    if (!key_ok(k)) { return refuse("party-key with a bad key"); }
    if (bytes_eq(k, p.hpke_key)) { return refuse("party-key that changes nothing"); }
    if (!signed_by_key(e.sigs, p.auth_key, e.encoded, 0)) { return refuse("party-key not signed by that device"); }
    return Ok(apply_effect(s, e.payload.body, [], e.payload.next_recovery_key_digests));
}

List(Party) with_hpke(List(Party) ps, List(Int) id, List(Int) k, Int i, ListBuf(Party) acc) {
    if (i >= ps.len()) { return acc.finish(); }
    Party p = ps[i];
    Party q = if (bytes_eq(p.id, id)) { Party {.id = p.id, .kind = p.kind, .auth_key = p.auth_key, .hpke_key = k, .label = p.label, .attestation = p.attestation} } else { p };
    return with_hpke(ps, id, k, i + 1, acc.push(q));
}

Result(LogState, SymbolonError) do_reshare(LogState s, SignedEvent e, List(Int) dig, Quorum nq) {
    if (!quorum_ok(nq)) { return refuse("malformed quorum"); }
    if (!bytes_eq(nq.root_pubkey, s.quorum.root_pubkey)) { return refuse("reshare changed the root key"); }
    if (nq.epoch != s.quorum.epoch + 1) { return refuse("reshare epoch is not the next epoch"); }
    if (!kv_kept(s.quorum, nq)) { return refuse("reshare changed or dropped the vault OPRF key (C_0)"); }
    if (!reshare_parties_ok(s, nq.parties, 0)) { return refuse("reshare party set"); }
    // The rotated kit replaces the old one: no other kit stays beside it.
    if (brings_rotated_kit(s, nq.parties, 0) && kit_count(nq.parties, 0, 0) != 1) { return refuse("reshare keeps another kit beside the rotated one"); }
    List(Party) everyone = s.quorum.parties.concat(nq.parties);
    List(List(Int)) all_signers = valid_signers(e.sigs, everyone, false, e.encoded, 0, []);
    // At least t of the old quorum, and every party that took part (SPEC
    // 8.2): every new party but the offline ones, the kit and guardians,
    // whose material the online parties compute and wrap (SPEC 10.6).
    if (signers_in(all_signers, s.quorum.parties, 0, 0) < (Int)s.quorum.t) {
        return refuse("reshare signed by fewer than t of the old quorum");
    }
    List(Party) online = online_parties(nq.parties, 0, []);
    if (signers_in(all_signers, online, 0, 0) < online.len()) {
        return refuse("reshare not signed by every online new party");
    }
    return Ok(apply_effect(s, e.payload.body, dig, e.payload.next_recovery_key_digests));
}

// The kit's recovery key: one field 6 names, or (R4-5) the quorum's own
// kit party while a rotate-recovery is in force and the re-share to the
// new kit has not landed yet. The new kit has no material until that
// re-share, so without this neither kit could recover in the window, and
// losing the one device that holds DIR/kit-next there lost the identity.
// The old kit stays the quorum's kit until the re-share replaces it
// (rotated_kit); a recover by it ends the rotation (rotated_to []).
Bool kit_authorized(LogState s, SignedEvent e, List(List(Int)) next_digests, Option(List(Int)) revealed) {
    return match revealed {
        Some(k) => key_ok(k)
                   && (has_bytes(s.recovery_digests, sha256_bytes(k), 0) || old_kit_in_window(s, sha256_bytes(k)))
                   && !has_bytes(next_digests, sha256_bytes(k), 0)
                   && signed_by_key(e.sigs, k, e.encoded, 0),
        None => false
    };
}

// Whether `d` is the id of the quorum's kit party, not removed, while a
// rotate-recovery in force (rotated_to) names another kit: the old kit
// before the re-share (a re-share that brings the new kit keeps no other
// kit beside it, do_reshare).
Bool old_kit_in_window(LogState s, List(Int) d) {
    if (s.rotated_to.len() == 0 || has_bytes(s.rotated_to, d, 0) || has_bytes(s.removed, d, 0)) { return false; }
    Option(Party) op = party_by_id(s.quorum.parties, d, 0);
    return match op { None => false, Some(p) => p.kind == party_kind_kit() };
}

Bool guardians_authorized(SignedEvent e, RecoverBodyInner r, Bool closure(EventPayload) approvals_ok) {
    return !opt_present(r.revealed_recovery_key)
        && signed_by_any(e.sigs, r.new_parties, e.encoded, 0)
        && approvals_ok(e.payload);
}

Result(LogState, SymbolonError) do_recover(LogState s, SignedEvent e, List(Int) dig, RecoverBodyInner r, Bool closure(EventPayload) approvals_ok) {
    EventPayload ep = e.payload;
    if (r.new_parties.len() < 1 || r.new_parties.len() > 8) { return refuse("recover party count"); }
    if (!ids_distinct(r.new_parties, 0) || !parties_ok(r.new_parties, 0)) { return refuse("recover parties"); }
    if (device_count(r.new_parties, 0, 0) < 1) { return refuse("recover without a device"); }
    if (ep.next_recovery_key_digests.len() < 1) { return refuse("recover without new digests"); }
    // One recover at a time (SPEC 13.4): otherwise whoever holds the kit
    // could file a recover at every next sequence, as fast as each one is
    // witnessed, and no veto would ever get a sequence of its own.
    if (recover_pending(s.pending, 0)) { return refuse("a recover (or the kit's set-policy) is already pending"); }
    Bool authorized = if (r.path == recover_path_kit()) {
        kit_authorized(s, e, ep.next_recovery_key_digests, r.revealed_recovery_key)
    } else {
        r.path == recover_path_guardians() && guardians_authorized(e, r, approvals_ok)
    };
    if (!authorized) { return refuse("recover not authorized"); }
    Int mult = if (s.vetoes >= 2) { 4 } else { 1 };
    Pending p = Pending {
        .seq = ep.sequence,
        .ready_at = s.last_time + (Int)s.policy.recovery_delay_sec * mult,
        .body = ep.body, .event_digest = dig, .next_digests = ep.next_recovery_key_digests, .kit = true,
        .signers = [], .forced = true };
    return Ok(with_pending(s, s.pending.concat([p])));
}

Result(LogState, SymbolonError) do_veto_found(LogState s, Int dev_sigs, UInt(64) target, Pending p) {
    // A contested recovery needs two devices to veto again (13.4).
    Bool kitev = is_recover_body(p.body) || p.kit;
    Int need = if (kitev && s.vetoes >= 2) { 2 } else { 1 };
    if (dev_sigs < need) { return refuse("veto without enough device signatures"); }
    LogState removed_p = with_pending(s, pending_without(s.pending, target, 0, ListBuf()));
    return Ok(if (kitev) { with_vetoes(removed_p, s.vetoes + 1) } else { removed_p });
}

Result(LogState, SymbolonError) do_veto(LogState s, Int dev_sigs, UInt(64) target) {
    Option(Pending) found = pending_by_seq(s.pending, target, 0);
    return match found {
        None => refuse("veto of an event that is not pending"),
        Some(p) => do_veto_found(s, dev_sigs, target, p)
    };
}

// confirm (SPEC 8.2): further devices of the household sign for the
// pending authority event at `target`, whose digest is `tdig`, and it
// takes effect at once, without waiting out its delay. Its own event at a
// sequence of its own (signatures sit outside an event's digest, but an
// event already witnessed and stored cannot take another one that counts:
// a verifier could not tell when it was added, so an attacker holding the
// event could add one later or a relay drop it), so its log id, sequence
// and predecessor bind it to this log at this point, and `tdig` to the one
// event it confirms.
//
// It counts the distinct devices among the pending event's own signers and
// the confirm's signers that may sign now: devices of the quorum in force,
// not removed, and not named by a remove-party still pending (a device
// being removed, perhaps the stolen one, cannot help make anything
// immediate meanwhile). Proposed parties are not in the quorum and never
// count. A signer of the pending event counts once, whoever signs again;
// the confirm must carry at least one device that did not sign the
// pending event; and the count must reach the signatures an authority
// event needs now (authority_sigs, at the confirm's witness time), or the
// confirm is refused: confirms do not accumulate.
//
// Never for what the kit or guardians filed (a recover, the kit's escape
// set-policy: those have their own rules, SPEC 13.4 and 20.3; a device
// that agrees simply lets the delay run) nor for a set-policy that weakens
// the policy, which is delayed whatever its signatures. The veto window
// orders itself by sequence: a vetoed event is no longer pending, so a
// later confirm of it is refused, and a confirmed event has taken effect,
// so a later veto of it is refused. The contest counter (vetoes) is not
// touched.
Result(LogState, SymbolonError) do_confirm(LogState s, SignedEvent e, UInt(64) target, List(Int) tdig) {
    Option(Pending) found = pending_by_seq(s.pending, target, 0);
    return match found {
        None => refuse("confirm of an event that is not pending"),
        Some(p) => do_confirm_found(s, e, target, tdig, p)
    };
}

Result(LogState, SymbolonError) do_confirm_found(LogState s, SignedEvent e, UInt(64) target, List(Int) tdig, Pending p) {
    if (!bytes_eq(p.event_digest, tdig)) { return refuse("confirm names another digest than the pending event's"); }
    if (p.kit || is_recover_body(p.body)) { return refuse("a recover or the kit's set-policy cannot be confirmed"); }
    if (p.forced) { return refuse("a set-policy that weakens the policy cannot be confirmed: it is always delayed"); }
    List(Party) live = not_removed(s.quorum.parties, s.removed, 0, ListBuf());
    List(Party) able = not_removed(live, pending_removals(s.pending, 0, []), 0, ListBuf());
    List(List(Int)) by = valid_signers(e.sigs, able, true, e.encoded, 0, []);
    List(List(Int)) orig = ids_among(p.signers, able, 0, []);
    Int fresh = keys_not_in(by, orig, 0, []);
    if (fresh < 1) { return refuse("confirm without a device that did not sign the pending event"); }
    Int need = authority_sigs(s.policy, live, s.last_time);
    if (orig.len() + fresh < need) { return refuse("confirm: fewer devices than an authority event needs"); }
    LogState rest = with_pending(s, pending_without(s.pending, target, 0, ListBuf()));
    return Ok(apply_effect(rest, p.body, p.event_digest, p.next_digests));
}

// The party ids a pending remove-party names.
List(List(Int)) pending_removals(List(Pending) ps, Int i, List(List(Int)) acc) {
    if (i >= ps.len()) { return acc; }
    EventBody b = ps[i].body;
    return pending_removals(ps, i + 1, match b { RemovePartyBody(id) => acc.concat([id]), _ => acc });
}

// The ids of `ids` that name a party of `ps`.
List(List(Int)) ids_among(List(List(Int)) ids, List(Party) ps, Int i, List(List(Int)) acc) {
    if (i >= ids.len()) { return acc; }
    return ids_among(ids, ps, i + 1, if (known_party(party_by_id(ps, ids[i], 0))) { acc.concat([ids[i]]) } else { acc });
}

Result(LogState, SymbolonError) apply_body(LogState s, SignedEvent e, List(Int) dig, Bool closure(EventPayload) approvals_ok) {
    EventBody body = e.payload.body;
    // Device signatures of the quorum's parties that are not removed: a
    // removed device no longer authorizes, vetoes or delays (R2W-6).
    Int dev_sigs = valid_signers(e.sigs, not_removed(s.quorum.parties, s.removed, 0, ListBuf()), true, e.encoded, 0, []).len();
    return match body {
        InceptionBody(_, _) => refuse("inception only as event 0"),
        ProposePartyBody(party, _) => do_propose(s, e, dig, dev_sigs, party),
        RemovePartyBody(id) => do_remove(s, e, dig, dev_sigs, id),
        SetPolicyBody(np) => do_set_policy(s, e, dig, dev_sigs, np),
        RotateRecoveryBody => do_rotate(s, e, dig, dev_sigs),
        MigrateBody(_) => refuse("unsupported suite"),
        ReshareBody(nq) => do_reshare(s, e, dig, nq),
        RecoverBody(r) => do_recover(s, e, dig, r, approvals_ok),
        VetoBody(target) => do_veto(s, dev_sigs, target),
        PartyKeyBody(id, k) => do_party_key(s, e, id, k),
        ConfirmBody(target, tdig) => do_confirm(s, e, target, tdig)
    };
}

// Digests in field 6 must not change except through rotate-recovery or recover.
Bool field6_stable(LogState s, EventPayload ep) {
    EventBody body = ep.body;
    return match body {
        RotateRecoveryBody => true,
        RecoverBody(_) => true,
        _ => digests_eq(s.recovery_digests, ep.next_recovery_key_digests, 0)
    };
}

Bool digests_eq(List(List(Int)) a, List(List(Int)) b, Int i) {
    if (a.len() != b.len()) { return false; }
    if (i >= a.len()) { return true; }
    if (!bytes_eq(a[i], b[i])) { return false; }
    return digests_eq(a, b, i + 1);
}

Result(LogState, SymbolonError) step(LogState s, SignedEvent e, List(Int) l, Bool closure(EventPayload) approvals_ok) {
    Int t = witness_time(e.cosigs, s.policy, l, e.payload.sequence, sha256_bytes(e.encoded))?;
    return step_at(s, e, l, t, approvals_ok);
}

// One event at witness time `t`: every check of `step` but the event's own
// co-signatures.
Result(LogState, SymbolonError) step_at(LogState s, SignedEvent e, List(Int) l, Int t, Bool closure(EventPayload) approvals_ok) {
    EventPayload ep = e.payload;
    List(Int) dig = sha256_bytes(e.encoded);
    if (t < s.last_time) { return refuse("witness time went backwards"); }
    LogState settled = settle(s, t);
    if (ep.sequence != settled.next_seq) { return refuse("sequence"); }
    if (ep.suite != 1) { return refuse("suite"); }
    if (!opt_bytes_is(ep.log_id, l)) { return refuse("log id"); }
    if (!opt_bytes_is(ep.predecessor_digest, settled.prev_digest)) { return refuse("predecessor digest"); }
    if (!field6_stable(settled, ep)) { return refuse("recovery-key digests changed without rotate or recover"); }
    if (e.sigs.len() > sigs_max(settled, ep.body)) { return refuse("more signatures than parties that could sign"); }
    // Delays run from this event's own witness time (A-07).
    LogState applied = apply_body(with_time(settled, t), e, dig, approvals_ok)?;
    return Ok(advance(applied, dig, t, e.cosigs));
}

// ============================================================================
// Whole log
// ============================================================================

Result(LogState, SymbolonError) start(SignedEvent e0, List(Int) l) { return start_at(e0, l, false, 0); }

// E0 with its co-signatures (`pre` false), or before it has any (`pre`
// true: a witness deciding whether to co-sign it at its time `now`).
Result(LogState, SymbolonError) start_at(SignedEvent e0, List(Int) l, Bool pre, Int now) {
    EventPayload ep = e0.payload;
    List(Int) dig = sha256_bytes(e0.encoded);
    if (!bytes_eq(dig, l)) { return refuse("H(E0) is not the log id"); }
    if (ep.sequence != 0 || ep.suite != 1) { return refuse("E0 sequence or suite"); }
    if (opt_present(ep.log_id) || opt_present(ep.predecessor_digest)) { return refuse("E0 carries a log id or predecessor"); }
    if (ep.next_recovery_key_digests.len() < 1) { return refuse("E0 without recovery digests"); }
    EventBody e0_body = ep.body;
    return match e0_body {
        InceptionBody(q, pol) => start_inception(e0, l, dig, q, pol, pre, now),
        _ => refuse("E0 is not an inception")
    };
}

Result(LogState, SymbolonError) start_inception(SignedEvent e0, List(Int) l, List(Int) dig, Quorum q, Policy pol, Bool pre, Int now) {
    EventPayload ep = e0.payload;
    if (!quorum_ok(q) || !policy_ok(pol, q)) { return refuse("E0 quorum or policy"); }
    Result(Int, SymbolonError) wt = if (pre) { Ok(now) } else { witness_time(e0.cosigs, pol, l, 0, dig) };
    Int t = wt?;
    // E0 is signed by every party of its own quorum.
    if (e0.sigs.len() > q.parties.len() + 1) { return refuse("more signatures than parties that could sign"); }
    List(List(Int)) signers = valid_signers(e0.sigs, q.parties, false, e0.encoded, 0, []);
    if (signers.len() < q.parties.len()) { return refuse("E0 not signed by every party"); }
    return Ok(LogState {
        .quorum = q, .policy = pol, .recovery_digests = ep.next_recovery_key_digests,
        .proposed = [], .removed = [], .pending = [], .vetoes = 0,
        .prev_digest = dig, .next_seq = 1, .last_time = t, .last_cosigs = e0.cosigs, .rotated_to = [] });
}

Result(LogState, SymbolonError) run(LogState s, List(SignedEvent) events, List(Int) l, Bool closure(EventPayload) approvals_ok, Int i) {
    if (i >= events.len()) { return Ok(s); }
    LogState next = step(s, events[i], l, approvals_ok)?;
    return run(next, events, l, approvals_ok, i + 1);
}

// SPEC 8.3. `now` is a witness time at or after the last event's: events
// pending at the head whose delay has run by `now` are applied, the rest are
// reported in `pending`. `approvals_ok` checks a guardian recovery's
// approvals against the guardians' own logs (SPEC 13.3).
pub Result(VerifiedHead, SymbolonError) il_verify(List(Int) l, List(SignedEvent) events, Int now, Bool closure(EventPayload) approvals_ok) {
    if (events.len() < 1) { return Err(ErrInvalidLog("empty log")); }
    LogState s0 = start(events[0], l)?;
    LogState s1 = run(s0, events, l, approvals_ok, 1)?;
    if (now < s1.last_time) { return Err(ErrInvalidLog("now precedes the last event")); }
    LogState fin = settle(s1, now);
    return Ok(VerifiedHead {
        .head = LogHead {
            .log_id = l, .sequence = fin.next_seq - 1, .digest = fin.prev_digest,
            .quorum = fin.quorum, .policy = fin.policy },
        .witness_cosigs = fin.last_cosigs,
        .pending = pending_seqs(fin.pending, 0, ListBuf()) });
}

// SPEC 20.3: what a witness checks before it co-signs `e` as the next event
// of log `l`, at its own time `now`. `before` is the whole log before `e`,
// from E0, with its co-signatures, and must verify (il_verify's checks);
// `e`, which has no co-signatures yet, must then pass every other check of
// the next step at witness time `now` (no earlier than the last event's):
// sequence, predecessor, log id, suite, field 6 and the signing rule in
// force, after settling what is pending by `now` (so a veto once the delay
// has run is refused). With `before` empty, `e` must be an inception whose
// digest is `l`, signed by every party of its quorum. Ok(the witness time
// `e` was checked at: `now`, or the last event's time when `now` is
// earlier) or the refusal. A witness signs that time, never an earlier
// one: a co-signature with a time before the last event's would be refused
// by every agent ("witness time went backwards") while the witness holds
// the sequence (R2W-3).
pub Result(Int, SymbolonError) il_check_next(List(Int) l, List(SignedEvent) before, SignedEvent e, Int now, Bool closure(EventPayload) approvals_ok) {
    NextOk n = il_next(l, before, e, now, approvals_ok)?;
    return Ok(n.time);
}

// il_check_next's answer with the sequencing relay (policy[8]) whose claim
// the event needs (SPEC 20.3): the one the policy names after event n-1,
// as the log stands at that event's own witness time (so every witness
// and the relay read the same one, whatever their clocks; a delayed change
// of relay applies from the event after the first one witnessed once its
// delay has run). None at sequence 0. `witnesses`: those whose
// co-signatures the event needs (the same policy's). `claimless`: whether
// a witness may co-sign it without that relay's claim (il_claimless).
pub type NextOk = { Int time; List(WitnessRef) sequencer; List(WitnessRef) witnesses; Bool claimless; };

pub Result(NextOk, SymbolonError) il_next(List(Int) l, List(SignedEvent) before, SignedEvent e, Int now, Bool closure(EventPayload) approvals_ok) {
    if (before.len() == 0) {
        LogState s = start_at(e, l, true, now)?;
        return Ok(NextOk {.time = now, .sequencer = [], .witnesses = [], .claimless = false});
    }
    LogState s0 = start(before[0], l)?;
    LogState s1 = run(s0, before, l, approvals_ok, 1)?;
    Int t = if (now > s1.last_time) { now } else { s1.last_time };
    LogState s2 = step_at(s1, e, l, t, approvals_ok)?;
    LogState st = settle(s1, t);
    return Ok(NextOk {.time = t, .sequencer = s1.policy.sequencer, .witnesses = s1.policy.witnesses, .claimless = il_claimless(st, e)});
}

// The relay as sequencer has an escape (SPEC 20.3, R3P-3): the events a
// witness co-signs at sequence n without the relay's claim, when it holds
// nothing at n yet. `st` is the log before the event settled at the
// witness time it is checked at, and the event already passed every check
// of that step. They are what a relay that refuses claims (working with
// whoever holds the kit, or gone) must not be able to hold back:
//   - a device's veto of the pending event the kit filed (a recover or the
//     kit's escape set-policy), with advisory time 0: one event per
//     sequence whoever of the devices signs it (signatures are not in the
//     digest), so devices vetoing at once never split a sequence;
//   - a set-policy that changes or drops the sequencing relay and nothing
//     else, signed by every device of the quorum not removed, while
//     nothing the kit filed is pending;
//   - the kit's escape set-policy (kit_escape), one event per sequence;
//   - any event once a delayed set-policy that dropped the relay has taken
//     effect by the witness's time (the policy before the event, read at
//     the previous event's time, still names it).
// At most one claimless event of the first three kinds can exist at a
// sequence for a given log before it but the second (whose content the
// holders of every device choose together), so a sequence can be split
// only between that event and one the relay claimed: with an odd number
// of witnesses one of the two always gets its majority once every witness
// has answered (SPEC 20.4).
Bool il_claimless(LogState st, SignedEvent e) {
    if (st.policy.sequencer.len() == 0) { return true; }
    EventBody b = e.payload.body;
    Option(Pending) kp = kit_pending(st.pending, 0);
    return match b {
        VetoBody(target) => (Int)e.payload.advisory_time == 0 && match kp { None => false, Some(k) => k.seq == target },
        SetPolicyBody(np) => same_but_sequencer(st.policy, np) && !same_refs(st.policy.sequencer, np.sequencer, 0)
                             && match kp { Some(_) => false, None => all_devices_signed(st, e) || (np.sequencer.len() == 0 && no_device_signed(st, e) && kit_signed(st, e)) },
        _ => false
    };
}

// Whether event `e`, which the sequencing relay claimed as the next event
// of `before`, can no longer be co-signed by any witness: invalid at
// witness time `now` and at every later time the log's state changes (each
// pending event's ready time), so a witness with a slower clock refuses it
// as well once its clock passes `now`. The relay's claim on it may then
// lapse (R3P-6).
pub Bool il_lapsed(List(Int) l, List(SignedEvent) before, SignedEvent e, Int now) {
    if (before.len() == 0) { return false; }
    Result(LogState, SymbolonError) s0 = start(before[0], l);
    return match s0 {
        Err(_) => false,
        Ok(a) => match run(a, before, l, lambda(x) { false }, 1) {
            Err(_) => false,
            Ok(s1) => invalid_at(s1, e, l, now) && invalid_after(s1, e, l, now, s1.pending, 0)
        }
    };
}

Bool invalid_at(LogState s1, SignedEvent e, List(Int) l, Int now) {
    Int t = if (now > s1.last_time) { now } else { s1.last_time };
    return match step_at(s1, e, l, t, lambda(x) { false }) { Ok(_) => false, Err(_) => true };
}

Bool invalid_after(LogState s1, SignedEvent e, List(Int) l, Int now, List(Pending) ps, Int i) {
    if (i >= ps.len()) { return true; }
    Bool here = ps[i].ready_at <= now || invalid_at(s1, e, l, ps[i].ready_at);
    return here && invalid_after(s1, e, l, now, ps, i + 1);
}

// The witness time by which everything pending at the end of `before`
// has taken effect (its last event's time when nothing is pending); -1
// when it does not verify. The relay checks an event offline at the last
// event's time and at this one before it asks any witness (R3P-4).
pub Int il_settled_time(List(Int) l, List(SignedEvent) before) {
    if (before.len() == 0) { return -1; }
    Result(LogState, SymbolonError) s0 = start(before[0], l);
    return match s0 {
        Err(_) => -1,
        Ok(a) => match run(a, before, l, lambda(x) { false }, 1) { Err(_) => -1, Ok(s1) => latest_ready(s1.pending, 0, s1.last_time) }
    };
}

Int latest_ready(List(Pending) ps, Int i, Int best) {
    if (i >= ps.len()) { return best; }
    return latest_ready(ps, i + 1, if (ps[i].ready_at > best) { ps[i].ready_at } else { best });
}

// The sequencing relay named by the policy of the verified log `before`
// (as il_next reads it for the event after it); [] when it names none or
// does not verify.
pub List(WitnessRef) il_sequencer(List(Int) l, List(SignedEvent) before) {
    if (before.len() == 0) { return []; }
    return match start(before[0], l) {
        Err(_) => [],
        Ok(a) => match run(a, before, l, lambda(x) { false }, 1) { Err(_) => [], Ok(s1) => s1.policy.sequencer }
    };
}

// The witnesses whose co-signatures the event after the verified log
// `before` needs (as il_next reads them); [] when it does not verify.
pub List(WitnessRef) il_witnesses(List(Int) l, List(SignedEvent) before) {
    if (before.len() == 0) { return []; }
    return match start(before[0], l) {
        Err(_) => [],
        Ok(a) => match run(a, before, l, lambda(x) { false }, 1) { Err(_) => [], Ok(s1) => s1.policy.witnesses }
    };
}

// The parties proposed and not yet re-shared in, as il_verify's state holds
// them at `now`: vetoed proposals and those cleared by a re-share or a
// settled recovery are gone, and pending ones are not yet there. [] when the
// log does not verify.
pub List(Party) il_proposed(List(Int) l, List(SignedEvent) events, Int now, Bool closure(EventPayload) approvals_ok) {
    if (events.len() < 1) { return []; }
    Result(LogState, SymbolonError) s0 = start(events[0], l);
    return match s0 {
        Err(_) => [],
        Ok(a) => match run(a, events, l, approvals_ok, 1) {
            Err(_) => [],
            Ok(s1) => if (now < s1.last_time) { [] } else { settle(s1, now).proposed }
        }
    };
}

// The membership changes in force at `now` and not yet re-shared: the
// parties proposed and the parties removed, as il_proposed reads them, and
// the field-6 digests of the latest rotate-recovery in force ([] when none,
// or a recovery came after it): a kit party with one of those ids may
// replace the quorum's kit (SPEC 13.2). None when the log does not verify.
pub type Membership = { List(Party) proposed; List(List(Int)) removed; List(List(Int)) rotated_to; };

pub Option(Membership) il_membership(List(Int) l, List(SignedEvent) events, Int now, Bool closure(EventPayload) approvals_ok) {
    if (events.len() < 1) { return None; }
    Result(LogState, SymbolonError) s0 = start(events[0], l);
    return match s0 {
        Err(_) => None,
        Ok(a) => match run(a, events, l, approvals_ok, 1) {
            Err(_) => None,
            Ok(s1) => if (now < s1.last_time) { None } else { membership_of(settle(s1, now)) }
        }
    };
}

Option(Membership) membership_of(LogState s) { return Some(Membership {.proposed = s.proposed, .removed = s.removed, .rotated_to = s.rotated_to}); }

// The events pending at `now` (no earlier than the last event's time) of
// a verified log, oldest first: sequence, the witness time it takes effect
// at, its digest, and whether devices may confirm it (do_confirm: not
// what the kit or guardians filed, not a weakening set-policy). [] when
// the log does not verify.
pub type PendingEvent = { UInt(64) seq; Int ready_at; List(Int) digest; Bool confirmable; };

pub List(PendingEvent) il_pending_events(List(Int) l, List(SignedEvent) events, Int now, Bool closure(EventPayload) approvals_ok) {
    if (events.len() < 1) { return []; }
    Result(LogState, SymbolonError) s0 = start(events[0], l);
    return match s0 {
        Err(_) => [],
        Ok(a) => match run(a, events, l, approvals_ok, 1) {
            Err(_) => [],
            Ok(s1) => pending_events(settle(s1, if (now < s1.last_time) { s1.last_time } else { now }).pending, 0, ListBuf())
        }
    };
}

List(PendingEvent) pending_events(List(Pending) ps, Int i, ListBuf(PendingEvent) acc) {
    if (i >= ps.len()) { return acc.finish(); }
    Pending p = ps[i];
    Bool c = !p.kit && !p.forced && !is_recover_body(p.body);
    return pending_events(ps, i + 1, acc.push(PendingEvent {.seq = p.seq, .ready_at = p.ready_at, .digest = p.event_digest, .confirmable = c}));
}

List(UInt(64)) pending_seqs(List(Pending) ps, Int i, ListBuf(UInt(64)) acc) {
    if (i >= ps.len()) { return acc.finish(); }
    return pending_seqs(ps, i + 1, acc.push(ps[i].seq));
}

// SPEC 8.4 / 20.4: two heads of one log at one sequence with different
// digests are a fork; a lower sequence than one already seen is a rollback.
pub Bool is_fork(LogHead a, LogHead b) {
    return bytes_eq(a.log_id, b.log_id) && a.sequence == b.sequence && !bytes_eq(a.digest, b.digest);
}

pub Bool is_rollback(LogHead seen, LogHead offered) {
    return bytes_eq(seen.log_id, offered.log_id) && offered.sequence < seen.sequence;
}
