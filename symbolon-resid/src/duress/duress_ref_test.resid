@requires(declassify, provision)
test "the duress profile has the subset's tweaks and nothing else" {
    DuressFull d = duress();
    Str inside = match subset_tweak(d, [58, 199, 184, 58, 119, 126, 201, 170, 239, 96, 47, 41, 98, 17, 123, 67, 116, 134, 79, 223, 41, 62, 7, 117, 10, 177, 201, 209, 178, 58, 76, 226], 0) { Some(t) => sh(t), None => "none" };
    Str outside = match subset_tweak(d, [76, 74, 21, 222, 101, 121, 176, 52, 172, 135, 94, 212, 109, 117, 74, 232, 26, 13, 173, 138, 111, 70, 166, 215, 218, 188, 230, 247, 224, 136, 181, 240], 0) { Some(t) => sh(t), None => "none" };
    expect(inside).toEqual("c477dd529fbf60a41950dfc338493202c62e690dbe638c4cc529741ca6d86789");
    expect(outside).toEqual("none");
}

