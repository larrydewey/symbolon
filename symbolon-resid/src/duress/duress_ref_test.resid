// Unlock and duress (src/duress/duress.resid) against values made by an
// independent implementation (tests/gen_duress_ref.py). Generated; do not
// edit by hand.

import "../types.resid";
import "duress.resid";
import "crypto.resid";
import "word.resid";
import "hpkeg.resid";
import "hpke.resid";

Str hx(List(Int) b) { return hex_encode(b); }

@requires(declassify)
Str sh(List(Secret(UInt(8))) b) { return hx(ints(declassify(secret_join(b), "test output"), 0, [])); }

List(Int) ints(List(UInt(8)) bs, Int i, List(Int) acc) {
    if (i >= bs.len()) { return acc; }
    return ints(bs, i + 1, acc.concat([(Int)bs[i]]));
}

@requires(declassify, provision)
test "pin stretch is Argon2id (OpenSSL's) and the unlock key HKDF over it" {
    expect(sh(pin_stretch(secret_bytes(rt [50, 52, 54, 56, 49, 48]), [165, 4, 135, 79, 102, 134, 44, 102, 28, 99, 12, 187, 234, 66, 178, 85], 64, 2))).toEqual("85edaf24eab6d56f4346e41c591332d3de1b6f42bae3673fb89363e844b36724");
    expect(sh(unlock_key(secret_bytes(rt [18, 178, 15, 198, 97, 76, 164, 223, 228, 49, 10, 127, 75, 79, 126, 181, 152, 8, 128, 179, 106, 201, 14, 35, 49, 127, 50, 151, 71, 212, 244, 252]), [165, 4, 135, 79, 102, 134, 44, 102, 28, 99, 12, 187, 234, 66, 178, 85]))).toEqual("f85af61ec54a288f1f95db609972d14203581c2b75aa5095e40dafdc6a8e715b");
}

RealProfile real() {
    return RealProfile { .share = secret_bytes(rt [239, 217, 132, 159, 192, 163, 248, 252, 3, 208, 110, 232, 155, 148, 6, 25, 216, 217, 32, 165, 127, 174, 77, 228, 176, 244, 25, 147, 195, 52, 145, 157]), .cc = secret_bytes(rt [158, 11, 137, 193, 164, 209, 129, 186, 53, 230, 240, 38, 130, 254, 83, 246, 223, 202, 93, 229, 255, 230, 65, 65, 31, 39, 231, 121, 74, 86, 97, 232]), .vault_key = secret_bytes(rt [7, 185, 73, 5, 246, 71, 66, 79, 4, 245, 2, 14, 28, 189, 204, 55, 139, 134, 167, 9, 131, 185, 142, 96, 230, 149, 32, 30, 146, 197, 150, 27]), .dek = secret_bytes(rt [132, 117, 173, 145, 221, 164, 156, 105, 170, 251, 34, 135, 122, 233, 108, 203, 164, 56, 149, 226, 153, 248, 219, 129, 140, 33, 83, 143, 200, 44, 0, 98]), .duress_hpke_pub = [4, 79, 37, 213, 62, 144, 209, 211, 115, 227, 179, 48, 207, 220, 91, 234, 104, 239, 197, 145, 207, 109, 100, 28, 236, 186, 153, 60, 169, 198, 204, 160, 115, 87, 47, 172, 55, 170, 245, 0, 95, 81, 244, 98, 94, 1, 117, 230, 194, 173, 220, 122, 206, 51, 221, 30, 128, 1, 137, 255, 45, 208, 131, 92, 72] };
}

DuressFull duress() {
    return DuressFull { .share = secret_bytes(rt [239, 217, 132, 159, 192, 163, 248, 252, 3, 208, 110, 232, 155, 148, 6, 25, 216, 217, 32, 165, 127, 174, 77, 228, 176, 244, 25, 147, 195, 52, 145, 157]), .subkey = secret_bytes(rt [46, 122, 57, 215, 46, 68, 84, 98, 93, 113, 35, 100, 250, 179, 108, 247, 23, 94, 198, 31, 206, 198, 116, 140, 125, 116, 234, 245, 153, 50, 102, 170]), .vault_key = secret_bytes(rt [102, 87, 125, 84, 149, 90, 167, 224, 217, 184, 251, 37, 20, 90, 85, 138, 166, 173, 188, 152, 87, 157, 144, 18, 130, 3, 140, 141, 41, 219, 227, 101]), .hpke_priv = secret_bytes(rt [15, 8, 183, 97, 28, 243, 228, 243, 0, 88, 229, 215, 118, 39, 229, 189, 16, 166, 110, 37, 52, 46, 4, 41, 54, 103, 154, 194, 79, 126, 187, 59]), .tweaks = [SubsetTweak { .cid = [246, 67, 124, 11, 72, 94, 138, 217, 127, 33, 43, 155, 105, 236, 37, 48, 85, 40, 182, 85, 184, 148, 185, 59, 230, 83, 162, 251, 46, 18, 33, 26], .tau = secret_bytes(rt [112, 193, 13, 77, 19, 38, 96, 114, 186, 92, 176, 135, 201, 71, 146, 99, 193, 219, 93, 77, 226, 210, 87, 155, 164, 9, 226, 186, 234, 211, 34, 17]) }, SubsetTweak { .cid = [207, 164, 128, 114, 138, 179, 38, 208, 119, 35, 30, 16, 120, 112, 12, 73, 101, 208, 78, 52, 34, 224, 64, 116, 234, 79, 5, 128, 205, 204, 169, 239], .tau = secret_bytes(rt [172, 142, 229, 90, 168, 113, 234, 83, 214, 124, 147, 17, 125, 184, 181, 32, 59, 206, 154, 126, 207, 181, 112, 253, 19, 241, 146, 149, 248, 180, 75, 36]) }, SubsetTweak { .cid = [58, 199, 184, 58, 119, 126, 201, 170, 239, 96, 47, 41, 98, 17, 123, 67, 116, 134, 79, 223, 41, 62, 7, 117, 10, 177, 201, 209, 178, 58, 76, 226], .tau = secret_bytes(rt [196, 119, 221, 82, 159, 191, 96, 164, 25, 80, 223, 195, 56, 73, 50, 2, 198, 46, 105, 13, 190, 99, 140, 76, 197, 41, 116, 28, 166, 216, 103, 137]) }] };
}

@requires(declassify, provision)
test "profile layouts and sealed blobs equal the reference (AES-256-GCM)" {
    List(Secret(UInt(8))) rp = encode_real(real()) else { [] };
    List(Secret(UInt(8))) dp = encode_duress(duress()) else { [] };
    expect(sh(rp)).toEqual("");
    expect(sh(dp)).toEqual("");
    expect(hx(seal_blob(secret_bytes(rt [248, 90, 246, 30, 197, 74, 40, 143, 31, 149, 219, 96, 153, 114, 209, 66, 3, 88, 28, 43, 117, 170, 80, 149, 228, 13, 175, 220, 106, 142, 113, 91]), [50, 92, 201, 78, 115, 45, 79, 24, 223, 108, 36, 189], rp))).toEqual("");
    expect(hx(seal_blob(secret_bytes(rt [255, 134, 230, 202, 175, 66, 85, 212, 31, 217, 181, 45, 59, 78, 100, 90, 161, 54, 85, 245, 108, 89, 254, 64, 150, 255, 124, 93, 69, 32, 44, 8]), [112, 245, 88, 233, 181, 253, 115, 95, 33, 143, 254, 138], dp))).toEqual("");
}

@requires(declassify, provision)
test "every blob has one length, real, duress or random" {
    expect(4124).toEqual(blob_len());
    expect(4124).toEqual(blob_len());
    expect(4124).toEqual(blob_len());
}

