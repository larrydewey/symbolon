    Str by_real = match open_slot(secret_bytes(rt [248, 90, 246, 30, 197, 74, 40, 143, 31, 149, 219, 96, 153, 114, 209, 66, 3, 88, 28, 43, 117, 170, 80, 149, 228, 13, 175, 220, 106, 142, 113, 91]), 6, slot) { Some(x) => sh(x.subkey), None => "none" };
    expect(read).toEqual("2e7a39d72e4454625d712364fab36cf7175ec61fcec6748c7d74eaf5993266aa");
    expect(stale).toEqual("none");
    expect(by_real).toEqual("none");
}

@requires(declassify, provision)
test "malformed profiles are refused" {
    RealProfile r = RealProfile { .share = secret_bytes(rt [239, 217, 132, 159, 192, 163, 248, 252, 3, 208, 110, 232, 155, 148, 6, 25, 216, 217, 32, 165, 127, 174, 77, 228, 176, 244, 25, 147, 195, 52, 145, 157]), .cc = secret_bytes(rt [158, 11, 137, 193, 164, 209, 129, 186, 53, 230, 240, 38, 130, 254, 83, 246, 223, 202, 93, 229, 255, 230, 65, 65, 31, 39, 231, 121, 74, 86, 97, 232]), .vault_key = secret_bytes(rt [7, 185, 73, 5, 246, 71, 66, 79, 4, 245, 2, 14, 28, 189, 204, 55, 139, 134, 167, 9, 131, 185, 142, 96, 230, 149, 32, 30, 146, 197, 150, 27]), .dek = secret_bytes(rt [132, 117, 173, 145, 221, 164, 156, 105, 170, 251, 34, 135, 122, 233, 108, 203, 164, 56, 149, 226, 153, 248, 219, 129, 140, 33, 83, 143, 200, 44, 0, 98]), .duress_hpke_pub = [4, 1] };
    Bool refused = match encode_real(r) { Some(_) => false, None => true };
    expect(refused).toBeTrue();
}
