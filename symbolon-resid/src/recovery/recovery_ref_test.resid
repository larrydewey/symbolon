test "the kit's keys from its seed equal the reference (HKDF; RFC 9180 DeriveKeyPair)" {
    KitKeys k = kit_keys([114, 43, 235, 11, 69, 153, 11, 5, 248, 193, 248, 152, 80, 173, 90, 58, 51, 190, 20, 161, 156, 45, 23, 98, 42, 44, 129, 152, 45, 54, 173, 65]) else { KitKeys { .sign_priv = [], .sign_pub = [], .hpke_priv = [], .hpke_pub = [] } };
    expect(hx(k.sign_priv)).toEqual("945b7fc46704f3f0d6fccaade51943527abd0f926e4847bc56c390504e9ba765");
    expect(hx(k.sign_pub)).toEqual("0431ff55a3e99d8aa5e03f84cc9bb247f1d00c2613090ef9278ef067c473aee7b00eb6056470491cae613dc826bbca8bc22926c6f41f13e8ecf455f36f855878bd");
    expect(hx(k.hpke_priv)).toEqual("4e57dbd3a5fe945dad9026b486d235109e10c8ea9943855473fcb79b7b808770");
    expect(hx(k.hpke_pub)).toEqual("042e5bcd94217a6a6ad915fb5e58fe1d96407d22d9bfa1637b489b0ad24dc05ff4673f62ad60d37ac28b803190614339e9d1fc216bd56310075f68166b9764eff5");
    expect(hx(recovery_key_digest(k.sign_pub))).toEqual("82848b8bef1bd777cfeb701c76ac1120c7c6b00af02115997d1a9ba3f36a4c32");
}

