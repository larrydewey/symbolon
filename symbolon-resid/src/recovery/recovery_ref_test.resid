Str quorum_names(Result(VerifiedHead, SymbolonError) r) {
    return match r { Ok(v) => names(v.head.quorum.parties, 0, ""), Err(e) => "error" };
}

Str names(List(Party) ps, Int i, Str acc) {
    if (i >= ps.len()) { return acc; }
    return names(ps, i + 1, acc + (if (i > 0) { "," } else { "" }) + ps[i].label);
}

Str released(List(SignedEvent) es, Int now) {
    return match il_verify([34, 166, 88, 216, 116, 190, 146, 177, 192, 52, 28, 190, 119, 174, 107, 101, 222, 241, 175, 80, 135, 48, 221, 26, 94, 61, 100, 181, 66, 4, 5, 202], es, now, lambda(p) { false }) {
        Err(_) => "log refused",
        Ok(v) => match release_target(es, v, [208, 18, 249, 134, 243, 176, 201, 195, 43, 80, 22, 17, 254, 66, 178, 113, 2, 157, 184, 137, 166, 28, 241, 89, 226, 234, 195, 71, 6, 72, 147, 59]) { Ok(k) => hx(k), Err(e) => match e { ErrRecoveryFailed(s) => s, _ => "other" } }
    };
}

test "a whole log signed in Python: the kit recovery takes effect only after the delay" {
    expect(quorum_names(il_verify([34, 166, 88, 216, 116, 190, 146, 177, 192, 52, 28, 190, 119, 174, 107, 101, 222, 241, 175, 80, 135, 48, 221, 26, 94, 61, 100, 181, 66, 4, 5, 202], [ev0(), ev1()], 2001 + 86399, lambda(p) { false }))).toEqual("phone,laptop,kit,cosigner");
    expect(quorum_names(il_verify([34, 166, 88, 216, 116, 190, 146, 177, 192, 52, 28, 190, 119, 174, 107, 101, 222, 241, 175, 80, 135, 48, 221, 26, 94, 61, 100, 181, 66, 4, 5, 202], [ev0(), ev1()], 2001 + 86400, lambda(p) { false }))).toEqual("new phone,cosigner");
}

test "the cosigner releases its kit half to the new device only after the delay, never after a veto" {
    expect(released([ev0(), ev1()], 2001 + 86399)).toEqual("the recovery delay has not run");
    expect(released([ev0(), ev1()], 2001 + 86400)).toEqual("04f933d02d2ccd59e5bf7e8dfe6ce013d3175ba109c984f845304f7082a25fcf8f9b2fa59a7f8be1a9491b9c197910ef461f7a10efd57f281a7fff649dbd4947ba");
    expect(released([ev0(), ev1(), ev2()], 2001 + 86400 * 2)).toEqual("the device is not in the quorum (vetoed?)");
    expect(released([ev0()], 5000)).toEqual("no kit recovery names this device");
}

