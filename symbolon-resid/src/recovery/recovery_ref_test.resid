test "inception payload bytes equal the reference" {
    expect(enc_hex(e0())).toEqual("");
    expect(hx(sha256_bytes(cose_hex_decode(enc_hex(e0()))))).toEqual("22a658d874be92b1c0341cbe77ae6b65def1af508730dd1a5e3d64b5420405ca");
}

