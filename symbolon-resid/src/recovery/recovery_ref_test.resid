test "guardian approval payload equals the reference" {
    expect(enc_hex(gp())).toEqual("");
    expect(match approval_payload(gp()) { Some(b) => hx(b), None => "" }).toEqual("82781d73796d626f6c6f6e20763120677561726469616e20617070726f76616c5820ad26cac6d2c7307a983551f8ca89c91a68927af221dca4dcb26b758c488f565f");
}

