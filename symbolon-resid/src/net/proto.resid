// Messages between Symbolon parties, carried inside HPKE envelopes through
// the relay (SPEC 20.2). Encoded with the instances resid-derive generates
// into proto_serial.resid.

import "../threshold/threshold.resid";
import "../cosigner/cosigner.resid";
import "../types.resid";
import "crypto.resid";

// An invitation to key generation at inception: the session, the parties in
// CGGMP id order (id i + 1 is parties[i]) with their keys, and the
// polynomial degree (t - 1).
//@ serial
pub type KeygenInvite = { List(Int) session_id; List(PartyKeys) parties; Int threshold; };

// A party's public keys, sent with its first message to a peer it has not
// met: authentication key (DK) and HPKE key, SEC1 points.
//@ serial
pub type PartyKeys = { List(Int) party; List(Int) auth_key; List(Int) hpke_key; };

// A request to co-sign (SPEC 10.4 step 3): the signed request and the
// signer set, then protocol messages under its session id.
//@ serial
pub type SignInvite = {
    List(Int) session_id; List(Int) message; Int epoch; List(Int) requester; Int kind; List(Int) sig;
    List(List(Int)) signers;
};

// One round's protocol messages from one sender: a receiver runs round
// `round` once it holds that round's batch from every other party. In a
// signing session the designated signer's round-7 batch carries its
// verdict on the S points (ThVerdict), and each peer's round-8 batch its
// answer: its signature share, or its abort-2 openings.
//@ serial
pub type SessionMsg = { List(Int) session_id; Int round; List(ThMsg) msgs; };

// The cosigner's half of the kit's material for a recovered device, and
// any other offline wrapping: HPKE base mode enc and ciphertext.
//@ serial
pub type WrappedBlob = { List(Int) enc; List(Int) ct; };

// An invitation to re-share (SPEC 11.3): the new quorum's parties in
// CGGMP id order (id i + 1 is new_parties[i]), who deals (old ids), who
// receives (new ids), who is offline (new ids), the new polynomial degree
// and epoch, and the requester's DK signature over request_tbs(session id,
// reshare_message(...), old epoch, requester, request_reshare).
//@ serial
pub type ReshareInvite = {
    List(Int) session_id; List(Int) log_id; List(Party) new_parties;
    List(Int) dealers; List(Int) receivers; List(Int) offline; Int degree; Int epoch;
    List(Int) requester; List(Int) sig;
};

// What an enrolled device receives from the device that enrolled it (SPEC
// 11.1 step 4): the chain code and the vault key.
//@ serial
pub type EnrollSecrets = { List(Int) cc; List(Int) vault_key; };

// One dealer's dealing of the vault OPRF key to one receiver (SPEC
// 18.10.1): the session it belongs to, the dealer's index, its Feldman
// commitments (compressed points) and the receiver's part (32 bytes),
// which only the receiver's envelope opens.
//@ serial
pub type KvDealMsg = { List(Int) session_id; Int dealer; List(List(Int)) commits; List(Int) part; };

// A protected-item evaluation request (SPEC 18.10.3): the device's blinded
// elements B_i (compressed points, at most 256), for purpose 0 (open), 1
// (re-key) or 2 (credential rotation), the event that requires a re-key
// (its sequence; -1 for none), and the device's DK signature over
// request_tbs(session id, eval_message(...), epoch, requester, request_eval).
//@ serial
pub type EvalRequest = { List(Int) session_id; List(Int) log_id; Int epoch; Int purpose; List(List(Int)) blinded; Int event_seq;
                         List(Int) requester; List(Int) sig; };

// The answer: Z_i = k_j B_i for each element, with one batched DLEQ proof.
//@ serial
pub type EvalAnswer = { List(Int) session_id; List(List(Int)) elements; List(Int) proof; };

// A device asks for the evaluation records of its log (SPEC 18.10.4): its
// DK signature over request_tbs(session id, SHA-256("symbolon v1 eval
// log"), epoch, requester, request_eval()). The answer: every evaluation
// of the past seven days, by any device of the log.
//@ serial
pub type EvalLogRequest = { List(Int) session_id; List(Int) log_id; Int epoch; List(Int) requester; List(Int) sig; };

//@ serial
pub type EvalLogEntry = { Int time; List(Int) device; Int count; };

//@ serial
pub type EvalLogAnswer = { List(Int) session_id; Int now; Int limit; List(EvalLogEntry) entries; };

// ─── Duress alerts (SPEC 14.4) ─────────────────────────────────────

// Sent at every unlock, by the real profile (signed with the DK) and by the
// duress profile (signed with the duress sub-key) alike, so the traffic is
// the same either way. `location` is always 32 bytes (all zeros when there
// is none): latitude and longitude in 1e-7 degrees, accuracy in meters and
// age in seconds, each 8 bytes big-endian, two's complement.
//@ serial
pub type Beacon = { List(Int) session_id; List(Int) log_id; Int epoch; Int time; List(Int) location; List(Int) requester; List(Int) sig; };

// Someone the cosigner tells when this identity is under duress, and how.
//@ serial
pub type AlertContact = { Str name; Bool ntfy; Str email; Str phone; Str household; Str threnody; };

// Ask for the alert settings (`set` false) or replace them; signed by a
// device's DK (the duress profile has none).
//@ serial
pub type AlertConfig = { List(Int) session_id; List(Int) log_id; Int epoch; Bool set; Str person; List(AlertContact) contacts; List(Int) requester; List(Int) sig; };

// The settings as the cosigner keeps them, with each contact's ntfy topic,
// and whether a duress window is open (and since when, by which device).
//@ serial
pub type AlertState = { List(Int) session_id; Str person; List(AlertContact) contacts; List(Str) topics; Bool duress; Int started_at; List(Int) party; };

// An end-duress message (SPEC 14.3): the window it ends and the device
// signatures over ["symbolon v1 end-duress", log_id, started_at].
//@ serial
pub type EndDuressReq = { List(Int) log_id; Int started_at; List(List(Int)) signers; List(List(Int)) sigs; };

//@ serial
pub type Packet =
    WKeygen(KeygenInvite)
  | WSign(SignInvite)
  | WSession(SessionMsg)
  | WRefused(List(Int))                  // a session id the receiver will not run
  | WKitHalf(WrappedBlob)
  | WSignEvent(List(Int))                 // event payload bytes the receiver is asked to sign
  | WEventSig(List(Int))                  // its signature r || s
  | WReshare(ReshareInvite)
  | WEnrollSecrets(EnrollSecrets)
  | WKitKey(List(Int))                    // the cosigner's half k_b of the kit key for a new epoch
  | WKitRelease(List(Int))                // a recovered device asks for the cosigner's half (log id)
  | WDuressKey(List(Int))                 // the sender's duress DK sub-key (SPEC 14.2); every device sends one
  | WKvDeal(KvDealMsg)                    // a dealing of the vault OPRF key (SPEC 18.10.1)
  | WKvHalf(WrappedBlob)                  // the cosigner's half b_v of the kit's k_v share, to a recovered device
  | WEval(EvalRequest)                    // a protected-item evaluation request (SPEC 18.10.3)
  | WEvalAnswer(EvalAnswer)               // its answer; a refusal is WRefused(session id)
  | WEvalLog(EvalLogRequest)              // the evaluation records, asked for
  | WEvalLogAnswer(EvalLogAnswer)         // and given
  | WBeacon(Beacon)                       // an unlock (SPEC 14.4); no answer
  | WAlertConfig(AlertConfig)             // the duress alert settings, asked for or set
  | WAlertState(AlertState)               // and answered
  | WEndDuress(EndDuressReq)              // end a duress window early (SPEC 14.3)
  | WAlertKey(List(Int))                  // the sender's alert key (household alerts, SPEC 14.4)
  | WVeto(List(Int));                     // a device's signed veto (as stored), to the cosigner (SPEC 13.4, R3P-3)

// What the relay carries: sender and recipient party ids, and the HPKE
// mode_auth encapsulation and ciphertext of one Packet value.
//@ serial
pub type Envelope = { List(Int) from; List(Int) to; List(Int) enc; List(Int) ct; };

// What a re-share request signs as its message m: SHA-256 of the log id,
// the session id, the new parties' ids, the dealers, receivers, offline
// ids, degree and epoch.
pub List(Int) reshare_message(ReshareInvite r) {
    return sha256_bytes(r.log_id.concat(r.session_id).concat(ids_bytes(r.new_parties, 0, [])).concat(small(r.dealers)).concat(small(r.receivers))
        .concat(small(r.offline)).concat([r.degree & 255, (r.epoch >> 24) & 255, (r.epoch >> 16) & 255, (r.epoch >> 8) & 255, r.epoch & 255]));
}

// What an evaluation request signs as its message m: SHA-256 of the log
// id, the purpose, the event sequence and every blinded element.
pub List(Int) eval_message(EvalRequest r) {
    List(Int) head = r.log_id.concat([r.purpose & 255]).concat(be8(r.event_seq + 1)).concat([(r.blinded.len() >> 8) & 255, r.blinded.len() & 255]);
    return sha256_bytes(head.concat(flat_bl(r.blinded, 0, [])));
}

List(Int) be8(Int v) { return [(v >> 56) & 255, (v >> 48) & 255, (v >> 40) & 255, (v >> 32) & 255, (v >> 24) & 255, (v >> 16) & 255, (v >> 8) & 255, v & 255]; }

List(Int) flat_bl(List(List(Int)) xs, Int i, List(Int) acc) { return if (i >= xs.len()) { acc } else { flat_bl(xs, i + 1, acc.concat([xs[i].len() & 255]).concat(xs[i])) }; }

pub List(Int) eval_log_message() { return sha256_bytes(utf8("symbolon v1 eval log")); }

// What a beacon's signature covers as its message m.
pub List(Int) beacon_message(Beacon b) { return sha256_bytes(utf8("symbolon v1 beacon").concat(b.log_id).concat(be8(b.time)).concat(b.location)); }

// What an alert-settings request signs as its message m.
pub List(Int) alert_config_message(AlertConfig a) {
    return sha256_bytes(utf8("symbolon v1 alert config").concat(a.log_id).concat([if (a.set) { 1 } else { 0 }]).concat(utf8(a.person)).concat(contacts_bytes(a.contacts, 0, [])));
}

List(Int) contacts_bytes(List(AlertContact) cs, Int i, List(Int) acc) {
    if (i >= cs.len()) { return acc; }
    AlertContact c = cs[i];
    List(Int) one = lp_str(c.name).concat([if (c.ntfy) { 1 } else { 0 }]).concat(lp_str(c.email)).concat(lp_str(c.phone)).concat(lp_str(c.household)).concat(lp_str(c.threnody));
    return contacts_bytes(cs, i + 1, acc.concat(one));
}

// A string with its length first, so fields cannot run into each other.
List(Int) lp_str(Str s) { List(Int) b = utf8(s); return [(b.len() >> 8) & 255, b.len() & 255].concat(b); }

List(Int) ids_bytes(List(Party) ps, Int i, List(Int) acc) {
    if (i >= ps.len()) { return acc; }
    return ids_bytes(ps, i + 1, acc.concat(ps[i].id));
}

List(Int) small(List(Int) xs) { return [xs.len() & 255].concat(xs); }
