// The relay (sync service, SPEC 20.1) and a witness (SPEC 20.3) as HTTP
// handlers over a data directory, and their clients.
//
// The relay is untrusted and dumb: it stores what it is given and returns
// it. Every object it holds is verified by its recipient (envelopes are
// HPKE mode_auth, log events are signed and witnessed, vault items are
// AEAD-sealed under a signed head).
//
//   POST /mbox/<to>            an envelope for party <to>; answers its index (the
//                              organization relay, agent/relaysrv.resid, takes it only
//                              from a party of <to>'s log: agent/mailgate.resid)
//   GET  /mbox/<to>/<n>        envelope n for <to>, 404 when there is none
//   POST /log/<log>/<seq>      an event; refused (409) when <seq> is taken
//   GET  /log/<log>/<seq>      the event
//   PUT  /blob/<name>          an object (vault state, wrapped keys, ...)
//   GET  /blob/<name>
//   GET  /list/<prefix>        the names of the blobs that start with <prefix>, one per
//                              line, sorted, at most max_listed() (people's cards, the
//                              shared collections a person's devices have keys for)
//
// A witness (agent/witnesssrv.resid) co-signs (log, seq, digest) once, and
// only for an event valid as the next one of the log it is shown: a second
// digest for the same (log, seq) is refused (409), the first is re-signed
// on request; an event that is not valid there is refused (403).
//
//   POST /cosign               CBOR [log, E0, ..., En, ? claim]; answers CBOR [time, r || s]
//                              over ["symbolon v1 witness", log, n, H(En)]; claim, CBOR
//                              [time, r || s], is the log's relay's claim on (log, n, H(En))
//                              (agent/relaysrv.resid POST /claim), needed when the log's
//                              policy names a sequencing relay (field 8, SPEC 20.3); a 409
//                              answers CBOR [digest, claim or an empty bstr] held there.
//                              Or CBOR [log, k, Ek, ..., En, ? claim]: only the events
//                              from k on, on top of the state the witness keeps for the
//                              log; 412 with CBOR [next] when it keeps none that far
//                              (next: the sequence after the last event it keeps, 0 for
//                              none), and the client sends from there (cosign_try)
//   POST /catchup              CBOR [log, k, Ek, ..., Em]: co-signed events the witness
//                              verifies and keeps, without co-signing anything, so that a
//                              log longer than one request reaches it in parts; answers
//                              CBOR [next], 412 as above
//   POST /time                 a 32-byte nonce; answers CBOR [time, r || s] over
//                              ["symbolon v1 witness time", nonce, time]: the witness
//                              time devices and the cosigner measure delays by (SPEC 13.4)
//
// <to>, <log> are lower-case hex; <seq>, <n> decimal; <name> is
// [a-z0-9._-], at most 128 characters.

import "../core/log.resid";
import "../core/event_decode.resid";
import "httpserv.resid";
import "cose.resid";
import "cosesig.resid";
import "ecdsa.resid";
import "crypto.resid";
import "clock.resid";
import "wire.resid";
import "tlsclient.resid";
import "tlswire.resid";
import "tlskey.resid";
import "chain.resid";

Bool hex_name(Str s, Int i) {
    if (str_len(s) == 0 || str_len(s) > 128) { return false; }
    if (i >= str_len(s)) { return true; }
    Int c = str_char_at(s, i);
    return ((c >= 48 && c <= 57) || (c >= 97 && c <= 102)) && hex_name(s, i + 1);
}

Bool blob_name(Str s, Int i) {
    if (str_len(s) == 0 || str_len(s) > 128) { return false; }
    if (i >= str_len(s)) { return true; }
    Int c = str_char_at(s, i);
    Bool ok = (c >= 48 && c <= 57) || (c >= 97 && c <= 122) || c == 46 || c == 95 || c == 45;
    return ok && !(i == 0 && c == 46) && blob_name(s, i + 1);
}

Bool dec_name(Str s, Int i) {
    if (str_len(s) == 0 || str_len(s) > 19) { return false; }
    if (i >= str_len(s)) { return true; }
    Int c = str_char_at(s, i);
    return c >= 48 && c <= 57 && dec_name(s, i + 1);
}

Str seg(List(Str) parts, Int i) { return if (i < parts.len()) { parts[i] } else { "" }; }

@requires(filesystem)
Int next_index(Str dir, Int i) {
    if (!filesystem.exists(dir + "/" + f"{i}")) { return i; }
    return next_index(dir, i + 1);
}

// ============================================================================
// The relay
// ============================================================================

@requires(filesystem)
pub HttpReply relay_handle(Str root, HttpRequest r) {
    List(Str) p = str_split(r.path, "/");
    // p[0] is "" (the path starts with "/").
    Str kind = seg(p, 1);
    if (kind == "mbox" && r.method == "POST" && p.len() == 3 && hex_name(seg(p, 2), 0)) {
        Str d = root + "/mbox/" + seg(p, 2);
        _ = filesystem.create_dir(d);
        Int n = next_index(d, 0);
        if (r.body.len() == 0 || r.body.len() > 16781312) { return http_reply_status(413); }
        return if (filesystem.write_bytes(d + "/" + f"{n}", r.body)) { http_reply_text(200, "text/plain", f"{n}") } else { http_reply_status(500) };
    }
    if (kind == "mbox" && r.method == "GET" && p.len() == 4 && hex_name(seg(p, 2), 0) && dec_name(seg(p, 3), 0)) {
        return file_reply(root + "/mbox/" + seg(p, 2) + "/" + seg(p, 3));
    }
    if (kind == "log" && p.len() == 4 && hex_name(seg(p, 2), 0) && dec_name(seg(p, 3), 0)) {
        Str f = root + "/log/" + seg(p, 2) + "/" + seg(p, 3);
        if (r.method == "GET") { return file_reply(f); }
        if (r.method == "POST") {
            if (filesystem.exists(f)) { return http_reply_status(409); }
            _ = filesystem.create_dir(root + "/log/" + seg(p, 2));
            return if (filesystem.write_bytes(f, r.body)) { http_reply_status(200) } else { http_reply_status(500) };
        }
    }
    if (kind == "blob" && p.len() == 3 && blob_name(seg(p, 2), 0)) {
        Str f = root + "/blob/" + seg(p, 2);
        if (r.method == "GET") { return file_reply(f); }
        if (r.method == "PUT") {
            _ = filesystem.create_dir(root + "/blob");
            return if (filesystem.write_bytes(f, r.body)) { http_reply_status(200) } else { http_reply_status(500) };
        }
    }
    if (kind == "list" && r.method == "GET" && p.len() == 3 && blob_name(seg(p, 2), 0)) {
        List(Str) names = sort(starting_with(filesystem.list_dir(root + "/blob"), seg(p, 2), 0, ListBuf()));
        return http_reply_text(200, "text/plain", str_join(if (names.len() > max_listed()) { names[0..max_listed()] } else { names }, "\n"));
    }
    return http_reply_status(404);
}

pub Int max_listed() { return 4096; }

List(Str) starting_with(List(Str) xs, Str prefix, Int i, ListBuf(Str) acc) {
    if (i >= xs.len()) { return acc.finish(); }
    return starting_with(xs, prefix, i + 1, if (str_starts_with(xs[i], prefix) && blob_name(xs[i], 0)) { acc.push(xs[i]) } else { acc });
}

@requires(filesystem)
HttpReply file_reply(Str f) {
    if (!filesystem.exists(f)) { return http_reply_status(404); }
    return http_reply_bytes(200, "application/octet-stream", filesystem.read_bytes(f));
}

// ============================================================================
// A witness
// ============================================================================

// The witness's request (SPEC 20.3): CBOR [log id, E0, ..., En], each
// event a byte string holding the event as the relay stores it
// (StoredEvent, agent/state.resid): the whole log before the event to
// co-sign, with its co-signatures, then that event (its co-signatures are
// not read). The witness (agent/witnesssrv.resid) co-signs En only if the
// log verifies and En is valid as its next event under the signing rules
// in force, at the witness's time.
pub List(Int) cosign_request(List(Int) l, List(List(Int)) events) {
    List(Int) b = cosign_request_claimed(l, events, None);
    return b;
}

// With the relay's claim on the last event (SPEC 20.3), as the last item.
pub List(Int) cosign_request_claimed(List(Int) l, List(List(Int)) events, Option(RelayClaim) c) {
    Int extra = match c { None => 0, Some(_) => 1 };
    List(Int) a = cosign_items(events, 0, cbe_bytes(l, cbe_array(events.len() + 1 + extra, [])));
    return match c { None => a, Some(x) => a.concat(claim_cbor(x)) };
}

// The incremental form (SPEC 20.3, R3P-2): CBOR [log id, k, Ek, ..., En,
// ? claim], `events` the log's events from sequence k on. The witness
// verifies them on top of the state it keeps for the log; the same form
// without a claim is a POST /catchup.
pub List(Int) cosign_delta(List(Int) l, Int k, List(List(Int)) events, Option(RelayClaim) c) {
    Int extra = match c { None => 0, Some(_) => 1 };
    List(Int) a = cosign_items(events, 0, cbe_uint(k, cbe_bytes(l, cbe_array(events.len() + 2 + extra, []))));
    return match c { None => a, Some(x) => a.concat(claim_cbor(x)) };
}

// The most a witness takes in one co-sign or catch-up request (413
// beyond): it verifies what a request carries, so the cost of one is
// bounded by its size.
pub Int cosign_max_bytes() { return 2097152; }
pub Int cosign_max_events() { return 2048; }

// A witness's CBOR [next]: the sequence after the last event it keeps for
// the log (0 for none); -1 when the body is not that.
pub Int witness_next_of(List(Int) b) {
    Rd a = rd(b, 0);
    Rd n = rd(b, a.next);
    Int v = if (a.major == 4 && a.val == 1 && n.major == 0 && n.next == b.len()) { n.val } else { -1 };
    return v;
}

List(Int) cosign_items(List(List(Int)) es, Int i, List(Int) acc) {
    if (i >= es.len()) { return acc; }
    return cosign_items(es, i + 1, cbe_bytes(es[i], acc));
}

Int be_at(List(Int) b, Int p, Int n, Int acc) { return if (n == 0) { acc } else { be_at(b, p + 1, n - 1, acc * 256 + b[p]) }; }

// The answer: CBOR [witness time, r || s over witness_message].
// What a witness signs for a time query.
pub List(Int) time_message(List(Int) nonce, Int t) {
    return cbe_uint(t, cbe_bytes(nonce, cbe_text("symbolon v1 witness time", cbe_array(3, []))));
}

// ============================================================================
// Clients
// ============================================================================

pub type HttpOut = { Int status; List(Int) body; };

List(Int) ascii(Str s) { return http_bytes(s); }

Int find_crlf2(List(Int) b, Int i) {
    if (i + 3 >= b.len()) { return -1; }
    if (b[i] == 13 && b[i + 1] == 10 && b[i + 2] == 13 && b[i + 3] == 10) { return i; }
    return find_crlf2(b, i + 1);
}

// One request on a fresh connection to host:port (loopback or a pinned
// address), Connection: close; the status and the body.
@requires(network)
pub HttpOut http_call_bytes(Str host, Int port, Str method, Str path, List(Int) body) { return http_call_head(host, port, method, path, "", body); }

// As http_call_bytes, with `extra` header lines (each ending in CRLF).
@requires(network)
pub HttpOut http_call_head(Str host, Int port, Str method, Str path, Str extra, List(Int) body) {
    Int fd = resid_tcp_connect(host, port);
    if (fd < 0) { return HttpOut {.status = 0, .body = []}; }
    Str head = method + " " + path + " HTTP/1.1\r\nHost: " + host + "\r\n" + extra + "Connection: close\r\nContent-Length: " + f"{body.len()}" + "\r\n\r\n";
    _ = resid_tcp_send_bin(fd, ascii(head).concat(body));
    _ = resid_tcp_deadline(fd, 30000);
    List(Int) raw = recv_all(fd, 0, ListBuf());
    _ = resid_tcp_close(fd);
    Int at = find_crlf2(raw, 0);
    if (at < 12) { return HttpOut {.status = 0, .body = []}; }
    Int status = str_parse_int(http_text(raw, 9, 12));
    return HttpOut {.status = status, .body = raw[at + 4..raw.len()]};
}

// The whole response, until the server closes; at most max_response()
// bytes (more is cut off, and the reply then fails to parse).
pub Int max_response() { return 16781312 + 65536; }

@requires(network)
List(Int) recv_all(Int fd, Int got, ListBuf(Int) acc) {
    if (got >= max_response()) { return acc.finish(); }
    List(Int) chunk = resid_tcp_recv_some(fd, 65536);
    if (chunk.len() == 0) { return acc.finish(); }
    return recv_all(fd, got + chunk.len(), push_all(acc, chunk, 0));
}

ListBuf(Int) push_all(ListBuf(Int) acc, List(Int) xs, Int i) {
    if (i >= xs.len()) { return acc; }
    return push_all(acc.push(xs[i]), xs, i + 1);
}

// `ca`: the PEM trust anchor for TLS to this endpoint; "" speaks plain HTTP
// (loopback tests). Every message is end-to-end protected anyway (HPKE
// envelopes, signed log events and witness signatures); TLS hides the
// traffic's metadata from the network and keeps a path attacker from
// posing as the relay or a witness.
// `token`: a session from the relay's sign-in (SPEC 29.4), sent as a
// bearer token; "" sends none.
pub type Endpoint = { Str host; Int port; Str ca; Str token; };

// One request to `e`: HTTPS under e.ca when it is set, else plain HTTP.
@requires(network, clock(readonly), declassify)
pub HttpOut http_call_ep(Endpoint e, Str method, Str path, List(Int) body) {
    Str auth = if (str_len(e.token) == 0) { "" } else { "Authorization: Bearer " + e.token + "\r\n" };
    if (str_len(e.ca) == 0) { return http_call_head(e.host, e.port, method, path, auth, body); }
    TrustStore store = trust_store_add_pem(trust_store_empty(), e.ca);
    HttpsGet g = tls_https_request("https://" + e.host + ":" + f"{e.port}" + path, "", store, ["http/1.1"], 30000, method, auth, body);
    return HttpOut {.status = g.status, .body = g.bytes};
}

@requires(network, clock(readonly), declassify)
pub Int mbox_put(Endpoint e, List(Int) to, List(Int) envelope) {
    HttpOut o = http_call_ep(e, "POST", "/mbox/" + hex_encode(to), envelope);
    return if (o.status == 200) { str_parse_int(http_text(o.body, 0, o.body.len())) } else { -1 };
}

@requires(network, clock(readonly), declassify)
pub Option(List(Int)) mbox_get(Endpoint e, List(Int) to, Int n) {
    HttpOut o = http_call_ep(e, "GET", "/mbox/" + hex_encode(to) + "/" + f"{n}", []);
    return if (o.status == 200) { Some(o.body) } else { None };
}

// ============================================================================
// Mailbox traffic over one kept connection
// ============================================================================
//
// A session waiting for its next round asks the relay for an envelope
// every 100 ms, and every request used to be a connection of its own: a
// TCP and TLS handshake for each one, which on a phone was much of a
// signature's wait. A burst sends its requests over one HTTPS connection
// (HTTP/1.1 keep-alive) and then closes it.
//
// A burst that waits lasts at most burst_ms(), for two reasons. The relay
// answers in child processes that take batch_conns() connections each and
// end when the last of them closes, and the next child starts only then:
// a connection kept long would hold up everyone queued for it. And a loop
// that carries a connection (a record) keeps every request's garbage until
// it returns, so the loop that waits across bursts (relay_wait) carries
// only plain values.
//
// An endpoint without a CA is plain HTTP, with no handshake to save: each
// request there is still a connection of its own.

// An envelope to post to party `to`'s mailbox.
pub type Post = { List(Int) to; List(Int) envelope; };

// What a burst read: envelope envs[i] came from the mailbox of parties
// entry which[i], and `nexts` is where each mailbox's reading resumes.
pub type Fetched = { List(Int) which; List(List(Int)) envs; List(Int) nexts; };

pub Int burst_ms() { return 1000; }

// `fresh`: no request has been answered on `conn` yet. `born`: when it
// was opened (clock_monotonic_ns).
type Link = { Endpoint e; Bool tls; Option(TlsClient) conn; Bool fresh; Int born; };

// Each request has 30 s to be answered, as one on a connection of its own
// had (http_call_ep).
Int link_request_ms() { return 30000; }

type LinkOut = { Link l; Int status; List(Int) body; };

Link link_new(Endpoint e) { return Link {.e = e, .tls = str_len(e.ca) > 0, .conn = None, .fresh = true, .born = 0}; }

Link link_closed(Link l) { return Link {.e = l.e, .tls = l.tls, .conn = None, .fresh = true, .born = 0}; }

@requires(network, clock(readonly), declassify)
Link link_dial(Endpoint e) {
    TrustStore store = trust_store_add_pem(trust_store_empty(), e.ca);
    TlsDial d = tls_client_connect(e.host, e.port, tls_client_cfg_within(tls_client_cfg(e.host, store, ["http/1.1"]), link_request_ms()));
    return Link {.e = e, .tls = true, .conn = if (str_len(d.err) == 0) { Some(d.conn) } else { None }, .fresh = true, .born = clock_monotonic_ns()};
}

@requires(network, declassify)
Bool link_close(Link l) {
    Option(TlsClient) oc = l.conn;
    return match oc { None => true, Some(c) => wire_close(c) };
}

// One request on the link; status 0 when nothing usable came back.
@requires(network, clock(readonly), declassify)
LinkOut link_call(Link l, Str method, Str path, List(Int) body) {
    if (!l.tls) {
        HttpOut o = http_call_ep(l.e, method, path, body);
        return LinkOut {.l = l, .status = o.status, .body = o.body};
    }
    Option(TlsClient) oc = l.conn;
    Bool open = match oc { None => false, Some(_) => true };
    // A connection is not kept past burst_ms(), however busy it is: a long
    // read (a mailbox far behind) takes several in turn.
    Bool old = open && clock_monotonic_ns() - l.born > burst_ms() * 1000000;
    if (old) { _ = link_close(l); }
    Bool kept = open && !old;
    Link l1 = if (kept) { l } else { link_dial(l.e) };
    LinkOut r = link_try(l1, method, path, body);
    if (r.status != 0 || l1.fresh) { return r; }
    // A kept connection that answered nothing: the relay closed it while it
    // was idle, before it read this request, so the request goes again on a
    // new connection. Were the answer lost after the relay stored a posted
    // envelope, a second copy would follow; only round batches (WSession)
    // are posted this way, and a session takes a round's batch from a party
    // once.
    return link_try(link_dial(l.e), method, path, body);
}

@requires(network, clock(readonly), declassify)
LinkOut link_try(Link l, Str method, Str path, List(Int) body) {
    Option(TlsClient) oc = l.conn;
    return match oc {
        None => LinkOut {.l = l, .status = 0, .body = []},
        Some(c) => link_exchange(l, c, method, path, body)
    };
}

type LinkHead = { TlsClient conn; List(Int) data; Int end; };   // end: where the head's CR LF CR LF starts, or -1

type LinkBody = { TlsClient conn; List(Int) data; Bool ok; };

@requires(network, clock(readonly), declassify)
LinkOut link_exchange(Link l, TlsClient c, Str method, Str path, List(Int) body) {
    Str auth = if (str_len(l.e.token) == 0) { "" } else { "Authorization: Bearer " + l.e.token + "\r\n" };
    List(Int) req = http_bytes(method + " " + path + " HTTP/1.1\r\nHost: " + l.e.host + ":" + f"{l.e.port}" + "\r\n" + auth
        + f"Content-Length: {body.len()}\r\nConnection: keep-alive\r\n\r\n").concat(body);
    _ = wire_deadline(c, link_request_ms());
    WireOut(TlsClient) sent = wire_send(c, req);
    if (!sent.ok) { return link_broken(l, sent.conn); }
    LinkHead h = link_head(sent.conn, [], 64);
    if (h.end < 0) { return link_broken(l, h.conn); }
    List(Str) lines = str_split(http_text(h.data, 0, h.end), "\r\n");
    Int status = link_status(lines[0]);
    Str cl = link_header(lines, "content-length", 1);
    if (status <= 0 || !dec_name(cl, 0) || str_len(cl) > 9) { return link_broken(l, h.conn); }
    Int want = str_parse_int(cl);
    if (want > https_max_body()) { return link_broken(l, h.conn); }
    LinkBody b = link_body(h.conn, h.data[(h.end + 4)..h.data.len()], want);
    if (!b.ok) { return link_broken(l, b.conn); }
    // Bytes past the body would be an answer to nothing: the connection
    // is not used again.
    Bool keep = str_to_lower(link_header(lines, "connection", 1)) != "close" && b.data.len() == want;
    if (!keep) { _ = wire_close(b.conn); }
    Link next = if (keep) { Link {.e = l.e, .tls = true, .conn = Some(b.conn), .fresh = false, .born = l.born} } else { link_closed(l) };
    return LinkOut {.l = next, .status = status, .body = b.data[0..want]};
}

@requires(network, declassify)
LinkOut link_broken(Link l, TlsClient c) {
    _ = wire_close(c);
    return LinkOut {.l = link_closed(l), .status = 0, .body = []};
}

// Reads until the response head is whole: at most 64 KiB, in at most
// `rounds` reads.
@requires(network, declassify)
LinkHead link_head(TlsClient c, List(Int) acc, Int rounds) {
    Int at = link_find_end(acc, 0);
    if (at >= 0) { return LinkHead {.conn = c, .data = acc, .end = at}; }
    if (rounds <= 0 || acc.len() > 65536) { return LinkHead {.conn = c, .data = acc, .end = -1}; }
    WireIn(TlsClient) in = wire_fill(c, acc, acc.len() + 1, 65536 + 4);
    if (in.eof && link_find_end(in.data, 0) < 0) { return LinkHead {.conn = in.conn, .data = in.data, .end = -1}; }
    return link_head(in.conn, in.data, rounds - 1);
}

// Where CR LF CR LF starts in `b`, from `i` on, or -1.
Int link_find_end(List(Int) b, Int i) {
    if (i + 3 >= b.len()) { return -1; }
    if (b[i] == 13 && b[i + 1] == 10 && b[i + 2] == 13 && b[i + 3] == 10) { return i; }
    return link_find_end(b, i + 1);
}

@requires(network, declassify)
LinkBody link_body(TlsClient c, List(Int) acc, Int want) {
    if (acc.len() >= want) { return LinkBody {.conn = c, .data = acc, .ok = true}; }
    WireIn(TlsClient) in = wire_fill(c, acc, want, want + 16384);
    if (in.eof && in.data.len() < want) { return LinkBody {.conn = in.conn, .data = in.data, .ok = false}; }
    return link_body(in.conn, in.data, want);
}

// The status code of "HTTP/1.1 200 OK", or -1.
Int link_status(Str line) {
    List(Str) ws = str_split(line, " ");
    if (ws.len() < 2 || !str_starts_with(ws[0], "HTTP/1.") || str_len(ws[1]) != 3 || !dec_name(ws[1], 0)) { return -1; }
    return str_parse_int(ws[1]);
}

// The value of header `name` (lower case) among the lines from `i` on, or "".
Str link_header(List(Str) lines, Str name, Int i) {
    if (i >= lines.len()) { return ""; }
    Int colon = str_index_of(lines[i], ":", 0);
    if (colon > 0 && str_to_lower(str_trim(str_slice(lines[i], 0, colon))) == name) { return str_trim(str_slice(lines[i], colon + 1, str_len(lines[i]))); }
    return link_header(lines, name, i + 1);
}

@requires(network, clock(readonly), declassify)
Link link_posts(Link l, List(Post) posts, Int i) {
    if (i >= posts.len()) { return l; }
    LinkOut r = link_call(l, "POST", "/mbox/" + hex_encode(posts[i].to), posts[i].envelope);
    return link_posts(r.l, posts, i + 1);
}

type BurstRead = { Link l; List(Int) which; List(List(Int)) envs; List(Int) nexts; };

// Reads each mailbox from its next index on until the relay has nothing
// more there (or does not answer).
@requires(network, clock(readonly), declassify)
BurstRead link_read(Link l, List(Int) parties, List(Int) nexts, Int k, ListBuf(Int) which, ListBuf(List(Int)) envs, ListBuf(Int) nx) {
    if (k >= nexts.len()) { return BurstRead {.l = l, .which = which.finish(), .envs = envs.finish(), .nexts = nx.finish()}; }
    LinkOut r = link_call(l, "GET", "/mbox/" + hex_encode(link_party(parties, k)) + "/" + f"{nexts[k]}", []);
    if (r.status != 200) { return link_read(r.l, parties, nexts, k + 1, which, envs, nx.push(nexts[k])); }
    // The same mailbox again, one further on.
    List(Int) more = nexts[0..k].concat([nexts[k] + 1]).concat(nexts[(k + 1)..nexts.len()]);
    return link_read(r.l, parties, more, k, which.push(k), envs.push(r.body), nx);
}

List(Int) link_party(List(Int) parties, Int k) { return parties[(32 * k)..(32 * k + 32)]; }

// Posts `posts`, then reads what the mailboxes of `parties` (32 bytes each,
// one after another) hold from `nexts` on, over one connection.
@requires(network, clock(readonly), declassify)
pub Fetched relay_read(Endpoint e, List(Post) posts, List(Int) parties, List(Int) nexts) {
    BurstRead r = link_read(link_posts(link_new(e), posts, 0), parties, nexts, 0, ListBuf(), ListBuf(), ListBuf());
    _ = link_close(r.l);
    return Fetched {.which = r.which, .envs = r.envs, .nexts = r.nexts};
}

// Posts `posts`, then reads the mailboxes of `parties` (32 bytes each, one
// after another) from `nexts` on, over one connection. With `wait`, when
// nothing came, asks again every 100 ms until something does, the clock
// passes `until` (seconds), or the burst has lasted burst_ms().
@requires(network, clock, declassify)
pub Fetched relay_burst(Endpoint e, List(Post) posts, List(Int) parties, List(Int) nexts, Bool wait, Int until) {
    return burst_loop(link_posts(link_new(e), posts, 0), parties, nexts, wait, until, clock_monotonic_ns());
}

@requires(network, clock, declassify)
Fetched burst_loop(Link l, List(Int) parties, List(Int) nexts, Bool wait, Int until, Int start) {
    BurstRead r = link_read(l, parties, nexts, 0, ListBuf(), ListBuf(), ListBuf());
    Bool over = !wait || r.envs.len() > 0 || clock_now_seconds() > until || clock_monotonic_ns() - start > burst_ms() * 1000000;
    if (over) {
        _ = link_close(r.l);
        return Fetched {.which = r.which, .envs = r.envs, .nexts = r.nexts};
    }
    _ = clock_sleep_ms(100);
    return burst_loop(r.l, parties, r.nexts, wait, until, start);
}

// Posts `posts`, then waits until a mailbox of `parties` holds its next
// envelope or the clock passes `until`, burst after burst, and returns
// what the burst that found something read.
@requires(network, clock, declassify)
pub Fetched relay_wait(Endpoint e, List(Post) posts, List(Int) parties, List(Int) nexts, Int until) {
    Fetched f = relay_burst(e, posts, parties, nexts, true, until);
    if (f.envs.len() > 0 || clock_now_seconds() > until) { return f; }
    return relay_wait_on(e.host, e.port, e.ca, e.token, parties, nexts, until);
}

// The waiting loop: plain values only, so each burst's garbage (its
// connection, its replies) is freed when the next begins.
@requires(network, clock, declassify)
Fetched relay_wait_on(Str host, Int port, Str ca, Str token, List(Int) parties, List(Int) nexts, Int until) {
    List(Post) none = [];
    Fetched f = relay_burst(Endpoint {.host = host, .port = port, .ca = ca, .token = token}, none, parties, nexts, true, until);
    if (f.envs.len() > 0 || clock_now_seconds() > until) { return f; }
    return relay_wait_on(host, port, ca, token, parties, nexts, until);
}

@requires(network, clock(readonly), declassify)
pub Bool log_put(Endpoint e, List(Int) l, UInt(64) seq, List(Int) event) {
    return http_call_ep(e, "POST", "/log/" + hex_encode(l) + "/" + f"{seq}", event).status == 200;
}

@requires(network, clock(readonly), declassify)
pub Option(List(Int)) log_get(Endpoint e, List(Int) l, UInt(64) seq) {
    HttpOut o = log_get_out(e, l, seq);
    return if (o.status == 200) { Some(o.body) } else { None };
}

// The relay's whole answer for one event: 404 says the log has no event
// at `seq`; anything but 200 or 404 (0 when nothing answered) says nothing
// about the log.
@requires(network, clock(readonly), declassify)
pub HttpOut log_get_out(Endpoint e, List(Int) l, UInt(64) seq) {
    return http_call_ep(e, "GET", "/log/" + hex_encode(l) + "/" + f"{seq}", []);
}

@requires(network, clock(readonly), declassify)
pub Bool blob_put(Endpoint e, Str name, List(Int) b) { return http_call_ep(e, "PUT", "/blob/" + name, b).status == 200; }

@requires(network, clock(readonly), declassify)
pub Option(List(Int)) blob_get(Endpoint e, Str name) {
    HttpOut o = http_call_ep(e, "GET", "/blob/" + name, []);
    return if (o.status == 200) { Some(o.body) } else { None };
}

// The names of the relay's blobs that start with `prefix`.
@requires(network, clock(readonly), declassify)
pub List(Str) blob_list(Endpoint e, Str prefix) { return list_from(e, prefix, "", []); }

// Page after page: a relay that pages (SPEC 29.4) answers from after the
// last name it gave; a plain one gives at most max_listed() once.
@requires(network, clock(readonly), declassify)
List(Str) list_from(Endpoint e, Str prefix, Str after, List(Str) acc) {
    HttpOut o = http_call_ep(e, "GET", "/list/" + prefix + (if (str_len(after) == 0) { "" } else { "?after=" + after }), []);
    if (o.status != 200 || o.body.len() == 0) { return acc; }
    List(Str) page = str_split(text_of_body(o.body, 0, StrBuf()), "\n");
    List(Str) all = acc.concat(page);
    Bool more = page.len() >= max_listed() && page[page.len() - 1] != after && all.len() < 1048576;
    return if (more) { list_from(e, prefix, page[page.len() - 1], all) } else { all };
}

Str text_of_body(List(Int) b, Int i, StrBuf acc) {
    if (i >= b.len()) { return acc.finish(); }
    return text_of_body(b, i + 1, acc.push(str_from_code(b[i])));
}

// A witness's co-signature on (l, seq, d), checked here under its key.
// `events`: the log up to and including the event at `seq` whose digest is
// `d`, as cosign_request takes it.
@requires(network, clock(readonly), declassify)
pub Option(WitnessCosignature) cosign_from(Endpoint e, List(Int) wkey, List(Int) l, UInt(64) seq, List(Int) d, List(List(Int)) events) {
    CosignOut o = cosign_try(e, wkey, l, seq, d, events, None);
    return o.cosig;
}

// A witness's answer to a co-sign request with the relay's claim `c`:
// its co-signature, or, when it refused because it holds another digest
// at the sequence (409), that digest and the relay claim it co-signed it
// with (`other` empty when it gave none).
pub type CosignOut = { Option(WitnessCosignature) cosig; List(Int) other; Option(RelayClaim) other_claim; };

@requires(network, clock(readonly), declassify)
pub CosignOut cosign_try(Endpoint e, List(Int) wkey, List(Int) l, UInt(64) seq, List(Int) d, List(List(Int)) events, Option(RelayClaim) c) {
    HttpOut o = cosign_post(e, l, events, c);
    if (o.status == 409) {
        Option(Held) h = held_of(o.body);
        return match h {
            None => CosignOut {.cosig = None, .other = [], .other_claim = None},
            Some(x) => CosignOut {.cosig = None, .other = x.digest, .other_claim = x.claim}
        };
    }
    Option(WitnessCosignature) w = if (o.status == 200) { cosig_of(o.body, wkey, l, seq, d) } else { None };
    return CosignOut {.cosig = w, .other = [], .other_claim = None};
}

// The co-sign request for the last of `events` (the log from E0, each as
// the relay stores it), as small as the witness lets it be (SPEC 20.3,
// R3P-2): cosign_first, then cosign_next on each answer until it is done;
// the last answer is the witness's.
@requires(network, clock(readonly), declassify)
HttpOut cosign_post(Endpoint e, List(Int) l, List(List(Int)) events, Option(RelayClaim) c) {
    HttpOut o = cosign_steps(e, l, events, c, cosign_first(l, events, c));
    return o;
}

@requires(network, clock(readonly), declassify)
HttpOut cosign_steps(Endpoint e, List(Int) l, List(List(Int)) events, Option(RelayClaim) c, CoStep s) {
    HttpOut o = http_call_ep(e, "POST", s.path, s.body);
    CoStep nx = cosign_next(l, events, c, s, o.status, o.body);
    return if (nx.done) { o } else { cosign_steps(e, l, events, c, nx) };
}

// One request of the exchange: POST `path` with `body`, whose events run
// from sequence `from`; `probe` for the first, the last two events;
// `round` counts the /catchup parts; `done` when the last answer is final.
pub type CoStep = { Str path; List(Int) body; Int from; Int round; Bool probe; Bool done; };

CoStep co_done() { return CoStep {.path = "", .body = [], .from = 0, .round = 0, .probe = false, .done = true}; }

// The first request: the last two events, from sequence n-1 (a witness
// that co-signed event n-1 verified and kept the log before it); the whole
// log when it is E0 alone.
pub CoStep cosign_first(List(Int) l, List(List(Int)) events, Option(RelayClaim) c) {
    Int n = events.len() - 1;
    if (n <= 0) { return CoStep {.path = "/cosign", .body = cosign_request_claimed(l, events, c), .from = 0, .round = 0, .probe = false, .done = false}; }
    return CoStep {.path = "/cosign", .body = cosign_delta(l, n - 1, events[n - 1..n + 1], c), .from = n - 1, .round = 0, .probe = true, .done = false};
}

// The request after the answer (`status`, `body`) to `s`. After the first: done unless the
// witness keeps less (412, CBOR [next]: from where it keeps) or does not
// know the incremental form (400: from E0). After a /catchup part: on
// from where the witness keeps the log now, provided it moved on (or asks,
// once, for an earlier start), at most cosign_max_rounds() parts. A
// /cosign that is not the first is final. Whatever the witness answers
// only steers what is sent: it verifies every event it is shown.
pub CoStep cosign_next(List(Int) l, List(List(Int)) events, Option(RelayClaim) c, CoStep s, Int status, List(Int) body) {
    Int n = events.len() - 1;
    if (s.probe) {
        if (status != 412 && status != 400) { return co_done(); }
        Int from = if (status == 412) { witness_next_of(body) } else { 0 };
        if (from < 0 || from >= n - 1) { return co_done(); }
        CoStep p = cosign_plan(l, events, c, from, 0);
        return p;
    }
    if (s.path != "/catchup") { return co_done(); }
    Int next = if (status == 200 || status == 412) { witness_next_of(body) } else { -1 };
    Bool on = next > s.from || (status == 412 && next >= 0 && next < s.from);
    if (!on || next > n || s.round + 1 >= cosign_max_rounds()) { return co_done(); }
    CoStep p2 = cosign_plan(l, events, c, next, s.round + 1);
    return p2;
}

// From sequence `from`: the rest in one /cosign when it fits (the old
// whole-log form from E0, which every witness takes), else the next part
// of the co-signed events before the last as a /catchup.
CoStep cosign_plan(List(Int) l, List(List(Int)) events, Option(RelayClaim) c, Int from, Int round) {
    Int n = events.len() - 1;
    Int fit = events_fitting(events, from, n + 1, 0, 0);
    if (from + fit > n) {
        List(Int) body = if (from == 0) { cosign_request_claimed(l, events, c) } else { cosign_delta(l, from, events[from..n + 1], c) };
        return CoStep {.path = "/cosign", .body = body, .from = from, .round = round, .probe = false, .done = false};
    }
    Int upto = if (fit < 1) { from + 1 } else { from + fit };
    return CoStep {.path = "/catchup", .body = cosign_delta(l, from, events[from..upto], None), .from = from, .round = round, .probe = false, .done = false};
}

pub Int cosign_max_rounds() { return 64; }

// How many of events[i..upto] fit in one request (cosign_max_bytes(),
// cosign_max_events()).
Int events_fitting(List(List(Int)) es, Int i, Int upto, Int count, Int bytes) {
    if (i >= upto || count >= cosign_max_events()) { return count; }
    Int b = bytes + es[i].len() + 9;
    if (b + 256 > cosign_max_bytes()) { return count; }
    return events_fitting(es, i + 1, upto, count + 1, b);
}

pub Option(WitnessCosignature) cosig_of(List(Int) b, List(Int) wkey, List(Int) l, UInt(64) seq, List(Int) d) {
    // [uint time, bytes(64)]
    if (b.len() < 3 || b[0] != 130) { return None; }
    Int ib = b[1];
    Int ai = ib & 31;
    Int n = if (ai < 24) { 0 } else { if (ai == 24) { 1 } else { if (ai == 25) { 2 } else { if (ai == 26) { 4 } else { if (ai == 27) { 8 } else { -1 } } } } };
    if ((ib >> 5) != 0 || n < 0 || 2 + n + 2 + 64 != b.len()) { return None; }
    Int t = if (n == 0) { ai } else { be_at(b, 2, n, 0) };
    if (b[2 + n] != 88 || b[3 + n] != 64) { return None; }
    List(Int) sig = b[4 + n..b.len()];
    if (!ecdsa_verify_raw(P256, Sha256, wkey, witness_message(l, seq, d), sig)) { return None; }
    return Some(WitnessCosignature {.log_id = l, .sequence = seq, .digest = d, .witness_key = wkey, .signature = sig, .witness_time = (UInt(64))t});
}

// ─── The sequencing relay (SPEC 20.3, agent/relaysrv.resid) ─────

// Proof that the log's relay `sq` equivocated (SPEC 20.4): it claimed `d`
// at `n` of log `l` for this device (`mine`, checked by the caller) and a
// witness (`outs`, the witnesses' answers) holds another digest there
// under a claim of the same relay: two signatures of the relay over two
// events at one sequence. "" when there is no such pair.
pub Str equivocation_in(WitnessRef sq, List(Int) l, Int n, List(Int) d, RelayClaim mine, List(CosignOut) outs, Int i) {
    Str why = equivocation_after(sq, l, n, d, mine, [], outs, i);
    return why;
}

// As equivocation_in, but a claim the relay's answer carried as lapsed
// (R3P-6) is none: `lapsed` are those records of it (CBOR [event,
// claim]) whose claim the caller checked is the relay's on that event
// and whose event it found can no longer be co-signed
// (core/log.resid il_lapsed), and a claim of them made at least
// claim_lapse_secs() before `mine` is the relay's earlier claim, not a
// second one.
pub Str equivocation_after(WitnessRef sq, List(Int) l, Int n, List(Int) d, RelayClaim mine, List(List(Int)) lapsed, List(CosignOut) outs, Int i) {
    if (i >= outs.len()) { return ""; }
    CosignOut o = outs[i];
    RelayClaim theirs = o.other_claim else { RelayClaim {.time = -1, .sig = []} };
    Bool two = o.other.len() == 32 && !bytes_eq(o.other, d) && theirs.time >= 0 && claim_ok(sq, l, n, o.other, theirs)
        && !lapsed_claim(lapsed, o.other, theirs, mine.time, 0);
    if (!two) { return equivocation_after(sq, l, n, d, mine, lapsed, outs, i + 1); }
    return f"relay equivocation: the log's relay {sq.url} claimed sequence {n} for two events, "
        + f"{hex_encode(d)} (claim {hex_encode(claim_cbor(mine))}) and {hex_encode(o.other)} (claim {hex_encode(claim_cbor(theirs))}); "
        + "keep both as proof and move the log to another relay (SPEC 20.4)";
}

// The relay's claim margin (agent/relaysrv.resid claim_margin_secs): a
// claim lapses no sooner than this after it was made.
pub Int claim_lapse_secs() { return 300; }

Bool lapsed_claim(List(List(Int)) recs, List(Int) d, RelayClaim c, Int later, Int i) {
    if (i >= recs.len()) { return false; }
    Option(ClaimRecord) r = claim_record_of(recs[i]);
    Bool hit = match r {
        None => false,
        Some(x) => bytes_eq(x.claim.sig, c.sig) && x.claim.time == c.time && c.time + claim_lapse_secs() <= later
    };
    return hit || lapsed_claim(recs, d, c, later, i + 1);
}



// The relay's claim key (GET /claim-key, hex); [] when it serves none.
@requires(network, clock(readonly), declassify)
pub List(Int) claim_key_get(Endpoint e) {
    HttpOut o = http_call_ep(e, "GET", "/claim-key", []);
    if (o.status != 200) { return []; }
    List(Int) k = cose_hex_decode(str_trim(text_of_body(o.body, 0, StrBuf())));
    return if (k.len() == 65 && ec_public_ok(P256, k)) { k } else { [] };
}

// The relay's answer to POST /claim/<log>/<n> with an event (as the relay
// stores it, without co-signatures): 200 with its claim on that event,
// 409 with the event it claimed there before and that claim (`event` and
// `claim` from CBOR [event, [time, r || s]]), or another status (a relay
// that does not sequence: 404) with neither.
// `lapsed`: the records of the claims at that sequence that lapsed before
// this one (R3P-6), oldest first.
pub type ClaimOut = { Int status; List(Int) event; Option(RelayClaim) claim; List(List(Int)) lapsed; };

@requires(network, clock(readonly), declassify)
pub ClaimOut claim_post(Endpoint e, List(Int) l, UInt(64) n, List(Int) stored_event) {
    HttpOut o = http_call_ep(e, "POST", "/claim/" + hex_encode(l) + "/" + f"{n}", stored_event);
    Bool answered = o.status == 200 || o.status == 409;
    Option(ClaimRecord) r = if (answered) { claim_record_of(o.body) } else { None };
    return match r {
        None => ClaimOut {.status = if (answered) { 502 } else { o.status }, .event = [], .claim = None, .lapsed = []},
        Some(x) => ClaimOut {.status = o.status, .event = x.event, .claim = Some(x.claim), .lapsed = claim_lapsed_of(o.body)}
    };
}

// A witness's current time, checked under its key and bound to `nonce`.
@requires(network, clock(readonly), declassify)
pub Option(Int) time_from(Endpoint e, List(Int) wkey, List(Int) nonce) {
    HttpOut o = http_call_ep(e, "POST", "/time", nonce);
    if (o.status != 200) { return None; }
    List(Int) b = o.body;
    if (b.len() < 3 || b[0] != 130) { return None; }
    Int ib = b[1];
    Int ai = ib & 31;
    Int n = if (ai < 24) { 0 } else { if (ai == 24) { 1 } else { if (ai == 25) { 2 } else { if (ai == 26) { 4 } else { if (ai == 27) { 8 } else { -1 } } } } };
    if ((ib >> 5) != 0 || n < 0 || 2 + n + 2 + 64 != b.len()) { return None; }
    Int t = if (n == 0) { ai } else { be_at(b, 2, n, 0) };
    if (b[2 + n] != 88 || b[3 + n] != 64) { return None; }
    return if (ecdsa_verify_raw(P256, Sha256, wkey, time_message(nonce, t), b[4 + n..b.len()])) { Some(t) } else { None };
}

// ============================================================================
// Mail credentials (SPEC 20.2)
// ============================================================================
//
// The relay keeps a mailbox message only from a known party of the
// recipient's log: the sender's bearer session (`Authorization: Bearer`,
// a device's sign-in or a mail session from POST /auth/mail) names its
// log and party, and the recipient must be a party of that same log (its
// quorum, a proposed party, or a party of a pending recovery). The one
// exception is a party of no log yet (an inception): its owner opens its
// mailbox for at most a day (POST /mbox-open/<party>, signed with the key
// whose SHA-256 is the party id), and anonymous posts to an opened mailbox
// count against the relay's budget for all anonymous writes.

List(Int) svc_be8(Int v) { return [(v >> 56) & 255, (v >> 48) & 255, (v >> 40) & 255, (v >> 32) & 255, (v >> 24) & 255, (v >> 16) & 255, (v >> 8) & 255, v & 255]; }

// What a party signs for a mail session: the relay's name and a challenge
// from GET /auth/challenge, apart from a device's sign-in.
pub List(Int) mail_auth_message(Str name, List(Int) chal) { return ascii("symbolon v1 relay mail auth " + name + "\n").concat(chal); }

// What a party of no log yet signs to open its mailbox until `until`.
pub List(Int) mbox_open_message(List(Int) party, Int until) { return ascii("symbolon v1 mailbox open\n").concat(party).concat(svc_be8(until)); }

// The longest a mailbox stays open: a day.
pub Int mbox_open_secs() { return 86400; }

// What a cosigner signs for the alert `name` whose sealed lines are `rest`.
pub List(Int) alert_sig_message(Str name, List(Int) rest) { return ascii("symbolon v1 alert " + name + "\n").concat(sha256_bytes(rest)); }

// A signed alert: "sig1 HEX -\n", then the sealed lines (a reader from
// before signatures skips the first line: it is not "ENC CT").
pub List(Int) alert_signed(List(Int) sig, List(Int) rest) { return ascii("sig1 " + hex_encode(sig) + " -\n").concat(rest); }

pub type AlertParts = { List(Int) sig; List(Int) rest; };

// The signature and the sealed lines of a signed alert; an empty `sig`
// when it is not one.
pub AlertParts alert_parts(List(Int) b) {
    AlertParts none = AlertParts {.sig = [], .rest = []};
    if (b.len() < 136 || b[135] != 10 || b[133] != 32 || b[134] != 45 || http_text(b, 0, 5) != "sig1 ") { return none; }
    Str h = http_text(b, 5, 133);
    if (!hex_name(h, 0)) { return none; }
    return AlertParts {.sig = cose_hex_decode(h), .rest = b[136..b.len()]};
}

// What the relay keeps in place of a mailbox message older than 30 days:
// readers skip it without a word, and the indexes after it stay.
pub List(Int) mail_expired_body() { return ascii("symbolon expired message"); }

pub Bool mail_expired(List(Int) b) { return b.len() == 24 && http_text(b, 0, 24) == "symbolon expired message"; }

// A sign-in challenge from the relay (hex); "" when it gave none.
@requires(network, clock(readonly), declassify)
pub Str relay_challenge(Endpoint e) {
    HttpOut ch = http_call_ep(e, "GET", "/auth/challenge", []);
    Str c = str_trim(http_text(ch.body, 0, ch.body.len()));
    return if (ch.status == 200 && str_len(c) == 64) { c } else { "" };
}

// A mail session for `party` of log `l`: "TOKEN UNTIL", or "" when the
// relay refused. `sig` is over mail_auth_message(name, challenge).
@requires(network, clock(readonly), declassify)
pub Str mail_session_from(Endpoint e, Str chal, List(Int) l, List(Int) party, List(Int) sig, Str name) {
    HttpOut r = http_call_ep(e, "POST", "/auth/mail", ascii(chal + " " + hex_encode(l) + " " + hex_encode(party) + " " + hex_encode(sig) + " " + name));
    Str t = str_trim(http_text(r.body, 0, r.body.len()));
    return if (r.status == 200 && str_len(t) > 65) { t } else { "" };
}

// Opens the mailbox of the party whose key is `pubkey` until `until`; `sig`
// is over mbox_open_message.
@requires(network, clock(readonly), declassify)
pub Bool mbox_open(Endpoint e, List(Int) pubkey, Int until, List(Int) sig) {
    return http_call_ep(e, "POST", "/mbox-open/" + hex_encode(sha256_bytes(pubkey)), ascii(hex_encode(pubkey) + " " + f"{until} " + hex_encode(sig))).status == 200;
}
