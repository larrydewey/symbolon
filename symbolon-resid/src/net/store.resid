// Where the relay keeps what it is given (SPEC 29.9): a directory (one
// box, Symbolon Home), PostgreSQL, or an S3-compatible object store. With
// either of the last two the relay holds nothing of its own, so several
// relay processes run behind a load balancer.
//
// Keys are paths of [a-z0-9._-] segments: "blob/NAME", "log/LOG/SEQ",
// "mbox/TO/N", "auth/...", "suspended/ORG/LOG", "scim/...". Objects that are
// a history (log events, mailbox messages, audit events) are written with
// st_put_new, which only one writer wins, in every backend.
//
//   --store DIR                                  a directory (the default: the relay's DIR)
//   --store postgres://USER:PASSWORD@HOST:PORT/DB[?sslmode=verify-full]   table symbolon_objects (made on start);
//                                                TLS under --store-ca FILE
//   --store s3://KEY-ID:SECRET@HOST:PORT/BUCKET?region=R   (--store-ca FILE for HTTPS)
//
// A directory store on a sealed Symbolon Home box names the box key in
// memory at its root (.box-seal.path, agent/boxseal.resid): every object is
// then written sealed under it, for its key (an object opens only under
// its own key), and nothing at all when the key is not in memory; objects
// read are opened, and one that is not sealed for its key reads as none
// (home secure and home serve seal the objects from before in place).

import "pg.resid";
import "s3.resid";
import "crypto.resid";
import "../agent/boxseal.resid";

pub type StoreCfg = Fs(Str) | Pg(PgCfg) | S3(S3Cfg);
pub type Store = FsStore(Str) | PgStore(PgConn) | PgTlsStore(PgCfg) | S3Store(S3Cfg);

pub Option(StoreCfg) store_cfg(Str spec, Str dir, Str ca) {
    if (str_len(spec) == 0) { return Some(Fs(dir)); }
    if (str_starts_with(spec, "postgres://")) { return match pg_url(spec, ca, dir) { Some(c) => Some(Pg(c)), None => None }; }
    if (str_starts_with(spec, "s3://")) { return match s3_url(spec, ca) { Some(c) => Some(S3(c)), None => None }; }
    return Some(Fs(spec));
}

pub Str pg_table() { return "symbolon_objects"; }

// Ready to use (the table made); "" or why not.
@requires(filesystem, network, clock(readonly), declassify)
pub Str store_prepare(StoreCfg c) {
    return match c {
        Fs(d) => if (filesystem.create_dir(d) || filesystem.is_dir(d)) { "" } else { "cannot make the directory" },
        Pg(p) => pg_prepare(p),
        S3(s) => s3_ready(s)
    };
}

// The bucket answers, and keeps write-once objects: a second PUT of one
// key with If-None-Match: * is refused. A store that ignores the header
// (some S3-compatible servers do) would let a second writer replace a log
// event, an audit event or a governance version, so the relay does not
// start on it.
@requires(filesystem, network, clock(readonly), declassify)
pub Str s3_ready(S3Cfg s) {
    if (s3_call(s, "GET", "", "list-type=2&max-keys=1", "", []).status != 200) { return "the bucket does not answer"; }
    Str k = "probe/write-once-" + hex_encode(random_bytes(8));
    Int first = s3_put_new(s, k, [1]);
    Int second = s3_put_new(s, k, [2]);
    _ = s3_call(s, "DELETE", k, "", "", []);
    if (first != 1) { return "the bucket does not take a new object"; }
    return if (second == 0) { "" } else { "the bucket does not refuse a second write of an object with If-None-Match: * (write-once objects would not be)" };
}

@requires(filesystem, network, clock(readonly), declassify)
Str pg_prepare(PgCfg p) {
    Str make = "CREATE TABLE IF NOT EXISTS " + pg_table() + " (k text COLLATE \"C\" PRIMARY KEY, v bytea NOT NULL)";
    if (p.tls) {
        PgResult t = pg_tls_exec(p, make, []);
        // Two relays starting together can race on IF NOT EXISTS; the loser's
        // second try finds the table.
        return if (str_len(t.err) > 0) { pg_tls_exec(p, make, []).err } else { "" };
    }
    PgConn c = pg_connect(p);
    if (c.fd < 0) { return c.err; }
    PgResult r = pg_exec(c, make, []);
    PgResult r2 = if (str_len(r.err) > 0) { pg_exec(c, make, []) } else { r };
    _ = pg_close(c);
    return r2.err;
}

@requires(filesystem, network, declassify)
pub Store store_open(StoreCfg c) {
    return match c { Fs(d) => FsStore(d), Pg(p) => if (p.tls) { PgTlsStore(p) } else { PgStore(pg_connect(p)) }, S3(s) => S3Store(s) };
}

// One statement on whichever Postgres connection the store has.
@requires(filesystem, network, clock(readonly), declassify)
PgResult pgq(Store s, Str sql, List(List(Int)) ps) {
    return match s { PgStore(c) => pg_exec(c, sql, ps), PgTlsStore(p) => pg_tls_exec(p, sql, ps), _ => PgResult {.rows = [], .tag = "", .err = "not a database"} };
}

@requires(network)
pub Int store_close(Store s) { return match s { PgStore(c) => pg_close(c), _ => 0 }; }

pub Bool store_ok(Store s) { return match s { PgStore(c) => c.fd >= 0, _ => true }; }

List(Int) utf(Str s) { return str_to_bytes(s); }

// ─── Operations ─────────────────────────────────────────────────

@requires(filesystem, network, clock(readonly), declassify)
pub Option(List(Int)) st_get(Store s, Str k) {
    return match s {
        FsStore(d) => if (filesystem.exists(d + "/" + k) && !filesystem.is_dir(d + "/" + k)) { seal_unwrap(d, k, filesystem.read_bytes(d + "/" + k)) } else { None },
        PgStore(c) => first_col(pgq(s, "SELECT v FROM " + pg_table() + " WHERE k = $1", [utf(k)])),
        PgTlsStore(c) => first_col(pgq(s, "SELECT v FROM " + pg_table() + " WHERE k = $1", [utf(k)])),
        S3Store(c) => s3_get(c, k)
    };
}

Option(List(Int)) first_col(PgResult r) {
    if (str_len(r.err) > 0 || r.rows.len() == 0 || r.rows[0].len() == 0) { return None; }
    return r.rows[0][0];
}

// The object, or empty bytes when there is none.
@requires(filesystem, network, clock(readonly), declassify)
pub List(Int) st_bytes(Store s, Str k) { return st_get(s, k) else { [] }; }

@requires(filesystem, network, clock(readonly), declassify)
pub Bool st_put(Store s, Str k, List(Int) b) {
    return match s {
        FsStore(d) => match seal_wrap(d, k, b) { None => false, Some(x) => fs_dirs(d, str_split(k, "/"), 0) && fs_replace(d + "/" + k, x) },
        PgStore(c) => str_len(pgq(s, "INSERT INTO " + pg_table() + " (k, v) VALUES ($1, $2) ON CONFLICT (k) DO UPDATE SET v = EXCLUDED.v", [utf(k), b]).err) == 0,
        PgTlsStore(c) => str_len(pgq(s, "INSERT INTO " + pg_table() + " (k, v) VALUES ($1, $2) ON CONFLICT (k) DO UPDATE SET v = EXCLUDED.v", [utf(k), b]).err) == 0,
        S3Store(c) => s3_put(c, k, b)
    };
}

// 1 written, 0 there already, -1 failed.
@requires(filesystem, network, clock(readonly), declassify)
pub Int st_put_new(Store s, Str k, List(Int) b) {
    return match s {
        FsStore(d) => match seal_wrap(d, k, b) { None => -1, Some(x) => fs_put_new(d, k, x) },
        PgStore(c) => pg_new(pgq(s, "INSERT INTO " + pg_table() + " (k, v) VALUES ($1, $2) ON CONFLICT (k) DO NOTHING", [utf(k), b])),
        PgTlsStore(c) => pg_new(pgq(s, "INSERT INTO " + pg_table() + " (k, v) VALUES ($1, $2) ON CONFLICT (k) DO NOTHING", [utf(k), b])),
        S3Store(c) => s3_put_new(c, k, b)
    };
}

// A directory has no "create only if absent" that writes the whole object
// at once, so one write is made of two steps that are each atomic: a
// claim, ".NAME.claim" beside the object, made with O_EXCL (create_new),
// which only one writer gets; then the winner writes the bytes to a
// temporary file and renames it onto the name, so a reader sees nothing
// or all of it. The claim stays (the listing skips names starting with
// "."), so a later writer finds it even before the rename. A writer that
// fails gives its claim back. The claim holds the time it was made; one
// older than claim_secs() with no object beside it is a writer that died
// between its claim and its rename: the next writer moves it aside (a
// rename, which only one of them wins) and claims the name afresh.
pub Int claim_secs() { return 600; }

Str claim_of(Str p) {
    Int cut = last_slash(p, str_len(p) - 1);
    return str_slice(p, 0, cut + 1) + "." + str_slice(p, cut + 1, str_len(p)) + ".claim";
}

@requires(filesystem, network, clock(readonly), declassify)
Int fs_put_new(Str d, Str k, List(Int) b) {
    Str p = d + "/" + k;
    if (filesystem.exists(p)) { return 0; }
    if (!fs_dirs(d, str_split(k, "/"), 0)) { return -1; }
    Str claim = claim_of(p);
    Int now = clock_now_seconds();
    File c = filesystem.create_new(claim);
    if (!filesystem.is_open(c)) {
        if (!filesystem.exists(claim)) { return -1; }
        return if (claim_stale(claim, now) && !filesystem.exists(p) && took_over(claim, now)) { fs_claimed(p, claim, b) } else { 0 };
    }
    _ = filesystem.write_handle(c, utf(f"{now}"));
    _ = filesystem.close(c);
    return fs_claimed(p, claim, b);
}

// The name is ours: the bytes land whole by a rename, unless a writer from
// before claims (st_put, or an older relay) got there.
@requires(filesystem, network, clock(readonly), declassify)
Int fs_claimed(Str p, Str claim, List(Int) b) {
    if (filesystem.exists(p)) { return 0; }
    Str tmp = claim_of(p) + ".tmp-" + hex_encode(random_bytes(8));
    if (filesystem.write_bytes(tmp, b) && filesystem.rename(tmp, p)) { return 1; }
    _ = filesystem.remove(tmp);
    _ = filesystem.remove(claim);
    return -1;
}

// When the claim was made: the time it holds, or (a claim from before,
// empty) the file's own time.
@requires(filesystem)
Bool claim_stale(Str claim, Int now) {
    Str t = str_trim(text_at(filesystem.read_bytes(claim), 0, StrBuf()));
    Int at = if (str_len(t) > 0 && str_len(t) <= 19 && digits(t, 0)) { str_parse_int(t) } else { filesystem.modified_ms(claim) / 1000 };
    return at + claim_secs() < now;
}

Bool digits(Str s, Int i) { return i >= str_len(s) || (str_char_at(s, i) >= 48 && str_char_at(s, i) <= 57 && digits(s, i + 1)); }

// Moves a stale claim aside and claims the name: of two writers that found
// it stale, only one moves it; one that moved a claim made meanwhile (not
// stale) puts it back and gives up.
@requires(filesystem, network, clock(readonly), declassify)
Bool took_over(Str claim, Int now) {
    Str away = claim + ".stale-" + hex_encode(random_bytes(8));
    if (!filesystem.rename(claim, away)) { return false; }
    if (!claim_stale(away, now)) { _ = filesystem.rename(away, claim); return false; }
    _ = filesystem.remove(away);
    File c = filesystem.create_new(claim);
    if (!filesystem.is_open(c)) { return false; }
    _ = filesystem.write_handle(c, utf(f"{now}"));
    _ = filesystem.close(c);
    return true;
}

// A whole new file at `p`, by a rename: a reader sees the old bytes or the
// new, never part of them, and a crash leaves the old.
@requires(filesystem, network, clock(readonly), declassify)
Bool fs_replace(Str p, List(Int) b) {
    Str tmp = claim_of(p) + ".put-" + hex_encode(random_bytes(8));
    if (filesystem.write_bytes(tmp, b) && filesystem.rename(tmp, p)) { return true; }
    _ = filesystem.remove(tmp);
    return false;
}

// Removes the object, and in a directory its claim, so the name can be
// written once again; true when it is gone (or was not there).
@requires(filesystem, network, clock(readonly), declassify)
pub Bool st_delete(Store s, Str k) {
    return match s {
        FsStore(d) => fs_delete(d + "/" + k),
        PgStore(c) => str_len(pgq(s, "DELETE FROM " + pg_table() + " WHERE k = $1", [utf(k)]).err) == 0,
        PgTlsStore(c) => str_len(pgq(s, "DELETE FROM " + pg_table() + " WHERE k = $1", [utf(k)]).err) == 0,
        S3Store(c) => s3_deleted(s3_call(c, "DELETE", k, "", "", []).status)
    };
}

Bool s3_deleted(Int st) { return st == 200 || st == 204 || st == 404; }

@requires(filesystem)
Bool fs_delete(Str p) {
    Bool gone = filesystem.remove(p) || !filesystem.exists(p);
    if (!gone) { return false; }
    Str claim = claim_of(p);
    return filesystem.remove(claim) || !filesystem.exists(claim);
}

Int pg_new(PgResult r) { return if (str_len(r.err) > 0) { -1 } else { if (r.tag == "INSERT 0 1") { 1 } else { 0 } }; }

@requires(filesystem, network, clock(readonly), declassify)
pub Bool st_text(Store s, Str k, Str t) { return st_put(s, k, utf(t)); }

@requires(filesystem, network, clock(readonly), declassify)
pub Str st_read_text(Store s, Str k) { List(Int) b = st_bytes(s, k); return text_at(b, 0, StrBuf()); }

Str text_at(List(Int) b, Int i, StrBuf acc) { return if (i >= b.len()) { acc.finish() } else { text_at(b, i + 1, acc.push(str_from_code(b[i]))) }; }

@requires(filesystem)
Bool fs_dirs(Str d, List(Str) segs, Int i) {
    if (i + 1 >= segs.len()) { return true; }
    Str p = d + "/" + str_join(segs[0..i + 1], "/");
    _ = filesystem.create_dir(p);
    return fs_dirs(d, segs, i + 1);
}

// The keys that start with `prefix` and sort after `after`, in byte
// order, at most `max`.
@requires(filesystem, network, clock(readonly), declassify)
pub List(Str) st_list(Store s, Str prefix, Str after, Int max) {
    return match s {
        FsStore(d) => fs_list(d, prefix, after, max),
        PgStore(c) => keys_of(pgq(s, "SELECT k FROM " + pg_table() + " WHERE starts_with(k, $1) AND k > $2 ORDER BY k LIMIT " + f"{max}", [utf(prefix), utf(after)]).rows, 0, ListBuf()),
        PgTlsStore(c) => keys_of(pgq(s, "SELECT k FROM " + pg_table() + " WHERE starts_with(k, $1) AND k > $2 ORDER BY k LIMIT " + f"{max}", [utf(prefix), utf(after)]).rows, 0, ListBuf()),
        S3Store(c) => capped(s3_list(c, prefix, after, max), max)
    };
}

List(Str) capped(List(Str) xs, Int max) { return if (xs.len() > max) { xs[0..max] } else { xs }; }

List(Str) keys_of(List(List(Option(List(Int)))) rows, Int i, ListBuf(Str) acc) {
    if (i >= rows.len()) { return acc.finish(); }
    Option(List(Int)) k = if (rows[i].len() > 0) { rows[i][0] } else { None };
    return keys_of(rows, i + 1, match k { Some(b) => acc.push(text_at(b, 0, StrBuf())), None => acc });
}

@requires(filesystem)
List(Str) fs_list(Str d, Str prefix, Str after, Int max) {
    Int cut = last_slash(prefix, str_len(prefix) - 1);
    Str sub = if (cut < 0) { "" } else { str_slice(prefix, 0, cut + 1) };
    Str base = str_slice(prefix, cut + 1, str_len(prefix));
    Str dir = d + "/" + sub;
    if (!filesystem.is_dir(dir)) { return []; }
    return capped(sort(fs_names(filesystem.list_dir(dir), sub, base, after, 0, ListBuf())), max);
}

List(Str) fs_names(List(Str) xs, Str sub, Str base, Str after, Int i, ListBuf(Str) acc) {
    if (i >= xs.len()) { return acc.finish(); }
    Str k = sub + xs[i];
    Bool ok = str_starts_with(xs[i], base) && !str_starts_with(xs[i], ".") && (str_len(after) == 0 || after < k);
    return fs_names(xs, sub, base, after, i + 1, if (ok) { acc.push(k) } else { acc });
}

Int last_slash(Str s, Int i) {
    if (i < 0) { return -1; }
    if (str_slice(s, i, i + 1) == "/") { return i; }
    return last_slash(s, i - 1);
}
