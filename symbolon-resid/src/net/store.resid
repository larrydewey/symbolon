// Where the relay keeps what it is given (SPEC 29.9): a directory (one
// box, Symbolon Home), PostgreSQL, or an S3-compatible object store. With
// either of the last two the relay holds nothing of its own, so several
// relay processes run behind a load balancer.
//
// Keys are paths of [a-z0-9._-] segments: "blob/NAME", "log/LOG/SEQ",
// "mbox/TO/N", "auth/...", "suspended/LOG", "scim/...". Objects that are
// a history (log events, mailbox messages, audit events) are written with
// st_put_new, which only one writer wins, in every backend.
//
//   --store DIR                                  a directory (the default: the relay's DIR)
//   --store postgres://USER:PASSWORD@HOST:PORT/DB   table symbolon_objects (made on start)
//   --store s3://KEY-ID:SECRET@HOST:PORT/BUCKET?region=R   (--store-ca FILE for HTTPS)

import "pg.resid";
import "s3.resid";
import "crypto.resid";

pub type StoreCfg = Fs(Str) | Pg(PgCfg) | S3(S3Cfg);
pub type Store = FsStore(Str) | PgStore(PgConn) | S3Store(S3Cfg);

pub Option(StoreCfg) store_cfg(Str spec, Str dir, Str ca) {
    if (str_len(spec) == 0) { return Some(Fs(dir)); }
    if (str_starts_with(spec, "postgres://")) { return match pg_url(spec) { Some(c) => Some(Pg(c)), None => None }; }
    if (str_starts_with(spec, "s3://")) { return match s3_url(spec, ca) { Some(c) => Some(S3(c)), None => None }; }
    return Some(Fs(spec));
}

pub Str pg_table() { return "symbolon_objects"; }

// Ready to use (the table made); "" or why not.
@requires(filesystem, network, clock(readonly), declassify)
pub Str store_prepare(StoreCfg c) {
    return match c {
        Fs(d) => if (filesystem.create_dir(d) || filesystem.is_dir(d)) { "" } else { "cannot make the directory" },
        Pg(p) => pg_prepare(p),
        S3(s) => if (s3_call(s, "GET", "", "list-type=2&max-keys=1", "", []).status == 200) { "" } else { "the bucket does not answer" }
    };
}

@requires(network, declassify)
Str pg_prepare(PgCfg p) {
    PgConn c = pg_connect(p);
    if (c.fd < 0) { return c.err; }
    Str make = "CREATE TABLE IF NOT EXISTS " + pg_table() + " (k text COLLATE \"C\" PRIMARY KEY, v bytea NOT NULL)";
    PgResult r = pg_exec(c, make, []);
    // Two relays starting together can race on IF NOT EXISTS; the loser's
    // second try finds the table.
    PgResult r2 = if (str_len(r.err) > 0) { pg_exec(c, make, []) } else { r };
    _ = pg_close(c);
    return r2.err;
}

@requires(network, declassify)
pub Store store_open(StoreCfg c) {
    return match c { Fs(d) => FsStore(d), Pg(p) => PgStore(pg_connect(p)), S3(s) => S3Store(s) };
}

@requires(network)
pub Int store_close(Store s) { return match s { PgStore(c) => pg_close(c), _ => 0 }; }

pub Bool store_ok(Store s) { return match s { PgStore(c) => c.fd >= 0, _ => true }; }

List(Int) utf(Str s) { return str_to_bytes(s); }

// ─── Operations ─────────────────────────────────────────────────

@requires(filesystem, network, clock(readonly), declassify)
pub Option(List(Int)) st_get(Store s, Str k) {
    return match s {
        FsStore(d) => if (filesystem.exists(d + "/" + k) && !filesystem.is_dir(d + "/" + k)) { Some(filesystem.read_bytes(d + "/" + k)) } else { None },
        PgStore(c) => first_col(pg_exec(c, "SELECT v FROM " + pg_table() + " WHERE k = $1", [utf(k)])),
        S3Store(c) => s3_get(c, k)
    };
}

Option(List(Int)) first_col(PgResult r) {
    if (str_len(r.err) > 0 || r.rows.len() == 0 || r.rows[0].len() == 0) { return None; }
    return r.rows[0][0];
}

// The object, or empty bytes when there is none.
@requires(filesystem, network, clock(readonly), declassify)
pub List(Int) st_bytes(Store s, Str k) { return st_get(s, k) else { [] }; }

@requires(filesystem, network, clock(readonly), declassify)
pub Bool st_put(Store s, Str k, List(Int) b) {
    return match s {
        FsStore(d) => fs_dirs(d, str_split(k, "/"), 0) && filesystem.write_bytes(d + "/" + k, b),
        PgStore(c) => str_len(pg_exec(c, "INSERT INTO " + pg_table() + " (k, v) VALUES ($1, $2) ON CONFLICT (k) DO UPDATE SET v = EXCLUDED.v", [utf(k), b]).err) == 0,
        S3Store(c) => s3_put(c, k, b)
    };
}

// 1 written, 0 there already, -1 failed.
@requires(filesystem, network, clock(readonly), declassify)
pub Int st_put_new(Store s, Str k, List(Int) b) {
    return match s {
        FsStore(d) => if (filesystem.exists(d + "/" + k)) { 0 } else { if (fs_dirs(d, str_split(k, "/"), 0) && filesystem.write_bytes(d + "/" + k, b)) { 1 } else { -1 } },
        PgStore(c) => pg_new(pg_exec(c, "INSERT INTO " + pg_table() + " (k, v) VALUES ($1, $2) ON CONFLICT (k) DO NOTHING", [utf(k), b])),
        S3Store(c) => s3_put_new(c, k, b)
    };
}

Int pg_new(PgResult r) { return if (str_len(r.err) > 0) { -1 } else { if (r.tag == "INSERT 0 1") { 1 } else { 0 } }; }

@requires(filesystem, network, clock(readonly), declassify)
pub Bool st_text(Store s, Str k, Str t) { return st_put(s, k, utf(t)); }

@requires(filesystem, network, clock(readonly), declassify)
pub Str st_read_text(Store s, Str k) { List(Int) b = st_bytes(s, k); return text_at(b, 0, StrBuf()); }

Str text_at(List(Int) b, Int i, StrBuf acc) { return if (i >= b.len()) { acc.finish() } else { text_at(b, i + 1, acc.push(str_from_code(b[i]))) }; }

@requires(filesystem)
Bool fs_dirs(Str d, List(Str) segs, Int i) {
    if (i + 1 >= segs.len()) { return true; }
    Str p = d + "/" + str_join(segs[0..i + 1], "/");
    _ = filesystem.create_dir(p);
    return fs_dirs(d, segs, i + 1);
}

// The keys that start with `prefix` and sort after `after`, in byte
// order, at most `max`.
@requires(filesystem, network, clock(readonly), declassify)
pub List(Str) st_list(Store s, Str prefix, Str after, Int max) {
    return match s {
        FsStore(d) => fs_list(d, prefix, after, max),
        PgStore(c) => keys_of(pg_exec(c, "SELECT k FROM " + pg_table() + " WHERE starts_with(k, $1) AND k > $2 ORDER BY k LIMIT " + f"{max}", [utf(prefix), utf(after)]).rows, 0, ListBuf()),
        S3Store(c) => capped(s3_list(c, prefix, after, max), max)
    };
}

List(Str) capped(List(Str) xs, Int max) { return if (xs.len() > max) { xs[0..max] } else { xs }; }

List(Str) keys_of(List(List(Option(List(Int)))) rows, Int i, ListBuf(Str) acc) {
    if (i >= rows.len()) { return acc.finish(); }
    Option(List(Int)) k = if (rows[i].len() > 0) { rows[i][0] } else { None };
    return keys_of(rows, i + 1, match k { Some(b) => acc.push(text_at(b, 0, StrBuf())), None => acc });
}

@requires(filesystem)
List(Str) fs_list(Str d, Str prefix, Str after, Int max) {
    Int cut = last_slash(prefix, str_len(prefix) - 1);
    Str sub = if (cut < 0) { "" } else { str_slice(prefix, 0, cut + 1) };
    Str base = str_slice(prefix, cut + 1, str_len(prefix));
    Str dir = d + "/" + sub;
    if (!filesystem.is_dir(dir)) { return []; }
    return capped(sort(fs_names(filesystem.list_dir(dir), sub, base, after, 0, ListBuf())), max);
}

List(Str) fs_names(List(Str) xs, Str sub, Str base, Str after, Int i, ListBuf(Str) acc) {
    if (i >= xs.len()) { return acc.finish(); }
    Str k = sub + xs[i];
    Bool ok = str_starts_with(xs[i], base) && !str_starts_with(xs[i], ".") && (str_len(after) == 0 || after < k);
    return fs_names(xs, sub, base, after, i + 1, if (ok) { acc.push(k) } else { acc });
}

Int last_slash(Str s, Int i) {
    if (i < 0) { return -1; }
    if (str_slice(s, i, i + 1) == "/") { return i; }
    return last_slash(s, i - 1);
}
