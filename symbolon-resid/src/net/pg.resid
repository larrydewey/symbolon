// A PostgreSQL client (frontend/backend protocol 3.0) for the relay's
// storage (SPEC 29.9): one connection per request, SCRAM-SHA-256
// authentication (RFC 5802, RFC 7677) or trust, and the extended query
// protocol with binary parameters and results, so object bytes are never
// quoted into SQL.
//
// Plain TCP keeps one connection per request. With TLS (`?sslmode=verify-full`
// and a trust anchor) the client asks for it (SSLRequest) and runs TLS 1.3
// over the same socket, the server's certificate checked for the host;
// each statement then has a connection of its own (a TLS connection's
// state cannot outlive the call that holds it), and the SCRAM salted
// password is kept in `cache` (a file per salt) so a connection costs one
// handshake, not a key derivation. The database password never crosses
// the wire (SCRAM).

import "crypto.resid";
import "wire.resid";
import "tlsclient.resid";
import "clock.resid";

// `ca`: PEM trust anchor when `tls`; `cache`: a directory for the SCRAM salted password.
pub type PgCfg = { Str host; Int port; Str user; Str password; Str db; Bool tls; Str ca; Str cache; };

// An open, authenticated connection; fd < 0 when it failed (`err` says why).
pub type PgConn = { Int fd; Str err; };

// A statement's rows (each column's bytes; None for NULL) and its
// command tag ("INSERT 0 1", "SELECT 3", ...).
pub type PgResult = { List(List(Option(List(Int)))) rows; Str tag; Str err; };

// postgres://USER:PASSWORD@HOST:PORT/DB[?sslmode=verify-full]
pub Option(PgCfg) pg_url(Str u0, Str ca, Str cache) {
    if (!str_starts_with(u0, "postgres://")) { return None; }
    Int q = str_index_of(u0, "?", 0);
    Str u = if (q < 0) { u0 } else { str_slice(u0, 0, q) };
    Bool tls = q >= 0 && str_contains(str_slice(u0, q, str_len(u0)), "sslmode=verify-full");
    if (tls && str_len(ca) == 0) { return None; }
    Str rest = str_slice(u, 11, str_len(u));
    Int at = str_last_index_of(rest, "@");
    if (at < 0) { return None; }
    Str cred = str_slice(rest, 0, at);
    Str hp_db = str_slice(rest, at + 1, str_len(rest));
    Int colon = str_index_of(cred, ":", 0);
    Int slash = str_index_of(hp_db, "/", 0);
    if (colon < 0 || slash < 0) { return None; }
    Str hp = str_slice(hp_db, 0, slash);
    Int pc = str_index_of(hp, ":", 0);
    return Some(PgCfg {.host = if (pc < 0) { hp } else { str_slice(hp, 0, pc) }, .port = if (pc < 0) { 5432 } else { str_parse_int(str_slice(hp, pc + 1, str_len(hp))) },
                       .user = str_slice(cred, 0, colon), .password = str_slice(cred, colon + 1, str_len(cred)), .db = str_slice(hp_db, slash + 1, str_len(hp_db)),
                       .tls = tls, .ca = ca, .cache = cache});
}

Int str_last_index_of(Str s, Str c) { return last_at(s, c, str_len(s) - 1); }
Int last_at(Str s, Str c, Int i) {
    if (i < 0) { return -1; }
    if (str_slice(s, i, i + 1) == c) { return i; }
    return last_at(s, c, i - 1);
}

// ─── Bytes ──────────────────────────────────────────────────────

List(Int) be32(Int n) { return [(n >> 24) & 255, (n >> 16) & 255, (n >> 8) & 255, n & 255]; }
List(Int) be16(Int n) { return [(n >> 8) & 255, n & 255]; }
Int rd32(List(Int) b, Int i) {
    Int v = (b[i] << 24) | (b[i + 1] << 16) | (b[i + 2] << 8) | b[i + 3];
    return if (v >= 2147483648) { v - 4294967296 } else { v };
}
Int rd16(List(Int) b, Int i) { return (b[i] << 8) | b[i + 1]; }

List(Int) asc(Str s) { return str_to_bytes(s); }
List(Int) cstr(Str s) { return asc(s).concat([0]); }

// A message: type byte, length (itself included), body.
List(Int) msg(Int t, List(Int) body) { return [t].concat(be32(body.len() + 4)).concat(body); }

Str text_of(List(Int) b, Int i, Int end, StrBuf acc) {
    if (i >= end) { return acc.finish(); }
    return text_of(b, i + 1, end, acc.push(str_from_code(b[i])));
}

// ─── Reading messages ───────────────────────────────────────────

type Msg = { Int t; List(Int) body; };
type Rx(T) = { T w; List(Msg) ms; List(Int) rest; Bool ok; };

// Messages from `buf` and the connection until one of type `until`
// arrives (included), or the connection fails.
@needs(Wire(T))
Rx(T) read_until(T w, List(Int) buf, Int until, ListBuf(Msg) acc) {
    if (buf.len() >= 5) {
        Int len = rd32(buf, 1);
        if (len < 4 || len > 268435456) { return Rx {.w = w, .ms = acc.finish(), .rest = [], .ok = false}; }
        if (buf.len() >= 1 + len) {
            Msg m = Msg {.t = buf[0], .body = buf[5..1 + len]};
            List(Int) rest = buf[1 + len..buf.len()];
            if (m.t == until) { return Rx {.w = w, .ms = acc.push(m).finish(), .rest = rest, .ok = true}; }
            return read_until(w, rest, until, acc.push(m));
        }
    }
    WireIn(T) more = wire_fill(w, buf, buf.len() + 1, buf.len() + 65536);
    if (more.data.len() <= buf.len()) { return Rx {.w = more.conn, .ms = acc.finish(), .rest = [], .ok = false}; }
    return read_until(more.conn, more.data, until, acc);
}

// The 'M' (message) field of an ErrorResponse.
Str error_text(List(Int) b, Int i) {
    if (i >= b.len() || b[i] == 0) { return "the database refused"; }
    Int end = zero_at(b, i + 1);
    if (b[i] == 77) { return text_of(b, i + 1, end, StrBuf()); }
    return error_text(b, end + 1);
}

Int zero_at(List(Int) b, Int i) { return if (i >= b.len() || b[i] == 0) { i } else { zero_at(b, i + 1) }; }

Option(Msg) first_of(List(Msg) ms, Int t, Int i) {
    if (i >= ms.len()) { return None; }
    if (ms[i].t == t) { return Some(ms[i]); }
    return first_of(ms, t, i + 1);
}

// ─── SCRAM-SHA-256 ──────────────────────────────────────────────

List(Int) xor_bytes(List(Int) a, List(Int) b, Int i, ListBuf(Int) acc) {
    if (i >= a.len()) { return acc.finish(); }
    return xor_bytes(a, b, i + 1, acc.push((a[i] ^ b[i]) & 255));
}

// `key=value` from a SCRAM attribute list.
Str attr(Str s, Str k) { return attr_in(str_split(s, ","), k + "=", 0); }
Str attr_in(List(Str) xs, Str k, Int i) {
    if (i >= xs.len()) { return ""; }
    if (str_starts_with(xs[i], k)) { return str_slice(xs[i], str_len(k), str_len(xs[i])); }
    return attr_in(xs, k, i + 1);
}

pub type Scram = { Str client_final; List(Int) server_sig; };

// The client's final message and the server signature it expects, from
// the client-first-bare and server-first messages (RFC 5802 section 3).
pub Scram scram_final(List(Int) salted, Str client_first_bare, Str server_first) {
    Str nonce = attr(server_first, "r");
    List(Int) client_key = hmac_sha256_bytes(salted, asc("Client Key"));
    List(Int) stored_key = sha256_bytes(client_key);
    Str without_proof = "c=biws,r=" + nonce;
    List(Int) auth = asc(client_first_bare + "," + server_first + "," + without_proof);
    List(Int) proof = xor_bytes(client_key, hmac_sha256_bytes(stored_key, auth), 0, ListBuf());
    List(Int) server_key = hmac_sha256_bytes(salted, asc("Server Key"));
    return Scram {.client_final = without_proof + ",p=" + base64_encode(proof), .server_sig = hmac_sha256_bytes(server_key, auth)};
}

// ─── Connecting ─────────────────────────────────────────────────

// An authenticated session over the transport `T`; `err` when it failed.
pub type PgSess(T) = { T w; List(Int) rest; Str err; };

@needs(Wire(T))
PgSess(T) sess_fail(T w, Str why) { _ = wire_close(w); return PgSess {.w = w, .rest = [], .err = why}; }

// The SCRAM salted password, from `cache` when it is there.
@requires(filesystem)
List(Int) salted_password(PgCfg c, List(Int) salt, Int iters) {
    List(Int) id = sha256_bytes(asc(c.user + " " + c.password + " ").concat(salt).concat(asc(f"{iters}")));
    Str f = c.cache + "/pg-scram-" + hex_encode(id[0..16]);
    List(Int) kept = if (str_len(c.cache) > 0 && filesystem.exists(f)) { filesystem.read_bytes(f) } else { [] };
    if (kept.len() == 32) { return kept; }
    List(Int) sp = pbkdf2_hmac_sha256(asc(c.password), salt, if (iters < 1) { 1 } else { iters }, 1);
    _ = if (str_len(c.cache) > 0) { filesystem.write_secret(f, sp) } else { false };
    return sp;
}

// The startup message and authentication (SCRAM-SHA-256 or trust).
@needs(Wire(T))
@requires(filesystem, network, declassify)
pub PgSess(T) pg_auth(T w0, PgCfg c) {
    List(Int) params = cstr("user").concat(cstr(c.user)).concat(cstr("database")).concat(cstr(c.db)).concat([0]);
    WireOut(T) s0 = wire_send(w0, be32(params.len() + 8).concat(be32(196608)).concat(params));
    Rx(T) r = read_until(s0.conn, [], 82, ListBuf());
    if (!r.ok) { return sess_fail(r.w, auth_error(r.ms, "the database closed the connection")); }
    Int code = rd32(r.ms[r.ms.len() - 1].body, 0);
    if (code == 0) { return ready(r.w, r.rest); }
    if (code != 10) { return sess_fail(r.w, f"the database asks for authentication {code}; use scram-sha-256"); }
    Str cnonce = base64_encode(random_bytes(18));
    Str first_bare = "n=,r=" + cnonce;
    Str first = "n,," + first_bare;
    WireOut(T) s1 = wire_send(r.w, msg(112, cstr("SCRAM-SHA-256").concat(be32(str_len(first))).concat(asc(first))));
    Rx(T) r2 = read_until(s1.conn, r.rest, 82, ListBuf());
    if (!r2.ok) { return sess_fail(r2.w, auth_error(r2.ms, "the database ended SCRAM")); }
    Msg m2 = r2.ms[r2.ms.len() - 1];
    if (rd32(m2.body, 0) != 11) { return sess_fail(r2.w, "the database did not continue SCRAM"); }
    Str server_first = text_of(m2.body, 4, m2.body.len(), StrBuf());
    if (!str_starts_with(attr(server_first, "r"), cnonce)) { return sess_fail(r2.w, "the database's SCRAM nonce is not ours"); }
    Scram sc = scram_final(salted_password(c, base64_decode(attr(server_first, "s")), str_parse_int(attr(server_first, "i"))), first_bare, server_first);
    WireOut(T) s2 = wire_send(r2.w, msg(112, asc(sc.client_final)));
    Rx(T) r3 = read_until(s2.conn, r2.rest, 82, ListBuf());
    if (!r3.ok) { return sess_fail(r3.w, auth_error(r3.ms, "the database refused the password")); }
    Msg m3 = r3.ms[r3.ms.len() - 1];
    Str server_final = text_of(m3.body, 4, m3.body.len(), StrBuf());
    if (rd32(m3.body, 0) != 12 || !bytes_eq(base64_decode(attr(server_final, "v")), sc.server_sig)) { return sess_fail(r3.w, "the database did not prove it knows the password"); }
    Rx(T) r4 = read_until(r3.w, r3.rest, 82, ListBuf());
    if (!r4.ok || rd32(r4.ms[r4.ms.len() - 1].body, 0) != 0) { return sess_fail(r4.w, auth_error(r4.ms, "the database refused the password")); }
    return ready(r4.w, r4.rest);
}

Str auth_error(List(Msg) ms, Str dflt) { return match first_of(ms, 69, 0) { Some(e) => error_text(e.body, 0), None => dflt }; }

@needs(Wire(T))
PgSess(T) ready(T w, List(Int) rest) {
    Rx(T) r = read_until(w, rest, 90, ListBuf());
    return if (r.ok) { PgSess {.w = r.w, .rest = [], .err = ""} } else { sess_fail(r.w, auth_error(r.ms, "the database did not become ready")) };
}

// A plain connection, authenticated: kept for a whole request.
@requires(filesystem, network, declassify)
pub PgConn pg_connect(PgCfg c) {
    Int fd = resid_tcp_connect(c.host, c.port);
    if (fd < 0) { return PgConn {.fd = -1, .err = "cannot reach the database"}; }
    _ = resid_tcp_deadline(fd, 30000);
    PgSess(Int) s = pg_auth(fd, c);
    return if (str_len(s.err) == 0) { PgConn {.fd = fd, .err = ""} } else { PgConn {.fd = -1, .err = s.err} };
}

@requires(network)
pub Int pg_close(PgConn c) {
    if (c.fd < 0) { return 0; }
    _ = resid_tcp_send_bin(c.fd, msg(88, []));
    _ = resid_tcp_close(c.fd);
    return 0;
}

// TLS over a socket that asked for it (SSLRequest answered 'S'): the
// handshake as tls_client_connect does it, on this descriptor.
@requires(network, clock(readonly), declassify)
TlsDial tls_on(Int fd, PgCfg c) {
    _ = resid_tcp_send_bin(fd, be32(8).concat(be32(80877103)));
    List(Int) yes = resid_tcp_recv_some(fd, 1);
    if (yes.len() != 1 || yes[0] != 83) { _ = resid_tcp_close(fd); return tls_client_on(-1, tls_client_cfg(c.host, trust_store_empty(), [])); }
    return tls_client_on(fd, tls_client_cfg(c.host, trust_store_add_pem(trust_store_empty(), c.ca), []));
}

// One statement on a TLS connection of its own.
@requires(filesystem, network, clock(readonly), declassify)
pub PgResult pg_tls_exec(PgCfg c, Str sql, List(List(Int)) ps) {
    Int fd = resid_tcp_connect(c.host, c.port);
    if (fd < 0) { return PgResult {.rows = [], .tag = "", .err = "cannot reach the database"}; }
    _ = resid_tcp_deadline(fd, 30000);
    TlsDial d = tls_on(fd, c);
    if (d.err != "") { return PgResult {.rows = [], .tag = "", .err = "the database refused TLS, or its certificate does not verify: " + d.err}; }
    PgSess(TlsClient) s = pg_auth(d.conn, c);
    if (str_len(s.err) > 0) { return PgResult {.rows = [], .tag = "", .err = s.err}; }
    Ran(TlsClient) r = exec_on(s.w, sql, ps);
    WireOut(TlsClient) bye = wire_send(r.w, msg(88, []));
    _ = wire_close(bye.conn);
    return r.res;
}

// ─── Statements ─────────────────────────────────────────────────

List(Int) param_bytes(List(List(Int)) ps, Int i, List(Int) acc) {
    if (i >= ps.len()) { return acc; }
    return param_bytes(ps, i + 1, acc.concat(be32(ps[i].len())).concat(ps[i]));
}

type Ran(T) = { T w; PgResult res; };

// `sql` with parameters $1.. (each sent as binary: text columns take
// their UTF-8, bytea its bytes), results in binary.
@needs(Wire(T))
Ran(T) exec_on(T w, Str sql, List(List(Int)) ps) {
    List(Int) parse = msg(80, cstr("").concat(cstr(sql)).concat(be16(0)));
    List(Int) bind = msg(66, cstr("").concat(cstr("")).concat(be16(1)).concat(be16(1)).concat(be16(ps.len())).concat(param_bytes(ps, 0, [])).concat(be16(1)).concat(be16(1)));
    List(Int) exec = msg(69, cstr("").concat(be32(0)));
    WireOut(T) sent = wire_send(w, parse.concat(bind).concat(exec).concat(msg(83, [])));
    Rx(T) r = read_until(sent.conn, [], 90, ListBuf());
    if (!r.ok) { return Ran {.w = r.w, .res = PgResult {.rows = [], .tag = "", .err = "the database closed the connection"}}; }
    return Ran {.w = r.w, .res = match first_of(r.ms, 69, 0) {
        Some(e) => PgResult {.rows = [], .tag = "", .err = error_text(e.body, 0)},
        None => PgResult {.rows = rows_of(r.ms, 0, ListBuf()), .tag = tag_of(r.ms), .err = ""}
    }};
}

@requires(network)
pub PgResult pg_exec(PgConn c, Str sql, List(List(Int)) ps) {
    if (c.fd < 0) { return PgResult {.rows = [], .tag = "", .err = c.err}; }
    return exec_on(c.fd, sql, ps).res;
}

Str tag_of(List(Msg) ms) { return match first_of(ms, 67, 0) { Some(m) => text_of(m.body, 0, zero_at(m.body, 0), StrBuf()), None => "" }; }

List(List(Option(List(Int)))) rows_of(List(Msg) ms, Int i, ListBuf(List(Option(List(Int)))) acc) {
    if (i >= ms.len()) { return acc.finish(); }
    return rows_of(ms, i + 1, if (ms[i].t == 68) { acc.push(cols_of(ms[i].body, rd16(ms[i].body, 0), 2, ListBuf())) } else { acc });
}

List(Option(List(Int))) cols_of(List(Int) b, Int n, Int at, ListBuf(Option(List(Int))) acc) {
    if (n <= 0 || at + 4 > b.len()) { return acc.finish(); }
    Int len = rd32(b, at);
    if (len < 0) { return cols_of(b, n - 1, at + 4, acc.push(None)); }
    return cols_of(b, n - 1, at + 4 + len, acc.push(Some(b[at + 4..at + 4 + len])));
}
