// The Paillier nonce-1 guard (threshold.resid "Paillier nonce 1", SPEC
// 6.2.1; reshare.resid's deal): Resid's cg_unit up to master 1458799c falls
// back to the nonce 1, and Enc(m; 1) = 1 + mN shows m. A party never sends
// such a ciphertext (it draws the round again) and refuses one it receives,
// blaming no one. Fixtures (the dealer's 2-of-3 configurations) are those
// of threshold_ref_test.resid.

import "../types.resid";
import "../core/log.resid";
import "threshold.resid";
import "reshare.resid";
import "rsmsg.resid";
import "crypto.resid";
import "ecdsa.resid";
import "cose.resid";
import "word.resid";

Str hx(List(Int) b) { return hex_encode(b); }

List(UInt(64)) nat(Str h) { return bn_from_be(cose_hex_decode(h)); }

CvPt pt(Str h) { return match cv_dec(cose_hex_decode(h)) { Some(p) => p, None => cv_inf() }; }

List(Secret(UInt(8))) chain_code() { return secret_bytes(rt [180, 32, 220, 232, 175, 131, 197, 200, 20, 214, 12, 52, 0, 135, 246, 4, 161, 218, 117, 121, 183, 226, 123, 17, 191, 180, 175, 100, 122, 18, 64, 170]); }

Party party_of(List(Int) id, UInt(8) kind) {
    return Party { .id = id, .kind = kind, .auth_key = [], .hpke_key = [], .label = "p", .attestation = NoAttestation };
}

Quorum quorum() {
    return Quorum { .parties = [party_of([12, 201, 97, 213, 187, 45, 176, 173, 225, 34, 33, 242, 136, 32, 83, 104, 116, 216, 241, 101, 151, 3, 58, 6, 128, 109, 190, 241, 109, 170, 205, 19], party_kind_device()), party_of([212, 166, 176, 3, 55, 10, 159, 24, 111, 1, 17, 25, 196, 237, 97, 45, 141, 202, 178, 19, 33, 155, 159, 26, 226, 237, 208, 170, 46, 129, 215, 191], party_kind_device()),
                                 party_of([50, 193, 193, 90, 151, 15, 15, 97, 64, 114, 44, 3, 216, 218, 213, 216, 65, 78, 192, 235, 134, 75, 38, 20, 123, 65, 36, 8, 70, 62, 65, 149], party_kind_cosigner())],
                     .t = 2, .root_pubkey = [4, 28, 46, 244, 29, 171, 122, 106, 51, 151, 132, 124, 190, 95, 52, 241, 152, 190, 33, 117, 178, 29, 71, 105, 184, 126, 141, 11, 0, 125, 120, 171, 211, 162, 22, 17, 181, 109, 175, 12, 189, 181, 106, 183, 251, 18, 210, 8, 93, 234, 35, 85, 223, 122, 72, 43, 66, 212, 245, 85, 101, 25, 96, 36, 76], .epoch = 3, .transcript_digest = [], .kv_commits = [] };
}

List(CgPublicCfg) publics() { return [CgPublicCfg { .id = 1, .ecdsa = pt("03f394cdebf414f02d27f71d56a66c8393995700be1e6944d021bb372d89520700"), .elgamal = pt("02442740efb73dd60dce2b6a8ca30b198c0c7c3a4493df511096dafba94a36e66e"), .n = nat(""), .ped = Pedersen { .n = nat(""), .s = nat(""), .t = nat("") } }, CgPublicCfg { .id = 2, .ecdsa = pt("03eed386a2eff2a46435f8a2f5dda4fbd78861fd4ba321c8094afc703de315d18c"), .elgamal = pt("03b08386ea09f9ef50adee236b1b396c479c89be03119b271e0397b8f9b9dcf9d6"), .n = nat(""), .ped = Pedersen { .n = nat(""), .s = nat(""), .t = nat("") } }, CgPublicCfg { .id = 3, .ecdsa = pt("03190d7e87cc1479ae9fae2368ef487c272755eb703d67c97c33c92fd285201d9a"), .elgamal = pt("03668c6d48b15156dbaab81cf1ae826ce41a9ec171480ff6336c6424cea5dfbe06"), .n = nat(""), .ped = Pedersen { .n = nat(""), .s = nat(""), .t = nat("") } }]; }

CgConfig config(Int i) {
    if (i == 1) { return CgConfig { .id = 1, .threshold = 1, .ecdsa = nat("4abdd223646ed1dccd4671599eaff1484b3d2dcf44438624aacf0f92d97a75f1"), .elgamal = nat("be7526b89f574580dad64c0317daac42eee124a8d0f265c51bda40a5d9e13f47"), .p = nat("c7a0a26d66491aa191e208dacad5e78e23c25b4ba562ef4b3b221ff8145257be0fa8ed3d39a016c37525162e12a61ebadecb27eb243f3a34fc42d1d0b9166d8fdcb4e7811efe5f11ad35501c444f9d0675e9af4a0ceceadda6b85f5875aa5704ec6ec283301faa4bf44de4b5ec0fa15447042f413cf862f1978ffebc030cd8b3"), .q = nat("c701021e91631cbcb4777dbcb122eae89fd1c3c3bff6621ecefd132929afbbdc64468d3fddfd3cb4c7a4f5c8c014916f8a3eb850e8d38089f9e5f58922ccbdd12912e610192914bd7d841f86e12a53d30a70f41290f85a11639f5c4f45d11ed12ea3d76ed22012dbe8b73a90fa3bea819dcc99b2a7378dc48019b415561cfe17"), .rid = [], .chain_key = [], .public = publics() }; }
    if (i == 2) { return CgConfig { .id = 2, .threshold = 1, .ecdsa = nat("303d9a7201458ee40a7d4714ed731c401a9678707e426978c4e122e52a96ead2"), .elgamal = nat("9c51c26267848e8a3dc697a5b210ca507cff7e5e2d616987b83a016f497282f8"), .p = nat("f90233cda18f309bd2ccb22e617dc9963f1b9866d7f02b854f4d9e30ec0d12981e60395b58845807f3ce4401723869f2533d790ac64cdeb5c0524e956e99a42c575cb6790f97e8dc7f53b4ab8c6f3a3427c4fb7cfc6e0061165d247efb403dcfe5d289fe45aea3bd221b38a2f438bfed2f2b37a4a1c89561ecdc2713e0f84fe7"), .q = nat("c12e35370a6d8ecc176a17150877d3b0ebfef52ba4fc1431f6d4945b59f8e144b16d5973544318faa40611bfce8ee72f9867258aa926fd2044e132dfbde15cfab284940d99c338bf1e6ad582cb9431cedfccd2574ad8909edbf7fae45082a3bca84c63f0b17903a10f71dc257578becd9849a3ef294c9728b871b0ba2eac39ef"), .rid = [], .chain_key = [], .public = publics() }; }
    if (i == 3) { return CgConfig { .id = 3, .threshold = 1, .ecdsa = nat("15bd62c09e1c4beb47b41cd03c364737e9efc311b8414cccdef336377bb35fb3"), .elgamal = nat("0ef8347d67d0cfd3454441863acf42c17da4aad1e971b305b07f9658b8c40964"), .p = nat("f859b2dec115412a690d45d00c683e33233e09ab7d7aec6ed44798dc9743b91959c93d6cec66279846cbd519234a379c267b535464a073607221daf0dc2419e31991d0af903c4e744a00dfff2d577ba9caac5c58e1089cd1f3fb98e3bb015fe1758cda4440eefd3694b87841f8d5e48ebede66232dd12035911e56914ff500ff"), .q = nat("c975431cf1aefae6c7cfc517303b6980fcc49bae30e18808c3f6e3b52bfcce94422e88602458044488a2e41963fd70052a9b7ede945060ad9e06db7e35c88aa0a5fe17e2c80ce2a1ccfa05bf97ec00fbde00a818ecbdd2ed4fdd979d961ae380e757678e0c112ea49beba271fac9e8ff56edf17ac2845ed4d0a6d76babf034bb"), .rid = [], .chain_key = [], .public = publics() }; }
    return CgConfig { .id = 0, .threshold = 0, .ecdsa = [], .elgamal = [], .p = [], .q = [], .rid = [], .chain_key = [], .public = [] };
}

// ─── Seeds and sessions ─────────────────────────────────────────

// The 32-byte seed i (4 bytes big-endian, then zeros). The seeds below
// were found by a search (Python, SHA-256 counter mode as cg_rng) for
// which Resid master 1458799c's cg_unit runs out of its 8 chunks under the
// device's Paillier modulus (publics()[0].n, about 1 call in 1,728):
//   1245: ps/kn (K)   385: ps/mta-d/3/r (the Delta F)   730: ps/mta-x/3/r (the Chi F)
//   457: bl/tn (the tweak T)   1775: rsh/d1/1/1 (a re-share part to party 1)
// A fixed Resid (cg_unit without the fallback) gives these seeds ordinary
// nonces; every test below holds on both.
List(Int) seed_n(Int i) { return [(i >> 24) & 255, (i >> 16) & 255, (i >> 8) & 255, i & 255].concat(zeros(28)); }
List(Int) zeros(Int n) { return if (n == 0) { [] } else { [0].concat(zeros(n - 1)) }; }

List(Int) dev() { return [12, 201, 97, 213, 187, 45, 176, 173, 225, 34, 33, 242, 136, 32, 83, 104, 116, 216, 241, 101, 151, 3, 58, 6, 128, 109, 190, 241, 109, 170, 205, 19]; }
List(Int) cos() { return [50, 193, 193, 90, 151, 15, 15, 97, 64, 114, 44, 3, 216, 218, 213, 216, 65, 78, 192, 235, 134, 75, 38, 20, 123, 65, 36, 8, 70, 62, 65, 149]; }
List(Int) digest() { return [83, 130, 189, 108, 162, 154, 7, 175, 26, 54, 117, 52, 16, 94, 216, 116, 224, 173, 64, 236, 204, 89, 25, 75, 15, 53, 26, 252, 214, 81, 119, 232]; }
List(Int) sid() { return [51, 55, 17, 188, 174, 75, 0, 133, 179, 81, 20, 211, 246, 165, 75, 136, 131, 169, 209, 57, 105, 90, 118, 144, 125, 235, 174, 79, 184, 57, 74, 90]; }

@requires(declassify)
List(UInt(64)) tau() { return tweak_scalar(chain_code(), "login.example.com", [50, 185, 196, 129, 49, 116, 171, 111, 241, 56, 213, 180, 146, 122, 133, 182]); }

type SPty = { CgCtx ctx; ThState st; };

// Party `who` of the device-and-cosigner session, the device initiating.
@requires(declassify)
SPty party(List(Int) who, List(Int) seed) {
    Quorum q = quorum();
    Bool d = bytes_eq(who, dev());
    List(UInt(64)) mine = if (d) { tau() } else { [] };
    CgCtx none = CgCtx {.self = 0, .ids = [], .pubs = [], .x = [], .elg = [], .psec = PaillierSec {.p = [], .q = [], .phi = [], .phi_inv = []}, .pubkey = cv_inf(), .base = tr_new(), .seed = [], .digest = []};
    CgCtx c = th_ctx(config(cg_id_of(q, who, 0)), q, [dev(), cos()], dev(), mine, sid(), digest(), seed) else { none };
    return SPty {.ctx = c, .st = th_start(c, th_role(c, q, dev(), mine)).state};
}

Bool for_me(ThMsg m, Int me) {
    return match m {
        ThCg(c) => c.from != me && (c.to == 0 || c.to == me),
        ThTw(t) => t.to == me,
        ThVerdict(v) => v.to == me,
        ThRs(r) => r.from != me && (r.to == 0 || r.to == me)
    };
}

List(ThMsg) inbox(List(ThMsg) all, Int me, Int i, ListBuf(ThMsg) acc) {
    if (i >= all.len()) { return acc.finish(); }
    return inbox(all, me, i + 1, if (for_me(all[i], me)) { acc.push(all[i]) } else { acc });
}

// A run: the parties, the last round's messages, everything sent so far.
type Run = { List(SPty) ps; List(ThMsg) out; List(ThMsg) sent; Str fail; List(Int) culprits; };

Run step_all(List(SPty) ps, List(ThMsg) in, Int i, ListBuf(SPty) acc, List(ThMsg) out) {
    if (i >= ps.len()) { return Run {.ps = acc.finish(), .out = out, .sent = [], .fail = "", .culprits = []}; }
    SPty p = ps[i];
    return match th_step(p.st, inbox(in, p.ctx.self, 0, ListBuf())) {
        Err(e) => failed(acc, e),
        Ok(s) => step_all(ps, in, i + 1, acc.push(SPty {.ctx = p.ctx, .st = s.state}), out.concat(s.out))
    };
}

Run failed(ListBuf(SPty) acc, CgFail e) {
    _ = acc.finish();
    return Run {.ps = [], .out = [], .sent = [], .fail = e.why, .culprits = e.culprits};
}

Run run(List(SPty) ps, List(ThMsg) in, List(ThMsg) sent, Int rounds) {
    if (rounds == 0) { return Run {.ps = ps, .out = in, .sent = sent, .fail = "", .culprits = []}; }
    Run r = step_all(ps, in, 0, ListBuf(), []);
    if (str_len(r.fail) > 0) { return r; }
    return run(r.ps, r.out, sent.concat(r.out), rounds - 1);
}

List(ThMsg) first_out(SPty p) {
    ThState st = p.st;
    return match st { ThR1(s, _) => wrap(s.out, 0, ListBuf()), _ => [] };
}

List(ThMsg) wrap(List(CgMsg) ms, Int i, ListBuf(ThMsg) acc) {
    if (i >= ms.len()) { return acc.finish(); }
    return wrap(ms, i + 1, acc.push(ThCg(ms[i])));
}

Str sig_of(List(SPty) ps, Int i) {
    if (i >= ps.len()) { return ""; }
    ThState st = ps[i].st;
    return match st { ThSigned(sig) => hx(th_sig_raw(sig)), _ => sig_of(ps, i + 1) };
}

// A whole session with the device drawing from `seed`: the signature (hex)
// when it is valid under SPty and nothing sent carries a nonce-1 ciphertext.
@requires(declassify)
Str session(List(Int) seed) {
    SPty d = party(dev(), seed);
    SPty c = party(cos(), sha256_bytes([3, 3, 3]));
    if (d.ctx.self == 0 || c.ctx.self == 0) { return "no context"; }
    List(ThMsg) start = first_out(d).concat(first_out(c));
    Run r = run([d, c], start, start, 8);
    if (str_len(r.fail) > 0) { return "fail: " + r.fail; }
    if (th_nonce_one(d.ctx, r.sent, 0)) { return "sent a ciphertext with the nonce 1"; }
    Str sig = sig_of(r.ps, 0);
    if (str_len(sig) != 128) { return "no signature"; }
    Bool ok = ecdsa_verify_digest(P256, credential_pubkey(quorum().root_pubkey, tau()), digest(), ecdsa_sig_raw(P256, cose_hex_decode(sig)));
    return if (ok) { "valid" } else { "invalid signature" };
}

// ─── The bug, and the sender's guard ────────────────────────────

test "a Paillier ciphertext with the nonce 1 is 1 + mN: it shows m, and the guard flags it" {
    List(UInt(64)) n = publics()[0].n;
    PaillierPub pk = paillier_pub(n);
    List(UInt(64)) m = bn_from_be([1, 2, 3, 4, 5, 6, 7, 8, 9]);
    List(UInt(64)) c = pa_enc(pk, zi_from_nat(m), [1]);
    expect(pa_nonce_one(n, c)).toBeTrue();
    // Resid before the fast-track fix (991062e8) accepts it in pa_ct_ok,
    // later Resid refuses it; the guard flags it either way.
    expect(bn_cmp(bn_divmod(bn_sub(c, [1]), n).q, m)).toEqual(0);
    // An ordinary nonce hides m, and the test does not flag it.
    expect(pa_nonce_one(n, pa_enc(pk, zi_from_nat(m), cg_unit(seed_n(1), "x", n)))).toBeFalse();
    // Under another party's modulus the same ciphertext is not flagged.
    expect(pa_nonce_one(publics()[2].n, c)).toBeFalse();
}

@requires(declassify)
test "round 1: where Resid's cg_unit falls back for K, the library's K shows k; th_start sends a fresh k under a real nonce" {
    SPty d = party(dev(), seed_n(1245));
    CgCtx c = d.ctx;
    List(UInt(64)) n = publics()[0].n;
    Ps1 raw = ps_start(c);
    Bool shown = pa_nonce_one(n, raw.k_ct);
    // On Resid master 1458799c: K = 1 + k N, so (K - 1) / N is k.
    expect(!shown || bn_cmp(bn_divmod(bn_sub(raw.k_ct, [1]), n).q, raw.kshare) == 0).toBeTrue();
    ThStep st = th_start(c, th_role(c, quorum(), dev(), tau()));
    expect(th_nonce_one(c, st.out, 0)).toBeFalse();
    // Redrawn exactly when the library's draw had the nonce 1: a new k, never the shown one.
    ThState s = st.state;
    Bool fresh = match s { ThR1(p, _) => bn_cmp(p.kshare, raw.kshare) != 0, _ => false };
    expect(fresh == shown).toBeTrue();
}

@requires(declassify)
test "a session where the device's K would have the nonce 1 signs, validly, and sends no such ciphertext" {
    expect(session(seed_n(1245))).toEqual("valid");
}

@requires(declassify)
test "a session where the device's Delta F would have the nonce 1 signs, validly, and sends no such ciphertext" {
    expect(session(seed_n(385))).toEqual("valid");
}

@requires(declassify)
test "a session where the device's Chi F would have the nonce 1 signs, validly, and sends no such ciphertext" {
    expect(session(seed_n(730))).toEqual("valid");
}

@requires(declassify)
test "a session where the device's tweak T would have the nonce 1 signs, validly, and sends no such ciphertext" {
    expect(session(seed_n(457))).toEqual("valid");
}

// ─── The receiver's refusal ─────────────────────────────────────

// `ms` with every K (PsB2) and every MtA F (PsM3) and tweak T replaced by
// an encryption of 7 with the nonce 1 under the sender's modulus `n`.
List(ThMsg) forged(List(ThMsg) ms, List(UInt(64)) n, Int i, ListBuf(ThMsg) acc) {
    if (i >= ms.len()) { return acc.finish(); }
    List(UInt(64)) bad = pa_enc(paillier_pub(n), zi_from_nat([7]), [1]);
    ThMsg m = ms[i];
    ThMsg f = match m {
        ThCg(c) => ThCg(CgMsg {.from = c.from, .to = c.to, .body = forged_body(c.body, bad)}),
        ThTw(t) => ThTw(BlTwMsg {.from = t.from, .to = t.to, .t = bad, .d = t.d, .f = t.f, .proof = t.proof}),
        _ => m
    };
    return forged(ms, n, i + 1, acc.push(f));
}

CgBody forged_body(CgBody b, List(UInt(64)) bad) {
    return match b {
        PsB2(x) => PsB2(PsB2R {.k = bad, .g = x.g, .zl = x.zl, .zm = x.zm, .commit = x.commit}),
        PsM3(x) => PsM3(PsM3R {.delta_f = x.delta_f, .delta_proof = x.delta_proof, .chi_f = bad, .chi_proof = x.chi_proof}),
        _ => b
    };
}

Str refusal(ThState st, List(ThMsg) in) {
    return match th_step(st, in) {
        Ok(_) => "accepted",
        Err(e) => if (e.culprits.len() == 0) { e.why } else { f"blames {e.culprits}: " + e.why }
    };
}

@requires(declassify)
test "a peer's K with the nonce 1 is refused before round 2, no one blamed, and the abort book is left alone" {
    SPty d = party(dev(), seed_n(9));
    SPty c = party(cos(), sha256_bytes([3, 3, 3]));
    List(ThMsg) bad = forged(first_out(c), publics()[2].n, 0, ListBuf());
    // The sender's test flags it, under the sender's own modulus.
    expect(th_nonce_one(c.ctx, bad, 0)).toBeTrue();
    expect(th_nonce_one(c.ctx, first_out(c), 0)).toBeFalse();
    Str why = refusal(d.st, inbox(bad, 1, 0, ListBuf()));
    expect(why).toEqual(nonce_one_refused());
    // As run_session reports it, with the seat and round after the reason.
    AbortBook b = record_run(abort_book(), quorum(), why + " (seat 1, round 1, culprits [], inbox 3>0)", []);
    expect(b.unidentified).toEqual(0);
    expect(b.banned.len()).toEqual(0);
    // An ordinary failure is still an abort.
    expect(record_run(abort_book(), quorum(), "Delta shares are inconsistent", []).unidentified).toEqual(1);
}

@requires(declassify)
test "a peer's MtA F or tweak T with the nonce 1 is refused at round 3, no one blamed" {
    SPty d = party(dev(), seed_n(9));
    SPty c = party(cos(), sha256_bytes([3, 3, 3]));
    List(ThMsg) start = first_out(d).concat(first_out(c));
    Run r = run([d, c], start, start, 1);
    expect(r.fail).toEqual("");
    // Round 2's messages: the cosigner's F to the device, the device's T to the cosigner.
    List(ThMsg) to_dev = inbox(r.out, 1, 0, ListBuf());
    List(ThMsg) to_cos = inbox(r.out, 3, 0, ListBuf());
    expect(refusal(r.ps[0].st, forged(to_dev, publics()[2].n, 0, ListBuf()))).toEqual(nonce_one_refused());
    expect(refusal(r.ps[1].st, forged(to_cos, publics()[0].n, 0, ListBuf()))).toEqual(nonce_one_refused());
    // Unforged, both go on.
    expect(refusal(r.ps[0].st, to_dev)).toEqual("accepted");
}

// ─── Re-share parts ─────────────────────────────────────────────

RsAnnMsg ann(Int id, List(UInt(64)) n) {
    List(UInt(64)) none = [];
    return RsAnnMsg { .id = id, .n = n, .ped = Pedersen { .n = n, .s = [5], .t = [7] }, .modp = ModProof { .w = none, .responses = [] }, .prm = PrmProof { .as = [], .zs = [] },
                      .elgamal = cv_mul_base([3]), .elg_proof = SchProof { .c = cv_inf(), .z = none } };
}

RsCtx dealer_ctx(List(Int) seed) {
    return RsCtx {.self = 0, .old_self = 1, .dealers = [1, 3], .receivers = [1, 2], .offline = [], .degree = 1, .old = [config(1)],
                  .root = quorum().root_pubkey, .session_id = sid(), .seed = seed, .primes = []};
}

List(RsPartMsg) deal_parts(List(ThMsg) ms, Int i) {
    if (i >= ms.len()) { return []; }
    ThMsg m = ms[i];
    List(RsPartMsg) got = match m { ThRs(r) => parts_of_body(r.body), _ => [] };
    return if (got.len() > 0) { got } else { deal_parts(ms, i + 1) };
}

List(RsPartMsg) parts_of_body(RsBody b) { return match b { RsDeal(d) => d.parts, _ => [] }; }

List(Int) seed_of(RsState st) { return match st { RS2(c, _, _, _, _) => c.seed, _ => [] }; }

test "a re-share part that would have the nonce 1 is dealt again from a fresh seed" {
    List(RsAnnMsg) as = [ann(1, publics()[0].n), ann(2, publics()[1].n)];
    // Resid master: the part to party 1 is drawn with the nonce 1 for this seed.
    Bool falls = bn_cmp(cg_unit(seed_n(1775), "rsh/d1/1/1", publics()[0].n), [1]) == 0;
    List(ThMsg) none = [];
    Str got = match deal_try(dealer_ctx(seed_n(1775)), [], as, none, 0) {
        Err(e) => "fail: " + e.why,
        Ok(s) => if (deal_parts(s.out, 0).len() != 2) { "no deal" }
                 else if (parts_nonce_one(deal_parts(s.out, 0), as, 0)) { "sent a part with the nonce 1" }
                 else if (bytes_eq(seed_of(s.state), seed_n(1775)) == falls) { "redrawn when it need not be, or not when it must" }
                 else { "ok" }
    };
    expect(got).toEqual("ok");
}

test "a received re-share part with the nonce 1 is refused, no one blamed" {
    List(RsAnnMsg) as = [ann(1, publics()[0].n), ann(2, publics()[1].n)];
    RsPartMsg bad = RsPartMsg {.to = 2, .ct = pa_enc(paillier_pub(publics()[1].n), zi_from_nat([9]), [1])};
    expect(parts_nonce_one([bad], as, 0)).toBeTrue();
    RsDealMsg dm = RsDealMsg {.dealer = 3, .commits = [], .parts = [bad]};
    List(RsMine) mine = [];
    List(RsOffline) off = [];
    List(RsDealMsg) own = [];
    Str why = match rs_step(RS2(dealer_ctx(seed_n(5)), mine, as, off, own), [ThRs(RsMsg {.from = 3, .to = 0, .body = RsDeal(dm)})]) {
        Ok(_) => "accepted",
        Err(e) => if (e.culprits.len() == 0) { e.why } else { f"blames {e.culprits}" }
    };
    expect(why).toEqual(nonce_one_refused());
}
