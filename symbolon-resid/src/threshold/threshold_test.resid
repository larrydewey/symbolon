// Threshold glue rules that need no reference values: the epoch rule, abort
// bookkeeping, the kit's split material and its HPKE wrapping.

import "../types.resid";
import "../core/log.resid";
import "threshold.resid";
import "crypto.resid";
import "hpke.resid";

Str hx(List(Int) b) { return hex_encode(b); }
List(Int) rep(Int b, Int n) { return if (n == 0) { [] } else { [b].concat(rep(b, n - 1)) }; }
List(Int) idn(Int n) { return rep(n, 32); }

Party party_of(Int n, UInt(8) kind) {
    return Party {.id = idn(n), .kind = kind, .auth_key = [], .hpke_key = [], .label = "p", .attestation = NoAttestation};
}

Quorum quorum_of(List(Party) ps, UInt(32) epoch) {
    return Quorum {.parties = ps, .t = 2, .root_pubkey = [], .epoch = epoch, .transcript_digest = []};
}

LogHead head_at(UInt(32) epoch) {
    Policy p = Policy {.device_sigs_for_authority = 2, .recovery_delay_sec = 86400, .guardians = [], .guardian_threshold = 0,
                       .witnesses = [], .duress_window_sec = 0, .cosigner_policy = NoCosignerPolicy};
    return LogHead {.log_id = idn(9), .sequence = 4, .digest = idn(8), .quorum = quorum_of([party_of(1, party_kind_device())], epoch), .policy = p};
}

Str epoch_said(UInt(32) e) {
    return match epoch_ok(e, head_at(5)) { Ok(_) => "ok", Err(x) => match x { ErrStaleEpoch(h, c) => f"stale {h}/{c}", ErrInvalidLog(s) => s, _ => "other" } };
}

test "only the log's current epoch signs (SPEC 11.3)" {
    expect(epoch_said(5)).toEqual("ok");
    expect(epoch_said(4)).toEqual("stale 4/5");
    expect(epoch_said(6)).toEqual("share epoch ahead of the verified log");
}

Str run_said(AbortBook b, List(List(Int)) signers) {
    return match may_run(b, signers) { Ok(_) => "ok", Err(e) => match e { ErrPolicyViolation(s) => s, _ => "other" } };
}

test "an identified party is banned until a re-share excludes it (SPEC 6.2)" {
    Quorum q = quorum_of([party_of(1, party_kind_device()), party_of(2, party_kind_device()), party_of(3, party_kind_cosigner())], 1);
    AbortBook b = record_abort(abort_book(), q, cg_fail("bad proof", [3]));
    expect(run_said(b, [idn(1), idn(3)])).toEqual("a signer was identified in an abort");
    expect(run_said(b, [idn(1), idn(2)])).toEqual("ok");
    // A refresh that keeps party 3 keeps the ban; one without it lifts it.
    AbortBook kept = after_reshare(b, q);
    expect(run_said(kept, [idn(1), idn(3)])).toEqual("a signer was identified in an abort");
    Quorum without = quorum_of([party_of(1, party_kind_device()), party_of(2, party_kind_device()), party_of(4, party_kind_cosigner())], 2);
    AbortBook lifted = after_reshare(b, without);
    expect(lifted.banned.len()).toEqual(0);
}

test "repeated unidentified aborts stop the parties" {
    Quorum q = quorum_of([party_of(1, party_kind_device()), party_of(2, party_kind_device())], 1);
    AbortBook b1 = record_abort(abort_book(), q, cg_fail("Delta shares are inconsistent", []));
    AbortBook b2 = record_abort(b1, q, cg_fail("Delta shares are inconsistent", []));
    expect(run_said(b2, [idn(1), idn(2)])).toEqual("ok");
    AbortBook b3 = record_abort(b2, q, cg_fail("Delta shares are inconsistent", []));
    expect(run_said(b3, [idn(1), idn(2)])).toEqual("repeated unidentified aborts: stop and alert");
    // A success in between resets the count.
    expect(run_said(record_abort(record_success(b2), q, cg_fail("x", [])), [idn(1), idn(2)])).toEqual("ok");
}

test "the kit's halves give back x_K and k_K; neither half alone does (SPEC 10.6)" {
    List(UInt(64)) xk = sc_of_bytes(rep(77, 32));
    List(Int) kk = rep(5, 32);
    KitHalves h = kit_split(xk, kk, rep(19, 32), rep(200, 32));
    expect(hx(bn_to_be(kit_share(h.a, h.b), 32))).toEqual(hx(bn_to_be(xk, 32)));
    expect(hx(kit_key(h.ka, h.kb))).toEqual(hx(kk));
    expect(hx(bn_to_be(h.a, 32)) == hx(bn_to_be(xk, 32))).toBeFalse();
    expect(hx(bn_to_be(h.b, 32)) == hx(bn_to_be(xk, 32))).toBeFalse();
    expect(hx(h.ka) == hx(kk)).toBeFalse();
    expect(kit_key(h.ka, [1]).len()).toEqual(0);
}

test "offline material opens only for its log, epoch and party" {
    HpkeKeyPair kp = hpke_derive_keypair(16, rep(42, 32));
    expect(kp.ok).toBeTrue();
    Option(Wrapped) ow = offline_wrap(kp.pk, idn(9), 3, idn(1), rep(7, 40), rep(11, 32));
    Wrapped w = ow else { Wrapped {.enc = [], .ct = []} };
    expect(w.ct.len()).toEqual(56);
    Str ok = match offline_unwrap(kp.sk, idn(9), 3, idn(1), w) { Some(pt) => hx(pt), None => "refused" };
    expect(ok).toEqual(hx(rep(7, 40)));
    Str other_epoch = match offline_unwrap(kp.sk, idn(9), 4, idn(1), w) { Some(pt) => hx(pt), None => "refused" };
    Str other_party = match offline_unwrap(kp.sk, idn(9), 3, idn(2), w) { Some(pt) => hx(pt), None => "refused" };
    Str other_log = match offline_unwrap(kp.sk, idn(8), 3, idn(1), w) { Some(pt) => hx(pt), None => "refused" };
    expect(other_epoch).toEqual("refused");
    expect(other_party).toEqual("refused");
    expect(other_log).toEqual("refused");
}
