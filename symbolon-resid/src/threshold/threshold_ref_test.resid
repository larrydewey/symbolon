// The threshold glue (src/threshold/threshold.resid) against values made by an
// independent implementation (tests/gen_threshold_ref.py): key derivation,
// info bytes, and a dealer's 2-of-3 sharing for whole signing sessions.
// Generated; do not edit by hand.

import "../types.resid";
import "../core/log.resid";
import "threshold.resid";
import "crypto.resid";
import "ecdsa.resid";
import "word.resid";
import "../net/wire.resid";

Str hx(List(Int) b) { return hex_encode(b); }
List(UInt(64)) nat(Str h) { return bn_from_be(cose_hex_decode(h)); }
CvPt pt(Str h) { return match cv_dec(cose_hex_decode(h)) { Some(p) => p, None => cv_inf() }; }
List(Secret(UInt(8))) chain_code() { return secret_bytes(rt [180, 32, 220, 232, 175, 131, 197, 200, 20, 214, 12, 52, 0, 135, 246, 4, 161, 218, 117, 121, 183, 226, 123, 17, 191, 180, 175, 100, 122, 18, 64, 170]); }

@requires(declassify)
test "credential tag and ID equal the reference (HMAC under HKDF(cc))" {
    expect(hx(credential_tag(chain_code(), "login.example.com", [50, 185, 196, 129, 49, 116, 171, 111, 241, 56, 213, 180, 146, 122, 133, 182]))).toEqual("1444b776512d1d0d1ed140726ccfa898");
    expect(hx(credential_id(chain_code(), "login.example.com", [50, 185, 196, 129, 49, 116, 171, 111, 241, 56, 213, 180, 146, 122, 133, 182]))).toEqual("32b9c4813174ab6ff138d5b4927a85b61444b776512d1d0d1ed140726ccfa898");
}

@requires(declassify)
Str nonce_of(Str rp, List(Int) cid) {
    return match credential_nonce(chain_code(), rp, cid) { Some(n) => hx(n), None => "refused" };
}

@requires(declassify)
test "a credential ID is accepted only with the RP ID it was made for (A-12)" {
    expect(nonce_of("login.example.com", [50, 185, 196, 129, 49, 116, 171, 111, 241, 56, 213, 180, 146, 122, 133, 182, 20, 68, 183, 118, 81, 45, 29, 13, 30, 209, 64, 114, 108, 207, 168, 152])).toEqual("32b9c4813174ab6ff138d5b4927a85b6");
    expect(nonce_of("evil.example.net", [50, 185, 196, 129, 49, 116, 171, 111, 241, 56, 213, 180, 146, 122, 133, 182, 20, 68, 183, 118, 81, 45, 29, 13, 30, 209, 64, 114, 108, 207, 168, 152])).toEqual("refused");
    expect(nonce_of("login.example.com", [50, 185, 196, 129, 49, 116, 171, 111, 241, 56, 213, 180, 146, 122, 133, 182, 20, 68, 183, 118, 81, 45, 29, 13, 30, 209, 64, 114, 108, 207, 168, 153])).toEqual("refused");
    expect(nonce_of("login.example.com", [50, 185, 196, 129, 49, 116, 171, 111, 241, 56, 213, 180, 146, 122, 133, 182, 20, 68, 183, 118, 81, 45, 29, 13, 30, 209, 64, 114, 108, 207, 168])).toEqual("refused");
}

@requires(declassify)
test "tau equals the reference: HKDF(cc, nil, tweak || rp || nonce, 48) mod q" {
    expect(hx(bn_to_be(tweak_scalar(chain_code(), "login.example.com", [50, 185, 196, 129, 49, 116, 171, 111, 241, 56, 213, 180, 146, 122, 133, 182]), 32))).toEqual("b848738f99d5bc55a6e1df53134d1bcb96a16d01990f65166a72a2fe50c219b7");
    expect(hx(bn_to_be(tweak_scalar(chain_code(), "evil.example.net", [50, 185, 196, 129, 49, 116, 171, 111, 241, 56, 213, 180, 146, 122, 133, 182]), 32))).toEqual("8d570d30edb03e506400c439181b04c4284d3d3f42aff0ce656b3f106142654f");
}

@requires(declassify)
test "P = X + tau G equals the reference" {
    expect(hx(credential_pubkey([4, 28, 46, 244, 29, 171, 122, 106, 51, 151, 132, 124, 190, 95, 52, 241, 152, 190, 33, 117, 178, 29, 71, 105, 184, 126, 141, 11, 0, 125, 120, 171, 211, 162, 22, 17, 181, 109, 175, 12, 189, 181, 106, 183, 251, 18, 210, 8, 93, 234, 35, 85, 223, 122, 72, 43, 66, 212, 245, 85, 101, 25, 96, 36, 76], tweak_scalar(chain_code(), "login.example.com", [50, 185, 196, 129, 49, 116, 171, 111, 241, 56, 213, 180, 146, 122, 133, 182])))).toEqual("046fdd5b9daa11133337ec84e8348ff0a6f4a59c1bf8077efcd7a2545f3cffcbdec16f4de1470402f2a5cf14caf4829b1a26dcdbe6e08ace77d2a346c96f49bb6e");
    expect(credential_pubkey([4, 1, 2], [1]).len()).toEqual(0);
    // A point off the curve (Y changed) is refused.
    expect(credential_pubkey([4, 28, 46, 244, 29, 171, 122, 106, 51, 151, 132, 124, 190, 95, 52, 241, 152, 190, 33, 117, 178, 29, 71, 105, 184, 126, 141, 11, 0, 125, 120, 171, 211, 162, 22, 17, 181, 109, 175, 12, 189, 181, 106, 183, 251, 18, 210, 8, 93, 234, 35, 85, 223, 122, 72, 43, 66, 212, 245, 85, 101, 25, 96, 36, 77], [1]).len()).toEqual(0);
}

