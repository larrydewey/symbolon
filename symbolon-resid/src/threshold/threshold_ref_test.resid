Party party_of(List(Int) id, UInt(8) kind) {
    return Party { .id = id, .kind = kind, .auth_key = [], .hpke_key = [], .label = "p", .attestation = NoAttestation };
}

Quorum quorum() {
    return Quorum { .parties = [party_of([12, 201, 97, 213, 187, 45, 176, 173, 225, 34, 33, 242, 136, 32, 83, 104, 116, 216, 241, 101, 151, 3, 58, 6, 128, 109, 190, 241, 109, 170, 205, 19], party_kind_device()), party_of([212, 166, 176, 3, 55, 10, 159, 24, 111, 1, 17, 25, 196, 237, 97, 45, 141, 202, 178, 19, 33, 155, 159, 26, 226, 237, 208, 170, 46, 129, 215, 191], party_kind_device()),
                                 party_of([50, 193, 193, 90, 151, 15, 15, 97, 64, 114, 44, 3, 216, 218, 213, 216, 65, 78, 192, 235, 134, 75, 38, 20, 123, 65, 36, 8, 70, 62, 65, 149], party_kind_cosigner())],
                     .t = 2, .root_pubkey = [4, 28, 46, 244, 29, 171, 122, 106, 51, 151, 132, 124, 190, 95, 52, 241, 152, 190, 33, 117, 178, 29, 71, 105, 184, 126, 141, 11, 0, 125, 120, 171, 211, 162, 22, 17, 181, 109, 175, 12, 189, 181, 106, 183, 251, 18, 210, 8, 93, 234, 35, 85, 223, 122, 72, 43, 66, 212, 245, 85, 101, 25, 96, 36, 76], .epoch = 3, .transcript_digest = [] };
}

List(CgPublicCfg) publics() { return [CgPublicCfg { .id = 1, .ecdsa = pt("03f394cdebf414f02d27f71d56a66c8393995700be1e6944d021bb372d89520700"), .elgamal = pt("02442740efb73dd60dce2b6a8ca30b198c0c7c3a4493df511096dafba94a36e66e"), .n = nat(""), .ped = Pedersen { .n = nat(""), .s = nat(""), .t = nat("") } }, CgPublicCfg { .id = 2, .ecdsa = pt("03eed386a2eff2a46435f8a2f5dda4fbd78861fd4ba321c8094afc703de315d18c"), .elgamal = pt("03b08386ea09f9ef50adee236b1b396c479c89be03119b271e0397b8f9b9dcf9d6"), .n = nat(""), .ped = Pedersen { .n = nat(""), .s = nat(""), .t = nat("") } }, CgPublicCfg { .id = 3, .ecdsa = pt("03190d7e87cc1479ae9fae2368ef487c272755eb703d67c97c33c92fd285201d9a"), .elgamal = pt("03668c6d48b15156dbaab81cf1ae826ce41a9ec171480ff6336c6424cea5dfbe06"), .n = nat(""), .ped = Pedersen { .n = nat(""), .s = nat(""), .t = nat("") } }]; }

CgConfig config(Int i) {
    if (i == 1) { return CgConfig { .id = 1, .threshold = 1, .ecdsa = nat("4abdd223646ed1dccd4671599eaff1484b3d2dcf44438624aacf0f92d97a75f1"), .elgamal = nat("be7526b89f574580dad64c0317daac42eee124a8d0f265c51bda40a5d9e13f47"), .p = nat("c7a0a26d66491aa191e208dacad5e78e23c25b4ba562ef4b3b221ff8145257be0fa8ed3d39a016c37525162e12a61ebadecb27eb243f3a34fc42d1d0b9166d8fdcb4e7811efe5f11ad35501c444f9d0675e9af4a0ceceadda6b85f5875aa5704ec6ec283301faa4bf44de4b5ec0fa15447042f413cf862f1978ffebc030cd8b3"), .q = nat("c701021e91631cbcb4777dbcb122eae89fd1c3c3bff6621ecefd132929afbbdc64468d3fddfd3cb4c7a4f5c8c014916f8a3eb850e8d38089f9e5f58922ccbdd12912e610192914bd7d841f86e12a53d30a70f41290f85a11639f5c4f45d11ed12ea3d76ed22012dbe8b73a90fa3bea819dcc99b2a7378dc48019b415561cfe17"), .rid = [], .chain_key = [], .public = publics() }; }
    if (i == 2) { return CgConfig { .id = 2, .threshold = 1, .ecdsa = nat("303d9a7201458ee40a7d4714ed731c401a9678707e426978c4e122e52a96ead2"), .elgamal = nat("9c51c26267848e8a3dc697a5b210ca507cff7e5e2d616987b83a016f497282f8"), .p = nat("f90233cda18f309bd2ccb22e617dc9963f1b9866d7f02b854f4d9e30ec0d12981e60395b58845807f3ce4401723869f2533d790ac64cdeb5c0524e956e99a42c575cb6790f97e8dc7f53b4ab8c6f3a3427c4fb7cfc6e0061165d247efb403dcfe5d289fe45aea3bd221b38a2f438bfed2f2b37a4a1c89561ecdc2713e0f84fe7"), .q = nat("c12e35370a6d8ecc176a17150877d3b0ebfef52ba4fc1431f6d4945b59f8e144b16d5973544318faa40611bfce8ee72f9867258aa926fd2044e132dfbde15cfab284940d99c338bf1e6ad582cb9431cedfccd2574ad8909edbf7fae45082a3bca84c63f0b17903a10f71dc257578becd9849a3ef294c9728b871b0ba2eac39ef"), .rid = [], .chain_key = [], .public = publics() }; }
    if (i == 3) { return CgConfig { .id = 3, .threshold = 1, .ecdsa = nat("15bd62c09e1c4beb47b41cd03c364737e9efc311b8414cccdef336377bb35fb3"), .elgamal = nat("0ef8347d67d0cfd3454441863acf42c17da4aad1e971b305b07f9658b8c40964"), .p = nat("f859b2dec115412a690d45d00c683e33233e09ab7d7aec6ed44798dc9743b91959c93d6cec66279846cbd519234a379c267b535464a073607221daf0dc2419e31991d0af903c4e744a00dfff2d577ba9caac5c58e1089cd1f3fb98e3bb015fe1758cda4440eefd3694b87841f8d5e48ebede66232dd12035911e56914ff500ff"), .q = nat("c975431cf1aefae6c7cfc517303b6980fcc49bae30e18808c3f6e3b52bfcce94422e88602458044488a2e41963fd70052a9b7ede945060ad9e06db7e35c88aa0a5fe17e2c80ce2a1ccfa05bf97ec00fbde00a818ecbdd2ed4fdd979d961ae380e757678e0c112ea49beba271fac9e8ff56edf17ac2845ed4d0a6d76babf034bb"), .rid = [], .chain_key = [], .public = publics() }; }
    return CgConfig { .id = 0, .threshold = 0, .ecdsa = [], .elgamal = [], .p = [], .q = [], .rid = [], .chain_key = [], .public = [] };
}

@requires(declassify)
test "signers map to ascending CGGMP ids; a stranger or a repeat gives none" {
    expect(cg_ids(quorum(), [[50, 193, 193, 90, 151, 15, 15, 97, 64, 114, 44, 3, 216, 218, 213, 216, 65, 78, 192, 235, 134, 75, 38, 20, 123, 65, 36, 8, 70, 62, 65, 149], [12, 201, 97, 213, 187, 45, 176, 173, 225, 34, 33, 242, 136, 32, 83, 104, 116, 216, 241, 101, 151, 3, 58, 6, 128, 109, 190, 241, 109, 170, 205, 19]], 0, [])).toEqual([1, 3]);
    List(Int) ids = cg_ids(quorum(), [[50, 193, 193, 90, 151, 15, 15, 97, 64, 114, 44, 3, 216, 218, 213, 216, 65, 78, 192, 235, 134, 75, 38, 20, 123, 65, 36, 8, 70, 62, 65, 149], [12, 201, 97, 213, 187, 45, 176, 173, 225, 34, 33, 242, 136, 32, 83, 104, 116, 216, 241, 101, 151, 3, 58, 6, 128, 109, 190, 241, 109, 170, 205, 19]], 0, []);
    expect(ids.len()).toEqual(2);
    expect(ids[0]).toEqual(1);
    expect(ids[1]).toEqual(3);
    expect(cg_ids(quorum(), [[12, 201, 97, 213, 187, 45, 176, 173, 225, 34, 33, 242, 136, 32, 83, 104, 116, 216, 241, 101, 151, 3, 58, 6, 128, 109, 190, 241, 109, 170, 205, 19], [214, 249, 12, 85, 74, 118, 60, 77, 145, 247, 250, 235, 158, 209, 230, 93, 6, 219, 249, 250, 208, 175, 191, 154, 157, 201, 192, 18, 137, 72, 239, 200]], 0, []).len()).toEqual(0);
    expect(cg_ids(quorum(), [[12, 201, 97, 213, 187, 45, 176, 173, 225, 34, 33, 242, 136, 32, 83, 104, 116, 216, 241, 101, 151, 3, 58, 6, 128, 109, 190, 241, 109, 170, 205, 19], [12, 201, 97, 213, 187, 45, 176, 173, 225, 34, 33, 242, 136, 32, 83, 104, 116, 216, 241, 101, 151, 3, 58, 6, 128, 109, 190, 241, 109, 170, 205, 19]], 0, []).len()).toEqual(0);
}

// ─── Whole sessions, every party in this process ────────────────

type Party3 = { CgCtx ctx; ThState st; };

Bool for_me(ThMsg m, Int me) {
    return match m {
        ThCg(c) => c.from != me && (c.to == 0 || c.to == me),
        ThTw(t) => t.to == me,
        ThAbortReq(f) => f != me,
        ThRs(r) => r.from != me && (r.to == 0 || r.to == me)
    };
}

List(ThMsg) inbox(List(ThMsg) all, Int me, Int i, ListBuf(ThMsg) acc) {
    if (i >= all.len()) { return acc.finish(); }
    return inbox(all, me, i + 1, if (for_me(all[i], me)) { acc.push(all[i]) } else { acc });
}

type Round = { List(Party3) ps; List(ThMsg) out; Str fail; List(Int) culprits; };

Round step_all(List(Party3) ps, List(ThMsg) in, Int i, ListBuf(Party3) acc, List(ThMsg) out) {
    if (i >= ps.len()) { return Round { .ps = acc.finish(), .out = out, .fail = "", .culprits = [] }; }
    Party3 p = ps[i];
    return match th_step(p.st, inbox(in, p.ctx.self, 0, ListBuf())) {
        Err(e) => failed(acc, e),
        Ok(s) => step_all(ps, in, i + 1, acc.push(Party3 { .ctx = p.ctx, .st = s.state }), out.concat(s.out))
    };
}

Round failed(ListBuf(Party3) acc, CgFail e) {
    _ = acc.finish();
    return Round { .ps = [], .out = [], .fail = e.why, .culprits = e.culprits };
}

Str signed_by(List(Party3) ps, Int i) {
    if (i >= ps.len()) { return ""; }
    ThState st = ps[i].st;
    return match st { ThSigned(sig) => hx(th_sig_raw(sig)), _ => signed_by(ps, i + 1) };
}

Int signed_count(List(Party3) ps, Int i, Int acc) {
    if (i >= ps.len()) { return acc; }
    ThState st = ps[i].st;
    return signed_count(ps, i + 1, acc + match st { ThSigned(_) => 1, _ => 0 });
}

// Every message crosses the wire: encoded, then decoded from the bytes.
List(ThMsg) through_wire(List(ThMsg) ms, Int i, ListBuf(ThMsg) acc) {
    if (i >= ms.len()) { return acc.finish(); }
    Option(ThMsg) d = msg_decode(msg_encode(ms[i]));
    return through_wire(ms, i + 1, match d { Some(m) => acc.push(m), None => acc });
}

Round run(List(Party3) ps, List(ThMsg) in, Int rounds) {
    if (rounds == 0) { return Round { .ps = ps, .out = in, .fail = "", .culprits = [] }; }
    Round r = step_all(ps, through_wire(in, 0, ListBuf()), 0, ListBuf(), []);
    if (str_len(r.fail) > 0) { return r; }
    return run(r.ps, r.out, rounds - 1);
}

Option(Party3) start(List(List(Int)) signers, List(Int) who, List(Int) initiator, List(UInt(64)) tau, List(Int) sid) {
    Quorum q = quorum();
    Int id = cg_id_of(q, who, 0);
    List(UInt(64)) mine = if (bytes_eq(who, initiator)) { tau } else { [] };
    Option(CgCtx) oc = th_ctx(config(id), q, signers, initiator, mine, sid, [83, 130, 189, 108, 162, 154, 7, 175, 26, 54, 117, 52, 16, 94, 216, 116, 224, 173, 64, 236, 204, 89, 25, 75, 15, 53, 26, 252, 214, 81, 119, 232], sha256_bytes(who.concat(sid)));
    return match oc {
        None => None,
        Some(c) => Some(Party3 { .ctx = c, .st = th_start(c, th_role(c, q, initiator, mine)).state })
    };
}

List(ThMsg) starts_out(List(Party3) ps, Int i, List(ThMsg) acc) {
    if (i >= ps.len()) { return acc; }
    ThState st = ps[i].st;
    List(ThMsg) out = match st { ThR1(s, _) => wrap_start(s.out, 0, ListBuf()), _ => [] };
    return starts_out(ps, i + 1, acc.concat(out));
}

List(ThMsg) wrap_start(List(CgMsg) ms, Int i, ListBuf(ThMsg) acc) {
    if (i >= ms.len()) { return acc.finish(); }
    return wrap_start(ms, i + 1, acc.push(ThCg(ms[i])));
}

@requires(declassify)
Str session(List(List(Int)) signers, List(Int) initiator) {
    List(UInt(64)) tau = tweak_scalar(chain_code(), "login.example.com", [50, 185, 196, 129, 49, 116, 171, 111, 241, 56, 213, 180, 146, 122, 133, 182]);
    List(Int) sid = [51, 55, 17, 188, 174, 75, 0, 133, 179, 81, 20, 211, 246, 165, 75, 136, 131, 169, 209, 57, 105, 90, 118, 144, 125, 235, 174, 79, 184, 57, 74, 90];
    List(Party3) ps = start_all(signers, initiator, tau, sid, 0, ListBuf());
    if (ps.len() != signers.len()) { return "no context"; }
    Round r = run(ps, starts_out(ps, 0, []), 6);
    if (str_len(r.fail) > 0) { return "fail: " + r.fail; }
    if (signed_count(r.ps, 0, 0) != 1) { return f"signed by {signed_count(r.ps, 0, 0)} parties"; }
    return signed_by(r.ps, 0);
}

List(Party3) start_all(List(List(Int)) signers, List(Int) initiator, List(UInt(64)) tau, List(Int) sid, Int i, ListBuf(Party3) acc) {
    if (i >= signers.len()) { return acc.finish(); }
    return match start(signers, signers[i], initiator, tau, sid) {
        None => start_all(signers, initiator, tau, sid, i + 1, acc),
        Some(p) => start_all(signers, initiator, tau, sid, i + 1, acc.push(p))
    };
}

test "the wire refuses truncated, oversized and non-CBOR bytes" {
    List(Int) b = msg_encode(ThAbortReq(3));
    Bool ok = match msg_decode(b) { Some(m) => match m { ThAbortReq(f) => f == 3, _ => false }, None => false };
    expect(ok).toBeTrue();
    expect(match msg_decode(b[0..b.len() - 1]) { Some(_) => false, None => true }).toBeTrue();
    expect(match msg_decode([255]) { Some(_) => false, None => true }).toBeTrue();
    expect(match msg_decode([]) { Some(_) => false, None => true }).toBeTrue();
}

@requires(declassify)
test "device and cosigner sign: one signature, at the initiator, valid under P and not under X" {
    Str sig = session([[12, 201, 97, 213, 187, 45, 176, 173, 225, 34, 33, 242, 136, 32, 83, 104, 116, 216, 241, 101, 151, 3, 58, 6, 128, 109, 190, 241, 109, 170, 205, 19], [50, 193, 193, 90, 151, 15, 15, 97, 64, 114, 44, 3, 216, 218, 213, 216, 65, 78, 192, 235, 134, 75, 38, 20, 123, 65, 36, 8, 70, 62, 65, 149]], [12, 201, 97, 213, 187, 45, 176, 173, 225, 34, 33, 242, 136, 32, 83, 104, 116, 216, 241, 101, 151, 3, 58, 6, 128, 109, 190, 241, 109, 170, 205, 19]);
    expect(str_len(sig)).toEqual(128);
    List(Int) raw = cose_hex_decode(sig);
    expect(ecdsa_verify_digest(P256, [4, 111, 221, 91, 157, 170, 17, 19, 51, 55, 236, 132, 232, 52, 143, 240, 166, 244, 165, 156, 27, 248, 7, 126, 252, 215, 162, 84, 95, 60, 255, 203, 222, 193, 111, 77, 225, 71, 4, 2, 242, 165, 207, 20, 202, 244, 130, 155, 26, 38, 220, 219, 230, 224, 138, 206, 119, 210, 163, 70, 201, 111, 73, 187, 110], [83, 130, 189, 108, 162, 154, 7, 175, 26, 54, 117, 52, 16, 94, 216, 116, 224, 173, 64, 236, 204, 89, 25, 75, 15, 53, 26, 252, 214, 81, 119, 232], ecdsa_sig_raw(P256, raw))).toBeTrue();
    expect(ecdsa_verify_digest(P256, [4, 28, 46, 244, 29, 171, 122, 106, 51, 151, 132, 124, 190, 95, 52, 241, 152, 190, 33, 117, 178, 29, 71, 105, 184, 126, 141, 11, 0, 125, 120, 171, 211, 162, 22, 17, 181, 109, 175, 12, 189, 181, 106, 183, 251, 18, 210, 8, 93, 234, 35, 85, 223, 122, 72, 43, 66, 212, 245, 85, 101, 25, 96, 36, 76], [83, 130, 189, 108, 162, 154, 7, 175, 26, 54, 117, 52, 16, 94, 216, 116, 224, 173, 64, 236, 204, 89, 25, 75, 15, 53, 26, 252, 214, 81, 119, 232], ecdsa_sig_raw(P256, raw))).toBeFalse();
}

@requires(declassify)
test "two devices sign, the second one initiating" {
    Str sig = session([[12, 201, 97, 213, 187, 45, 176, 173, 225, 34, 33, 242, 136, 32, 83, 104, 116, 216, 241, 101, 151, 3, 58, 6, 128, 109, 190, 241, 109, 170, 205, 19], [212, 166, 176, 3, 55, 10, 159, 24, 111, 1, 17, 25, 196, 237, 97, 45, 141, 202, 178, 19, 33, 155, 159, 26, 226, 237, 208, 170, 46, 129, 215, 191]], [212, 166, 176, 3, 55, 10, 159, 24, 111, 1, 17, 25, 196, 237, 97, 45, 141, 202, 178, 19, 33, 155, 159, 26, 226, 237, 208, 170, 46, 129, 215, 191]);
    List(Int) raw = cose_hex_decode(sig);
    expect(ecdsa_verify_digest(P256, [4, 111, 221, 91, 157, 170, 17, 19, 51, 55, 236, 132, 232, 52, 143, 240, 166, 244, 165, 156, 27, 248, 7, 126, 252, 215, 162, 84, 95, 60, 255, 203, 222, 193, 111, 77, 225, 71, 4, 2, 242, 165, 207, 20, 202, 244, 130, 155, 26, 38, 220, 219, 230, 224, 138, 206, 119, 210, 163, 70, 201, 111, 73, 187, 110], [83, 130, 189, 108, 162, 154, 7, 175, 26, 54, 117, 52, 16, 94, 216, 116, 224, 173, 64, 236, 204, 89, 25, 75, 15, 53, 26, 252, 214, 81, 119, 232], ecdsa_sig_raw(P256, raw))).toBeTrue();
}

@requires(declassify)
