// Symbolon threshold glue (SPEC Sections 6.2, 10, 11.3, 12.2): per-credential
// keys, one party's side of a blind-tweak CGGMP21 signing session, the epoch
// rule, abort bookkeeping and the kit's split offline material.
//
// The cryptography is the Resid standard library (lib/cggmp*.resid). The
// tweak is applied with lib/cggmp_blind.resid: no party but the designated
// one (the initiating device) learns tau, tau*G or P, and only it receives
// the S points and the signature shares (SPEC 12.2).
//
// Layer 8 of PLAN-CGGMP.md is open: CGGMP21 holds key shares and nonces as
// public List(UInt(64)). The tweak is derived as a secret and crosses into
// the protocol at one named point, `tweak_scalar` ("tweak into CGGMP
// reference implementation"); that declassify is a release blocker and goes
// away with layer 8.

import "../types.resid";
import "../core/log.resid";
import "../vault/vault.resid";
import "cggmp_blind.resid";
import "rsmsg.resid";
import "cggmp_curve.resid";
import "sha256g.resid";
import "word.resid";
import "hpke.resid";
import "cose.resid";
import "crypto.resid";

// ============================================================================
// Per-credential keys (SPEC 10.3)
// ============================================================================

List(Secret(UInt(8))) hkdf_nil(List(Secret(UInt(8))) ikm, List(Int) info, Int n) {
    List(Secret(UInt(8))) nil = [];
    return hkdf256g_expand(hkdf256g_extract(nil, ikm), secret_bytes(info), n);
}

List(Int) ints_of(List(UInt(8)) bs, Int i, ListBuf(Int) acc) {
    if (i >= bs.len()) { return acc.finish(); }
    return ints_of(bs, i + 1, acc.push((Int)bs[i]));
}

// k_cid = HKDF(cc, nil, "symbolon v1 cid", 32)
List(Secret(UInt(8))) cid_key(List(Secret(UInt(8))) cc) { return hkdf_nil(cc, utf8("symbolon v1 cid"), 32); }

// tag = HMAC-SHA256(k_cid, "symbolon v1 cid" || rp_id || nonce)[0..16]. The
// tag goes into the credential ID, which the relying party holds.
@requires(declassify)
pub List(Int) credential_tag(List(Secret(UInt(8))) cc, Str rp_id, List(Int) nonce) {
    List(Secret(UInt(8))) mac = hmac256g(cid_key(cc), secret_bytes(utf8("symbolon v1 cid").concat(utf8(rp_id)).concat(nonce)));
    return ints_of(declassify(secret_join(mac[0..16]), "credential id tag goes to the relying party"), 0, ListBuf());
}

// cid = nonce || tag, 32 bytes.
@requires(declassify)
pub List(Int) credential_id(List(Secret(UInt(8))) cc, Str rp_id, List(Int) nonce) {
    return nonce.concat(credential_tag(cc, rp_id, nonce));
}

// The nonce of a credential ID presented with the request's RP ID, or None
// when the tag does not match that RP ID (A-12).
@requires(declassify)
pub Option(List(Int)) credential_nonce(List(Secret(UInt(8))) cc, Str rp_id, List(Int) cid) {
    if (cid.len() != 32) { return None; }
    List(Int) nonce = cid[0..16];
    return if (ct_equal(credential_tag(cc, rp_id, nonce), cid[16..32])) { Some(nonce) } else { None };
}

// The 48 tweak bytes, HKDF(cc, nil, "symbolon v1 tweak" || rp_id || nonce, 48).
pub List(Secret(UInt(8))) tweak_bytes(List(Secret(UInt(8))) cc, Str rp_id, List(Int) nonce) {
    return hkdf_nil(cc, utf8("symbolon v1 tweak").concat(utf8(rp_id)).concat(nonce), 48);
}

// tau = tweak_bytes mod q, as the protocol's scalar. See the header: this is
// the one declassification of the threshold layer.
@requires(declassify)
pub List(UInt(64)) tweak_scalar(List(Secret(UInt(8))) cc, Str rp_id, List(Int) nonce) {
    List(Int) b = ints_of(declassify(secret_join(tweak_bytes(cc, rp_id, nonce)), "tweak into CGGMP reference implementation"), 0, ListBuf());
    return sc_of_bytes(b);
}

// P = X + tau*G as a SEC1 uncompressed point (65 bytes), or [] when X is not
// a point.
pub List(Int) credential_pubkey(List(Int) root_pubkey, List(UInt(64)) tau) {
    Option(CvPt) ox = sec1_point(root_pubkey);
    return match ox {
        None => [],
        Some(x) => sec1_uncompressed(cv_add(x, cv_mul_base(tau)))
    };
}

// The point of a SEC1 uncompressed encoding (0x04 || X || Y), checked to be
// on the curve: it is decoded from its compressed form and Y must agree.
pub Option(CvPt) sec1_point(List(Int) b) {
    if (b.len() != 65 || b[0] != 4) { return None; }
    List(UInt(64)) y = bn_from_be(b[33..65]);
    Option(CvPt) op = cv_dec([2 + bn_bit(y, 0)].concat(b[1..33]));
    return match op {
        None => None,
        Some(p) => if (bn_cmp(p.y, y) == 0) { Some(p) } else { None }
    };
}

pub List(Int) sec1_uncompressed(CvPt p) {
    if (p.inf) { return []; }
    return [4].concat(bn_to_be(p.x, 32)).concat(bn_to_be(p.y, 32));
}

// ============================================================================
// Parties as protocol ids (SPEC 7)
// ============================================================================

// A party's CGGMP id: its position in the quorum's party list, from 1.
pub Int cg_id_of(Quorum q, List(Int) party, Int i) {
    if (i >= q.parties.len()) { return 0; }
    if (bytes_eq(q.parties[i].id, party)) { return i + 1; }
    return cg_id_of(q, party, i + 1);
}

List(Int) insert_sorted(List(Int) xs, Int v, Int i, ListBuf(Int) acc) {
    if (i >= xs.len()) { return acc.push(v).finish(); }
    if (v < xs[i]) { return copy_rest(xs, i, acc.push(v)); }
    return insert_sorted(xs, v, i + 1, acc.push(xs[i]));
}

List(Int) copy_rest(List(Int) xs, Int i, ListBuf(Int) acc) {
    if (i >= xs.len()) { return acc.finish(); }
    return copy_rest(xs, i + 1, acc.push(xs[i]));
}

// The signers' CGGMP ids in ascending order, or [] when one is not in the
// quorum or appears twice.
pub List(Int) cg_ids(Quorum q, List(List(Int)) signers, Int i, List(Int) acc) {
    if (i >= signers.len()) { return acc; }
    Int id = cg_id_of(q, signers[i], 0);
    if (id == 0 || cg_index(acc, id, 0) >= 0) { return []; }
    return cg_ids(q, signers, i + 1, insert_sorted(acc, id, 0, ListBuf()));
}

// ============================================================================
// Epochs (SPEC 11.3)
// ============================================================================

// A party signs only with shares of the log's current epoch.
pub Result(Int, SymbolonError) epoch_ok(UInt(32) share_epoch, LogHead h) {
    if (share_epoch < h.quorum.epoch) { return Err(ErrStaleEpoch(share_epoch, h.quorum.epoch)); }
    if (share_epoch > h.quorum.epoch) { return Err(ErrInvalidLog("share epoch ahead of the verified log")); }
    return Ok(0);
}

// ============================================================================
// One party's side of a signing session (SPEC 10.4)
// ============================================================================

//@ serial
pub type ThMsg = ThCg(CgMsg) | ThTw(BlTwMsg) | ThVerdict(BlVerdict) | ThRs(RsMsg);

// Round 7 is split (lib/cggmp_blind.resid): a peer sends its S point only;
// the designated party checks the S points and sends each peer a verdict;
// on "ok" the peer sends its signature share, on "abort" its abort-2
// openings, never both. A peer's sigma_j next to its openings (k_j and its
// Chi MtA plaintexts) would give the designated party chi_j and from it the
// peer's key share; CGGMP21 opens only a presignature that never signed.
//
// Every party sends one batch per round to every other (agent/session.resid),
// so the split costs two rounds in which a party hears nothing it needs:
// the peer's round 6 (the designated party's empty batch) and the
// designated party's round 7 (the peers' empty batches). They run alongside
// the rounds that matter; the critical path gains one relay round trip
// (verdict out, answer back).
//
// Storage rule (BlPeer7): the state that bl_r7_answer returns is what this
// party holds when its answer goes out, and no older copy is ever answered
// from. Here the session state lives only in memory, in the process that
// runs the session (the cosigner's serve-for child, the device's `sign`),
// and is never written anywhere: a process that ends or restarts loses the
// presignature, which is then simply abandoned (safe: nothing derived from
// it is sent again), and a new session starts from fresh nonces.
pub type ThState =
    ThR1(Ps1, BlRole)
  | ThR2(BlR2)
  | ThR3(Ps3, BlR2)
  | ThR4(Ps4, BlR2)
  | ThR5(Ps5, BlR2)
  | ThR6(Ps6, BlR2)                     // the designated party, waiting for the S points
  | ThPeerS(BlPeer7, BlR2)              // a peer that has sent its S point; its round-6 inbox holds nothing for it
  | ThPeerWait(BlPeer7, BlR2)           // a peer waiting for the designated party's verdict
  | ThAnswered(BlPeer7)                 // a peer that has answered (sigma or openings, per `answered`); done
  | ThVerdictOk(Ps6, CgPresig, BlR2)    // the designated party, "ok" sent; its round-7 inbox holds nothing for it
  | ThAwaitSigma(Ps6, CgPresig, BlR2)   // the designated party, waiting for the signature shares
  | ThVerdictAbort(PsAb2, BlR2)         // the designated party, "abort" sent; its round-7 inbox holds nothing for it
  | ThAwaitAbort(PsAb2, BlR2)           // the designated party, waiting for abort-2 openings
  | ThSigned(CgSig)
  | ThClosed
  | ThNoNonce;                          // no redraw gave round 1 a nonce other than 1; nothing was sent

pub type ThStep = { ThState state; List(ThMsg) out; };

// The session context for party `self_party`. The designated party is the
// initiating device: it alone holds tau and ends with the signature.
pub Option(CgCtx) th_ctx(CgConfig cfg, Quorum q, List(List(Int)) signers, List(Int) initiator, List(UInt(64)) tau, List(Int) session_id, List(Int) digest, List(Int) seed) {
    List(Int) ids = cg_ids(q, signers, 0, []);
    Int d = cg_id_of(q, initiator, 0);
    if (ids.len() == 0 || d == 0) { return None; }
    return bl_ctx(cfg, ids, BlRole {.designated = d, .tau = if (cfg.id == d) { tau } else { [] }}, session_id, digest, seed);
}

pub BlRole th_role(CgCtx c, Quorum q, List(Int) initiator, List(UInt(64)) tau) {
    Int d = cg_id_of(q, initiator, 0);
    return BlRole {.designated = d, .tau = if (c.self == d) { tau } else { [] }};
}

List(ThMsg) wrap_cg(List(CgMsg) ms, Int i, ListBuf(ThMsg) acc) {
    if (i >= ms.len()) { return acc.finish(); }
    return wrap_cg(ms, i + 1, acc.push(ThCg(ms[i])));
}

List(ThMsg) wrap_tw(List(BlTwMsg) ms, Int i, ListBuf(ThMsg) acc) {
    if (i >= ms.len()) { return acc.finish(); }
    return wrap_tw(ms, i + 1, acc.push(ThTw(ms[i])));
}

List(ThMsg) wrap_verdicts(List(BlVerdict) vs, Int i, ListBuf(ThMsg) acc) {
    if (i >= vs.len()) { return acc.finish(); }
    return wrap_verdicts(vs, i + 1, acc.push(ThVerdict(vs[i])));
}

List(CgMsg) cg_of(List(ThMsg) ms, Int i, ListBuf(CgMsg) acc) {
    if (i >= ms.len()) { return acc.finish(); }
    ThMsg m = ms[i];
    return cg_of(ms, i + 1, match m { ThCg(x) => acc.push(x), _ => acc });
}

List(BlTwMsg) tw_of(List(ThMsg) ms, Int i, ListBuf(BlTwMsg) acc) {
    if (i >= ms.len()) { return acc.finish(); }
    ThMsg m = ms[i];
    return tw_of(ms, i + 1, match m { ThTw(x) => acc.push(x), _ => acc });
}

// The first verdict in `ms` addressed to `me`.
Option(BlVerdict) verdict_for(List(ThMsg) ms, Int me, Int i) {
    if (i >= ms.len()) { return None; }
    ThMsg m = ms[i];
    return match m {
        ThVerdict(v) => if (v.to == me) { Some(v) } else { verdict_for(ms, me, i + 1) },
        _ => verdict_for(ms, me, i + 1)
    };
}

// Round 1: K = Enc(k) and G = Enc(gamma). When one has the nonce 1 (see
// "Paillier nonce 1" below) the round is drawn again from a fresh seed,
// so k and gamma are new as well: the k that would have shown is dropped
// before anything left this party.
pub ThStep th_start(CgCtx c, BlRole role) { return th_start_try(c, role, 0); }

ThStep th_start_try(CgCtx c, BlRole role, Int k) {
    if (k >= nonce_one_redraws()) { return ThStep {.state = ThNoNonce, .out = []}; }
    CgCtx ck = if (k == 0) { c } else { ctx_reseeded(c, nonce_one_seed(c.seed, k)) };
    Ps1 s = ps_start(ck);
    List(ThMsg) out = wrap_cg(s.out, 0, ListBuf());
    if (th_nonce_one(ck, out, 0)) { return th_start_try(c, role, k + 1); }
    return ThStep {.state = ThR1(s, role), .out = out};
}

CgCtx ctx_of6(Ps6 s) { return s.prev.prev.prev.prev.prev.ctx; }

ThStep quiet(ThState st) { return ThStep {.state = st, .out = []}; }

// Advances the session by one round on `in`, everything addressed to this
// party in the last round. A failure names the parties to blame, if any.
pub Result(ThStep, CgFail) th_step(ThState st, List(ThMsg) in) {
    List(CgMsg) cin = cg_of(in, 0, ListBuf());
    return match st {
        ThR1(s, role) => th_r2(s, role, cin),
        ThR2(b) => th_r3(b, cin, tw_of(in, 0, ListBuf())),
        ThR3(s, b) => th_r4(s, b, cin),
        ThR4(s, b) => th_r5(s, b, cin),
        ThR5(s, b) => th_r6(s, b, cin),
        ThR6(s, b) => th_r7(s, b, cin),
        ThPeerS(p, b) => Ok(quiet(ThPeerWait(p, b))),
        ThPeerWait(p, b) => th_answer(p, b, in),
        ThAnswered(p) => Ok(quiet(ThAnswered(p))),
        ThVerdictOk(s, pre, b) => Ok(quiet(ThAwaitSigma(s, pre, b))),
        ThAwaitSigma(s, pre, b) => th_finish(s, pre, b, cin),
        ThVerdictAbort(a, b) => Ok(quiet(ThAwaitAbort(a, b))),
        ThAwaitAbort(a, b) => Err(bl_abort2_blame(a, cin, b)),
        ThSigned(sig) => Ok(quiet(ThSigned(sig))),
        ThClosed => Err(cg_fail("session closed", [])),
        ThNoNonce => Err(cg_fail(nonce_one_exhausted(), []))
    };
}

// Round 2: the Delta and Chi MtAs (F = Enc_self(y) to each peer) and, at
// the designated party, the tweak MtA (T = Enc_self(tau), F). A peer's K or
// G with the nonce 1 is refused first. When one of ours has the nonce 1
// the round is computed again with a fresh seed for this round's draws:
// k and gamma stay (K and G went out in round 1 and are what the peers
// hold), the masks y, the nonces and the proofs are new, and the round
// that would have shown y (and through D the secret it masks) is never
// sent.
Result(ThStep, CgFail) th_r2(Ps1 s, BlRole role, List(CgMsg) in) {
    if (th_nonce_one(s.ctx, wrap_cg(in, 0, ListBuf()), 0)) { return Err(cg_fail(nonce_one_refused(), [])); }
    return th_r2_try(s, role, in, 0);
}

Result(ThStep, CgFail) th_r2_try(Ps1 s0, BlRole role, List(CgMsg) in, Int k) {
    if (k >= nonce_one_redraws()) { return Err(cg_fail(nonce_one_exhausted(), [])); }
    Ps1 s = if (k == 0) { s0 } else { ps1_reseeded(s0, nonce_one_seed(s0.ctx.seed, k)) };
    Ps2 s2 = ps_r2(s, in)?;
    BlR2 b = bl_r2(s2, role);
    List(ThMsg) out = wrap_cg(s2.out, 0, ListBuf()).concat(wrap_tw(b.out, 0, ListBuf()));
    if (th_nonce_one(s.ctx, out, 0)) { return th_r2_try(s0, role, in, k + 1); }
    return Ok(ThStep {.state = ThR2(b), .out = out});
}

// Round 3 reads the peers' F ciphertexts and the designated party's tweak
// T and F; one with the nonce 1 is refused before anything is built on it.
Result(ThStep, CgFail) th_r3(BlR2 b, List(CgMsg) in, List(BlTwMsg) tw) {
    CgCtx c = b.s.prev.ctx;
    if (th_nonce_one(c, wrap_cg(in, 0, ListBuf()).concat(wrap_tw(tw, 0, ListBuf())), 0)) { return Err(cg_fail(nonce_one_refused(), [])); }
    Ps3 s = bl_r3(b, in, tw)?;
    return Ok(ThStep {.state = ThR3(s, b), .out = wrap_cg(s.out, 0, ListBuf())});
}

Result(ThStep, CgFail) th_r4(Ps3 s3, BlR2 b, List(CgMsg) in) {
    Ps4 s = ps_r4(s3, in)?;
    return Ok(ThStep {.state = ThR4(s, b), .out = wrap_cg(s.out, 0, ListBuf())});
}

Result(ThStep, CgFail) th_r5(Ps4 s4, BlR2 b, List(CgMsg) in) {
    Ps5 s = ps_r5(s4, in)?;
    return Ok(ThStep {.state = ThR5(s, b), .out = wrap_cg(s.out, 0, ListBuf())});
}

// A peer sends its S point, to the designated party only, and nothing else
// until the verdict.
Result(ThStep, CgFail) th_r6(Ps5 s5, BlR2 b, List(CgMsg) in) {
    Ps6 s = bl_r6(ps_r6(s5, in)?, b.role);
    CgCtx c = ctx_of6(s);
    if (c.self == b.role.designated) { return Ok(ThStep {.state = ThR6(s, b), .out = []}); }
    return Ok(ThStep {.state = ThPeerS(bl_r7_peer(s, b.role), b), .out = wrap_cg(s.out, 0, ListBuf())});
}

// The designated party: the S points must add up to P. Then every peer
// gets "ok" and is asked for its signature share; when they do not, every
// peer gets "abort" and is asked for its openings, which name the party
// whose Chi share was wrong. Any other failure (a missing or malformed S
// point names its sender) ends the session at once.
Result(ThStep, CgFail) th_r7(Ps6 s, BlR2 b, List(CgMsg) in) {
    CgCtx c = ctx_of6(s);
    return match bl_r7_designated(s, in) {
        Ok(done) => Ok(ThStep {.state = ThVerdictOk(s, done.presig, b), .out = wrap_verdicts(bl_verdicts(c, true), 0, ListBuf())}),
        Err(e) => th_start_abort(s, b, in, e)
    };
}

Result(ThStep, CgFail) th_start_abort(Ps6 s, BlR2 b, List(CgMsg) in, CgFail e) {
    if (e.culprits.len() > 0 || e.why != "the S shares do not add up to the public key") { return Err(e); }
    PsAb2 a = bl_abort2(s, in, b.role)?;
    return Ok(ThStep {.state = ThVerdictAbort(a, b), .out = wrap_verdicts(bl_verdicts(ctx_of6(s), false), 0, ListBuf())});
}

// A peer answers the designated party's verdict once: sigma on "ok", its
// openings on "abort" (bl_r7_answer refuses a second verdict and records
// which answer went). No verdict (the designated party gave up) closes
// the session; the presignature is abandoned.
Result(ThStep, CgFail) th_answer(BlPeer7 p, BlR2 b, List(ThMsg) in) {
    CgCtx c = p.prev.prev.prev.prev.prev.prev.ctx;
    return match verdict_for(in, c.self, 0) {
        None => Ok(quiet(ThClosed)),
        Some(v) => th_answered(bl_r7_answer(p, v)?)
    };
}

Result(ThStep, CgFail) th_answered(BlPeer7 p) {
    return Ok(ThStep {.state = ThAnswered(p), .out = wrap_cg(p.out, 0, ListBuf())});
}

// The signature shares make the signature, checked under P. A share that
// fails the designated party's check names no one: in blind mode only the
// designated party checks the shares, against values its own tweak entered,
// and no other party can confirm the blame, so it is an unidentified abort
// (SPEC 6.2) and bans no one.
Result(ThStep, CgFail) th_finish(Ps6 s, CgPresig pre, BlR2 b, List(CgMsg) in) {
    return match bl_finish(ctx_of6(s), pre, in, b.role) {
        Err(e) => Err(cg_fail(e.why, [])),
        Ok(sig) => Ok(quiet(ThSigned(sig)))
    };
}

// Whether a session could not start: every redraw of round 1 hit the
// nonce 1 (th_start). The caller ends the session without sending.
pub Bool th_no_nonce(ThState st) { return match st { ThNoNonce => true, _ => false }; }

// Whether a peer's session ended in its answer to an "abort" verdict: the
// designated party found that the S points do not add up.
pub Bool th_peer_aborted(ThState st) {
    return match st { ThAnswered(p) => p.answered == 2, _ => false };
}

// The ECDSA signature r || s (64 bytes) of a finished session.
pub List(Int) th_sig_raw(CgSig sig) { return cg_sig_raw(sig.r, sig.s); }

// ============================================================================
// Paillier nonce 1 (SPEC 6.2.1)
// ============================================================================
//
// Resid's cg_unit (lib/cggmp.resid:46-52 up to master 1458799c) draws a
// Paillier nonce from an 8-chunk stream and falls back to the nonce 1 when
// every chunk is rejected: for a 2048-bit N that is up to 1 call in 745
// (1 in 13,200 on average). Enc(m; 1) = 1 + mN mod N^2, so anyone holding
// the ciphertext and N reads m = (c - 1) / N, and pa_ct_ok accepts it. The
// values so encrypted are k and gamma (K, G), the MtA masks y (F, which give
// gamma or the sender's key share through D), tau (T and the tweak F) and a
// re-share dealer's parts: with two signers several of them give the other
// party the root key. Symbolon does not change Resid; it guards both sides:
//
// - A sender tests every Paillier ciphertext it made before the round goes
//   out (th_start, th_r2 here; reshare.resid's deal) and on a hit computes
//   the round again from nonce_one_seed. Nothing derived from the dropped
//   draw was sent, so nothing is reused and no one is blamed.
// - A receiver refuses a ciphertext c with c = 1 (mod N_sender): the session
//   ends without blame (record_run leaves the abort book alone), so an
//   honest party never builds on a value the sender's build showed.
//
// For a valid ciphertext c = (1 + mN) r^N, c mod N = r^N mod N, and x -> x^N
// is a bijection on the units mod N (gcd(N, phi(N)) = 1), so c = 1 (mod N)
// exactly when r = 1 (mod N).

// The session protocol version every invitation and round batch carries
// (proto.resid: SignInvite, ReshareInvite, SessionMsg; absent reads as 0).
// 2 is the first with this guard. A party refuses an invitation or a batch
// below session_proto_min: a build without the guard can send a ciphertext
// that shows its secret, and an old peer that receives ours keeps the
// unguarded build in use. The refusal blames no one and tells the user
// which side to upgrade (the cosigner first, then the devices).
pub Int session_proto() { return 2; }
pub Int session_proto_min() { return 2; }
pub Str old_build_prefix() { return "old build: "; }
pub Str old_build_refusal(Str who, Int v) {
    return old_build_prefix() + f"{who} runs a Symbolon build from before the Paillier nonce fix (session protocol {v}, {session_proto_min()} needed): upgrade it";
}

// Whether c = 1 (mod N): a ciphertext under N whose nonce is 1.
pub Bool pa_nonce_one(List(UInt(64)) n, List(UInt(64)) c) {
    if (bn_cmp(n, [2]) < 0 || c.len() == 0) { return false; }
    return bn_cmp(bn_mod(c, n), [1]) == 0;
}

// How many fresh seeds a round tries before it gives up (each hit has
// probability below 2^-9.5, so 8 in a row below 2^-76).
pub Int nonce_one_redraws() { return 8; }

// The seed of redraw k: a function of the secret session seed, so as
// unpredictable as it.
pub List(Int) nonce_one_seed(List(Int) seed, Int k) {
    return sha256_bytes(seed.concat(bytes_of(f"symbolon v1 nonce-one redraw {k}")));
}

pub Str nonce_one_prefix() { return "Paillier nonce 1: "; }
pub Str nonce_one_refused() { return nonce_one_prefix() + "a peer sent a ciphertext that shows its plaintext (its build lacks the nonce fix); refused, no one blamed"; }
pub Str nonce_one_exhausted() { return nonce_one_prefix() + "every redraw made a ciphertext that would show its plaintext; nothing sent"; }

pub CgCtx ctx_reseeded(CgCtx c, List(Int) seed) {
    return CgCtx {.self = c.self, .ids = c.ids, .pubs = c.pubs, .x = c.x, .elg = c.elg, .psec = c.psec, .pubkey = c.pubkey, .base = c.base, .seed = seed, .digest = c.digest};
}

Ps1 ps1_reseeded(Ps1 s, List(Int) seed) {
    return Ps1 {.ctx = ctx_reseeded(s.ctx, seed), .gamma = s.gamma, .kshare = s.kshare, .g_nonce = s.g_nonce, .k_nonce = s.k_nonce, .elg_nonce = s.elg_nonce,
                .pre_id = s.pre_id, .decommit = s.decommit, .k_ct = s.k_ct, .g_ct = s.g_ct, .zl = s.zl, .zm = s.zm, .commit = s.commit, .out = s.out};
}

// The ciphertexts of m that its sender encrypted under its own key: K and
// G (PsB2), both MtAs' F (PsM3), the tweak MtA's T and F. (D is under the
// receiver's key, which reads it anyway.)
Bool cg_msg_nonce_one(CgCtx c, CgMsg m) {
    if (cg_index(c.ids, m.from, 0) < 0) { return false; }
    List(UInt(64)) n = cg_pub_of(c, m.from).pail.n;
    CgBody b = m.body;
    return match b {
        PsB2(x) => pa_nonce_one(n, x.k) || pa_nonce_one(n, x.g),
        PsM3(x) => pa_nonce_one(n, x.delta_f) || pa_nonce_one(n, x.chi_f),
        _ => false
    };
}

Bool tw_msg_nonce_one(CgCtx c, BlTwMsg t) {
    if (cg_index(c.ids, t.from, 0) < 0) { return false; }
    List(UInt(64)) n = cg_pub_of(c, t.from).pail.n;
    return pa_nonce_one(n, t.t) || pa_nonce_one(n, t.f);
}

// Whether any message of `ms` carries a ciphertext with the nonce 1 under
// its sender's key.
pub Bool th_nonce_one(CgCtx c, List(ThMsg) ms, Int i) {
    if (i >= ms.len()) { return false; }
    ThMsg m = ms[i];
    Bool hit = match m { ThCg(x) => cg_msg_nonce_one(c, x), ThTw(t) => tw_msg_nonce_one(c, t), _ => false };
    return hit || th_nonce_one(c, ms, i + 1);
}

// ============================================================================
// Aborts (SPEC 6.2)
// ============================================================================

// Parties named by an abort, and the count of aborts that named no one.
pub type AbortBook = { List(List(Int)) banned; Int unidentified; };

pub AbortBook abort_book() { return AbortBook {.banned = [], .unidentified = 0}; }

// After this many consecutive aborts that identify no one, the parties stop
// and alert instead of trying again.
pub Int unidentified_limit() { return 3; }

List(List(Int)) party_ids_of(Quorum q, List(Int) cg_ids_named, Int i, List(List(Int)) acc) {
    if (i >= cg_ids_named.len()) { return acc; }
    Int k = cg_ids_named[i] - 1;
    List(List(Int)) next = if (k >= 0 && k < q.parties.len()) { acc.concat([q.parties[k].id]) } else { acc };
    return party_ids_of(q, cg_ids_named, i + 1, next);
}

Bool held(List(List(Int)) xs, List(Int) x, Int i) {
    if (i >= xs.len()) { return false; }
    if (bytes_eq(xs[i], x)) { return true; }
    return held(xs, x, i + 1);
}

List(List(Int)) union_ids(List(List(Int)) a, List(List(Int)) b, Int i) {
    if (i >= b.len()) { return a; }
    return union_ids(if (held(a, b[i], 0)) { a } else { a.concat([b[i]]) }, b, i + 1);
}

pub AbortBook record_abort(AbortBook book, Quorum q, CgFail f) {
    if (f.culprits.len() == 0) { return AbortBook {.banned = book.banned, .unidentified = book.unidentified + 1}; }
    return AbortBook {.banned = union_ids(book.banned, party_ids_of(q, f.culprits, 0, []), 0), .unidentified = 0};
}

pub AbortBook record_success(AbortBook book) { return AbortBook {.banned = book.banned, .unidentified = 0}; }

// Whether a session with these signers may run: none is banned, and the
// aborts that named no one have not reached the limit.
pub Result(Int, SymbolonError) may_run(AbortBook book, List(List(Int)) signers) {
    if (book.unidentified >= unidentified_limit()) { return Err(ErrPolicyViolation("repeated unidentified aborts: stop and alert")); }
    return may_run_from(book, signers, 0);
}

Result(Int, SymbolonError) may_run_from(AbortBook book, List(List(Int)) signers, Int i) {
    if (i >= signers.len()) { return Ok(0); }
    if (held(book.banned, signers[i], 0)) { return Err(ErrPolicyViolation("a signer was identified in an abort")); }
    return may_run_from(book, signers, i + 1);
}

List(List(Int)) still_present(List(List(Int)) banned, Quorum q, Int i, List(List(Int)) acc) {
    if (i >= banned.len()) { return acc; }
    Bool present = cg_id_of(q, banned[i], 0) != 0;
    return still_present(banned, q, i + 1, if (present) { acc.concat([banned[i]]) } else { acc });
}

// After a refresh or re-share to `q`: a banned party that `q` excludes is
// forgotten; one still in `q` stays banned (only a refresh that excludes it
// lifts the rule).
pub AbortBook after_reshare(AbortBook book, Quorum q) {
    return AbortBook {.banned = still_present(book.banned, q, 0, []), .unidentified = 0};
}

// What a session's end does to the book: a success resets the count of
// unidentified aborts; a session that failed a protocol check is an abort
// (identified when it names a party); a session that only timed out or was
// refused is no abort, since no check failed.
// A party refused for an old build (a ciphertext with the nonce 1, or a
// protocol version below session_proto_min, SPEC 6.2.1) is no abort either:
// no protocol check failed against an honest party of the current build.
pub AbortBook record_run(AbortBook book, Quorum q, Str fail, List(Int) culprits) {
    if (str_len(fail) == 0) { return record_success(book); }
    if (fail == "timed out waiting for a round" || fail == "the cosigner is unreachable") { return book; }
    if (str_starts_with(fail, nonce_one_prefix()) || str_starts_with(fail, old_build_prefix())) { return book; }
    return record_abort(book, q, cg_fail(fail, culprits));
}

// The book as kept on disk, one per log: the epoch it was last written at
// (4 bytes, big-endian), the count of unidentified aborts (one byte,
// capped) and the banned parties' 32-byte ids.
pub List(Int) abort_book_encode(AbortBook book, UInt(32) epoch) {
    Int e = (Int)epoch;
    Int u = if (book.unidentified > 255) { 255 } else { book.unidentified };
    return [(e >> 24) & 255, (e >> 16) & 255, (e >> 8) & 255, e & 255, u].concat(join_ids(book.banned, 0, []));
}

List(Int) join_ids(List(List(Int)) ids, Int i, List(Int) acc) {
    if (i >= ids.len()) { return acc; }
    return join_ids(ids, i + 1, if (ids[i].len() == 32) { acc.concat(ids[i]) } else { acc });
}

List(List(Int)) split_ids(List(Int) b, Int at, List(List(Int)) acc) {
    if (at + 32 > b.len()) { return acc; }
    return split_ids(b, at + 32, acc.concat([b[at..at + 32]]));
}

// The book kept for quorum q: none kept (or unreadable) is a fresh book;
// one written at an earlier epoch has seen a re-share since, so
// after_reshare applies.
pub AbortBook abort_book_decode(List(Int) b, Quorum q) {
    if (b.len() < 5 || (b.len() - 5) % 32 != 0) { return abort_book(); }
    Int e = (b[0] << 24) | (b[1] << 16) | (b[2] << 8) | b[3];
    AbortBook book = AbortBook {.banned = split_ids(b, 5, []), .unidentified = b[4]};
    return if (e < (Int)q.epoch) { after_reshare(book, q) } else { book };
}

// ============================================================================
// The kit's offline material (SPEC 10.6)
// ============================================================================

// With a cosigner in the quorum the kit's share is x_K = a + b and its key
// k_K = k_a XOR k_b; a, k_a are wrapped to the kit, b, k_b to the cosigner.
pub type KitHalves = { List(UInt(64)) a; List(UInt(64)) b; List(Int) ka; List(Int) kb; };

List(Int) xor_bytes(List(Int) x, List(Int) y, Int i, ListBuf(Int) acc) {
    if (i >= x.len()) { return acc.finish(); }
    return xor_bytes(x, y, i + 1, acc.push(x[i] ^ y[i]));
}

// `ra` (32 bytes) and `rkb` (as long as k_K) are fresh random bytes.
pub KitHalves kit_split(List(UInt(64)) xk, List(Int) kk, List(Int) ra, List(Int) rkb) {
    List(UInt(64)) a = sc_of_bytes(ra);
    return KitHalves {.a = a, .b = sc_nat_sub(xk, a), .ka = xor_bytes(kk, rkb, 0, ListBuf()), .kb = rkb};
}

pub List(UInt(64)) kit_share(List(UInt(64)) a, List(UInt(64)) b) { return sc_nat_add(a, b); }

pub List(Int) kit_key(List(Int) ka, List(Int) kb) {
    if (ka.len() != kb.len()) { return []; }
    return xor_bytes(ka, kb, 0, ListBuf());
}

// HPKE base mode, DHKEM(P-256), HKDF-SHA256, AES-256-GCM (SPEC 6.1).
pub HpkeSuite offline_suite() { return hpke_suite(16, 1, 2); }

// info = CBOR ["symbolon v1 offline", log_id, epoch, party_id]
pub List(Int) offline_info(List(Int) log_id, UInt(32) epoch, List(Int) party) {
    List(Int) a = cbe_text("symbolon v1 offline", cbe_array(4, []));
    List(Int) b = cbe_bytes(log_id, a);
    List(Int) c = cbe_uint((Int)epoch, b);
    return cbe_bytes(party, c);
}

pub type Wrapped = { List(Int) enc; List(Int) ct; };

// Wraps `pt` to `hpke_pub` for party `party` at this epoch. `ikm_e` is the
// fresh ephemeral key material.
pub Option(Wrapped) offline_wrap(List(Int) hpke_pub, List(Int) log_id, UInt(32) epoch, List(Int) party, List(Int) pt, List(Int) ikm_e) {
    HpkeSender s = hpke_setup_sender_full(offline_suite(), hpke_pub, offline_info(log_id, epoch, party), [], [], [], ikm_e);
    if (!s.ctx.ok) { return None; }
    HpkeSealed sealed = hpke_seal(s.ctx, [], pt);
    if (sealed.ct.len() == 0) { return None; }
    return Some(Wrapped {.enc = s.enc, .ct = sealed.ct});
}

pub Option(List(Int)) offline_unwrap(List(Int) hpke_priv, List(Int) log_id, UInt(32) epoch, List(Int) party, Wrapped w) {
    return hpke_open_with(offline_suite(), w.enc, hpke_priv, offline_info(log_id, epoch, party), [], w.ct);
}
