    BeaconOutcome b8 = cosigner_beacon(b7.s, p8, [157, 242, 77, 191, 211, 210, 194, 174, 189, 226, 4, 86, 52, 118, 237, 242, 20, 23, 238, 140, 22, 252, 187, 158, 75, 230, 233, 165, 164, 241, 213, 161], [134, 114, 115, 121, 109, 98, 111, 108, 111, 110, 32, 118, 49, 32, 99, 111, 115, 105, 103, 110, 88, 32, 157, 242, 77, 191, 211, 210, 194, 174, 189, 226, 4, 86, 52, 118, 237, 242, 20, 23, 238, 140, 22, 252, 187, 158, 75, 230, 233, 165, 164, 241, 213, 161, 88, 32, 2, 146, 6, 175, 126, 206, 235, 21, 242, 218, 118, 59, 166, 147, 25, 88, 254, 7, 158, 225, 4, 19, 231, 169, 12, 153, 24, 181, 173, 45, 37, 125, 4, 88, 32, 153, 125, 157, 206, 119, 122, 72, 163, 49, 96, 10, 191, 252, 156, 240, 132, 158, 198, 203, 109, 113, 210, 24, 124, 122, 24, 210, 165, 139, 55, 31, 167, 7], [78, 142, 240, 84, 208, 232, 162, 164, 240, 214, 28, 201, 41, 10, 208, 187, 198, 148, 192, 61, 221, 73, 170, 80, 95, 30, 157, 61, 197, 225, 220, 154, 79, 10, 150, 145, 153, 55, 63, 46, 186, 250, 125, 229, 242, 146, 216, 56, 32, 143, 80, 199, 231, 215, 185, 55, 25, 75, 234, 32, 101, 113, 70, 242], 5600, 5600);
    expect(bea(b8)).toEqual("- ended");
    expect(window_ran_out(b7.s, 5600)).toBeTrue();
    expect(window_ran_out(b7.s, 5599)).toBeFalse();
}

Str moved(CosignerState s, VerifiedHead v) {
    return match cosigner_update_head(s, v) { Ok(x) => f"{x.verified.head.sequence}", Err(e) => err_str(e) };
}

test "the held head moves forward only" {
    expect(moved(fresh(), vh(10, [175, 163, 67, 115, 237, 222, 147, 217, 22, 119, 124, 5, 130, 184, 39, 252, 118, 241, 161, 48, 197, 138, 47, 205, 99, 122, 99, 77, 187, 73, 210, 222]))).toEqual("10");
    expect(moved(fresh(), vh(9, [82, 106, 48, 236, 254, 177, 68, 36, 148, 86, 33, 50, 9, 26, 178, 92, 121, 37, 189, 211, 212, 152, 26, 152, 204, 50, 33, 49, 206, 83, 150, 82]))).toEqual("9");
    expect(moved(fresh(), vh(9, [177, 117, 28, 186, 161, 98, 107, 148, 236, 99, 134, 115, 83, 178, 70, 240, 86, 4, 15, 164, 255, 95, 7, 178, 247, 33, 237, 22, 153, 197, 99, 149]))).toEqual("log: fork");
    expect(moved(fresh(), vh(8, [246, 71, 164, 201, 89, 34, 79, 46, 102, 64, 63, 205, 58, 107, 115, 192, 62, 153, 126, 117, 202, 29, 49, 137, 252, 180, 166, 43, 240, 221, 198, 163]))).toEqual("log: rollback");
}
