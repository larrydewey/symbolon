}

test "a device's DK-signed request proceeds and is recorded with H(m)" {
    CosignOutcome o = cosign_decide(fresh(), CosignRequest { .session_id = [125, 200, 95, 252, 117, 65, 140, 175, 18, 133, 140, 52, 13, 202, 204, 21, 238, 48, 228, 59, 239, 196, 154, 87, 36, 173, 189, 83, 147, 190, 139, 64], .message = [60, 78, 129, 35, 34, 110, 249, 23, 155, 225, 111, 129, 52, 26, 195, 29, 22, 16, 101, 78, 131, 60, 228, 41, 44, 32, 38, 68, 165, 192, 147, 166], .epoch = 4, .requester = [17, 227, 196, 101, 122, 109, 164, 176, 152, 188, 57, 110, 33, 127, 245, 255, 231, 142, 92, 213, 17, 34, 247, 78, 152, 242, 2, 0, 141, 194, 139, 145], .kind = 0, .sig = [206, 214, 52, 208, 136, 24, 193, 20, 65, 15, 137, 175, 58, 155, 25, 54, 18, 3, 7, 132, 227, 217, 20, 100, 19, 59, 30, 202, 80, 100, 109, 211, 62, 255, 172, 195, 39, 36, 203, 226, 249, 19, 20, 206, 154, 229, 230, 105, 140, 73, 27, 50, 2, 143, 101, 188, 0, 185, 134, 1, 39, 161, 195, 208] }, 100);
    expect(said(o)).toEqual("proceed");
    CosignerState s = st(o);
    expect(s.records.len()).toEqual(1);
    expect(hx(s.records[0].message_hash)).toEqual("6304c739a70775f78985158e8a43e7924d1a4f28a1f89050e874c3fb81fbc251");
    expect(hx(s.records[0].requester)).toEqual("11e3c4657a6da4b098bc396e217ff5ffe78e5cd51122f74e98f202008dc28b91");
    expect(s.records[0].time).toEqual(100);
}

