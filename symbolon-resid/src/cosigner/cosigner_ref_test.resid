Str ended(CosignerState s, EndDuress m, Int now) {
    return match cosigner_end_duress(s, m, now) {
        Ok(x) => if (cosigner_in_duress(x, now)) { "still" } else { "ended" },
        Err(e) => err_str(e)
    };
}

