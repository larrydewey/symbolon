// The cosigner policy (src/cosigner/cosigner.resid) against signing bytes,
// signatures and hashes made by an independent implementation
// (tests/gen_cosigner_ref.py). Generated; do not edit by hand.

import "../types.resid";
import "../core/log.resid";
import "cosigner.resid";
import "crypto.resid";

Str hx(List(Int) b) { return hex_encode(b); }

Party pt(List(Int) id, UInt(8) kind, List(Int) key) {
    return Party { .id = id, .kind = kind, .auth_key = key, .hpke_key = [], .label = "p", .attestation = NoAttestation };
}

LogHead head_at(UInt(64) seq, List(Int) dig) {
    Quorum q = Quorum {
        .parties = [pt([17, 227, 196, 101, 122, 109, 164, 176, 152, 188, 57, 110, 33, 127, 245, 255, 231, 142, 92, 213, 17, 34, 247, 78, 152, 242, 2, 0, 141, 194, 139, 145], party_kind_device(), [4, 171, 171, 48, 29, 11, 189, 216, 198, 218, 182, 200, 222, 189, 4, 29, 170, 232, 199, 43, 173, 108, 233, 132, 54, 178, 176, 120, 196, 222, 114, 236, 24, 218, 59, 30, 239, 180, 7, 231, 199, 94, 70, 49, 210, 109, 80, 218, 119, 199, 118, 33, 223, 211, 29, 3, 226, 245, 44, 132, 0, 225, 69, 126, 117]), pt([153, 125, 157, 206, 119, 122, 72, 163, 49, 96, 10, 191, 252, 156, 240, 132, 158, 198, 203, 109, 113, 210, 24, 124, 122, 24, 210, 165, 139, 55, 31, 167], party_kind_device(), [4, 163, 251, 209, 180, 164, 188, 85, 188, 168, 128, 75, 175, 13, 29, 233, 236, 66, 138, 16, 212, 181, 105, 47, 113, 35, 121, 79, 24, 247, 236, 46, 120, 15, 120, 91, 167, 112, 226, 205, 172, 172, 104, 93, 124, 122, 135, 200, 199, 177, 119, 188, 213, 27, 220, 182, 212, 221, 116, 102, 80, 45, 32, 53, 112]),
                    pt([127, 251, 218, 72, 24, 158, 160, 22, 209, 115, 225, 72, 39, 11, 252, 242, 225, 139, 245, 244, 1, 173, 120, 86, 45, 238, 183, 29, 200, 164, 199, 103], party_kind_device(), [4, 213, 222, 70, 63, 225, 241, 235, 242, 180, 104, 226, 89, 117, 100, 183, 215, 27, 72, 112, 220, 115, 191, 127, 166, 240, 199, 47, 138, 255, 33, 203, 2, 155, 199, 245, 139, 128, 200, 66, 41, 69, 120, 144, 30, 151, 94, 118, 255, 170, 213, 42, 9, 102, 57, 96, 222, 240, 109, 235, 159, 195, 71, 118, 142]), pt([214, 112, 29, 228, 19, 211, 230, 205, 69, 163, 219, 122, 131, 46, 232, 28, 70, 157, 100, 64, 195, 239, 117, 140, 174, 174, 215, 160, 139, 225, 215, 175], party_kind_kit(), [4, 171, 171, 48, 29, 11, 189, 216, 198, 218, 182, 200, 222, 189, 4, 29, 170, 232, 199, 43, 173, 108, 233, 132, 54, 178, 176, 120, 196, 222, 114, 236, 24, 218, 59, 30, 239, 180, 7, 231, 199, 94, 70, 49, 210, 109, 80, 218, 119, 199, 118, 33, 223, 211, 29, 3, 226, 245, 44, 132, 0, 225, 69, 126, 117]),
                    pt([35, 95, 115, 133, 86, 59, 55, 158, 136, 230, 221, 100, 40, 48, 170, 248, 244, 180, 73, 223, 246, 79, 31, 130, 164, 160, 157, 30, 166, 61, 116, 91], party_kind_cosigner(), [4, 45, 105, 41, 22, 93, 63, 2, 182, 63, 53, 115, 201, 58, 109, 111, 246, 161, 11, 176, 36, 136, 161, 52, 177, 198, 221, 37, 225, 192, 218, 240, 74, 49, 135, 50, 3, 123, 127, 174, 13, 50, 41, 82, 215, 221, 204, 7, 150, 142, 6, 117, 215, 199, 175, 154, 148, 189, 202, 130, 203, 61, 155, 4, 32])],
        .t = 2, .root_pubkey = [], .epoch = 4, .transcript_digest = [] };
    Policy p = Policy {
        .device_sigs_for_authority = 2, .recovery_delay_sec = 86400, .guardians = [], .guardian_threshold = 0,
        .witnesses = [], .duress_window_sec = 600, .cosigner_policy = CosignerLimit(3) };
    return LogHead { .log_id = [135, 71, 155, 199, 225, 162, 132, 38, 86, 76, 73, 242, 72, 218, 232, 92, 88, 235, 68, 182, 199, 249, 102, 246, 172, 6, 255, 190, 96, 69, 247, 157], .sequence = seq, .digest = dig, .quorum = q, .policy = p };
}

VerifiedHead vh(UInt(64) seq, List(Int) dig) { return VerifiedHead { .head = head_at(seq, dig), .witness_cosigs = [], .pending = [] }; }

CosignerState fresh() {
    return cosigner_new(vh(9, [82, 106, 48, 236, 254, 177, 68, 36, 148, 86, 33, 50, 9, 26, 178, 92, 121, 37, 189, 211, 212, 152, 26, 152, 204, 50, 33, 49, 206, 83, 150, 82]), [DuressKey { .party = [17, 227, 196, 101, 122, 109, 164, 176, 152, 188, 57, 110, 33, 127, 245, 255, 231, 142, 92, 213, 17, 34, 247, 78, 152, 242, 2, 0, 141, 194, 139, 145], .subkey = [4, 57, 55, 81, 81, 219, 165, 186, 135, 156, 28, 217, 135, 74, 96, 182, 226, 83, 79, 125, 44, 190, 195, 204, 101, 233, 93, 39, 3, 83, 138, 52, 77, 148, 173, 5, 243, 233, 105, 21, 84, 131, 53, 192, 180, 213, 187, 70, 183, 162, 11, 189, 237, 78, 15, 6, 193, 138, 205, 144, 19, 46, 105, 81, 6] }]);
}

Str err_str(SymbolonError e) {
    return match e {
        ErrInvalidLog(s) => "log: " + s, ErrInvalidSignature(s) => "sig: " + s,
        ErrQuorumNotMet(h, n) => f"quorum {h}/{n}", ErrStaleEpoch(h, c) => f"epoch {h}/{c}",
        ErrVaultIntegrity(s) => s, ErrPolicyViolation(s) => "policy: " + s, ErrDuressContainment(s) => "duress: " + s,
        ErrRecoveryFailed(s) => s, ErrRotationFailed(s) => s, ErrAttestationFailed(s) => s,
        ErrCapabilityDenied(s) => s, ErrNetwork(s) => "net: " + s, ErrStorage(s) => s, ErrHardware(s) => s,
        ErrInternal(s) => s
    };
}

Str said(CosignOutcome o) { return match o { Proceed(_) => "proceed", Refuse(_, e) => err_str(e) }; }
CosignerState st(CosignOutcome o) { return match o { Proceed(s) => s, Refuse(s, _) => s }; }

test "request signing bytes equal the reference" {
    expect(hx(request_tbs([18, 176, 38, 73, 202, 147, 51, 166, 125, 127, 241, 183, 211, 218, 84, 134, 7, 123, 109, 9, 76, 53, 143, 96, 251, 115, 176, 233, 82, 147, 239, 187], [119, 142, 182, 136, 238, 175, 192, 102, 221, 212, 21, 8, 237, 172, 241, 215, 40, 237, 251, 14, 0, 122, 25, 201, 144, 203, 142, 44, 231, 125, 81, 228], 4, [17, 227, 196, 101, 122, 109, 164, 176, 152, 188, 57, 110, 33, 127, 245, 255, 231, 142, 92, 213, 17, 34, 247, 78, 152, 242, 2, 0, 141, 194, 139, 145], 1))).toEqual("867273796d626f6c6f6e20763120636f7369676e582012b02649ca9333a67d7ff1b7d3da5486077b6d094c358f60fb73b0e95293efbb5820778eb688eeafc066ddd41508edacf1d728edfb0e007a19c990cb8e2ce77d51e404582011e3c4657a6da4b098bc396e217ff5ffe78e5cd51122f74e98f202008dc28b9101");
}

