Str moved(CosignerState s, VerifiedHead v) {
    return match cosigner_update_head(s, v) { Ok(x) => f"{x.verified.head.sequence}", Err(e) => err_str(e) };
}

test "the held head moves forward only" {
    expect(moved(fresh(), vh(10, [84, 240, 255, 11, 36, 153, 63, 46, 160, 206, 242, 35, 164, 232, 233, 193, 24, 93, 98, 207, 197, 246, 72, 85, 123, 55, 85, 177, 110, 148, 236, 141]))).toEqual("10");
    expect(moved(fresh(), vh(9, [82, 106, 48, 236, 254, 177, 68, 36, 148, 86, 33, 50, 9, 26, 178, 92, 121, 37, 189, 211, 212, 152, 26, 152, 204, 50, 33, 49, 206, 83, 150, 82]))).toEqual("9");
    expect(moved(fresh(), vh(9, [165, 43, 46, 220, 178, 253, 224, 181, 93, 189, 221, 99, 47, 105, 102, 182, 99, 153, 179, 211, 45, 21, 157, 250, 100, 173, 170, 143, 11, 8, 233, 116]))).toEqual("log: fork");
    expect(moved(fresh(), vh(8, [114, 165, 207, 243, 1, 201, 183, 101, 125, 242, 76, 43, 95, 36, 102, 56, 67, 2, 232, 49, 176, 30, 79, 41, 151, 130, 239, 31, 64, 240, 104, 188]))).toEqual("log: rollback");
}
