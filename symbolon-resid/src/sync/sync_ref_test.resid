// The sync checks (src/sync/sync.resid) against bytes and signatures made by
// an independent implementation (tests/gen_sync_ref.py): device-authentication
// signing bytes and ECDSA signatures, and witness co-signatures. Generated;
// do not edit by hand.

import "../types.resid";
import "../core/log.resid";
import "sync.resid";
import "crypto.resid";

Str hx(List(Int) b) { return hex_encode(b); }

Party test_party(List(Int) id, UInt(8) kind, List(Int) key) {
    return Party { .id = id, .kind = kind, .auth_key = key, .hpke_key = [], .label = "p", .attestation = NoAttestation };
}

Quorum auth_quorum() {
    return Quorum {
        .parties = [test_party([223, 88, 88, 41, 58, 150, 1, 161, 205, 234, 27, 84, 60, 233, 170, 6, 37, 55, 47, 170, 131, 43, 154, 22, 13, 99, 112, 6, 80, 12, 69, 159], party_kind_device(), [4, 243, 213, 85, 108, 207, 84, 83, 197, 116, 29, 238, 62, 90, 29, 169, 70, 7, 2, 170, 155, 85, 55, 220, 44, 95, 6, 169, 144, 78, 232, 192, 218, 210, 84, 17, 253, 28, 230, 100, 123, 40, 251, 34, 190, 38, 91, 109, 65, 31, 170, 27, 181, 108, 80, 134, 130, 40, 157, 213, 216, 136, 109, 114, 73]),
                    test_party([64, 214, 140, 55, 198, 50, 111, 122, 101, 115, 49, 154, 64, 199, 71, 42, 229, 249, 1, 91, 96, 159, 207, 48, 151, 105, 186, 152, 73, 50, 2, 141], party_kind_kit(), [4, 243, 213, 85, 108, 207, 84, 83, 197, 116, 29, 238, 62, 90, 29, 169, 70, 7, 2, 170, 155, 85, 55, 220, 44, 95, 6, 169, 144, 78, 232, 192, 218, 210, 84, 17, 253, 28, 230, 100, 123, 40, 251, 34, 190, 38, 91, 109, 65, 31, 170, 27, 181, 108, 80, 134, 130, 40, 157, 213, 216, 136, 109, 114, 73])],
        .t = 1, .root_pubkey = [], .epoch = 0, .transcript_digest = [] };
}

test "auth signing bytes equal the reference" {
    expect(hx(auth_tbs([31, 198, 191, 144, 202, 236, 50, 34, 240, 108, 5, 35, 174, 7, 91, 142, 150, 51, 1, 21, 108, 105, 207, 40, 184, 144, 226, 25, 70, 192, 203, 201], [223, 88, 88, 41, 58, 150, 1, 161, 205, 234, 27, 84, 60, 233, 170, 6, 37, 55, 47, 170, 131, 43, 154, 22, 13, 99, 112, 6, 80, 12, 69, 159], "sync.example.org"))).toEqual("847073796d626f6c6f6e207631206175746858201fc6bf90caec3222f06c0523ae075b8e963301156c69cf28b890e21946c0cbc95820df5858293a9601a1cdea1b543ce9aa0625372faa832b9a160d637006500c459f7073796e632e6578616d706c652e6f7267");
}

test "a device signature made in Python verifies; every change to it fails" {
    Quorum q = auth_quorum();
    expect(verify_device_auth(q, [223, 88, 88, 41, 58, 150, 1, 161, 205, 234, 27, 84, 60, 233, 170, 6, 37, 55, 47, 170, 131, 43, 154, 22, 13, 99, 112, 6, 80, 12, 69, 159], [31, 198, 191, 144, 202, 236, 50, 34, 240, 108, 5, 35, 174, 7, 91, 142, 150, 51, 1, 21, 108, 105, 207, 40, 184, 144, 226, 25, 70, 192, 203, 201], "sync.example.org", [93, 140, 218, 129, 210, 34, 250, 249, 47, 157, 12, 135, 177, 37, 52, 98, 24, 78, 54, 89, 7, 200, 198, 39, 80, 207, 136, 18, 65, 71, 149, 53, 174, 158, 184, 204, 40, 94, 77, 144, 210, 43, 54, 180, 62, 27, 104, 186, 244, 12, 64, 172, 247, 65, 15, 39, 113, 202, 98, 60, 248, 101, 70, 107])).toBeTrue();
    expect(verify_device_auth(q, [223, 88, 88, 41, 58, 150, 1, 161, 205, 234, 27, 84, 60, 233, 170, 6, 37, 55, 47, 170, 131, 43, 154, 22, 13, 99, 112, 6, 80, 12, 69, 159], [31, 198, 191, 144, 202, 236, 50, 34, 240, 108, 5, 35, 174, 7, 91, 142, 150, 51, 1, 21, 108, 105, 207, 40, 184, 144, 226, 25, 70, 192, 203, 201], "other.example.org", [93, 140, 218, 129, 210, 34, 250, 249, 47, 157, 12, 135, 177, 37, 52, 98, 24, 78, 54, 89, 7, 200, 198, 39, 80, 207, 136, 18, 65, 71, 149, 53, 174, 158, 184, 204, 40, 94, 77, 144, 210, 43, 54, 180, 62, 27, 104, 186, 244, 12, 64, 172, 247, 65, 15, 39, 113, 202, 98, 60, 248, 101, 70, 107])).toBeFalse();
    expect(verify_device_auth(q, [223, 88, 88, 41, 58, 150, 1, 161, 205, 234, 27, 84, 60, 233, 170, 6, 37, 55, 47, 170, 131, 43, 154, 22, 13, 99, 112, 6, 80, 12, 69, 159], [103, 92, 115, 149, 0, 63, 26, 114, 218, 193, 141, 174, 67, 163, 27, 5, 47, 243, 90, 75, 107, 178, 64, 75, 149, 51, 87, 155, 238, 104, 43, 60], "sync.example.org", [93, 140, 218, 129, 210, 34, 250, 249, 47, 157, 12, 135, 177, 37, 52, 98, 24, 78, 54, 89, 7, 200, 198, 39, 80, 207, 136, 18, 65, 71, 149, 53, 174, 158, 184, 204, 40, 94, 77, 144, 210, 43, 54, 180, 62, 27, 104, 186, 244, 12, 64, 172, 247, 65, 15, 39, 113, 202, 98, 60, 248, 101, 70, 107])).toBeFalse();
    expect(verify_device_auth(q, [79, 13, 79, 180, 157, 186, 11, 133, 13, 228, 0, 163, 146, 240, 232, 159, 26, 12, 17, 43, 10, 157, 215, 143, 235, 143, 43, 219, 36, 12, 201, 8], [31, 198, 191, 144, 202, 236, 50, 34, 240, 108, 5, 35, 174, 7, 91, 142, 150, 51, 1, 21, 108, 105, 207, 40, 184, 144, 226, 25, 70, 192, 203, 201], "sync.example.org", [93, 140, 218, 129, 210, 34, 250, 249, 47, 157, 12, 135, 177, 37, 52, 98, 24, 78, 54, 89, 7, 200, 198, 39, 80, 207, 136, 18, 65, 71, 149, 53, 174, 158, 184, 204, 40, 94, 77, 144, 210, 43, 54, 180, 62, 27, 104, 186, 244, 12, 64, 172, 247, 65, 15, 39, 113, 202, 98, 60, 248, 101, 70, 107])).toBeFalse();
    expect(verify_device_auth(q, [223, 88, 88, 41, 58, 150, 1, 161, 205, 234, 27, 84, 60, 233, 170, 6, 37, 55, 47, 170, 131, 43, 154, 22, 13, 99, 112, 6, 80, 12, 69, 159], [31, 198, 191, 144, 202, 236, 50, 34, 240, 108, 5, 35, 174, 7, 91, 142, 150, 51, 1, 21, 108, 105, 207, 40, 184, 144, 226, 25, 70, 192, 203, 201], "sync.example.org", [93, 140, 218, 129, 210, 34, 250, 249, 47, 157, 12, 135, 177, 37, 52, 98, 24, 78, 54, 89, 7, 200, 198, 39, 80, 207, 136, 18, 65, 71, 149, 53, 174, 158, 184, 204, 40, 94, 77, 144, 214, 43, 54, 180, 62, 27, 104, 186, 244, 12, 64, 172, 247, 65, 15, 39, 113, 202, 98, 60, 248, 101, 70, 107])).toBeFalse();
    // The kit shares the key above but is not a device: it cannot authenticate as one.
    expect(verify_device_auth(q, [64, 214, 140, 55, 198, 50, 111, 122, 101, 115, 49, 154, 64, 199, 71, 42, 229, 249, 1, 91, 96, 159, 207, 48, 151, 105, 186, 152, 73, 50, 2, 141], [31, 198, 191, 144, 202, 236, 50, 34, 240, 108, 5, 35, 174, 7, 91, 142, 150, 51, 1, 21, 108, 105, 207, 40, 184, 144, 226, 25, 70, 192, 203, 201], "sync.example.org", [93, 140, 218, 129, 210, 34, 250, 249, 47, 157, 12, 135, 177, 37, 52, 98, 24, 78, 54, 89, 7, 200, 198, 39, 80, 207, 136, 18, 65, 71, 149, 53, 174, 158, 184, 204, 40, 94, 77, 144, 210, 43, 54, 180, 62, 27, 104, 186, 244, 12, 64, 172, 247, 65, 15, 39, 113, 202, 98, 60, 248, 101, 70, 107])).toBeFalse();
}

LogHead log_head() {
    Policy p = Policy {
        .device_sigs_for_authority = 2, .recovery_delay_sec = 86400, .guardians = [], .guardian_threshold = 0,
        .witnesses = [WitnessRef { .url = "a", .key = [4, 94, 103, 89, 165, 88, 87, 44, 60, 233, 98, 162, 122, 4, 206, 6, 80, 151, 36, 241, 60, 23, 3, 121, 190, 1, 38, 61, 196, 73, 87, 242, 38, 139, 252, 67, 85, 106, 245, 171, 248, 19, 147, 13, 44, 203, 183, 54, 171, 138, 114, 237, 191, 56, 166, 254, 45, 27, 250, 148, 83, 240, 34, 164, 30] }, WitnessRef { .url = "b", .key = [4, 7, 32, 174, 101, 54, 194, 78, 50, 220, 73, 104, 135, 155, 27, 176, 184, 13, 84, 83, 54, 169, 148, 224, 235, 111, 183, 5, 107, 56, 176, 3, 187, 55, 26, 139, 155, 127, 236, 233, 200, 24, 240, 44, 49, 3, 76, 180, 138, 207, 228, 13, 105, 127, 209, 171, 187, 96, 63, 161, 252, 213, 40, 159, 240] },
                      WitnessRef { .url = "c", .key = [4, 58, 68, 211, 177, 229, 152, 94, 155, 60, 27, 238, 204, 40, 101, 126, 243, 180, 33, 152, 94, 6, 65, 251, 37, 130, 116, 223, 180, 227, 68, 198, 93, 24, 106, 140, 246, 78, 59, 90, 13, 42, 96, 68, 89, 62, 34, 216, 218, 39, 255, 31, 81, 113, 227, 147, 187, 240, 97, 193, 174, 6, 222, 29, 219] }],
        .duress_window_sec = 0, .cosigner_policy = NoCosignerPolicy };
    return LogHead { .log_id = [148, 60, 97, 228, 205, 239, 34, 156, 58, 111, 105, 156, 106, 147, 223, 242, 48, 186, 125, 94, 190, 149, 77, 5, 171, 193, 75, 145, 65, 33, 91, 18], .sequence = 6, .digest = [59, 143, 213, 45, 98, 226, 227, 208, 22, 89, 88, 48, 254, 152, 81, 124, 140, 119, 60, 48, 228, 221, 171, 121, 85, 28, 231, 45, 12, 146, 15, 130],
                      .quorum = auth_quorum(), .policy = p };
}

Int witnessed(List(WitnessCosignature) cosigs) {
    return match require_witnessed(cosigs, log_head()) { Ok(t) => t, Err(_) => -1 };
}

