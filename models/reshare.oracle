#!/usr/bin/env python3
# Goal ranking for reshare.spthy (tamarin-prover --heuristic=O --oraclename=reshare.oracle).
import sys

goals = [l.rstrip("\n") for l in sys.stdin if ":" in l]

def rank(g):
    body = g.split(":", 1)[1]
    if "'reshare'" in body:
        return 9
    if "Accept(" in body or "AcceptPrev(" in body:
        return 0
    if "Head(" in body or "Cosigned" in body:
        return 1
    if "!KU( sign(<'event'" in body or "!KU( sign(<'wit'" in body:
        return 2
    if "!KU( ~" in body or "RevealDK" in body:
        return 3
    if "!DevKey" in body or "!Genesis" in body or "!Intent" in body:
        return 4
    if "Intend" in body or "MadeKey" in body or "Installs(" in body:
        return 5
    return 9

if goals:
    best = min(goals, key=rank)
    print(best.split(":", 1)[0].strip())
