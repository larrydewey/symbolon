theory SymbolonFork
begin

builtins: signing, hashing
functions: succ/1

/* ---------- Setup ---------- */

rule Inception:
    let pa = pk(~ka)
        pb = pk(~kb)
        g  = h(<'E0', pa, pb, pk(~w)>)
    in
    [ Fr(~ka), Fr(~kb), Fr(~w) ]
  --[ Inception(g, pa, pb), MadeKey(g, pa), MadeKey(g, pb) ]->
    [ !Genesis(g, pa, pb)
    , !WitnessQuorum(g, ~w), !WitnessPk(g, pk(~w))
    , !DevKey(g, ~ka), !DevKey(g, ~kb)
    , !DevHead(g, ~ka, succ('0'), g), !DevHead(g, ~kb, succ('0'), g)
    , !WitHead(g, succ('0'), g)
    , Slot(g, 'i1')
    , Slot(g, 'a1')
    , Out(<'log', g, pa, pb, pk(~w)>) ]

rule NewParty:
    [ !Genesis(g, pa, pb), Fr(~p) ]
  --[ Start(~p, g), Installs(~p, g, pa, pb) ]->
    [ Head(~p, g, succ('0'), g, pa, pb) ]

/* ---------- Single proposal (honest protocol) ---------- */

rule IntendEvent:
    [ !Genesis(g, pa, pb), Fr(~x), Slot(g, 'i1') ]
  --[ Intend(g, <'ev', ~x>) ]->
    [ !Intent(g, <'ev', ~x>), Out(<'ev', ~x>) ]

/* ---------- Devices sign intended events ---------- */

rule DeviceSign:
    let m = <'event', g, succ(n), hd, body> in
    [ !DevKey(g, k), !DevHead(g, k, n, hd), !Intent(g, body) ]
  --[ DeviceSigned(pk(k), m) ]->
    [ Out(<'sig', m, sign(m, k)>) ]

/* ---------- Witnesses ---------- */

rule WitnessCosign:
    let m = <'event', g, succ(n), hd, body> in
    [ !WitnessQuorum(g, w), !WitHead(g, n, hd), !DevKey(g, ka), !DevKey(g, kb)
    , In(<m, sa, sb>) ]
  --[ Eq(verify(sa, m, pk(ka)), true), Eq(verify(sb, m, pk(kb)), true)
    , WSign(g, succ(n), h(m)) ]->
    [ Out(<'cos', m, sign(<'wit', g, succ(n), h(m)>, w)>) ]

/* ---------- Verification and acceptance ---------- */

rule CheckHead:
    let m = <'event', g, succ(n), hd, body> in
    [ Head(p, g, n, hd, qa, qb), !DevKey(g, ka), !DevKey(g, kb)
    , !WitnessPk(g, wq), In(<m, sa, sb, cw>) ]
  --[ Eq(pk(ka), qa), Eq(pk(kb), qb)
    , Eq(verify(sa, m, qa), true), Eq(verify(sb, m, qb), true)
    , Eq(verify(cw, <'wit', g, succ(n), h(m)>, wq), true)
    , CosignOK(g, succ(n), h(m)) ]->
    [ Head(p, g, n, hd, qa, qb), Cosigned(g, succ(n), m, qa, qb) ]

rule AcceptEvent:
    let m = <'event', g, succ(n), hd, body>
        d = h(m)
    in
    [ Head(p, g, n, hd, qa, qb)[-], Cosigned(g, succ(n), m, qa, qb)[-]
    , Slot(g, a) ]
  --[ Accept(p, g, succ(n), d, body, qa, qb) ]->
    [ Head(p, g, succ(n), d, qa, qb), !Accepted(p, g, succ(n), d, body) ]

/* ---------- Restrictions ---------- */

restriction Equality:
  "All x y #i. Eq(x, y) @ #i ==> x = y"

restriction Inequality:
  "All x #i. Neq(x, x) @ #i ==> F"

restriction WitnessOneDigest:
  "All g n d1 d2 #i #j. WSign(g, n, d1) @ #i & WSign(g, n, d2) @ #j
     ==> d1 = d2"

restriction MaxParties:
  "All p1 g1 #i p2 g2 #j p3 g3 #k. Start(p1, g1) @ #i & Start(p2, g2) @ #j
     & Start(p3, g3) @ #k & #i < #j & #j < #k ==> F"

/* ---------- Sanity: honest protocol completes ---------- */

lemma sanity_event_accepted:
  exists-trace
  "Ex p g n d body qa qb #i. Accept(p, g, n, d, body, qa, qb) @ #i
     & not (Ex k #r. RevealDK(k) @ #r)"

/* ---------- L-02 Fork prevention (stronger than detection under honest witnesses) ---------- */

lemma L02_fork_detection [use_induction]:
  "All p1 p2 g n d1 d2 body1 body2 qa qb ra rb #i #j.
       Accept(p1, g, n, d1, body1, qa, qb) @ #i
     & Accept(p2, g, n, d2, body2, ra, rb) @ #j
     & not (body1 = body2)
     ==> F"

end