<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The agent talks to the relay, witnesses and cosigner. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- The network's DNS servers, for the agent's lookups (no /etc/resolv.conf on Android). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- The QR scanner (QrScanner.kt); optional, as a code can also be pasted. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <!-- The fill screen hides other apps' overlays (SPEC 22.6 item 4, Android 12+). -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS"/>
    <!-- Duress alerts (SPEC 14.4): the last known location the alert carries
         (no new fix is asked for), and household members' alerts shown as
         notifications (AlertWorker.kt). Asked for when alerts are set up. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-feature android:name="android.hardware.location" android:required="false"/>
    <!-- Apps that may use the SSH agent service (SPEC 16.1.1): Symbolon's own
         signer, or one listed in res/values/ssh_agent_callers.xml. -->
    <permission
        android:name="dev.symbolon.permission.SSH_SIGN"
        android:protectionLevel="signature|knownSigner"
        android:knownCerts="@array/ssh_agent_callers"
        android:label="Use Symbolon's SSH keys" />
    <!-- No backup and no transfer to a new phone of anything the app keeps
         (the device's key share, the agent's state): res/xml/backup_rules.xml
         and data_extraction_rules.xml exclude everything as well. -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="Symbolon"
        android:extractNativeLibs="true"
        android:usesCleartextTraffic="true"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Straight to SSH keys: what an app that uses the SSH agent
                 (Pylon) opens when Symbolon has no key for it yet. -->
            <intent-filter>
                <action android:name="dev.symbolon.action.SSH_KEYS"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
        <!-- A passkey ceremony for the system (Android 14+). -->
        <activity
            android:name=".PasskeyActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/NormalTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize" />
        <!-- The autofill fill and save screen (SPEC 22.6). -->
        <activity
            android:name=".AutofillActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/NormalTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize" />
        <!-- The SSH signature window for another app (SPEC 16.1.1). -->
        <activity
            android:name=".SshConsentActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/NormalTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize" />
        <!-- The SSH agent for other apps (SPEC 16.1.1). -->
        <service
            android:name=".SshAgentService"
            android:exported="true"
            android:permission="dev.symbolon.permission.SSH_SIGN">
            <intent-filter>
                <action android:name="dev.symbolon.action.SSH_AGENT" />
            </intent-filter>
        </service>
        <!-- Symbolon as Android's autofill service (Settings > Passwords, passkeys and accounts). -->
        <service
            android:name=".SymbolonAutofillService"
            android:exported="true"
            android:label="Symbolon"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data android:name="android.autofill" android:resource="@xml/autofill_service" />
        </service>
        <!-- Symbolon as a passkey provider (Settings > Passwords, passkeys and accounts). -->
        <service
            android:name=".SymbolonCredentialService"
            android:enabled="true"
            android:exported="true"
            android:label="Symbolon"
            android:icon="@mipmap/ic_launcher"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE">
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>
            <meta-data
                android:name="android.credentials.provider"
                android:resource="@xml/credential_provider" />
        </service>
        <!-- Managed configuration from an organization's device management (SPEC 29.9). -->
        <meta-data android:name="android.content.APP_RESTRICTIONS" android:resource="@xml/app_restrictions" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <!-- Launchable apps: who asks for a fill, and which app a login may be linked to (SPEC 22.6). -->
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
