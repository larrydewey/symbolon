{
  "manifest_version": 3,
  "name": "Symbolon",
  "version": "0.3.2",
  "description": "Fill logins and cards from Symbolon. The extension holds nothing: each fill is approved in the Symbolon window, outside the page.",
  "key": "",
  "permissions": ["nativeMessaging", "scripting", "webNavigation", "activeTab"],
  "host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Fill with Symbolon (Ctrl+Shift+L)"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+L" },
      "description": "Fill this page with Symbolon"
    }
  },
  "browser_specific_settings": {
    "gecko": { "id": "browser@symbolon.dev", "strict_min_version": "128.0" }
  }
}
